{
  "manifest_version": 3,
  "name": "B-Faith FBA納品 福通伝票CSV",
  "version": "0.4.0",
  "description": "Amazon Seller Central の納品プラン画面から、福山通運 iS-2 に取り込む送り状CSVを作る (社内用・通信なし)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellercentral.amazon.co.jp/*",
        "https://sellercentral-japan.amazon.com/*"
      ],
      "js": [
        "sjis.js",
        "fukutsu-csv.js",
        "page-parse.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
