{
  "manifest_version": 3,
  "name": "B-Faith 選べるセット展開",
  "version": "0.1.0",
  "description": "ネクストエンジンの受注伝票で「選べる〇種セット」を実SKUの明細行に展開する (社内用)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://wh.bfaith-wh.uk/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://main.next-engine.com/Userjyuchu/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
