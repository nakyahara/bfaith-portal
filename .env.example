# ログイン認証
SESSION_SECRET=your-random-secret-here
PORTAL_USER=admin
PORTAL_PASS=changeme

# サーバー設定
PORT=3000

# 楽天順位チェッカー
# 2026-05-14 以降は新APIキー (新ダッシュボード https://webservice.rakuten.co.jp/) の値を使うこと
# applicationId は UUID 形式、accessKey は pk_ で始まる
# affiliateId はオプション (アフィリエイト報酬を取る場合に設定)
RAKUTEN_APP_ID=your-rakuten-app-id
RAKUTEN_ACCESS_KEY=your-rakuten-access-key
RAKUTEN_AFFILIATE_ID=your-rakuten-affiliate-id
RAKUTEN_SHOP_CODE=b-faith
YAHOO_APP_ID=your-yahoo-app-id
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
AMAZON_ASSOCIATE_TAG=your-amazon-associate-tag

# FBA仕入れ利益計算
SP_API_CLIENT_ID=your-sp-api-client-id
SP_API_CLIENT_SECRET=your-sp-api-client-secret
SP_API_REFRESH_TOKEN=your-sp-api-refresh-token
SP_API_MARKETPLACE_ID=A1VC38T7YXB528
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
NOTION_API_KEY=your-notion-api-key
NOTION_PROFIT_DB_ID=your-notion-db-id

# Google Drive CSV自動保存（9:00 JST）
GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json
GOOGLE_DRIVE_FILE_ID=google-drive-file-id-to-overwrite

# FBA在庫補充システム
FBA_SPREADSHEET_ID=1NruozyuL_lwdnk3WqtlRvwpB1frrbqSRVEDN9l6Uh50

# 入庫情報管理 (apps/inbound-info)
# 日次 cron (JST 09:00) は既定で有効: NE商品マスタ(ミラー)からの新商品自動追加 +
# 入荷予定 nefuda.csv の取得。止めるときだけ false (0 / off / no も可) を設定する。
# ⚠ Render は 1 インスタンス運用前提 (複数インスタンスだと各々で cron が走る)
INBOUND_INFO_SYNC_ENABLED=
# 既定 JST 09:00。cron 式 (JST 基準) で上書きしたい場合のみ
INBOUND_INFO_SYNC_CRON=
# 入荷予定 nefuda.csv の置き場 (既定は共有ドライブ直下 / nefuda.csv)
INBOUND_NEFUDA_FOLDER_ID=
INBOUND_NEFUDA_FILE=
# 入荷予定リストPDF のファイル名 (既定 入荷予定リスト.pdf。nefuda.csv と同じフォルダに上書き保存)
INBOUND_SCHEDULE_PDF_FILE=

# 楽天 未発送アラート (apps/rakuten-unshipped) — ⚠ミニPC専用
# 前日12:00 (締め) までに入金確認できていて、まだ発送されていない注文を GChat へ通知する。
# daily-sync (毎朝07:00) の最後のステップとして実行される。Render では動かさない
# (楽天RMSは同じキーで受注変更もできる = API集約方針でミニPC経由必須)。
# 通知先スペースの Google Chat Webhook URL (未設定ならステップが失敗する)
GCHAT_WEBHOOK_SHIPPING=
# 出荷の締め時刻 (時・JST、既定 12)
RAKUTEN_UNSHIPPED_CUTOFF_HOUR=
# 未発送を探す期間 (日、既定 180。RMSの63日上限に合わせて60日窓に分割して検索する)
RAKUTEN_UNSHIPPED_SEARCH_DAYS=
# お届け日指定を保留にできる猶予 (日、既定 2。お届け日が今日+この日数以内なら出荷漏れ扱い)
RAKUTEN_UNSHIPPED_LEAD_DAYS=
# RMS 受注API の認証は RAKUTEN_SERVICE_SECRET / RAKUTEN_LICENSE_KEY (既存の楽天RMS設定を使う)

# Yahoo! 未発送アラート (apps/yahoo-unshipped) — ⚠ミニPC専用・通知先は楽天版と同じスペース
# warehouse.db で候補を絞り、Yahoo受注API (VPSプロキシ経由・1件1秒) で最新確認してから通知する。
# ⚠DBだけでは判定しない (同期は7日窓 = 古い注文の ship_status が更新されないため)
# 締め時刻 (時・JST、既定 12)
YAHOO_UNSHIPPED_CUTOFF_HOUR=
# DBから候補を拾う期間 (日、既定 180)
YAHOO_UNSHIPPED_SEARCH_DAYS=
# API で最新確認する候補数の上限 (既定 60。1件1秒かかるので暴走防止)
YAHOO_UNSHIPPED_MAX_VERIFY=
# 通知先は GCHAT_WEBHOOK_SHIPPING (楽天版と共用)。API認証は YAHOO_PROXY_URL / YAHOO_PROXY_SECRET

# Yahoo! 問い合わせ対応漏れチェック (apps/yahoo-inquiry-alert) — ⚠ミニPC専用
# ① 未返信 (出店者回答待ち) ② 返信済みだが「完了する」処理がされていない問い合わせを
# 問い合わせ管理API (VPSプロキシ経由) で検知し、1件以上あるときだけ通知する。
# daily-sync の1ステップとして実行。API認証は YAHOO_PROXY_URL / YAHOO_PROXY_SECRET を共用
# 通知先スペースの Google Chat Webhook URL (未設定ならステップが失敗する)
GCHAT_WEBHOOK_YAHOO_INQUIRY=
# ② 完了処理待ちを「要対応」として通知する窓 (日、既定 30)。
# 窓より古い過去分は件数だけ添える (導入時実測で過去分が1,000件超あったため)
YAHOO_INQUIRY_WINDOW_DAYS=

# au PAY 未発送アラート (apps/aupay-unshipped) — ⚠ミニPC専用・通知先は楽天/Yahoo版と同じスペース
# warehouse.db で候補を絞り、auPAY受注API (VPSプロキシ経由) で最新確認してから通知する。
# ⚠auPAY の payment_status は「入金済み」ではない (発送後にYになる)。判定は order_status='発送待ち'
# 締め時刻 (時・JST、既定 12)
AUPAY_UNSHIPPED_CUTOFF_HOUR=
# DBから候補を拾う期間 (日、既定 180)
AUPAY_UNSHIPPED_SEARCH_DAYS=
# API で最新確認する注文日の上限 (既定 20。auPAYは注文ID指定ができず1日1リクエストになるため)
AUPAY_UNSHIPPED_MAX_DAYS=
# 認証は既存の AUPAY_PROXY_URL / AUPAY_PROXY_SECRET / AUPAY_SHOP_ID を使う

# Qoo10 未発送アラート (apps/qoo10-unshipped) — ⚠ミニPC専用・通知先は3モール共通
# ⚠Qoo10 だけは API 再確認をしない (同期が直近90日を毎回取り直し + キャンセル済みは
#   受注APIから消えて last_seen_at が古くなるため、今日の同期分に絞れば最新状態になる)
# 締め時刻 (時・JST、既定 12)
QOO10_UNSHIPPED_CUTOFF_HOUR=
# 認証は既存の QOO10_CERT_KEY (受注同期側) をそのまま使う。このジョブ自体はAPIを叩かない

# ABAキーワード拡張 (apps/aba-keywords、miniPC専用 — セラースプライト置換)
# mount gate: 1 のときだけ /aba-ext-api が立つ (Render では設定しない)
ENABLE_ABA_EXT=
# Chrome拡張の認証トークン (fail-closed: 未設定なら503)。長いランダム文字列を設定
ABA_EXT_TOKEN=
# 取込モード (既定 watched = 蓄積しない設計: 監視ASINを含む検索語だけ保存、DBは数MB。
# full にすると全検索語を保存 = 任意ASIN即答の代わりにGB級)
ABA_INGEST_MODE=
# fullモードのみ: 全検索語の保持週数 (既定8。監視ASINを含む検索語は無期限保持)
ABA_KEEP_WEEKS=
# 商品タイトルの保存 (既定OFF。1行の容量が数倍になる割に拡張UIでは未使用)
ABA_STORE_TITLES=
# 検索結果ページ用カタログ情報 (BSR/梱包) のキャッシュ時間 (既定24h)
ABA_CATALOG_TTL_HOURS=
# buy box出品者の表示 (getItemOffersBatch はレート制限が厳しいため既定OFF。1で有効)
ABA_EXT_OFFERS=

# 梱包サイズマスター Easy Ship (apps/easy-ship — Chrome拡張の入力補助)
# Chrome拡張の認証トークン (fail-closed: 未設定なら ext-api は503)。長いランダム文字列を設定
EASY_SHIP_EXT_TOKEN=
# 拡張からの操作ログに注文番号を保存することを許可 (1で有効。既定: 破棄する)
EASY_SHIP_ALLOW_ORDER_ID_LOGGING=

# 返信文のAI書き換え (apps/inquiry-hub/ai-rewrite.js — ✨丁寧に/やわらかく/簡潔に)
# OpenAI APIキー (未設定ならボタン自体が出ない = ダークローンチ)
OPENAI_API_KEY=
# 使用モデル (既定 gpt-5.6-luna。品質を上げたいときは gpt-5.4-mini 等へ)
OPENAI_REWRITE_MODEL=
