          "source": "app_statement_budget",
          "stage": "month_body"
        }
      },
      "expect": {
        "code": "PROFIT_PARTIAL_FAILED",
        "reason": "MONTH_STATEMENT_TIMEOUT",
        "respond": true,
        "send_rollback": true,
        "failed_months": true,
        "log": "month_statement_timeout"
      }
