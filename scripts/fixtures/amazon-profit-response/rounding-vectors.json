{
  "_note": "Decimal の足し算と丸め (PostgreSQL の round(sum(numeric), 2) = 0 から遠い方へ)。試験で JS の参照の組み立てと PGlite の round の両方と突き合わせる。月ごとに丸めてから足すと合わない例を含む",
  "cases": [
    { "raws": ["0.005"], "expected": "0.01" },
    { "raws": ["-0.005"], "expected": "-0.01" },
    { "raws": ["0.004"], "expected": "0.00" },
    { "raws": ["-0.004"], "expected": "0.00" },
    { "raws": ["2.675"], "expected": "2.68" },
    { "raws": ["-2.675"], "expected": "-2.68" },
    { "raws": ["1.234999999999"], "expected": "1.23" },
    { "raws": ["0.1", "0.2"], "expected": "0.30" },
    { "raws": ["100.004", "200.004", "0.004"], "expected": "300.01" },
    { "raws": ["-1000.0025", "-500.0025"], "expected": "-1500.01" },
    { "raws": ["-0.0049", "0.0049"], "expected": "0.00" },
    { "raws": ["525445.4505454545", "1090909.0909090909", "0"], "expected": "1616354.54" },
    { "raws": ["9007199254740993.125", "0.005"], "expected": "9007199254740993.13" },
    { "raws": ["5"], "expected": "5.00" },
    { "raws": ["-12.3"], "expected": "-12.30" },
    { "raws": ["0", "0.00", "-0"], "expected": "0.00" }
  ]
}
