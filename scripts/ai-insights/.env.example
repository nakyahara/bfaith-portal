# C:\tools\ai-insights\.env にコピーして値を設定 (このファイル自体には実値を書かない)
# ⚠️ 値の作成・設定は中原さんが行う (Claude は触らない)

# bfaith-portal のURL
PORTAL_BASE_URL=https://bfaith-portal.onrender.com

# Render env と同じ値 (read-only / 書き込み)
AI_READ_TOKEN=
AI_INSIGHT_SERVICE_TOKEN=

# 経営インサイトスペースの Incoming Webhook URL
GCHAT_WEBHOOK_URL=

# ↓ 通常は変更不要
# CLAUDE_CMD=claude
# DEADLINE_HOUR=18
# CLAUDE_TIMEOUT_MS=600000
