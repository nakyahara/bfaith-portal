# モールCSV自動取得ツール — 認証情報テンプレート
#
# ⚠️ このファイルは雛形です。コピーして .env を作り、そこに実値を記入してください。
# ⚠️ .env は絶対にコミットしないこと (.gitignore 済み)。
# ⚠️ 記入は中原さん。Claude は実値を読み書きしません (secret不触の原則)。
#
# 推奨: 個人アカウントではなく「店舗運用専用の楽天会員ID + R-Login従業員ID」を新設して使う
#       (要件定義 §9-3 の決定)

# --- 楽天RMS 3段階ログイン ---
RMS_RLOGIN_ID=
RMS_RLOGIN_PW=
RMS_MEMBER_ID=
RMS_MEMBER_PW=

# --- 実行オプション ---
# 0 = ブラウザ表示 (検証はまずこちら) / 1 = ヘッドレス (無人運用)
HEADLESS=0

# --- P1で使用 (P0時点では未使用) ---
# Render 取込APIへCSVをPOSTする際のトークン (手動アップロードと同一コードパス)
# INGEST_API_BASE=https://bfaith-portal.onrender.com
# INGEST_API_TOKEN=

# GChat 失敗通知 (無音停止禁止の原則)
# GCHAT_WEBHOOK_INSIGHT=
