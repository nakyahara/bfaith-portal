+<!DOCTYPE html>
+<html lang="ja">
+<head>
+  <meta charset="utf-8">
+  <title>B-Faith ABAキーワード — 設定</title>
+  <style>
+    body { font-family: "Segoe UI", "Hiragino Sans", sans-serif; max-width: 560px; margin: 32px auto; padding: 0 16px; color: #222; }
+    h1 { font-size: 18px; }
+    label { display: block; margin: 16px 0 4px; font-weight: 600; }
+    input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
+    button { margin-top: 16px; margin-right: 8px; padding: 8px 20px; border: none; border-radius: 6px; cursor: pointer; }
+    #save { background: #1d6428; color: #fff; }
+    #test { background: #0f4d7a; color: #fff; }
