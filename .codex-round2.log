154-/**
155- * state ファイル読み込み。
156- * 戻り値:
157- *   { found: false }                              ファイル無し (no-op で終了)
158- *   { found: true, state }                        正常読み込み
159- *   { found: true, state: null, parseError }      破損 (呼び出し側で deleteState を試みる)
160- */
161-function loadState() {
162-  if (!fs.existsSync(RETRY_STATE_FILE)) return { found: false };
163-  try {
164-    const json = fs.readFileSync(RETRY_STATE_FILE, 'utf-8');
165-    return { found: true, state: JSON.parse(json) };
166-  } catch (e) {
167-    console.error('[Retry] state file 読み込み失敗:', e.message);
168-    return { found: true, state: null, parseError: e.message };
169-  }
170-}
