+async function notifyFailure(error) {
+  const webhook = process.env.GCHAT_WEBHOOK_YAHOO_INQUIRY;
+  if (!webhook) return;
+  const text = `笶・Yahoo!蝠上＞蜷医ｏ縺帙メ繧ｧ繝・け縺ｮ螳溯｡後↓螟ｱ謨・ ${String(error?.message || error).slice(0, 300)}\n`
+    + '(daily-sync 縺ｮ retry 縺ｧ蠖捺律荳ｭ縺ｫ閾ｪ蜍募・螳溯｡後＆繧後∪縺吶る｣邯壹＠縺ｦ蜃ｺ繧句ｴ蜷医・隕∬ｪｿ譟ｻ)';
+  try {
+    await sendGChatMessage(webhook, text);
+  } catch (e) {
+    console.warn(`[${TAG}] 螟ｱ謨鈴夂衍縺ｮ騾∽ｿ｡繧ゅ〒縺阪∪縺帙ｓ縺ｧ縺励◆: ${e.message}`);
