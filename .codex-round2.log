506:++}
507:++function eq(actual, expected, label) {
508:++  const a = JSON.stringify(actual);
509:++  const e = JSON.stringify(expected);
510:++  if (a === e) { pass++; return; }
511:++  fail++;
512:++  console.error(`  ✗ ${label}\n      期待: ${e}\n      実際: ${a}`);
513:++}
514:++async function throws(fn, re, label) {
515:++  try {
516:++    await fn();
517:++    fail++;
518:++    console.error(`  ✗ ${label} (throw されなかった)`);
519:++  } catch (e) {
520:++    if (re.test(e.message)) { pass++; return; }
521:++    fail++;
522:++    console.error(`  ✗ ${label}\n      期待パターン: ${re}\n      実際: ${e.message}`);
523:++  }
524:++}
525:++function section(name) { console.log(`\n── ${name}`); }
