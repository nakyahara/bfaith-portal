+}
+
+/**
+ * 讀懃衍 竊・騾夂衍縲・+ * @returns {Promise<{ok:boolean, note:string, text:string|null, unanswered:object, uncompleted:object}>}
+ */
+export async function runYahooInquiryAlert(opts = {}) {
+  // 騾√ｊ蜈医′辟｡縺・・縺ｯ險ｭ螳壽ｼ上ｌ縲・PI 繧定ｧｦ繧句燕縺ｫ關ｽ縺ｨ縺・(髱吶°縺ｫ辟｡騾夂衍縺ｫ縺励↑縺・
+  const webhook = process.env.GCHAT_WEBHOOK_YAHOO_INQUIRY;
+  if (!opts.dryRun && !webhook) {
+    throw new Error('GCHAT_WEBHOOK_YAHOO_INQUIRY 譛ｪ險ｭ螳壹・縺溘ａ騾夂衍縺ｧ縺阪∪縺帙ｓ');
+  }
+
+  const result = await fetchInquiryStatus(opts);
+  const text = buildMessage(result);
+  const note = `譛ｪ霑比ｿ｡${result.unanswered.count}莉ｶ / 螳御ｺ・・逅・ｾ・■${result.uncompleted.count}莉ｶ`;
+
+  if (opts.dryRun) {
+    console.log(`[${TAG}] dry-run (${note})`);
+    console.log(text ?? '(隧ｲ蠖・莉ｶ 窶・騾夂衍縺ｪ縺・');
+    return { ...result, ok: true, note: `${note} (dry-run)`, text };
+  }
+
+  if (text === null) {
+    // 隧ｲ蠖薙ぞ繝ｭ縺ｯ騾夂衍縺励↑縺・ｻ墓ｧ倥ゅ悟ｮ溯｡後＆繧後◆縺九阪・ daily-sync 縺ｮ繧ｵ繝槭Μ縺ｨ螳溯｡後Ο繧ｰ縺ｧ遒ｺ隱阪〒縺阪ｋ
+    console.log(`[${TAG}] 隧ｲ蠖・莉ｶ縺ｮ縺溘ａ騾夂衍縺ｪ縺・(${note})`);
+    return { ...result, ok: true, note, text };
+  }
+
+  await sendWithRetry(webhook, text);
+  console.log(`[${TAG}] 騾夂衍縺励∪縺励◆ (${note})`);
+  return { ...result, ok: true, note, text };
+}
+
+/**
+ * 螳溯｡悟､ｱ謨励ｒ蜷後§ webhook 縺ｸ遏･繧峨○繧・(best effort 窶・縺薙ｌ閾ｪ菴薙・螟ｱ謨励〒蜈・・繧ｨ繝ｩ繝ｼ繧帝國縺輔↑縺・縲・+ * 隧ｲ蠖薙ぞ繝ｭ=辟｡騾夂衍 縺ｮ莉墓ｧ倥↑縺ｮ縺ｧ縲∝､ｱ謨励ｒ騾夂衍縺励↑縺・→縲碁撕縺九↑蛛懈ｭ｢縲阪→縲悟ｹｳ蜥後↑0莉ｶ縲阪ｒ
