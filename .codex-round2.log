185-/**
186- * state ファイル削除。成否を返す。
187- * - ファイル無し: ok (成功扱い)
188- * - 削除成功: ok
189- * - 削除失敗: ok=false + error (呼び出し側で通知)
190- *   stale state が残ると後続 retry が誤実行するため、失敗は明示する。
191- */
192-function deleteState() {
193-  try {
194-    fs.unlinkSync(RETRY_STATE_FILE);
195-    return { ok: true };
196-  } catch (e) {
197-    if (e.code === 'ENOENT') return { ok: true };
198-    return { ok: false, error: e.message };
199-  }
200-}
