+async function sendWithRetry(webhook, text) {
+  try {
+    await sendGChatMessage(webhook, text);
+  } catch (e) {
+    console.warn(`[${TAG}] GChat騾∽ｿ｡縺ｫ螟ｱ謨励・0遘貞ｾ後↓蜀崎ｩｦ陦・ ${e.message}`);
+    await new Promise(r => setTimeout(r, 10_000));
