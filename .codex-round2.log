+  const received = fmtJstFromUnixSec(it.userPostTime) || '-';
+  const times = kind === 'uncompleted' && it.sellerPostTime
+    ? `蜿嶺ｿ｡ ${received} / 霑比ｿ｡ ${fmtJstFromUnixSec(it.sellerPostTime)}`
+    : `蜿嶺ｿ｡ ${received}`;
+  return `繝ｻ[${tag}] ${truncate(it.title, 40)} (${times})`;
+}
+
+/**
+ * 騾夂衍譛ｬ譁・ｒ邨・∩遶九※繧九・*荳｡譁ｹ0莉ｶ縺ｪ繧・null** (隧ｲ蠖薙ぞ繝ｭ縺ｯ騾夂衍縺励↑縺・ｻ墓ｧ・窶・+ * 縲碁夂衍縺梧擂縺・= 菴輔°蟇ｾ蠢懊′蠢・ｦ√阪→蛻・°繧九ｈ縺・↓縺吶ｋ縲ょｮ溯｡後・逕溷ｭ倡｢ｺ隱阪・ daily-sync 蛛ｴ縺梧球縺・縲・+ */
+export function buildMessage({ unanswered, uncompleted }) {
+  const total = unanswered.count + uncompleted.count;
+  if (total === 0) return null;
+
+  const lines = [];
+  lines.push(`笞・・*Yahoo!蝠上＞蜷医ｏ縺帙↓蟇ｾ蠢懊′蠢・ｦ√↑繧ゅ・縺・{total}莉ｶ縺ゅｊ縺ｾ縺・`);
+
+  if (unanswered.count > 0) {
+    lines.push('');
+    lines.push(`閥 譛ｪ霑比ｿ｡ (蜃ｺ蠎苓・屓遲泌ｾ・■): *${unanswered.count}莉ｶ*`);
+    for (const it of unanswered.items.slice(0, MAX_SHOW)) lines.push(itemLine(it, 'unanswered'));
+    if (unanswered.count > MAX_SHOW) lines.push(`  窶ｦ莉・${unanswered.count - MAX_SHOW}莉ｶ`);
+  }
+
+  if (uncompleted.count > 0) {
+    lines.push('');
+    lines.push(`泯 霑比ｿ｡貂医∩縺縺後悟ｮ御ｺ・☆繧九阪′謚ｼ縺輔ｌ縺ｦ縺・↑縺・ *${uncompleted.count}莉ｶ*`);
+    for (const it of uncompleted.items.slice(0, MAX_SHOW)) lines.push(itemLine(it, 'uncompleted'));
+    if (uncompleted.count > MAX_SHOW) lines.push(`  窶ｦ莉・${uncompleted.count - MAX_SHOW}莉ｶ`);
+  }
+
+  lines.push('');
+  lines.push('繧ｹ繝医い繧ｯ繝ｪ繧ｨ繧､繧ｿ繝ｼPro縲悟撫縺・粋繧上○邂｡逅・阪〒霑比ｿ｡繝ｻ螳御ｺ・・逅・ｒ縺励※縺上□縺輔＞');
+  return lines.join('\n');
+}
