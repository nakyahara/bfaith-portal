1366:+    fail++;
1367:+    console.error(`  ✗ ${label}\n      期待パターン: ${re}\n      実際: ${e.message}`);
1368:+  }
1369:+}
1370:+function section(name) { console.log(`\n── ${name}`); }
1371:+
1372:+// テスト用の一覧レスポンスを組み立てる
1373:+function listJson({ filter, count, headlines }) {
1374:+  return {
1375:+    summary: { filter, unansweredCount: 0, topic: { start: 1, end: headlines.length, count } },
1376:+    headlines,
1377:+  };
1378:+}
1379:+function headline(over = {}) {
1380:+  return {
1381:+    topicId: over.topicId ?? 't-default',
1382:+    isUnread: false,
1383:+    isNoAnswer: false,
1384:+    isCompleted: false,
1385:+    title: 'テスト質問',
1386:+    userPostTime: 1754870400, // 2026-08-11 09:00 JST
1387:+    sellerPostTime: null,
1388:+    ...over,
1389:+  };
1390:+}
1391:+
1392:+// fetchImpl スタブ: URLの requestFilter/serviceType を見て応答を返す
1393:+function stubFetch(responses) {
1394:+  const calls = [];
1395:+  const impl = async (urlStr) => {
1396:+    const u = new URL(urlStr);
1397:+    const key = `${u.searchParams.get('requestFilter')}/${u.searchParams.get('serviceType')}`;
1398:+    calls.push({ key, params: Object.fromEntries(u.searchParams) });
1399:+    const r = responses[key];
1400:+    if (!r) throw new Error(`スタブ未定義: ${key}`);
1401:+    if (r.status && r.status !== 200) {
1402:+      return { status: r.status, text: async () => r.body ?? '<Error><Code>px-test</Code></Error>' };
1403:+    }
1404:+    return { status: 200, text: async () => JSON.stringify(r.json) };
1405:+  };
1406:+  impl.calls = calls;
1407:+  return impl;
1408:+}
1409:+
