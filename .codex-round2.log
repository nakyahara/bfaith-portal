172-/**
173- * state ファイル書き込み。成否を返す。
174- * 失敗時は呼び出し側で「state 不整合の恐れあり」として通知すべき。
175- */
176-function saveState(state) {
177-  try {
178-    fs.writeFileSync(RETRY_STATE_FILE, JSON.stringify(state, null, 2));
179-    return { ok: true };
180-  } catch (e) {
181-    return { ok: false, error: e.message };
182-  }
183-}
