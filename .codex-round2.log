+// 笏笏笏 GChat 譛ｬ譁・笏笏笏
+
+/**
+ * 鬘ｧ螳｢蜈･蜉・(繧ｿ繧､繝医Ν) 繧帝夂衍縺ｸ霈峨○繧句燕縺ｮ辟｡螳ｳ蛹・(Codex繝ｬ繝薙Η繝ｼ Medium)縲・+ * 謾ｹ陦後・蛻ｶ蠕｡譁・ｭ励〒騾夂衍縺ｮ繧ｻ繧ｯ繧ｷ繝ｧ繝ｳ蛛ｽ陬・ｒ縺輔ｌ縺ｪ縺・/ GChat 縺ｮ繝｡繝ｳ繧ｷ繝ｧ繝ｳ險俶ｳ・+ * (<users/all> 遲・ 繧堤匱蜍輔＆縺帙↑縺・り｣・｣ｾ險俶ｳ・(*) 縺ｯ隕九◆逶ｮ縺縺代↑縺ｮ縺ｧ險ｱ螳ｹ
+ */
+export function sanitizeForChat(s) {
+  return String(s || '')
+    .replace(/[\u0000-\u001f\u007f]+/g, ' ')            // 謾ｹ陦後・繧ｿ繝門性繧蛻ｶ蠕｡譁・ｭ・竊・遨ｺ逋ｽ
+    .replace(/<(users|rooms)\//gi, '<\u200b$1/')       // 繝｡繝ｳ繧ｷ繝ｧ繝ｳ險俶ｳ輔ｒ繧ｼ繝ｭ蟷・せ繝壹・繧ｹ縺ｧ蛻・妙
+    .trim();
+}
+
+function truncate(s, n) {
+  const str = sanitizeForChat(s);
+  return str.length > n ? `${str.slice(0, n)}窶ｦ` : str;
+}
+
+function itemLine(it, kind) {
