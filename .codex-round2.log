527:++// テスト用の一覧レスポンスを組み立てる
528:++function listJson({ filter, count, headlines }) {
529:++  return {
530:++    summary: { filter, unansweredCount: 0, topic: { start: 1, end: headlines.length, count } },
531:++    headlines,
532:++  };
533:++}
534:++function headline(over = {}) {
535:++  return {
536:++    topicId: over.topicId ?? 't-default',
537:++    isUnread: false,
538:++    isNoAnswer: false,
539:++    isCompleted: false,
540:++    title: 'テスト質問',
541:++    userPostTime: 1754870400, // 2026-08-11 09:00 JST
542:++    sellerPostTime: null,
543:++    ...over,
544:++  };
545:++}
546:++
547:++// fetchImpl スタブ: URLの requestFilter/serviceType を見て応答を返す
548:++function stubFetch(responses) {
549:++  const calls = [];
550:++  const impl = async (urlStr) => {
551:++    const u = new URL(urlStr);
552:++    const key = `${u.searchParams.get('requestFilter')}/${u.searchParams.get('serviceType')}`;
553:++    calls.push({ key, params: Object.fromEntries(u.searchParams) });
554:++    const r = responses[key];
555:++    if (!r) throw new Error(`スタブ未定義: ${key}`);
556:++    if (r.status && r.status !== 200) {
557:++      return { status: r.status, text: async () => r.body ?? '<Error><Code>px-test</Code></Error>' };
558:++    }
559:++    return { status: 200, text: async () => JSON.stringify(r.json) };
560:++  };
561:++  impl.calls = calls;
562:++  return impl;
563:++}
