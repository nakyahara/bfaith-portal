77:+diff --git a/apps/yahoo-inquiry-alert/notify-job.js b/apps/yahoo-inquiry-alert/notify-job.js
78:+new file mode 100644
79:+index 0000000..a90c763
80:+--- /dev/null
81:++++ b/apps/yahoo-inquiry-alert/notify-job.js
82:+@@ -0,0 +1,137 @@
83:++/**
84:++ * Yahoo!ショッピング 問い合わせ対応漏れチェック — 検知して GChat へ通知する (ミニPC実行)
85:++ *
86:++ * 何を見ているか (詳細は service.js の冒頭コメント):
87:++ *   ① 未返信 (出店者回答待ち) の問い合わせ
88:++ *   ② 返信済みだが「完了する」(回答済み) 処理がされていない問い合わせ
89:++ *   対象は「通常」と「オークション (落札前)」の両方。**該当が1件以上あるときだけ**通知する。
90:++ *
91:++ * どこで動くか:
92:++ *   ミニPC の daily-sync (毎朝07:00) の1ステップ (未発送アラート群の直後)。
93:++ *   warehouse.db には依存しない (Yahoo!の問い合わせAPIを直接読むだけ)。
94:++ *   失敗した日は retry-failed-jobs (08:30/10:00/11:30) が拾って当日中に再実行する。
95:++ *
96:++ * 安全設計:
97:++ *   - 照会のみ。返信・完了処理・既読化などデータ変更は一切しない
98:++ *     (VPSプロキシの read-only passthrough しか叩かない)
99:++ *   - 実行失敗 (認証切れ・API変更など) も同じ webhook に ❌ で通知する
100:++ *     (該当ゼロ=無通知 の仕様なので、静かに止まると気づけないため)
101:++ *   - 件数が読み取れないときは 0件と混同せずエラーにする (service.js の fail-closed 検証)
102:++ *
103:++ * 環境変数 (ミニPC の .env):
104:++ *   GCHAT_WEBHOOK_YAHOO_INQUIRY     … 通知先スペースの webhook (必須)
105:++ *   YAHOO_PROXY_URL / YAHOO_PROXY_SECRET … VPSプロキシ (既存のYahoo設定を使う)
106:++ *
107:++ * 使い方:
108:++ *   node apps/yahoo-inquiry-alert/notify-job.js --once       … 実行して該当があれば GChat へ送る
109:++ *   node apps/yahoo-inquiry-alert/notify-job.js --dry-run    … 送らずに結果を標準出力へ
110:++ */
111:++import 'dotenv/config';
112:++import fs from 'node:fs';
113:++import { fileURLToPath } from 'node:url';
114:++import { fetchInquiryStatus, buildMessage } from './service.js';
115:++import { sendGChatMessage } from '../profit-analysis/gchat-client.js';
116:++
117:++const TAG = 'yahoo-inquiry';
118:++
119:++/** GChat 送信。一時障害に備えて1回だけリトライする */
120:++async function sendWithRetry(webhook, text) {
121:++  try {
122:++    await sendGChatMessage(webhook, text);
123:++  } catch (e) {
124:++    console.warn(`[${TAG}] GChat送信に失敗、10秒後に再試行: ${e.message}`);
125:++    await new Promise(r => setTimeout(r, 10_000));
126:++    await sendGChatMessage(webhook, text);
127:++  }
128:++}
129:++
130:++/**
131:++ * 検知 → 通知。
132:++ * @returns {Promise<{ok:boolean, note:string, text:string|null, unanswered:object, uncompleted:object}>}
133:++ */
134:++export async function runYahooInquiryAlert(opts = {}) {
135:++  // 送り先が無いのは設定漏れ。API を触る前に落とす (静かに無通知にしない)
136:++  const webhook = process.env.GCHAT_WEBHOOK_YAHOO_INQUIRY;
137:++  if (!opts.dryRun && !webhook) {
138:++    throw new Error('GCHAT_WEBHOOK_YAHOO_INQUIRY 未設定のため通知できません');
139:++  }
140:++
141:++  const result = await fetchInquiryStatus(opts);
142:++  const text = buildMessage(result);
143:++  const note = `未返信${result.unanswered.count}件 / 完了処理待ち${result.uncompleted.count}件`;
144:++
145:++  if (opts.dryRun) {
146:++    console.log(`[${TAG}] dry-run (${note})`);
147:++    console.log(text ?? '(該当0件 — 通知なし)');
148:++    return { ...result, ok: true, note: `${note} (dry-run)`, text };
149:++  }
150:++
151:++  if (text === null) {
152:++    // 該当ゼロは通知しない仕様。「実行されたか」は daily-sync のサマリと実行ログで確認できる
153:++    console.log(`[${TAG}] 該当0件のため通知なし (${note})`);
154:++    return { ...result, ok: true, note, text };
155:++  }
156:++
157:++  await sendWithRetry(webhook, text);
158:++  console.log(`[${TAG}] 通知しました (${note})`);
159:++  return { ...result, ok: true, note, text };
160:++}
161:++
162:++/**
163:++ * 実行失敗を同じ webhook へ知らせる (best effort — これ自体の失敗で元のエラーを隠さない)。
164:++ * 該当ゼロ=無通知 の仕様なので、失敗を通知しないと「静かな停止」と「平和な0件」を
165:++ * 受け手が区別できない。retry (08:30/10:00/11:30) が成功すればその日は正常に戻る。
166:++ */
167:++async function notifyFailure(error) {
168:++  const webhook = process.env.GCHAT_WEBHOOK_YAHOO_INQUIRY;
169:++  if (!webhook) return;
170:++  const text = `❌ Yahoo!問い合わせチェックの実行に失敗: ${String(error?.message || error).slice(0, 300)}\n`
171:++    + '(daily-sync の retry で当日中に自動再実行されます。連続して出る場合は要調査)';
172:++  try {
173:++    await sendGChatMessage(webhook, text);
174:++  } catch (e) {
175:++    console.warn(`[${TAG}] 失敗通知の送信もできませんでした: ${e.message}`);
176:++  }
177:++}
178:++
179:++/**
180:++ * 終了処理。
181:++ * 🚨process.exit() を即座に呼ぶと、開いたままの fetch 接続の終了処理と競合して
182:++ *   Windows で `Assertion failed: !(handle->flags & UV_HANDLE_CLOSING)` abort になることがある
183:++ *   (2026-08-10 の yahoo-unshipped 初回本番で実発生。通知は送れているのに 0xC0000409 で
184:++ *    終了し、daily-sync が失敗と誤判定 → retry で通知が重複する)。
185:++ *   → exitCode を立てて自然終了させ、万一終わらない時だけ強制終了する (未発送アラート群と同じ形)。
186:++ */
187:++const FORCE_EXIT_AFTER_MS = 5000;
188:++
189:++export function finish(code) {
190:++  process.exitCode = code;
191:++  // unref するのでイベントループの終了は妨げない。発火した = 何かのハンドルが残っている
192:++  // 証拠なので、同期書き込みで必ず痕跡を残す (console.error は exit で捨てられうる)
193:++  setTimeout(() => {
194:++    const msg = `[${TAG}] ${FORCE_EXIT_AFTER_MS}ms 待っても終了しないため強制終了します (残っているハンドルを調べること)`;
195:++    try { fs.writeSync(2, msg + '\n'); } catch { /* 書けなくても終了は続ける */ }
196:++    process.exit(code);
197:++  }, FORCE_EXIT_AFTER_MS).unref();
198:++}
199:++
200:++// ─── CLI ───
201:++const isMain = process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1];
202:++if (isMain) {
203:++  const dryRun = process.argv.includes('--dry-run');
204:++  if (!dryRun && !process.argv.includes('--once')) {
205:++    console.log('使い方: node apps/yahoo-inquiry-alert/notify-job.js --once | --dry-run');
206:++    process.exit(1);
207:++  }
208:++  runYahooInquiryAlert({ dryRun })
209:++    .then(r => {
210:++      // daily-sync はこの行の末尾をサマリに載せる
211:++      console.log(`[${TAG}] 完了: ${r.note}`);
212:++      finish(0);
213:++    })
214:++    .catch(async e => {
215:++      console.error(`[${TAG}] 失敗:`, e.message);
216:++      if (!dryRun) await notifyFailure(e);
217:++      finish(1);
218:++    });
219:++}
220:+diff --git a/apps/yahoo-inquiry-alert/service.js b/apps/yahoo-inquiry-alert/service.js
221:+new file mode 100644
222:+index 0000000..65fca29
223:+--- /dev/null
224:++++ b/apps/yahoo-inquiry-alert/service.js
225:+@@ -0,0 +1,249 @@
226:++/**
227:++ * Yahoo!ショッピング 問い合わせ対応漏れチェック — 検知ロジック
228:++ *
229:++ * 目的:
230:++ *   問い合わせ回答率の悪化を防ぐ。返信していても「完了する」(回答済み) 処理を忘れると
231:++ *   回答率に反映されないため、次の2種類を毎朝検知して GChat に通知する:
232:++ *     ① 未返信 (出店者回答待ち)                 … isNoAnswer=true
233:++ *     ② 返信済みだが完了処理されていない        … isNoAnswer=false かつ isCompleted=false
234:++ *   対象はストアクリエイターPro 問い合わせ管理ツールの「通常」(shp) と
235:++ *   「オークション (落札前)」(auc) の両方。
236:++ *
237:++ * データ源: 問い合わせ管理API 質問一覧 (externalTalkList)。
238:++ *   https://developer.yahoo.co.jp/webapi/shopping/question/list.html
239:++ *   - VPSプロキシ (vps-proxy/aupay-proxy.js) の read-only passthrough 経由
240:++ *     (Yahoo!システムAPIは登録済み固定IPからしか呼べない。Bearer+公開鍵署名はVPS側で付与)
241:++ *   - requestFilter=unanswered / answered をサーバー側で絞り、**1ページ目だけ**読む。
242:++ *     件数は summary.topic.count (絞り込み後の総件数) から取るので全ページ走査は不要。
243:++ *     一覧はソート指定の降順 → 1ページ目 (20件) = 最新の該当分 = 通知に載せる分
244:++ *
245:++ * 🚨fail-closed の考え方 (0件と「読めない」を混同しない):
246:++ *   - summary.filter が要求した requestFilter と一致しなければエラー
247:++ *     (旧プロキシがパラメータを転送していない場合、全件が返って summary.filter='all' になる。
248:++ *      そのまま进むと件数を誤読するので必ず止める)
249:++ *   - unanswered の結果に isNoAnswer=false が混ざる、answered の結果に isCompleted=true が
250:++ *     混ざる場合もエラー (フィルタ語義が想定 (相互排他な状態) と違う = 件数を信用できない)
251:++ *   - shp と auc の結果に同じ topicId が出たらエラー (serviceType が効いていない)
252:++ *
253:++ * 個人情報: 通知に載せるのはタイトルと日時のみ。注文者名・マスクIDは扱わない。
254:++ */
255:++
256:++/** 1リクエスト/秒のレート制限 (公式)。余裕を持って1.1秒 */
257:++export const SLEEP_MS = 1100;
258:++/** 通知に載せる明細の上限 (カテゴリごと)。超えた分は件数だけ伝える */
259:++export const MAX_SHOW = 10;
260:++/** externalTalkList の1ページ上限 (公式仕様) */
261:++const PAGE_SIZE = 20;
262:++
263:++export const SERVICE_LABEL = { shp: '通常', auc: 'オークション' };
264:++
265:++/**
266:++ * 実行する照会の一覧。
267:++ *   kind 'unanswered'  = ① 未返信 → 顧客の最終投稿 (userPostTime) が新しい順
268:++ *   kind 'uncompleted' = ② 返信済み・完了処理待ち → 店舗の最終返信 (sellerPostTime) が新しい順
269:++ */
270:++export const QUERIES = [
271:++  { serviceType: 'shp', requestFilter: 'unanswered', kind: 'unanswered', sort: 'userPostTime' },
272:++  { serviceType: 'auc', requestFilter: 'unanswered', kind: 'unanswered', sort: 'userPostTime' },
273:++  { serviceType: 'shp', requestFilter: 'answered', kind: 'uncompleted', sort: 'sellerPostTime' },
274:++  { serviceType: 'auc', requestFilter: 'answered', kind: 'uncompleted', sort: 'sellerPostTime' },
275:++];
276:++
277:++export function proxyConfig(env = process.env) {
278:++  const base = (env.YAHOO_PROXY_URL || 'http://133.167.122.198:8080').replace(/\/+$/, '');
279:++  const secret = env.YAHOO_PROXY_SECRET || env.AUPAY_PROXY_SECRET || '';
280:++  if (!secret) throw new Error('YAHOO_PROXY_SECRET (または AUPAY_PROXY_SECRET) が未設定です');
281:++  return { base, secret };
282:++}
283:++
284:++/** UNIX秒 → 'M/D HH:MM' (JST)。不正は null */
285:++export function fmtJstFromUnixSec(v) {
286:++  const n = Number(v);
287:++  if (!Number.isFinite(n) || n <= 0) return null;
288:++  const t = new Date(n * 1000 + 9 * 3600 * 1000);
289:++  const pad2 = x => String(x).padStart(2, '0');
290:++  return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${pad2(t.getUTCHours())}:${pad2(t.getUTCMinutes())}`;
291:++}
292:++
293:++function contractError(msg) {
294:++  const e = new Error(msg);
295:++  e.errorType = 'contract_violation';
296:++  return e;
297:++}
298:++
299:++/**
300:++ * 一覧レスポンス1ページ分を検証する。壊れていたら throw (握り潰さない)。
301:++ * @returns {{count:number, headlines:object[]}}
302:++ */
303:++export function validateListResponse(json, q) {
304:++  const label = `${q.requestFilter}/${q.serviceType}`;
305:++  const filter = json?.summary?.filter;
306:++  // 旧プロキシは requestFilter を転送しない → Yahoo!は全件を返し filter='all' になる。
307:++  // ここで止めないと「全問い合わせ数」を「対応漏れ数」と誤読する
308:++  if (filter !== q.requestFilter) {
309:++    throw contractError(`summary.filter='${filter}' が要求 '${q.requestFilter}' と一致しません`
310:++      + ` (VPSプロキシが絞り込みパラメータ未対応の可能性。${label})`);
311:++  }
312:++  const count = json?.summary?.topic?.count;
313:++  if (!Number.isFinite(count) || count < 0) {
314:++    throw contractError(`summary.topic.count が読み取れません (${label}: ${JSON.stringify(count)})`);
315:++  }
316:++  const headlines = json?.headlines;
317:++  if (!Array.isArray(headlines)) {
318:++    throw contractError(`headlines が配列でありません (${label})`);
319:++  }
320:++  for (const h of headlines) {
321:++    if (!h?.topicId) throw contractError(`topicId のない行があります (${label})`);
322:++    if (typeof h.isNoAnswer !== 'boolean' || typeof h.isCompleted !== 'boolean') {
323:++      throw contractError(`isNoAnswer/isCompleted が真偽値でありません (${label}: ${h.topicId})`);
324:++    }
325:++    // フィルタ語義の検証: unanswered に返信済みが混ざる / answered に未返信・完了済みが
326:++    // 混ざるなら、summary.topic.count を「その分類の件数」として信用できない
327:++    if (q.kind === 'unanswered' && h.isNoAnswer !== true) {
328:++      throw contractError(`unanswered の結果に返信済み (isNoAnswer=false) が混ざっています (${label}: ${h.topicId})`);
329:++    }
330:++    if (q.kind === 'uncompleted' && (h.isNoAnswer !== false || h.isCompleted !== false)) {
331:++      throw contractError(`answered の結果に想定外の状態が混ざっています`
332:++        + ` (${label}: ${h.topicId} isNoAnswer=${h.isNoAnswer} isCompleted=${h.isCompleted})`);
333:++    }
334:++    // serviceType が返ってくる場合は要求と一致すること (無指定転送の検出)
335:++    if (h.serviceType != null && h.serviceType !== q.serviceType) {
336:++      throw contractError(`serviceType='${h.serviceType}' が要求 '${q.serviceType}' と一致しません (${label}: ${h.topicId})`);
337:++    }
338:++  }
339:++  return { count, headlines };
340:++}
341:++
342:++/** 一覧行 → 通知に載せる1件 (タイトルと日時のみ。個人情報は持たない) */
343:++export function toItem(h, q) {
344:++  return {
345:++    topicId: String(h.topicId),
346:++    serviceType: q.serviceType,
347:++    title: String(h.title || '(タイトルなし)'),
348:++    userPostTime: Number(h.userPostTime) || null,
349:++    sellerPostTime: h.sellerPostTime == null ? null : Number(h.sellerPostTime) || null,
350:++    sortTime: Number(h[q.sort]) || 0,
351:++  };
352:++}
353:++
354:++/**
355:++ * 4照会 (shp/auc × unanswered/answered) を実行して分類する。
356:++ * @param {{fetchImpl?:Function, sleepMs?:number, timeoutMs?:number, env?:object}} opts
357:++ * @returns {Promise<{unanswered:{count:number, items:object[]}, uncompleted:{count:number, items:object[]}}>}
358:++ *   count = Yahoo!側の総件数 (summary.topic.count の合算)、items = 新しい順の明細 (最大20件/照会)
359:++ */
360:++export async function fetchInquiryStatus(opts = {}) {
361:++  const fetchImpl = opts.fetchImpl ?? fetch;
362:++  const sleepMs = opts.sleepMs ?? SLEEP_MS;
363:++  const timeoutMs = opts.timeoutMs ?? 45000;
364:++  const { base, secret } = proxyConfig(opts.env ?? process.env);
365:++
366:++  const out = {
367:++    unanswered: { count: 0, items: [] },
368:++    uncompleted: { count: 0, items: [] },
369:++  };
370:++  const seen = new Map(); // topicId → query label (serviceType が効いていない事故の検出)
371:++  let requests = 0;
372:++
373:++  for (const q of QUERIES) {
374:++    if (requests > 0) await new Promise(r => setTimeout(r, sleepMs));
375:++    requests++;
376:++
377:++    const u = new URL(`${base}/yahoo/externalTalkList`);
378:++    u.searchParams.set('start', '1');
379:++    u.searchParams.set('result', String(PAGE_SIZE));
380:++    u.searchParams.set('requestFilter', q.requestFilter);
381:++    u.searchParams.set('serviceType', q.serviceType);
382:++    u.searchParams.set('sort', q.sort);
383:++    u.searchParams.set('sortOrder', 'desc');
384:++
385:++    const label = `${q.requestFilter}/${q.serviceType}`;
386:++    let res;
387:++    try {
388:++      res = await fetchImpl(u.toString(), {
389:++        headers: { 'X-Proxy-Secret': secret },
390:++        signal: AbortSignal.timeout(timeoutMs),
391:++      });
392:++    } catch (err) {
393:++      const timedOut = err?.name === 'TimeoutError' || err?.name === 'AbortError';
394:++      throw new Error(timedOut
395:++        ? `Yahooプロキシ タイムアウト (${timeoutMs}ms, ${label})`
396:++        : `Yahooプロキシ接続失敗 (${label}): ${err?.message || err}`);
397:++    }
398:++    const text = await res.text();
399:++    if (res.status !== 200) {
400:++      // Yahoo!のエラーはXML <Error><Code/>。コードだけ抜く (問い合わせ本文の露出防止)
401:++      const code = (text.match(/<Code>([^<]{1,40})<\/Code>/) || [])[1];
402:++      throw new Error(`Yahoo API HTTP ${res.status} (${label})${code ? ` code=${code}` : ''}`);
403:++    }
404:++    let json;
405:++    try { json = JSON.parse(text); } catch {
406:++      throw contractError(`Yahoo APIレスポンスがJSONでありません (${label}): ${text.length} bytes`);
407:++    }
408:++
409:++    const { count, headlines } = validateListResponse(json, q);
410:++    for (const h of headlines) {
411:++      const prev = seen.get(h.topicId);
412:++      if (prev) {
413:++        throw contractError(`同じ topicId が複数の照会に現れました (${prev} と ${label}: ${h.topicId})`
414:++          + ' — serviceType の絞り込みが効いていない可能性');
415:++      }
416:++      seen.set(h.topicId, label);
417:++    }
418:++    const bucket = out[q.kind];
419:++    bucket.count += count;
420:++    bucket.items.push(...headlines.map(h => toItem(h, q)));
421:++    console.log(`[yahoo-inquiry] ${label}: ${count}件`);
422:++  }
423:++
424:++  // shp と auc を混ぜて新しい順に (通知は最新のものから載せる)
425:++  out.unanswered.items.sort((a, b) => b.sortTime - a.sortTime);
426:++  out.uncompleted.items.sort((a, b) => b.sortTime - a.sortTime);
427:++  return out;
428:++}
429:++
430:++// ─── GChat 本文 ───
431:++
432:++function truncate(s, n) {
433:++  const str = String(s || '');
434:++  return str.length > n ? `${str.slice(0, n)}…` : str;
435:++}
436:++
437:++function itemLine(it, kind) {
438:++  const tag = SERVICE_LABEL[it.serviceType] || it.serviceType;
439:++  const received = fmtJstFromUnixSec(it.userPostTime) || '-';
440:++  const times = kind === 'uncompleted' && it.sellerPostTime
441:++    ? `受信 ${received} / 返信 ${fmtJstFromUnixSec(it.sellerPostTime)}`
442:++    : `受信 ${received}`;
443:++  return `・[${tag}] ${truncate(it.title, 40)} (${times})`;
444:++}
445:++
446:++/**
447:++ * 通知本文を組み立てる。**両方0件なら null** (該当ゼロは通知しない仕様 —
448:++ * 「通知が来た = 何か対応が必要」と分かるようにする。実行の生存確認は daily-sync 側が担う)。
449:++ */
450:++export function buildMessage({ unanswered, uncompleted }) {
451:++  const total = unanswered.count + uncompleted.count;
452:++  if (total === 0) return null;
453:++
454:++  const lines = [];
455:++  lines.push(`⚠️ *Yahoo!問い合わせに対応が必要なものが${total}件あります*`);
456:++
457:++  if (unanswered.count > 0) {
458:++    lines.push('');
459:++    lines.push(`🔴 未返信 (出店者回答待ち): *${unanswered.count}件*`);
460:++    for (const it of unanswered.items.slice(0, MAX_SHOW)) lines.push(itemLine(it, 'unanswered'));
461:++    if (unanswered.count > MAX_SHOW) lines.push(`  …他 ${unanswered.count - MAX_SHOW}件`);
462:++  }
463:++
464:++  if (uncompleted.count > 0) {
465:++    lines.push('');
466:++    lines.push(`🟡 返信済みだが「完了する」が押されていない: *${uncompleted.count}件*`);
467:++    for (const it of uncompleted.items.slice(0, MAX_SHOW)) lines.push(itemLine(it, 'uncompleted'));
468:++    if (uncompleted.count > MAX_SHOW) lines.push(`  …他 ${uncompleted.count - MAX_SHOW}件`);
469:++  }
470:++
471:++  lines.push('');
472:++  lines.push('ストアクリエイターPro「問い合わせ管理」で返信・完了処理をしてください');
473:++  return lines.join('\n');
474:++}
