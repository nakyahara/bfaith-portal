902:diff --git a/apps/yahoo-inquiry-alert/notify-job.js b/apps/yahoo-inquiry-alert/notify-job.js
903:new file mode 100644
904:index 0000000..a90c763
905:--- /dev/null
906:+++ b/apps/yahoo-inquiry-alert/notify-job.js
907:@@ -0,0 +1,137 @@
908:+/**
909:+ * Yahoo!ショッピング 問い合わせ対応漏れチェック — 検知して GChat へ通知する (ミニPC実行)
910:+ *
911:+ * 何を見ているか (詳細は service.js の冒頭コメント):
912:+ *   ① 未返信 (出店者回答待ち) の問い合わせ
913:+ *   ② 返信済みだが「完了する」(回答済み) 処理がされていない問い合わせ
914:+ *   対象は「通常」と「オークション (落札前)」の両方。**該当が1件以上あるときだけ**通知する。
915:+ *
916:+ * どこで動くか:
917:+ *   ミニPC の daily-sync (毎朝07:00) の1ステップ (未発送アラート群の直後)。
918:+ *   warehouse.db には依存しない (Yahoo!の問い合わせAPIを直接読むだけ)。
919:+ *   失敗した日は retry-failed-jobs (08:30/10:00/11:30) が拾って当日中に再実行する。
920:+ *
921:+ * 安全設計:
922:+ *   - 照会のみ。返信・完了処理・既読化などデータ変更は一切しない
923:+ *     (VPSプロキシの read-only passthrough しか叩かない)
924:+ *   - 実行失敗 (認証切れ・API変更など) も同じ webhook に ❌ で通知する
925:+ *     (該当ゼロ=無通知 の仕様なので、静かに止まると気づけないため)
926:+ *   - 件数が読み取れないときは 0件と混同せずエラーにする (service.js の fail-closed 検証)
927:+ *
928:+ * 環境変数 (ミニPC の .env):
929:+ *   GCHAT_WEBHOOK_YAHOO_INQUIRY     … 通知先スペースの webhook (必須)
930:+ *   YAHOO_PROXY_URL / YAHOO_PROXY_SECRET … VPSプロキシ (既存のYahoo設定を使う)
931:+ *
932:+ * 使い方:
933:+ *   node apps/yahoo-inquiry-alert/notify-job.js --once       … 実行して該当があれば GChat へ送る
934:+ *   node apps/yahoo-inquiry-alert/notify-job.js --dry-run    … 送らずに結果を標準出力へ
935:+ */
936:+import 'dotenv/config';
937:+import fs from 'node:fs';
938:+import { fileURLToPath } from 'node:url';
939:+import { fetchInquiryStatus, buildMessage } from './service.js';
940:+import { sendGChatMessage } from '../profit-analysis/gchat-client.js';
941:+
942:+const TAG = 'yahoo-inquiry';
943:+
944:+/** GChat 送信。一時障害に備えて1回だけリトライする */
945:+async function sendWithRetry(webhook, text) {
946:+  try {
947:+    await sendGChatMessage(webhook, text);
948:+  } catch (e) {
949:+    console.warn(`[${TAG}] GChat送信に失敗、10秒後に再試行: ${e.message}`);
950:+    await new Promise(r => setTimeout(r, 10_000));
951:+    await sendGChatMessage(webhook, text);
952:+  }
953:+}
954:+
955:+/**
956:+ * 検知 → 通知。
957:+ * @returns {Promise<{ok:boolean, note:string, text:string|null, unanswered:object, uncompleted:object}>}
958:+ */
959:+export async function runYahooInquiryAlert(opts = {}) {
960:+  // 送り先が無いのは設定漏れ。API を触る前に落とす (静かに無通知にしない)
961:+  const webhook = process.env.GCHAT_WEBHOOK_YAHOO_INQUIRY;
962:+  if (!opts.dryRun && !webhook) {
963:+    throw new Error('GCHAT_WEBHOOK_YAHOO_INQUIRY 未設定のため通知できません');
964:+  }
965:+
966:+  const result = await fetchInquiryStatus(opts);
967:+  const text = buildMessage(result);
968:+  const note = `未返信${result.unanswered.count}件 / 完了処理待ち${result.uncompleted.count}件`;
969:+
970:+  if (opts.dryRun) {
971:+    console.log(`[${TAG}] dry-run (${note})`);
972:+    console.log(text ?? '(該当0件 — 通知なし)');
973:+    return { ...result, ok: true, note: `${note} (dry-run)`, text };
974:+  }
975:+
976:+  if (text === null) {
977:+    // 該当ゼロは通知しない仕様。「実行されたか」は daily-sync のサマリと実行ログで確認できる
978:+    console.log(`[${TAG}] 該当0件のため通知なし (${note})`);
979:+    return { ...result, ok: true, note, text };
980:+  }
981:+
982:+  await sendWithRetry(webhook, text);
983:+  console.log(`[${TAG}] 通知しました (${note})`);
984:+  return { ...result, ok: true, note, text };
985:+}
986:+
987:+/**
988:+ * 実行失敗を同じ webhook へ知らせる (best effort — これ自体の失敗で元のエラーを隠さない)。
989:+ * 該当ゼロ=無通知 の仕様なので、失敗を通知しないと「静かな停止」と「平和な0件」を
990:+ * 受け手が区別できない。retry (08:30/10:00/11:30) が成功すればその日は正常に戻る。
991:+ */
992:+async function notifyFailure(error) {
993:+  const webhook = process.env.GCHAT_WEBHOOK_YAHOO_INQUIRY;
994:+  if (!webhook) return;
995:+  const text = `❌ Yahoo!問い合わせチェックの実行に失敗: ${String(error?.message || error).slice(0, 300)}\n`
996:+    + '(daily-sync の retry で当日中に自動再実行されます。連続して出る場合は要調査)';
997:+  try {
998:+    await sendGChatMessage(webhook, text);
999:+  } catch (e) {
1000:+    console.warn(`[${TAG}] 失敗通知の送信もできませんでした: ${e.message}`);
1001:+  }
1002:+}
1003:+
1004:+/**
1005:+ * 終了処理。
1006:+ * 🚨process.exit() を即座に呼ぶと、開いたままの fetch 接続の終了処理と競合して
1007:+ *   Windows で `Assertion failed: !(handle->flags & UV_HANDLE_CLOSING)` abort になることがある
1008:+ *   (2026-08-10 の yahoo-unshipped 初回本番で実発生。通知は送れているのに 0xC0000409 で
1009:+ *    終了し、daily-sync が失敗と誤判定 → retry で通知が重複する)。
1010:+ *   → exitCode を立てて自然終了させ、万一終わらない時だけ強制終了する (未発送アラート群と同じ形)。
1011:+ */
1012:+const FORCE_EXIT_AFTER_MS = 5000;
1013:+
1014:+export function finish(code) {
1015:+  process.exitCode = code;
1016:+  // unref するのでイベントループの終了は妨げない。発火した = 何かのハンドルが残っている
1017:+  // 証拠なので、同期書き込みで必ず痕跡を残す (console.error は exit で捨てられうる)
1018:+  setTimeout(() => {
1019:+    const msg = `[${TAG}] ${FORCE_EXIT_AFTER_MS}ms 待っても終了しないため強制終了します (残っているハンドルを調べること)`;
1020:+    try { fs.writeSync(2, msg + '\n'); } catch { /* 書けなくても終了は続ける */ }
1021:+    process.exit(code);
1022:+  }, FORCE_EXIT_AFTER_MS).unref();
1023:+}
1024:+
1025:+// ─── CLI ───
1026:+const isMain = process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1];
1027:+if (isMain) {
1028:+  const dryRun = process.argv.includes('--dry-run');
1029:+  if (!dryRun && !process.argv.includes('--once')) {
1030:+    console.log('使い方: node apps/yahoo-inquiry-alert/notify-job.js --once | --dry-run');
1031:+    process.exit(1);
1032:+  }
1033:+  runYahooInquiryAlert({ dryRun })
1034:+    .then(r => {
1035:+      // daily-sync はこの行の末尾をサマリに載せる
1036:+      console.log(`[${TAG}] 完了: ${r.note}`);
1037:+      finish(0);
1038:+    })
1039:+    .catch(async e => {
1040:+      console.error(`[${TAG}] 失敗:`, e.message);
1041:+      if (!dryRun) await notifyFailure(e);
1042:+      finish(1);
1043:+    });
1044:+}
1045:diff --git a/apps/yahoo-inquiry-alert/service.js b/apps/yahoo-inquiry-alert/service.js
1046:new file mode 100644
1047:index 0000000..621bd4d
1048:--- /dev/null
1049:+++ b/apps/yahoo-inquiry-alert/service.js
1050:@@ -0,0 +1,269 @@
1051:+/**
1052:+ * Yahoo!ショッピング 問い合わせ対応漏れチェック — 検知ロジック
1053:+ *
1054:+ * 目的:
1055:+ *   問い合わせ回答率の悪化を防ぐ。返信していても「完了する」(回答済み) 処理を忘れると
1056:+ *   回答率に反映されないため、次の2種類を毎朝検知して GChat に通知する:
1057:+ *     ① 未返信 (出店者回答待ち)                 … isNoAnswer=true
1058:+ *     ② 返信済みだが完了処理されていない        … isNoAnswer=false かつ isCompleted=false
1059:+ *   対象はストアクリエイターPro 問い合わせ管理ツールの「通常」(shp) と
1060:+ *   「オークション (落札前)」(auc) の両方。
1061:+ *
1062:+ * データ源: 問い合わせ管理API 質問一覧 (externalTalkList)。
1063:+ *   https://developer.yahoo.co.jp/webapi/shopping/question/list.html
1064:+ *   - VPSプロキシ (vps-proxy/aupay-proxy.js) の read-only passthrough 経由
1065:+ *     (Yahoo!システムAPIは登録済み固定IPからしか呼べない。Bearer+公開鍵署名はVPS側で付与)
1066:+ *   - requestFilter=unanswered / answered をサーバー側で絞り、**1ページ目だけ**読む。
1067:+ *     件数は summary.topic.count (絞り込み後の総件数) から取るので全ページ走査は不要。
1068:+ *     一覧はソート指定の降順 → 1ページ目 (20件) = 最新の該当分 = 通知に載せる分
1069:+ *
1070:+ * 🚨fail-closed の考え方 (0件と「読めない」を混同しない):
1071:+ *   - summary.filter が要求した requestFilter と一致しなければエラー
1072:+ *     (旧プロキシがパラメータを転送していない場合、全件が返って summary.filter='all' になる。
1073:+ *      そのまま进むと件数を誤読するので必ず止める)
1074:+ *   - unanswered の結果に isNoAnswer=false が混ざる、answered の結果に isCompleted=true が
1075:+ *     混ざる場合もエラー (フィルタ語義が想定 (相互排他な状態) と違う = 件数を信用できない)
1076:+ *   - shp と auc の結果に同じ topicId が出たらエラー (serviceType が効いていない)
1077:+ *
1078:+ * 個人情報: 通知に載せるのはタイトルと日時のみ。注文者名・マスクIDは扱わない。
1079:+ */
1080:+
1081:+/** 1リクエスト/秒のレート制限 (公式)。余裕を持って1.1秒 */
1082:+export const SLEEP_MS = 1100;
1083:+/** 通知に載せる明細の上限 (カテゴリごと)。超えた分は件数だけ伝える */
1084:+export const MAX_SHOW = 10;
1085:+/** externalTalkList の1ページ上限 (公式仕様) */
1086:+const PAGE_SIZE = 20;
1087:+
1088:+export const SERVICE_LABEL = { shp: '通常', auc: 'オークション' };
1089:+
1090:+/**
1091:+ * 実行する照会の一覧。
1092:+ *   kind 'unanswered'  = ① 未返信 → 顧客の最終投稿 (userPostTime) が新しい順
1093:+ *   kind 'uncompleted' = ② 返信済み・完了処理待ち → 店舗の最終返信 (sellerPostTime) が新しい順
1094:+ */
1095:+export const QUERIES = [
1096:+  { serviceType: 'shp', requestFilter: 'unanswered', kind: 'unanswered', sort: 'userPostTime' },
1097:+  { serviceType: 'auc', requestFilter: 'unanswered', kind: 'unanswered', sort: 'userPostTime' },
1098:+  { serviceType: 'shp', requestFilter: 'answered', kind: 'uncompleted', sort: 'sellerPostTime' },
1099:+  { serviceType: 'auc', requestFilter: 'answered', kind: 'uncompleted', sort: 'sellerPostTime' },
1100:+];
1101:+
1102:+export function proxyConfig(env = process.env) {
1103:+  const base = (env.YAHOO_PROXY_URL || 'http://133.167.122.198:8080').replace(/\/+$/, '');
1104:+  const secret = env.YAHOO_PROXY_SECRET || env.AUPAY_PROXY_SECRET || '';
1105:+  if (!secret) throw new Error('YAHOO_PROXY_SECRET (または AUPAY_PROXY_SECRET) が未設定です');
1106:+  return { base, secret };
1107:+}
1108:+
1109:+/** UNIX秒 → 'M/D HH:MM' (JST)。不正は null */
1110:+export function fmtJstFromUnixSec(v) {
1111:+  const n = Number(v);
1112:+  if (!Number.isFinite(n) || n <= 0) return null;
1113:+  const t = new Date(n * 1000 + 9 * 3600 * 1000);
1114:+  const pad2 = x => String(x).padStart(2, '0');
1115:+  return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${pad2(t.getUTCHours())}:${pad2(t.getUTCMinutes())}`;
1116:+}
1117:+
1118:+function contractError(msg) {
1119:+  const e = new Error(msg);
1120:+  e.errorType = 'contract_violation';
1121:+  return e;
1122:+}
1123:+
1124:+/**
1125:+ * 一覧レスポンス1ページ分を検証する。壊れていたら throw (握り潰さない)。
1126:+ * @returns {{count:number, headlines:object[]}}
1127:+ */
1128:+export function validateListResponse(json, q) {
1129:+  const label = `${q.requestFilter}/${q.serviceType}`;
1130:+  const filter = json?.summary?.filter;
1131:+  // 旧プロキシは requestFilter を転送しない → Yahoo!は全件を返し filter='all' になる。
1132:+  // ここで止めないと「全問い合わせ数」を「対応漏れ数」と誤読する
1133:+  if (filter !== q.requestFilter) {
1134:+    throw contractError(`summary.filter='${filter}' が要求 '${q.requestFilter}' と一致しません`
1135:+      + ` (VPSプロキシが絞り込みパラメータ未対応の可能性。${label})`);
1136:+  }
1137:+  const count = json?.summary?.topic?.count;
1138:+  if (!Number.isFinite(count) || count < 0) {
1139:+    throw contractError(`summary.topic.count が読み取れません (${label}: ${JSON.stringify(count)})`);
1140:+  }
1141:+  const headlines = json?.headlines;
1142:+  if (!Array.isArray(headlines)) {
1143:+    throw contractError(`headlines が配列でありません (${label})`);
1144:+  }
1145:+  // count と明細数の整合性 (Codexレビュー High): start=1, result=20 の要求に対して
1146:+  // 明細数は必ず min(count, 20) になるはず。count=0 なのに明細がある / count>0 なのに
1147:+  // 明細が無い ようなレスポンスをそのまま通すと、該当があるのに「0件=無通知」で
1148:+  // 正常終了してしまう。矛盾はエラーにする (0件と読み取り不能を混同しない)
1149:+  const expected = Math.min(count, PAGE_SIZE);
1150:+  if (headlines.length !== expected) {
1151:+    throw contractError(`count=${count} に対して明細が ${headlines.length}件 (期待 ${expected}件) です (${label})`);
1152:+  }
1153:+  for (const h of headlines) {
1154:+    if (!h?.topicId) throw contractError(`topicId のない行があります (${label})`);
1155:+    if (typeof h.isNoAnswer !== 'boolean' || typeof h.isCompleted !== 'boolean') {
1156:+      throw contractError(`isNoAnswer/isCompleted が真偽値でありません (${label}: ${h.topicId})`);
1157:+    }
1158:+    // フィルタ語義の検証: unanswered に返信済みが混ざる / answered に未返信・完了済みが
1159:+    // 混ざるなら、summary.topic.count を「その分類の件数」として信用できない
1160:+    if (q.kind === 'unanswered' && h.isNoAnswer !== true) {
1161:+      throw contractError(`unanswered の結果に返信済み (isNoAnswer=false) が混ざっています (${label}: ${h.topicId})`);
1162:+    }
1163:+    if (q.kind === 'uncompleted' && (h.isNoAnswer !== false || h.isCompleted !== false)) {
1164:+      throw contractError(`answered の結果に想定外の状態が混ざっています`
1165:+        + ` (${label}: ${h.topicId} isNoAnswer=${h.isNoAnswer} isCompleted=${h.isCompleted})`);
1166:+    }
1167:+    // serviceType が返ってくる場合は要求と一致すること (無指定転送の検出)
1168:+    if (h.serviceType != null && h.serviceType !== q.serviceType) {
1169:+      throw contractError(`serviceType='${h.serviceType}' が要求 '${q.serviceType}' と一致しません (${label}: ${h.topicId})`);
1170:+    }
1171:+  }
1172:+  return { count, headlines };
1173:+}
1174:+
1175:+/** 一覧行 → 通知に載せる1件 (タイトルと日時のみ。個人情報は持たない) */
1176:+export function toItem(h, q) {
1177:+  return {
1178:+    topicId: String(h.topicId),
1179:+    serviceType: q.serviceType,
1180:+    title: String(h.title || '(タイトルなし)'),
1181:+    userPostTime: Number(h.userPostTime) || null,
1182:+    sellerPostTime: h.sellerPostTime == null ? null : Number(h.sellerPostTime) || null,
1183:+    sortTime: Number(h[q.sort]) || 0,
1184:+  };
1185:+}
1186:+
1187:+/**
1188:+ * 4照会 (shp/auc × unanswered/answered) を実行して分類する。
1189:+ * @param {{fetchImpl?:Function, sleepMs?:number, timeoutMs?:number, env?:object}} opts
1190:+ * @returns {Promise<{unanswered:{count:number, items:object[]}, uncompleted:{count:number, items:object[]}}>}
1191:+ *   count = Yahoo!側の総件数 (summary.topic.count の合算)、items = 新しい順の明細 (最大20件/照会)
1192:+ */
1193:+export async function fetchInquiryStatus(opts = {}) {
1194:+  const fetchImpl = opts.fetchImpl ?? fetch;
1195:+  const sleepMs = opts.sleepMs ?? SLEEP_MS;
1196:+  const timeoutMs = opts.timeoutMs ?? 45000;
1197:+  const { base, secret } = proxyConfig(opts.env ?? process.env);
1198:+
1199:+  const out = {
1200:+    unanswered: { count: 0, items: [] },
1201:+    uncompleted: { count: 0, items: [] },
1202:+  };
1203:+  const seen = new Map(); // topicId → query label (serviceType が効いていない事故の検出)
1204:+  let requests = 0;
1205:+
1206:+  for (const q of QUERIES) {
1207:+    if (requests > 0) await new Promise(r => setTimeout(r, sleepMs));
1208:+    requests++;
1209:+
1210:+    const u = new URL(`${base}/yahoo/externalTalkList`);
1211:+    u.searchParams.set('start', '1');
1212:+    u.searchParams.set('result', String(PAGE_SIZE));
1213:+    u.searchParams.set('requestFilter', q.requestFilter);
1214:+    u.searchParams.set('serviceType', q.serviceType);
1215:+    u.searchParams.set('sort', q.sort);
1216:+    u.searchParams.set('sortOrder', 'desc');
1217:+
1218:+    const label = `${q.requestFilter}/${q.serviceType}`;
1219:+    let res;
1220:+    try {
1221:+      res = await fetchImpl(u.toString(), {
1222:+        headers: { 'X-Proxy-Secret': secret },
1223:+        signal: AbortSignal.timeout(timeoutMs),
1224:+      });
1225:+    } catch (err) {
1226:+      const timedOut = err?.name === 'TimeoutError' || err?.name === 'AbortError';
1227:+      throw new Error(timedOut
1228:+        ? `Yahooプロキシ タイムアウト (${timeoutMs}ms, ${label})`
1229:+        : `Yahooプロキシ接続失敗 (${label}): ${err?.message || err}`);
1230:+    }
1231:+    const text = await res.text();
1232:+    if (res.status !== 200) {
1233:+      // Yahoo!のエラーはXML <Error><Code/>。コードだけ抜く (問い合わせ本文の露出防止)
1234:+      const code = (text.match(/<Code>([^<]{1,40})<\/Code>/) || [])[1];
1235:+      throw new Error(`Yahoo API HTTP ${res.status} (${label})${code ? ` code=${code}` : ''}`);
1236:+    }
1237:+    let json;
1238:+    try { json = JSON.parse(text); } catch {
1239:+      throw contractError(`Yahoo APIレスポンスがJSONでありません (${label}): ${text.length} bytes`);
1240:+    }
1241:+
1242:+    const { count, headlines } = validateListResponse(json, q);
1243:+    for (const h of headlines) {
1244:+      const prev = seen.get(h.topicId);
1245:+      if (prev) {
1246:+        throw contractError(`同じ topicId が複数の照会に現れました (${prev} と ${label}: ${h.topicId})`
1247:+          + ' — serviceType の絞り込みが効いていない可能性');
1248:+      }
1249:+      seen.set(h.topicId, label);
1250:+    }
1251:+    const bucket = out[q.kind];
1252:+    bucket.count += count;
1253:+    bucket.items.push(...headlines.map(h => toItem(h, q)));
1254:+    console.log(`[yahoo-inquiry] ${label}: ${count}件`);
1255:+  }
1256:+
1257:+  // shp と auc を混ぜて新しい順に (通知は最新のものから載せる)
1258:+  out.unanswered.items.sort((a, b) => b.sortTime - a.sortTime);
1259:+  out.uncompleted.items.sort((a, b) => b.sortTime - a.sortTime);
1260:+  return out;
1261:+}
1262:+
1263:+// ─── GChat 本文 ───
1264:+
1265:+/**
1266:+ * 顧客入力 (タイトル) を通知へ載せる前の無害化 (Codexレビュー Medium)。
1267:+ * 改行・制御文字で通知のセクション偽装をされない / GChat のメンション記法
1268:+ * (<users/all> 等) を発動させない。装飾記法 (*) は見た目だけなので許容
1269:+ */
1270:+export function sanitizeForChat(s) {
1271:+  return String(s || '')
1272:+    .replace(/[\u0000-\u001f\u007f]+/g, ' ')            // 改行・タブ含む制御文字 → 空白
1273:+    .replace(/<(users|rooms)\//gi, '<\u200b$1/')       // メンション記法をゼロ幅スペースで分断
1274:+    .trim();
1275:+}
1276:+
1277:+function truncate(s, n) {
1278:+  const str = sanitizeForChat(s);
1279:+  return str.length > n ? `${str.slice(0, n)}…` : str;
1280:+}
1281:+
1282:+function itemLine(it, kind) {
1283:+  const tag = SERVICE_LABEL[it.serviceType] || it.serviceType;
1284:+  const received = fmtJstFromUnixSec(it.userPostTime) || '-';
1285:+  const times = kind === 'uncompleted' && it.sellerPostTime
1286:+    ? `受信 ${received} / 返信 ${fmtJstFromUnixSec(it.sellerPostTime)}`
1287:+    : `受信 ${received}`;
1288:+  return `・[${tag}] ${truncate(it.title, 40)} (${times})`;
1289:+}
1290:+
1291:+/**
1292:+ * 通知本文を組み立てる。**両方0件なら null** (該当ゼロは通知しない仕様 —
1293:+ * 「通知が来た = 何か対応が必要」と分かるようにする。実行の生存確認は daily-sync 側が担う)。
1294:+ */
1295:+export function buildMessage({ unanswered, uncompleted }) {
1296:+  const total = unanswered.count + uncompleted.count;
1297:+  if (total === 0) return null;
1298:+
1299:+  const lines = [];
1300:+  lines.push(`⚠️ *Yahoo!問い合わせに対応が必要なものが${total}件あります*`);
1301:+
1302:+  if (unanswered.count > 0) {
1303:+    lines.push('');
1304:+    lines.push(`🔴 未返信 (出店者回答待ち): *${unanswered.count}件*`);
1305:+    for (const it of unanswered.items.slice(0, MAX_SHOW)) lines.push(itemLine(it, 'unanswered'));
1306:+    if (unanswered.count > MAX_SHOW) lines.push(`  …他 ${unanswered.count - MAX_SHOW}件`);
1307:+  }
1308:+
1309:+  if (uncompleted.count > 0) {
1310:+    lines.push('');
1311:+    lines.push(`🟡 返信済みだが「完了する」が押されていない: *${uncompleted.count}件*`);
1312:+    for (const it of uncompleted.items.slice(0, MAX_SHOW)) lines.push(itemLine(it, 'uncompleted'));
1313:+    if (uncompleted.count > MAX_SHOW) lines.push(`  …他 ${uncompleted.count - MAX_SHOW}件`);
1314:+  }
1315:+
1316:+  lines.push('');
1317:+  lines.push('ストアクリエイターPro「問い合わせ管理」で返信・完了処理をしてください');
1318:+  return lines.join('\n');
1319:+}
