1331:+process.env.YAHOO_PROXY_URL = 'http://proxy.test';
1332:+process.env.YAHOO_PROXY_SECRET = 'test-secret';
1333:+
1334:+const {
1335:+  QUERIES,
1336:+  MAX_SHOW,
1337:+  fmtJstFromUnixSec,
1338:+  validateListResponse,
1339:+  toItem,
