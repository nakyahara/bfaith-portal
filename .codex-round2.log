1354:+  const e = JSON.stringify(expected);
1355:+  if (a === e) { pass++; return; }
1356:+  fail++;
1357:+  console.error(`  ✗ ${label}\n      期待: ${e}\n      実際: ${a}`);
1358:+}
1359:+async function throws(fn, re, label) {
1360:+  try {
1361:+    await fn();
1362:+    fail++;
