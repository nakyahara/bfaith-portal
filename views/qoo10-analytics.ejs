      ['gmv', 'GMV'], ['platform_fee', '手数料'], ['fee_pct', '手数料%'],
      ['net_settlement', '受取'], ['shipping', '送料'], ['cogs', '原価'],
      ['variable_margin', '粗利L1'], ['burden_est', '負担(推)'], ['l2', 'L2参考'],
      ['margin_pct', '利益率%'], ['mega_dependency_pct', 'メガ日比%'], ['cost_status', 'cost', 'l'],
    ];
    const head = '<tr>' + cols.map(([k, label, cls]) =>
      `<th class="${cls || ''}" data-sort="${k}">${label}${pfSort === k ? (pfDir === 'desc' ? ' ▼' : ' ▲') : ''}</th>`).join('') + '</tr>';
    const body = data.rows.map(r => {
      const cls = r.flag === 'loss' ? 'row-loss' : r.flag === 'promo_squeeze' ? 'row-squeeze' : r.flag === 'unresolved' ? 'row-unresolved' : '';
      return `<tr class="${cls}" data-sku="${esc(r.sku_code)}">
        <td class="l"><a href="#" class="sku-link" data-sku="${esc(r.sku_code)}">${esc(r.sku_code)}</a></td>
        <td class="l" title="${esc(r.product_name)}">${esc(r.product_name.slice(0, 28))}</td>
        <td class="num">${r.units_net.toLocaleString()}</td>
        <td class="num">${fmtYen(r.gmv)}</td><td class="num">${fmtYen(r.platform_fee)}</td>
        <td class="num">${fmtPct(r.fee_pct)}</td><td class="num">${fmtYen(r.net_settlement)}</td>
        <td class="num">${fmtYen(r.shipping)}</td><td class="num">${fmtYen(r.cogs)}</td>
        <td class="num ${signClass(r.variable_margin)}">${fmtYen(r.variable_margin)}</td>
        <td class="num">${fmtYen(r.burden_est)}</td>
        <td class="num ${signClass(r.l2)}">${fmtYen(r.l2)}</td>
        <td class="num">${fmtPct(r.margin_pct)}</td><td class="num">${fmtPct(r.mega_dependency_pct)}</td>
        <td class="l">${esc(r.cost_status === 'complete' ? '✓' : r.cost_status)}</td>
      </tr>`;
    }).join('');
    const table = document.getElementById('pf-table');
    table.innerHTML = head + body;
    table.querySelectorAll('th[data-sort]').forEach(th => th.addEventListener('click', () => {
      const k = th.dataset.sort;
      if (pfSort === k) pfDir = pfDir === 'desc' ? 'asc' : 'desc'; else { pfSort = k; pfDir = 'desc'; }
      renderSkuTable();
    }));
    table.querySelectorAll('.sku-link').forEach(a => a.addEventListener('click', (e) => {
      e.preventDefault();
      openSkuDetail(a.dataset.sku);
    }));
  } catch (e) {
    document.getElementById('pf-table').innerHTML = `<tr><td class="l">取得失敗: ${esc(e.message)}</td></tr>`;
