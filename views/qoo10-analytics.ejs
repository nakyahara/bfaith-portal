let bsPreset = '30d', bsAxis = 'sales';
function sparkline(points) {
  if (!points || points.length === 0) return '';
  const blocks = '▁▂▃▄▅▆▇█';
  const max = Math.max(...points.map(p => p.u), 1);
  return points.slice(-30).map(p => blocks[Math.min(7, Math.round(p.u / max * 7))]).join('');
}
