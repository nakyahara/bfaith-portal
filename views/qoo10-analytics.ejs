      type: 'bar',
      data: { labels: d.weekday.map(w => dowLabels[w.dow]), datasets: [
        { label: '日平均売上', data: d.weekday.map(w => w.avg_sales), backgroundColor: d.weekday.map(w => w.dow === 0 || w.dow === 6 ? '#f472b6' : '#fbcfe8') },
      ]},
      options: { responsive: true, maintainAspectRatio: false,
        scales: { y: { ticks: { callback: v => fmtJPY(v) } } }, plugins: { legend: { display: false } } },
    });
  } catch (e) {
    document.getElementById('bs-summary').innerHTML = `<div class="warn-note">売れ筋の取得に失敗: ${esc(e.message)}</div>`;
  }
}

// ============================================================
// ⚙️ 設定
// ============================================================
const SETTING_LABELS = {
  burden_megawari_pct: 'メガ割セラー負担率% (既定50)',
  burden_megapo_pct: 'メガポセラー負担率% (既定50・要較正)',
  abc_a_pct: 'ABC: A群の累積%閾値',
  abc_b_pct: 'ABC: B群の累積%閾値',
  new_product_days: '新商品バッジ日数',
  movers_min_units: '急上昇/急落の最低販売数',
};
function stMsg(html, ok) {
  document.getElementById('st-msg').innerHTML = html ? `<div class="${ok ? 'ok-note' : 'warn-note'}">${html}</div>` : '';
}
async function loadSettings() {
  try {
    const s = await getJSON(`${API}/settings`);
    document.getElementById('st-form').innerHTML = Object.keys(SETTING_LABELS).map(k =>
      `<label>${SETTING_LABELS[k]} <input type="number" step="any" id="st-${k}" value="${s[k]}"></label>`).join('');
    document.getElementById('st-certkey').value = s.cert_key_issued_on || '';
    renderCertInfo(s);
    document.getElementById('st-save').onclick = saveSettingsUi;
    document.getElementById('st-certkey').onchange = saveSettingsUi;
    document.getElementById('ev-add').onclick = addEventUi;
    await refreshEvents();
  } catch (e) { stMsg('設定の取得に失敗: ' + esc(e.message), false); }
}
function renderCertInfo(s) {
  const el = document.getElementById('st-certkey-info');
  if (s.cert_key_expires_on) {
    el.textContent = `${s.cert_key_expires_on} (残り ${s.cert_key_days_left} 日)`;
    el.style.color = s.cert_key_days_left <= 30 ? '#dc2626' : '#065f46';
  } else { el.textContent = '未登録'; el.style.color = '#6b7280'; }
}
async function saveSettingsUi() {
  const patch = { cert_key_issued_on: document.getElementById('st-certkey').value || '' };
  for (const k of Object.keys(SETTING_LABELS)) patch[k] = document.getElementById('st-' + k).value;
  try {
    const res = await fetch(`${API}/settings`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(patch) });
    const body = await res.json();
    if (!res.ok) throw new Error(body.error || 'HTTP ' + res.status);
    renderCertInfo(body);
    stMsg('✓ 設定を保存しました (概要/利益分析タブは再読込で反映)', true);
  } catch (e) { stMsg('保存失敗: ' + esc(e.message), false); }
}
async function refreshEvents() {
  const d = await getJSON(`${API}/mega-events`);
  const kindLabel = (k) => k === 'megawari' ? '🎪 メガ割' : '🅿️ メガポ';
  document.getElementById('ev-table').innerHTML =
    '<tr><th class="l noclick">種別</th><th class="l noclick">名称</th><th class="noclick">期間</th><th class="noclick">参加</th><th class="l noclick">メモ</th><th class="noclick"></th></tr>' +
    (d.events.length === 0 ? '<tr><td class="l" colspan="6">未登録 (下の候補から採用できます)</td></tr>' : d.events.map(e => `
      <tr><td class="l">${kindLabel(e.kind)}</td><td class="l">${esc(e.label || '−')}</td>
      <td>${e.date_from} 〜 ${e.date_to}</td><td>${e.participated ? '✓' : '不参加'}</td>
      <td class="l">${esc(e.memo || '')}</td>
      <td><button class="btn ghost small ev-del" data-id="${e.id}">削除</button></td></tr>`).join(''));
  document.getElementById('ev-suggest').innerHTML =
    '<tr><th class="l noclick">種別</th><th class="noclick">期間 (推定)</th><th class="noclick">実売日数</th><th class="noclick"></th></tr>' +
    (d.suggestions.length === 0 ? '<tr><td class="l" colspan="4">候補なし (全期間が登録済み)</td></tr>' : d.suggestions.map(sg => `
      <tr><td class="l">${kindLabel(sg.kind)}</td><td>${sg.date_from} 〜 ${sg.date_to}</td><td class="num">${sg.days}</td>
      <td><button class="btn small ev-adopt" data-kind="${sg.kind}" data-from="${sg.date_from}" data-to="${sg.date_to}">採用</button></td></tr>`).join(''));
  document.querySelectorAll('.ev-del').forEach(b => b.onclick = async () => {
    if (!confirm('この開催回を削除しますか?')) return;
    try {
      const res = await fetch(`${API}/mega-events/${b.dataset.id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error((await res.json()).error || 'HTTP ' + res.status);
      await refreshEvents();
    } catch (e) { stMsg('削除失敗: ' + esc(e.message), false); }
  });
  document.querySelectorAll('.ev-adopt').forEach(b => b.onclick = () => {
    document.getElementById('ev-kind').value = b.dataset.kind;
    document.getElementById('ev-from').value = b.dataset.from;
    document.getElementById('ev-to').value = b.dataset.to;
    document.getElementById('ev-label').focus();
  });
}
async function addEventUi() {
  const body = {
    kind: document.getElementById('ev-kind').value,
    label: document.getElementById('ev-label').value,
    date_from: document.getElementById('ev-from').value,
    date_to: document.getElementById('ev-to').value,
    participated: document.getElementById('ev-part').value === '1' ? 1 : 0,
    memo: document.getElementById('ev-memo').value,
  };
  try {
    const res = await fetch(`${API}/mega-events`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const j = await res.json();
    if (!res.ok) throw new Error(j.error || 'HTTP ' + res.status);
    stMsg('✓ 開催回を登録しました', true);
    document.getElementById('ev-label').value = '';
    document.getElementById('ev-memo').value = '';
    await refreshEvents();
  } catch (e) { stMsg('登録失敗: ' + esc(e.message), false); }
}

// 初期ロード
loadTab('overview');
</script>
</body>
</html>
