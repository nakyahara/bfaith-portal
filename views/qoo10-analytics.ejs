<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Qoo10分析ツール - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
          integrity="sha384-9nhczxUqK87bcKHh20fSQcTGD4qq5GhayNYSYWqwBkINBhOfQLg/P5HG5lF1urn4"
          crossorigin="anonymous"></script>
  <style>
    body { background: #f5f7fa; }
    .container { max-width: 1500px; margin: 0 auto; padding: 16px 20px; }
    .header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 12px; }
    .header-row h2 { margin: 0; }
    .back-link { font-size: 13px; color: #e91e63; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .meta-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 14px; margin-bottom: 12px; font-size: 12px; color: #555; display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

    /* 精度バッジ (要件 §11-2: 速報/自動(日次)/推定を常時区別。税はすべて税込) */
    .pbadge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; vertical-align: middle; }
    .pbadge.flash { background: #dbeafe; color: #1e40af; }
    .pbadge.fact { background: #d1fae5; color: #065f46; }
    .pbadge.est { background: #fef3c7; color: #92400e; }

    /* タブ (Qoo10 マゼンタ) */
    .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
    .tab-btn { background: #fff; border: 1px solid #e5e7eb; border-bottom: none; border-radius: 6px 6px 0 0; padding: 10px 16px; cursor: pointer; font-size: 13px; color: #555; }
    .tab-btn.active { background: #e91e63; color: white; border-color: #e91e63; }
    .tab-content { background: white; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 8px; padding: 16px; min-height: 400px; }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* 期間切替 */
    .period-switcher { display: inline-flex; gap: 4px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; flex-wrap: wrap; }
    .period-switcher button { background: transparent; border: none; padding: 6px 10px; font-size: 12px; cursor: pointer; border-radius: 4px; color: #555; }
    .period-switcher button.active { background: #e91e63; color: white; }
    .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }

    /* タイル */
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .tile { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .tile h3 { margin: 0 0 8px; font-size: 14px; color: #374151; }
    .tile .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #4b5563; }
    .tile .row .v { font-variant-numeric: tabular-nums; font-weight: 600; color: #111; }
    .tile .row.hero { border-top: 1px dashed #e5e7eb; margin-top: 6px; padding-top: 8px; }
    .tile .row.hero .v { font-size: 20px; font-weight: 700; }
    .tile .row.sep { border-top: 1px dashed #e5e7eb; margin-top: 6px; padding-top: 8px; }
    .pos { color: #047857 !important; } .negv { color: #dc2626 !important; }

    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .chart-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; }
    .chart-card h3 { margin: 0 0 8px; font-size: 13px; color: #374151; font-weight: 600; }
    .chart-wrap { position: relative; height: 300px; }
    .chart-wrap.tall { height: 420px; }
    @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }

    .note { font-size: 11.5px; color: #6b7280; margin: 6px 0; }
    .warn-note { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 8px 12px; font-size: 12px; color: #92400e; border-radius: 4px; margin-bottom: 12px; }
    .mega-note { background: #fdf2f8; border-left: 4px solid #e91e63; padding: 8px 12px; font-size: 12px; color: #9d174d; border-radius: 4px; margin-bottom: 12px; }
    .ok-note { background: #ecfdf5; border-left: 4px solid #10b981; padding: 8px 12px; font-size: 12px; color: #065f46; border-radius: 4px; margin-bottom: 12px; }
    .loading { color: #6b7280; font-size: 13px; padding: 30px; text-align: center; }

    /* データテーブル */
    .dtable { width: 100%; border-collapse: collapse; font-size: 12px; }
    .dtable th, .dtable td { border-bottom: 1px solid #f1f5f9; padding: 6px 8px; text-align: right; white-space: nowrap; }
    .dtable th { background: #f9fafb; color: #374151; position: sticky; top: 0; cursor: pointer; user-select: none; }
    .dtable th.noclick { cursor: default; }
    .dtable td.l, .dtable th.l { text-align: left; }
    .dtable tr:hover td { background: #fdf2f8; }
    .dtable td.num { font-variant-numeric: tabular-nums; }
    .table-scroll { overflow-x: auto; max-height: 560px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; }
    tr.row-loss td { background: #fef2f2; } tr.row-loss:hover td { background: #fee2e2; }
    tr.row-squeeze td { background: #fff7ed; } tr.row-squeeze:hover td { background: #ffedd5; }
    tr.row-unresolved td { background: #fefce8; }
    .abc-badge { display: inline-block; width: 18px; text-align: center; border-radius: 4px; font-size: 10px; font-weight: 700; }
    .abc-A { background: #d1fae5; color: #065f46; } .abc-B { background: #dbeafe; color: #1e40af; } .abc-C { background: #f3f4f6; color: #6b7280; }
    .new-badge { background: #e91e63; color: #fff; border-radius: 4px; font-size: 9px; padding: 1px 4px; font-weight: 700; }
    .spark { font-family: monospace; font-size: 11px; color: #e91e63; letter-spacing: -1px; }
    .btn { background: #e91e63; color: #fff; border: none; border-radius: 6px; padding: 7px 14px; font-size: 12px; cursor: pointer; }
    .btn.ghost { background: #fff; color: #e91e63; border: 1px solid #e91e63; }
    .btn.small { padding: 3px 9px; font-size: 11px; }
    .btn:disabled { opacity: 0.5; cursor: default; }
    input[type="text"], input[type="number"], input[type="date"], select { border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 8px; font-size: 12px; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px 16px; margin-bottom: 12px; }
    .form-grid label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: #374151; }

    /* SKU 詳細モーダル */
    .modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: none; z-index: 50; }
    .modal-bg.open { display: flex; align-items: center; justify-content: center; }
    .modal { background: #fff; border-radius: 12px; width: min(980px, 94vw); max-height: 88vh; overflow-y: auto; padding: 18px 22px; }
    .modal h3 { margin: 0 0 6px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-row">
      <h2>🛒 Qoo10分析ツール</h2>
      <div style="display:flex; gap:14px; align-items:center;">
        <span style="font-size:12px; color:#6b7280;"><%= displayName || username || '' %></span>
        <a class="back-link" href="/">← ポータルへ戻る</a>
      </div>
    </div>
    <div class="meta-bar">
      <span>精度: <span class="pbadge flash">速報</span>=NE受注ベース(毎朝更新) <span class="pbadge fact">確定</span>=配送完了fact(手数料<b>実額</b>) <span class="pbadge est">推定</span>=メガ割等セラー負担(割引×50%) / 金額はすべて<b>税込</b></span>
      <span id="meta-updated"></span>
    </div>

    <div class="tabs" id="tabs">
      <button class="tab-btn active" data-tab="overview">🏠 概要</button>
      <button class="tab-btn" data-tab="bestsellers">🏆 売れ筋</button>
      <button class="tab-btn" data-tab="profit">💰 利益分析</button>
      <button class="tab-btn" data-tab="ads">📣 広告</button>
      <button class="tab-btn" data-tab="megawari">🎪 メガ割</button>
      <button class="tab-btn" data-tab="diagnosis">🩺 診断</button>
      <button class="tab-btn" data-tab="import">📥 取込</button>
      <button class="tab-btn" data-tab="claims">📦 返品・出品</button>
      <button class="tab-btn" data-tab="settings">⚙️ 設定</button>
    </div>

    <div class="tab-content">
      <!-- 🏠 概要 -->
      <div class="tab-pane active" id="pane-overview">
        <div id="ov-unresolved"></div>
        <div id="ov-tiles" class="tile-grid"><div class="loading">読み込み中…</div></div>
        <div class="toolbar">
          <div class="period-switcher" id="ov-period"></div>
          <span class="note" id="ov-freshness"></span>
        </div>
        <div id="ov-trend-error"></div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>売上 × 粗利 × 粗利率 <span class="note">棒=確定売上(GMV)<span class="pbadge fact">確定</span> 桃色棒=メガ割開催 / 青線=速報売上(NE受注)<span class="pbadge flash">速報</span> / 粗利L1はセラー負担・広告費 控除前</span></h3>
            <div class="chart-wrap tall"><canvas id="chart-trend"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>販売数 × 客単価 <span class="pbadge fact">確定</span></h3>
            <div class="chart-wrap"><canvas id="chart-units"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>プロモ割引の推移 (メガ割 / メガポ / その他 — プラットフォーム割引<b>全体</b>。セラー負担はこの約50% <span class="pbadge est">推定</span>) <span class="pbadge fact">確定</span></h3>
            <div class="chart-wrap"><canvas id="chart-promo"></canvas></div>
          </div>
        </div>
      </div>

      <!-- 🏆 売れ筋 (P3) -->
      <div class="tab-pane" id="pane-bestsellers">
        <div class="toolbar">
          <div class="period-switcher" id="bs-period"></div>
          <div class="period-switcher" id="bs-axis">
            <button data-axis="sales" class="active">売上</button>
            <button data-axis="units">数量</button>
            <button data-axis="margin">粗利L1</button>
          </div>
          <span class="note" id="bs-meta"></span>
        </div>
        <div id="bs-summary" class="tile-grid"></div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>売れ筋ランキング Top100 <span class="pbadge fact">確定</span> <span class="note">メガ割日比 = メガ割/メガポ注文が出た日の売上構成比 (依存度の近似)</span></h3>
            <div class="table-scroll"><table class="dtable" id="bs-table"></table></div>
          </div>
          <div class="chart-card">
            <h3>急上昇 Top20 <span class="note" id="bs-prev-note"></span></h3>
            <div class="table-scroll" style="max-height:320px;"><table class="dtable" id="bs-risers"></table></div>
          </div>
          <div class="chart-card">
            <h3>急落 Top20</h3>
            <div class="table-scroll" style="max-height:320px;"><table class="dtable" id="bs-fallers"></table></div>
          </div>
          <div class="chart-card">
            <h3>曜日パターン (日平均売上)</h3>
            <div class="chart-wrap"><canvas id="bs-weekday"></canvas></div>
          </div>
        </div>
      </div>

      <!-- 💰 利益分析 (P3) -->
      <div class="tab-pane" id="pane-profit">
        <div class="toolbar">
          <div class="period-switcher" id="pf-period"></div>
          <span class="note">粗利率の分母はショップ受取 (SettlePrice)。手数料% = 手数料実額÷GMV (9%/10%混在の実測)。</span>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>利益ウォーターフォール <span class="pbadge fact">確定</span>+<span class="pbadge est">推定</span> <span class="note">L2 = L1 − メガ割/メガポ セラー負担推定。広告費 (P5)・精算実額 L3 (P4) は取込後に行が増えます</span></h3>
            <div class="chart-wrap"><canvas id="pf-waterfall"></canvas></div>
          </div>
        </div>
        <div class="toolbar">
          <input type="text" id="pf-q" placeholder="SKU / NEコード / 商品名で検索" style="width:260px;">
          <a class="btn ghost small" id="pf-csv" href="#" download>CSV出力</a>
          <span class="note" id="pf-count"></span>
          <span class="note">行色: <span style="background:#fff7ed;padding:1px 6px;">橙=L1黒字だが負担後赤字</span> <span style="background:#fef2f2;padding:1px 6px;">赤=L2赤字</span> <span style="background:#fefce8;padding:1px 6px;">黄=SKU未解決</span></span>
        </div>
        <div class="table-scroll"><table class="dtable" id="pf-table"></table></div>
      </div>

      <!-- 📣 広告 (P5) -->
      <div class="tab-pane" id="pane-ads">
        <div class="warn-note">準備中 (P5)。実装予定: スマートセールス商品別実績 (Excel取込) / 実効広告率 (スマートセールス+定額広告按分)÷売上 の損益分岐判定 (🟢余裕/🟡限界/🔴広告赤字) / スマートセールス料率の妥当性診断 / 定額広告 (パワーランクアップ/Mega AD等) の期間前後比較。<br>データは 📥取込タブ (P4-P5) からのQSM Excelアップロードで入ります (Qoo10に広告APIは存在しないため)。</div>
      </div>

      <!-- 🎪 メガ割 (P6) — 本アプリの目玉 -->
      <div class="tab-pane" id="pane-megawari">
        <div class="mega-note">準備中 (P6 — 本アプリの目玉)。実装予定: 開催回カレンダー (開催期間・エントリーSKU管理、過去分はfactから逆推定して初期構築) / 開催回ごとの損益判定 (平常時ベースライン比の増分売上・増分L2利益 −セラー負担 −追加広告費 =「参加して儲かったのか」) / SKU別メガ割成績表 (リフト倍率×負担後利益) → 次回エントリー推奨リスト / 参加シミュレーション / エントリー資格の常時監視 (キャンセル率10%未満)。<br>市販ツールが1つも無い空白領域です (競合調査 2026-07-06)。次回メガ割 (例年9月頃) までにここへ到達するのが目標。</div>
      </div>

      <!-- 🩺 診断 (P8) -->
      <div class="tab-pane" id="pane-diagnosis">
        <div class="warn-note">準備中 (P8)。実装予定: 稼ぎ頭 / 赤字SKU / メガ割で赤字 / 広告垂れ流し / 死に筋 / 価格ミス疑い (メガ割期間除外判定) / 手数料異常 (SettlePrice公式一致率の急変) / SKU未解決 / CVR異常 / 出したのに売れてない の自動判定リスト + GChatアラート (QOO10_CERT_KEY 失効30日前警告含む)。</div>
      </div>

      <!-- 📥 取込 (P4) -->
      <div class="tab-pane" id="pane-import">
        <div class="warn-note">準備中 (P4 — 確定利益の本丸)。実装予定: QSM精算内訳Excel / スマートセールス実績Excel / Qoo10 Analyticsトラフィック・CVR Excel のドラッグ&ドロップ取込 (種別自動判別・file_hash重複排除・run_id publish) + データ鮮度ボード (前月分の精算内訳が翌月15日まで未取込ならGChat通知)。<br>精算内訳の「販売促進費 / メガプロモーション補償金 / 利用料調整」3費目を対応付けてメガ割セラー負担を<b>実額</b>確定し、L3確定純利益 (variable_margin_full) をbackfillします。DL運用は月1〜2回 (§13-②)。</div>
      </div>

      <!-- 📦 返品・出品 (P9) -->
      <div class="tab-pane" id="pane-claims">
        <div class="warn-note">準備中 (P9 — 新規API承認済み §13-⑥)。実装予定: 返品・クレーム統合 (GetClaimInfo_V3: SKU別返品率、メガ割参加資格 = キャンセル率10%未満の常時監視) / 出品・価格監視 (GetAllGoodsInfo: 価格ミス検知の精度向上、出品停止検知)。miniPC側の新規API取得を伴うため単独PR+smokeで実施。</div>
      </div>

      <!-- ⚙️ 設定 (P3) -->
      <div class="tab-pane" id="pane-settings">
        <div id="st-msg"></div>
        <div class="chart-card" style="margin-bottom:12px;">
          <h3>セラー負担率・分析閾値</h3>
          <div class="note">負担率は P4 (精算Excel突合) で実額と較正するまでの推定値。変更すると概要/利益分析/売れ筋の L2 が即座に再計算されます。</div>
          <div class="form-grid" id="st-form"></div>
          <button class="btn" id="st-save">設定を保存</button>
        </div>
        <div class="chart-card" style="margin-bottom:12px;">
          <h3>APIキー期限 (QOO10_CERT_KEY)</h3>
          <div class="note">Qoo10 APIキーは年1回の再発行が必要。発行日を記録すると残日数を監視できます (期限アラートは P8)。キー本体はここには入力しない (miniPC .env 管理)。</div>
          <div class="form-grid">
            <label>発行日 <input type="date" id="st-certkey"></label>
            <label>期限 (発行+365日) <span id="st-certkey-info" style="padding:6px 0; font-weight:600;">—</span></label>
          </div>
        </div>
        <div class="chart-card">
          <h3>🎪 メガ割/メガポ 開催回マスタ <span class="note">メガ割タブ (P6) の損益判定の基盤。過去分は下の「factからの候補」から採用して登録</span></h3>
          <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
            <label>種別 <select id="ev-kind"><option value="megawari">メガ割</option><option value="megapo">メガポ</option></select></label>
            <label>名称 <input type="text" id="ev-label" placeholder="例: 2026 第3回メガ割"></label>
            <label>開始日 <input type="date" id="ev-from"></label>
            <label>終了日 <input type="date" id="ev-to"></label>
            <label>参加 <select id="ev-part"><option value="1">参加した</option><option value="0">不参加</option></select></label>
            <label>メモ <input type="text" id="ev-memo"></label>
          </div>
          <button class="btn" id="ev-add">開催回を登録</button>
          <h3 style="margin-top:14px;">登録済み開催回</h3>
          <div class="table-scroll" style="max-height:260px;"><table class="dtable" id="ev-table"></table></div>
          <h3 style="margin-top:14px;">factからの候補 (メガ割/メガポ注文が出た連続期間の逆推定)</h3>
          <div class="table-scroll" style="max-height:220px;"><table class="dtable" id="ev-suggest"></table></div>
        </div>
      </div>
    </div>
  </div>

  <!-- SKU 詳細モーダル -->
  <div class="modal-bg" id="sku-modal-bg">
    <div class="modal">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h3 id="sku-modal-title">SKU詳細</h3>
        <button class="btn ghost small" onclick="document.getElementById('sku-modal-bg').classList.remove('open')">閉じる ✕</button>
      </div>
      <div id="sku-modal-meta" class="note"></div>
      <div class="chart-wrap"><canvas id="sku-modal-chart"></canvas></div>
    </div>
  </div>

<script>
// ============================================================
// 共通 util
// ============================================================
const API = '/apps/qoo10-analytics/api/v1';
const charts = {};
function destroyChart(id) { if (charts[id]) { charts[id].destroy(); delete charts[id]; } }
function mkChart(id, cfg) { destroyChart(id); charts[id] = new Chart(document.getElementById(id).getContext('2d'), cfg); return charts[id]; }

// 金額: 経営向け日本語単位 (億/万) — feedback_japanese_currency_units
function fmtJPY(n) {
  if (n === null || n === undefined) return '−';
  const neg = n < 0; const a = Math.abs(Math.round(n));
  let s;
  if (a >= 100000000) s = (a / 100000000).toFixed(2).replace(/\.?0+$/, '') + '億円';
  else if (a >= 10000) s = Math.round(a / 10000).toLocaleString() + '万円';
  else s = '¥' + a.toLocaleString();
  return neg ? '−' + s : s;
}
function fmtYen(n) { if (n === null || n === undefined) return '−'; return '¥' + Math.round(n).toLocaleString(); }
function fmtPct(n) { return (n === null || n === undefined) ? '−' : n + '%'; }
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function getJSON(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}
function signClass(n) { return n < 0 ? 'negv' : n > 0 ? 'pos' : ''; }

// 期間プリセット
const PRESETS = [
  ['7d', '7日'], ['14d', '14日'], ['30d', '30日'], ['90d', '90日'],
  ['this_month', '今月'], ['last_month', '先月'], ['12m', '12ヶ月'], ['this_year', '今年'],
];
function mountPeriodSwitcher(elId, defaultPreset, onChange) {
  const el = document.getElementById(elId);
  el.innerHTML = PRESETS.map(([k, label]) =>
    `<button data-preset="${k}" class="${k === defaultPreset ? 'active' : ''}">${label}</button>`).join('');
  el.addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    el.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    onChange(btn.dataset.preset);
  });
}

