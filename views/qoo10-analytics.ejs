let pfPreset = '30d', pfSort = 'l2', pfDir = 'desc', pfQ = '';
async function loadProfit() {
  mountPeriodSwitcher('pf-period', pfPreset, (p) => { pfPreset = p; refreshProfit(); });
  const qInput = document.getElementById('pf-q');
  let debounce = null;
  qInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => { pfQ = qInput.value; renderSkuTable(); }, 250);
  });
  refreshProfit();
}
async function refreshProfit() {
  try {
    const wf = await getJSON(`${API}/waterfall?preset=${pfPreset}`);
    renderWaterfall(wf);
  } catch (e) { console.error(e); }
  renderSkuTable();
}
function renderWaterfall(wf) {
  // floating bar: 各ステップを [開始, 終了] の帯で描く
  let running = 0;
  const bars = wf.steps.map(s => {
    if (s.kind === 'total' && s.key === 'gmv') { running = s.amount; return { label: s.label, range: [0, s.amount], color: '#f472b6' }; }
    if (s.kind === 'cost') { const from = running; running -= s.amount; return { label: s.label, range: [running, from], color: s.precision === 'est' ? '#fcd34d' : '#fda4af' }; }
    // subtotal / total: running を明示的にその値へ揃える (累積誤差の可視化防止)
    running = s.amount;
    return { label: s.label, range: [0, s.amount], color: s.key === 'l2' ? '#a78bfa' : '#86efac' };
  });
  mkChart('pf-waterfall', {
    type: 'bar',
    data: { labels: bars.map(b => b.label), datasets: [{ data: bars.map(b => b.range), backgroundColor: bars.map(b => b.color), borderSkipped: false }] },
    options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y',
      scales: { x: { ticks: { callback: v => fmtJPY(v) } } },
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => fmtJPY(c.raw[1] - c.raw[0]) } } } },
  });
}
async function renderSkuTable() {
  try {
    const data = await getJSON(`${API}/sku-profit?preset=${pfPreset}&sort=${pfSort}&dir=${pfDir}&q=${encodeURIComponent(pfQ)}&limit=300`);
    document.getElementById('pf-count').textContent = `${data.total} SKU (上位300表示) / 負担率: メガ割${data.burden_rates.megawari_pct}%・メガポ${data.burden_rates.megapo_pct}%`;
    document.getElementById('pf-csv').href = `${API}/sku-profit.csv?preset=${pfPreset}&q=${encodeURIComponent(pfQ)}&sort=${pfSort}&dir=${pfDir}`;
    const cols = [
