}
function sparkSvg(points) {
  if (!points || points.length < 2) return '';
  const max = Math.max(...points.map(p => p.u), 1);
  const w = 80, h = 22;
  const step = w / (points.length - 1);
  const d = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${(i * step).toFixed(1)},${(h - p.u / max * (h - 2) - 1).toFixed(1)}`).join('');
  return `<svg width="${w}" height="${h}" style="vertical-align:middle;"><path d="${d}" fill="none" stroke="#2563eb" stroke-width="1.5"/></svg>`;
}
async function fetchBestsellers() {
  try {
    const data = await getJSON(`${API}/bestsellers?preset=${bsPreset}&axis=${bsAxis}`);
    document.getElementById('bs-note').textContent = `期間 ${data.from}〜${data.to} (前期: ${data.prev_from}〜${data.prev_to}) / 全${data.total_skus} SKU`;
    const abc = data.abc;
    document.getElementById('bs-abc').innerHTML =
      `ABC分析: <span class="pill" style="background:#dbeafe;color:#1e40af;">A ${abc.count.A} SKU (${fmtJPY(abc.revenue.A)})</span> <span class="pill" style="background:#e0e7ff;color:#4338ca;">B ${abc.count.B} SKU (${fmtJPY(abc.revenue.B)})</span> <span class="pill" style="background:#f3f4f6;color:#6b7280;">C ${abc.count.C} SKU (${fmtJPY(abc.revenue.C)})</span> — A群の在庫切れが最優先リスク`;

    const dows = ['日', '月', '火', '水', '木', '金', '土'];
    mkChart('chart-weekday', {
      type: 'bar',
      data: { labels: data.weekday.map(r => dows[r.dow]), datasets: [{ label: '平均販売数/日', data: data.weekday.map(r => r.avg_units), backgroundColor: data.weekday.map(r => r.dow === 0 ? '#fca5a5' : '#93c5fd') }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false },
        tooltip: { callbacks: { footer: (items) => { const r = data.weekday[items[0].dataIndex]; return `平均売上/日: ${fmtJPY(r.avg_sales)}`; } } } } },
    });
    const g = data.goen;
    document.getElementById('bs-goen').innerHTML = g.goen_avg_sales !== null && g.normal_avg_sales !== null
      ? `🎪 <b>5のつく日</b> (${g.goen_days}日): 平均売上 ${fmtJPY(g.goen_avg_sales)}/日 vs 通常日 ${fmtJPY(g.normal_avg_sales)}/日 → <b class="${g.lift_pct >= 0 ? 'pos' : 'negv'}">${g.lift_pct >= 0 ? '+' : ''}${g.lift_pct}%</b>`
      : '5のつく日の比較は期間を広げると表示されます';

    const mover = (r, up) => `<div style="display:flex; justify-content:space-between; padding:2px 0; border-bottom:1px dashed #eee;">
      <span class="name-cell" style="max-width:60%;">${esc(r.yahoo_sku_key)} <span class="note">${esc((r.product_name || '').slice(0, 24))}</span></span>
      <span class="${up ? 'pos' : 'negv'}" style="font-weight:600;">${up ? '↗' : '↘'} ${r.units_growth_pct}% (${r.prev_units}→${r.units_net})</span></div>`;
    document.getElementById('bs-movers').innerHTML =
      (data.risers.slice(0, 10).map(r => mover(r, true)).join('') +
       data.fallers.slice(0, 10).map(r => mover(r, false)).join('')) || '<div class="note">対象なし</div>';

    const rows = data.ranking.map((r, i) => `<tr>
      <td class="num">${i + 1}</td>
      <td><a class="sku-link" data-sku="${esc(r.yahoo_sku_key)}" data-preset="${bsPreset}">${esc(r.yahoo_sku_key)}</a> ${r.abc ? `<span class="pill" style="background:#f3f4f6;">${r.abc}</span>` : ''} ${r.is_new ? '<span class="pill" style="background:#fce7f3;color:#9d174d;">NEW</span>' : ''} ${r.unresolved ? '<span class="pill unres">未解決</span>' : ''}</td>
      <td class="name-cell" title="${esc(r.product_name)}">${esc(r.product_name)}</td>
      <td class="num">${r.units_net.toLocaleString()}</td>
      <td class="num">${r.units_growth_pct === null ? '<span class="pill" style="background:#fce7f3;color:#9d174d;">新規</span>' : `<span class="${r.units_growth_pct >= 0 ? 'pos' : 'negv'}">${r.units_growth_pct}%</span>`}</td>
      <td class="num">${fmtYen(r.sales_incl)}</td>
      <td class="num ${signClass(r.variable_margin)}">${fmtYen(r.variable_margin)}</td>
      <td class="num">${fmtPct(r.margin_pct)}</td>
      <td>${sparkSvg(r.spark)}</td>
    </tr>`).join('');
    document.getElementById('bs-table').innerHTML = `<thead><tr>
      <th>#</th><th>Yahoo SKU</th><th>商品名</th><th>販売数</th><th>前期比</th>
      <th>売上(税込)</th><th>粗利</th><th>粗利率</th><th>推移</th>
    </tr></thead><tbody>${rows}</tbody>`;
  } catch (e) {
    document.getElementById('bs-table').innerHTML = `<tr><td class="warn-note">取得失敗: ${esc(e.message)}</td></tr>`;
  }
}

