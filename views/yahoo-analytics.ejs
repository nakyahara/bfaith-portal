  document.getElementById('rate-history').addEventListener('click', async (e) => {
    const btn = e.target.closest('button[data-del]'); if (!btn) return;
    if (!confirm('この料率行を削除しますか?')) return;
    try {
      const res = await fetch(`${API}/rates/${btn.dataset.del}`, { method: 'DELETE' });
      if (!res.ok) throw new Error((await res.json()).error || res.status);
      renderRates(await res.json());
    } catch (err) { document.getElementById('rate-status').textContent = '削除失敗: ' + err.message; }
  });
  try { renderRates(await getJSON(`${API}/rates`)); } catch (e) { document.getElementById('rate-status').textContent = '料率の取得に失敗: ' + e.message; }
  try { renderThresholds(await getJSON(`${API}/settings`)); } catch (e) { console.error(e); }
}
function renderRates(data) {
  const sel = document.getElementById('rate-key');
  sel.innerHTML = Object.entries(data.keys).map(([k, label]) => `<option value="${k}">${esc(label)}</option>`).join('');
  const upcomingByKey = {};
  for (const u of data.upcoming) (upcomingByKey[u.rate_key] ||= []).push(u);
  document.getElementById('rate-current').innerHTML = `<thead><tr><th>料率種別</th><th>現在有効</th><th>適用開始日</th><th>改定予約</th></tr></thead><tbody>` +
    Object.entries(data.keys).map(([k, label]) => {
      const c = data.current[k];
      const up = (upcomingByKey[k] || []).map(u => `${u.effective_from}〜 ${u.rate_pct}%`).join(' / ');
      return `<tr><td>${esc(label)}</td>
        <td class="num">${c ? `<b>${c.rate_pct}%</b>` : '<span class="note">未登録</span>'}</td>
        <td>${c ? esc(c.effective_from) : '−'}</td>
        <td>${up ? '📅 ' + esc(up) : '−'}</td></tr>`;
    }).join('') + '</tbody>';
  document.getElementById('rate-history').innerHTML = `<thead><tr><th>料率種別</th><th>料率</th><th>適用開始日</th><th>メモ</th><th>登録日時</th><th></th></tr></thead><tbody>` +
    (data.history.length ? data.history.map(r => `<tr>
      <td>${esc(data.keys[r.rate_key] || r.rate_key)}</td>
      <td class="num">${r.rate_pct}%</td>
      <td>${esc(r.effective_from)}</td>
      <td>${esc(r.memo)}</td>
      <td class="note">${esc((r.created_at || '').slice(0, 10))}</td>
      <td><button class="btn secondary" data-del="${r.id}" style="padding:2px 8px;">削除</button></td>
    </tr>`).join('') : '<tr><td colspan="6" class="note">履歴なし。参考: ストアポイント原資1%必須〜/キャンペーン原資1.5%/プロモーションパッケージ3% (2026-09から2%)/売上ロイヤリティ2.5% (2026-09新設)</td></tr>') + '</tbody>';
}
async function addRateFromForm() {
  const body = {
    rate_key: document.getElementById('rate-key').value,
    rate_pct: document.getElementById('rate-pct').value,
    effective_from: document.getElementById('rate-from').value,
    memo: document.getElementById('rate-memo').value,
  };
  const st = document.getElementById('rate-status');
  try {
    const res = await fetch(`${API}/rates`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || res.status);
    renderRates(json);
    st.textContent = '✅ 登録しました';
    document.getElementById('rate-pct').value = ''; document.getElementById('rate-memo').value = '';
  } catch (e) { st.textContent = '登録失敗: ' + e.message; }
}
function renderThresholds(s) {
  document.getElementById('settings-form').innerHTML = Object.entries(SETTING_LABELS).map(([k, label]) =>
    `<div><label class="note">${esc(label)}</label><br><input type="text" data-setting="${k}" value="${s[k]}" style="width:90px; border:1px solid #d1d5db; border-radius:6px; padding:6px 10px;"></div>`).join('');
}
async function saveThresholds() {
  const patch = {};
  document.querySelectorAll('[data-setting]').forEach(el => { patch[el.dataset.setting] = el.value; });
  const st = document.getElementById('settings-status');
  try {
    const res = await fetch(`${API}/settings`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(patch) });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || res.status);
    renderThresholds(json);
    st.textContent = '✅ 保存しました';
  } catch (e) { st.textContent = '保存失敗: ' + e.message; }
}

// 初期ロード
loadTab('overview');
</script>
</body>
</html>
