    </tr>`).join('');
    const table = document.getElementById('pf-table');
    if (reset) table.innerHTML = thead + `<tbody>${rowsHtml}</tbody>`;
    else table.querySelector('tbody').insertAdjacentHTML('beforeend', rowsHtml);
    document.getElementById('pf-more').style.display = (pfOffset + 100 < data.total) ? '' : 'none';
