<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ヤフー分析ツール - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
          integrity="sha384-9nhczxUqK87bcKHh20fSQcTGD4qq5GhayNYSYWqwBkINBhOfQLg/P5HG5lF1urn4"
          crossorigin="anonymous"></script>
  <style>
    body { background: #f5f7fa; }
    .container { max-width: 1500px; margin: 0 auto; padding: 16px 20px; }
    .header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 12px; }
    .header-row h2 { margin: 0; }
    .back-link { font-size: 13px; color: #e6002e; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .meta-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 14px; margin-bottom: 12px; font-size: 12px; color: #555; display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

    /* 精度バッジ (要件 §11-2: 速報/推定/確定を常時区別。税はすべて税込) */
    .pbadge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; vertical-align: middle; }
    .pbadge.flash { background: #dbeafe; color: #1e40af; }
    .pbadge.est { background: #fef3c7; color: #92400e; }
    .pbadge.settled { background: #d1fae5; color: #065f46; }

    /* タブ (Yahoo!レッド) */
    .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
    .tab-btn { background: #fff; border: 1px solid #e5e7eb; border-bottom: none; border-radius: 6px 6px 0 0; padding: 10px 16px; cursor: pointer; font-size: 13px; color: #555; }
    .tab-btn.active { background: #e6002e; color: white; border-color: #e6002e; }
    .tab-content { background: white; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 8px; padding: 16px; min-height: 400px; }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* 期間切替 */
    .period-switcher { display: inline-flex; gap: 4px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; flex-wrap: wrap; }
    .period-switcher button { background: transparent; border: none; padding: 6px 10px; font-size: 12px; cursor: pointer; border-radius: 4px; color: #555; }
    .period-switcher button.active { background: #e6002e; color: white; }
    .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }

    /* タイル */
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .tile { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .tile h3 { margin: 0 0 8px; font-size: 14px; color: #374151; }
    .tile .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #4b5563; }
    .tile .row .v { font-variant-numeric: tabular-nums; font-weight: 600; color: #111; }
    .tile .row.hero { border-top: 1px dashed #e5e7eb; margin-top: 6px; padding-top: 8px; }
    .tile .row.hero .v { font-size: 20px; font-weight: 700; }
    .pos { color: #047857 !important; } .negv { color: #dc2626 !important; }

    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .chart-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; }
    .chart-card h3 { margin: 0 0 8px; font-size: 13px; color: #374151; font-weight: 600; }
    .chart-wrap { position: relative; height: 300px; }
    .chart-wrap.tall { height: 420px; }
    @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }

    .note { font-size: 11.5px; color: #6b7280; margin: 6px 0; }
    .warn-note { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 8px 12px; font-size: 12px; color: #92400e; border-radius: 4px; margin-bottom: 12px; }
    .loading { color: #6b7280; font-size: 13px; padding: 30px; text-align: center; }

    /* テーブル (利益分析タブ) */
    .toolbar input[type=text] { border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 10px; font-size: 12px; }
    table.data { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    table.data th, table.data td { border: 1px solid #e5e7eb; padding: 5px 8px; }
    table.data th { background: #f9fafb; font-weight: 600; color: #374151; text-align: left; white-space: nowrap; cursor: pointer; user-select: none; }
    table.data td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    table.data td.name-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    table.data tr.flag-loss td { background: #fef2f2; }
    table.data tr.flag-unresolved td { background: #fefce8; }
    .table-scroll { overflow-x: auto; }
    .section-h { font-size: 14px; font-weight: 700; color: #1f2937; margin: 18px 0 8px; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .pill.edge { background: #fef3c7; color: #92400e; }
    .pill.unres { background: #fee2e2; color: #991b1b; }
    .btn { background: #e6002e; color: #fff; border: none; border-radius: 6px; padding: 6px 14px; font-size: 12px; cursor: pointer; }
    .btn.secondary { background: #6b7280; }
    a.sku-link { color: #1d4ed8; cursor: pointer; text-decoration: none; }
    a.sku-link:hover { text-decoration: underline; }
    dialog { border: 1px solid #e5e7eb; border-radius: 10px; max-width: 940px; width: 92%; padding: 18px; }
    dialog::backdrop { background: rgba(0,0,0,0.35); }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-row">
      <h2>🛍️ ヤフー分析ツール</h2>
      <div style="display:flex; gap:14px; align-items:center;">
        <span style="font-size:12px; color:#6b7280;"><%= displayName || username || '' %></span>
        <a class="back-link" href="/">← ポータルへ戻る</a>
      </div>
    </div>
    <div class="meta-bar">
      <span>精度: <span class="pbadge flash">速報</span>=受注ベース(毎朝更新) <span class="pbadge est">推定</span>=手数料10%一律 <span class="pbadge settled">確定</span>=月次請求明細実額 / 金額はすべて<b>税込</b></span>
      <span id="meta-updated"></span>
    </div>

    <div class="tabs" id="tabs">
      <button class="tab-btn active" data-tab="overview">🏠 概要</button>
      <button class="tab-btn" data-tab="bestsellers">🏆 売れ筋</button>
      <button class="tab-btn" data-tab="profit">💰 利益分析</button>
      <button class="tab-btn" data-tab="ads">📣 広告</button>
      <button class="tab-btn" data-tab="search">🔍 検索・順位</button>
      <button class="tab-btn" data-tab="campaign">🎪 キャンペーン</button>
      <button class="tab-btn" data-tab="diagnosis">🩺 診断</button>
      <button class="tab-btn" data-tab="import">📥 取込</button>
      <button class="tab-btn" data-tab="settings">⚙️ 設定</button>
    </div>

    <div class="tab-content">
      <!-- 🏠 概要 -->
      <div class="tab-pane active" id="pane-overview">
        <div id="ov-unresolved"></div>
        <div id="ov-tiles" class="tile-grid"><div class="loading">読み込み中…</div></div>
        <div class="toolbar">
          <div class="period-switcher" id="ov-period"></div>
          <span class="note" id="ov-freshness"></span>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>売上 × 粗利 × 粗利率 <span class="pbadge flash">速報</span> <span class="note">粗利 = 変動利益 (売上−クーポン−ポイント利用−手数料<span class="pbadge est">推定</span>−送料−原価)</span></h3>
            <div class="chart-wrap tall"><canvas id="chart-trend"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>販売数 × 客単価 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap"><canvas id="chart-units"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>クーポン店舗負担 × ポイント利用の推移 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap"><canvas id="chart-deductions"></canvas></div>
          </div>
        </div>
      </div>

      <!-- 🏆 売れ筋 (P3) -->
      <div class="tab-pane" id="pane-bestsellers">
        <div class="toolbar">
          <div class="period-switcher" id="bs-period"></div>
          <div class="period-switcher" id="bs-axis">
            <button data-axis="sales" class="active">売上</button>
            <button data-axis="units">販売数</button>
            <button data-axis="margin">粗利</button>
          </div>
        </div>
        <div class="note" id="bs-abc"></div>
        <div class="charts-grid">
          <div class="chart-card">
            <h3>曜日パターン (平均販売数/日) <span class="pbadge flash">速報</span> <span class="note">赤=日曜 (LYPプレミアム系)</span></h3>
            <div class="chart-wrap" style="height:200px;"><canvas id="chart-weekday"></canvas></div>
            <div class="note" id="bs-goen"></div>
          </div>
          <div class="chart-card">
            <h3>急上昇 ↗ / 急落 ↘ (前期間比・販売数)</h3>
            <div id="bs-movers" style="max-height:230px; overflow-y:auto; font-size:12px;"></div>
          </div>
        </div>
        <div class="section-h">売れ筋ランキング <span class="pbadge flash">速報</span> <span class="note" id="bs-note"></span></div>
        <div class="table-scroll"><table class="data" id="bs-table"></table></div>
      </div>

      <!-- 💰 利益分析 (P2) -->
      <div class="tab-pane" id="pane-profit">
        <div class="toolbar">
          <div class="period-switcher" id="pf-period"></div>
          <input type="text" id="pf-search" placeholder="Yahoo SKU / NEコード / 商品名 検索">
          <button class="btn secondary" id="pf-csv">CSV出力</button>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>利益ウォーターフォール <span id="pf-wf-title"></span> <span class="note" id="pf-wf-note"></span></h3>
            <div class="chart-wrap tall"><canvas id="chart-waterfall"></canvas></div>
          </div>
        </div>
        <div class="section-h">SKU別利益 <span class="pbadge flash">速報</span>+<span class="pbadge est">手数料推定10%</span> — 行色: <span style="background:#fefce8; padding:1px 6px;">黄=SKU未解決 (原価0円計上で粗利が過大)</span> / <span style="background:#fef2f2; padding:1px 6px;">赤=粗利赤字</span></div>
        <div class="table-scroll"><table class="data" id="pf-table"></table></div>
        <div class="toolbar" style="justify-content:center;"><button class="btn secondary" id="pf-more" style="display:none;">さらに表示</button></div>

        <div class="section-h">🔍 SKU未解決一覧 (直近180日) <span class="note" id="unres-note"></span> <button class="btn secondary" id="unres-csv" style="margin-left:8px;">作業用CSV出力</button></div>
        <div class="note">解消手順: 「Yahoo SKU」列の値がそのまま <code>f_yahoo_sku_map.yahoo_key</code> の登録キーです。NEコード候補を確認 → 作業用CSVの ne_code 記入欄を埋める → miniPC の <code>f_yahoo_sku_map</code> に登録 (Claudeに「YahooのSKU未解決を登録して」と依頼でOK)。翌朝の fact rebuild から原価が反映されます。</div>
        <div class="table-scroll"><table class="data" id="unres-table"></table></div>
      </div>

      <!-- 📣 広告 (P6) -->
      <div class="tab-pane" id="pane-ads">
        <div class="warn-note">準備中 (P6)。実装予定: アイテムリーチ商品別・KW別の広告効率 / PRオプション料率の妥当性診断 / 実効広告率 (アイテムリーチ+PRオプション)÷売上 の損益分岐判定 (🟢余裕/🟡限界/🔴広告赤字) / 未カバー広告費の見える化。<br>データは 📥取込タブ (P5) からのコマースアドマネージャーCSV / PRオプションレポートCSVアップロードで入ります。</div>
      </div>

      <!-- 🔍 検索・順位 (P7-P8) -->
      <div class="tab-pane" id="pane-search">
        <div class="warn-note">準備中 (P7-P8)。実装予定: 検索流入KW分析 (流入/売上/注文率、検索流入レポートCSV取込) / 自社商品の順位トラッキング (itemSearch API 日次スナップショット、miniPC実行→mirror同期) / 順位×売上×広告の重ね合わせ / 1ページ目占有率。</div>
      </div>

      <!-- 🎪 キャンペーン (P9) -->
      <div class="tab-pane" id="pane-campaign">
        <div class="warn-note">準備中 (P9)。実装予定: キャンペーン損益カレンダー (5のつく日/日曜/ボーナスストア参加日) / 開催日別の売上×ポイント原資×利益のベースライン比較 =「参加して儲かったのか」判定 / 参加損益シミュレーション。</div>
      </div>

      <!-- 🩺 診断 (P9) -->
      <div class="tab-pane" id="pane-diagnosis">
        <div class="warn-note">準備中 (P9)。実装予定: 稼ぎ頭 / 赤字SKU / 広告垂れ流し / 順位急落 / 死に筋 / 価格ミス疑い / SKU未解決 / CVR異常 の自動判定リスト。</div>
      </div>

      <!-- 📥 取込 (P5) -->
      <div class="tab-pane" id="pane-import">
        <div class="warn-note">準備中 (P5)。実装予定: コマースアドマネージャー広告詳細 (日次×約30ファイル一括) / PRオプションレポート / 利用明細 (billing+receipt) / 商品分析レポート / 検索流入レポート のドラッグ&ドロップ取込 (種別自動判別・file_hash重複排除) + データ鮮度ボード (前月分が翌月10日まで未取込ならGChat通知)。<br>月次確定 (広告費・PF手数料) は当面 <a href="/apps/yahoo-accounting" target="_blank">Yahoo!売上集計ツール</a> の請求明細取込を参照します。</div>
      </div>

      <!-- ⚙️ 設定 (P3) -->
      <div class="tab-pane" id="pane-settings">
        <div class="section-h">料率マスタ (改定日付き履歴) <span class="note">実質利益の精緻化・2026年9月改定シミュレーション (将来Phase) の入力になります。未来日の改定予約も登録可</span></div>
        <div class="table-scroll"><table class="data" id="rate-current"></table></div>
        <div class="form-grid" style="display:flex; gap:10px; flex-wrap:wrap; align-items:end; margin:12px 0;">
          <div><label class="note">料率種別</label><br><select id="rate-key"></select></div>
          <div><label class="note">料率 (%)</label><br><input type="text" id="rate-pct" placeholder="例: 3" style="width:80px; border:1px solid #d1d5db; border-radius:6px; padding:6px 10px;"></div>
          <div><label class="note">適用開始日</label><br><input type="date" id="rate-from" style="border:1px solid #d1d5db; border-radius:6px; padding:5px 10px;"></div>
          <div style="flex:1;"><label class="note">メモ</label><br><input type="text" id="rate-memo" placeholder="例: 2026-09改定" style="width:100%; border:1px solid #d1d5db; border-radius:6px; padding:6px 10px;"></div>
          <div><button class="btn" id="rate-add">追加</button></div>
        </div>
        <div class="note" id="rate-status"></div>
        <div class="section-h">改定履歴</div>
        <div class="table-scroll"><table class="data" id="rate-history"></table></div>

        <div class="section-h">分析閾値</div>
        <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:end;" id="settings-form"></div>
        <div style="margin-top:10px;"><button class="btn" id="settings-save">閾値を保存</button> <span class="note" id="settings-status"></span></div>
      </div>
    </div>
  </div>

  <!-- SKU詳細ダイアログ -->
  <dialog id="sku-dialog">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
      <h3 style="margin:0; font-size:15px;" id="sku-dialog-title"></h3>
      <button class="btn secondary" onclick="document.getElementById('sku-dialog').close()">閉じる</button>
    </div>
    <div class="note" id="sku-dialog-meta"></div>
    <div class="chart-wrap"><canvas id="chart-sku-daily"></canvas></div>
    <div class="chart-wrap" style="margin-top:12px;"><canvas id="chart-sku-waterfall"></canvas></div>
  </dialog>

<script>
// ============================================================
// 共通 util
// ============================================================
const API = '/apps/yahoo-analytics/api/v1';
const charts = {};
function destroyChart(id) { if (charts[id]) { charts[id].destroy(); delete charts[id]; } }
function mkChart(id, cfg) { destroyChart(id); charts[id] = new Chart(document.getElementById(id).getContext('2d'), cfg); return charts[id]; }

// 金額: 経営向け日本語単位 (億/万) — feedback_japanese_currency_units
function fmtJPY(n) {
  if (n === null || n === undefined) return '−';
  const neg = n < 0; const a = Math.abs(Math.round(n));
  let s;
  if (a >= 100000000) s = (a / 100000000).toFixed(2).replace(/\.?0+$/, '') + '億円';
  else if (a >= 10000) s = Math.round(a / 10000).toLocaleString() + '万円';
  else s = '¥' + a.toLocaleString();
  return neg ? '−' + s : s;
}
function fmtYen(n) { if (n === null || n === undefined) return '−'; return '¥' + Math.round(n).toLocaleString(); }
function fmtPct(n) { return (n === null || n === undefined) ? '−' : n + '%'; }
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function getJSON(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}
function signClass(n) { return n < 0 ? 'negv' : n > 0 ? 'pos' : ''; }

// 期間プリセット
const PRESETS = [
  ['7d', '7日'], ['14d', '14日'], ['30d', '30日'], ['90d', '90日'],
  ['this_month', '今月'], ['last_month', '先月'], ['12m', '12ヶ月'], ['this_year', '今年'],
];
function mountPeriodSwitcher(elId, defaultPreset, onChange) {
  const el = document.getElementById(elId);
  el.innerHTML = PRESETS.map(([k, label]) =>
    `<button data-preset="${k}" class="${k === defaultPreset ? 'active' : ''}">${label}</button>`).join('');
  el.addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    el.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    onChange(btn.dataset.preset);
  });
}

// ============================================================
// タブ制御 (lazy load)
// ============================================================
const loaded = {};
document.getElementById('tabs').addEventListener('click', (e) => {
  const btn = e.target.closest('.tab-btn'); if (!btn) return;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('pane-' + btn.dataset.tab).classList.add('active');
  loadTab(btn.dataset.tab);
});
function loadTab(tab) {
  if (loaded[tab]) return;
  loaded[tab] = true;
  ({ overview: loadOverview, profit: loadProfit, bestsellers: loadBestsellers, settings: loadSettings }[tab] || (() => {}))();
}
function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }

// ============================================================
// 🏠 概要
// ============================================================
let ovPreset = '30d';
async function loadOverview() {
  try {
    const data = await getJSON(API + '/overview');
    document.getElementById('meta-updated').textContent =
      `データ最終日: ${data.data_to || '−'} / 生成: ${new Date(data.generated_at).toLocaleString('ja-JP')}`;
    document.getElementById('ov-freshness').textContent =
      'factは毎朝07:00更新 (出荷完了+入金済のみ計上)。「今日」タイルは翌朝の更新まで0のままです。';
    if (data.unresolved && data.unresolved.sku_count > 0) {
      document.getElementById('ov-unresolved').innerHTML =
        `<div class="warn-note">⚠️ SKU未解決: 今月 <b>${data.unresolved.sku_count}</b> SKU / 売上 ${fmtJPY(data.unresolved.sales_incl)} (${fmtPct(data.unresolved.share_pct)}) が商品マスタに紐づいていません (原価0円計上のため粗利が過大に出ます)。💰利益分析タブ下部の「SKU未解決一覧」から解消できます。</div>`;
    }
    const tiles = data.tiles.map(t => {
      const confirmedRows = t.confirmed !== undefined ? (t.confirmed ? `
