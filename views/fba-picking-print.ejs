<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body { font-family: "Hiragino Sans", "Meiryo", sans-serif; margin: 12px; color: #111; }
    h2 { font-size: 16px; margin: 4px 0 8px; }
    h3 { font-size: 14px; margin: 16px 0 6px; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th, td { border: 1px solid #999; padding: 3px 5px; text-align: left; vertical-align: top; }
    th { background: #e0e0e0; font-weight: bold; }
    tbody tr:nth-child(even) { background: #f5f5f5; }
    tr.dodai-row { background: #fde2e2 !important; }
    .dodai-tag { color: #b91c1c; font-weight: bold; }
    .meta { font-size: 11px; color: #555; margin-bottom: 8px; }
    .toolbar { margin-bottom: 12px; }
    .toolbar button, .toolbar a { padding: 8px 16px; font-size: 13px; border: 1px solid #ccc; border-radius: 6px; background: #2563eb; color: #fff; cursor: pointer; text-decoration: none; }
    .toolbar a.sec { background: #e5e7eb; color: #374151; }
    /* プラン別シートは「前にプラン別シートがある時だけ」改ページ。先頭シートは改ページしないので
       1枚目が meta だけの空白ページにならない。
       ※ 旧 .plan-sheet:first-of-type はタグ(最初のdiv=toolbar)を指し効かなかった。隣接セレクタで確実化。 */
    .plan-sheet + .plan-sheet { page-break-before: always; }
    .planno { white-space: pre-line; }
    /* プラン別シート: 列幅を固定し、商品名を狭く(2行折返し可)、納品箱Noを広く。行高を一定寄りに。 */
    .plan-table { table-layout: fixed; }
    .plan-table td { vertical-align: middle; word-break: break-word; overflow-wrap: anywhere; }
    .plan-table .c-num { text-align: center; }
    .plan-table .c-qty { text-align: right; }
    /* どのプラン/種類のシートかを各ページ(改ページ後)にも表示する繰り返しタイトル行 */
    .plan-sheet-title { background: #222; color: #fff; font-size: 13px; font-weight: bold; text-align: left; padding: 5px 6px; }
    .runs-nav { margin: 8px 0 12px; font-size: 12px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .runs-nav .rn-label { color: #555; font-weight: bold; }
    .runs-nav a { padding: 3px 8px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #2563eb; background: #fff; }
    .runs-nav a.cur { background: #2563eb; color: #fff; border-color: #2563eb; }
    @media print {
      .toolbar { display: none; }
      .runs-nav { display: none; }
      body { margin: 0; }
      thead { display: table-header-group; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button onclick="window.print()">🖨 印刷 / PDF保存</button>
    <% if (!isPublic) { %><a class="sec" href="/apps/fba-replenishment/picking-prep">&larr; 戻る</a><% } %>
  </div>

  <% if (locals.runs && locals.runs.length) { %>
    <div class="runs-nav">
      <span class="rn-label">回を選択:</span>
      <% locals.runs.forEach(function(rn){ %>
        <a class="<%= rn.id === currentRunId ? 'cur' : '' %>" href="/print/picking/<%= rn.id %>"><%= rn.run_at %></a>
      <% }); %>
    </div>
  <% } %>

  <% if (runId) { %><div class="meta">実行ID: <%= runId %> / 実行日時: <%= runAt %></div><% } %>

  <% if (!planSheets || planSheets.length === 0) { %>
    <p>プラン別シートのデータがありません。</p>
  <% } %>
  <% (planSheets || []).forEach(function(ps, i){ %>
      <div class="plan-sheet">
        <table class="plan-table">
          <colgroup>
            <col style="width:4%"><col style="width:11%"><col style="width:27%"><col style="width:6%">
            <col style="width:12%"><col style="width:12%"><col style="width:19%"><col style="width:9%">
          </colgroup>
          <thead>
            <tr><th colspan="8" class="plan-sheet-title"><%= ps.plan %> / <%= ps.kind %> （<%= ps.sheet %>）　〔納品プランNo接頭辞: <%= ps.label %>〕</th></tr>
            <tr><th>No</th><th>FNSKU</th><th>商品名</th><th>数量</th><th>ラベル貼り担当者</th><th>ラベル貼り確認担当者</th><th>納品箱No</th><th>期限管理商品</th></tr>
          </thead>
          <tbody>
            <% ps.rows.forEach(function(row){ %>
              <tr>
                <td class="c-num"><%= row.no %></td>
                <td><%= row.fnsku %></td>
                <td><%= row.productName %></td>
                <td class="c-qty"><%= row.qty %></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
  <% }); %>
</body>
</html>
