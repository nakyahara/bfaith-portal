  <!-- ─── 常時 present: 共通 helper + タブA ロジック ─── -->
  <script>
    const HTML_ESCAPE_MAP = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    function escapeHtml(s) {
      if (s === null || s === undefined) return '';
      return String(s).replace(/[&<>"']/g, ch => HTML_ESCAPE_MAP[ch]);
    }
    function formatNumber(n) {
      if (n === null || n === undefined || !Number.isFinite(Number(n))) return '-';
      return Number(n).toLocaleString('ja-JP');
    }
    function formatCurrency(n) {
      if (n === null || n === undefined || !Number.isFinite(Number(n))) return '-';
      return '¥' + Math.round(Number(n)).toLocaleString('ja-JP');
    }
    function localDateString(d) {
      const date = d instanceof Date ? d : new Date(d || Date.now());
      return date.toLocaleDateString('sv-SE');
    }
    async function fetchJson(url, options) {
      const res = await fetch(url, options);
      const text = await res.text();
      let data = null;
      try { data = text ? JSON.parse(text) : null; } catch {}
      if (!res.ok) {
        const err = new Error((data && data.error) || `HTTP ${res.status}`);
        err.status = res.status;
        err.body = data;
        throw err;
      }
      return data;
    }

    // ─── タブA: モール別粗利分析（既存機能） ───
    const MALL_FEE_RATES_LABEL = { amazon: 'Amazon', rakuten: '楽天', yahoo: 'Yahoo!', aupay: 'au PAY', qoo10: 'Qoo10', linegift: 'LINEギフト', mercari: 'メルカリ' };
    let currentData = [];
    let currentView = 'worst';
    // 🚨 表示先 (#table-container) はタブ共通。読み込み中にタブを切り替えると、
    //    遅れて返った応答が別タブの表を上書きする。連番で「まだ自分の番か」を確かめる
    let loadSeq = 0;
    const nextLoad = () => ++loadSeq;
    const stillMine = (seq, view) => seq === loadSeq && currentView === view;
    let sortCol = 'margin_rate';
    let sortAsc = true;

    // 画面の見出し。どのタブが「実績」でどれが「これから」なのかを言葉で出す
    const VIEW_INTRO = {
      worst:  ['粗利ワースト商品', '直近の販売実績から、粗利の低い商品を洗い出します'],
      border: ['粗利率 10〜15% の商品', 'あと少しで健全になる商品。値上げ・送料区分の見直しが効きます'],
      trend:  ['前月比で悪化した商品', '先月より粗利が落ちた商品を、落ち幅の大きい順に出します'],
      mall:   ['同じ商品のモール別比較', '複数モールに出している商品を並べて、どこが取れていないかを見ます'],
      expected: ['想定利益 (いま1個売ったら)', '販売実績は使いません。登録価格とマスタだけで「1個売ったら手元にいくら残るか」を全出品ぶん計算した、昨夜の結果です'],
    };

    function switchProfitView(view) {
      currentView = view;
      nextLoad();                      // 前のタブ向けに走っている読み込みを無効にする
      document.querySelectorAll('#pd-sub-tabs-a .sub-tab').forEach(t => t.classList.toggle('active', t.dataset.view === view));
      const isExpected = view === 'expected';
      const intro = VIEW_INTRO[view] || VIEW_INTRO.worst;
      const titleEl = document.getElementById('pd-view-title');
      const leadEl = document.getElementById('pd-view-lead');
      if (titleEl) titleEl.textContent = intro[0];
      if (leadEl) leadEl.textContent = intro[1];
      // 🚨 想定利益は実績を使わない別系統。実績タブ用の操作・数字をそのまま残すと、
      //    上の KPI が「想定利益の集計」だと誤読される (2026-09-08 作り直し)
      const hideOnExpected = [
        document.getElementById('pd-filters-actual'),
        document.getElementById('fee-status'),
        document.getElementById('summary-cards'),
        document.getElementById('pd-tab-a-actions'),
        document.getElementById('pd-notice-actual'),
      ];
      for (const el of hideOnExpected) { if (el) el.style.display = isExpected ? 'none' : ''; }
      if (view === 'trend') {
        loadTrendData();
      } else if (view === 'expected') {
        loadExpectedProfit();
      } else {
        renderTable();
      }
    }

    // ─── 想定利益 (単品販売シナリオ) ───
    // 実績を使わず、夜間に作った世代を読むだけ。計算はここでしない
    let epState = { rows: [], summary: null, published: null, scope: 'self_v1', sort: 'margin', order: 'desc',
      rankOnly: true, mall: '' };

    async function loadExpectedProfit() {
      const seq = nextLoad();
      const c = document.getElementById('table-container');
      c.innerHTML = '<div class="loading">想定利益を読み込み中...</div>';
      try {
        const res = await fetchJson('/apps/profit-analysis/api/expected-profit?' + epQuery({ limit: '500' }));
        if (!stillMine(seq, 'expected')) return;      // 実績タブへ移っていたら描かない
        epState.rows = res.rows || [];
        epState.summary = res.summary;
        epState.published = res.published;
        epState.total = res.total;
        renderExpectedProfit();
      } catch (e) {
        if (!stillMine(seq, 'expected')) return;
        c.innerHTML = '<div class="empty" style="color:#dc2626;">エラー: ' + escapeHtml(e.message) + '</div>';
      }
    }

    /**
     * 🚨 このタブの絞り込みは epState だけで持つ (Codex 2巡目 [中])。
     *    実績タブの #filter-mall に書き戻していたので、想定利益でモールを変えて
     *    実績タブへ戻ると、断りなく実績側の絞り込みまで変わっていた
     */
    function epQuery(extra) {
      const q = new URLSearchParams({
        scope: epState.scope, sort: epState.sort, order: epState.order,
        rank_only: epState.rankOnly ? '1' : '0', ...(extra || {}),
      });
      if (epState.mall) q.set('mall', epState.mall);
      return q.toString();
    }

    function epNum(v, digits) {
      if (v == null || !isFinite(v)) return '—';
      return Number(v).toLocaleString('ja-JP', { maximumFractionDigits: digits == null ? 0 : digits });
    }
    function epPct(v) {
      if (v == null || !isFinite(v)) return '—';
      return (v * 100).toFixed(1) + '%';
    }

    // 除外・不成立の理由を日本語にする。英語のまま出すと現場で読めない
    var EP_REASON = {
      quantity_shipping_unknown: 'まとめ買い出品 (送料が単品前提)',
      quantity_variation_suspected: 'まとめ買いの疑い (価格の開きが大きい)',
      shipping_revenue_unknown: '送料収入が不明',
      shipping_master_missing: '送料区分が未登録',
      ne_code_not_found: 'NE品番に紐づいていない',
      multiple_ne_codes: '1出品が複数のNE品番を指している',
      product_not_found: 'NE商品が見つからない',
      cost_missing: '原価が未登録',
      set_cost_incomplete: 'セット原価が未完成',
      price_missing: '売価が取れていない',
      fee_missing: '手数料の見積が無い',
      fba_fee_missing: 'FBA配送代行の見積が無い',
      fee_revision_crossed: '手数料改定をまたいだ見積',
      fulfillment_unresolved: '出荷区分が判定できない',
      not_own_price: '自社の価格ではない',
      scenario_undecidable: '標準シナリオに当てはまらない',
      mall_fee_rate_unknown: 'モールの手数料率が未設定',
      listing_inactive: '出品が停止中',
      listing_incomplete: '出品情報が未完成',
      listing_hidden: '非公開の出品',
      empty_enumeration: '出品を1件も取れていない',
      enum_failed: '出品の取得に失敗',
    };
    function epReason(code) {
      if (!code) return '参考値';
      if (EP_REASON[code]) return EP_REASON[code];
    // `${入力}_${状態}` 形式 (例 cost_expired) はそのまま出すが、よくある語だけ置き換える
      var m = String(code).replace(/^listing_enum_/, '出品一覧が ').replace(/^price_/, '売価が ')
        .replace(/^cost_/, '原価が ').replace(/^fee_/, '手数料が ').replace(/^shipping_master_/, '送料区分が ')
        .replace(/expired$/, '期限切れ').replace(/missing$/, '未取得');
      return m;
    }

    // 表の列。🚨 まとまり (colspan) と実際のセル数がずれると表が1列ずれるので、
    //    見出しも本体もこの定義から作る (数え間違いを起こさない)
    const EP_GROUPS = [
      { label: '商品', span: 1, stickyL: true },
      { label: '売上', span: 3 },
      { label: '仕入', span: 2 },
      { label: '配送にかかる費用', span: 7 },
      { label: 'モールに払う手数料', span: 5 },
      { label: '結果', span: 2, stickyR: true },
    ];
    const EP_COLS = [
      { label: '商品', stickyL: true },
      { label: '売価(税抜)' }, { label: '売価(税込)' }, { label: '送料収入' },
      { label: '原価(税抜)' }, { label: '何個ぶん' },
      { label: '使った配送' }, { label: '送料' }, { label: '出荷作業料' }, { label: '梱包資材費' },
      { label: '人件費' }, { label: '配送費 小計' }, { label: 'FBA配送代行' },
      { label: '販売手数料' }, { label: '成約料' }, { label: '基本成約料' }, { label: '手数料 合計' }, { label: '手数料率' },
      { label: '想定利益', stickyR2: true }, { label: '想定利益率', stickyR: true },
    ];

    function renderExpectedProfit() {
      const c = document.getElementById('table-container');
      if (!epState.published) {
        c.innerHTML = '<div class="empty">まだ計算結果がありません。夜間バッチ (毎日 23:30) が動くとここに出ます。</div>';
        return;
      }
      const s = epState.summary || {};
      const p = epState.published;
      const degraded = (p.malls_degraded || [])
        .map(function (d) { return escapeHtml(d.mall) + '(' + escapeHtml(d.reason) + ')'; }).join(', ');

      let html = '';

      // ── 1. この数字は何なのか (§9.1: 前提を常に見せる) ──
      html += '<div class="ep-note">';
      html += '<div><b>この表の見方</b> — 1注文・1個・同梱なし・送料無料ラインなし・クーポンやポイントなし・返品なしで'
        + '「<b>今この出品を1個売ったら手元にいくら残るか</b>」。販売実績は使いません</div>';
      html += '<div class="ep-note-warn"><b>含んでいない費用</b>: 広告費 / ポイント原資 / クーポン原資 / 返品。'
        + 'FBA では納品の配送費・納品準備・保管料・長期保管手数料も含みません</div>';
      html += '<div class="ep-note-meta">Amazon の手数料は SP-API の<b>見積</b>です (確定請求額ではありません)。'
        + '他モールは料率からの<b>簡易見積</b>で、ポイント原資やアフィリエイトを含みません</div>';
      html += '<div class="ep-gen ep-note-meta" style="margin-top:6px;">'
        + '<span>計算 ' + escapeHtml(epWhen(p.built_at)) + '</span>'
        + '<span>公開 ' + escapeHtml(epWhen(p.published_at)) + '</span>'
        + '<span>世代 ' + escapeHtml(p.generation_id || '—') + ' (seq ' + epNum(p.seq) + ')</span>'
        + (degraded ? '<span style="color:var(--neg);">取得が劣化: ' + degraded + '</span>' : '')
        + '</div>';
      html += '</div>';

      // ── 2. 母数のうちどれだけ数字になっているか ──
      const negative = epState.rows.filter(function (r) { return r.expected_profit != null && r.expected_profit < 0; }).length;
      html += '<div class="summary-cards">';
      html += epCard('対象の出品', epNum(s.total), '昨夜みつかった全出品');
      html += epCard('計算できた', epNum(s.ok), s.total ? Math.round((s.ok / s.total) * 100) + '% が金額になった' : '');
      html += epCard('ランキング対象', epNum(s.rankEligible), '前提どおりに計算できたぶん');
      html += epCard('計算できなかった', epNum(s.total - s.ok), '原価・送料区分・紐づけの未登録', (s.total - s.ok) > 0 ? 'warning' : '');
      html += epCard('赤字の出品', epNum(negative), '表示中 ' + epNum(epState.rows.length) + ' 件のうち', negative > 0 ? 'danger' : 'success');
      html += '</div>';

      // ── 3. 操作 ──
      html += '<div class="filters">';
      // モール絞り込みはこの世代に入っているモールだけ出す (無いモールを選ばせない)
      const mallNow = epState.mall;
      html += '<label>モール: <select id="ep-mall"><option value="">全モール</option>';
      for (const m of (p.malls_included || [])) {
        html += '<option value="' + escapeHtml(m) + '"' + (mallNow === m ? ' selected' : '') + '>'
          + escapeHtml(MALL_FEE_RATES_LABEL[m] || m) + '</option>';
      }
      html += '</select></label>';
      html += '<label>費用の範囲: <select id="ep-scope">'
        + '<option value="self_v1"' + (epState.scope === 'self_v1' ? ' selected' : '') + '>自社出荷 (送料・作業料・資材・人件費)</option>'
        + '<option value="fba_v1"' + (epState.scope === 'fba_v1' ? ' selected' : '') + '>FBA (配送代行手数料)</option>'
        + '</select></label>';
      html += '<label>並び: <select id="ep-sort">'
        + '<option value="margin"' + (epState.sort === 'margin' ? ' selected' : '') + '>利益率</option>'
        + '<option value="profit"' + (epState.sort === 'profit' ? ' selected' : '') + '>利益額</option>'
        + '</select></label>';
      html += '<label>順: <select id="ep-order">'
        + '<option value="desc"' + (epState.order === 'desc' ? ' selected' : '') + '>良い順</option>'
        + '<option value="asc"' + (epState.order === 'asc' ? ' selected' : '') + '>悪い順</option>'
        + '</select></label>';
      html += '<label><input type="checkbox" id="ep-rank-only"' + (epState.rankOnly ? ' checked' : '') + '> 参考値を隠す</label>';
      html += '<button class="btn btn-export" id="ep-csv">CSV出力</button>';
      html += '<span class="notice-small" style="margin-left:auto;">🚨 費用の範囲が違うので <b>FBA と自社出荷は同じ順位表に混ぜていません</b></span>';
      html += '</div>';

      if (epState.rows.length === 0) {
        html += '<div class="empty">条件に合う行がありません</div>';
        c.innerHTML = html;
        bindExpectedProfitEvents();
        return;
      }

      // ── 4. 表 ──
      html += '<div class="table-wrap"><table class="data-table ep-table"><thead>';
      html += '<tr class="ep-group">';
      for (const g of EP_GROUPS) {
        html += '<th colspan="' + g.span + '"' + epStickyClass(g) + '>' + escapeHtml(g.label) + '</th>';
      }
      html += '</tr><tr>';
      for (const col of EP_COLS) html += '<th' + epStickyClass(col) + '>' + escapeHtml(col.label) + '</th>';
      html += '</tr></thead><tbody>';

      for (let i = 0; i < epState.rows.length; i++) {
        html += epRowHtml(epState.rows[i], i);
      }
      html += '</tbody></table></div>';
      html += '<div class="notice-small">' + epNum(epState.rows.length) + ' / ' + epNum(epState.total)
        + ' 件を表示 — 行を押すと、その1件の計算の内訳が開きます</div>';
      c.innerHTML = html;
      bindExpectedProfitEvents();
    }

    function epStickyClass(col) {
      if (col.stickyL) return ' class="ep-stick-l"';
      if (col.stickyR2) return ' class="ep-stick-r2"';
      if (col.stickyR) return ' class="ep-stick-r"';
      return '';
    }

    function epCard(label, value, sub, tone) {
      return '<div class="card' + (tone ? ' ' + tone : '') + '"><div class="label">' + escapeHtml(label) + '</div>'
        + '<div class="value">' + value + '</div>'
        + (sub ? '<div class="sub">' + escapeHtml(sub) + '</div>' : '') + '</div>';
    }

    /** ISO 文字列を「9/8 16:34」のように読める形にする */
    function epWhen(iso) {
      if (!iso) return '—';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return String(iso);
      return (d.getMonth() + 1) + '/' + d.getDate() + ' ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
    }

    /** 値が無い (その経路では発生しない) ことと 0 円を見分けられるようにする */
    function epMoney(v) {
      return (v == null ? '<span class="ep-none">—</span>' : epNum(v));
    }

    /**
     * 🚨 この計算で実際に使った配送。中原さんの指示 (2026-09-08):
     *    「どの配送方法を使ったのか記載して」。送料コード (501) だけでは何のことか読めないので、
     *    送料マスタの区分名 (ネコポス等) を正とし、無いときだけ NE 登録の配送方法に落とす
     */
    function epShippingLabel(r) {
      const name = r.shipping_rate_name || r.shipping_method;
      if (!name) return '<span class="ep-none">—</span>';
      return '<span class="ep-ship">' + escapeHtml(name) + '</span>'
        + (r.shipping_code ? '<span class="ep-ship-code">' + escapeHtml(r.shipping_code) + '</span>' : '');
    }

    function epRowHtml(r, idx) {
      const isFba = r.fulfillment === 'FBA';
      const profitClass = (r.expected_profit != null && r.expected_profit < 0) ? 'num-neg' : 'num-pos';
      let rowClass = '';
      if (r.expected_profit != null && r.expected_profit < 0) rowClass = 'row-danger';
      else if (r.expected_margin_rate != null && r.expected_margin_rate < 0.05) rowClass = 'row-warning';

      let html = '<tr class="' + rowClass + '" data-ep-idx="' + idx + '">';
      // ── 商品 (左に貼り付け) ──
      const reason = r.rank_eligible_now ? '' : epReason(r.rank_exclusion_reason_now || r.incomplete_reason);
      html += '<td class="ep-stick-l">'
        + '<div class="ep-name" title="' + escapeHtml(r.product_name || '') + '">' + escapeHtml(r.product_name || '(商品名なし)') + '</div>'
        + '<div class="ep-sub">' + escapeHtml(r.mall_item_key) + ' · '
        + '<span class="badge badge-mall">' + escapeHtml(MALL_FEE_RATES_LABEL[r.mall] || r.mall) + '</span> '
        + (r.fulfillment ? '<span class="badge ' + (isFba ? 'badge-fba' : 'badge-fbm') + '">' + escapeHtml(r.fulfillment) + '</span>' : '')
        + (reason ? ' <span class="ep-chip ep-chip-warn">' + escapeHtml(reason) + '</span>' : '')
        + '</div></td>';
      // ── 売上 ──
      html += '<td>' + epNum(r.price_ex_tax) + '</td>';
      html += '<td>' + epNum(r.price_incl_tax) + '</td>';
      html += '<td>' + epMoney(r.postage_revenue_ex_tax) + '</td>';
      // ── 仕入 ──
      html += '<td>' + epMoney(r.cost_ex_tax) + '</td>';
      // まとめ買いSKU は単品原価 × 数量。何個ぶんかを出さないと原価が高すぎるように見える
      html += '<td>' + (r.unit_quantity == null ? '<span class="ep-none">—</span>'
        : (r.unit_quantity > 1 ? '<b style="color:var(--warn);">×' + r.unit_quantity + '</b>' : '1')) + '</td>';
      // ── 配送にかかる費用 (使った配送 + 内訳5 + FBA配送代行 = 7列) ──
      html += '<td style="text-align:left;">' + (isFba ? '<span class="ep-chip">Amazon (FBA)</span>' : epShippingLabel(r)) + '</td>';
      if (isFba) {
        html += '<td colspan="5" style="text-align:left;color:var(--faint);">Amazon が配送するので自社の配送費はかからない</td>';
      } else {
        html += '<td>' + epMoney(r.shipping_fee_ex_tax) + '</td>';
        html += '<td>' + epMoney(r.shipping_work_ex_tax) + '</td>';
        html += '<td>' + epMoney(r.shipping_material_ex_tax) + '</td>';
        html += '<td>' + epMoney(r.shipping_labor_ex_tax) + '</td>';
        html += '<td>' + epMoney(r.shipping_total_ex_tax) + '</td>';
      }
      html += '<td>' + epMoney(r.fba_fee_ex_tax) + '</td>';
      // ── 手数料 ──
      html += '<td>' + epMoney(r.referral_fee_ex_tax) + '</td>';
      html += '<td>' + epMoney(r.closing_fee_ex_tax) + '</td>';
      html += '<td>' + epMoney(r.per_item_fee_ex_tax) + '</td>';
      html += '<td>' + epMoney(r.fee_total_ex_tax) + '</td>';
      html += '<td>' + epPct(r.fee_rate_display) + (r.mall === 'amazon' ? '' : ' <span class="ep-none">概算</span>') + '</td>';
      // ── 結果 (右に貼り付け) ──
      html += '<td class="ep-stick-r2 ' + profitClass + '">' + epNum(r.expected_profit) + '</td>';
      html += '<td class="ep-stick-r ' + profitClass + ' ep-margin">' + epPct(r.expected_margin_rate) + '</td>';
      html += '</tr>';
      return html;
    }

    /**
     * 1行ぶんの計算内訳。「なぜこの利益になったか」を式のまま出す。
     * 🚨 ここでは計算し直さない。保存された内訳をそのまま足して見せるだけ
     */
    function epDetailHtml(r) {
      const isFba = r.fulfillment === 'FBA';
      const line = (label, v, sign) => '<div class="ep-calc-row"><span class="ep-calc-label">' + escapeHtml(label)
        + '</span><span class="ep-calc-val">' + (v == null ? '<span class="ep-none">—</span>' : (sign || '') + epNum(v)) + '</span></div>';
      let calc = '<div class="ep-calc">';
      calc += line('売価 (税抜)', r.price_ex_tax);
      if (r.postage_revenue_ex_tax) calc += line('送料収入 (税抜)', r.postage_revenue_ex_tax, '+');
      calc += line('原価 (税抜)' + (r.unit_quantity > 1 ? ' × ' + r.unit_quantity + '個ぶん' : ''), r.cost_ex_tax, '−');
      if (!isFba) calc += line('配送関係費 合計', r.shipping_total_ex_tax, '−');
      if (r.fba_fee_ex_tax != null) calc += line('FBA配送代行', r.fba_fee_ex_tax, '−');
      calc += line('モール手数料 合計', r.fee_total_ex_tax, '−');
      calc += '<div class="ep-calc-row total"><span class="ep-calc-label">想定利益</span>'
        + '<span class="ep-calc-val ' + (r.expected_profit < 0 ? 'num-neg' : 'num-pos') + '">'
        + epNum(r.expected_profit) + ' 円 (' + epPct(r.expected_margin_rate) + ')</span></div>';
      calc += '</div>';

      // 🚨 「どの配送方法を使ったか」を言葉で書く (中原さん 2026-09-08)
      const shipRevenue = { included: '送料込み (別途もらっていない)', ok: '別途もらっている', unknown: '不明 (0円として計算)' };
      let facts = '<dl class="ep-facts">';
      facts += '<dt>この計算で使った配送</dt><dd>' + (isFba
        ? 'Amazon が配送 (FBA)。自社の送料・作業料は発生しない'
        : (r.shipping_rate_name
          ? escapeHtml(r.shipping_rate_name) + ' <span class="ep-ship-code">送料コード ' + escapeHtml(r.shipping_code || '—') + '</span>'
            + (r.shipping_rate_category ? ' <span class="ep-chip">' + escapeHtml(r.shipping_rate_category) + '</span>' : '')
          : '<span class="ep-none">送料区分が未登録のため決まっていません</span>')) + '</dd>';
      if (!isFba && r.shipping_method) {
        facts += '<dt>NE に登録されている配送方法</dt><dd>' + escapeHtml(r.shipping_method) + '</dd>';
      }
      if (r.shipping_group) {
        facts += '<dt>モール側の配送パターン</dt><dd>' + escapeHtml(r.shipping_group) + '</dd>';
      }
      facts += '<dt>送料収入の扱い</dt><dd>' + escapeHtml(shipRevenue[r.shipping_revenue_status] || r.shipping_revenue_status || '—') + '</dd>';
      facts += '<dt>原価の出所</dt><dd>' + escapeHtml(r.cost_method === 'set_master' ? 'セット原価' : r.cost_method === 'single' ? '単品原価' : (r.cost_method || '—'))
        + (r.ne_code ? ' · NE品番 ' + escapeHtml(r.ne_code) : '') + '</dd>';
      facts += '<dt>手数料</dt><dd>' + (r.mall === 'amazon' ? 'SP-API の見積' : '料率からの簡易見積')
        + ' · 実効 ' + epPct(r.fee_rate_display) + '</dd>';
      if (!r.rank_eligible_now) {
        facts += '<dt>ランキングに載せていない理由</dt><dd class="ep-note-warn">'
          + escapeHtml(epReason(r.rank_exclusion_reason_now || r.incomplete_reason)) + '</dd>';
      }
      facts += '</dl>';

      return '<tr class="ep-detail"><td colspan="' + EP_COLS.length + '"><div class="ep-detail-inner">'
        + calc + facts + '</div></td></tr>';
    }

    // inline onclick は品番の ' で壊れるので addEventListener で結ぶ
    function bindExpectedProfitEvents() {
      const mallSel = document.getElementById('ep-mall');
      if (mallSel) mallSel.addEventListener('change', function () {
        // 🚨 実績タブの #filter-mall には書かない (タブ間で絞り込みが混ざる)
        epState.mall = this.value;
        loadExpectedProfit();
      });
      const scope = document.getElementById('ep-scope');
      const sort = document.getElementById('ep-sort');
      const order = document.getElementById('ep-order');
      const rankOnly = document.getElementById('ep-rank-only');
      const csv = document.getElementById('ep-csv');
      if (scope) scope.addEventListener('change', function () { epState.scope = this.value; loadExpectedProfit(); });
      if (sort) sort.addEventListener('change', function () { epState.sort = this.value; loadExpectedProfit(); });
      if (order) order.addEventListener('change', function () { epState.order = this.value; loadExpectedProfit(); });
      if (rankOnly) rankOnly.addEventListener('change', function () { epState.rankOnly = this.checked; loadExpectedProfit(); });
      if (csv) csv.addEventListener('click', function () {
        window.location.href = '/apps/profit-analysis/api/expected-profit.csv?' + epQuery();
      });

      // 行を押したら、その1件の計算の内訳を開く (もう一度押すと閉じる)。
      // 🚨 委譲で結ぶ。行ごとに inline onclick を書くと品番の ' で壊れる
      const tbody = document.querySelector('.ep-table tbody');
      if (tbody) tbody.addEventListener('click', function (ev) {
        const tr = ev.target.closest('tr[data-ep-idx]');
        if (!tr) return;
        const open = tr.nextElementSibling && tr.nextElementSibling.classList.contains('ep-detail');
        // 開いているものは1つだけにする (どの行の内訳か迷わせない)
        for (const d of tbody.querySelectorAll('tr.ep-detail')) d.remove();
        if (open) return;
        const row = epState.rows[Number(tr.dataset.epIdx)];
        if (!row) return;
        tr.insertAdjacentHTML('afterend', epDetailHtml(row));
      });
    }

    async function loadData() {
      // 🚨 想定利益タブに移っている間に返ってきた応答で、向こうの表を上書きしない
      const seq = nextLoad();
      const view = currentView;
      const days = document.getElementById('filter-days').value;
      const mall = document.getElementById('filter-mall').value;
      document.getElementById('table-container').innerHTML = '<div class="loading">データ読み込み中...</div>';
      document.getElementById('btn-load').disabled = true;
      try {
        const [profitRes, feeRes] = await Promise.all([
          fetchJson(`/apps/profit-analysis/api/profit?days=${days}&mall=${mall}`),
          fetchJson('/apps/profit-analysis/api/fee-status'),
        ]);
        // 取得したデータ自体は残す (タブを戻したときに再取得しないで済む) が、描画はしない
        currentData = profitRes.items || [];
        document.getElementById('btn-export').disabled = false;
        if (!stillMine(seq, view)) return;
        renderSummary(profitRes.summary);
        renderFeeStatus(feeRes);
        renderTable();
      } catch (e) {
        if (!stillMine(seq, view)) return;
        document.getElementById('table-container').innerHTML = `<div class="empty" style="color:#dc2626;">エラー: ${escapeHtml(e.message)}</div>`;
      } finally {
        document.getElementById('btn-load').disabled = false;
      }
    }

    async function loadTrendData() {
      const seq = nextLoad();
      const mall = document.getElementById('filter-mall').value;
      document.getElementById('table-container').innerHTML = '<div class="loading">前月比データ計算中...</div>';
      try {
        const res = await fetchJson(`/apps/profit-analysis/api/profit/trend?mall=${mall}`);
        if (!stillMine(seq, 'trend')) return;
        currentData = res.items || [];
        sortCol = 'profit_change_pct';
        sortAsc = true;
        renderTable();
      } catch (e) {
        if (!stillMine(seq, 'trend')) return;
        document.getElementById('table-container').innerHTML = `<div class="empty" style="color:#dc2626;">エラー: ${escapeHtml(e.message)}</div>`;
      }
    }

    function renderSummary(s) {
      if (!s) return;
      // 単位を書く (「848,804」が何なのか分からない、を無くす)
      document.getElementById('summary-cards').innerHTML = `
        <div class="card"><div class="label">対象商品</div><div class="value">${formatNumber(s.count)}</div><div class="sub">件</div></div>
        <div class="card"><div class="label">売上合計</div><div class="value">${formatNumber(s.total_revenue)}</div><div class="sub">円</div></div>
        <div class="card"><div class="label">原価合計</div><div class="value">${formatNumber(s.total_cost)}</div><div class="sub">円 (税込)</div></div>
        <div class="card"><div class="label">送料合計</div><div class="value">${formatNumber(s.total_shipping)}</div><div class="sub">円</div></div>
        <div class="card"><div class="label">手数料合計</div><div class="value">${formatNumber(s.total_fee)}</div><div class="sub">円</div></div>
        <div class="card ${s.total_profit < 0 ? 'danger' : 'success'}"><div class="label">粗利合計</div><div class="value">${formatNumber(s.total_profit)}</div><div class="sub">円</div></div>
        <div class="card ${s.avg_margin_rate < 10 ? 'danger' : s.avg_margin_rate < 15 ? 'warning' : 'success'}"><div class="label">平均粗利率</div><div class="value">${s.avg_margin_rate}%</div><div class="sub">売上に対する粗利</div></div>
      `;
    }

    function renderFeeStatus(f) {
      const el = document.getElementById('fee-status');
      if (f.total > 0) {
        el.innerHTML = `Amazon手数料キャッシュ: <span class="ok">${f.total}件</span> (FBA: ${f.fba}, FBM: ${f.fbm}) | 最古: ${escapeHtml(f.oldest_fetch || '-')}`;
      } else {
        el.innerHTML = `Amazon手数料キャッシュ: <span class="warn">未取得（概算15%で計算中）</span>`;
      }
    }

    function renderTable() {
      const minRevenue = parseInt(document.getElementById('filter-min-revenue').value) || 0;
      let data = currentData.filter(d => d.revenue >= minRevenue);
      if (currentView === 'worst') {
        sortCol = sortCol || 'margin_rate';
      } else if (currentView === 'border') {
        data = data.filter(d => d.margin_rate >= 10 && d.margin_rate <= 15);
      } else if (currentView === 'mall') {
        const codeCount = {};
        for (const d of data) {
          const key = d.listing_code;
          if (!codeCount[key]) codeCount[key] = new Set();
          codeCount[key].add(d.mall);
        }
        const multiMall = new Set(Object.keys(codeCount).filter(k => codeCount[k].size > 1));
        data = data.filter(d => multiMall.has(d.listing_code));
        data.sort((a, b) => a.listing_code.localeCompare(b.listing_code) || a.margin_rate - b.margin_rate);
      }
      if (currentView !== 'mall') {
        data.sort((a, b) => {
          let va = a[sortCol], vb = b[sortCol];
          if (typeof va === 'string') { va = va.toLowerCase(); vb = (vb||'').toLowerCase(); }
          if (va < vb) return sortAsc ? -1 : 1;
          if (va > vb) return sortAsc ? 1 : -1;
          return 0;
        });
      }
      if (data.length === 0) {
        document.getElementById('table-container').innerHTML = '<div class="empty">該当データなし</div>';
        return;
      }
      const isTrend = currentView === 'trend';
      const cols = [
        { key: 'product_name', label: '商品' },
        { key: 'mall', label: 'モール' },
        { key: 'qty', label: '数量' },
        { key: 'revenue', label: '売上' },
        { key: 'cost', label: '原価(税込)' },
        { key: 'shipping', label: '送料' },
        { key: 'platform_fee', label: '手数料' },
        { key: 'gross_profit', label: '粗利額' },
        { key: 'margin_rate', label: '粗利率' },
      ];
      if (isTrend) {
        cols.push({ key: 'prev_profit', label: '前月粗利' });
        cols.push({ key: 'profit_change_pct', label: '変化率' });
      }
      let html = '<div class="table-wrap"><table class="data-table"><thead><tr>';
      for (const c of cols) {
        const arrow = sortCol === c.key ? (sortAsc ? ' ↑' : ' ↓') : '';
        html += `<th data-sort-col="${escapeHtml(c.key)}" onclick="doProfitSort(this.dataset.sortCol)">${escapeHtml(c.label)}${arrow}</th>`;
      }
      html += '</tr></thead><tbody>';
      for (const d of data) {
        let rowClass = '';
        if (d.margin_rate < 5) rowClass = 'row-danger';
        else if (d.margin_rate < 10) rowClass = 'row-warning';
        else if (d.margin_rate >= 20) rowClass = 'row-success';
        const mallLabel = MALL_FEE_RATES_LABEL[d.mall] || d.mall;
        const channelBadge = d.channel === 'FBA' ? ' <span class="badge badge-fba">FBA</span>' :
                             d.channel === 'FBM' ? ' <span class="badge badge-fbm">FBM</span>' : '';
        html += `<tr class="${rowClass}">`;
        // 商品名とコードは1つのセルにまとめる (列が多いほど読みにくい)
        html += `<td class="cell-name" title="${escapeHtml(d.product_name||'')}">${escapeHtml(d.product_name || '-')}`
          + `<div class="cell-code">${escapeHtml(d.listing_code)}</div></td>`;
        html += `<td><span class="badge badge-mall">${escapeHtml(mallLabel)}</span>${channelBadge}</td>`;
        html += `<td>${formatNumber(d.qty)}</td>`;
        html += `<td>${formatNumber(d.revenue)}</td>`;
        html += `<td>${formatNumber(d.cost)}</td>`;
        html += `<td>${formatNumber(d.shipping)}</td>`;
        html += `<td>${formatNumber(d.platform_fee)}</td>`;
        html += `<td class="${d.gross_profit < 0 ? 'num-neg' : ''}">${formatNumber(d.gross_profit)}</td>`;
        html += `<td class="${d.margin_rate < 10 ? 'num-neg' : 'num-pos'}">${d.margin_rate}%</td>`;
        if (isTrend) {
          html += `<td>${formatNumber(d.prev_profit)}</td>`;
          html += `<td class="num-neg">${d.profit_change_pct}%</td>`;
        }
        html += '</tr>';
      }
      html += '</tbody></table></div>';
      html += `<div class="notice-small">${data.length}件表示 — 見出しを押すと並び替わります</div>`;
      document.getElementById('table-container').innerHTML = html;
    }

    function doProfitSort(col) {
      if (sortCol === col) { sortAsc = !sortAsc; }
      else { sortCol = col; sortAsc = col === 'margin_rate' || col === 'profit_change_pct'; }
      renderTable();
    }

    function exportCSV() {
      const minRevenue = parseInt(document.getElementById('filter-min-revenue').value) || 0;
      const data = currentData.filter(d => d.revenue >= minRevenue);
      if (!data.length) return alert('データがありません');
      const headers = ['コード','商品名','モール','チャネル','数量','売上','原価(税込)','送料','PF手数料','粗利額','粗利率%','原価ソース'];
      const rows = data.map(d => [
        d.listing_code, d.product_name, d.mall, d.channel, d.qty,
        d.revenue, d.cost, d.shipping, d.platform_fee, d.gross_profit, d.margin_rate, d.cost_source,
      ]);
      const esc = v => { const s = String(v ?? ''); return s.includes(',') || s.includes('"') || s.includes('\n') ? '"' + s.replace(/"/g, '""') + '"' : s; };
      const csv = '\uFEFF' + [headers.join(','), ...rows.map(r => r.map(esc).join(','))].join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `商品収益性ダッシュボード_モール別粗利_${currentView}_${localDateString()}.csv`;
      a.click();
    }

    // 処分率単位変換（ratio/percent）— 常時 present（他所でも useful、テストも同等実装）
    function ratioToPercent(r) {
      if (r === null || r === undefined || !Number.isFinite(Number(r))) return '';
      return Math.round(Number(r) * 1000) / 10;
    }
    function percentToRatio(p) {
      const n = Number(p);
      if (!Number.isFinite(n) || n <= 0 || n > 100) {
        throw new Error('処分率は 0% より大きく 100% 以下の数値です');
      }
      return n / 100;
    }
  </script>

<% if (featureFlagEnabled) { %>
  <!-- ─── feature flag ON 時のみ: 大タブ切替 + タブB ロジック ─── -->
  <script>
    // 大タブ切替（flag 内に閉じる）
    function switchMegaTab(section) {
      document.querySelectorAll('.pd-mega-tab').forEach(t => t.classList.toggle('active', t.dataset.section === section));
      document.getElementById('pd-tab-a').classList.toggle('active', section === 'profit');
      document.getElementById('pd-tab-b').classList.toggle('active', section === 'inventory');
      if (section === 'inventory' && !window.__pdTabBInitialized) {
        window.__pdTabBInitialized = true;
        initTabB();
      }
    }

    // ==================================================================
    // タブB: 在庫整理・撤退判断支援
    // ==================================================================
    const PD_SALES_CLASS_LABEL = { 1: '🔷 自社商品', 2: '🔸 取引先限定', 3: '🔶 仕入商品' };
    const PD_INV_SUBTABS = [
      { key: '優良在庫', label: '🟢 優良在庫', highlight: 'row-success' },
      { key: '観察継続', label: '🟡 観察継続' },
      { key: '値下げ候補', label: '🟠 値下げ候補' },
      { key: 'セット候補', label: '🔵 セット候補' },
      { key: '撤退警戒', label: '🟠 撤退警戒', highlight: 'row-warning' },
      { key: '撤退候補', label: '🔴 撤退候補', highlight: 'row-danger' },
      { key: '評価不能', label: '⚪ 評価不能' },
      { key: '分類外', label: '⚠ 分類外' },
    ];
    const PD_STATUS_COMMON = ['継続', '値下げ検討', '撤退検討', '撤退確定'];
    const PD_STATUS_SELF = ['消化計画中', 'リブランディング検討', '再生産判断中'];
    const PD_REVIEW_REQUIRED = new Set(PD_STATUS_SELF);
    const PD_REASON_REQUIRED = new Set(['撤退検討', '撤退確定', ...PD_STATUS_SELF]);
    const PD_DEFAULT_DISPOSAL_RATE = 0.5;
    // Codex R2 Medium 1 反映: client-side 形式 regex
    const PD_RE_YYYY_MM_DD = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/;
    const PD_RE_YYYY_MM = /^\d{4}-(0[1-9]|1[0-2])$/;
    // Codex R2 Low-Medium 2 反映: 形式だけでなく実在日を round-trip で検証（2026-02-31 等を弾く）
    function pdIsValidRealDate(str) {
      if (!PD_RE_YYYY_MM_DD.test(str)) return false;
      const [y, m, d] = str.split('-').map(Number);
      const dt = new Date(Date.UTC(y, m - 1, d));
      return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
    }

    const stateB = {
      salesClass: 1,
      subtab: '撤退候補',
      periodDays: 30,
      candidates: [],
      meta: null,
      thresholds: null,           // 全売上分類の閾値マトリクス（UI閾値パネル編集用、/thresholds から取得）
      appliedThresholds: null,    // Codex PR3 R3 Low-Medium 反映: /candidates レスポンスに含まれる
                                  //   現サブセットの「実際に分類に適用された」閾値スナップショット用
      disposalRate: PD_DEFAULT_DISPOSAL_RATE,
      sortCol: 'metrics.gmroi',
      sortAsc: true,
      activeRowCode: null,
      savingStatus: false,
      savingThresholds: false,
    };

    async function initTabB() {
      try {
        stateB.thresholds = await fetchJson('/apps/profit-analysis/api/inventory/thresholds');
        stateB.disposalRate = Number(stateB.thresholds.disposal_rate_default ?? PD_DEFAULT_DISPOSAL_RATE);
        document.getElementById('pd-inv-disposal-rate').value = ratioToPercent(stateB.disposalRate);
        populateThresholdInputs();
        await refreshCandidates();
      } catch (e) {
        if (e.status === 503) {
          const tabB = document.getElementById('pd-tab-b');
          const megaBtn = document.querySelector('.pd-mega-tab[data-section="inventory"]');
          if (tabB) tabB.style.display = 'none';
          if (megaBtn) megaBtn.style.display = 'none';
        } else {
          showTabBError(`初期化エラー: ${e.message}`);
        }
      }
    }

    function showTabBError(msg) {
      const el = document.getElementById('pd-tab-b-error');
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';
    }
    function clearTabBError() {
      const el = document.getElementById('pd-tab-b-error');
      if (el) el.style.display = 'none';
    }

    async function switchSalesClass(cls) {
      stateB.salesClass = Number(cls);
      document.querySelectorAll('#pd-tab-b .pd-segmented-item').forEach(b => {
        b.classList.toggle('active', Number(b.dataset.class) === stateB.salesClass);
      });
      populateThresholdInputs();
      await refreshCandidates();
    }

    function toggleThresholdPanel() {
      const el = document.getElementById('pd-threshold-panel');
      el.classList.toggle('open');
    }

    function populateThresholdInputs() {
      if (!stateB.thresholds) return;
      const ret = (stateB.thresholds.retirement || {})[String(stateB.salesClass)];
      if (ret) {
        document.getElementById('pd-threshold-class-label').textContent = `（${PD_SALES_CLASS_LABEL[stateB.salesClass]}）`;
        document.getElementById('pd-th-warn-days').value = ret.warn_days_no_sales ?? '';
        document.getElementById('pd-th-retire-days').value = ret.retire_days_no_sales ?? '';
        const isPurchase = stateB.salesClass === 3;
        document.getElementById('pd-th-warn-gmroi-row').style.display = isPurchase ? '' : 'none';
        document.getElementById('pd-th-retire-gmroi-row').style.display = isPurchase ? '' : 'none';
        document.getElementById('pd-th-retire-turnover-row').style.display = isPurchase ? '' : 'none';
        if (isPurchase) {
          document.getElementById('pd-th-warn-gmroi').value = ret.warn_gmroi_lt ?? '';
          document.getElementById('pd-th-retire-gmroi').value = ret.retire_gmroi_lt ?? '';
          document.getElementById('pd-th-retire-turnover').value = ret.retire_turnover_gt ?? '';
        }
      }
      const cls = stateB.thresholds.classification || {};
      if (cls.good_stock) {
        document.getElementById('pd-th-good-gmroi').value = cls.good_stock.gmroi_gt ?? '';
        document.getElementById('pd-th-good-turn-min').value = cls.good_stock.turnover_min ?? '';
        document.getElementById('pd-th-good-turn-max').value = cls.good_stock.turnover_max ?? '';
      }
      if (cls.observe) {
        document.getElementById('pd-th-obs-min').value = cls.observe.gmroi_min ?? '';
        document.getElementById('pd-th-obs-max').value = cls.observe.gmroi_max ?? '';
      }
      if (cls.price_down) {
        document.getElementById('pd-th-pd-turn').value = cls.price_down.turnover_gt ?? '';
        document.getElementById('pd-th-pd-turn-max').value = cls.price_down.turnover_lte ?? '';
        document.getElementById('pd-th-pd-margin').value = cls.price_down.margin_rate_gt ?? '';
        document.getElementById('pd-th-pd-sales90-min').value = cls.price_down.sales_90d_min ?? '';
      }
      if (cls.bundle_candidate) {
        document.getElementById('pd-th-bundle-turn').value = cls.bundle_candidate.turnover_gt ?? '';
      }
      document.getElementById('pd-th-disposal-rate').value = ratioToPercent(stateB.thresholds.disposal_rate_default ?? PD_DEFAULT_DISPOSAL_RATE);
    }

    async function saveThresholds() {
      if (stateB.savingThresholds) return;
      stateB.savingThresholds = true;
      document.getElementById('pd-btn-save-thresholds').disabled = true;
      document.getElementById('pd-threshold-error').textContent = '';
      try {
        const retirement = JSON.parse(JSON.stringify(stateB.thresholds.retirement || {}));
        const ret = retirement[String(stateB.salesClass)] || {};
        ret.warn_days_no_sales = Number(document.getElementById('pd-th-warn-days').value);
        ret.retire_days_no_sales = Number(document.getElementById('pd-th-retire-days').value);
        if (stateB.salesClass === 3) {
          ret.warn_gmroi_lt = Number(document.getElementById('pd-th-warn-gmroi').value);
          ret.retire_gmroi_lt = Number(document.getElementById('pd-th-retire-gmroi').value);
          ret.retire_turnover_gt = Number(document.getElementById('pd-th-retire-turnover').value);
        }
        retirement[String(stateB.salesClass)] = ret;
        const classification = {
          good_stock: {
            gmroi_gt: Number(document.getElementById('pd-th-good-gmroi').value),
            turnover_min: Number(document.getElementById('pd-th-good-turn-min').value),
            turnover_max: Number(document.getElementById('pd-th-good-turn-max').value),
          },
          observe: {
            gmroi_min: Number(document.getElementById('pd-th-obs-min').value),
            gmroi_max: Number(document.getElementById('pd-th-obs-max').value),
          },
          price_down: (() => {
            const obj = {
              turnover_gt: Number(document.getElementById('pd-th-pd-turn').value),
              margin_rate_gt: Number(document.getElementById('pd-th-pd-margin').value),
            };
            // 任意項目: 入力が空なら制限なし（フィールドを送らない）
            const turnLteRaw = document.getElementById('pd-th-pd-turn-max').value.trim();
            if (turnLteRaw !== '') obj.turnover_lte = Number(turnLteRaw);
            const sales90MinRaw = document.getElementById('pd-th-pd-sales90-min').value.trim();
            if (sales90MinRaw !== '') obj.sales_90d_min = Number(sales90MinRaw);
            return obj;
          })(),
          bundle_candidate: {
            turnover_gt: Number(document.getElementById('pd-th-bundle-turn').value),
          },
        };
        const disposal_rate_default = percentToRatio(document.getElementById('pd-th-disposal-rate').value);

        await fetchJson('/apps/profit-analysis/api/inventory/thresholds', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ retirement, classification, disposal_rate_default }),
        });

        // Codex R1 Medium: 保存後は再 GET してサーバー値を state に反映 + candidates 再取得
        stateB.thresholds = await fetchJson('/apps/profit-analysis/api/inventory/thresholds');
        stateB.disposalRate = Number(stateB.thresholds.disposal_rate_default ?? PD_DEFAULT_DISPOSAL_RATE);
        document.getElementById('pd-inv-disposal-rate').value = ratioToPercent(stateB.disposalRate);
        populateThresholdInputs();
        await refreshCandidates();
        toggleThresholdPanel();
      } catch (e) {
        document.getElementById('pd-threshold-error').textContent = e.message;
      } finally {
        stateB.savingThresholds = false;
        document.getElementById('pd-btn-save-thresholds').disabled = false;
      }
    }

    async function refreshCandidates() {
      clearTabBError();
      const periodDays = Number(document.getElementById('pd-inv-period-days').value) || 30;
      stateB.periodDays = periodDays;
      document.getElementById('pd-inv-table-container').innerHTML = '<div class="loading">候補取得中...</div>';
      try {
        // Codex PR3 実装 R1 Medium 2 反映: 閾値も毎回再同期して stale を防ぐ
        // Codex PR3 実装 R2 Low 3 反映: thresholds 失敗は best-effort で警告のみ、候補表示は継続
        const data = await fetchJson(`/apps/profit-analysis/api/inventory/candidates?sales_class=${stateB.salesClass}&period_days=${periodDays}`);
        stateB.candidates = Array.isArray(data.candidates) ? data.candidates : [];
        stateB.meta = data.meta || null;
        // Codex PR3 R3 Low-Medium 反映: /candidates レスポンスの thresholds は
        //   「実際に分類に適用された」ものなので、saveStatus の snapshot 用に常に最新保持する
        // Codex R4 Low 反映: /candidates 成功でも thresholds 欠如時は null に戻す
        //   （他 salesClass の古い値を snapshot に混入させない防御）
        stateB.appliedThresholds = data.thresholds ? data.thresholds : null;
        try {
          stateB.thresholds = await fetchJson('/apps/profit-analysis/api/inventory/thresholds');
        } catch (tErr) {
          // thresholds 取得失敗時は既存 state を保持。画面には警告のみ
          console.warn('[inventory-decision] thresholds 再取得失敗（既存値を継続利用）:', tErr.message);
          showTabBError(`閾値の再取得に失敗しました（候補は最新、閾値パネルは前回値、保存時の snapshot は候補適用値を使用）: ${tErr.message}`);
        }
        updateSegmentCounts();
        renderDataPeriodNote();
        renderImpactCards();
        renderInventorySubtabs();
        renderInventoryTable();
        document.getElementById('pd-btn-export-inv').disabled = stateB.candidates.length === 0;
      } catch (e) {
        showTabBError(`候補取得エラー: ${e.message}`);
        document.getElementById('pd-inv-table-container').innerHTML = '';
        document.getElementById('pd-btn-export-inv').disabled = true;
      }
    }

    function updateSegmentCounts() {
      const el1 = document.getElementById('pd-seg-count-1');
      const el2 = document.getElementById('pd-seg-count-2');
      const el3 = document.getElementById('pd-seg-count-3');
      const total = stateB.candidates.length;
      const currentLabel = stateB.salesClass === 1 ? el1 : stateB.salesClass === 2 ? el2 : el3;
      if (currentLabel) currentLabel.textContent = ` (${total})`;
      [el1, el2, el3].forEach(el => { if (el && el !== currentLabel) el.textContent = ''; });
    }

    function renderDataPeriodNote() {
      const note = document.getElementById('pd-inv-data-period-note');
      const periodDays = stateB.periodDays;
      const snapshotMonths = stateB.candidates.reduce((m, c) => Math.max(m, Number(c?.metrics?.stock_snapshot_months) || 0), 0);
      const warn = snapshotMonths < 6 ? `（在庫スナップショット ${snapshotMonths}/6ヶ月、不足）` : '';
      note.textContent = `判定期間 ${periodDays}日 ${warn}`;
    }

    function onDisposalRateChange() {
      try {
        const input = document.getElementById('pd-inv-disposal-rate').value;
        stateB.disposalRate = percentToRatio(input);
        renderImpactCards();
      } catch (e) {
        showTabBError(e.message);
        document.getElementById('pd-inv-disposal-rate').value = ratioToPercent(stateB.disposalRate);
      }
    }

    function renderImpactCards() {
      const el = document.getElementById('pd-impact-cards');
      if (!el) return;
      const subtab = stateB.subtab;
      const subset = stateB.candidates.filter(c => c.classification === subtab);
      // 評価損見込み = avg_stock_value × disposal_rate (PR3 §6-A、二重計上しない)
      const totalImpact = subset.reduce((s, c) => s + (Number(c?.metrics?.avg_stock_value) || 0) * stateB.disposalRate, 0);
      const totalLostProfit = subset.reduce((s, c) => s + (Number(c?.metrics?.period_profit) || 0), 0);
      const annualLost = stateB.periodDays > 0 ? totalLostProfit * (365 / stateB.periodDays) : 0;
      const totalStockValue = subset.reduce((s, c) => s + (Number(c?.metrics?.avg_stock_value) || 0), 0);
      el.innerHTML = `
        <div class="card"><div class="label">対象商品数</div><div class="value">${formatNumber(subset.length)}</div><div class="sub">${escapeHtml(subtab)}</div></div>
        <div class="card"><div class="label">在庫金額合計（平均）</div><div class="value">${formatCurrency(totalStockValue)}</div><div class="sub">avg_stock × 原価</div></div>
        <div class="card ${totalImpact > 0 ? 'danger' : ''}"><div class="label">評価損見込み</div><div class="value">${formatCurrency(totalImpact)}</div><div class="sub">処分率 ${ratioToPercent(stateB.disposalRate)}% 適用</div></div>
        <div class="card"><div class="label">年間粗利逸失見込み</div><div class="value">${formatCurrency(annualLost)}</div><div class="sub">期間粗利 × (365/${stateB.periodDays})</div></div>
      `;
    }

    function renderInventorySubtabs() {
      const summary = (stateB.meta && stateB.meta.summary) || {};
      const container = document.getElementById('pd-inv-subtabs');
      let html = '';
      for (const st of PD_INV_SUBTABS) {
        const count = summary[st.key] || 0;
        const active = stateB.subtab === st.key ? 'active' : '';
        html += `<button class="sub-tab ${active}" data-pd-inv-subtab="${escapeHtml(st.key)}">${escapeHtml(st.label)}<span class="count">${formatNumber(count)}</span></button>`;
      }
      container.innerHTML = html;
      // Codex PR3 R1 High 3 反映: inline onclick を廃し event delegation
      container.querySelectorAll('[data-pd-inv-subtab]').forEach(btn => {
        btn.addEventListener('click', () => switchInventorySubtab(btn.dataset.pdInvSubtab));
      });
    }

    function switchInventorySubtab(key) {
      stateB.subtab = key;
      document.querySelectorAll('#pd-tab-b #pd-inv-subtabs .sub-tab').forEach(t => t.classList.toggle('active', t.dataset.pdInvSubtab === key));
      renderImpactCards();
      renderInventoryTable();
    }

    function getByPath(obj, path) {
      if (!obj || !path) return undefined;
      return path.split('.').reduce((acc, k) => (acc == null ? acc : acc[k]), obj);
    }

    function renderInventoryTable() {
      const container = document.getElementById('pd-inv-table-container');
      const subset = stateB.candidates.filter(c => c.classification === stateB.subtab);
      if (subset.length === 0) {
        container.innerHTML = '<div class="empty">該当なし</div>';
        return;
      }
      subset.sort((a, b) => {
        let va = getByPath(a, stateB.sortCol);
        let vb = getByPath(b, stateB.sortCol);
        if (va === null || va === undefined) return 1;
        if (vb === null || vb === undefined) return -1;
        if (typeof va === 'string') { va = va.toLowerCase(); vb = String(vb).toLowerCase(); }
        if (va < vb) return stateB.sortAsc ? -1 : 1;
        if (va > vb) return stateB.sortAsc ? 1 : -1;
        return 0;
      });

      const cols = [
        { key: 'ne_product_code', label: 'NE品番' },
        { key: 'product_name', label: '商品名' },
        { key: 'supplier_code', label: '仕入先' },
        { key: 'metrics.latest_stock', label: '現在庫' },
        { key: 'sales.sales_period', label: `販売(判定${stateB.periodDays}日)` },
        { key: 'sales.sales_30d', label: '直近30日' },
        { key: 'sales.sales_90d', label: '直近90日' },
        { key: 'metrics.gmroi', label: 'GMROI(年率)%' },
        { key: 'metrics.turnover_days', label: '回転日数' },
        { key: 'metrics.rakuten_unit_profit', label: '利益単価' },
        { key: 'metrics.days_since_sale', label: '最終販売経過' },
        { key: 'reason', label: '理由/フラグ' },
        { key: 'action', label: '操作', sortable: false },
      ];

      let html = '<div class="table-wrap"><table class="data-table"><thead><tr>';
      for (const c of cols) {
        if (c.sortable === false) {
          html += `<th>${escapeHtml(c.label)}</th>`;
        } else {
          const arrow = stateB.sortCol === c.key ? (stateB.sortAsc ? ' ▲' : ' ▼') : '';
          html += `<th data-pd-sort="${escapeHtml(c.key)}">${escapeHtml(c.label)}${arrow}</th>`;
        }
      }
      html += '</tr></thead><tbody>';

      for (const c of subset) {
        const m = c.metrics || {};
        const s = c.sales || {};
        const f = c.flags || {};
        const st = c.retirement_status;
        const chips = [];
        if (c.early_warning && c.early_warning.type) {
          const ewLabel = {
            drop: '⚠ 急落', insufficient: '判定不足', indeterminate: '判定不能', skip: 'EW対象外',
          }[c.early_warning.type];
          if (ewLabel) chips.push(`<span class="pd-flag-chip pd-chip-ew-${escapeHtml(c.early_warning.type)}" title="${escapeHtml(c.early_warning.reason || '')}">${escapeHtml(ewLabel)}</span>`);
        }
        if (f.stock_data_insufficient) chips.push('<span class="pd-flag-chip pd-chip-data-insufficient" title="在庫スナップショット月数不足">📉 在庫データ不足</span>');
        if (f.seasonality_off_season) chips.push('<span class="pd-flag-chip pd-chip-seasonality" title="季節性オフシーズン">❄ 季節性</span>');
        if (f.new_product) chips.push('<span class="pd-flag-chip pd-chip-new-product" title="新商品（12ヶ月未満）">🆕 新商品</span>');
        if (st && st.status) chips.push(`<span class="pd-flag-chip pd-chip-status" title="${escapeHtml(st.next_review_date || '')}">📋 ${escapeHtml(st.status)}</span>`);

        const rowHi = PD_INV_SUBTABS.find(t => t.key === c.classification)?.highlight || '';
        html += `<tr class="${rowHi}">`;
        html += `<td>${escapeHtml(c.ne_product_code || '')}</td>`;
        html += `<td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;" title="${escapeHtml(c.product_name || '')}">${escapeHtml(c.product_name || '-')}</td>`;
        html += `<td>${escapeHtml(c.supplier_code || '-')}</td>`;
        html += `<td>${formatNumber(m.latest_stock)}</td>`;
        html += `<td>${formatNumber(s.sales_period)}</td>`;
        html += `<td>${formatNumber(s.sales_30d)}</td>`;
        html += `<td>${formatNumber(s.sales_90d)}</td>`;
        html += `<td>${m.gmroi == null ? '-' : formatNumber(Math.round(m.gmroi)) + '%'}</td>`;
        html += `<td>${m.turnover_days == null ? '-' : formatNumber(m.turnover_days)}</td>`;
        html += `<td>${formatCurrency(m.rakuten_unit_profit)}</td>`;
        html += `<td>${m.days_since_sale == null ? '-' : formatNumber(m.days_since_sale)}</td>`;
        html += `<td style="white-space:normal;max-width:220px;">${escapeHtml(c.reason || '')} ${chips.join(' ')}</td>`;
        // Codex PR3 R1 High 3 反映: inline onclick を廃し data-attribute + event delegation に
        html += `<td><button class="btn btn-secondary" style="font-size:11px;padding:3px 8px;" data-pd-open-status="${escapeHtml(c.ne_product_code || '')}">判断付与</button></td>`;
        html += '</tr>';
      }
      html += '</tbody></table></div>';
      html += `<div style="font-size:11px;color:#9ca3af;margin-top:4px;">${subset.length}件表示 / 全体 ${stateB.candidates.length}件</div>`;
      if (stateB.subtab === '分類外' && stateB.meta && stateB.meta.reason_summary) {
        const keys = Object.keys(stateB.meta.reason_summary).filter(k => k.startsWith('分類外: '));
        if (keys.length > 0) {
          html += '<div style="font-size:11px;color:#6b7280;margin-top:4px;">理由別内訳: ';
          html += keys.map(k => `${escapeHtml(k.replace('分類外: ', ''))}: ${stateB.meta.reason_summary[k]}件`).join(' / ');
          html += '</div>';
        }
      }
      container.innerHTML = html;
      // event delegation: data-pd-sort / data-pd-open-status
      container.querySelectorAll('th[data-pd-sort]').forEach(th => {
        th.addEventListener('click', () => doInvSort(th.dataset.pdSort));
      });
      container.querySelectorAll('button[data-pd-open-status]').forEach(btn => {
        btn.addEventListener('click', () => openStatusModal(btn.dataset.pdOpenStatus));
      });
    }

    function doInvSort(col) {
      if (stateB.sortCol === col) { stateB.sortAsc = !stateB.sortAsc; }
      else { stateB.sortCol = col; stateB.sortAsc = col === 'metrics.gmroi' ? true : false; }
      renderInventoryTable();
    }

    // ─── ステータス付与モーダル ───

    async function openStatusModal(code) {
      if (!code) return;
      stateB.activeRowCode = code;
      const candidate = stateB.candidates.find(c => c.ne_product_code === code);
      if (!candidate) { showTabBError(`商品 ${code} が候補リストにありません`); return; }

      // Codex R1 Medium 2 反映: モーダル開く時にも最新 thresholds を同期
      try {
        stateB.thresholds = await fetchJson('/apps/profit-analysis/api/inventory/thresholds');
      } catch {}

      document.getElementById('pd-status-modal-product').textContent = `${code} / ${candidate.product_name || ''}`;
      document.getElementById('pd-status-modal-current').textContent = candidate.retirement_status?.status || '未設定';
      document.getElementById('pd-status-reason').value = candidate.retirement_status?.reason || '';
      document.getElementById('pd-status-next-review').value = candidate.retirement_status?.next_review_date || '';
      document.getElementById('pd-plan-target-month').value = '';
      document.getElementById('pd-plan-monthly-target').value = '';
      document.getElementById('pd-status-disposal-rate').value = ratioToPercent(candidate.retirement_status?.disposal_rate || stateB.disposalRate);
      document.getElementById('pd-status-error').textContent = '';

      if (candidate.retirement_status && candidate.retirement_status.status) {
        try {
          const latest = await fetchJson(`/apps/profit-analysis/api/inventory/status/${encodeURIComponent(code)}`);
          if (latest && latest.disposal_rate != null) {
            document.getElementById('pd-status-disposal-rate').value = ratioToPercent(latest.disposal_rate);
          }
        } catch {}
      }

      const group = document.getElementById('pd-status-radio-group');
      const options = [...PD_STATUS_COMMON];
      if (stateB.salesClass === 1) options.push(...PD_STATUS_SELF);
      group.innerHTML = options.map(st => {
        const checked = (candidate.retirement_status?.status === st) ? 'checked' : '';
        return `<label><input type="radio" name="pd-status-radio" value="${escapeHtml(st)}" ${checked}>${escapeHtml(st)}</label>`;
      }).join('');
      group.querySelectorAll('input[type=radio]').forEach(r => r.addEventListener('change', onStatusChange));
      onStatusChange();

      document.getElementById('pd-status-modal').classList.add('open');
    }

    function onStatusChange() {
      const sel = document.querySelector('#pd-status-radio-group input[type=radio]:checked');
      const val = sel ? sel.value : '';
      document.getElementById('pd-review-required-mark').textContent = PD_REVIEW_REQUIRED.has(val) ? '（必須）' : '';
      document.getElementById('pd-reason-required-mark').textContent = PD_REASON_REQUIRED.has(val) ? '（必須）' : '';
      document.getElementById('pd-plan-details-section').style.display = (val === '消化計画中') ? '' : 'none';
    }

    function closeStatusModal() {
      document.getElementById('pd-status-modal').classList.remove('open');
      stateB.activeRowCode = null;
    }
    function onStatusModalBackdrop(ev) {
      if (ev.target.id === 'pd-status-modal') closeStatusModal();
    }

    // ─── マニュアルモーダル ───
    function openManualModal() {
      document.getElementById('pd-manual-modal').classList.add('open');
    }
    function closeManualModal() {
      document.getElementById('pd-manual-modal').classList.remove('open');
    }
    // 開閉のイベント委譲（XSS 対策で onclick=inline を使わない既存ポリシーに準拠）
    document.addEventListener('click', (ev) => {
      const opener = ev.target.closest('[data-pd-open-manual]');
      if (opener) { ev.preventDefault(); openManualModal(); return; }
      const closer = ev.target.closest('[data-pd-close-manual]');
      if (closer) { ev.preventDefault(); closeManualModal(); return; }
      const backdrop = document.getElementById('pd-manual-modal');
      if (backdrop && ev.target === backdrop) closeManualModal();
    });

    async function saveStatus() {
      if (stateB.savingStatus) return;
      stateB.savingStatus = true;
      document.getElementById('pd-btn-status-save').disabled = true;
      document.getElementById('pd-btn-status-cancel').disabled = true;
      document.getElementById('pd-status-error').textContent = '';
      try {
        const sel = document.querySelector('#pd-status-radio-group input[type=radio]:checked');
        if (!sel) throw new Error('ステータスを選択してください');
        const status = sel.value;
        const reason = document.getElementById('pd-status-reason').value.trim();
        const next_review_date = document.getElementById('pd-status-next-review').value || null;
        const disposal_rate = percentToRatio(document.getElementById('pd-status-disposal-rate').value);

        if (PD_REASON_REQUIRED.has(status) && !reason) throw new Error(`${status} は判断根拠 (reason) 必須です`);
        if (PD_REVIEW_REQUIRED.has(status) && !next_review_date) throw new Error(`${status} は次回レビュー日必須です`);
        // Codex PR3 R1 Medium 1 + R2 Low-Medium 2 反映: 形式 + 実在日
        if (next_review_date && !pdIsValidRealDate(next_review_date)) {
          throw new Error('次回レビュー日は YYYY-MM-DD 形式の実在日');
        }

        let plan_details;
        if (status === '消化計画中') {
          const target_month = document.getElementById('pd-plan-target-month').value.trim();
          const monthly_sales_target = Number(document.getElementById('pd-plan-monthly-target').value);
          if (!PD_RE_YYYY_MM.test(target_month)) throw new Error('完売予測月は YYYY-MM 形式（01〜12）');
          if (!Number.isInteger(monthly_sales_target) || monthly_sales_target <= 0) {
            throw new Error('月次販売目標は正の整数');
          }
          plan_details = { target_month, monthly_sales_target };
        }

        const c = stateB.candidates.find(x => x.ne_product_code === stateB.activeRowCode);
        const decision_metrics = c ? {
          sales_class: c.sales_class,
          classification: c.classification,
          gmroi: c.metrics?.gmroi,
          turnover_days: c.metrics?.turnover_days,
          latest_stock: c.metrics?.latest_stock,
          avg_stock: c.metrics?.avg_stock,
          rakuten_unit_profit: c.metrics?.rakuten_unit_profit,
          period_days: stateB.periodDays,
          stock_snapshot_months: c.metrics?.stock_snapshot_months,
          disposal_rate,
          early_warning: c.early_warning,
          stock_data_insufficient: !!(c.flags && c.flags.stock_data_insufficient),
        } : {};
        // Codex PR3 R3 Low-Medium 反映: snapshot は /candidates が実際に使った閾値を優先
        //   （/thresholds 再取得失敗で stateB.thresholds が stale の時、audit で新分類/古閾値の乖離を防ぐ）
        //   /candidates の thresholds は現在の salesClass に適用された値のみ（retirement は該当クラスのみ）
        const applied = stateB.appliedThresholds || {};
        const thresholds = {
          retirement: applied.retirement || (stateB.thresholds?.retirement?.[String(stateB.salesClass)]) || null,
          classification: applied.classification || stateB.thresholds?.classification || null,
          early_warning: applied.early_warning || stateB.thresholds?.early_warning || null,
        };

        const body = {
          ne_product_code: stateB.activeRowCode,
          status,
          reason: reason || undefined,
          next_review_date: next_review_date || undefined,
          disposal_rate,
          plan_details,
          thresholds,
          decision_metrics,
        };
        await fetchJson('/apps/profit-analysis/api/inventory/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        closeStatusModal();
        await refreshCandidates();
      } catch (e) {
        document.getElementById('pd-status-error').textContent = e.message;
      } finally {
        stateB.savingStatus = false;
        document.getElementById('pd-btn-status-save').disabled = false;
        document.getElementById('pd-btn-status-cancel').disabled = false;
      }
    }

    function exportInventoryCSV() {
      const subset = stateB.candidates.filter(c => c.classification === stateB.subtab);
      if (!subset.length) return alert('データがありません');
      const headers = ['NE品番','商品名','仕入先','現在庫','販売_期間','販売_30日','販売_90日','GMROI%','回転日数','利益単価','最終販売経過','分類','理由','早期警戒','在庫データ不足','季節性','新商品','現ステータス'];
      const rows = subset.map(c => {
        const m = c.metrics || {}; const s = c.sales || {}; const f = c.flags || {};
        return [
          c.ne_product_code, c.product_name, c.supplier_code, m.latest_stock, s.sales_period, s.sales_30d, s.sales_90d,
          m.gmroi == null ? '' : Math.round(m.gmroi), m.turnover_days, m.rakuten_unit_profit, m.days_since_sale,
          c.classification, c.reason,
          c.early_warning?.type || '', f.stock_data_insufficient ? '1' : '', f.seasonality_off_season ? '1' : '', f.new_product ? '1' : '',
          c.retirement_status?.status || '',
        ];
      });
      const esc = v => { const s = String(v ?? ''); return s.includes(',') || s.includes('"') || s.includes('\n') ? '"' + s.replace(/"/g, '""') + '"' : s; };
      const csv = '\uFEFF' + [headers.join(','), ...rows.map(r => r.map(esc).join(','))].join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      const salesClassSlug = { 1: '自社商品', 2: '取引先限定', 3: '仕入商品' }[stateB.salesClass] || 'unknown';
      a.download = `商品収益性ダッシュボード_${salesClassSlug}_${stateB.subtab}_${stateB.periodDays}日_${localDateString()}.csv`;
      a.click();
    }

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        const sModal = document.getElementById('pd-status-modal');
        if (sModal && sModal.classList.contains('open')) { closeStatusModal(); return; }
        const mModal = document.getElementById('pd-manual-modal');
        if (mModal && mModal.classList.contains('open')) { closeManualModal(); return; }
      }
    });
  </script>
<% } %>

</body>
</html>
