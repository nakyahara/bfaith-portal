<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>商品収益性ダッシュボード - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png"><link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <style>
    /* ─── 常時 present: 画面ぜんぶで使う見た目 (2026-09-09 作り直し) ───
       ねらい = 「人が見て分かる」。数字は等幅で桁を揃え、良い/悪いは色ではなく
       色 + 記号で示す。表は横に長いので、商品名 (左) と 結果 (右) を貼り付ける

       見た目は**航空計器 (グラスコックピット) の配色体系**に寄せた (中原さん指示: 近未来感)。
         緑 = 正常 / 琥珀 = 注意 / 赤 = 警告 / マゼンタ = 人が決めた基準値
       強い赤は「許容していない想定赤字」だけに使う。全部が目立つ画面は何も目立たない

       🚨 色は必ずこのトークンから取る。ここに無い色を直書きすると、
          ダークの地に明るい前提の色が乗って読めなくなる */
    :root {
      --ink: #dce6f2; --ink-2: #b9c8dc; --muted: #9ab0c8; --faint: #7d90ac;
      --line: #22314a; --line-2: #1a2637; --bg: #070c16; --card: #0f1929;
      --card-2: #142138;                    /* 一段持ち上げた面 (選択中・展開部) */
      --brand: #56cef2; --brand-dark: #7bdcfa;
      --pos: #35d693; --pos-bg: #072a1f; --neg: #ff6670; --neg-bg: #2c1219;
      --neg-edge: #83262f;                  /* 赤字パネルの枠 */
      --warn: #f0a93a; --warn-bg: #2b2009;
      --mag: #da8cff;                       /* 人が決めた値 (許容の上限・売価のライン) */
      --slate: #788cac;
      --shadow: 0 1px 0 rgba(255,255,255,.04) inset, 0 10px 28px rgba(0,0,0,.4);
      --radius: 4px;
      /* 費目の色 (内訳バーと凡例で同じ色を使う) */
      --c-cost: #5e88f5; --c-ship: #f0a93a; --c-hand: #c08434; --c-fee: #b285ed; --c-fba: #56cef2;
      /* 🚨 貼り付けた結果2列の幅。オフセット (right) と幅を同じ値から出さないと、
         中身が広がったときに左の列が右の列に重なる */
      --ep-r-col: 112px;
    }
    /* 🚨 フォントは画面ぜんぶメイリオ (中原さん指定 2026-09-09)。
       数字は tabular-nums で桁を縦に揃える (上下に読み比べるため) */
    body {
      background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased;
      font-family: "Meiryo", "メイリオ", "Hiragino Sans", "ヒラギノ角ゴシック",
                   "Yu Gothic UI", "Segoe UI", system-ui, sans-serif;
    }
    /* 🚨 ヘッダのクラスは .portal-header (style.css)。.top-nav は存在しないので効かない。
       2026-09-08 に同じ間違いでヘッダが素のテキストになっていた。地に合わせるだけにする */
    .portal-header { background: var(--card); border-bottom: 1px solid var(--line); color: var(--ink); }
    .container { max-width: 1760px; margin: 0 auto; padding: 20px 24px 40px; }
    .header-row { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
    .header-row h2 { margin: 0; font-size: 21px; letter-spacing: .01em; }
    .page-lead { font-size: 12.5px; color: var(--muted); margin-top: 4px; }

    .notice { background: var(--warn-bg); border: 1px solid var(--warn); border-left: 4px solid var(--warn);
      border-radius: 8px; padding: 10px 14px; font-size: 12.5px; color: var(--warn); margin-bottom: 14px; }
    .notice-small { font-size: 11.5px; color: var(--muted); margin-top: 4px; }

    /* KPI タイル */
    .summary-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; box-shadow: var(--shadow); }
    .card .label { font-size: 11.5px; color: var(--muted); font-weight: 500; letter-spacing: .02em; }
    .card .value { font-size: 22px; font-weight: 650; margin-top: 6px; color: var(--ink);
      font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
    .card .sub { font-size: 11px; color: var(--faint); margin-top: 2px; }
    .card.danger { border-color: var(--neg-edge); background: linear-gradient(0deg, var(--neg-bg), var(--neg-bg)); }
    .card.danger .value { color: var(--neg); }
    .card.warning { border-color: var(--warn); background: var(--warn-bg); }
    .card.warning .value { color: var(--warn); }
    .card.success { border-color: var(--pos); background: var(--pos-bg); }
    .card.success .value { color: var(--pos); }

    /* タブ = 押せると分かる形にする (下線1本だと押せると気づかれない) */
    .sub-tabs { display: inline-flex; gap: 2px; margin-bottom: 14px; flex-wrap: wrap;
      background: var(--card-2); border-radius: 10px; padding: 3px; }
    .sub-tab { padding: 7px 15px; border: none; background: none; cursor: pointer; font-size: 13px;
      font-weight: 600; color: var(--ink-2); border-radius: 8px; transition: background .12s, color .12s; }
    .sub-tab:hover:not(.active) { background: rgba(255,255,255,.06); }
    .sub-tab.active { background: var(--card); color: var(--brand); box-shadow: var(--shadow); }

    .filters { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 14px;
      background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; box-shadow: var(--shadow); }
    .filters label { font-size: 12.5px; color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px; }
    .filters select, .filters input { padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px;
      font-size: 13px; color: var(--ink); background: var(--bg); }
    .filters select:focus, .filters input:focus { outline: 2px solid var(--line); outline-offset: -1px; border-color: var(--brand); }

    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 15px; border: 1px solid transparent;
      border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; transition: background .12s, box-shadow .12s; }
    .btn-primary { background: var(--brand); color: var(--bg); box-shadow: var(--shadow); }
    .btn-primary:hover:not(:disabled) { background: var(--brand-dark); }
    .btn-primary:disabled { background: var(--line); cursor: not-allowed; box-shadow: none; }
    .btn-export { background: var(--card); color: var(--ink-2); border-color: var(--line); box-shadow: var(--shadow); }
    .btn-export:hover:not(:disabled) { background: var(--card-2); }
    .btn-export:disabled { color: var(--faint); cursor: not-allowed; box-shadow: none; }
    .btn-secondary { background: var(--card); color: var(--ink-2); border-color: var(--line); }
    .btn-secondary:hover:not(:disabled) { background: var(--card-2); }

    /* 表 */
    .table-wrap { max-height: calc(100vh - 330px); overflow: auto; border: 1px solid var(--line);
      border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); }
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 12.5px; }
    .data-table th, .data-table td { border-bottom: 1px solid var(--line-2); padding: 8px 10px;
      text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .data-table th { background: var(--card-2); position: sticky; top: 0; z-index: 10; text-align: right;
      font-size: 11.5px; font-weight: 600; color: var(--ink-2); cursor: pointer; user-select: none;
      border-bottom: 1px solid var(--line); }
    .data-table th:hover { background: var(--line); }
    /* 商品名に幅を寄せる。放っておくとモール列だけ間延びして読みにくい */
    .data-table:not(.ep-table) td:first-child, .data-table:not(.ep-table) th:first-child { width: 30%; }
    /* 文字の列だけ左寄せ。数字は右寄せのまま (ep-table は独自に指定する) */
    .data-table:not(.ep-table) td:nth-child(1), .data-table:not(.ep-table) td:nth-child(2),
    .data-table:not(.ep-table) th:nth-child(1), .data-table:not(.ep-table) th:nth-child(2) { text-align: left; }
    .data-table tbody tr:hover { background: var(--card-2); }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .num-pos { color: var(--pos); font-weight: 650; }
    .num-neg { color: var(--neg); font-weight: 650; }
    .cell-name { max-width: 320px; overflow: hidden; text-overflow: ellipsis; }
    .cell-code { color: var(--muted); font-size: 11.5px; }

    .row-danger { background: var(--neg-bg); }
    .row-danger:hover { background: var(--neg-bg) !important; }
    .row-warning { background: var(--warn-bg); }
    .row-warning:hover { background: var(--warn-bg) !important; }
    .row-success { background: var(--pos-bg); }
    .row-success:hover { background: var(--pos-bg) !important; }

    .badge { display: inline-block; padding: 2px 7px; border-radius: 20px; font-size: 10.5px; font-weight: 600; line-height: 1.5; }
    .badge-fba { background: var(--card-2); color: var(--brand); }
    .badge-fbm { background: var(--warn-bg); color: var(--warn); }
    .badge-mall { background: var(--card-2); color: var(--ink-2); }

    .loading { text-align: center; padding: 48px; color: var(--muted); }
    .empty { text-align: center; padding: 48px; color: var(--faint); }

    .fee-status { font-size: 11.5px; color: var(--muted); margin-bottom: 10px; }
    .fee-status .ok { color: var(--pos); font-weight: 600; }
    .fee-status .warn { color: var(--warn); font-weight: 600; }

    /* ─── 想定利益タブ ─── */
    .ep-table { font-size: 12.5px; }
    .ep-table th, .ep-table td { white-space: nowrap; }
    .ep-table .ep-group th { background: var(--card-2); color: var(--ink-2); font-size: 11px; text-align: center;
      font-weight: 700; letter-spacing: .04em; border-right: 1px solid var(--line); top: 0; }
    .ep-table thead tr:nth-child(2) th { top: 29px; }
    /* 🚨 横に長い表なので、商品 (左) と 結果 (右) は貼り付けて常に見えるようにする */
    .ep-table th.ep-stick-l, .ep-table td.ep-stick-l { position: sticky; left: 0; z-index: 5; background: var(--card);
      border-right: 1px solid var(--line); text-align: left; box-shadow: 6px 0 8px -8px rgba(2,5,12,.72); }
    .ep-table thead th.ep-stick-l { z-index: 12; background: var(--card-2); }
    .ep-table .ep-group th.ep-stick-l { z-index: 13; background: var(--card-2); }
    /* 🚨 結果は2列とも右に貼る。両方 right:0 にすると重なって片方が読めなくなる */
    .ep-table th.ep-stick-r, .ep-table td.ep-stick-r,
    .ep-table th.ep-stick-r2, .ep-table td.ep-stick-r2 { position: sticky; z-index: 5; background: var(--card); }
    .ep-table th.ep-stick-r2, .ep-table td.ep-stick-r2 { right: var(--ep-r-col); border-left: 1px solid var(--line);
      box-shadow: -6px 0 8px -8px rgba(2,5,12,.72); }
    .ep-table th.ep-stick-r, .ep-table td.ep-stick-r { right: 0; }
    .ep-table th.ep-stick-r, .ep-table td.ep-stick-r,
    .ep-table th.ep-stick-r2, .ep-table td.ep-stick-r2 {
      width: var(--ep-r-col); min-width: var(--ep-r-col); max-width: var(--ep-r-col); }
    .ep-table thead th.ep-stick-r, .ep-table thead th.ep-stick-r2 { z-index: 12; background: var(--card-2); }
    .ep-table .ep-group th.ep-stick-r { z-index: 13; background: var(--card-2); right: 0; border-left: 1px solid var(--line); }
    .ep-table tbody tr:hover td.ep-stick-r2 { background: var(--card-2); }
    .ep-table tbody tr.row-danger td.ep-stick-r2 { background: var(--neg-bg); }
    .ep-table tbody tr.row-warning td.ep-stick-l, .ep-table tbody tr.row-warning td.ep-stick-r,
    .ep-table tbody tr.row-warning td.ep-stick-r2 { background: var(--warn-bg); }
    .ep-table tbody tr:hover td.ep-stick-l, .ep-table tbody tr:hover td.ep-stick-r { background: var(--card-2); }
    .ep-table tbody tr.row-danger td.ep-stick-l, .ep-table tbody tr.row-danger td.ep-stick-r { background: var(--neg-bg); }
    .ep-table tbody tr { cursor: pointer; }
    .ep-name { font-weight: 600; color: var(--ink); max-width: 300px; overflow: hidden; text-overflow: ellipsis; }
    .ep-sub { font-size: 11px; color: var(--muted); margin-top: 1px; }
    .ep-margin { font-weight: 700; font-size: 13.5px; }
    .ep-none { color: var(--muted); }   /* 「未取得」と「0 円」を見分ける印。薄くしすぎると消える */
    .ep-ship { color: var(--ink); }
    .ep-ship-code { color: var(--faint); font-size: 11px; margin-left: 4px; }
    .ep-chip { display: inline-block; padding: 1px 7px; border-radius: 20px; font-size: 10.5px;
      background: var(--card-2); color: var(--ink-2); font-weight: 600; }
    .ep-chip-warn { background: var(--warn-bg); color: var(--warn); }

    .ep-note { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 12px 14px; margin-bottom: 12px; font-size: 12.5px; line-height: 1.75; box-shadow: var(--shadow); }
    .ep-note b { color: var(--ink); }
    .ep-note .ep-note-warn { color: var(--warn); }
    .ep-note .ep-note-meta { color: var(--muted); font-size: 11.5px; }
    .ep-gen { display: flex; flex-wrap: wrap; gap: 16px; align-items: baseline; }

    /* 1行ぶんの計算内訳 (行を押すと開く) */
    .ep-detail td { background: var(--card-2); padding: 0; }
    /* 🚨 表は横に長いので、内訳は左に貼り付けて横スクロールしなくても読めるようにする。
       .data-table td の text-align:right をここで打ち消す (打ち消さないと文字が右端へ飛ぶ) */
    .ep-detail-inner { padding: 14px 18px; display: grid; grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
      gap: 28px; white-space: normal; text-align: left; position: sticky; left: 0; max-width: 1180px; }
    .ep-calc { font-size: 12.5px; }
    .ep-calc-row { display: flex; justify-content: space-between; gap: 20px; padding: 4px 0; border-bottom: 1px dashed var(--line); }
    .ep-calc-row:last-child { border-bottom: none; }
    .ep-calc-row.total { font-weight: 700; border-top: 2px solid var(--line); border-bottom: none; margin-top: 4px; padding-top: 8px; }
    .ep-calc-label { color: var(--ink-2); }
    .ep-calc-val { font-variant-numeric: tabular-nums; }
    .ep-facts { font-size: 12.5px; line-height: 1.9; }
    .ep-facts dt { color: var(--muted); font-size: 11.5px; }
    .ep-facts dd { margin: 0 0 6px; color: var(--ink); }
<% if (featureFlagEnabled) { %>

    /* ─── 以下、feature flag ON 時のみ出力（Dark Launch 漏れ防止） ─── */
    .impact-cards .card .value { font-size: 20px; }
    .impact-cards .card .sub { font-size: 11px; color: var(--faint); margin-top: 2px; }

    .pd-mega-tabs { display: flex; gap: 8px; margin-bottom: 16px; border-bottom: 3px solid var(--brand); }
    .pd-mega-tab { padding: 12px 24px; border: none; background: var(--card-2); cursor: pointer; font-size: 15px; font-weight: 600; color: var(--muted); border-radius: 6px 6px 0 0; margin-bottom: -3px; }
    .pd-mega-tab.active { color: var(--bg); background: var(--brand); border-bottom: 3px solid var(--brand); }
    .pd-mega-tab:hover:not(.active) { background: var(--line); color: var(--ink); }
    .pd-tab-panel { display: none; }
    .pd-tab-panel.active { display: block; }

    .sub-tab .count { font-size: 11px; color: var(--faint); margin-left: 4px; }
    .sub-tab.active .count { color: var(--brand); }

    .pd-flag-chip { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 10px; font-weight: 600; margin-right: 3px; white-space: nowrap; }
    .pd-chip-ew-drop { background: var(--neg-bg); color: var(--neg); }
    .pd-chip-ew-insufficient { background: var(--warn-bg); color: var(--warn); }
    .pd-chip-ew-indeterminate { background: var(--card-2); color: var(--brand); }
    .pd-chip-ew-skip { background: var(--card-2); color: var(--muted); }
    .pd-chip-data-insufficient { background: var(--warn-bg); color: var(--warn); }
    .pd-chip-seasonality { background: var(--pos-bg); color: var(--pos); }
    .pd-chip-new-product { background: var(--card-2); color: var(--mag); }
    .pd-chip-status { background: var(--card-2); color: var(--brand); border: 1px dashed var(--brand); }

    .pd-segmented { display: inline-flex; background: var(--card-2); border-radius: 8px; padding: 3px; margin-bottom: 12px; }
    .pd-segmented-item { padding: 8px 16px; border: none; background: transparent; cursor: pointer; font-size: 13px; font-weight: 500; color: var(--muted); border-radius: 6px; }
    .pd-segmented-item.active { background: var(--card); color: var(--brand); box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .pd-segmented-item .pd-segment-count { font-size: 11px; color: var(--faint); margin-left: 4px; }
    .pd-segmented-item.active .pd-segment-count { color: var(--brand); }

    .pd-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center; z-index: 100; }
    .pd-modal-backdrop.open { display: flex; }
    .pd-modal-box { background: var(--card); border-radius: 10px; padding: 24px; max-width: 720px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .pd-modal-title { font-size: 16px; font-weight: 700; margin: 0 0 12px; color: var(--ink); }
    .pd-modal-row { margin-bottom: 12px; font-size: 13px; }
    .pd-modal-row label { display: block; margin-bottom: 4px; color: var(--muted); font-weight: 500; }
    .pd-modal-row input[type=text], .pd-modal-row input[type=number], .pd-modal-row input[type=date], .pd-modal-row textarea, .pd-modal-row select {
      width: 100%; padding: 6px 10px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px; box-sizing: border-box;
    }
    .pd-modal-row textarea { min-height: 60px; resize: vertical; }
    .pd-modal-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .pd-modal-section { background: var(--card-2); padding: 10px 12px; border-radius: 6px; margin-bottom: 12px; }
    .pd-modal-error { color: var(--neg); font-size: 12px; margin-top: 4px; }
    .pd-modal-footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
    .pd-manual-box { max-width: 880px; }
    .pd-manual-h3 { font-size: 14px; font-weight: 700; margin: 18px 0 8px; color: var(--ink); border-left: 4px solid var(--brand); padding-left: 8px; }
    .pd-manual-list { margin: 0 0 8px 20px; padding: 0; font-size: 13px; line-height: 1.7; color: var(--ink); }
    .pd-manual-list ul { margin: 4px 0 4px 20px; }
    .pd-manual-list code { background: var(--card-2); padding: 1px 5px; border-radius: 3px; font-size: 12px; }
    .pd-manual-table { width: 100%; border-collapse: collapse; font-size: 12px; margin: 6px 0; }
    .pd-manual-table th, .pd-manual-table td { border: 1px solid var(--card-2); padding: 6px 8px; text-align: left; vertical-align: top; }
    .pd-manual-table th { background: var(--card-2); font-weight: 600; }
    .pd-manual-table td:first-child { white-space: nowrap; font-weight: 600; }
    .pd-status-radio-group { display: flex; flex-wrap: wrap; gap: 8px; }
    .pd-status-radio-group label { display: flex; align-items: center; gap: 4px; padding: 4px 10px; border: 1px solid var(--card-2); border-radius: 20px; cursor: pointer; }
    .pd-status-radio-group input[type=radio] { margin: 0; }
    .pd-status-radio-group label:has(input:checked) { background: var(--card-2); border-color: var(--brand); color: var(--brand); font-weight: 600; }

    .pd-threshold-panel { background: var(--card-2); border: 1px solid var(--card-2); border-radius: 8px; padding: 16px; margin-bottom: 16px; display: none; }
    .pd-threshold-panel.open { display: block; }
    .pd-threshold-row { display: grid; grid-template-columns: 220px 1fr; gap: 10px; align-items: center; margin-bottom: 8px; font-size: 13px; }
    .pd-threshold-row label { color: var(--muted); }
    .pd-threshold-row input { padding: 5px 8px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px; width: 120px; }
    .pd-threshold-section { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--card-2); }
    .pd-threshold-section:last-child { border-bottom: none; }
    .pd-threshold-section h3 { font-size: 13px; font-weight: 700; color: var(--ink); margin: 0 0 8px; }

    .pd-error-banner { background: var(--neg-bg); border: 1px solid var(--neg); color: var(--neg); border-radius: 6px; padding: 8px 14px; font-size: 12px; margin-bottom: 12px; }
<% } %>

    /* ═══════════════════════════════════════════════════════════════════
       想定利益タブ = 想定赤字モニター (2026-09-09 作り直し・中原さん指示)

       3 層に分ける:
         ① 一目で分かる層 … 警告灯 1 つ。強い赤はここだけ
         ② 掘る層         … 4 つの山 → 一覧 (テープ行)
         ③ 証拠を見る層   … 行を開くと「入る/出る」の 2 本 + 24 列の内訳

       🚨 24 列は消していない。「全列で照合」に切り替えると今までの表が出る
       ═══════════════════════════════════════════════════════════════════ */

    /* ── 前提の 1 行 (常時) ── */
    .ep-premise { display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      background: var(--card-2); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 8px 14px; font-size: 12.5px; color: var(--muted); margin-bottom: 12px; }
    .ep-premise b { color: var(--ink); }
    .ep-link { background: none; border: none; color: var(--brand); font: inherit; font-size: 12.5px;
      cursor: pointer; text-decoration: underline; text-underline-offset: 3px; padding: 2px 0; }
    .ep-link:hover { color: var(--brand-dark); }

    /* ── ① 警告灯 ── */
    .ep-ann { display: grid; grid-template-columns: 6px 1fr auto; align-items: stretch;
      background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
      overflow: hidden; margin-bottom: 10px; box-shadow: var(--shadow); }
    .ep-ann.alert { border-color: var(--neg-edge); }
    .ep-ann-bar { background: var(--slate); }
    .ep-ann.alert .ep-ann-bar { background: var(--neg); }
    .ep-ann.hold  .ep-ann-bar { background: var(--warn); }
    .ep-ann.clear .ep-ann-bar { background: var(--pos); }
    .ep-ann-body { padding: 16px 20px 18px; }
    .ep-ann-eyebrow { font-size: 12px; letter-spacing: .13em; font-weight: 700; margin-bottom: 5px; color: var(--slate); }
    .ep-ann.alert .ep-ann-eyebrow { color: var(--neg); }
    .ep-ann.hold  .ep-ann-eyebrow { color: var(--warn); }
    .ep-ann.clear .ep-ann-eyebrow { color: var(--pos); }
    .ep-ann-lead { font-size: 13.5px; color: var(--muted); margin: 0 0 14px; line-height: 1.65; max-width: 76ch; }
    .ep-ann-lead b { color: var(--ink); }
    .ep-figs { display: flex; flex-wrap: wrap; gap: 16px 42px; }
    .ep-fig-label { font-size: 12px; color: var(--muted); letter-spacing: .04em; }
    .ep-fig-value { font-size: 40px; font-weight: 700; line-height: 1.1; letter-spacing: -.02em;
      font-variant-numeric: tabular-nums; color: var(--ink); }
    .ep-ann.alert .ep-fig-value.lead { color: var(--neg); }
    .ep-fig-value.mid { font-size: 25px; }
    .ep-fig-value.mid.warn { color: var(--warn); }
    .ep-fig-unit { font-size: 19px; }
    .ep-fig-note { font-size: 12px; color: var(--faint); margin-top: 2px; }
    .ep-ann-action { display: flex; align-items: center; padding: 0 20px; border-left: 1px solid var(--line); }

    /* ── ② 4 つの山 ── */
    .ep-piles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px; }
    .ep-pile { background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--line);
      border-radius: var(--radius); padding: 12px 15px 14px; cursor: pointer; text-align: left;
      font: inherit; color: inherit; display: grid; gap: 1px; min-height: 94px; }
    .ep-pile:hover { background: var(--card-2); }
    .ep-pile:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    .ep-pile[aria-pressed="true"] { background: var(--card-2); border-color: var(--slate);
      box-shadow: inset 0 -3px 0 var(--brand); }
    .ep-pile-head { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; letter-spacing: .03em; }
    .ep-pile-count { font-size: 27px; font-weight: 700; line-height: 1.25; font-variant-numeric: tabular-nums; }
    .ep-pile-sub { font-size: 12px; color: var(--muted); line-height: 1.5; }
    .ep-pile.neg   { border-left-color: var(--neg); }
    .ep-pile.neg   .ep-pile-head, .ep-pile.neg   .ep-pile-count { color: var(--neg); }
    .ep-pile.warn  { border-left-color: var(--warn); }
    .ep-pile.warn  .ep-pile-head, .ep-pile.warn  .ep-pile-count { color: var(--warn); }
    .ep-pile.slate { border-left-color: var(--slate); }
    .ep-pile.slate .ep-pile-head, .ep-pile.slate .ep-pile-count { color: var(--muted); }
    .ep-pile.mag   { border-left-color: var(--mag); }
    .ep-pile.mag   .ep-pile-head, .ep-pile.mag   .ep-pile-count { color: var(--mag); }
    .ep-glyph { width: 16px; height: 16px; border-radius: 2px; flex: none; display: inline-grid;
      place-items: center; font-size: 11px; font-weight: 700; color: var(--card); }
    .ep-glyph.neg { background: var(--neg); } .ep-glyph.warn { background: var(--warn); }
    .ep-glyph.slate { background: var(--slate); } .ep-glyph.mag { background: var(--mag); }

    /* ── 出荷区分の二択 (混ぜられないことを形で示す) ── */
    .ep-seg { display: inline-flex; background: var(--card); border: 1px solid var(--line);
      border-radius: var(--radius); overflow: hidden; }
    .ep-seg button { background: transparent; border: none; color: var(--muted); font: inherit; font-size: 13px;
      padding: 6px 16px; min-height: 44px; cursor: pointer; border-right: 1px solid var(--line);
      display: grid; gap: 1px; text-align: left; }
    .ep-seg button:last-child { border-right: none; }
    .ep-seg button[aria-pressed="true"] { background: var(--card-2); color: var(--ink); box-shadow: inset 0 -3px 0 var(--brand); }
    .ep-seg button:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; }
    .ep-seg .ep-seg-name { font-weight: 700; }
    .ep-seg .ep-seg-sub { font-size: 11px; color: var(--faint); font-variant-numeric: tabular-nums; }
    .ep-seg button[aria-pressed="true"] .ep-seg-sub { color: var(--muted); }
    .ep-seg .hot { color: var(--neg); font-weight: 700; }
    .ep-rule { font-size: 12px; color: var(--faint); border-left: 2px solid var(--mag);
      padding-left: 10px; max-width: 440px; line-height: 1.5; }
    .ep-caption { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      font-size: 12px; color: var(--muted); margin: 14px 0 6px; }
    .ep-caption b { color: var(--ink); font-size: 13px; }

    /* ── 一覧 (テープ行) ── */
    .ep-list { border-top: 1px solid var(--line); }
    .ep-tape { display: grid;
      grid-template-columns: 4px 108px minmax(0,1fr) 74px 74px 136px 94px 94px 124px 68px 30px;
      align-items: center; gap: 0 12px; width: 100%; padding: 0; text-align: left;
      font: inherit; color: inherit; cursor: pointer; min-height: 62px;
      background: var(--card); border: none; border-bottom: 1px solid var(--line); }
    .ep-tape:hover { background: var(--card-2); }
    .ep-tape:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; }
    .ep-tape[aria-expanded="true"] { background: var(--card-2); }
    .ep-stripe { align-self: stretch; }
    .sv-neg   .ep-stripe { background: var(--neg); }
    .sv-warn  .ep-stripe { background: var(--warn); }
    .sv-pos   .ep-stripe { background: var(--pos); }
    .sv-mag   .ep-stripe { background: var(--mag); }
    .sv-slate .ep-stripe { background: var(--slate); }
    .ep-state { padding: 10px 0 10px 11px; }
    .ep-state-chip { display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px; border-radius: 2px;
      font-size: 11px; font-weight: 700; letter-spacing: .02em; border: 1px solid transparent; white-space: nowrap; }
    .sv-neg   .ep-state-chip { background: var(--neg-bg); color: var(--neg); border-color: var(--neg-edge); }
    .sv-warn  .ep-state-chip { background: var(--warn-bg); color: var(--warn); border-color: var(--warn); }
    .sv-pos   .ep-state-chip { background: var(--pos-bg); color: var(--pos); }
    .sv-mag   .ep-state-chip { color: var(--mag); border-color: var(--mag); }
    .sv-slate .ep-state-chip { color: var(--muted); border-color: var(--line); }
    .ep-state-sub { display: block; font-size: 11px; color: var(--faint); margin-top: 3px; line-height: 1.4; }
    .ep-state-sub.new { color: var(--brand); font-weight: 700; }
    .ep-state-sub.back { color: var(--warn); }
    .ep-tape-main { padding: 9px 0; min-width: 0; }
    .ep-tape-name { font-size: 13.5px; font-weight: 700; color: var(--ink);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ep-tape-meta { display: flex; align-items: center; gap: 7px; margin-top: 2px; font-size: 11px; color: var(--faint); }
    .ep-tape-why { font-size: 12px; color: var(--warn); margin-top: 3px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sv-pos .ep-tape-why, .sv-slate .ep-tape-why { color: var(--faint); }
    .sv-mag .ep-tape-why { color: var(--muted); }
    .ep-cell { padding: 9px 0; text-align: right; min-width: 0; }
    .ep-cell-label { font-size: 11px; color: var(--faint); letter-spacing: .02em;
      display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* 費目のラベルは「何に・いくら」を 1 セルで言う。方法名を拾えるように色を変える */
    .ep-cell-label .how { color: var(--muted); font-weight: 700; }
    .ep-cell-val { font-size: 13.5px; display: block; margin-top: 1px; font-variant-numeric: tabular-nums; }
    .ep-cell-val.dim { color: var(--muted); }
    .ep-profit { font-size: 20px; font-weight: 700; display: block; margin-top: 1px;
      font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
    .ep-rate { font-size: 12.5px; font-weight: 700; display: block; margin-top: 1px; font-variant-numeric: tabular-nums; }
    .sv-neg   .ep-profit, .sv-neg   .ep-rate { color: var(--neg); }
    .sv-warn  .ep-profit, .sv-warn  .ep-rate { color: var(--warn); }
    .sv-pos   .ep-profit, .sv-pos   .ep-rate { color: var(--pos); }
    .sv-mag   .ep-profit, .sv-mag   .ep-rate { color: var(--mag); }
    .sv-slate .ep-profit, .sv-slate .ep-rate { color: var(--faint); }
    .ep-caret { color: var(--faint); font-size: 11px; text-align: center; transition: transform .14s ease; }
    .ep-tape[aria-expanded="true"] .ep-caret { transform: rotate(90deg); }

    /* ── ③ 証拠: 入る / 出る の 2 本 ── */
    .ep-open { background: var(--card-2); border-bottom: 1px solid var(--line);
      border-left: 4px solid var(--line); padding: 16px 20px 18px 24px; }
    .ep-open-title { font-size: 12px; letter-spacing: .1em; color: var(--muted); font-weight: 700; margin-bottom: 12px; }
    .ep-lanes { display: grid; gap: 9px; }
    .ep-lane { display: grid; grid-template-columns: 88px 1fr 104px; align-items: center; gap: 12px; }
    .ep-lane-label { font-size: 12px; color: var(--muted); text-align: right; }
    .ep-lane-track { position: relative; height: 28px; background: var(--bg); border: 1px solid var(--line);
      border-radius: 2px; overflow: hidden; display: flex; }
    .ep-lane-total { font-size: 13.5px; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
    .ep-bar { height: 100%; }
    .ep-bar + .ep-bar { border-left: 1px solid rgba(0,0,0,.3); }
    .ep-bar.in { background: var(--pos); }
    .ep-bar.cost { background: var(--c-cost); } .ep-bar.ship { background: var(--c-ship); }
    .ep-bar.hand { background: var(--c-hand); } .ep-bar.fee { background: var(--c-fee); }
    .ep-bar.fba { background: var(--c-fba); }
    /* 🚨 ラベルは付けない。track は overflow:hidden なので上に出すと切れるし、
       レーンの外に出すと上の行のバーに重なる。凡例で「│ 売価のライン」と説明する */
    .ep-price-line { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--mag); z-index: 3; }
    .ep-legend .ep-swatch.line { width: 3px; height: 12px; border-radius: 0; background: var(--mag); }
    .ep-over { position: absolute; top: 0; bottom: 0; z-index: 2; border-left: 2px solid var(--neg);
      background: repeating-linear-gradient(-45deg, rgba(255,102,112,.34) 0 5px, rgba(255,102,112,.1) 5px 10px);
      pointer-events: none; }
    .ep-legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 11px; font-size: 12px; color: var(--muted); }
    .ep-legend span { display: inline-flex; align-items: center; gap: 5px; }
    .ep-swatch { width: 10px; height: 10px; border-radius: 2px; flex: none; }
    .ep-verdict { margin-top: 12px; font-size: 13px; padding: 10px 14px; border-radius: var(--radius); line-height: 1.6; }
    .ep-verdict.bad { background: var(--neg-bg); color: var(--neg); border: 1px solid var(--neg-edge); }
    .ep-verdict.ok  { background: var(--pos-bg); color: var(--pos); }
    .ep-verdict.mag { color: var(--mag); border: 1px solid var(--mag); }
    .ep-verdict.hold { background: var(--card); color: var(--muted); border: 1px solid var(--line); }
    .ep-verdict b { font-weight: 700; }
    .ep-open-actions { display: flex; gap: 8px; margin-top: 15px; flex-wrap: wrap; }
    .ep-act { background: var(--card); border: 1px solid var(--line); color: var(--ink);
      border-radius: var(--radius); padding: 0 15px; min-height: 40px; font: inherit; font-size: 12.5px; cursor: pointer; }
    .ep-act:hover { border-color: var(--slate); }
    .ep-act:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    .ep-act.mag { border-color: var(--mag); color: var(--mag); }

    /* ── 許容登録ダイアログ ── */
    dialog.ep-dlg { border: 1px solid var(--mag); border-radius: var(--radius); background: var(--card);
      color: var(--ink); padding: 0; max-width: 580px; width: calc(100% - 32px); box-shadow: var(--shadow); font: inherit; }
    dialog.ep-dlg::backdrop { background: rgba(2,5,12,.72); }
    .ep-dlg-head { padding: 16px 22px 12px; border-bottom: 1px solid var(--line); }
    .ep-dlg-eyebrow { font-size: 11px; letter-spacing: .12em; color: var(--mag); font-weight: 700; }
    .ep-dlg-title { font-size: 16px; font-weight: 700; margin: 4px 0 0; }
    .ep-dlg-body { padding: 16px 22px 4px; display: grid; gap: 13px; max-height: 62vh; overflow-y: auto; }
    .ep-dlg-target { background: var(--card-2); border-radius: var(--radius); padding: 10px 14px; font-size: 13px; }
    .ep-dlg-target .t-name { font-weight: 700; }
    .ep-dlg-target .t-meta { color: var(--muted); font-size: 12px; margin-top: 2px; }
    .ep-dlg-target .t-now { color: var(--neg); font-weight: 700; font-size: 15px; margin-top: 6px;
      font-variant-numeric: tabular-nums; }
    .ep-field { display: grid; gap: 5px; }
    .ep-field > label { font-size: 12px; color: var(--muted); font-weight: 700; }
    .ep-field .req { color: var(--neg); }
    .ep-field input, .ep-field select, .ep-field textarea { background: var(--bg); border: 1px solid var(--line);
      border-radius: var(--radius); color: var(--ink); font: inherit; font-size: 13px; padding: 9px 11px;
      width: 100%; box-sizing: border-box; min-height: 40px; }
    .ep-field .hint { font-size: 11px; color: var(--faint); }
    .ep-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .ep-dlg-warn { font-size: 12px; color: var(--warn); background: var(--warn-bg);
      border-radius: var(--radius); padding: 10px 13px; line-height: 1.6; }
    .ep-dlg-err { font-size: 12.5px; color: var(--neg); background: var(--neg-bg);
      border: 1px solid var(--neg-edge); border-radius: var(--radius); padding: 9px 13px; }
    .ep-dlg-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 22px 17px; border-top: 1px solid var(--line); }
    .ep-btn-mag { background: var(--mag); color: var(--bg); border: none; border-radius: var(--radius);
      padding: 0 18px; min-height: 40px; font: inherit; font-weight: 700; font-size: 13px; cursor: pointer; }
    .ep-btn-mag:disabled { opacity: .5; cursor: progress; }

    @media (max-width: 1200px) {
      .ep-piles { grid-template-columns: repeat(2, 1fr); }
      /* 幅が足りないときも「配送」と「手数料」は残す (中原さん指示: 内訳が見えないと信用できない) */
      .ep-tape { grid-template-columns: 4px 108px minmax(0,1fr) 136px 94px 124px 30px; }
      .ep-tape .ep-cell.opt { display: none; }
    }
    @media (max-width: 820px) {
      .ep-ann { grid-template-columns: 6px 1fr; }
      .ep-ann-action { grid-column: 2; border-left: none; border-top: 1px solid var(--line); padding: 14px 20px 16px; }
      .ep-piles { grid-template-columns: 1fr; }
      .ep-field-row { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) { .ep-caret { transition: none; } }
  </style>
  <link rel="stylesheet" href="/mobile.css">
</head>
<body>
  <!-- 🚨 ヘッダはポータル共通の .portal-header を使う。
       2026-09-08 まで .top-nav という style.css に**存在しないクラス**を書いていたため、
       この画面だけヘッダが素のテキストで縦積みになっていた -->
  <header class="portal-header">
    <div class="header-left">
      <a href="/" class="back-link">&larr; Portal</a>
      <h1>商品収益性ダッシュボード</h1>
    </div>
    <div class="header-right">
      <span class="user-name"><%= displayName || username %></span>
      <a href="/logout" class="btn-logout">Logout</a>
    </div>
  </header>

  <div class="container">
    <div class="header-row">
      <div>
        <h2 id="pd-view-title">粗利ワースト商品</h2>
        <div class="page-lead" id="pd-view-lead">直近の販売実績から、粗利の低い商品を洗い出します</div>
      </div>
<% if (!featureFlagEnabled) { %>
      <div style="display:flex;gap:8px;" id="pd-tab-a-actions">
        <button class="btn btn-primary" onclick="loadData()" id="btn-load">データ取得</button>
        <button class="btn btn-export" onclick="exportCSV()" id="btn-export" disabled>CSV出力</button>
      </div>
<% } %>
    </div>

    <div class="notice" id="pd-notice-actual">
      この4つのタブは<b>販売実績ベース</b>の管理指標です (現行原価・現行料率。過去時点の再現値ではありません)。
    </div>

<% if (featureFlagEnabled) { %>
    <!-- ─── 大タブ（feature flag ON 時のみ出力） ─── -->
    <div class="pd-mega-tabs" role="tablist">
      <button class="pd-mega-tab active" data-section="profit" onclick="switchMegaTab('profit')" role="tab">モール別粗利分析</button>
      <button class="pd-mega-tab" data-section="inventory" onclick="switchMegaTab('inventory')" role="tab">在庫整理・撤退判断支援</button>
    </div>

    <!-- ─── タブA: モール別粗利分析（flag ON: tab-panel でラップ） ─── -->
    <div id="pd-tab-a" class="pd-tab-panel active">
      <div class="header-row" style="margin-bottom: 8px;">
        <div></div>
        <div style="display:flex;gap:8px;" id="pd-tab-a-actions">
          <button class="btn btn-primary" onclick="loadData()" id="btn-load">データ取得</button>
          <button class="btn btn-export" onclick="exportCSV()" id="btn-export" disabled>CSV出力</button>
        </div>
      </div>
<% } %>

      <div class="sub-tabs" id="pd-sub-tabs-a">
        <button class="sub-tab active" data-view="worst" onclick="switchProfitView('worst')">ワースト商品</button>
        <button class="sub-tab" data-view="border" onclick="switchProfitView('border')">ボーダー帯</button>
        <button class="sub-tab" data-view="trend" onclick="switchProfitView('trend')">前月比悪化</button>
        <button class="sub-tab" data-view="mall" onclick="switchProfitView('mall')">モール別比較</button>
        <button class="sub-tab" data-view="expected" onclick="switchProfitView('expected')">想定利益 (単品)</button>
      </div>

      <div class="filters" id="pd-filters-actual">
        <label>期間:
          <select id="filter-days" onchange="loadData()">
            <option value="30">直近30日</option>
            <option value="60">直近60日</option>
            <option value="90">直近90日</option>
          </select>
        </label>
        <label>モール:
          <select id="filter-mall" onchange="loadData()">
            <option value="">全モール</option>
            <option value="amazon">Amazon</option>
            <option value="rakuten">楽天</option>
            <option value="yahoo">Yahoo!</option>
            <option value="aupay">au PAY</option>
            <option value="qoo10">Qoo10</option>
            <option value="linegift">LINEギフト</option>
            <option value="mercari">メルカリ</option>
          </select>
        </label>
        <label id="pd-filter-min-revenue-label">最低売上:
          <input type="number" id="filter-min-revenue" value="1000" min="0" step="1000" style="width:90px;" onchange="renderTable()">
        </label>
      </div>

      <div id="fee-status" class="fee-status"></div>
      <div class="summary-cards" id="summary-cards"></div>
      <div id="table-container">
        <div class="empty">「データ取得」を押してください</div>
      </div>

<% if (featureFlagEnabled) { %>
    </div><!-- /pd-tab-a -->

    <!-- ─── タブB: 在庫整理・撤退判断支援（flag ON 時のみ出力） ─── -->
    <div id="pd-tab-b" class="pd-tab-panel">
      <div id="pd-tab-b-error" class="pd-error-banner" style="display:none;"></div>

      <!-- 売上分類セグメント -->
