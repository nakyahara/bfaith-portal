<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <title><%= title %></title>
  <style>
    :root { --line:#e2e8f0; --muted:#64748b; --accent:#2563eb; --bg:#f8fafc; }
    * { box-sizing: border-box; }
    body { font-family: "Hiragino Sans","Meiryo",system-ui,sans-serif; margin:0; color:#0f172a; background:var(--bg); }
    .wrap { max-width: 1100px; margin: 0 auto; padding: 20px 16px 64px; }
    header.hd { padding: 8px 0 14px; border-bottom: 2px solid var(--accent); margin-bottom: 14px; }
    .hd h1 { font-size: 20px; margin: 0 0 4px; }
    .hd .sub { color: var(--muted); font-size: 13px; }
    .toolbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin:14px 0; }
    .seg a { display:inline-block; padding:6px 12px; border:1px solid var(--line); border-radius:6px; text-decoration:none; color:#334155; background:#fff; font-size:13px; }
    .seg a.on { background:var(--accent); color:#fff; border-color:var(--accent); }
    .custom { display:flex; gap:6px; align-items:center; font-size:13px; color:var(--muted); }
    .custom input { padding:5px 8px; border:1px solid var(--line); border-radius:6px; font-size:13px; }
    .custom button, .csv { padding:6px 12px; border:1px solid var(--accent); background:var(--accent); color:#fff; border-radius:6px; font-size:13px; cursor:pointer; text-decoration:none; }
    .csv { background:#fff; color:var(--accent); }
    .period { display:inline-block; background:#eff6ff; color:#1e40af; border:1px solid #bfdbfe; border-radius:6px; padding:4px 10px; font-size:12px; }
    .cards { display:flex; flex-wrap:wrap; gap:12px; margin:8px 0 14px; }
    .card { flex:1 1 160px; background:#fff; border:1px solid var(--line); border-radius:10px; padding:12px 14px; }
    .card .k { color:var(--muted); font-size:12px; } .card .v { font-size:22px; font-weight:700; margin-top:2px; }
    .card .v small { font-size:12px; color:var(--muted); font-weight:400; }
    table { width:100%; border-collapse:collapse; background:#fff; font-size:13px; border:1px solid var(--line); border-radius:10px; overflow:hidden; }
    th, td { padding:9px 10px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
    th { background:#f1f5f9; color:#334155; font-weight:600; font-size:12px; }
    td.l, th.l { text-align:left; white-space:normal; }
    .name { font-weight:600; } .code { color:var(--muted); font-size:11px; }
    .trend-up { color:#16a34a; } .trend-dn { color:#dc2626; } .trend-fl { color:var(--muted); }
    .toggle { cursor:pointer; color:var(--accent); font-size:12px; user-select:none; }
    .sub-row td { background:#fbfcfe; border-bottom:1px dashed var(--line); }
    .sub-tbl { width:100%; border:none; border-radius:0; }
    .sub-tbl th, .sub-tbl td { border-bottom:1px solid #eef2f7; font-size:12px; padding:6px 8px; }
    .badge { display:inline-block; padding:0 6px; border-radius:8px; font-size:10px; }
    .b-fba { background:#dcfce7; color:#166534; } .b-fbm { background:#fef3c7; color:#92400e; }
    .b-mall { background:#eef2ff; color:#3730a3; }
    .tabs { display:flex; gap:6px; margin:16px 0 8px; border-bottom:2px solid var(--line); }
    .tabbtn { border:none; background:none; padding:9px 18px; font-size:14px; font-weight:700; color:var(--muted); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; }
    .tabbtn.on { color:var(--accent); border-bottom-color:var(--accent); }
    .tabpanel { display:none; }
    .note { color:var(--muted); font-size:11px; margin-top:18px; line-height:1.8; background:#fff; border:1px solid var(--line); border-radius:10px; padding:12px 14px; }
    .empty { background:#fff; border:1px solid var(--line); border-radius:10px; padding:40px; text-align:center; color:var(--muted); }
    .scroll { overflow-x:auto; }
    @media (max-width:640px){ .hd h1{font-size:17px;} .card .v{font-size:18px;} }
  </style>
</head>
<body>
<div class="wrap">
  <header class="hd">
    <h1><%= supplierName %> 様 販売実績</h1>
    <div class="sub">B-Faith / 全モール（Amazon・楽天 ほか）合算・実出荷ピース数ベース</div>
  </header>

  <% function qstr(p){ const t='&tab=kakutei'; return p==='custom' ? `?period=custom&start=${encodeURIComponent(query.start)}&end=${encodeURIComponent(query.end)}${t}` : `?period=${p}${t}`; } %>
  <% if (!period) { %>
    <div class="empty" style="margin-top:14px;">対象商品の販売実績データがまだありません。</div>
  <% } else {
       const yen = n => '¥' + Math.round(n||0).toLocaleString('ja-JP');
       const num = n => (Math.round((n||0)*10)/10).toLocaleString('ja-JP');
       const trend = (cur, prev) => {
         if (prev === 0 && cur === 0) return { cls:'trend-fl', mark:'—' };
         if (prev === 0) return { cls:'trend-up', mark:'▲ new' };
         const r = (cur - prev) / prev;
         if (r > 0.05) return { cls:'trend-up', mark:'▲ ' + Math.round(r*100) + '%' };
         if (r < -0.05) return { cls:'trend-dn', mark:'▼ ' + Math.round(Math.abs(r)*100) + '%' };
         return { cls:'trend-fl', mark:'→' };
       };
       const hasSokuho = !!(sokuho && sokuho.asOf);
       const sokuhoProducts = products.filter(p => p.sokuho7 || p.sokuho30);
       const kakuteiProducts = [...products].filter(p => p.pieces || p.sales).sort((a,b)=> b.sales-a.sales || b.pieces-a.pieces);
  %>
    <div class="tabs">
      <button type="button" class="tabbtn" data-tab="sokuho">🟢 速報（注文ベース・直近）</button>
      <button type="button" class="tabbtn" data-tab="kakutei">確定（精算ベース）</button>
    </div>

    <!-- ===== 速報タブ ===== -->
    <section class="tabpanel" data-panel="sokuho">
      <div class="period">速報（注文ベース）: <%= hasSokuho ? sokuho.asOf + ' 朝時点' : '準備中' %>　／　全モール合算（Amazon FBA ＋ 楽天・Yahoo! など FBA以外）</div>
      <div class="cards">
        <div class="card"><div class="k">対象商品数</div><div class="v"><%= sokuhoProducts.length.toLocaleString('ja-JP') %><small> 点</small></div></div>
        <div class="card"><div class="k">直近7日 販売数</div><div class="v"><%= num(totals.sokuho7) %><small> 個</small></div></div>
        <div class="card"><div class="k">直近30日 販売数</div><div class="v"><%= num(totals.sokuho30) %><small> 個</small></div></div>
      </div>
      <% if (!sokuhoProducts.length) { %>
        <div class="empty">速報データがまだありません。</div>
      <% } else { %>
      <div class="scroll">
      <table>
        <thead><tr><th class="l">商品</th><th>速報<br>7日</th><th>速報<br>30日</th><th>内Amazon<br>FBA(30日)</th><th>現在庫</th><th>在庫<br>日数</th></tr></thead>
        <tbody>
          <% sokuhoProducts.forEach(p => { %>
            <tr>
              <td class="l"><div class="name"><%= p.product_name || '(商品名なし)' %></div><div class="code"><%= p.ne_code %></div></td>
              <td><strong><%= num(p.sokuho7) %></strong></td>
              <td><strong><%= num(p.sokuho30) %></strong></td>
              <td><%= num(p.sokuho30Fba) %></td>
              <td><%= p.stock == null ? '—' : num(p.stock) %></td>
              <td><%= p.stockDays == null ? '—' : num(p.stockDays) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
      <div class="note">
        <b>速報（注文ベース）</b>とは … 注文が入った日でカウントした直近の販売数です（ほぼ前日まで反映・Amazon FBA含む・返品/キャンセル後の精算は未反映の暫定値）。<br>
        対象は<b>全モール</b>です。<b>楽天・Yahoo!・Amazon FBM など「FBA以外」はまとめて</b>この数字に含まれます（うち Amazon FBA 分だけ「内Amazon FBA」で分離表示）。モール別・出品別に分けて見るには「確定」タブの<b>出品内訳</b>をご覧ください。<br>
        ・<b>在庫日数</b> … 現在庫 ÷ 直近の販売ペースの目安日数です。
      </div>
    </section>

    <!-- ===== 確定タブ ===== -->
    <section class="tabpanel" data-panel="kakutei">
      <div class="toolbar">
        <div class="seg">
          <a href="<%= qstr('7d') %>"  class="<%= query.period==='7d'?'on':'' %>">7日</a>
          <a href="<%= qstr('30d') %>" class="<%= (query.period==='30d'||!query.period)?'on':'' %>">30日</a>
          <a href="<%= qstr('90d') %>" class="<%= query.period==='90d'?'on':'' %>">90日</a>
        </div>
        <form class="custom" method="get">
          <input type="hidden" name="period" value="custom">
          <input type="hidden" name="tab" value="kakutei">
          <input type="date" name="start" value="<%= query.start %>"><span>〜</span><input type="date" name="end" value="<%= query.end %>">
          <button type="submit">表示</button>
        </form>
        <a class="csv" href="<%= '/share/supplier/' + token + '/csv' + qstr(query.period||'30d') %>">CSVダウンロード</a>
      </div>
      <div class="period">確定（精算ベース）: <%= period.start %> 〜 <%= period.end %>（<%= period.label %>・<%= period.cutoff %>まで確定分）</div>
      <div class="cards">
        <div class="card"><div class="k">対象商品数</div><div class="v"><%= kakuteiProducts.length.toLocaleString('ja-JP') %><small> 点</small></div></div>
        <div class="card"><div class="k">販売ピース数</div><div class="v"><%= num(totals.pieces) %><small> 個</small></div></div>
        <div class="card"><div class="k">売上(税込)</div><div class="v"><%= yen(totals.sales) %></div></div>
        <div class="card"><div class="k">前同期間比(個数)</div><div class="v"><% const tt=trend(totals.pieces, totals.prevPieces); %><span class="<%= tt.cls %>"><%= tt.mark %></span></div></div>
      </div>
      <% if (!kakuteiProducts.length) { %>
        <div class="empty">この期間に確定済みの販売実績がありません（速報タブをご覧ください）。</div>
      <% } else { %>
      <div class="scroll">
      <table>
        <thead><tr><th class="l">商品</th><th>ピース数</th><th>傾向</th><th>日平均</th><th>売上(税込)</th><th>最終販売日</th><th class="l">出品内訳</th></tr></thead>
        <tbody>
          <% kakuteiProducts.forEach((p, idx) => { const t = trend(p.pieces, p.prevPieces); %>
            <tr>
              <td class="l"><div class="name"><%= p.product_name || '(商品名なし)' %></div><div class="code"><%= p.ne_code %></div></td>
              <td><%= num(p.pieces) %></td>
              <td class="<%= t.cls %>"><%= t.mark %></td>
              <td><%= num(p.avgPerDay) %></td>
              <td><%= yen(p.sales) %></td>
              <td><%= p.lastSold || '—' %></td>
              <td class="l"><% if (p.listings.length) { %><span class="toggle" data-tgt="lst-<%= idx %>">出品内訳 (<%= p.listings.length %>) ▼</span><% } else { %><span class="code">—</span><% } %></td>
            </tr>
            <tr class="sub-row" id="lst-<%= idx %>" style="display:none;">
              <td colspan="7" class="l">
                <table class="sub-tbl">
                  <thead><tr><th class="l">モール</th><th class="l">出品ページ</th><th>販売件数</th><th>ピース数</th><th>売上(税込)</th></tr></thead>
                  <tbody>
                    <% p.listings.forEach(L => { %>
                      <tr>
                        <td class="l"><span class="badge b-mall"><%= mallLabels[L.mall] || L.mall %></span><% if (L.mall==='amazon') { %> <span class="badge <%= L.is_fba?'b-fba':'b-fbm' %>"><%= L.is_fba?'FBA':'FBM' %></span><% } %></td>
                        <td class="l"><%= L.listingName || '(名称なし)' %><br><span class="code"><%= L.listingId %><%= L.asin?(' / '+L.asin):'' %></span></td>
                        <td><%= num(L.sold) %></td><td><%= num(L.pieces) %></td><td><%= yen(L.sales) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
      <div class="note">
        <b>確定（精算ベース）</b>とは … 各モールの精算が確定した後の数字で、返品・キャンセルを差し引いた実績です。精算の都合で直近〜2週間ほどは遅れて反映されるため、速報より対象期間が手前（<%= period.cutoff %>まで）になります。<br>
        ・<b>ピース数</b> … 実際に出荷した個数。3個セットが1件売れたら「3個」（全モール共通）。<br>
        ・<b>売上(税込)</b> … 出品が実際に売れた金額の合計（手数料・送料は含まず／複数商品セットは標準売価比で按分）。<br>
        ・<b>出品内訳</b> … 楽天の3個セットページ、Amazon の FBA / FBM 別など、どの出品で売れたかを確認できます。
      </div>
    </section>

    <div class="note" style="margin-top:14px;">
      ・速報（注文日ベース）と確定（精算ベース）は集計の基準が違うため、数字は一致しません。「今売れているか」は速報、「確定した実績」は確定をご覧ください。<br>
      ・本ページは B-Faith が共有用に発行した専用リンクです。第三者への転送はお控えください。
    </div>
  <% } %>
</div>
<script>
  // タブ切り替え（初期タブ = 確定を直前に操作していたら確定、それ以外は速報）
  (function(){
    var initial = <%- JSON.stringify(query && query.tab === 'kakutei' ? 'kakutei' : 'sokuho') %>;
    function activate(name){
      document.querySelectorAll('.tabbtn').forEach(function(b){ b.classList.toggle('on', b.dataset.tab===name); });
      document.querySelectorAll('.tabpanel').forEach(function(p){ p.style.display = (p.dataset.panel===name) ? 'block' : 'none'; });
    }
    document.querySelectorAll('.tabbtn').forEach(function(b){ b.addEventListener('click', function(){ activate(b.dataset.tab); }); });
    activate(initial);
  })();
  // 出品内訳の開閉
  document.querySelectorAll('.toggle').forEach(function(el){
    el.addEventListener('click', function(){
      var row = document.getElementById(el.dataset.tgt);
      if(!row) return;
      var open = row.style.display !== 'none';
      row.style.display = open ? 'none' : 'table-row';
      el.textContent = el.textContent.replace(open?'▲':'▼', open?'▼':'▲');
    });
  });
</script>
</body>
</html>
