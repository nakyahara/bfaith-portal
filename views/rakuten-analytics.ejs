let actFilter = 'open,acked';
async function loadActions() {
  document.getElementById('act-filter').addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    document.querySelectorAll('#act-filter button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    actFilter = btn.dataset.f;
    fetchActions(false);
  });
  document.getElementById('act-rerun').addEventListener('click', async () => {
    document.getElementById('act-runinfo').textContent = '診断を実行中…';
    try { await postJSON(API + '/actions/run'); } catch (e) { alert('再実行失敗: ' + e.message); }
    fetchActions(false);
  });
  fetchActions(true);
}
async function fetchActions(ensureRun) {
  try {
    const data = await getJSON(`${API}/actions?status=${encodeURIComponent(actFilter)}&ensure_run=${ensureRun ? '1' : '0'}`);
    const run = data.latest_run;
    document.getElementById('act-runinfo').textContent = run
      ? `最終診断: ${new Date(run.finished_at || run.started_at).toLocaleString('ja-JP')} (${run.status}) / ルール ${data.rule_set_version}`
      : '診断未実行';
    document.getElementById('act-runerror').innerHTML = data.run_error ? `<div class="err-note">${esc(data.run_error)}</div>` : '';
    updateActionBadge(data.action_counts);
    const items = data.items || [];
    if (items.length === 0) {
      document.getElementById('act-list').innerHTML = '<div class="note" style="padding:20px; text-align:center;">該当するアクションはありません 🎉</div>';
      return;
    }
    const sevPill = { critical: '<span class="pill err">要対応</span>', warning: '<span class="pill warn">注意</span>', info: '<span class="pill info">情報</span>' };
    const stPill = { open: '', acked: '<span class="pill info">対応中</span>', done: '<span class="pill ok">完了</span>', dismissed: '<span class="pill todo">却下</span>', expired: '<span class="pill todo">期限切れ</span>', resolved: '<span class="pill ok">解消 (自動)</span>' };
    document.getElementById('act-list').innerHTML = items.map(a => `
      <div class="action-card ${a.severity}">
        <div class="a-title">${sevPill[a.severity] || ''} ${stPill[a.status] || ''} ${esc(a.title)}</div>
        <div class="a-sub">${esc(a.entity_type)}: <b>${esc(a.entity_id)}</b> ${esc(a.entity_label || '')}
          / 初検知 ${esc((a.first_seen_at || '').slice(0, 10))} / 検知 ${a.occurrence_count}回 / ソース: ${a.source === 'rule' ? 'ルール' : a.source === 'ai' ? '🤖AI' : '人'}</div>
        <div class="a-suggest">💡 ${esc(a.suggested_action || '(提案なし)')}</div>
        <div class="a-btns">
          ${a.status === 'open' ? `<button class="btn sm ghost" data-act="ack" data-id="${a.id}">対応中にする</button>` : ''}
          ${(a.status === 'open' || a.status === 'acked') ? `
            <button class="btn sm" data-act="done" data-id="${a.id}">✓ 実施した</button>
            <button class="btn sm secondary" data-act="dismiss" data-id="${a.id}">却下</button>` : ''}
          ${(a.status === 'dismissed' || a.status === 'done' || a.status === 'resolved') ? `<button class="btn sm ghost" data-act="reopen" data-id="${a.id}">再オープン</button>` : ''}
          <button class="btn sm ghost" data-act="detail" data-id="${a.id}">詳細・履歴</button>
        </div>
      </div>`).join('');
  } catch (e) {
    document.getElementById('act-list').innerHTML = `<div class="err-note">取得失敗: ${esc(e.message)}</div>`;
  }
}
function updateActionBadge(counts) {
  const n = (counts?.open || 0);
  const el = document.getElementById('action-count');
  el.style.display = n > 0 ? '' : 'none';
  el.textContent = n;
}
async function refreshActionBadge() {
  try {
    const data = await getJSON(`${API}/actions?status=open&limit=1&ensure_run=0`);
    updateActionBadge(data.action_counts);
  } catch { /* バッジは飾り */ }
}

document.addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act]'); if (!btn) return;
  const id = btn.dataset.id, act = btn.dataset.act;
  try {
    if (act === 'detail') return showActionDetail(id);
    if (act === 'ack') await postJSON(`${API}/actions/${id}/act`, { event: 'ack' });
    if (act === 'reopen') await postJSON(`${API}/actions/${id}/act`, { event: 'reopen' });
    if (act === 'done') {
      const note = prompt('何を実施しましたか? (効果測定の記録に残ります)\n例: RPPの商品CPCを20円→15円に変更');
      if (note === null) return;
      await postJSON(`${API}/actions/${id}/act`, { event: 'done', note });
    }
    if (act === 'dismiss') {
      const reason = prompt('却下理由 (AIの学習材料になります)\n例: 意図的な広告投資 (新商品育成中)');
      if (reason === null) return;
      const scope = confirm('この案件を今後も表示しない場合は OK (恒久却下)。\nキャンセル = 7日間だけ非表示') ? 'permanent' : 'occurrence';
      await postJSON(`${API}/actions/${id}/act`, { event: 'dismiss', note: reason, dismiss_scope: scope });
    }
    fetchActions(false);
  } catch (err) { alert('操作失敗: ' + err.message); }
});

