          <tr><td>アクセス</td><td class="num">${ef.before.access.toLocaleString()}</td><td class="num">${ef.after.access.toLocaleString()}</td><td class="num ${signClass(ef.access_change_pct)}">${fmtPct(ef.access_change_pct)}</td></tr>
          <tr><td>転換率</td><td class="num">${fmtPct(ef.before.cvr_pct)}</td><td class="num">${fmtPct(ef.after.cvr_pct)}</td><td class="num ${signClass(ef.cvr_change_pct)}">${fmtPct(ef.cvr_change_pct)}</td></tr>
        </tbody></table>
        <div class="note">信頼度: ${esc(ef.confidence)}。前期間イベント: ${esc(ef.before.events.join(', ') || 'なし')} / 後期間イベント: ${esc(ef.after.events.join(', ') || 'なし')}</div>`;
    }
    document.getElementById('act-dialog-body').innerHTML = `
      <div class="a-sub">${esc(d.entity_type)}: <b>${esc(d.entity_id)}</b> ${esc(d.entity_label || '')} / 状態: ${esc(d.status)} / 検知 ${d.occurrence_count}回</div>
