      <table class="data"><thead><tr><th>日時</th><th>イベント</th><th>操作者</th><th>メモ</th></tr></thead><tbody>${events}</tbody></table>`;
  } catch (e) {
    document.getElementById('act-dialog-body').innerHTML = `<div class="err-note">${esc(e.message)}</div>`;
  }
}

