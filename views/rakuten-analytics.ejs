// ============================================================
let eqWindow = 7;
async function loadEquation() {
  document.getElementById('eq-window').addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    document.querySelectorAll('#eq-window button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    eqWindow = Number(btn.dataset.w);
    fetchEquation();
  });
  fetchEquation();
  fetchMovers();
}
function renderEqWaterfall(canvasId, eq) {
  const f = eq.factors;
  const steps = [
    { label: `前期間 売上`, v: eq.previous.sales, kind: 'total' },
    { label: `アクセス (${eq.previous.access.toLocaleString()}→${eq.current.access.toLocaleString()})`, v: f.access, kind: 'delta' },
    { label: `転換率 (${eq.previous.cvr_pct}%→${eq.current.cvr_pct}%)`, v: f.cvr, kind: 'delta' },
    { label: `客単価 (¥${eq.previous.aov.toLocaleString()}→¥${eq.current.aov.toLocaleString()})`, v: f.aov, kind: 'delta' },
    ...(Math.abs(f.residual) > 0 ? [{ label: 'その他・データ差異', v: f.residual, kind: 'delta' }] : []),
    { label: `今期間 売上`, v: eq.current.sales, kind: 'total' },
  ];
  let cum = 0;
  const bars = [], colors = [];
  for (const s of steps) {
    if (s.kind === 'total') { bars.push([0, s.v]); cum = s.v; colors.push('#9ca3af'); }
    else { bars.push([cum, cum + s.v]); cum += s.v; colors.push(s.v >= 0 ? '#047857' : '#dc2626'); }
  }
  mkChart(canvasId, {
    type: 'bar',
    data: { labels: steps.map(s => s.label), datasets: [{ data: bars, backgroundColor: colors, borderSkipped: false }] },
    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: {
        label: (c) => { const s = steps[c.dataIndex]; return `${s.kind === 'total' ? '' : (s.v >= 0 ? '+' : '')}${fmtJPY(s.v)}`; } } } },
      scales: { x: { ticks: { callback: v => fmtJPY(v) } } } },
  });
}
async function fetchEquation() {
  try {
    const eq = await getJSON(`${API}/equation?level=store&window=${eqWindow}`);
    if (!eq.available) {
      document.getElementById('eq-note').innerHTML = '<div class="warn-note">店舗日次データがまだmirrorに届いていません。</div>';
      return;
    }
    document.getElementById('eq-title').textContent = `${eq.current.from}〜${eq.current.to} vs ${eq.previous.from}〜${eq.previous.to}`;
    document.getElementById('eq-note').innerHTML = `<div class="${eq.confounded ? 'warn-note' : 'note'}">${esc(eq.note)}。
      今期間イベント: ${esc(eq.current.events.join(', ') || 'なし')} / 前期間: ${esc(eq.previous.events.join(', ') || 'なし')}</div>`;
    renderEqWaterfall('chart-eq', eq);
  } catch (e) { document.getElementById('eq-note').innerHTML = `<div class="err-note">${esc(e.message)}</div>`; }
}
async function fetchMovers() {
  try {
    const data = await getJSON(`${API}/equation/movers`);
    if (!data.available) return;
    const fLabel = { access: 'アクセス', cvr: '転換率', aov: '客単価', residual: 'その他' };
    const fClass = { access: 'factor-access', cvr: 'factor-cvr', aov: 'factor-aov' };
    const row = (r) => `<tr>
      <td><a href="#" class="eq-sku-link" data-sku="${esc(r.sku)}" data-name="${esc(r.name)}">${esc(r.sku)}</a></td>
      <td class="name-cell">${esc(r.name)}</td>
      <td class="num">${fmtYen(r.sales_prev)}</td>
      <td class="num">${fmtYen(r.sales_cur)}</td>
      <td class="num ${signClass(r.delta)}"><b>${r.delta >= 0 ? '+' : ''}${fmtJPY(r.delta)}</b></td>
      <td>${r.main_factor ? `<span class="factor-pill ${fClass[r.main_factor] || ''}">${fLabel[r.main_factor] || r.main_factor}</span>` : '−'}</td>
      <td class="num">${r.factors.access >= 0 ? '+' : ''}${fmtJPY(r.factors.access)}</td>
      <td class="num">${r.factors.cvr >= 0 ? '+' : ''}${fmtJPY(r.factors.cvr)}</td>
      <td class="num">${r.factors.aov >= 0 ? '+' : ''}${fmtJPY(r.factors.aov)}</td>
    </tr>`;
    const head = `<thead><tr><th>SKU</th><th>商品名</th><th>前7日</th><th>直近7日</th><th>変化</th><th>主因</th><th>アクセス因子</th><th>転換率因子</th><th>客単価因子</th></tr></thead>`;
    document.getElementById('eq-fallers').innerHTML = head + '<tbody>' + data.fallers.filter(r => r.delta < 0).map(row).join('') + '</tbody>';
    document.getElementById('eq-risers').innerHTML = head + '<tbody>' + data.risers.filter(r => r.delta > 0).map(row).join('') + '</tbody>';
  } catch (e) { console.error(e); }
}
document.addEventListener('click', async (e) => {
  const a = e.target.closest('a.eq-sku-link'); if (!a) return;
  e.preventDefault();
  try {
    const eq = await getJSON(`${API}/equation?level=sku&sku=${encodeURIComponent(a.dataset.sku)}&window=${eqWindow}`);
    if (!eq.available) return;
    document.getElementById('eq-sku-title').textContent = `${a.dataset.sku} ${a.dataset.name || ''}`;
    renderEqWaterfall('chart-eq-sku', eq);
  } catch (err) { console.error(err); }
});

// ============================================================
// 📡 データ鮮度
// ============================================================
async function loadFreshness() {
  try {
    const data = await getJSON(API + '/freshness');
    document.getElementById('fresh-table').innerHTML = `<thead><tr>
      <th>データ</th><th>状態</th><th>最新</th><th>行数</th><th>取得経路</th>
    </tr></thead><tbody>` + data.datasets.map(d => `<tr>
      <td>${esc(d.label)}</td>
      <td>${d.stale ? '<span class="pill err">停滞</span>' : '<span class="pill ok">正常</span>'}</td>
      <td>${esc(d.latest || '−')}${d.lag_days !== null && d.lag_days > 0 ? ` <span class="note">(${d.lag_days}日前)</span>` : ''}</td>
      <td class="num">${(d.rows || 0).toLocaleString()}</td>
      <td class="note">${esc(d.source)}</td>
    </tr>`).join('') + '</tbody>';
  } catch (e) {
    document.getElementById('fresh-table').innerHTML = `<tbody><tr><td class="err-note">${esc(e.message)}</td></tr></tbody>`;
  }
}

// ============================================================
// ⚙️ 設定 (診断閾値)
// ============================================================
const TH_LABELS = {
  freshness_lag_days: 'データ停滞とみなす日数',
  ad_min_spend_yen: '広告判定の最低月広告費 (円)',
  ad_expand_roas_ratio: '増額候補: 損益分岐×N 以上',
  cvr_min_access_7d: 'CVR急落判定の最低アクセス (7日)',
  cvr_drop_warn_ratio: 'CVR急落 警告閾値 (基準比)',
  cvr_drop_crit_ratio: 'CVR急落 重大閾値 (基準比)',
  stock_days_threshold: '在庫警告の残日数',
  dismiss_occurrence_days: '却下(今回のみ)の非表示日数',
};
async function loadSettings() {
  try {
    const s = await getJSON(API + '/settings');
    document.getElementById('th-form').innerHTML = Object.entries(TH_LABELS).map(([k, label]) =>
      `<div><label>${label}</label><input type="text" data-th="${k}" value="${s[k]}"></div>`).join('');
    document.getElementById('th-save').onclick = async () => {
      const patch = {};
      document.querySelectorAll('[data-th]').forEach(el => { patch[el.dataset.th] = el.value; });
      const st = document.getElementById('th-status');
      try {
        const res = await fetch(API + '/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(patch) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
        if (data.rejected && data.rejected.length) {
          st.textContent = `⚠️ 一部保存されませんでした: ${data.rejected.join(' / ')}`;
        } else {
          st.textContent = '保存しました ✓ (次回の診断実行から反映)';
          setTimeout(() => st.textContent = '', 4000);
        }
        // 保存後の実値を再表示 (拒否された項目は元の値に戻る)
        const cur = await getJSON(API + '/settings');
        document.querySelectorAll('[data-th]').forEach(el => { if (el.dataset.th in cur) el.value = cur[el.dataset.th]; });
      } catch (e) {
        st.textContent = '保存失敗: ' + e.message;
      }
    };
  } catch (e) { console.error(e); }
}

// 初期ロード
loadTab('overview');
</script>
