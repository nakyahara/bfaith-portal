<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>楽天分析ツール - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
          integrity="sha384-9nhczxUqK87bcKHh20fSQcTGD4qq5GhayNYSYWqwBkINBhOfQLg/P5HG5lF1urn4"
          crossorigin="anonymous"></script>
  <style>
    body { background: #f5f7fa; }
    .container { max-width: 1500px; margin: 0 auto; padding: 16px 20px; }
    .header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 12px; }
    .header-row h2 { margin: 0; }
    .back-link { font-size: 13px; color: #bf0000; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .meta-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 14px; margin-bottom: 12px; font-size: 12px; color: #555; display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

    /* 精度バッジ (要件 §9-2: 速報/推定/確定を常時区別。税はすべて税込) */
    .pbadge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; vertical-align: middle; }
    .pbadge.flash { background: #dbeafe; color: #1e40af; }
    .pbadge.est { background: #fef3c7; color: #92400e; }
    .pbadge.settled { background: #d1fae5; color: #065f46; }

    /* タブ (楽天クリムゾン) */
    .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
    .tab-btn { background: #fff; border: 1px solid #e5e7eb; border-bottom: none; border-radius: 6px 6px 0 0; padding: 10px 16px; cursor: pointer; font-size: 13px; color: #555; }
    .tab-btn.active { background: #bf0000; color: white; border-color: #bf0000; }
    .tab-content { background: white; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 8px; padding: 16px; min-height: 400px; }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* 期間切替 */
    .period-switcher { display: inline-flex; gap: 4px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; flex-wrap: wrap; }
    .period-switcher button { background: transparent; border: none; padding: 6px 10px; font-size: 12px; cursor: pointer; border-radius: 4px; color: #555; }
    .period-switcher button.active { background: #bf0000; color: white; }
    .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }

    /* タイル */
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .tile { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .tile h3 { margin: 0 0 8px; font-size: 14px; color: #374151; }
    .tile .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #4b5563; }
    .tile .row .v { font-variant-numeric: tabular-nums; font-weight: 600; color: #111; }
    .tile .row.hero { border-top: 1px dashed #e5e7eb; margin-top: 6px; padding-top: 8px; }
    .tile .row.hero .v { font-size: 20px; font-weight: 700; }
    .pos { color: #047857 !important; } .negv { color: #dc2626 !important; }

    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .chart-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; }
    .chart-card h3 { margin: 0 0 8px; font-size: 13px; color: #374151; font-weight: 600; }
    .chart-wrap { position: relative; height: 300px; }
    .chart-wrap.tall { height: 420px; }
    @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }

    .note { font-size: 11.5px; color: #6b7280; margin: 6px 0; }
    .warn-note { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 8px 12px; font-size: 12px; color: #92400e; border-radius: 4px; margin-bottom: 12px; }
    .ok-note { background: #ecfdf5; border-left: 4px solid #10b981; padding: 8px 12px; font-size: 12px; color: #065f46; border-radius: 4px; margin-bottom: 8px; }
    .err-note { background: #fef2f2; border-left: 4px solid #dc2626; padding: 8px 12px; font-size: 12px; color: #991b1b; border-radius: 4px; margin-bottom: 8px; }
    .loading { color: #6b7280; font-size: 13px; padding: 30px; text-align: center; }
    .section-h { font-size: 14px; font-weight: 700; color: #1f2937; margin: 18px 0 8px; }
    table.data { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    table.data th, table.data td { border: 1px solid #e5e7eb; padding: 5px 8px; }
    table.data th { background: #f9fafb; font-weight: 600; color: #374151; text-align: left; white-space: nowrap; }
    table.data td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .table-scroll { overflow-x: auto; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .pill.ok { background: #d1fae5; color: #065f46; }
    .pill.err { background: #fee2e2; color: #991b1b; }
    .pill.todo { background: #f3f4f6; color: #6b7280; }
    .pill.warn { background: #fef3c7; color: #92400e; }
    #drop-zone.dragover { border-color: #bf0000; background: #fef2f2; color: #bf0000; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-row">
      <h2>📊 楽天分析ツール</h2>
      <div style="display:flex; gap:14px; align-items:center;">
        <span style="font-size:12px; color:#6b7280;"><%= displayName || username || '' %></span>
        <a class="back-link" href="/">← ポータルへ戻る</a>
      </div>
    </div>
    <div class="meta-bar">
      <span>精度: <span class="pbadge flash">速報</span>=受注ベース(毎朝更新) <span class="pbadge est">推定</span>=手数料10%一律 <span class="pbadge settled">確定</span>=月次仕訳書実額 / 金額はすべて<b>税込</b></span>
      <span id="meta-updated"></span>
    </div>

    <div class="tabs" id="tabs">
      <button class="tab-btn active" data-tab="overview">🏠 概要</button>
      <button class="tab-btn" data-tab="bestsellers">🏆 売れ筋</button>
      <button class="tab-btn" data-tab="profit">💰 利益分析</button>
      <button class="tab-btn" data-tab="ads">📣 広告</button>
      <button class="tab-btn" data-tab="ranking">🔍 検索順位</button>
      <button class="tab-btn" data-tab="diagnosis">🩺 診断</button>
      <button class="tab-btn" data-tab="import">📥 取込</button>
      <button class="tab-btn" data-tab="settings">⚙️ 設定</button>
    </div>

    <div class="tab-content">
      <!-- 🏠 概要 -->
      <div class="tab-pane active" id="pane-overview">
        <div id="ov-tiles" class="tile-grid"><div class="loading">読み込み中…</div></div>
        <div class="toolbar">
          <div class="period-switcher" id="ov-period"></div>
          <span class="note" id="ov-freshness"></span>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>売上 × 粗利 × 粗利率 <span class="pbadge flash">速報</span> <span class="note">粗利 = 変動利益 (売上−クーポン−返金−手数料<span class="pbadge est">推定</span>−送料−原価)</span></h3>
            <div class="chart-wrap tall"><canvas id="chart-trend"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>販売数 × キャンセル率 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap"><canvas id="chart-units"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>クーポン店舗負担 × 返金の推移 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap"><canvas id="chart-deductions"></canvas></div>
          </div>
        </div>
      </div>

      <!-- 🏆 売れ筋 (P5) -->
      <div class="tab-pane" id="pane-bestsellers">
        <div class="warn-note">準備中 (P5)。実装予定: 売れ筋ランキング (数量/売上/実質利益の3軸) / 急上昇・急落 / ABC分析 / 楽天genre別 / 曜日パターン+イベント期間フラグ。</div>
      </div>

      <!-- 💰 利益分析 (P4) -->
      <div class="tab-pane" id="pane-profit">
        <div class="warn-note">準備中 (P4)。実装予定: 楽天版利益ウォーターフォール (クーポン→返金→手数料→送料→原価→広告費→料率推定コスト) / SKU別実質利益テーブル (損益分岐ROAS付き) / 料率マスタ。</div>
      </div>

      <!-- 📣 広告 (P3) -->
      <div class="tab-pane" id="pane-ads">
        <div class="warn-note">準備中 (P3)。実装予定: RPP商品別・キーワード別の広告効率 / 損益分岐ROAS判定 (🟢余裕/🟡限界/🔴広告赤字) / 広告費率×売上の4象限 / クーポンアドバンス。<br>データは 📥取込タブ (P2) からのRPPレポートCSVアップロードで入ります。</div>
      </div>

      <!-- 🔍 検索順位 (P6) -->
      <div class="tab-pane" id="pane-ranking">
        <div class="warn-note">準備中 (P6)。実装予定: 順位×売上×広告の重ね合わせグラフ / 施策注釈 / 順位急落リスト / 1ページ目占有率。データは既存順位チェッカー (mirror_rank_history 同期) から。<br>それまでは <a href="/apps/ranking-checker" target="_blank">既存の順位チェッカー</a> をご利用ください。</div>
      </div>

      <!-- 🩺 診断 (P7) -->
      <div class="tab-pane" id="pane-diagnosis">
        <div class="warn-note">準備中 (P7)。実装予定: 稼ぎ頭 / 広告赤字 (損益分岐ROAS割れ30日) / 広告伸ばし先 / CVR低下 / 順位急落 / 死に筋 / 価格ミス疑い の自動判定リスト。</div>
      </div>

      <!-- 📥 取込 (P2) -->
      <div class="tab-pane" id="pane-import">
        <div class="note" style="margin-bottom:10px;">
          <b>RMS → 広告(プロモーションメニュー) → 検索連動型広告(RPP) → パフォーマンスレポート</b> から2種類をDLしてドロップ (zipのままでOK・複数可):<br>
          ① <b>商品別 (月次)</b>: 集計期間 <b>「月ごとに表示」</b> + 期間3ヶ月以内 + 表示/出力項目 <b>「全てを選択」</b> → 「全商品レポートダウンロード」<br>
          ② <b>日次広告費</b>: 集計単位 <b>「すべての広告」</b> + <b>「日ごとに集計」</b> + 期間3ヶ月以内 → 「この条件でダウンロード」<br>
          ※商品別レポートは楽天の仕様で月次のみ (日別は選べません)。過去分は3ヶ月ずつ遡って全期間分。
          売上・CVは30日間さかのぼって加算されるため、<b>直近分は次回まとめて再アップロードすれば上書き更新</b>されます。
        </div>
        <div id="drop-zone" style="border:2px dashed #d1d5db; border-radius:10px; padding:36px; text-align:center; color:#6b7280; cursor:pointer; margin-bottom:14px;">
          📥 ここにファイルをドロップ / クリックして選択 (CSV, zip)
          <input type="file" id="file-input" multiple accept=".csv,.zip" style="display:none;">
        </div>
        <div id="import-result"></div>
        <div class="section-h">データ鮮度ボード</div>
        <div class="table-scroll"><table class="data" id="freshness-table"><tbody><tr><td class="loading">読み込み中…</td></tr></tbody></table></div>
        <div class="section-h">取込履歴 (最近50件)</div>
        <div class="table-scroll"><table class="data" id="import-log-table"></table></div>
      </div>

      <!-- ⚙️ 設定 (P7) -->
      <div class="tab-pane" id="pane-settings">
        <div class="warn-note">準備中 (P7)。実装予定: 料率マスタ (システム利用料/決済/ポイント/アフィリエイト — 確定月から実効料率を自動逆算) / イベントカレンダー (マラソン/スーパーセール) / 診断閾値 / GChat通知。</div>
      </div>
    </div>
  </div>

<script>
// ============================================================
// 共通 util
// ============================================================
const API = '/apps/rakuten-analytics/api/v1';
const charts = {};
function destroyChart(id) { if (charts[id]) { charts[id].destroy(); delete charts[id]; } }
function mkChart(id, cfg) { destroyChart(id); charts[id] = new Chart(document.getElementById(id).getContext('2d'), cfg); return charts[id]; }

// 金額: 経営向け日本語単位 (億/万) — feedback_japanese_currency_units
function fmtJPY(n) {
  if (n === null || n === undefined) return '−';
  const neg = n < 0; const a = Math.abs(Math.round(n));
  let s;
  if (a >= 100000000) s = (a / 100000000).toFixed(2).replace(/\.?0+$/, '') + '億円';
  else if (a >= 10000) s = Math.round(a / 10000).toLocaleString() + '万円';
  else s = '¥' + a.toLocaleString();
  return neg ? '−' + s : s;
}
function fmtYen(n) { if (n === null || n === undefined) return '−'; return '¥' + Math.round(n).toLocaleString(); }
function fmtPct(n) { return (n === null || n === undefined) ? '−' : n + '%'; }
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function getJSON(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}
function signClass(n) { return n < 0 ? 'negv' : n > 0 ? 'pos' : ''; }

// 期間プリセット
const PRESETS = [
  ['7d', '7日'], ['14d', '14日'], ['30d', '30日'], ['90d', '90日'],
  ['this_month', '今月'], ['last_month', '先月'], ['12m', '12ヶ月'], ['this_year', '今年'],
];
function mountPeriodSwitcher(elId, defaultPreset, onChange) {
  const el = document.getElementById(elId);
  el.innerHTML = PRESETS.map(([k, label]) =>
    `<button data-preset="${k}" class="${k === defaultPreset ? 'active' : ''}">${label}</button>`).join('');
  el.addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    el.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    onChange(btn.dataset.preset);
  });
}

// ============================================================
// タブ制御 (lazy load)
// ============================================================
const loaded = {};
document.getElementById('tabs').addEventListener('click', (e) => {
  const btn = e.target.closest('.tab-btn'); if (!btn) return;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('pane-' + btn.dataset.tab).classList.add('active');
  loadTab(btn.dataset.tab);
});
function loadTab(tab) {
  if (loaded[tab]) return;
  loaded[tab] = true;
  ({ overview: loadOverview, import: loadImport }[tab] || (() => {}))();
}

// ============================================================
// 🏠 概要
// ============================================================
let ovPreset = '30d';
async function loadOverview() {
  try {
    const data = await getJSON(API + '/overview');
    document.getElementById('meta-updated').textContent =
      `データ最終日: ${data.data_to || '−'} / 生成: ${new Date(data.generated_at).toLocaleString('ja-JP')}`;
    document.getElementById('ov-freshness').textContent =
      'factは毎朝07:00更新 (受注7日窓)。「今日」タイルは翌朝の更新まで0のままです。';
    const tiles = data.tiles.map(t => {
      const confirmedRows = t.confirmed !== undefined ? (t.confirmed ? `
        <div class="row"><span>広告費 <span class="pbadge settled">確定</span></span><span class="v">−${fmtYen(t.confirmed.ad_cost)}</span></div>
        <div class="row"><span>楽天手数料 <span class="pbadge settled">確定</span></span><span class="v">−${fmtYen(t.confirmed.pf_fee)}</span></div>
        <div class="row"><span>実質利益 <span class="pbadge settled">確定寄せ</span></span><span class="v ${signClass(t.confirmed.full_margin)}">${fmtJPY(t.confirmed.full_margin)}</span></div>`
        : `<div class="row"><span class="note">月次仕訳書 未取込 (広告費・実質利益は取込後に確定)</span><span></span></div>`) : '';
      return `<div class="tile">
        <h3>${t.label} <span class="note">(${t.from}${t.from !== t.to ? '〜' + t.to : ''})</span></h3>
        <div class="row"><span>売上(税込) <span class="pbadge flash">速報</span></span><span class="v">${fmtJPY(t.sales_incl)}</span></div>
        <div class="row"><span>販売数 (ｷｬﾝｾﾙ)</span><span class="v">${t.units_net.toLocaleString()} <span class="note">(−${t.units_cancelled.toLocaleString()})</span></span></div>
        <div class="row"><span>クーポン店負 / 返金</span><span class="v">−${fmtYen(t.coupon_shop)} / −${fmtYen(t.refunds)}</span></div>
        <div class="row"><span>手数料 <span class="pbadge est">推定10%</span> / 送料</span><span class="v">−${fmtYen(t.mall_fee_est)} / −${fmtYen(t.shipping)}</span></div>
        <div class="row"><span>原価 <span class="note">ｶﾊﾞｰ${fmtPct(t.cost_coverage_pct)}</span></span><span class="v">−${fmtYen(t.cogs)}</span></div>
        <div class="row hero"><span>粗利 <span class="pbadge flash">速報</span> <span class="note">${fmtPct(t.margin_pct)}</span></span><span class="v ${signClass(t.variable_margin)}">${fmtJPY(t.variable_margin)}</span></div>
        ${confirmedRows}
      </div>`;
    }).join('');
    document.getElementById('ov-tiles').innerHTML = tiles;
  } catch (e) {
    document.getElementById('ov-tiles').innerHTML = `<div class="warn-note">概要の取得に失敗: ${esc(e.message)}</div>`;
  }
  mountPeriodSwitcher('ov-period', ovPreset, (p) => { ovPreset = p; loadTrend(); });
  loadTrend();
}

async function loadTrend() {
  try {
    const gran = ['12m', 'this_year'].includes(ovPreset) ? 'month' : ovPreset === '90d' ? 'week' : 'day';
    const data = await getJSON(`${API}/trend?preset=${ovPreset}&granularity=${gran}`);
    const labels = data.rows.map(r => r.bucket);
    const confirmedSet = new Set((data.confirmed_months || []).map(c => c.year_month));

    mkChart('chart-trend', {
      type: 'bar',
      data: { labels, datasets: [
        { label: '売上(税込)', data: data.rows.map(r => r.sales_incl), backgroundColor: labels.map(l => confirmedSet.has(l) ? '#fda4af' : '#fecaca'), yAxisID: 'y', order: 3 },
        { label: '粗利(変動利益)', data: data.rows.map(r => r.variable_margin), type: 'line', borderColor: '#047857', pointRadius: 0, yAxisID: 'y', order: 1 },
        { label: '粗利率%', data: data.rows.map(r => r.margin_pct), type: 'line', borderColor: '#f59e0b', pointRadius: 0, yAxisID: 'y1', order: 0 },
      ]},
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: { y: { position: 'left', ticks: { callback: v => fmtJPY(v) } }, y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: v => v + '%' } } },
        plugins: { tooltip: { callbacks: {
          label: c => c.dataset.label + ': ' + (c.dataset.yAxisID === 'y1' ? fmtPct(c.parsed.y) : fmtJPY(c.parsed.y)),
          footer: (items) => {
            const c = (data.confirmed_months || []).find(x => x.year_month === items[0]?.label);
            return c ? `確定: 広告費 ${fmtJPY(c.ad_cost)} / 手数料 ${fmtJPY(c.pf_fee)} / 実質利益 ${fmtJPY(c.full_margin)}` : '';
          },
        } } } },
    });

    mkChart('chart-units', {
      type: 'bar',
      data: { labels, datasets: [
        { label: '販売数', data: data.rows.map(r => r.units_net), backgroundColor: '#93c5fd', yAxisID: 'y' },
        { label: 'キャンセル率%', data: data.rows.map(r => r.cancel_rate_pct), type: 'line', borderColor: '#dc2626', pointRadius: 0, yAxisID: 'y1' },
      ]},
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: { y: {}, y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: v => v + '%' } } } },
    });

    mkChart('chart-deductions', {
      type: 'line',
      data: { labels, datasets: [
        { label: 'クーポン店舗負担', data: data.rows.map(r => r.coupon_shop), borderColor: '#7c3aed', backgroundColor: 'rgba(124,58,237,0.08)', fill: true, pointRadius: 0 },
        { label: '返金', data: data.rows.map(r => r.refunds), borderColor: '#dc2626', backgroundColor: 'rgba(220,38,38,0.08)', fill: true, pointRadius: 0 },
      ]},
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: { y: { ticks: { callback: v => fmtJPY(v) } } },
        plugins: { tooltip: { callbacks: { label: c => c.dataset.label + ': ' + fmtJPY(c.parsed.y) } } } },
    });
  } catch (e) { console.error(e); }
}

// ============================================================
// 📥 取込
// ============================================================
async function loadImport() {
  const zone = document.getElementById('drop-zone');
  const input = document.getElementById('file-input');
  zone.addEventListener('click', () => input.click());
  input.addEventListener('change', () => { if (input.files.length) uploadFiles(input.files); });
  zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('dragover'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault(); zone.classList.remove('dragover');
    if (e.dataTransfer.files.length) uploadFiles(e.dataTransfer.files);
  });
  refreshImportViews();
}

async function uploadFiles(fileList) {
  const resultEl = document.getElementById('import-result');
  const files = [...fileList];
  document.getElementById('file-input').value = '';
  const allResults = [];
  // サーバーは1リクエスト4ファイルまで (メモリ保護) → 4件ずつ順次送信
  for (let i = 0; i < files.length; i += 4) {
    const batch = files.slice(i, i + 4);
    resultEl.innerHTML = `<div class="loading">取込中… (${Math.min(i + 4, files.length)}/${files.length})</div>`;
    const fd = new FormData();
    for (const f of batch) fd.append('files', f);
    try {
      const res = await fetch(API + '/import', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) {
        allResults.push(...batch.map(f => ({ file: f.name, ok: false, error: data.error || ('HTTP ' + res.status) })));
      } else {
        allResults.push(...data.results);
      }
    } catch (e) {
      allResults.push(...batch.map(f => ({ file: f.name, ok: false, error: 'アップロード失敗: ' + e.message })));
    }
  }
  resultEl.innerHTML = allResults.map(r => r.ok
    ? `<div class="ok-note">✓ ${esc(r.file)} — ${esc(r.label)} / 期間 ${esc(r.date_from)}〜${esc(r.date_to)} / ${r.rows.toLocaleString()}行 (新規 ${r.inserted.toLocaleString()} / 上書き ${r.updated.toLocaleString()}${r.dedup_in_file ? ` / ファイル内重複統合 ${r.dedup_in_file}` : ''})</div>`
    : r.skipped
    ? `<div class="warn-note">⏸ ${esc(r.file)} — ${esc(r.error)}</div>`
    : `<div class="err-note">✗ ${esc(r.file)} — ${esc(r.error)}</div>`).join('');
  refreshImportViews();
}

async function refreshImportViews() {
  try {
    const st = await getJSON(API + '/import/status');
    document.getElementById('freshness-table').innerHTML = `<thead><tr>
      <th>データ種別</th><th>状態</th><th>データ期間</th><th>行数</th><th>最終取込</th><th>未取込の月</th>
    </tr></thead><tbody>` + st.types.map(t => {
      if (!t.implemented) return `<tr><td>${esc(t.label)}</td><td><span class="pill todo">準備中</span></td><td colspan="4" class="note">${esc(t.note || '')}</td></tr>`;
      if (t.optional && t.row_count === 0) return `<tr><td>${esc(t.label)}</td><td><span class="pill todo">任意</span></td><td colspan="4" class="note">${esc(t.note || '')}</td></tr>`;
      const missing = (t.missing_months || []);
      return `<tr>
        <td>${esc(t.label)}</td>
        <td>${t.row_count > 0 ? '<span class="pill ok">取込済</span>' : '<span class="pill warn">未取込</span>'}</td>
        <td>${t.data_from ? esc(t.data_from) + ' 〜 ' + esc(t.data_to) : '−'}</td>
        <td class="num">${(t.row_count || 0).toLocaleString()}</td>
        <td>${t.last_imported_at ? esc(new Date(t.last_imported_at).toLocaleString('ja-JP')) : '−'}</td>
        <td>${missing.length ? `<span class="pill warn">${missing.length}ヶ月</span> ${esc(missing.slice(0, 8).join(', '))}${missing.length > 8 ? ' …' : ''}` : (t.row_count > 0 ? '<span class="pill ok">なし</span>' : '−')}</td>
      </tr>`;
    }).join('') + '</tbody>';

    const log = await getJSON(API + '/import/log?limit=50');
    document.getElementById('import-log-table').innerHTML = `<thead><tr>
      <th>日時</th><th>ファイル</th><th>種別</th><th>結果</th><th>期間</th><th>行数</th><th>新規/上書き</th><th>メッセージ</th>
    </tr></thead><tbody>` + (log.items.length === 0 ? '<tr><td colspan="8" class="note">履歴なし</td></tr>' :
      log.items.map(r => `<tr>
        <td>${esc(new Date(r.imported_at).toLocaleString('ja-JP'))}</td>
        <td style="max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${esc(r.file_name)}</td>
        <td>${esc(r.file_type)}</td>
        <td>${r.status === 'ok' ? '<span class="pill ok">OK</span>' : r.status === 'skipped' ? '<span class="pill warn">スキップ</span>' : '<span class="pill err">エラー</span>'}</td>
        <td>${r.date_from ? esc(r.date_from) + '〜' + esc(r.date_to) : '−'}</td>
        <td class="num">${(r.row_count || 0).toLocaleString()}</td>
        <td class="num">${(r.inserted || 0).toLocaleString()} / ${(r.updated || 0).toLocaleString()}</td>
        <td style="max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${esc(r.message || '')}">${esc(r.message || '')}</td>
      </tr>`).join('')) + '</tbody>';
  } catch (e) {
    document.getElementById('freshness-table').innerHTML = `<tbody><tr><td class="err-note">取得失敗: ${esc(e.message)}</td></tr></tbody>`;
  }
}

// 初期ロード
loadTab('overview');
</script>
