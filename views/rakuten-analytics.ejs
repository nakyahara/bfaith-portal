      `<tr><td>${esc(k)}</td><td class="num">${esc(Array.isArray(v) ? v.join(', ') : v)}</td></tr>`).join('');
    const events = (d.events || []).map(x =>
      `<tr><td>${esc(new Date(x.at).toLocaleString('ja-JP'))}</td><td>${esc(x.event)}</td><td>${esc(x.actor_kind)}${x.actor ? ' (' + esc(x.actor) + ')' : ''}</td><td>${esc(x.note || '')}</td></tr>`).join('');
    let effectHtml = '';
    if (d.effect) {
