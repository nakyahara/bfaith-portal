<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>楽天分析ツール - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
          integrity="sha384-9nhczxUqK87bcKHh20fSQcTGD4qq5GhayNYSYWqwBkINBhOfQLg/P5HG5lF1urn4"
          crossorigin="anonymous"></script>
  <style>
    body { background: #f5f7fa; }
    .container { max-width: 1500px; margin: 0 auto; padding: 16px 20px; }
    .header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 12px; }
    .header-row h2 { margin: 0; }
    .back-link { font-size: 13px; color: #bf0000; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .meta-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 14px; margin-bottom: 12px; font-size: 12px; color: #555; display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

    /* 精度バッジ */
    .pbadge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; vertical-align: middle; }
    .pbadge.flash { background: #dbeafe; color: #1e40af; }
    .pbadge.est { background: #fef3c7; color: #92400e; }
    .pbadge.settled { background: #d1fae5; color: #065f46; }
    .pbadge.actual { background: #ede9fe; color: #5b21b6; }

    /* タブ (楽天クリムゾン) */
    .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
    .tab-btn { background: #fff; border: 1px solid #e5e7eb; border-bottom: none; border-radius: 6px 6px 0 0; padding: 10px 16px; cursor: pointer; font-size: 13px; color: #555; position: relative; }
    .tab-btn.active { background: #bf0000; color: white; border-color: #bf0000; }
    .tab-btn .cnt { position: absolute; top: -6px; right: -4px; background: #dc2626; color: #fff; border-radius: 10px; font-size: 10px; font-weight: 700; padding: 1px 6px; }
    .tab-content { background: white; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 8px; padding: 16px; min-height: 400px; }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    .period-switcher { display: inline-flex; gap: 4px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; flex-wrap: wrap; }
    .period-switcher button { background: transparent; border: none; padding: 6px 10px; font-size: 12px; cursor: pointer; border-radius: 4px; color: #555; }
    .period-switcher button.active { background: #bf0000; color: white; }
    .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }
    .toolbar select { border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 8px; font-size: 12px; }

    .tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .tile { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .tile h3 { margin: 0 0 8px; font-size: 14px; color: #374151; }
    .tile .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #4b5563; }
    .tile .row .v { font-variant-numeric: tabular-nums; font-weight: 600; color: #111; }
    .tile .row.hero { border-top: 1px dashed #e5e7eb; margin-top: 6px; padding-top: 8px; }
    .tile .row.hero .v { font-size: 20px; font-weight: 700; }
    .pos { color: #047857 !important; } .negv { color: #dc2626 !important; }

    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .chart-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; }
    .chart-card h3 { margin: 0 0 8px; font-size: 13px; color: #374151; font-weight: 600; }
    .chart-wrap { position: relative; height: 300px; }
    .chart-wrap.tall { height: 420px; }
    @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }

    .note { font-size: 11.5px; color: #6b7280; margin: 6px 0; }
    .warn-note { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 8px 12px; font-size: 12px; color: #92400e; border-radius: 4px; margin-bottom: 12px; }
    .err-note { background: #fef2f2; border-left: 4px solid #dc2626; padding: 8px 12px; font-size: 12px; color: #991b1b; border-radius: 4px; margin-bottom: 8px; }
    .loading { color: #6b7280; font-size: 13px; padding: 30px; text-align: center; }
    .section-h { font-size: 14px; font-weight: 700; color: #1f2937; margin: 18px 0 8px; }
    table.data { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    table.data th, table.data td { border: 1px solid #e5e7eb; padding: 5px 8px; }
    table.data th { background: #f9fafb; font-weight: 600; color: #374151; text-align: left; white-space: nowrap; }
    table.data td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .table-scroll { overflow-x: auto; }
    .name-cell { max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .pill.ok { background: #d1fae5; color: #065f46; }
    .pill.warn { background: #fef3c7; color: #92400e; }
    .pill.err { background: #fee2e2; color: #991b1b; }
    .pill.info { background: #dbeafe; color: #1e40af; }
    .pill.todo { background: #f3f4f6; color: #6b7280; }
    .btn { background: #bf0000; color: #fff; border: none; border-radius: 6px; padding: 6px 14px; font-size: 12px; cursor: pointer; }
    .btn.secondary { background: #6b7280; }
    .btn.ghost { background: #fff; color: #374151; border: 1px solid #d1d5db; }
    .btn.sm { padding: 3px 10px; font-size: 11px; }
    dialog { border: 1px solid #e5e7eb; border-radius: 10px; max-width: 920px; width: 92%; padding: 18px; }
    dialog::backdrop { background: rgba(0,0,0,0.35); }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; margin-bottom: 10px; }
    .form-grid label { font-size: 11px; color: #6b7280; display: block; }
    .form-grid input, .form-grid select { width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 8px; font-size: 12px; box-sizing: border-box; }

    /* アクションカード */
    .action-card { border: 1px solid #e5e7eb; border-left: 4px solid #d1d5db; border-radius: 8px; padding: 10px 14px; margin-bottom: 10px; background: #fff; }
    .action-card.critical { border-left-color: #dc2626; }
    .action-card.warning { border-left-color: #f59e0b; }
    .action-card.info { border-left-color: #3b82f6; }
    .action-card .a-title { font-size: 13.5px; font-weight: 700; color: #111; }
    .action-card .a-sub { font-size: 12px; color: #6b7280; margin: 3px 0; }
    .action-card .a-suggest { font-size: 12.5px; color: #1f2937; background: #f9fafb; border-radius: 6px; padding: 6px 10px; margin: 6px 0; }
    .action-card .a-btns { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .factor-pill { display: inline-block; padding: 1px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; }
    .factor-access { background: #dbeafe; color: #1e40af; }
    .factor-cvr { background: #fee2e2; color: #991b1b; }
    .factor-aov { background: #fef3c7; color: #92400e; }
  </style>
  <link rel="stylesheet" href="/mobile.css">
</head>
<body>
  <div class="container">
    <div class="header-row">
      <h2>📊 楽天分析ツール</h2>
      <div style="display:flex; gap:14px; align-items:center;">
        <span style="font-size:12px; color:#6b7280;"><%= displayName || username || '' %></span>
        <a class="back-link" href="/">← ポータルへ戻る</a>
      </div>
    </div>
    <div class="meta-bar">
      <span>精度: <span class="pbadge flash">速報</span>=受注ベース <span class="pbadge actual">実績</span>=RMSレポート自動取得 <span class="pbadge est">推定</span>=手数料10%一律 <span class="pbadge settled">確定</span>=月次仕訳書 / 金額は<b>税込</b></span>
      <span id="meta-updated"></span>
    </div>

    <div class="tabs" id="tabs">
      <button class="tab-btn active" data-tab="overview">🏠 概要</button>
      <button class="tab-btn" data-tab="actions">🎯 アクション<span class="cnt" id="action-count" style="display:none;"></span></button>
      <button class="tab-btn" data-tab="ads">📣 広告</button>
      <button class="tab-btn" data-tab="equation">📈 売上方程式</button>
      <button class="tab-btn" data-tab="bestsellers">🏆 売れ筋</button>
      <button class="tab-btn" data-tab="profit">💰 利益分析</button>
      <button class="tab-btn" data-tab="ranking">🔍 検索順位</button>
      <button class="tab-btn" data-tab="data">📡 データ</button>
      <button class="tab-btn" data-tab="settings">⚙️ 設定</button>
    </div>

    <div class="tab-content">
      <!-- 🏠 概要 -->
      <div class="tab-pane active" id="pane-overview">
        <div id="ov-tiles" class="tile-grid"><div class="loading">読み込み中…</div></div>
        <div class="toolbar">
          <div class="period-switcher" id="ov-period"></div>
          <span class="note" id="ov-freshness"></span>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>売上 × 粗利 × 粗利率 <span class="pbadge flash">速報</span> <span class="note">粗利 = 変動利益 (売上−クーポン−返金−手数料<span class="pbadge est">推定</span>−送料−原価)</span></h3>
            <div class="chart-wrap tall"><canvas id="chart-trend"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>販売数 × キャンセル率 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap"><canvas id="chart-units"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>クーポン店舗負担 × 返金の推移 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap"><canvas id="chart-deductions"></canvas></div>
          </div>
        </div>
      </div>

      <!-- 🎯 アクション -->
      <div class="tab-pane" id="pane-actions">
        <div class="toolbar">
          <div class="period-switcher" id="act-filter">
            <button data-f="open,acked" class="active">対応待ち</button>
            <button data-f="done">完了</button>
            <button data-f="resolved">解消</button>
            <button data-f="dismissed">却下</button>
            <button data-f="open,acked,done,dismissed,resolved">全て</button>
          </div>
          <button class="btn ghost sm" id="act-rerun">🔄 診断を再実行</button>
          <span class="note" id="act-runinfo"></span>
        </div>
        <div id="act-runerror"></div>
        <div id="act-list"><div class="loading">読み込み中…</div></div>
        <div class="note">診断は毎日1回、画面を開いたときに自動実行されます (ルールv1: データ鮮度 / 損益分岐ROAS割れ / CVR急落 / 在庫切れ間近×広告)。
        「完了」にすると実施記録が残り、7日後に前後比較 (参考評価) が詳細に表示されます。将来ここに AI の提案 (source=ai) も合流します。</div>
      </div>

      <!-- 📣 広告 -->
      <div class="tab-pane" id="pane-ads">
        <div class="toolbar">
          <label class="note">対象月</label><select id="ads-month"></select>
          <span class="note" id="ads-match"></span>
        </div>
        <div id="ads-summary" class="tile-grid"></div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>日次広告費 × ROAS (直近90日、店舗全体) <span class="pbadge actual">実績</span></h3>
            <div class="chart-wrap"><canvas id="chart-ads-daily"></canvas></div>
          </div>
        </div>
        <div class="section-h">SKU別 広告効率 (RPP月次 × 利益fact) — 判定: 実ROAS(720h) vs 損益分岐ROAS = 100÷変動利益率</div>
        <div class="table-scroll"><table class="data" id="ads-table"></table></div>
      </div>

      <!-- 📈 売上方程式 -->
      <div class="tab-pane" id="pane-equation">
        <div class="toolbar">
          <div class="period-switcher" id="eq-window">
            <button data-w="7" class="active">7日</button>
            <button data-w="14">14日</button>
            <button data-w="28">28日</button>
          </div>
          <span class="note">売上 = アクセス × 転換率 × 客単価。変化を3因子に分解します (順序固定の会計的分解、厳密な因果ではありません)</span>
        </div>
        <div id="eq-note"></div>
        <div class="charts-grid">
          <div class="chart-card">
            <h3>店舗全体: 売上変化の因子分解 <span class="pbadge actual">実績</span> <span id="eq-title" class="note"></span></h3>
            <div class="chart-wrap"><canvas id="chart-eq"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>SKU: <span id="eq-sku-title">上下表から商品をクリック</span></h3>
            <div class="chart-wrap"><canvas id="chart-eq-sku"></canvas></div>
          </div>
        </div>
        <div class="section-h">急落SKU (直近7日 vs 直前7日) — 主因バッジ: <span class="factor-pill factor-access">アクセス</span> <span class="factor-pill factor-cvr">転換率</span> <span class="factor-pill factor-aov">客単価</span></div>
        <div class="table-scroll"><table class="data" id="eq-fallers"></table></div>
        <div class="section-h">急伸SKU</div>
        <div class="table-scroll"><table class="data" id="eq-risers"></table></div>
      </div>

      <!-- 🏆 売れ筋 (準備中) -->
      <div class="tab-pane" id="pane-bestsellers">
        <div class="warn-note">準備中。実装予定: 売れ筋ランキング (数量/売上/実質利益) / 急上昇・急落 / ABC / genre別 / 曜日×イベント。</div>
      </div>

      <!-- 💰 利益分析 (準備中) -->
      <div class="tab-pane" id="pane-profit">
        <div class="warn-note">準備中。実装予定: 楽天版ウォーターフォール / SKU別実質利益テーブル / 料率マスタ (確定月から実効料率を自動逆算)。</div>
      </div>

      <!-- 🔍 検索順位 (準備中) -->
      <div class="tab-pane" id="pane-ranking">
        <div class="warn-note">準備中。実装予定: 順位×売上×広告の重ね合わせ / 順位急落 / 1ページ目占有率 (mirror_rank_history 同期後)。それまでは <a href="/apps/ranking-checker" target="_blank">順位チェッカー</a> へ。</div>
      </div>

      <!-- 📡 データ -->
      <div class="tab-pane" id="pane-data">
        <div class="note">楽天のデータは <b>mall-csv-fetcher (miniPC)</b> が毎朝RMSから自動取得し、warehouse.db → mirror に同期されます。
        自動取得が壊れた日は GChat に通知が届き、手動DL→miniPCの incoming/ フォルダ投入で無停止運用できます (取込コードは共通)。</div>
        <div class="table-scroll"><table class="data" id="fresh-table"><tbody><tr><td class="loading">読み込み中…</td></tr></tbody></table></div>
      </div>

      <!-- ⚙️ 設定 -->
      <div class="tab-pane" id="pane-settings">
        <div class="section-h">診断ルールの閾値</div>
        <div class="form-grid" id="th-form"></div>
        <button class="btn" id="th-save">保存</button>
        <span class="note" id="th-status"></span>
      </div>
    </div>
  </div>

  <!-- アクション詳細ダイアログ -->
  <dialog id="act-dialog">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
      <h3 style="margin:0; font-size:15px;" id="act-dialog-title"></h3>
      <button class="btn secondary sm" onclick="document.getElementById('act-dialog').close()">閉じる</button>
    </div>
    <div id="act-dialog-body" style="font-size:12.5px;"></div>
  </dialog>

<script>
// ============================================================
// 共通 util
// ============================================================
const API = '/apps/rakuten-analytics/api/v1';
const charts = {};
function destroyChart(id) { if (charts[id]) { charts[id].destroy(); delete charts[id]; } }
function mkChart(id, cfg) { destroyChart(id); charts[id] = new Chart(document.getElementById(id).getContext('2d'), cfg); return charts[id]; }
function fmtJPY(n) {
  if (n === null || n === undefined) return '−';
  const neg = n < 0; const a = Math.abs(Math.round(n));
  let s;
  if (a >= 100000000) s = (a / 100000000).toFixed(2).replace(/\.?0+$/, '') + '億円';
  else if (a >= 10000) s = Math.round(a / 10000).toLocaleString() + '万円';
  else s = '¥' + a.toLocaleString();
  return neg ? '−' + s : s;
}
function fmtYen(n) { if (n === null || n === undefined) return '−'; return '¥' + Math.round(n).toLocaleString(); }
function fmtPct(n) { return (n === null || n === undefined) ? '−' : n + '%'; }
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function getJSON(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}
async function postJSON(url, body) {
  const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
  return data;
}
function signClass(n) { return n < 0 ? 'negv' : n > 0 ? 'pos' : ''; }

const PRESETS = [
  ['7d', '7日'], ['14d', '14日'], ['30d', '30日'], ['90d', '90日'],
  ['this_month', '今月'], ['last_month', '先月'], ['12m', '12ヶ月'], ['this_year', '今年'],
];
function mountPeriodSwitcher(elId, defaultPreset, onChange) {
  const el = document.getElementById(elId);
  el.innerHTML = PRESETS.map(([k, label]) =>
    `<button data-preset="${k}" class="${k === defaultPreset ? 'active' : ''}">${label}</button>`).join('');
  el.addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    el.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    onChange(btn.dataset.preset);
  });
}

// ============================================================
// タブ制御 (lazy load)
// ============================================================
const loaded = {};
document.getElementById('tabs').addEventListener('click', (e) => {
  const btn = e.target.closest('.tab-btn'); if (!btn) return;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('pane-' + btn.dataset.tab).classList.add('active');
  loadTab(btn.dataset.tab);
});
function loadTab(tab) {
  if (loaded[tab]) return;
  loaded[tab] = true;
  ({ overview: loadOverview, actions: loadActions, ads: loadAds, equation: loadEquation,
     data: loadFreshness, settings: loadSettings }[tab] || (() => {}))();
}

// ============================================================
// 🏠 概要
// ============================================================
let ovPreset = '30d';
async function loadOverview() {
  try {
    const data = await getJSON(API + '/overview');
    document.getElementById('meta-updated').textContent =
      `データ最終日: ${data.data_to || '−'} / 生成: ${new Date(data.generated_at).toLocaleString('ja-JP')}`;
    document.getElementById('ov-freshness').textContent =
      '受注factは毎朝07:00更新。広告実績はRMS仕様で昨日分まで (「今日」タイルは翌朝に埋まります)。';
    const tiles = data.tiles.map(t => {
      const confirmedRows = t.confirmed !== undefined ? (t.confirmed ? `
        <div class="row"><span>広告費 <span class="pbadge settled">確定</span></span><span class="v">−${fmtYen(t.confirmed.ad_cost)}</span></div>
        <div class="row"><span>楽天手数料 <span class="pbadge settled">確定</span></span><span class="v">−${fmtYen(t.confirmed.pf_fee)}</span></div>
        <div class="row"><span>実質利益 <span class="pbadge settled">確定寄せ</span></span><span class="v ${signClass(t.confirmed.full_margin)}">${fmtJPY(t.confirmed.full_margin)}</span></div>`
        : `<div class="row"><span class="note">月次仕訳書 未取込 (確定値は取込後)</span><span></span></div>`) : '';
      return `<div class="tile">
        <h3>${t.label} <span class="note">(${t.from}${t.from !== t.to ? '〜' + t.to : ''})</span></h3>
        <div class="row"><span>売上(税込) <span class="pbadge flash">速報</span></span><span class="v">${fmtJPY(t.sales_incl)}</span></div>
        <div class="row"><span>販売数 (ｷｬﾝｾﾙ)</span><span class="v">${t.units_net.toLocaleString()} <span class="note">(−${t.units_cancelled.toLocaleString()})</span></span></div>
