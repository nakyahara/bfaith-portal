        scales: { y: { ticks: { callback: v => fmtJpyShort(v) } } },
        plugins: { tooltip: { callbacks: { label: (ctx) => ctx.dataset.label + ': ¥' + fmtJpyComma(ctx.parsed.y) } } },
      },
    });

    // 7. 在庫回転 (棒=棚卸資産月末残高 + 折れ線=在庫回転日数)
    destroyChart('invTurnover');
    charts.invTurnover = new Chart(document.getElementById('chart-inv-turnover').getContext('2d'), {
      type: 'bar',
      data: {
        labels: bsLabels,
        datasets: [
          { type: 'bar', label: '棚卸資産 (月末)', data: bsTrend.map(r => r.inventory || 0), backgroundColor: '#7c3aed', yAxisID: 'y' },
          { type: 'line', label: '在庫回転日数', data: bsTrend.map(r => r.inventory_turnover_days), borderColor: '#dc2626', backgroundColor: 'transparent', yAxisID: 'y1', tension: 0.2 },
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        scales: {
          y: { position: 'left', ticks: { callback: v => fmtJpyShort(v) } },
          y1: { position: 'right', ticks: { callback: v => v + '日' }, grid: { drawOnChartArea: false } },
        },
        plugins: { tooltip: { callbacks: { label: (ctx) => ctx.dataset.label + ': ' + (ctx.dataset.yAxisID === 'y1' ? (ctx.parsed.y == null ? '—' : ctx.parsed.y + '日') : '¥' + fmtJpyComma(ctx.parsed.y)) } } },
      },
    });
  }
}

// ─── render: 試算表 ───
function renderTrialBalance(targetId, j, kind) {
  const months = j.months;
  let html = '<div class="table-scroll"><table class="tb"><thead><tr><th style="width:30px"></th><th>科目</th>';
  for (const m of months) html += '<th>' + m + '</th>';
  html += '<th>合計</th></tr></thead><tbody>';

  for (const sec of j.sections) {
    const sectionId = (kind || 'pl') + '-' + sec.name.replace(/[^\w]/g, '');
    const total = sec.totals.reduce((s, v) => s + (v || 0), 0);
    const rowClass = sec.is_subtotal ? 'subtotal' : 'section';
    const expandable = sec.items && sec.items.length > 0;
    const toggle = expandable ? '<button class="toggle-btn" data-target="' + sectionId + '">▶</button>' : '';
    html += '<tr class="' + rowClass + '"><td>' + toggle + '</td><td><strong>' + sec.name + '</strong></td>';
    for (const t of sec.totals) html += '<td' + (t < 0 ? ' class="neg"' : '') + '>' + fmtJpyComma(t) + '</td>';
    html += '<td' + (total < 0 ? ' class="neg"' : '') + '><strong>' + fmtJpyComma(total) + '</strong></td></tr>';

    if (expandable) {
      for (const it of sec.items) {
        const itTotal = it.totals.reduce((s, v) => s + (v || 0), 0);
        if (itTotal === 0 && it.totals.every(t => t === 0)) continue;
        html += '<tr class="item item-detail" data-section="' + sectionId + '" style="display:none"><td></td><td style="padding-left:30px">' + it.name + '</td>';
        for (const t of it.totals) html += '<td' + (t < 0 ? ' class="neg"' : '') + '>' + fmtJpyComma(t) + '</td>';
        html += '<td' + (itTotal < 0 ? ' class="neg"' : '') + '>' + fmtJpyComma(itTotal) + '</td></tr>';
      }
    }
  }
  html += '</tbody></table></div>';
  document.getElementById(targetId).innerHTML = html;

  // toggle handler
  document.querySelectorAll('#' + targetId + ' .toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const sectionId = btn.dataset.target;
      const items = document.querySelectorAll('#' + targetId + ' .item-detail[data-section="' + sectionId + '"]');
      const isOpen = items.length > 0 && items[0].style.display !== 'none';
      items.forEach(it => it.style.display = isOpen ? 'none' : '');
      btn.textContent = isOpen ? '▶' : '▼';
    });
  });
}

// ─── render: 異常検知 ───
function renderAnomaly(rows) {
  if (!rows || rows.length === 0) {
    document.getElementById('tab-anomaly').innerHTML = '<div class="empty" style="background:#d1fae5;border-color:#10b981;color:#065f46">✅ open な異常検知シグナルはありません</div>';
    return;
  }
  let html = '<table class="data"><thead><tr><th>重要度</th><th>コード</th><th>タイトル</th><th>状態</th><th>状況</th></tr></thead><tbody>';
  rows.forEach(r => {
    const sev = r.severity || 'info';
    html += '<tr>'
      + '<td><span class="badge ' + sev + '">' + sev + '</span></td>'
      + '<td>' + r.signal_code + '</td>'
      + '<td><strong>' + r.title + '</strong><div style="font-size:12px;color:#666">' + (r.description || '') + '</div></td>'
      + '<td>' + (r.state_status || 'open') + '</td>'
      + '<td>' + (r.observed_value != null ? '実測:' + r.observed_value + ' / 閾値:' + (r.threshold_value || '—') : '') + '</td>'
      + '</tr>';
  });
  html += '</tbody></table>';
  document.getElementById('tab-anomaly').innerHTML = html;
}

// ─── render: 詳細 (旧 5 タブの内容を折りたたみで) ───
function renderDetails(j) {
  let html = '';
  // モール別売上
  if (j.channelRows && j.channelRows.length > 0) {
    const months = [...new Set(j.channelRows.map(r => r.month_ym))].sort().reverse();
    const channels = [...new Set(j.channelRows.map(r => r.channel_display_name))];
    const m = {};
    j.channelRows.forEach(r => { m[r.month_ym + '|' + r.channel_display_name] = r; });
    let t = '<table class="data"><thead><tr><th>月</th>';
    channels.forEach(c => t += '<th>' + c + '</th>');
    t += '<th>合計</th></tr></thead><tbody>';
    for (const month of months) {
      let total = 0;
      t += '<tr><td><strong>' + month + '</strong></td>';
      for (const ch of channels) {
        const v = m[month + '|' + ch]?.gross_sales_excl_tax || 0;
        total += v;
        t += '<td class="num">' + (v > 0 ? fmtJpyShort(v) : '—') + '</td>';
      }
      t += '<td class="num"><strong>' + fmtJpyShort(total) + '</strong></td></tr>';
    }
    t += '</tbody></table>';
    html += '<details class="detail-section"><summary>モール別売上 (補助科目別、生データ)</summary><div class="table-scroll" style="margin-top:10px">' + t + '</div></details>';
  }
  // 月末残高
  if (j.balanceRows && j.balanceRows.length > 0) {
    const months = [...new Set(j.balanceRows.map(r => r.month_ym))].sort().reverse();
    const accs = [...new Set(j.balanceRows.map(r => r.account_name + (r.sub_account_name ? '/' + r.sub_account_name : '')))];
    const m = {};
    j.balanceRows.forEach(r => {
      const k = r.account_name + (r.sub_account_name ? '/' + r.sub_account_name : '');
      m[r.month_ym + '|' + k] = r.closing_balance_excl_tax;
    });
    let t = '<table class="data"><thead><tr><th>月</th>';
    accs.forEach(a => t += '<th>' + a + '</th>');
    t += '</tr></thead><tbody>';
    for (const month of months) {
      t += '<tr><td><strong>' + month + '</strong></td>';
      for (const a of accs) {
        const v = m[month + '|' + a] || 0;
        t += '<td class="num">' + (v !== 0 ? fmtJpyShort(v) : '—') + '</td>';
      }
      t += '</tr>';
    }
    t += '</tbody></table>';
    html += '<details class="detail-section"><summary>月末残高 (口座別、生データ)</summary><div class="table-scroll" style="margin-top:10px">' + t + '</div></details>';
  }
  // 現金流入出
  if (j.cashRows && j.cashRows.length > 0) {
    let t = '<table class="data"><thead><tr><th>銀行</th><th>入金</th><th>件数</th><th>出金</th><th>件数</th><th>差引</th></tr></thead><tbody>';
    j.cashRows.forEach(r => {
      const diff = (r.in_total || 0) - (r.out_total || 0);
      t += '<tr><td><strong>' + r.bank_account_key + '</strong></td>'
        + '<td class="num">' + fmtJpyShort(r.in_total) + '</td>'
        + '<td class="num">' + (r.in_cnt || 0) + '</td>'
        + '<td class="num">' + fmtJpyShort(r.out_total) + '</td>'
        + '<td class="num">' + (r.out_cnt || 0) + '</td>'
        + '<td class="num"' + (diff < 0 ? ' style="color:#dc2626"' : '') + '>' + fmtJpyShort(diff) + '</td></tr>';
    });
    t += '</tbody></table>';
    html += '<details class="detail-section"><summary>現金流入出 (過去90日)</summary><div style="margin-top:10px">' + t + '</div></details>';
  }
  // role_key 別 PL
  if (j.plRows && j.plRows.length > 0) {
    let t = '<table class="data"><thead><tr><th>月</th><th>role_key</th><th>金額</th></tr></thead><tbody>';
    j.plRows.slice(0, 200).forEach(r => {
      t += '<tr><td>' + r.month_ym + '</td><td>' + r.role_key + '</td><td class="num">¥' + fmtJpyComma(r.amount_excl_tax) + '</td></tr>';
    });
    t += '</tbody></table>';
    html += '<details class="detail-section"><summary>role_key 別 PL (デバッグ用、200行まで)</summary><div class="table-scroll" style="margin-top:10px">' + t + '</div></details>';
  }
  document.getElementById('tab-details').innerHTML = html || '<div class="empty">詳細データなし</div>';
}

// ─── 起動 ───
loadSnapshot();
loadFySummary();
loadAll();
</script>
</body>
</html>
