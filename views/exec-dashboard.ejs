    const liabSegs = [
      { key: 'l_ap', label: '仕入債務', color: '#f59e0b' },
      { key: 'l_short_loan', label: '短期借入金等', color: '#f97316' },
      { key: 'l_other_current', label: 'その他流動負債', color: '#fbbf24' },
      { key: 'l_fixed', label: '固定負債(長期借入金等)', color: '#dc2626' },
      { key: 'l_equity', label: '純資産', color: '#10b981' },
    ];
    const bsBalDatasets = [
      ...assetSegs.map(s => ({ label: '資産:' + s.label, data: bsTrend.map(r => r[s.key] || 0), backgroundColor: s.color, stack: 'asset' })),
      ...liabSegs.map(s => ({ label: '負債純資産:' + s.label, data: bsTrend.map(r => r[s.key] || 0), backgroundColor: s.color, stack: 'liab' })),
    ];
    charts.bsBalance = new Chart(document.getElementById('chart-bs-balance').getContext('2d'), {
      type: 'bar',
      data: { labels: bsLabels, datasets: bsBalDatasets },
      options: {
        responsive: true, maintainAspectRatio: false,
        scales: { x: { stacked: true }, y: { stacked: true, ticks: { callback: v => fmtJpyShort(v) } } },
        plugins: {
          legend: { labels: { boxWidth: 10, font: { size: 10 } } },
          tooltip: { callbacks: { label: (ctx) => ctx.dataset.label + ': ¥' + fmtJpyComma(ctx.parsed.y) } },
          title: { display: true, text: '各月: 左=資産構成 / 右=資金調達構成 (同じ高さ=BSが釣り合い)', font: { size: 10 }, color: '#6b7280' },
        },
      },
    });

    // 6. 財務体質推移 (折れ線): 総資産 / 純資産 / 借入金合計
    destroyChart('bsTrend');
    charts.bsTrend = new Chart(document.getElementById('chart-bs-trend').getContext('2d'), {
      type: 'line',
