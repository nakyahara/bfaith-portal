      { key: 'a_cash', label: '現預金', color: '#0891b2' },
      { key: 'a_ar', label: '売上債権', color: '#2563eb' },
      { key: 'a_inventory', label: '棚卸資産', color: '#7c3aed' },
      { key: 'a_other_current', label: 'その他流動資産', color: '#a78bfa' },
      { key: 'a_fixed', label: '固定資産', color: '#64748b' },
