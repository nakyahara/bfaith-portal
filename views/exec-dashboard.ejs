<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MF経営トップダッシュボード - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <!-- Chart.js (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    body { background: #f5f7fa; }
    .container { max-width: 1400px; margin: 0 auto; padding: 16px 20px; }
    .header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; }
    .header-row h2 { margin: 0; }
    .back-link { font-size: 13px; color: #2563eb; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }

    .meta-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px 16px; margin-bottom: 16px; font-size: 12px; color: #555; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; }
    .meta-bar strong { color: #111; }
    .badge-success { background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }

    /* 期間切替 */
    .period-switcher { display: inline-flex; gap: 4px; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; }
    .period-switcher button { background: transparent; border: none; padding: 6px 12px; font-size: 12px; cursor: pointer; border-radius: 4px; color: #555; }
    .period-switcher button.active { background: #2563eb; color: white; }

    /* KPI */
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .kpi-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .kpi-card h3 { margin: 0 0 6px 0; font-size: 13px; color: #6b7280; font-weight: 500; }
    .kpi-card .v { font-size: 28px; font-weight: 700; color: #111; line-height: 1.2; }
    .kpi-card .sub { font-size: 12px; color: #6b7280; margin-top: 4px; }
    .kpi-card.cash .v { color: #047857; }
    .kpi-card.danger .v { color: #b91c1c; font-size: 22px; }
    .yoy-up { color: #059669; }
    .yoy-down { color: #dc2626; }

    /* グラフ */
    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
    .chart-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .chart-card h3 { margin: 0 0 10px 0; font-size: 13px; color: #374151; font-weight: 600; }
    .chart-wrap { position: relative; height: 280px; }
    /* Phase 1d-3c++: 「5つの箱」BS 概観 + アコーディオン式 BS */
    .big-bs-card, .bsacc-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 18px; margin-bottom: 16px; }
    .big-bs-card h3, .bsacc-card h3 { margin: 0 0 12px 0; font-size: 15px; color: #1e3a8a; font-weight: 700; }
    .bsbox-grid { display: flex; gap: 10px; align-items: stretch; }
    .bsbox-col { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .bsbox-colhead { font-size: 13px; text-align: center; padding: 4px 0 8px; color: #374151; }
    .bsbox-colhead strong { font-size: 16px; color: #111; }
    .bsbox-colhead .sub { font-weight: 400; color: #6b7280; font-size: 12px; }
    .bsbox-stack { display: flex; flex-direction: column; height: 380px; border: 1px solid #d1d5db; border-radius: 6px; overflow: hidden; }
    .bsbox { flex-grow: 1; flex-basis: 0; min-height: 52px; border-bottom: 1px solid rgba(0,0,0,0.12); border-left: 5px solid #ccc; padding: 8px 14px; overflow: hidden; display: flex; flex-direction: column; justify-content: center; }
    .bsbox:last-child { border-bottom: none; }
    .bsbox-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .bsbox-label { font-size: 16px; font-weight: 700; color: #1f2937; }
    .bsbox-amt { font-size: 16px; font-weight: 700; color: #111; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bsbox-pct { font-size: 13px; font-weight: 600; color: #6b7280; margin-left: 2px; }
    .bsbox-note { font-size: 11px; color: #6b7280; margin-top: 2px; }
    /* アコーディオン式 BS */
    .bsacc-group { margin-bottom: 12px; }
    .bsacc-group-head { display: flex; justify-content: space-between; font-size: 16px; font-weight: 700; color: #111; padding: 8px 10px; background: #eef2ff; border-radius: 4px; }
    .bsacc-section { border-left: 5px solid #ccc; margin: 6px 0 6px 8px; }
    .bsacc-section-head { display: flex; justify-content: space-between; font-size: 14px; font-weight: 700; color: #1f2937; padding: 6px 12px; }
    .bsacc-acct { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 14px; color: #374151; padding: 6px 12px 6px 30px; border-bottom: 1px solid #f3f4f6; }
    .bsacc-acct[data-toggle] { cursor: pointer; }
    .bsacc-acct[data-toggle]:hover { background: #f9fafb; }
    .bsacc-tri { font-size: 10px; color: #6b7280; width: 14px; flex-shrink: 0; }
    .bsacc-name { flex: 1; }
    .bsacc-amt { font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 600; color: #111; }
    .bsacc-subpanel { background: #fafafa; }
    .bsacc-item { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; color: #6b7280; padding: 4px 12px 4px 50px; border-bottom: 1px dashed #eee; }
    .bsacc-bottom { display: flex; justify-content: space-between; font-size: 16px; font-weight: 700; color: #111; padding: 10px; background: #f0f9ff; border-radius: 4px; border-top: 2px solid #bae6fd; margin-top: 8px; }
    .bsacc-acct.bsacc-subtotal { background: #fffbeb; border-top: 1px solid #fde68a; border-bottom: 1px solid #fde68a; }
    .pl-flow-note { margin-top: 10px; padding: 8px 12px; background: #f0fdf4; border-left: 4px solid #43a047; border-radius: 4px; font-size: 13px; color: #166534; }
    .bs-trend-details { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 14px; margin-bottom: 8px; }
    .bs-trend-details > summary { font-weight: 600; cursor: pointer; padding: 4px 0; color: #374151; }
    /* FY 期ボタン (period-switcher 内) */
    .period-switcher button.fy-period-btn { border-left: 1px solid #e5e7eb; margin-left: 2px; padding-left: 10px; }
    @media (max-width: 768px) {
      .bsbox-grid { flex-direction: column; }
      .bsbox-stack { height: auto; }
      .bsbox { min-height: 48px; }
      .bsacc-acct { padding-left: 20px; } .bsacc-item { padding-left: 36px; }
      .bsbox-label, .bsbox-amt, .bsacc-group-head, .bsacc-bottom { font-size: 14px; }
    }

    /* タブ */
    .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
    .tab-btn { background: #fff; border: 1px solid #e5e7eb; border-bottom: none; border-radius: 6px 6px 0 0; padding: 10px 16px; cursor: pointer; font-size: 13px; color: #555; }
    .tab-btn.active { background: #2563eb; color: white; border-color: #2563eb; }
    .tab-content { background: white; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 8px; padding: 16px; min-height: 400px; }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* 試算表 */
    table.tb { width: 100%; border-collapse: collapse; font-size: 13px; }
    table.tb thead th { background: #f3f4f6; font-weight: 600; color: #374151; padding: 8px 10px; border: 1px solid #e5e7eb; text-align: right; position: sticky; top: 0; z-index: 1; }
    table.tb thead th:first-child, table.tb thead th:nth-child(2) { text-align: left; }
    table.tb tbody td { padding: 5px 10px; border: 1px solid #e5e7eb; font-variant-numeric: tabular-nums; text-align: right; }
    table.tb tbody td:first-child, table.tb tbody td:nth-child(2) { text-align: left; }
    table.tb tr.section { background: #eef2ff; font-weight: 700; }
    table.tb tr.section td { color: #1e3a8a; }
    table.tb tr.subtotal { background: #fef3c7; font-weight: 700; }
    table.tb tr.subtotal td { color: #92400e; border-top: 2px solid #fbbf24; }
    table.tb tr.item { color: #4b5563; }
    table.tb tr.item:hover { background: #f9fafb; }
    .toggle-btn { background: transparent; border: none; cursor: pointer; padding: 0 4px; font-size: 14px; color: #6b7280; }
    .toggle-btn:hover { color: #2563eb; }
    .neg { color: #dc2626; }

    /* タブ折りたたみ (詳細) */
    details.detail-section { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 12px; margin-bottom: 8px; }
    details.detail-section summary { font-weight: 600; cursor: pointer; padding: 4px 0; color: #374151; }

    /* table.data: 既存 5 タブ用 */
    table.data { width: 100%; border-collapse: collapse; font-size: 13px; }
    table.data th, table.data td { border: 1px solid #e5e7eb; padding: 6px 10px; }
    table.data th { background: #f9fafb; font-weight: 600; color: #374151; text-align: left; }
    table.data td.num { text-align: right; font-variant-numeric: tabular-nums; }

    .empty { background: #fef3c7; border: 1px solid #fbbf24; padding: 16px; border-radius: 6px; color: #78350f; }
    .loading { padding: 16px; color: #6b7280; }

    /* 第N期 累計 セクション (Phase 1d-2) */
    .fy-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
    .fy-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .fy-card.current { border-left: 4px solid #2563eb; }
    .fy-card.prev { border-left: 4px solid #6b7280; }
    .fy-card .fy-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
    .fy-card .fy-title { font-size: 15px; font-weight: 700; color: #111; }
    .fy-card .fy-period { font-size: 12px; color: #6b7280; }
    .fy-card .fy-status { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600; }
    .fy-card .fy-status.in-progress { background: #dbeafe; color: #1e40af; }
    .fy-card .fy-status.completed { background: #d1fae5; color: #065f46; }
    .fy-card .fy-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; margin-top: 6px; }
    .fy-card .fy-metric { padding: 6px 0; border-bottom: 1px solid #f3f4f6; }
    .fy-card .fy-metric:last-child { border-bottom: none; }
    .fy-card .fy-metric .label { font-size: 11px; color: #6b7280; }
    /* Phase 1d-5: KPI 数値定義ヘルプ ⓘ — hover で title 属性のネイティブ tooltip 表示 */
    .help-icon { font-size: 10px; color: #9ca3af; cursor: help; margin-left: 2px; user-select: none; vertical-align: super; outline: none; }
    .help-icon:hover, .help-icon:focus { color: #2563eb; }
    /* タッチデバイス (hover 不可) では ⓘ をやや強調 (タップで long-press tooltip 表示) */
    @media (hover: none) { .help-icon { color: #2563eb; font-size: 11px; } }
    .fy-card .fy-metric .value { font-size: 18px; font-weight: 700; color: #111; }
    .fy-card .fy-metric .pct { font-size: 12px; color: #2563eb; margin-left: 4px; font-weight: 500; }
    @media (max-width: 768px) {
      .fy-summary { grid-template-columns: 1fr; }
      .fy-card .fy-row { grid-template-columns: 1fr; }
    }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; }
    .badge.success { background: #d1fae5; color: #065f46; }
    .badge.warn { background: #fef3c7; color: #92400e; }
    .badge.high { background: #fed7aa; color: #9a3412; }
    .badge.critical { background: #fecaca; color: #991b1b; }
    .badge.info { background: #dbeafe; color: #1e40af; }

    /* モバイル */
    @media (max-width: 900px) {
      .charts-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .kpi-grid { grid-template-columns: 1fr 1fr; }
      .meta-bar { font-size: 11px; }
      .chart-wrap { height: 220px; }
      .tab-content { padding: 8px; }
      table.tb, table.data { font-size: 11px; }
      table.tb thead th, table.tb tbody td { padding: 4px 6px; }
      /* テーブル横スクロール */
      .table-scroll { overflow-x: auto; }
    }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left"><h1>B-Faith Portal</h1></div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/" class="btn-logout">ダッシュボード</a>
      <a href="/logout" class="btn-logout">ログアウト</a>
    </div>
  </header>

  <main class="container">
    <div class="header-row">
      <h2>📊 MFクラウド経営トップ</h2>
      <div class="period-switcher" id="period-switcher">
        <button data-period="6m">6ヶ月</button>
        <button data-period="12m" class="active">12ヶ月</button>
        <button data-period="24m">24ヶ月</button>
        <button data-period="all">全期間</button>
      </div>
      <a href="/" class="back-link">← ポータルへ戻る</a>
    </div>

    <div id="status-bar" class="meta-bar">
      <span class="loading">読み込み中...</span>
    </div>

    <div id="kpi-section" class="kpi-grid"></div>

    <!-- Phase 1d-2: 期 (FY) 累計 (B-Faith 第N期、7月-6月) -->
    <div id="fy-summary" class="fy-summary">
      <div class="loading">第N期 累計データ読み込み中...</div>
    </div>

    <div class="charts-grid">
      <div class="chart-card"><h3>📈 売上 vs 粗利 (粗利率折れ線)</h3><div class="chart-wrap"><canvas id="chart-sales"></canvas></div></div>
      <div class="chart-card"><h3>💵 現預金推移 (銀行別積み上げ)</h3><div class="chart-wrap"><canvas id="chart-cash"></canvas></div></div>
      <div class="chart-card"><h3>🛒 モール別売上 (積み上げ)</h3><div class="chart-wrap"><canvas id="chart-channel"></canvas></div></div>
      <div class="chart-card"><h3>💼 PL 主要 (売上/粗利/営業利益/経常利益)</h3><div class="chart-wrap"><canvas id="chart-pl"></canvas></div></div>
    </div>

    <!-- Phase 1d-3c: BS グラフ (資産=負債+純資産 + 財務体質推移 + 在庫回転) -->
    <div id="bs-charts-card" class="charts-grid">
      <div class="chart-card"><h3>🏦 貸借対照表 構成 (各月: 左=資産 / 右=負債+純資産)</h3><div class="chart-wrap"><canvas id="chart-bs-balance"></canvas></div></div>
      <div class="chart-card"><h3>📊 財務体質推移 (総資産 / 純資産 / 借入金合計)</h3><div class="chart-wrap"><canvas id="chart-bs-trend"></canvas></div></div>
      <div class="chart-card"><h3>📦 在庫回転 (棚卸資産 + 回転日数)</h3><div class="chart-wrap"><canvas id="chart-inv-turnover"></canvas></div></div>
    </div>

    <div class="tabs">
      <button class="tab-btn active" data-tab="pl">📋 PL 試算表</button>
      <button class="tab-btn" data-tab="bs">🏦 BS 試算表 (貸借対照表)</button>
      <button class="tab-btn" data-tab="anomaly">⚠️ 異常検知</button>
      <button class="tab-btn" data-tab="details">🔎 詳細</button>
    </div>

    <div class="tab-content">
      <div class="tab-pane active" id="tab-pl"><div class="loading">読み込み中...</div></div>
      <div class="tab-pane" id="tab-bs"><div class="loading">期間切替後に表示</div></div>
      <div class="tab-pane" id="tab-anomaly"><div class="loading">読み込み中...</div></div>
      <div class="tab-pane" id="tab-details"><div class="loading">タブを開くと読み込みます</div></div>
    </div>
  </main>

<script>
'use strict';

// ─── 日本語金額フォーマット ───
function fmtJpyShort(n) {
  if (n == null || isNaN(n)) return '—';
  const v = Math.round(Number(n));
  if (v === 0) return '¥0';
  if (Math.abs(v) >= 100000000) return (v / 100000000).toFixed(2).replace(/\.?0+$/, '') + '億';
  if (Math.abs(v) >= 10000) return Math.round(v / 10000).toLocaleString() + '万';
  return v.toLocaleString();
}
function fmtJpyComma(n) {
  if (n == null || isNaN(n)) return '—';
  const v = Math.round(Number(n));
  return v.toLocaleString();
}
function fmtPct(n) {
  if (n == null || isNaN(n)) return '—';
  return (n >= 0 ? '+' : '') + Number(n).toFixed(1) + '%';
}
function fmtDate(s) { return s ? s.slice(0, 19).replace('T', ' ') : '—'; }
// HTML escape helper (Codex review Q5: stored XSS 対策)
function esc(s) {
  if (s == null) return '';
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// ─── 数値定義ヘルプ (Phase 1d-5: KPI 各項目に hover で表示する定義集) ───
//   各 KPI helper (pctOnly/yenOnly 等) に defKey を渡すと ⓘ icon が出てネイティブ tooltip で定義表示
//   定義は「計算式」「意味」「目安/しきい値」「B-Faith戦略」を改行区切りで含める
const KPI_DEFS = {
  // ─ 上部 KPI 5 ─
  top_sales: '売上 (確定月)\n計算式: sales_mtd_excl_tax (税抜)\n意味: 最終確定月の売上総額\nB-Faith は EC物販 (年商¥11億) のため月次¥80-100M の幅',
  top_gross_profit: '粗利 (限界利益)\n計算式: 売上 - 売上原価\n意味: 限界利益 (B-Faith戦略「原価=変動費」)、粗利率は対売上%\n目安: 月次粗利率 12-16% (繁忙期高、閑散期低)',
  top_op_income: '営業利益\n計算式: 粗利 - 販管費 (sgae_*)\n意味: 本業の利益。販管費を引いた後の儲け\n目安: 月次¥0-5M、累計で営業利益率 3-5%',
  top_cash: '現預金合計 (確定月末)\n計算式: 現金+預金 (UPSIDER等カード除く)\n5区分: 普通預金/定期預金/PayPal/ペイオニア/小口現金\n注意: UPSIDER等のクレジットカード残高は別カウント',
  top_danger: '危険信号\n計算式: mart_mf_anomaly_signals の status=open 件数\nルール: R1 資金繰り残月数 / R2 粗利率急落 / R3 在庫急増 / R4 モール売上急減 / R5 営業赤字\n対応: タブ「異常検知」で詳細確認',

  // ─ 第N期 累計 4個 (PL) ─
  fy_sales: '売上累計 (FY期初〜確定月)\n計算式: Σsales (税抜、FY 期間)\n意味: 当期どこまで稼いだか',
  fy_gross_profit: '粗利累計 (限界利益累計)\n計算式: Σ(売上 - 売上原価)\n意味: 限界利益 (固定費+利益の原資)',
  fy_op_income: '営業利益累計\n計算式: Σ(粗利 - 販管費)\n意味: 本業の儲け累計',
  fy_ord_income: '経常利益累計\n計算式: 営業利益 + 営業外収益 - 営業外費用\n意味: 借入利息や雑収入を含めた通常の儲け\n目安: 売上対比 3-5% で健全',

  // ─ 経営指標 KPI 9個 ─
  marginal_profit_rate: '限界利益率 (= 粗利率)\n計算式: 粗利 ÷ 売上 × 100\n意味: 売上1円あたり、変動費を引いた残り (固定費+利益の原資)\nB-Faith戦略: 原価=変動費なので 粗利率=限界利益率\n目安: 12-16%',
  labor_distribution: '労働分配率\n計算式: 人件費 ÷ 限界利益 × 100\n意味: 稼いだ限界利益の何%を人件費に分配しているか\n目安: 50%以下が健全、70%超は人件費過多\n人件費 = 役員報酬+給与+賞与+法定福利+福利厚生',
  marginal_per_employee: '1人当たり限界利益 (年換算)\n計算式: 限界利益累計 ÷ 従業員数\n意味: 1人がいくら限界利益を稼いでいるか\n注意: 過去 FY も今の HEADCOUNT で割るので履歴非整合 (将来 mart に headcount 列追加予定)',
