};
const helpIcon = (defKey) => {
  if (!defKey) return '';
  const def = KPI_DEFS[defKey];
  if (!def) {
    if (typeof console !== 'undefined') console.warn('[KPI helpIcon] Unknown defKey:', defKey);
    return '';
  }
  return ' <span class="help-icon" tabindex="0" role="button" aria-label="' + esc(def) + '" title="' + esc(def) + '">ⓘ</span>';
};

// ─── 状態 ───
let currentPeriod = '12m';
const charts = {};
let detailsLoaded = false;

// ─── 期間切替 (FY ボタンは動的追加なのでイベント委譲) ───
document.getElementById('period-switcher').addEventListener('click', (e) => {
  const btn = e.target.closest('button[data-period]');
  if (!btn) return;
  currentPeriod = btn.dataset.period;
  document.querySelectorAll('#period-switcher button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  loadAll();
});
// Phase 1d-3c+: 第N期 ボタンを period-switcher に追加 (loadFySummary から呼ばれる)
function renderFyPeriodButtons(fyRows) {
  const sw = document.getElementById('period-switcher');
  sw.querySelectorAll('.fy-period-btn').forEach(b => b.remove());
  if (!fyRows || fyRows.length === 0) return;
  // fy_number 降順 (新しい期が左)
  const sorted = [...fyRows].sort((a, b) => b.fy_number - a.fy_number);
  for (const fy of sorted) {
    const b = document.createElement('button');
    b.dataset.period = 'fy:' + fy.fy_number;
    b.className = 'fy-period-btn';
    b.textContent = '第' + fy.fy_number + '期';
    if (currentPeriod === 'fy:' + fy.fy_number) b.classList.add('active');
    sw.appendChild(b);
  }
}

// ─── タブ切替 ───
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    if (btn.dataset.tab === 'bs') loadBs();
    if (btn.dataset.tab === 'details' && !detailsLoaded) loadDetails();
  });
});

// ─── データ取得 ───
async function fetchJson(url) {
  const res = await fetch(url);
  return res.json();
}

async function loadSnapshot() {
  const j = await fetchJson('/apps/exec-dashboard/api/snapshot');
  if (!j.ok) {
    document.getElementById('status-bar').innerHTML = '<span style="color:#dc2626">エラー: ' + (j.error || 'unknown') + '</span>';
    return;
  }
  if (!j.available) {
    document.getElementById('status-bar').innerHTML = '<span class="empty">' + (j.message || 'データなし') + '</span>';
    return;
  }
  renderStatus(j.exec, j.runMeta);
  renderKpi(j.exec);
  renderAnomaly(j.anomalies);
}

// Phase 1d-2: 第N期 累計 FY summary (PDF 経営実績報告書の指標)
async function loadFySummary() {
  const el = document.getElementById('fy-summary');
  // Codex R2 review: 前回成功時の meta が unavailable/error に切替えても残る問題を fix
  //   loadFySummary 突入時に必ず meta を消す (renderFySummary 成功時のみ再注入)
  const oldMeta = document.getElementById('fy-summary-meta');
  if (oldMeta) oldMeta.remove();
  try {
    const j = await fetchJson('/apps/exec-dashboard/api/fy-summary');
    if (!j.ok) { el.textContent = ''; el.innerHTML = '<div class="empty">FY summary 取得エラー: ' + esc(j.error || '') + '</div>'; return; }
    if (!j.available) { el.textContent = ''; el.innerHTML = '<div class="empty">' + esc(j.message || '第N期 累計データなし') + '</div>'; return; }
    renderFySummary(j.fy_summary, j.headcount, j.meta);
    renderFyPeriodButtons(j.fy_summary);  // Phase 1d-3c+: 上部に 第N期 ボタン追加
  } catch (e) {
    el.textContent = ''; el.innerHTML = '<div class="empty">FY summary 通信エラー: ' + esc(e.message) + '</div>';
  }
}

function renderFySummary(rows, headcount, meta) {
  const el = document.getElementById('fy-summary');
  if (!rows || rows.length === 0) { el.innerHTML = '<div class="empty">第N期 データなし</div>'; return; }
  // 当期 = fy_number 大、前期 = 小 (rows は API 側で fy_number DESC ソート済み LIMIT 2)
  const cur = rows[0];
  const prev = rows[1];

  // Phase 1d-5: 各 KPI helper に optional defKey を追加。指定時は label の右に ⓘ + tooltip
  const m = (label, val, pct, defKey) => {
    const pctHtml = pct != null && Number.isFinite(pct) ? '<span class="pct">' + esc(pct.toFixed(2)) + '%</span>' : '';
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value">' + (val == null ? '—' : esc(fmtJpyShort(val))) + pctHtml + '</div></div>';
  };
  const pctOnly = (label, pct, defKey) => {
    const v = pct == null || !Number.isFinite(pct) ? '—' : esc(Number(pct).toFixed(2)) + '%';
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value">' + v + '</div></div>';
  };
  const daysOnly = (label, d, defKey) => {
    const v = d == null || !Number.isFinite(d) ? '—' : esc(Number(d).toFixed(1)) + '日';
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value">' + v + '</div></div>';
  };
  const monthsOnly = (label, d, warnThreshold, defKey) => {
    const ok = d != null && Number.isFinite(d);
    const v = ok ? esc(Number(d).toFixed(1)) + 'ヶ月' : '—';
    const warn = ok && warnThreshold != null && d < warnThreshold;
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value"' + (warn ? ' style="color:#dc2626"' : '') + '>' + v + (warn ? ' ⚠' : '') + '</div></div>';
  };
  const yenOnly = (label, val, defKey) => {
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value">' + (val == null ? '—' : esc(fmtJpyShort(val))) + '</div></div>';
  };
  // ratioFmt: 倍数 (n.n倍) 表示。warnIfBelow=N で N 未満を赤太字 ⚠ (例: インタレストカバレッジ 3倍以下、返済余力 1.0以下)
  //   missingNote: val が null の時に "—" の代わりに表示する文言 (例: "計算不能 (赤字)")。指定時は ⚠ + 赤太字
  const ratioFmt = (label, val, suffix, warnIfBelow, missingNote, defKey) => {
    const ok = val != null && Number.isFinite(val);
    let v, warn = false;
    if (ok) { v = esc(Number(val).toFixed(1)) + suffix; warn = warnIfBelow != null && val < warnIfBelow; }
    else if (missingNote) { v = esc(missingNote); warn = true; }
    else { v = '—'; }
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value"' + (warn ? ' style="color:#dc2626"' : '') + '>' + v + (warn ? ' ⚠' : '') + '</div></div>';
  };
  // ratioFmtAbove: warnIfAbove=N で N 超過を赤太字 ⚠ (例: 債務償還年数 10年超、借入金月商比率 3ヶ月超)
  const ratioFmtAbove = (label, val, suffix, warnIfAbove, missingNote, defKey) => {
    const ok = val != null && Number.isFinite(val);
    let v, warn = false;
    if (ok) { v = esc(Number(val).toFixed(1)) + suffix; warn = warnIfAbove != null && val > warnIfAbove; }
    else if (missingNote) { v = esc(missingNote); warn = true; }
    else { v = '—'; }
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value"' + (warn ? ' style="color:#dc2626"' : '') + '>' + v + (warn ? ' ⚠' : '') + '</div></div>';
  };
  // yenSigned: 純増減金額。負(純減=返済進行)を緑▲、正(純増=借入増)を赤+ で色分け
  const yenSigned = (label, val, defKey) => {
    if (val == null || !Number.isFinite(val)) return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value">—</div></div>';
    const color = val < 0 ? '#16a34a' : (val > 0 ? '#dc2626' : '#111');
    const display = val < 0 ? ('▲' + fmtJpyShort(Math.abs(val))) : (val > 0 ? ('+' + fmtJpyShort(val)) : '±¥0');
    return '<div class="fy-metric"><div class="label">' + esc(label) + helpIcon(defKey) + '</div><div class="value" style="color:' + color + '">' + esc(display) + '</div></div>';
  };

  const card = (fy, klass) => {
    if (!fy) return '';   // Codex Q4: prev 無い場合は単独 card (placeholder 削除)
    const statusClass = fy.is_fy_completed ? 'completed' : 'in-progress';
    const statusLabel = fy.is_fy_completed ? '完了' : '進行中';
    const periodText = esc(fy.fy_start_ym) + ' 〜 ' + esc(fy.fy_end_ym)
      + ' (' + esc(String(fy.months_in_cumulative)) + 'ヶ月時点 ' + esc(fy.cumulative_through_ym) + ')';
    return ''
      + '<div class="fy-card ' + klass + '">'
      + '  <div class="fy-head">'
      + '    <div>'
      + '      <div class="fy-title">第' + esc(String(fy.fy_number)) + '期 累計</div>'
      + '      <div class="fy-period">' + periodText + '</div>'
      + '    </div>'
      + '    <span class="fy-status ' + statusClass + '">' + statusLabel + '</span>'
      + '  </div>'
      // 累計 PL
      + '  <div class="fy-row">'
      + m('売上累計', fy.sales_cum, null, 'fy_sales')
      + m('粗利累計 (限界利益)', fy.gross_profit_cum, fy.marginal_profit_pct, 'fy_gross_profit')
      + m('営業利益累計', fy.operating_income_cum, null, 'fy_op_income')
      + m('経常利益累計', fy.ordinary_income_cum, fy.ordinary_profit_pct, 'fy_ord_income')
      + '  </div>'
      // 経営指標 KPI
      + '  <div style="font-size:11px;color:#6b7280;margin:10px 0 4px;font-weight:600;border-top:1px solid #e5e7eb;padding-top:8px">📐 経営指標 KPI</div>'
      + '  <div class="fy-row">'
      + pctOnly('1. 限界利益率', fy.marginal_profit_pct, 'marginal_profit_rate')
      + pctOnly('2. 労働分配率', fy.labor_distribution_pct, 'labor_distribution')
      + yenOnly('3. 1人当たり限界利益 (' + esc(String(headcount)) + '名)', fy.marginal_profit_per_employee, 'marginal_per_employee')
      + pctOnly('4. 売上高経常利益率', fy.ordinary_profit_pct, 'ordinary_profit_rate')
      + pctOnly('5. 当座比率 (当座資産÷流動負債)', fy.quick_ratio_pct, 'quick_ratio')
      + pctOnly('6. 自己資本比率 (純資産÷総資産)', fy.equity_ratio_pct, 'equity_ratio')
      + pctOnly('7. ROA (経常÷平均総資産)', fy.roa_pct, 'roa')
      + daysOnly('8. DSO 売上債権回転日数', fy.dso_days, 'dso')
      + daysOnly('9. DPO 仕入債務回転日数', fy.dpo_days, 'dpo')
      + daysOnly('在庫回転日数', fy.inventory_turnover_days, 'inventory_turnover')
      + daysOnly('CCC (DSO+在庫回転−DPO)', fy.ccc_days, 'ccc')
      + monthsOnly('💰 資金繰り残月数 (現預金÷月間固定費)', fy.cash_runway_months, 3, 'cash_runway')
      + yenOnly('月間固定費 (販管費月平均)', fy.monthly_fixed_cost, 'monthly_fixed')
      + yenOnly('総資産 月平均', fy.total_asset_average, 'total_asset_avg')
      + '  </div>'
      // 💳 借入金返済余力 (Phase 1d-4 + 1d-5: 期中借入額/返済額 分離)
      + (fy.loan && fy.loan.available
          ? ('  <div style="font-size:11px;color:#6b7280;margin:10px 0 4px;font-weight:600;border-top:1px solid #e5e7eb;padding-top:8px">'
              + '💳 借入金返済余力'
              + '<span style="font-weight:400;color:#9ca3af;margin-left:6px">期首=' + esc(fy.loan.opening_ym) + ' / 確定月=' + esc(fy.loan.closing_ym) + '</span>'
              + '<span style="font-weight:400;color:#9ca3af;font-size:10px;margin-left:6px">※ Phase 1d-5: 月次純変動から期中借入/返済を gross 集計、返済余力もこれを分母に再計算</span>'
              + '</div>'
            + '  <div class="fy-row">'
            + yenOnly('借入金合計 (短期+長期)', fy.loan.loan_total_closing, 'loan_total')
            + yenSigned('期首比 純増減 (▲=返済進行)', fy.loan.loan_change_in_period, 'loan_change')
            // ─ Phase 1d-5: 期中借入額/返済額 を gross で分離表示 (月次純変動から推定) ─
            + yenOnly('期中借入額 (月次純変動 +方向の合計)', fy.loan.gross_borrowing_in_period, 'loan_borrowing')
            + yenOnly('期中返済額 (月次純変動 -方向の合計)', fy.loan.gross_repayment_in_period, 'loan_repayment')
            + ratioFmtAbove('債務償還年数 (借入÷年換算EBITDA、目安≤10年)', fy.loan.debt_to_ebitda_years, '年', 10,
                fy.loan.ebitda_status === 'non_positive' ? '計算不能 (EBITDA≤0)' : null, 'debt_to_ebitda')
            + ratioFmt('インタレスト・カバレッジ (営業利益÷支払利息、目安≥3倍)', fy.loan.interest_coverage_ratio, '倍', 3, null, 'icr')
            + ratioFmtAbove('借入金月商比率 (借入÷月平均売上、目安≤3ヶ月)', fy.loan.loan_to_monthly_sales_months, 'ヶ月', 3, null, 'loan_to_sales')
            // ─ Phase 1d-5: 返済余力は gross 返済ベースに変更 (純減ベースは旧仕様、追加借入を隠す問題があった) ─
            + ratioFmt('🛟 返済余力 (年換算EBITDA÷年間返済額 実績、目安≥1.0倍)', fy.loan.repayment_capacity_ratio, '倍', 1.0,
                fy.loan.repayment_status === 'no_repayment' ? '期中返済なし (要注意)'
                  : fy.loan.repayment_status === 'gap_in_history' ? '月次BSに欠損 (算出不能)'
                  : null, 'repayment_capacity')
            + yenOnly('年換算EBITDA (簡易: 営業利益+減価償却)', fy.loan.annualized_ebitda, 'ebitda')
            + yenOnly('年間返済額 (期中gross実績・年換算)', fy.loan.annualized_gross_repayment, 'loan_repayment')
            + yenOnly('年間借入額 (期中gross実績・年換算)', fy.loan.annualized_gross_borrowing, 'loan_borrowing')
            + yenOnly('支払利息 累計', fy.loan.interest_paid_cum, 'interest_paid')
            + yenOnly('減価償却費 累計', fy.loan.depreciation_cum, 'depreciation')
            + '  </div>')
          : '')
      // 💰 簡易キャッシュフロー (間接法、Phase 1d-4)
      + (fy.cash_flow && fy.cash_flow.available
          ? renderCashFlowHtml(fy.cash_flow)
          : '')
      + '</div>';
  };

  // Codex Q4: prev が無い (第1期のみ) 場合は当期 card のみ。grid の 1fr 1fr を上書き。
  if (!prev) {
    el.style.gridTemplateColumns = '1fr';
  } else {
    el.style.gridTemplateColumns = '';
  }
  el.innerHTML = card(cur, 'current') + card(prev, 'prev');

  // Codex Q6/Q7: 鮮度メタ情報を status bar の右側に注記 (単独 div で append)
  if (meta && meta.run_id) {
    const sb = document.getElementById('status-bar');
    // 既存の FY summary meta 行を上書き (重複防止)
    const old = document.getElementById('fy-summary-meta');
    if (old) old.remove();
    const span = document.createElement('span');
    span.id = 'fy-summary-meta';
    span.textContent = `📅 FY summary: run_id=${meta.run_id} / 〜${meta.cumulative_through_ym} / 1人=${headcount}名 (現在値)`;
    span.style.fontSize = '11px';
    span.style.color = '#6b7280';
    sb.appendChild(span);
  }
}

// ─── 💰 簡易キャッシュフロー (間接法、Phase 1d-4) ───
//   経営者向け「利益 → 現金」ブリッジを fy-card に挿入。
//   表示する金額の符号は CF 影響ベース (BS 変動の符号と逆になる項目あり、コメント参照)
function renderCashFlowHtml(cf) {
  // 符号付き金額: + は緑 (現金 IN)、- は赤 (現金 OUT)、0 はグレー
  const sign = (v) => {
    if (v == null || !Number.isFinite(v)) return '—';
    if (v === 0) return '±¥0';
    return (v > 0 ? '+' : '▲') + fmtJpyShort(Math.abs(v));
  };
  const colorOf = (v) => (v == null || !Number.isFinite(v)) ? '#6b7280' : (v > 0 ? '#16a34a' : (v < 0 ? '#dc2626' : '#6b7280'));
  const row = (label, value, opts) => {
    opts = opts || {};
    const indent = opts.indent ? 'padding-left:14px;color:#6b7280;' : 'color:#111;';
    const bold = opts.bold ? 'font-weight:700;' : '';
    const border = opts.borderTop ? 'border-top:1px solid #e5e7eb;padding-top:4px;margin-top:2px;' : '';
    const fz = opts.bold ? '13px' : '12px';
    const color = colorOf(value);
    return '<div style="display:flex;justify-content:space-between;font-size:' + fz + ';padding:2px 0;' + indent + bold + border + '">'
         + '<span>' + esc(label) + (opts.defKey ? helpIcon(opts.defKey) : '') + '</span>'
         + '<span style="color:' + color + ';font-variant-numeric:tabular-nums">' + esc(sign(value)) + '</span>'
         + '</div>';
  };
  // BS 変動 → CF 影響への符号変換:
  //   資産系 (AR/棚卸/その他流動資産): BS増加 = CF▲ (資金圧迫) → -wc_*_change
  //   負債系 (AP/その他流動負債/その他固定負債): BS増加 = CF+ (資金調達) → +wc_*_change
  return '  <div style="font-size:11px;color:#6b7280;margin:10px 0 4px;font-weight:600;border-top:1px solid #e5e7eb;padding-top:8px">'
    + '💰 簡易キャッシュフロー (間接法)'
    + '<span style="font-weight:400;color:#9ca3af;margin-left:6px">期首=' + esc(cf.opening_ym) + ' / 確定月=' + esc(cf.closing_ym) + '</span>'
    + '</div>'
    + '<div style="background:#fafbfc;border:1px solid #e5e7eb;border-radius:6px;padding:8px 12px;margin-top:4px">'
    + row('利益 (経常利益累計)', cf.profit_base, { defKey: 'cf_profit_base' })
    + row('+ 減価償却費 (現金支出なき費用)', cf.depreciation, { defKey: 'cf_depreciation' })
    + row('= キャッシュ生成 小計', cf.cash_generation, { bold: true, borderTop: true, defKey: 'cf_cash_generation' })
    + '<div style="font-size:11px;color:#6b7280;margin:6px 0 2px">営業WC変動 (CF影響):</div>'
    + row('売掛金 (▲=未回収増)', -cf.wc_ar_change, { indent: true, defKey: 'cf_wc_ar' })
    + row('棚卸資産 (▲=過剰在庫増)', -cf.wc_inv_change, { indent: true, defKey: 'cf_wc_inv' })
    + row('買掛金 (+=支払繰延)', cf.wc_ap_change, { indent: true, defKey: 'cf_wc_ap' })
    // Phase 1d-5: その他流動 を 7分類に細分化 (mirror_mf_bs_subaccount_monthly_latest 由来)
    //   breakdown が無い場合 (mirror 未デプロイ) は旧 wc_other_ca_change/cl_change で総額表示
    + (cf.wc_breakdown
        ? ('<div style="font-size:11px;color:#6b7280;margin:6px 0 2px;padding-left:8px;border-left:2px solid #e5e7eb">　└ その他流動 内訳 <span style="color:#9ca3af;font-weight:400">(参考値、FY期初 ' + esc(cf.wc_breakdown.opening_ym) + ' 起点)</span></div>'
            + row('税系 (仮払/仮受/未払消費税)', cf.wc_breakdown.tax_consumption, { indent: true, defKey: 'wc_tax_consumption' })
            + (cf.wc_breakdown.tax_corporate !== 0 ? row('未払法人税等 変動', cf.wc_breakdown.tax_corporate, { indent: true, defKey: 'wc_tax_corporate' }) : '')
            + (cf.wc_breakdown.accrued_payable !== 0 ? row('未払金 (UPSIDER/給与/送料/クレカ等)', cf.wc_breakdown.accrued_payable, { indent: true, defKey: 'wc_accrued_payable' }) : '')
            + (cf.wc_breakdown.deposit_received !== 0 ? row('預り金 (住民税/社会保険/所得税)', cf.wc_breakdown.deposit_received, { indent: true, defKey: 'wc_deposit_received' }) : '')
            + (cf.wc_breakdown.prepay_advance !== 0 ? row('前払金/前払費用', cf.wc_breakdown.prepay_advance, { indent: true, defKey: 'wc_prepay_advance' }) : '')
            + (cf.wc_breakdown.provisional !== 0 ? row('仮払金/仮受金', cf.wc_breakdown.provisional, { indent: true, defKey: 'wc_provisional' }) : '')
            + (cf.wc_breakdown.other_residual !== 0 ? row('その他 (未分類)', cf.wc_breakdown.other_residual, { indent: true, defKey: 'wc_other_residual' }) : '')
            // 内訳の起点 (FY期初) と CF全体の起点 (期首前月末) は異なるため、内訳合計と CF その他流動 総額は一致しない
            + '<div style="font-size:10px;color:#9ca3af;padding-left:14px;margin-top:2px">'
                + '　※ 内訳は FY期初起点。CF全体は期首前月末起点 (' + esc(cf.opening_ym) + ') のため範囲が異なる'
              + '</div>')
        : (row('その他流動資産 (前払/仮払/立替 等)', -cf.wc_other_ca_change, { indent: true })
            + row('その他流動負債 (未払消費税/未払金/預り 等)', cf.wc_other_cl_change, { indent: true })))
    + row('▶ 営業CF (本業の現金生成力)', cf.operating_cf, { bold: true, borderTop: true, defKey: 'cf_operating' })
    + row('投資CF (固定資産取得相当・売却時は過小)', cf.investing_cf, { bold: true, defKey: 'cf_investing' })
    + row('財務CF (借入金+資本金+役員借入金/長期未払金 等 変動)', cf.financing_cf, { bold: true, defKey: 'cf_financing' })
    + row('= 現金純増減 (理論)', cf.theoretical_cash_change, { bold: true, borderTop: true, defKey: 'cf_theoretical' })
    + row('現金純増減 (実績、BS差分)', cf.actual_cash_change, { bold: true, defKey: 'cf_actual' })
    // 差額: 税金支払・為替差・資本取引差等。閾値超過 (max(¥10M, 実績×20%)) なら赤太字 ⚠
    + (cf.unexplained_severity === 'high'
        ? '<div style="display:flex;justify-content:space-between;font-size:12px;padding:2px 0;border-top:1px solid #e5e7eb;padding-top:4px;margin-top:2px;color:#dc2626;font-weight:600">'
            + '<span>差額 (未分類: 税金支払・為替差・資本取引差等) ⚠ 閾値超過' + helpIcon('cf_unexplained') + '</span>'
            + '<span style="font-variant-numeric:tabular-nums">' + esc(sign(cf.unexplained)) + '</span>'
          + '</div>'
        : row('差額 (未分類: 税金支払・為替差・資本取引差等)', cf.unexplained, { borderTop: true, defKey: 'cf_unexplained' }))
    + '</div>';
}

async function loadTimeseries() {
  const j = await fetchJson('/apps/exec-dashboard/api/timeseries?period=' + currentPeriod);
  if (!j.ok) return;
  renderCharts(j);
}

async function loadPl() {
  const target = document.getElementById('tab-pl');
  target.innerHTML = '<div class="loading">読み込み中...</div>';
  let j;
  try { j = await fetchJson('/apps/exec-dashboard/api/trial-balance/pl?period=' + currentPeriod); }
  catch (e) { target.innerHTML = '<div class="empty">通信エラー: ' + esc(e.message) + '</div>'; return; }
  if (!j.ok) { target.innerHTML = '<div class="empty">エラー: ' + esc(j.error || '') + '</div>'; return; }
  // 上: PL 箱図 (売上 ＝ 原価＋経費＋利益) → 中: アコーディオン式 PL → 下: 月次推移 (折りたたみ)
  target.innerHTML = ((j.pl_box && j.pl_tree) ? (renderPlBoxHtml(j.pl_box) + renderPlAccordionHtml(j.pl_tree)) : '')
    + '<details class="bs-trend-details"><summary>📅 月次推移 (試算表形式) を見る</summary><div id="pl-table-area"></div></details>';
  renderTrialBalance('pl-table-area', j, 'pl');
  // アコーディオン: 科目 (▶/▼) クリックで内訳を開閉
  document.querySelectorAll('#tab-pl .bsacc-acct[data-toggle]').forEach(row => {
    row.addEventListener('click', () => {
      const id = row.getAttribute('data-toggle');
      const panel = document.getElementById(id);
      if (!panel) return;
      const open = panel.style.display !== 'none';
      panel.style.display = open ? 'none' : '';
      const tri = row.querySelector('.bsacc-tri');
      if (tri) tri.textContent = open ? '▶' : '▼';
    });
  });
}

// PL 箱図 (左=売上、右=売上原価(上)/販管費(中)/営業利益(下)、高さ ∝ 金額、左右が釣り合い)
function renderPlBoxHtml(b) {
  const fmt = (v) => '¥' + fmtJpyComma(v);
  const pctOf = (v, whole) => whole ? '<span class="bsbox-pct">(' + (v / whole * 100).toFixed(1) + '%)</span>' : '';
  const total = b.sales || 0;
  // 右列: 上から 売上原価(変動費) / 販管費(固定費) / 営業利益(利益)。% は売上高に対する比率
  const rightSegs = [
    { label: '売上原価 (変動費)', note: '商品仕入・モール手数料・運賃・広告等', total: b.cogs || 0, bg: '#fde4ec', border: '#ec407a' },
    { label: '販管費 (固定費)', note: '役員報酬・給与・家賃・減価償却等', total: b.sgae || 0, bg: '#fff0df', border: '#f57c00' },
    { label: '営業利益', note: '売上 − 原価 − 経費', total: b.operating_income || 0, bg: '#e3f6e6', border: '#43a047' },
  ];
  const segHtml = (s) => ''
    + '<div class="bsbox" style="flex-grow:' + Math.max(1, Math.abs(s.total)) + ';background:' + s.bg + ';border-left-color:' + s.border + '">'
    + '<div class="bsbox-head"><span class="bsbox-label">' + esc(s.label) + '</span><span class="bsbox-amt">' + fmt(s.total) + ' ' + pctOf(s.total, total) + '</span></div>'
    + '<div class="bsbox-note">' + esc(s.note) + '</div></div>';
  // 利益の流れ (waterfall) を box の下に注記
  const wf = (b.profit_waterfall || []);
  const find = (n) => (wf.find(x => x.name === n) || {}).value || 0;
  const flowNote = '営業利益 ' + fmt(find('営業利益'))
    + ' ＋ 営業外収益 ' + fmt(find('営業外収益')) + ' − 営業外費用 ' + fmt(find('営業外費用'))
    + ' ＝ 経常利益 ' + fmt(find('経常利益'))
    + ' − 法人税等 ' + fmt(find('法人税等'))
    + ' ＝ 当期純利益 ' + fmt(b.net_income || 0);
  return ''
    + '<div class="big-bs-card">'
    + '  <h3>📊 損益計算書 ' + esc(b.period_label || '') + ' — 売上 ＝ 原価 ＋ 経費 ＋ 利益</h3>'
    + '  <div class="bsbox-grid">'
    + '    <div class="bsbox-col"><div class="bsbox-colhead">売上高 &nbsp;<strong>' + fmt(total) + '</strong></div>'
    + '      <div class="bsbox-stack"><div class="bsbox" style="flex-grow:1;background:#e8f0fe;border-left-color:#1e88e5"><div class="bsbox-head"><span class="bsbox-label">売上高</span><span class="bsbox-amt">' + fmt(total) + '</span></div><div class="bsbox-note">' + esc(b.period_label || '') + '</div></div></div></div>'
    + '    <div class="bsbox-col"><div class="bsbox-colhead">原価・経費・利益 &nbsp;<strong>' + fmt(total) + '</strong> <span class="sub">(限界利益(粗利) ' + fmt(b.gross_profit || 0) + ' = 販管費 ＋ 営業利益)</span></div>'
    + '      <div class="bsbox-stack">' + rightSegs.map(segHtml).join('') + '</div></div>'
    + '  </div>'
    + '  <div class="pl-flow-note">' + esc(flowNote) + '</div>'
    + '</div>';
}

// アコーディオン式 PL (売上高▶ / 売上原価▶ / 売上総利益 / 販管費▶ / 営業利益 / 営業外▶ / 経常利益 / 法人税等 / 当期純利益)
function renderPlAccordionHtml(tree) {
  const fmtAmt = (v) => '¥' + fmtJpyComma(v);
  let panelSeq = 0;
  const rowHtml = (node) => {
    if (node.subtotal) {
      return '<div class="bsacc-acct bsacc-subtotal"><span class="bsacc-tri" style="visibility:hidden">▶</span><span class="bsacc-name"><strong>' + esc(node.name) + '</strong></span><span class="bsacc-amt"><strong>' + fmtAmt(node.value) + '</strong></span></div>';
    }
    const hasItems = node.items && node.items.length > 0;
    if (!hasItems) {
      return '<div class="bsacc-acct"><span class="bsacc-tri" style="visibility:hidden">▶</span><span class="bsacc-name">' + esc(node.name) + '</span><span class="bsacc-amt">' + fmtAmt(node.value) + '</span></div>';
    }
    const pid = 'placc-p' + (++panelSeq);
    const sub = node.items.map(it => '<div class="bsacc-item"><span class="bsacc-name">' + esc(it.name) + '</span><span class="bsacc-amt">' + fmtAmt(it.value) + '</span></div>').join('');
    return '<div class="bsacc-acct" data-toggle="' + pid + '"><span class="bsacc-tri">▶</span><span class="bsacc-name">' + esc(node.name) + '</span><span class="bsacc-amt">' + fmtAmt(node.value) + '</span></div>'
      + '<div class="bsacc-subpanel" id="' + pid + '" style="display:none">' + sub + '</div>';
  };
  return ''
    + '<div class="bsacc-card">'
    + '  <h3>📋 損益計算書 (科目別) — 科目をクリックで内訳を表示</h3>'
    + '  <div class="bsacc-section" style="border-left-color:#cbd5e1">'
    + '    ' + (tree || []).map(rowHtml).join('')
    + '  </div>'
    + '</div>';
}

async function loadBs() {
  const target = document.getElementById('tab-bs');
  target.innerHTML = '<div class="loading">読み込み中...</div>';
  let j;
  try { j = await fetchJson('/apps/exec-dashboard/api/trial-balance/bs?period=' + currentPeriod); }
  catch (e) { target.innerHTML = '<div class="empty">通信エラー: ' + esc(e.message) + '</div>'; return; }
  if (!j.ok) { target.innerHTML = '<div class="empty">エラー: ' + esc(j.error || '') + '</div>'; return; }
  const lb = j.latest_balance;
  // 上: 「5つの箱」概観 → 中: アコーディオン式 貸借対照表 (科目→補助科目) → 下: 月次推移 (折りたたみ)
  target.innerHTML = (lb ? (renderBsBoxDiagramHtml(lb) + renderBsAccordionHtml(lb)) : '')
    + '<details class="bs-trend-details"><summary>📅 月次推移 (試算表形式) を見る</summary><div id="bs-table-area"></div></details>';
  renderTrialBalance('bs-table-area', j, 'bs');
  // アコーディオン: 科目 (▶/▼) クリックで補助科目を開閉
  document.querySelectorAll('#tab-bs .bsacc-acct[data-toggle]').forEach(row => {
    row.addEventListener('click', () => {
      const id = row.getAttribute('data-toggle');
      const panel = document.getElementById(id);
      if (!panel) return;
      const open = panel.style.display !== 'none';
      panel.style.display = open ? 'none' : '';
      const tri = row.querySelector('.bsacc-tri');
      if (tri) tri.textContent = open ? '▶' : '▼';
    });
  });
}

// 「5つの箱」貸借対照表 図解 (純 HTML/CSS、高さ ∝ 金額) — 概観のみ、細目はアコーディオンで
function renderBsBoxDiagramHtml(lb) {
  const fmtBox = (v) => '¥' + fmtJpyComma(v);
  const denom = lb.total_asset || (lb.total_liab + lb.net_assets) || 0;  // 資産の部合計 = 負債純資産合計
  const pctOf = (v) => denom ? '<span class="bsbox-pct">(' + (v / denom * 100).toFixed(1) + '%)</span>' : '';
  const sideBoxes = (side) => (lb.boxes || []).filter(b => b.side === side);
  const boxHtml = (b) => ''
    + '<div class="bsbox" style="flex-grow:' + Math.max(1, b.total) + ';background:' + b.bg + ';border-left-color:' + b.border + '">'
    + '<div class="bsbox-head"><span class="bsbox-label">' + esc(b.label) + '</span><span class="bsbox-amt">' + fmtBox(b.total) + ' ' + pctOf(b.total) + '</span></div>'
    + '<div class="bsbox-note">' + esc(b.note || '') + '</div>'
    + '</div>';
  const leftCol = sideBoxes('asset').map(boxHtml).join('');
  const rightCol = sideBoxes('liab').map(boxHtml).join('');
  return ''
    + '<div class="big-bs-card">'
    + '  <h3>📊 貸借対照表 ' + esc(lb.month) + ' 時点 — 左列 ＝ 右列 で釣り合い</h3>'
    + '  <div class="bsbox-grid">'
    + '    <div class="bsbox-col"><div class="bsbox-colhead">資産の部 &nbsp;<strong>' + fmtBox(lb.total_asset) + '</strong></div><div class="bsbox-stack">' + leftCol + '</div></div>'
    + '    <div class="bsbox-col"><div class="bsbox-colhead">負債・純資産の部 &nbsp;<strong>' + fmtBox(lb.total_liab + lb.net_assets) + '</strong> <span class="sub">(負債 ' + fmtBox(lb.total_liab) + ' ＋ 純資産 ' + fmtBox(lb.net_assets) + ')</span></div><div class="bsbox-stack">' + rightCol + '</div></div>'
    + '  </div>'
    + '</div>';
}

// アコーディオン式 貸借対照表 (部 → 流動/固定 → 科目 ▶ → 補助科目)
function renderBsAccordionHtml(lb) {
  const fmtAmt = (v) => '¥' + fmtJpyComma(v);
  let panelSeq = 0;
  const acctRow = (a) => {
    const hasItems = a.items && a.items.length > 0;
    if (!hasItems) {
      return '<div class="bsacc-acct"><span class="bsacc-tri" style="visibility:hidden">▶</span><span class="bsacc-name">' + esc(a.name) + '</span><span class="bsacc-amt">' + fmtAmt(a.value) + '</span></div>';
    }
    const pid = 'bsacc-p' + (++panelSeq);
    const sub = a.items.map(it => '<div class="bsacc-item"><span class="bsacc-name">' + esc(it.name) + '</span><span class="bsacc-amt">' + fmtAmt(it.value) + '</span></div>').join('');
    return '<div class="bsacc-acct" data-toggle="' + pid + '"><span class="bsacc-tri">▶</span><span class="bsacc-name">' + esc(a.name) + '</span><span class="bsacc-amt">' + fmtAmt(a.value) + '</span></div>'
      + '<div class="bsacc-subpanel" id="' + pid + '" style="display:none">' + sub + '</div>';
  };
  const sectionBlock = (s) => ''
    + '<div class="bsacc-section" style="border-left-color:' + (s.border || '#ccc') + '">'
    + '  <div class="bsacc-section-head" style="background:' + (s.bg || '#f3f4f6') + '"><span class="bsacc-name">' + esc(s.name) + '</span><span class="bsacc-amt">' + fmtAmt(s.value) + '</span></div>'
    + '  ' + (s.accounts || []).map(acctRow).join('')
    + '</div>';
  const groupBlock = (g) => ''
    + '<div class="bsacc-group">'
    + '  <div class="bsacc-group-head"><span class="bsacc-name">' + esc(g.name) + '</span><span class="bsacc-amt">' + fmtAmt(g.value) + '</span></div>'
    + '  ' + (g.sections || []).map(sectionBlock).join('')
    + '</div>';
  return ''
    + '<div class="bsacc-card">'
    + '  <h3>📋 貸借対照表 (科目別) — 科目をクリックで補助科目を表示</h3>'
    + '  ' + (lb.tree || []).map(groupBlock).join('')
    + '  <div class="bsacc-bottom"><span class="bsacc-name">' + esc((lb.bottom_total && lb.bottom_total.name) || '負債・純資産の部 合計') + '</span><span class="bsacc-amt">' + fmtAmt((lb.bottom_total && lb.bottom_total.value) || 0) + '</span></div>'
    + '</div>';
}

async function loadDetails() {
  document.getElementById('tab-details').innerHTML = '<div class="loading">読み込み中...</div>';
  const j = await fetchJson('/apps/exec-dashboard/api/details');
  if (!j.ok) { document.getElementById('tab-details').innerHTML = '<div class="empty">エラー: ' + j.error + '</div>'; return; }
  renderDetails(j);
  detailsLoaded = true;
}

async function loadAll() {
  // 期間切替時: timeseries + pl は再取得、bs/details はタブ開いた時のみ
  await Promise.all([loadTimeseries(), loadPl()]);
  // 開いてる他タブを refresh
  if (document.getElementById('tab-bs').classList.contains('active')) await loadBs();
  detailsLoaded = false;
  if (document.getElementById('tab-details').classList.contains('active')) await loadDetails();
}

