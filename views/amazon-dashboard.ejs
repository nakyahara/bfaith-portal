      <td>${{ safe: '<span class="pill safe">🟢 余裕</span>', edge: '<span class="pill edge">🟡 限界</span>', bleed: '<span class="pill bleed">🔴 広告赤字</span>', no_data: '<span class="pill no_data">データ不足</span>' }[s.verdict]}</td>
      <td class="num">${fmtPct(s.tacos_pct)}</td>
      <td class="num ${signClass(s.profit_after_ads)}">${fmtYen(s.profit_after_ads)}</td>
    </tr>`).join('') + '</tbody>';

    document.getElementById('ad-camp-table').innerHTML = `<thead><tr>
      <th class="noclick">キャンペーン</th><th class="noclick">状態</th><th class="noclick">広告費</th><th class="noclick">売上(14d)</th>
      <th class="noclick">ACOS</th><th class="noclick">クリック</th><th class="noclick">CTR</th><th class="noclick">CPC</th>
    </tr></thead><tbody>` + data.campaigns.slice(0, 100).map(c => `<tr>
      <td class="name-cell">${esc(c.campaign_name || c.campaign_id)}</td>
      <td>${esc(c.status || '')}</td>
      <td class="num">${fmtYen(c.ad_cost)}</td>
      <td class="num">${fmtYen(c.ad_sales_14d)}</td>
      <td class="num">${fmtPct(c.acos_pct)}</td>
      <td class="num">${(c.clicks || 0).toLocaleString()}</td>
      <td class="num">${c.ctr_pct === null ? '−' : c.ctr_pct + '%'}</td>
      <td class="num">${c.cpc === null ? '−' : '¥' + c.cpc}</td>
    </tr>`).join('') + '</tbody>';
  } catch (e) {
    document.getElementById('ad-totals').innerHTML = `<div class="warn-note">取得失敗: ${esc(e.message)} — 広告mirror同期 (PR-A) がまだ流れていない可能性があります。</div>`;
  }
}

// ============================================================
// 📦 在庫
// ============================================================
async function loadInventory() {
  try {
    const data = await getJSON(API + '/inventory');
    if (!data.as_of) {
      document.getElementById('inv-summary').innerHTML = '<div class="warn-note">在庫スナップショットがありません。</div>';
      return;
    }
    const s = data.summary;
    let feeTiles = '';
    try {
      const fees = await getJSON(`${API}/account-fees?months=2`);
      const latest = fees.months[fees.months.length - 1];
      const prev = fees.months.length > 1 ? fees.months[fees.months.length - 2] : null;
      const pick = (m, k) => (m && m.fees[k]) || 0;
      if (latest) feeTiles = `
        <div class="tile"><h3>在庫保管料 <span class="pbadge settled">確定</span></h3>
          <div class="row"><span>${latest.ym}</span><span class="v">${fmtYen(pick(latest, 'storage'))}</span></div>
          ${prev ? `<div class="row"><span>${prev.ym}</span><span class="v">${fmtYen(pick(prev, 'storage'))}</span></div>` : ''}</div>
        <div class="tile"><h3>長期在庫追加手数料 (LTSF)</h3>
          <div class="row"><span>${latest.ym}</span><span class="v ${pick(latest, 'long_term_storage') > 100000 ? 'negv' : ''}">${fmtYen(pick(latest, 'long_term_storage'))}</span></div>
          ${prev ? `<div class="row"><span>${prev.ym}</span><span class="v">${fmtYen(pick(prev, 'long_term_storage'))}</span></div>` : ''}
          <div class="note">271日超の在庫に課金。詳細月次は利益分析タブ</div></div>`;
    } catch (e) { /* フィー未同期でも在庫表示は継続 */ }
    document.getElementById('inv-summary').innerHTML = `
      <div class="tile"><h3>在庫金額 (FBA+入荷待ち)</h3><div class="row hero"><span></span><span class="v">${fmtJPY(s.total_value)}</span></div><div class="note">${data.as_of} 時点 / ${s.sku_count} 商品</div></div>
      <div class="tile"><h3>残30日未満 (要補充検討)</h3><div class="row hero"><span></span><span class="v ${s.low_cover_count > 0 ? 'negv' : ''}">${s.low_cover_count} 商品</span></div></div>
      <div class="tile"><h3>直近30日販売なし</h3><div class="row hero"><span></span><span class="v">${s.no_velocity_count} 商品</span></div></div>` + feeTiles;
    document.getElementById('inv-table').innerHTML = `<thead><tr>
      <th class="noclick">商品コード</th><th class="noclick">商品名</th><th class="noclick">FBA在庫</th><th class="noclick">入荷待ち</th>
      <th class="noclick">30日販売</th><th class="noclick">在庫残日数</th><th class="noclick">在庫金額</th><th class="noclick">最終販売日</th>
    </tr></thead><tbody>` + data.rows.map(r => `<tr>
      <td>${esc(r.ne_code)}</td><td class="name-cell">${esc(r.product_name || '')}</td>
      <td class="num">${r.fba_qty.toLocaleString()}</td><td class="num">${r.inbound_qty.toLocaleString()}</td>
      <td class="num">${(r.sales_30d || 0).toLocaleString()}</td>
      <td class="num ${r.days_of_cover !== null && r.days_of_cover < 30 ? 'negv' : ''}">${r.days_of_cover === null ? '−' : r.days_of_cover + '日'}</td>
      <td class="num">${fmtYen(r.stock_value)}</td>
      <td>${esc(r.last_sold_date || '−')}</td>
    </tr>`).join('') + '</tbody>';
  } catch (e) {
    document.getElementById('inv-summary').innerHTML = `<div class="warn-note">取得失敗: ${esc(e.message)}</div>`;
  }
}

// ============================================================
// 🔍 診断
// ============================================================
async function loadDiagnosis() {
  try {
    const d = await getJSON(API + '/diagnosis');
    document.getElementById('diag-meta').textContent = `基準月: ${d.base_month} (前月比較: ${d.prev_month}) / 生成: ${new Date(d.generated_at).toLocaleString('ja-JP')}`;
    const li = (rows, fmt) => rows.length === 0 ? '<div class="note">該当なし 🎉</div>'
      : `<div class="table-scroll"><table class="data"><tbody>${rows.map(fmt).join('')}</tbody></table></div>`;
    document.getElementById('diag-cards').innerHTML = `
      <div class="diag-card"><h4>💪 稼ぎ頭 (利益上位、A群 ${d.earners.length}件) — 在庫切れ防止最優先</h4>
        ${li(d.earners, r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num pos">${fmtYen(r.profit_after_ads)}</td></tr>`)}</div>
      <div class="diag-card"><h4>🩸 赤字SKU (広告後赤字 ${d.settings.loss_months}ヶ月連続、${d.loss_skus.length}件) — 値上げ/広告停止/撤退判断</h4>
        ${li(d.loss_skus, r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num negv">${fmtYen(r.profit_cur)}</td><td class="num negv">${fmtYen(r.profit_prev)}</td></tr>`)}</div>
      <div class="diag-card"><h4>📉 悪化SKU (利益率 前月比−${d.settings.margin_drop_pt}pt超、${d.worsened.length}件)</h4>
        ${li(d.worsened, r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">${r.margin_prev_pct}%→${r.margin_cur_pct}%</td><td class="num negv">−${r.drop_pt}pt</td></tr>`)}</div>
      <div class="diag-card"><h4>🔥 広告垂れ流し (直近${d.settings.ad_bleed_days}日合算ACOS>損益分岐、${d.ad_bleed.length}件)</h4>
        ${li(d.ad_bleed, r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">ACOS ${r.acos_pct}% > 分岐 ${r.breakeven_acos_pct}%</td><td class="num">${fmtYen(r.ad_cost)}</td></tr>`)}</div>
      <div class="diag-card"><h4>💤 死に筋 (販売0×${d.settings.dead_stock_days}日+在庫あり、${d.dead_stock.length}件) — <a href="/apps/profit-analysis" target="_blank">撤退判断タブへ</a></h4>
        ${li(d.dead_stock, r => `<tr><td>${esc(r.ne_code)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">${r.qty}個</td><td class="num">${fmtYen(r.stock_value)}</td><td>${esc(r.last_sold_date || '販売実績なし')}</td></tr>`)}</div>
      <div class="diag-card"><h4>⚠️ 価格ミス疑い (実売単価<標準売価×${d.settings.price_miss_ratio}、${d.price_miss.length}件) — Seller Central要確認</h4>
        ${li(d.price_miss, r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">実売 ${fmtYen(r.avg_price_incl)}</td><td class="num">標準 ${fmtYen(r.standard_price)}</td></tr>`)}</div>
      <div class="diag-card"><h4>🚱 出したのに売れてない (発売180日以内×直近30日販売≦1×在庫あり、${(d.launch_flop || []).length}件) — 露出/価格/画像の見直し候補</h4>
        ${li(d.launch_flop || [], r => `<tr><td>${esc(r.ne_code)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">${r.qty}個 / ${fmtYen(r.stock_value)}</td><td>発売 ${esc(r.launch_date || '?')}</td><td class="num">30日販売 ${r.sales_30d}</td></tr>`)}</div>
      <div class="diag-card"><h4>💱 カート価格ズレ (乖離≥${d.settings.price_gap_pct}%、${(d.price_gap || []).length}件) ${d.price_snapshot_date ? `<span class="note">${d.price_snapshot_date} 時点</span>` : '<span class="pill no_data">価格データ未取得 (翌朝から)</span>'}</h4>
        ${li(d.price_gap || [], r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">自分 ${fmtYen(r.my_price)}</td><td class="num">カート ${fmtYen(r.buybox_price)}</td><td class="num ${r.direction === 'higher' ? 'negv' : ''}">${r.direction === 'higher' ? '▲高い' : '▼安い'} ${Math.abs(r.gap_pct)}%</td></tr>`)}</div>
      <div class="diag-card"><h4>🛒 カート非保有 (他社がカート取得中×直近30日売上あり、${(d.buybox_lost || []).length}件) — 価格/在庫/配送スピード確認</h4>
        ${li(d.buybox_lost || [], r => `<tr><td>${esc(r.seller_sku)}</td><td class="name-cell">${esc(r.product_name || '')}</td><td class="num">自分 ${r.my_price != null ? fmtYen(r.my_price) : '出品なし'}</td><td class="num">カート ${fmtYen(r.buybox_price)}</td><td class="num">30日売上 ${fmtYen(r.revenue_30d)}</td></tr>`)}</div>`;
  } catch (e) {
    document.getElementById('diag-cards').innerHTML = `<div class="warn-note">取得失敗: ${esc(e.message)}</div>`;
  }
}

// ============================================================
// ⚙️ 設定
// ============================================================
const SETTING_LABELS = {
  acos_safe_ratio: 'ACOS余裕判定比率 (損益分岐×N)', loss_months: '赤字SKU連続月数',
  margin_drop_pt: '悪化SKU閾値 (pt)', ad_bleed_days: '広告垂れ流し判定日数',
  dead_stock_days: '死に筋判定日数', price_miss_ratio: '価格ミス判定比率',
  abc_a_pct: 'ABC: A群 累積%', abc_b_pct: 'ABC: B群 累積%', new_product_days: '新商品バッジ日数',
  price_gap_pct: 'カート価格ズレ閾値 (%)',
};
async function loadSettings() {
  await refreshExpenses();
  const s = await getJSON(API + '/settings');
  document.getElementById('settings-form').innerHTML = Object.entries(SETTING_LABELS).map(([k, label]) =>
    `<div><label>${label}</label><input type="text" data-setting="${k}" value="${s[k]}"></div>`).join('');
  document.getElementById('settings-save').onclick = async () => {
    const patch = {};
    document.querySelectorAll('[data-setting]').forEach(el => { patch[el.dataset.setting] = el.value; });
    await fetch(API + '/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(patch) });
    document.getElementById('settings-status').textContent = '保存しました ✓';
    setTimeout(() => document.getElementById('settings-status').textContent = '', 3000);
  };
  document.getElementById('exp-add').onclick = async () => {
    const body = {
      name: document.getElementById('exp-name').value,
      expense_type: document.getElementById('exp-type').value,
      amount_jpy: document.getElementById('exp-amount').value,
      month_from: document.getElementById('exp-from').value,
      month_to: document.getElementById('exp-to').value || null,
      memo: document.getElementById('exp-memo').value,
    };
    const res = await fetch(API + '/expenses', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (!res.ok) { const j = await res.json().catch(() => ({})); alert('追加失敗: ' + (j.error || res.status)); return; }
    document.getElementById('exp-name').value = ''; document.getElementById('exp-amount').value = '';
    await refreshExpenses();
  };
}
async function refreshExpenses() {
  const data = await getJSON(API + '/expenses');
  const typeLabel = { fixed_monthly: '毎月定額', oneoff: '単発', sales_pct: '売上比%' };
  document.getElementById('exp-table').innerHTML = `<thead><tr>
    <th class="noclick">名称</th><th class="noclick">種別</th><th class="noclick">金額/%</th><th class="noclick">期間</th><th class="noclick">メモ</th><th class="noclick"></th>
  </tr></thead><tbody>` + (data.items.length === 0 ? '<tr><td colspan="6" class="note">登録なし</td></tr>' :
    data.items.map(r => `<tr>
      <td>${esc(r.name)}</td><td>${typeLabel[r.expense_type]}</td>
      <td class="num">${r.expense_type === 'sales_pct' ? r.amount_jpy + '%' : fmtYen(r.amount_jpy)}</td>
      <td>${esc(r.month_from)}${r.expense_type === 'oneoff' ? '' : ' 〜 ' + esc(r.month_to || '継続中')}</td>
      <td>${esc(r.memo || '')}</td>
      <td><button class="btn danger" onclick="deleteExpenseRow(${r.id})">削除</button></td>
    </tr>`).join('')) + '</tbody>';
}
async function deleteExpenseRow(id) {
  if (!confirm('この経費を削除しますか?')) return;
  await fetch(`${API}/expenses/${id}`, { method: 'DELETE' });
  await refreshExpenses();
}

// 初期ロード
loadTab('overview');
</script>
</body>
</html>
