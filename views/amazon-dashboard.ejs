function renderWaterfall(canvasId, wf) {
  // floating bar でウォーターフォール: 各 step の [開始, 終了] を累積計算
  let cum = 0;
  const bars = [], colors = [], labels = [];
  for (const s of wf.steps) {
    labels.push(s.label);
    if (s.kind === 'total' && s.key === 'revenue') { bars.push([0, s.amount]); cum = s.amount; colors.push(WF_COLORS.total); }
    else if (s.kind === 'subtotal' || s.kind === 'total') { bars.push([0, s.amount]); cum = s.amount; colors.push(s.kind === 'total' ? WF_COLORS.total : WF_COLORS.subtotal); }
    else if (s.kind === 'income') { bars.push([cum, cum + s.amount]); cum += s.amount; colors.push(WF_COLORS.income); }
    else { bars.push([cum - s.amount, cum]); cum -= s.amount; colors.push(WF_COLORS.cost); }
  }
  mkChart(canvasId, {
    type: 'bar',
    data: { labels, datasets: [{ data: bars, backgroundColor: colors, borderSkipped: false }] },
    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: {
        label: (c) => {
          const s = wf.steps[c.dataIndex];
          const v = s.kind === 'cost' ? -s.amount : s.amount;
          return `${s.label}: ${fmtJPY(s.kind === 'cost' || s.kind === 'income' ? s.amount * (s.kind === 'cost' ? -1 : 1) : v)}${s.precision === 'allocated' ? ' (按分込)' : ''}`;
        } } } },
      scales: { x: { ticks: { callback: v => fmtJPY(v) } } } },
  });
}
