async function loadTrend() {
  try {
    // 月ごとの売上・利益の変化を追える月次粒度 (12ヶ月/今年)、90日は週次、それ以外は日次
    const gran = ['12m', 'this_year'].includes(ovPreset) ? 'month' : ovPreset === '90d' ? 'week' : 'day';
    const data = await getJSON(`${API}/trend?preset=${ovPreset}&granularity=${gran}`);
    const labels = data.rows.map(r => r.bucket);
    const pendingIdx = data.rows.findIndex(r => (r.bucket_start || r.bucket) >= data.settlement_pending_from);
    const shade = {
      id: 'pendingShade',
      beforeDraw(chart) {
        if (pendingIdx < 0) return;
        const { ctx, chartArea, scales } = chart;
        const x = scales.x.getPixelForValue(Math.max(0, pendingIdx - 0.5));
        ctx.save();
        ctx.fillStyle = 'rgba(251, 191, 36, 0.10)';
        ctx.fillRect(x, chartArea.top, chartArea.right - x, chartArea.bottom - chartArea.top);
        ctx.restore();
      }
    };
    mkChart('chart-trend', {
      type: 'bar',
      data: { labels, datasets: [
        { label: '確定売上(税抜)', data: data.rows.map(r => r.revenue_excl), backgroundColor: '#93c5fd', yAxisID: 'y', order: 3 },
        { label: '速報売上(税込)', data: data.rows.map(r => r.flash_sales_incl), type: 'line', borderColor: '#2563eb', borderDash: [4, 3], pointRadius: 0, yAxisID: 'y', order: 2 },
        { label: '広告後利益', data: data.rows.map(r => r.profit_after_ads), type: 'line', borderColor: '#047857', pointRadius: 0, yAxisID: 'y', order: 1 },
        { label: '利益率%', data: data.rows.map(r => r.margin_pct), type: 'line', borderColor: '#f59e0b', pointRadius: 0, yAxisID: 'y1', order: 0 },
      ]},
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: { y: { position: 'left', ticks: { callback: v => fmtJPY(v) } }, y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: v => v + '%' } } },
        plugins: { tooltip: { callbacks: { label: c => c.dataset.label + ': ' + (c.dataset.yAxisID === 'y1' ? fmtPct(c.parsed.y) : fmtJPY(c.parsed.y)) } } } },
      plugins: [shade],
    });
    mkChart('chart-profit-layers', {
      type: 'line',
      data: { labels, datasets: [
        { label: '補填込み粗利(広告前)', data: data.rows.map(r => r.profit_before_ads), borderColor: '#7c3aed', backgroundColor: 'rgba(124,58,237,0.08)', fill: true, pointRadius: 0 },
        { label: '広告後利益', data: data.rows.map(r => r.profit_after_ads), borderColor: '#047857', backgroundColor: 'rgba(4,120,87,0.08)', fill: true, pointRadius: 0 },
      ]},
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: { y: { ticks: { callback: v => fmtJPY(v) } } },
        plugins: { tooltip: { callbacks: { label: c => c.dataset.label + ': ' + fmtJPY(c.parsed.y) } } } },
    });
    // TACOS 月次 (広告タブと同データ、ここでは ads API から)
    const ads = await getJSON(`${API}/ads?preset=this_month`);
    const tt = ads.tacos_trend;
    mkChart('chart-tacos', {
      type: 'bar',
      data: { labels: tt.map(r => r.ym), datasets: [
        { label: '広告費', data: tt.map(r => r.ad_cost), backgroundColor: '#fca5a5', yAxisID: 'y' },
        { label: 'TACOS%', data: tt.map(r => r.tacos_pct), type: 'line', borderColor: '#dc2626', yAxisID: 'y1' },
      ]},
      options: { responsive: true, maintainAspectRatio: false,
        scales: { y: { ticks: { callback: v => fmtJPY(v) } }, y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: v => v + '%' } } } },
    });
  } catch (e) { console.error(e); }
}

