<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Amazon統合ダッシュボード - B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
          integrity="sha384-9nhczxUqK87bcKHh20fSQcTGD4qq5GhayNYSYWqwBkINBhOfQLg/P5HG5lF1urn4"
          crossorigin="anonymous"></script>
  <style>
    body { background: #f5f7fa; }
    .container { max-width: 1500px; margin: 0 auto; padding: 16px 20px; }
    .header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 12px; }
    .header-row h2 { margin: 0; }
    .back-link { font-size: 13px; color: #2563eb; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .meta-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 14px; margin-bottom: 12px; font-size: 12px; color: #555; display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

    /* 精度バッジ (要件 §9-2: 確定/速報/推定を常時区別) */
    .pbadge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; vertical-align: middle; }
    .pbadge.settled { background: #d1fae5; color: #065f46; }
    .pbadge.flash { background: #dbeafe; color: #1e40af; }
    .pbadge.est { background: #fef3c7; color: #92400e; }
    .pbadge.alloc { background: #ede9fe; color: #5b21b6; }

    /* タブ */
    .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
    .tab-btn { background: #fff; border: 1px solid #e5e7eb; border-bottom: none; border-radius: 6px 6px 0 0; padding: 10px 16px; cursor: pointer; font-size: 13px; color: #555; }
    .tab-btn.active { background: #2563eb; color: white; border-color: #2563eb; }
    .tab-content { background: white; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 8px; padding: 16px; min-height: 400px; }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* 期間切替 */
    .period-switcher { display: inline-flex; gap: 4px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; flex-wrap: wrap; }
    .period-switcher button { background: transparent; border: none; padding: 6px 10px; font-size: 12px; cursor: pointer; border-radius: 4px; color: #555; }
    .period-switcher button.active { background: #2563eb; color: white; }
    .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }
    .toolbar input[type=text] { border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 10px; font-size: 12px; }

    /* タイル (Sellerboard 方式) */
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .tile { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); cursor: pointer; }
    .tile:hover { border-color: #93c5fd; }
    .tile h3 { margin: 0 0 8px; font-size: 14px; color: #374151; }
    .tile .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #4b5563; }
    .tile .row .v { font-variant-numeric: tabular-nums; font-weight: 600; color: #111; }
    .tile .row.hero { border-top: 1px dashed #e5e7eb; margin-top: 6px; padding-top: 8px; }
    .tile .row.hero .v { font-size: 20px; font-weight: 700; }
    .pos { color: #047857 !important; } .negv { color: #dc2626 !important; }

    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .chart-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; }
    .chart-card h3 { margin: 0 0 8px; font-size: 13px; color: #374151; font-weight: 600; }
    .chart-wrap { position: relative; height: 300px; }
    .chart-wrap.tall { height: 420px; }
    @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }

    /* テーブル */
    table.data { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    table.data th, table.data td { border: 1px solid #e5e7eb; padding: 5px 8px; }
    table.data th { background: #f9fafb; font-weight: 600; color: #374151; text-align: left; white-space: nowrap; cursor: pointer; user-select: none; }
    table.data th.noclick { cursor: default; }
    table.data td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    table.data tr.flag-loss td { background: #fef2f2; }
    table.data tr.flag-ad_bleed td { background: #fff7ed; }
    .table-scroll { overflow-x: auto; }
    .sku-link { color: #2563eb; cursor: pointer; text-decoration: none; }
    .sku-link:hover { text-decoration: underline; }
    .name-cell { max-width: 340px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .note { font-size: 11.5px; color: #6b7280; margin: 6px 0; }
    .warn-note { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 8px 12px; font-size: 12px; color: #92400e; border-radius: 4px; margin-bottom: 12px; }
    .section-h { font-size: 14px; font-weight: 700; color: #1f2937; margin: 18px 0 8px; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .pill.safe { background: #d1fae5; color: #065f46; }
    .pill.edge { background: #fef3c7; color: #92400e; }
    .pill.bleed { background: #fee2e2; color: #991b1b; }
    .pill.no_data { background: #f3f4f6; color: #6b7280; }
    .pill.A { background: #dbeafe; color: #1e40af; } .pill.B { background: #e0e7ff; color: #4338ca; } .pill.C { background: #f3f4f6; color: #6b7280; }
    .pill.new { background: #fce7f3; color: #9d174d; }
    .diag-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 1100px) { .diag-grid { grid-template-columns: 1fr; } }
    .diag-card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 14px; }
    .diag-card h4 { margin: 0 0 8px; font-size: 13.5px; }
    .spark { vertical-align: middle; }
    .btn { background: #2563eb; color: #fff; border: none; border-radius: 6px; padding: 6px 14px; font-size: 12px; cursor: pointer; }
    .btn.secondary { background: #6b7280; }
    .btn.danger { background: #dc2626; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; margin-bottom: 10px; }
    .form-grid label { font-size: 11px; color: #6b7280; display: block; }
    .form-grid input, .form-grid select { width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 8px; font-size: 12px; box-sizing: border-box; }
    dialog { border: 1px solid #e5e7eb; border-radius: 10px; max-width: 900px; width: 90%; padding: 18px; }
    dialog::backdrop { background: rgba(0,0,0,0.35); }
    .loading { color: #6b7280; font-size: 13px; padding: 30px; text-align: center; }
  </style>
  <link rel="stylesheet" href="/mobile.css">
</head>
<body>
  <div class="container">
    <div class="header-row">
      <h2>🛒 Amazon統合ダッシュボード</h2>
      <div style="display:flex; gap:14px; align-items:center;">
        <span style="font-size:12px; color:#6b7280;"><%= displayName || username || '' %></span>
        <a class="back-link" href="/">← ポータルへ戻る</a>
      </div>
    </div>
    <div class="meta-bar">
      <span>精度: <span class="pbadge settled">確定</span>=settlement <span class="pbadge flash">速報</span>=受注ベース(税込) <span class="pbadge est">推定</span>=速報売上−手数料参考値−最新原価−広告費 <span class="pbadge alloc">按分</span>=未配賦広告費の配賦値</span>
      <span id="meta-updated"></span>
    </div>

    <div class="tabs" id="tabs">
      <button class="tab-btn active" data-tab="overview">🏠 概要</button>
      <button class="tab-btn" data-tab="bestsellers">🏆 売れ筋</button>
      <button class="tab-btn" data-tab="profit">💰 利益分析</button>
      <button class="tab-btn" data-tab="ads">📣 広告</button>
      <button class="tab-btn" data-tab="inventory">📦 在庫</button>
      <button class="tab-btn" data-tab="diagnosis">🔍 診断</button>
      <button class="tab-btn" data-tab="recovery">🛡️ 回収・異常</button>
      <button class="tab-btn" data-tab="settings">⚙️ 設定</button>
    </div>

    <div class="tab-content">
      <!-- 🏠 概要 -->
      <div class="tab-pane active" id="pane-overview">
        <div id="ov-tiles" class="tile-grid"><div class="loading">読み込み中…</div></div>
        <div class="toolbar">
          <div class="period-switcher" id="ov-period"></div>
          <span class="note">直近14日はsettlement確定待ち (グラフ網掛け)。この期間の利益は<span class="pbadge est">推定</span>です。</span>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>売上 × 利益 × 利益率 <span class="pbadge settled">確定</span><span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap tall"><canvas id="chart-trend"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>利益2層の推移 (広告前粗利 / 広告後利益) <span class="pbadge settled">確定</span></h3>
            <div class="chart-wrap"><canvas id="chart-profit-layers"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>TACOS推移 (広告費÷確定売上、月次)</h3>
            <div class="chart-wrap"><canvas id="chart-tacos"></canvas></div>
          </div>
        </div>
      </div>

      <!-- 🏆 売れ筋 -->
      <div class="tab-pane" id="pane-bestsellers">
        <div class="toolbar">
          <div class="period-switcher" id="bs-period"></div>
          <div class="period-switcher" id="bs-axis">
            <button data-axis="sales" class="active">売上</button>
            <button data-axis="units">数量</button>
            <button data-axis="profit">広告後利益</button>
          </div>
        </div>
        <div id="bs-abc" class="note"></div>
        <div class="charts-grid">
          <div class="chart-card">
            <h3>曜日別 平均販売数 <span class="pbadge flash">速報</span></h3>
            <div class="chart-wrap" style="height:200px;"><canvas id="chart-weekday"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>急上昇 / 急落 TOP10 (販売数 前期比)</h3>
            <div id="bs-movers" style="font-size:12px; max-height:200px; overflow-y:auto;"></div>
          </div>
        </div>
        <div class="section-h">売れ筋ランキング <span class="pbadge settled">確定</span> <span class="note" id="bs-note"></span></div>
        <div class="table-scroll"><table class="data" id="bs-table"></table></div>
      </div>

      <!-- 💰 利益分析 -->
      <div class="tab-pane" id="pane-profit">
        <div class="toolbar">
          <div class="period-switcher" id="pf-period"></div>
          <input type="text" id="pf-search" placeholder="SKU / 商品名 / ASIN 検索">
          <button class="btn secondary" id="pf-csv">CSV出力</button>
        </div>
        <div class="charts-grid">
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>利益ウォーターフォール <span class="pbadge settled">確定</span> <span id="pf-wf-title"></span> <span class="note">※アカウント単位フィー(保管料等)はSKUに紐付かないため下のチャートで別掲</span></h3>
            <div class="chart-wrap tall"><canvas id="chart-waterfall"></canvas></div>
          </div>
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h3>Amazonアカウントフィー月次 <span class="pbadge settled">確定</span> <span class="note">SKU利益に含まれない控除 — 月タイルの「最終利益」で反映済み</span></h3>
            <div class="chart-wrap"><canvas id="chart-account-fees"></canvas></div>
          </div>
        </div>
        <div class="note" id="pf-adnote"></div>
        <div class="section-h">SKU別利益 <span class="pbadge settled">確定</span>+<span class="pbadge alloc">按分広告</span> — 行色: <span style="background:#fff7ed; padding:1px 6px;">橙=粗利黒字が広告で赤字転落</span> / <span style="background:#fef2f2; padding:1px 6px;">赤=広告前から赤字</span></div>
        <div class="table-scroll"><table class="data" id="pf-table"></table></div>
        <div class="toolbar" style="justify-content:center;"><button class="btn secondary" id="pf-more" style="display:none;">さらに表示</button></div>
      </div>

      <!-- 📣 広告 -->
      <div class="tab-pane" id="pane-ads">
        <div class="toolbar"><div class="period-switcher" id="ad-period"></div></div>
        <div class="tile-grid" id="ad-totals"></div>
        <div class="charts-grid">
          <div class="chart-card">
            <h3>TACOS × 売上の4象限 (SKU別、バブル=広告費)</h3>
            <div class="chart-wrap"><canvas id="chart-quadrant"></canvas></div>
          </div>
          <div class="chart-card">
            <h3>TACOS月次トレンド (下降=オーガニック健全化)</h3>
            <div class="chart-wrap"><canvas id="chart-tacos2"></canvas></div>
          </div>
        </div>
        <div class="section-h">SKU別 広告効率 — 損益分岐ACOSとの比較 <span class="pbadge est">損益分岐=推定</span></div>
        <div class="table-scroll"><table class="data" id="ad-sku-table"></table></div>
        <div class="section-h">キャンペーン別</div>
        <div class="table-scroll"><table class="data" id="ad-camp-table"></table></div>
      </div>

      <!-- 📦 在庫 -->
      <div class="tab-pane" id="pane-inventory">
        <div class="note">FBA在庫 (倉庫+入荷待ち) と直近30日販売からの在庫残日数。発注・納品計画は <a href="/apps/fba-replenishment" target="_blank">FBA在庫補充ツール</a> へ。</div>
        <div class="tile-grid" id="inv-summary"></div>
        <div class="table-scroll"><table class="data" id="inv-table"></table></div>
      </div>

      <!-- 🔍 診断 -->
      <div class="tab-pane" id="pane-diagnosis">
        <div class="note" id="diag-meta"></div>
        <div class="diag-grid" id="diag-cards"><div class="loading">読み込み中…</div></div>
      </div>

      <!-- 🛡️ 回収・異常 (将来Phase) -->
      <div class="tab-pane" id="pane-recovery">
        <div class="warn-note">準備中 (Phase 2)。ここに実装予定: ①FBA紛失・破損の未補填検知 ②返金済み未返送 (45日) 検知 ③手数料過大請求検知 ④GChatアラート履歴。<br>
        必要データ (Inventory Ledger / 返品レポート / 補填レポート) の取得追加は要件定義書 §2.3 参照。</div>
      </div>

      <!-- ⚙️ 設定 -->
      <div class="tab-pane" id="pane-settings">
        <div class="section-h">カスタム経費 (月タイルと最終利益に反映)</div>
        <div class="form-grid" id="exp-form">
          <div><label>名称</label><input type="text" id="exp-name" placeholder="例: ツール利用料"></div>
          <div><label>種別</label><select id="exp-type">
            <option value="fixed_monthly">毎月定額</option>
            <option value="oneoff">単発 (開始月のみ)</option>
            <option value="sales_pct">売上比% (確定売上×%)</option>
          </select></div>
          <div><label>金額(円) / %値</label><input type="text" id="exp-amount" placeholder="5280"></div>
          <div><label>開始月</label><input type="text" id="exp-from" placeholder="2026-07"></div>
          <div><label>終了月 (任意)</label><input type="text" id="exp-to" placeholder=""></div>
          <div><label>メモ</label><input type="text" id="exp-memo" placeholder=""></div>
          <div style="align-self:end;"><button class="btn" id="exp-add">追加</button></div>
        </div>
        <div class="table-scroll"><table class="data" id="exp-table"></table></div>

        <div class="section-h">診断閾値</div>
        <div class="form-grid" id="settings-form"></div>
        <button class="btn" id="settings-save">閾値を保存</button>
        <span class="note" id="settings-status"></span>
      </div>
    </div>
  </div>

  <!-- SKU詳細ダイアログ -->
  <dialog id="sku-dialog">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
      <h3 style="margin:0; font-size:15px;" id="sku-dialog-title"></h3>
      <button class="btn secondary" onclick="document.getElementById('sku-dialog').close()">閉じる</button>
    </div>
    <div class="chart-wrap"><canvas id="chart-sku-waterfall"></canvas></div>
  </dialog>

<script>
// ============================================================
// 共通 util
// ============================================================
const API = '/apps/amazon-dashboard/api/v1';
const charts = {};
function destroyChart(id) { if (charts[id]) { charts[id].destroy(); delete charts[id]; } }
function mkChart(id, cfg) { destroyChart(id); charts[id] = new Chart(document.getElementById(id).getContext('2d'), cfg); return charts[id]; }

// 金額: 経営向け日本語単位 (億/万) — feedback_japanese_currency_units
function fmtJPY(n) {
  if (n === null || n === undefined) return '−';
  const neg = n < 0; const a = Math.abs(Math.round(n));
  let s;
  if (a >= 100000000) s = (a / 100000000).toFixed(2).replace(/\.?0+$/, '') + '億円';
  else if (a >= 10000) s = Math.round(a / 10000).toLocaleString() + '万円';
  else s = '¥' + a.toLocaleString();
  return neg ? '−' + s : s;
}
function fmtYen(n) { if (n === null || n === undefined) return '−'; return '¥' + Math.round(n).toLocaleString(); }
function fmtPct(n) { return (n === null || n === undefined) ? '−' : n + '%'; }
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function getJSON(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}
function signClass(n) { return n < 0 ? 'negv' : n > 0 ? 'pos' : ''; }

// 期間プリセット (Helium 10 方式)
const PRESETS = [
  ['7d', '7日'], ['14d', '14日'], ['30d', '30日'], ['90d', '90日'],
  ['this_month', '今月'], ['last_month', '先月'], ['12m', '12ヶ月'], ['this_year', '今年'],
];
function mountPeriodSwitcher(elId, defaultPreset, onChange) {
  const el = document.getElementById(elId);
  el.innerHTML = PRESETS.map(([k, label]) =>
    `<button data-preset="${k}" class="${k === defaultPreset ? 'active' : ''}">${label}</button>`).join('');
  el.addEventListener('click', (e) => {
    const btn = e.target.closest('button'); if (!btn) return;
    el.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    onChange(btn.dataset.preset);
  });
}

// ============================================================
// タブ制御 (lazy load)
// ============================================================
const loaded = {};
document.getElementById('tabs').addEventListener('click', (e) => {
  const btn = e.target.closest('.tab-btn'); if (!btn) return;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('pane-' + btn.dataset.tab).classList.add('active');
  loadTab(btn.dataset.tab);
});
function loadTab(tab) {
  if (loaded[tab]) return;
  loaded[tab] = true;
  ({ overview: loadOverview, bestsellers: loadBestsellers, profit: loadProfit,
     ads: loadAds, inventory: loadInventory, diagnosis: loadDiagnosis, settings: loadSettings }[tab] || (() => {}))();
}

// ============================================================
// 🏠 概要
// ============================================================
let ovPreset = '30d';
async function loadOverview() {
  try {
    const data = await getJSON(API + '/overview');
    document.getElementById('meta-updated').textContent = '更新: ' + new Date(data.generated_at).toLocaleString('ja-JP');
    const tiles = data.tiles.map(t => {
      const monthExtra = t.custom_expenses !== undefined ? `
        <div class="row"><span>アカウントフィー <span class="note">(保管/長期/返送等)</span></span><span class="v">−${fmtYen(t.account_fees || 0)}</span></div>
        <div class="row"><span>自社経費</span><span class="v">−${fmtYen(t.custom_expenses)}</span></div>
        <div class="row"><span>最終利益 <span class="pbadge settled">確定</span></span><span class="v ${signClass(t.settled_profit_final)}">${fmtJPY(t.settled_profit_final)}</span></div>` : '';
      return `<div class="tile">
        <h3>${t.label} <span class="note">(${t.from}${t.from !== t.to ? '〜' + t.to : ''})</span></h3>
        <div class="row"><span>売上 <span class="pbadge flash">速報</span></span><span class="v">${fmtJPY(t.flash_sales_incl)}</span></div>
        <div class="row"><span>販売数 / 注文</span><span class="v">${t.flash_units.toLocaleString()} / ${t.flash_orders.toLocaleString()}</span></div>
        <div class="row"><span>広告費</span><span class="v">${fmtYen(t.ad_cost)}</span></div>
