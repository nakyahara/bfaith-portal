  }
  function closeDrawer() {
    if (!drawerOpen()) return;
    $('dr-bg').classList.remove('on'); openFp = null; openC = null; $('detail').innerHTML = '';
    refreshDirty();
    if (drawerFrom && drawerFrom.focus && document.contains(drawerFrom)) drawerFrom.focus();
    else { const a = document.querySelector('#rows a.rowlink'); if (a) a.focus(); }
  }
  $('dr-x').onclick = closeDrawer;
  $('dr-bg').addEventListener('click', (e) => { if (e.target === $('dr-bg')) closeDrawer(); });

  // ─────────── キー (窓の中だけで Tab が回る・Esc で閉じる・Space で行を選ぶ) ───────────
  window.addEventListener('keydown', (e) => {
    const shellBox = document.querySelector('#leave-bg.on') || document.querySelector('#palette-bg.on');
    if (shellBox) return;   // 全体から探す・離れるときの確認は me-shell.js が扱う
    if (drawerOpen()) {
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); closeDrawer(); return; }
      if (e.key === 'Tab') {
        const f = [...$('drawer').querySelectorAll('button, input, a[href], select, textarea, summary')].filter((x) => !x.disabled && x.offsetParent !== null);
        if (!f.length) return;
        if (!$('drawer').contains(document.activeElement)) { e.preventDefault(); f[0].focus(); return; }
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
        return;
      }
      // 窓が開いている間は、後ろの一覧のキー (/・↑↓) を動かさない
      if (e.key === '/' || e.key === 'ArrowUp' || e.key === 'ArrowDown') { if (!/^(input|textarea|select)$/i.test(e.target.tagName)) e.stopPropagation(); }
      return;
    }
    const a = document.activeElement;
    if (CAN && e.key === ' ' && a && a.classList && a.classList.contains('rowlink')) { e.preventDefault(); const i = Number(a.dataset.open); pick(i, !picked.has(items[i].fingerprint)); }
  }, true);

  // ─────────── 離れるときの確認 (me-shell.js): 数えるのは まだ決めていない入力 (直す値・メモ) だけ。選んだ行は数えない ───────────
  ME.dirty = () => {
    const out = [];
    const note = $('note'); if (note && note.value.trim()) out.push('まとめて決めるメモ「' + note.value.trim().slice(0, 40) + '」');
    if (drawerOpen() && openC) {
      const dv = $('d-val'), dn = $('d-note');
      if (dv && dv.value.trim() && !$('d-val-wrap').hidden) out.push(openC.code_norm + ' ' + colName(openC) + ' の直す値「' + dv.value.trim().slice(0, 40) + '」');
      if (dn && dn.value.trim()) out.push(openC.code_norm + ' ' + colName(openC) + ' のメモ');
    }
    return { n: out.length, items: out, impacts: [] };
  };
  ME.review = () => { const t = drawerOpen() ? ($('d-val') && $('d-val').value.trim() ? $('d-val') : $('d-note')) : $('note'); if (t) t.focus(); };
  function refreshDirty() { if (ME.setUnsaved) ME.setUnsaved(ME.dirty().n); }

  async function refresh() { await loadSummary(); await load(); loadCsv(); }
  refresh().catch((e) => showRes('err', '読み込めませんでした: ' + e.message));
})();
</script>
</body>
</html>
