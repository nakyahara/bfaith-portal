<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .st-wrap { max-width: 1100px; margin: 0 auto; padding: 12px 16px; }
    .st-box { background: #f8f9fa; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px; }
    .st-box h2 { font-size: 1.0em; margin: 0 0 10px; }
    .st-box p.hint { font-size: 0.85em; color: #495057; margin: 0 0 10px; line-height: 1.6; }
    table.st { width: 100%; border-collapse: collapse; font-size: 0.86em; }
    table.st th, table.st td { border-bottom: 1px solid #dee2e6; padding: 5px 6px; text-align: left; vertical-align: middle; }
    table.st th { background: #f1f3f5; white-space: nowrap; }
    table.st input, table.st select { width: 100%; box-sizing: border-box; padding: 4px 5px; font-size: 0.95em; border: 1px solid #ced4da; border-radius: 4px; }
    table.st input.dirty { background: #fff9db; }
    table.st tr.inactive td { color: #adb5bd; }
    table.st tr.inactive input, table.st tr.inactive select { color: #adb5bd; }
    .btn-sm { padding: 3px 10px; font-size: 0.85em; cursor: pointer; white-space: nowrap; }
    .btn-sm:disabled { opacity: 0.35; cursor: default; }
    td.sort-col { width: 72px; }
    .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .row input, .row select { padding: 6px; }
    .msg { font-size: 0.9em; } .msg.err { color: #c92a2a; } .msg.ok { color: #2b8a3e; }
    .tbox { max-height: 70vh; overflow: auto; border: 1px solid #dee2e6; background: #fff; }
    thead th { position: sticky; top: 0; box-shadow: inset 0 -1px 0 #dee2e6; }
    code { background: #e9ecef; padding: 1px 5px; border-radius: 4px; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">👥 スタッフマスタ</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/" class="btn-logout">ダッシュボード</a>
    </div>
  </header>

  <div class="st-wrap">
    <div class="st-box">
      <p class="hint">
        「人」の正本です。各アプリ (入荷受付チェック・ピッキング・梱包 …) の名前タップはここから引きます。
        <b>スタッフ管理番号</b> は 0001〜 と 入社日 (YYYYMMDD) が混在する運用のまま持ちます。
        <b>短い表記</b> は名前タップに出す名前 (空なら正式表記)。退職は削除でなく「無効」(履歴が参照するため)。
        将来の勤怠・シフトはこの表の <code>id</code> に紐づけます。
        <% if (exportEnabled) { %>他マシン向けの読み取り API (<code>/apps/staff/export</code>) は有効です。<% } else { %>他マシン向け読み取り API は <code>STAFF_EXPORT_TOKEN</code> 未設定のため無効です。<% } %>
      </p>
    </div>

    <div class="st-box">
      <h2>➕ 追加</h2>
      <div class="row">
        <input type="text" id="n_no" placeholder="管理番号 (例 20260901)" style="width:150px" maxlength="20">
        <input type="text" id="n_name" placeholder="名前 (正式表記)" style="width:160px" maxlength="40">
        <input type="text" id="n_short" placeholder="短い表記 (任意)" style="width:120px" maxlength="40">
        <select id="n_kind"><option value="">区分</option><% for (const k of kinds) { %><option value="<%= k %>"><%= kindLabels[k] %></option><% } %></select>
        <input type="date" id="n_joined" title="入社日">
        <input type="email" id="n_email" placeholder="ポータルmail (任意)" style="width:200px">
        <button id="addBtn" type="button">追加</button>
        <span id="addMsg" class="msg"></span>
      </div>
    </div>

    <div class="st-box">
      <h2>一覧 (<%= staff.filter(s => s.active).length %> 名 有効 / 全 <%= staff.length %> 名) <span class="msg" id="listMsg"></span></h2>
      <div class="tbox">
      <table class="st">
        <thead><tr><th>並び</th><th>管理番号</th><th>名前</th><th>短い表記</th><th>よみ</th><th>区分</th><th>ポータルmail</th><th>入社日</th><th>退職日</th><th>メモ</th><th></th></tr></thead>
        <tbody>
          <% for (const s of staff) { %>
            <tr class="<%= s.active ? '' : 'inactive' %>" data-id="<%= s.id %>" data-version="<%= s.version %>">
              <td class="sort-col"><input name="sort" type="number" value="<%= s.sort %>"></td>
              <td style="width:110px"><input name="staff_no" value="<%= s.staff_no %>" maxlength="20"></td>
              <td style="width:140px"><input name="display_name" value="<%= s.display_name %>" maxlength="40"></td>
              <td style="width:110px"><input name="short_name" value="<%= s.short_name || '' %>" maxlength="40"></td>
              <td style="width:120px"><input name="kana" value="<%= s.kana || '' %>"></td>
              <td style="width:130px"><select name="kind"><option value="">-</option><% for (const k of kinds) { %><option value="<%= k %>" <%= s.kind === k ? 'selected' : '' %>><%= kindLabels[k] %></option><% } %></select></td>
              <td style="width:180px"><input name="portal_email" value="<%= s.portal_email || '' %>"></td>
              <td style="width:130px"><input name="joined_on" type="date" value="<%= s.joined_on || '' %>"></td>
              <td style="width:130px"><input name="left_on" type="date" value="<%= s.left_on || '' %>"></td>
              <td><input name="note" value="<%= s.note || '' %>"></td>
              <td style="white-space:nowrap">
                <button class="btn-sm btn-save" type="button" disabled>保存</button>
                <button class="btn-sm btn-active" type="button" data-active="<%= s.active ? 0 : 1 %>"><%= s.active ? '無効' : '有効に' %></button>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <script>
    const BASE = <%- JSON.stringify(base) %>;
    const $ = s => document.querySelector(s);
    const postJson = (url, body) => fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(async r => ({ status: r.status, j: await r.json().catch(() => ({})) }));
    const msg = (el, ok, text) => { el.className = 'msg ' + (ok ? 'ok' : 'err'); el.textContent = text; };

    $('#addBtn').addEventListener('click', async () => {
      const body = { staff_no: $('#n_no').value, display_name: $('#n_name').value, short_name: $('#n_short').value, kind: $('#n_kind').value, joined_on: $('#n_joined').value, portal_email: $('#n_email').value };
      const { status, j } = await postJson(BASE + '/api/staff', body);
      if (j.ok) location.reload(); else msg($('#addMsg'), false, j.message || ('HTTP ' + status));
    });

    // 行ごとの編集: 入力があった行だけ保存を有効化 (未編集行の誤保存を防ぐ)
    document.querySelectorAll('table.st tbody tr').forEach(tr => {
      const save = tr.querySelector('.btn-save');
      tr.querySelectorAll('input, select').forEach(el => {
        el.dataset.orig = el.value;
        el.addEventListener('input', () => { el.classList.toggle('dirty', el.value !== el.dataset.orig); save.disabled = ![...tr.querySelectorAll('input, select')].some(x => x.value !== x.dataset.orig); });
      });
      save.addEventListener('click', async () => {
        const fields = {};
        tr.querySelectorAll('input, select').forEach(el => { if (el.value !== el.dataset.orig) fields[el.name] = el.value; });
        const { status, j } = await postJson(BASE + '/api/staff/' + tr.dataset.id, { fields, expect_version: Number(tr.dataset.version) });
        if (j.ok) {
          tr.dataset.version = j.staff.version;
          tr.querySelectorAll('input, select').forEach(el => { el.dataset.orig = el.value; el.classList.remove('dirty'); });
          save.disabled = true; msg($('#listMsg'), true, j.staff.display_name + ' を保存しました');
        } else if (j.error === 'conflict') { msg($('#listMsg'), false, '他の人が先に変更しました。再読込します'); setTimeout(() => location.reload(), 800); }
        else msg($('#listMsg'), false, j.message || ('HTTP ' + status));
      });
      tr.querySelector('.btn-active').addEventListener('click', async () => {
        // 未保存の入力がある行は状態変更させない (reload で編集が黙って消えるのを防ぐ — Codex R4 Medium)
        if (!save.disabled) { msg($('#listMsg'), false, 'この行に未保存の変更があります。先に「保存」してください'); return; }
        const active = tr.querySelector('.btn-active').dataset.active === '1';
        const name = tr.querySelector('input[name=display_name]').value;
        if (!confirm((active ? '有効に戻します: ' : '無効にします (退職・契約終了。削除はしません): ') + name)) return;
        const { status, j } = await postJson(BASE + '/api/staff/' + tr.dataset.id + '/active', { active, expect_version: Number(tr.dataset.version) });
        if (j.ok) location.reload();
        else if (j.error === 'conflict') { msg($('#listMsg'), false, '他の人が先に変更しました。再読込します'); setTimeout(() => location.reload(), 800); }
        else msg($('#listMsg'), false, j.message || ('HTTP ' + status));
      });
    });
  </script>
</body>
</html>
