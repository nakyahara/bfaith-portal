<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .pk-wrap { max-width: 720px; margin: 0 auto; padding: 10px 12px 40px; }
    .muted { color: #868e96; font-size: 0.85em; }
    .card { background: #fff; border: 1px solid #dee2e6; border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }
    .card.repick { border-left: 6px solid #e03131; }
    .card.return { border-left: 6px solid #1971c2; }
    .row1 { display: flex; gap: 12px; align-items: center; }
    .timg { flex: 0 0 auto; width: 84px; height: 84px; border: 1px solid #e9ecef; border-radius: 8px;
      background: #f8f9fa center/contain no-repeat; display: flex; align-items: center; justify-content: center; color: #ced4da; font-size: 24px; }
    .tmain { flex: 1 1 auto; min-width: 0; }
    .kind { font-weight: 800; font-size: 1.0em; }
    .kind.repick { color: #e03131; } .kind.return { color: #1971c2; }
    .loc { font-family: ui-monospace, Consolas, monospace; font-size: 1.5em; font-weight: 800; }
    .pname { font-size: 1.0em; font-weight: 700; line-height: 1.3; }
    .qty { font-size: 1.6em; font-weight: 800; white-space: nowrap; }
    .actions { display: flex; gap: 8px; margin-top: 10px; }
    .actions button { flex: 1; padding: 14px 6px; font-size: 1.05em; font-weight: 700; border-radius: 10px; border: none; cursor: pointer; }
    .b-claim { background: #1971c2; color: #fff; }
    .b-done { background: #2b8a3e; color: #fff; }
    .b-na { background: #f1f3f5; color: #c92a2a; border: 1px solid #dee2e6 !important; }
    .pk-empty { color: #868e96; padding: 40px 0; text-align: center; }
    .claimed-tag { background: #fff3bf; border-radius: 4px; padding: 1px 8px; font-size: 0.85em; }
    #workerPick { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 50; align-items: flex-end; justify-content: center; }
    .sheet { background: #fff; border-radius: 16px 16px 0 0; padding: 18px 16px calc(18px + env(safe-area-inset-bottom)); width: 100%; max-width: 520px; }
    .sheet h3 { margin: 0 0 12px; font-size: 1.1em; }
    .sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .worker-opt { padding: 18px 8px; font-size: 1.15em; font-weight: 600; border: 1px solid #ced4da; border-radius: 12px; background: #f8f9fa; cursor: pointer; }
    .sheet-cancel { margin-top: 12px; width: 100%; padding: 12px; border: none; background: none; color: #868e96; font-size: 1em; cursor: pointer; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">🔴 再ピック・棚戻し</span>
    </div>
    <div class="header-right">
      <a href="/apps/picking/" class="btn-logout">← バッチ一覧</a>
    </div>
  </header>

  <div class="pk-wrap">
    <div class="muted" style="margin-bottom:8px"><%= tasks.length %> 件の依頼 (梱包現場から)。60秒ごとに自動更新</div>
    <% if (tasks.length === 0) { %><div class="pk-empty">依頼はありません 🎉</div><% } %>

    <% for (const t of tasks) { %>
      <div class="card <%= t.kind %>" data-id="<%= t.id %>">
        <div class="row1">
          <div class="timg" style="<%= t.imageUrl ? `background-image:url('${t.imageUrl}')` : '' %>"><%= t.imageUrl ? '' : '📦' %></div>
          <div class="tmain">
            <div class="kind <%= t.kind %>"><%= t.kind === 'repick' ? '🔴 再ピック (取ってくる)' : '↩ 棚戻し (棚へ戻す)' %></div>
            <% if (t.locationLabel) { %><div class="loc"><%= t.locationLabel %><%= t.kind === 'return' ? ' (参考)' : '' %></div><% } %>
            <div class="pname"><%= t.product_name || t.sku %></div>
            <div class="muted"><%= t.sku %> / 依頼元: <%= t.folder_name || t.batch_folder || '-' %><%= t.slip_seq ? ` #${t.slip_seq}` : '' %> (<%= t.requested_by %>)</div>
            <% if (t.status === 'claimed') { %><span class="claimed-tag">対応中: <%= t.claimed_by %></span><% } %>
          </div>
          <div class="qty"><%= t.req_qty %>個</div>
        </div>
        <div class="actions">
          <% if (t.status === 'requested') { %>
            <button class="b-claim" data-act="claim">対応する</button>
            <% if (t.kind === 'repick') { %><button class="b-na" data-act="unavailable">在庫なし</button><% } %>
          <% } else { %>
            <button class="b-done" data-act="fulfill"><%= t.kind === 'repick' ? '梱包台へ持って行った' : '棚に戻した' %></button>
            <% if (t.kind === 'repick') { %><button class="b-na" data-act="unavailable">在庫なし</button><% } %>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <div id="workerPick">
    <div class="sheet">
      <h3>だれが対応しますか？</h3>
      <div class="sheet-grid">
        <% for (const w of workers) { %>
          <button class="worker-opt" data-code="<%= w.code %>" data-name="<%= w.name %>"><%= w.name %></button>
        <% } %>
      </div>
      <button class="sheet-cancel" id="wpCancel" type="button">やめる</button>
    </div>
  </div>

  <script>
    const $ = (s) => document.querySelector(s);
    let pendingAction = null;   // { id, act }
    let workerCode = localStorage.getItem('pk_task_worker') || '';

    async function send(id, act, code) {
      const res = await fetch(`/apps/picking/api/tasks/${id}/${act}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ worker_code: code }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) { alert(body.error || `エラー (${res.status})`); return; }
      location.reload();
    }

    function withWorker(id, act) {
      pendingAction = { id, act };
      $('#workerPick').style.display = 'flex';
    }

    document.querySelectorAll('.actions button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.closest('.card').dataset.id;
        const act = btn.dataset.act;
        if (act === 'unavailable' && !confirm('在庫なし (取れない) として管理者へ通知します。よろしいですか?')) return;
        withWorker(id, act);   // 毎回名前タップ (picking 本体と同じ運用)
      });
    });
    document.querySelectorAll('.worker-opt').forEach((btn) => {
      btn.addEventListener('click', () => {
        workerCode = btn.dataset.code;
        localStorage.setItem('pk_task_worker', workerCode);
        $('#workerPick').style.display = 'none';
        if (pendingAction) send(pendingAction.id, pendingAction.act, workerCode);
      });
    });
    $('#wpCancel').addEventListener('click', () => { $('#workerPick').style.display = 'none'; pendingAction = null; });

    setTimeout(() => location.reload(), 60_000);
  </script>
</body>
</html>
