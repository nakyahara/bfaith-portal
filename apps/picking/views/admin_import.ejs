<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .pk-wrap { max-width: 900px; margin: 0 auto; padding: 12px 16px; }
    .pk-form { background: #f8f9fa; border-radius: 8px; padding: 14px 16px; margin-bottom: 16px; }
    .pk-form h2 { font-size: 1.0em; margin: 0 0 10px; }
    .pk-row { margin-bottom: 10px; }
    .pk-row label { display: block; font-size: 0.82em; color: #495057; margin-bottom: 3px; }
    .pk-row input[type=file], .pk-row input[type=text], .pk-row select { width: 100%; max-width: 480px; padding: 6px; box-sizing: border-box; }
    .pk-actions { margin-top: 12px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .pk-actions button { padding: 8px 22px; font-size: 1em; cursor: pointer; }
    .pk-actions button:disabled { opacity: 0.5; cursor: default; }
    #confirmBtn { background: #2b8a3e; color: #fff; border: 1px solid #2b8a3e; border-radius: 4px; }
    .pk-msg { font-size: 0.9em; white-space: pre-wrap; }
    .pk-msg.err { color: #c92a2a; } .pk-msg.ok { color: #2b8a3e; }
    .pk-preview { display: none; }
    .pk-sum { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 10px 14px;
      margin-bottom: 12px; display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 0.92em; }
    table.pk-lines { width: 100%; border-collapse: collapse; font-size: 0.88em; }
    table.pk-lines th, table.pk-lines td { border-bottom: 1px solid #dee2e6; padding: 5px 8px; text-align: left; }
    table.pk-lines th { background: #f1f3f5; }
    table.pk-lines td.num { text-align: right; }
    td.loc { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; white-space: nowrap; }
    .pk-overwrite { display: none; background: #fff3bf; border-radius: 6px; padding: 8px 12px; font-size: 0.9em; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">📥 CS03002 取込</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/apps/picking/" class="btn-logout">← バッチ一覧</a>
      <a href="/" class="btn-logout">ダッシュボード</a>
    </div>
  </header>

  <div class="pk-wrap">
    <div class="pk-form">
      <h2>📂 Driveから取り込む (出荷_no フォルダ)</h2>
      <div class="pk-actions" style="margin-top:0">
        <button id="driveListBtn" type="button">ファイル一覧を更新</button>
        <span id="driveMsg" class="pk-msg"></span>
      </div>
      <table class="pk-lines" id="driveTable" style="display:none; margin-top:10px">
        <thead><tr><th>フォルダ</th><th>ファイル名</th><th>更新日時</th><th></th></tr></thead>
        <tbody id="driveBody"></tbody>
      </table>
    </div>

    <div class="pk-form">
      <h2>💻 ファイルをアップロードして取り込む</h2>
      <div class="pk-row">
        <label>ファイル (カンタン引当で出力したピッキングリストCSV・Shift-JIS)</label>
        <input type="file" id="file" accept=".csv">
      </div>
      <div class="pk-actions">
        <button id="previewBtn" type="button">解析してプレビュー</button>
        <span id="msg" class="pk-msg"></span>
      </div>
    </div>

    <div class="pk-preview" id="preview">
      <div class="pk-sum" id="summary"></div>
      <div class="pk-form">
        <div class="pk-row">
          <label>引当分類 (推定候補が先頭。違っていたら選び直す・自由入力も可)</label>
          <input type="text" id="hikiateClass" list="patternList" autocomplete="off">
          <datalist id="patternList"></datalist>
        </div>
        <div class="pk-row">
          <label>出荷フォルダ名 (任意。例: 出荷_03)</label>
          <input type="text" id="folderName" placeholder="出荷_XX">
        </div>
        <div class="pk-overwrite" id="overwriteBox">
          ⚠ <span id="overwriteMsg"></span><br>
          <label><input type="checkbox" id="overwriteChk"> 上書きして取り込み直す</label>
        </div>
        <div class="pk-actions">
          <button id="confirmBtn" type="button">この内容で取り込む</button>
          <span id="confirmMsg" class="pk-msg"></span>
        </div>
      </div>
      <h3 style="font-size:1em">明細プレビュー (ロケーション順)</h3>
      <table class="pk-lines">
        <thead><tr><th>#</th><th>ロケーション</th><th>商品ID</th><th>商品名</th><th>数量</th></tr></thead>
        <tbody id="lineBody"></tbody>
      </table>
    </div>
  </div>

  <script>
    <%# JSON内の "<" を "\u003c" にエスケープし、script要素からのコンテキスト脱出を防ぐ
        (現状はサーバー固定定数だが、将来DB管理化しても安全なように) %>
    const ALL_PATTERNS = <%- JSON.stringify(patternNames).replace(/</g, '\\u003c') %>;
    const $ = (id) => document.getElementById(id);
    // 取込元: {type:'file', file} (アップロード) | {type:'drive', fileId} (出荷_noフォルダ)
    let currentSource = null;

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function post(source, mode, extra = {}) {
      let res;
      if (source.type === 'drive') {
        res = await fetch('/apps/picking/admin/import/drive', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ file_id: source.fileId, parent_name: source.parentName || '', mode, ...extra }),
        });
      } else {
        const fd = new FormData();
        fd.append('file', source.file);
        fd.append('mode', mode);
        for (const [k, v] of Object.entries(extra)) fd.append(k, v);
        res = await fetch('/apps/picking/admin/import', { method: 'POST', body: fd });
      }
      const body = await res.json().catch(() => ({ error: '応答の解析に失敗しました' }));
      return { status: res.status, body };
    }

    function fillDatalist(suggestions) {
      const names = [...suggestions, ...ALL_PATTERNS.filter((p) => !suggestions.includes(p))];
      $('patternList').innerHTML = names.map((n) => `<option value="${esc(n)}">`).join('');
    }

    function showPreview(body) {
      $('summary').innerHTML =
        `<span><b>${esc(body.tbLabel || body.tbNo)}</b></span>` +
        (body.filename ? `<span>📂 ${esc(body.filename)}</span>` : '') +
        `<span>出荷指示日: ${esc(body.instructDate)}</span>` +
        `<span>${esc(body.invoiceSoft)} / ${esc(body.deliveryMethod)}</span>` +
        `<span>構成: <b>${esc(body.composition)}</b></span>` +
        `<span>明細 ${body.lineCount} / 伝票 ${body.slipCount} / 数量 ${body.totalQty}</span>` +
        (body.dateWarning ? `<span style="color:#e8590c; font-weight:600">⚠ ${esc(body.dateWarning)}</span>` : '');
      fillDatalist(body.suggestions || []);
      $('hikiateClass').value = (body.suggestions || [])[0] || '';
      // 前回プレビューの値を残さない (残すと別ファイルに古い出荷_XXが付いたまま確定できてしまう)
      $('folderName').value = body.folderNameSuggestion || '';
      $('lineBody').innerHTML = body.lines.map((l, i) =>
        `<tr><td class="num">${i + 1}</td><td class="loc">${esc(l.locationLabel)}</td>` +
        `<td>${esc(l.sku)}</td><td>${esc(l.productName)}</td><td class="num">${l.qty}</td></tr>`).join('');
      $('overwriteBox').style.display = 'none';
      $('overwriteChk').checked = false;
      $('confirmMsg').textContent = '';
      $('preview').style.display = 'block';
    }

    // プレビュー要求ごとにトークンを振り、最新の応答だけを画面と currentSource に反映する
    // (連打・並行プレビューで「画面はA・確定対象はB」に食い違うのを防ぐ)
    let previewToken = 0;
    async function doPreview(source, msgEl) {
      const token = ++previewToken;
      msgEl.textContent = '解析中…'; msgEl.className = 'pk-msg';
      const { status, body } = await post(source, 'preview');
      if (token !== previewToken) return;   // 後から始まったプレビューが優先
      if (status !== 200) {
        msgEl.textContent = body.error || `エラー (${status})`; msgEl.className = 'pk-msg err';
        currentSource = null;
        $('preview').style.display = 'none';
        return;
      }
      msgEl.textContent = '解析OK'; msgEl.className = 'pk-msg ok';
      currentSource = source;   // 画面に表示した内容とだけ結び付ける
      showPreview(body);
    }

    $('previewBtn').addEventListener('click', async () => {
      const f = $('file').files[0];
      if (!f) { $('msg').textContent = 'ファイルを選択してください'; $('msg').className = 'pk-msg err'; return; }
      $('previewBtn').disabled = true;
      try { await doPreview({ type: 'file', file: f }, $('msg')); } finally { $('previewBtn').disabled = false; }
    });

    // ── Drive一覧 ──
    $('driveListBtn').addEventListener('click', async () => {
      $('driveMsg').textContent = '取得中…'; $('driveMsg').className = 'pk-msg';
      $('driveListBtn').disabled = true;
      try {
        const res = await fetch('/apps/picking/admin/import/drive-files');
        const body = await res.json().catch(() => ({ error: '応答の解析に失敗しました' }));
        if (!res.ok) {
          $('driveMsg').textContent = body.error || `エラー (${res.status})`; $('driveMsg').className = 'pk-msg err';
          return;
        }
        const files = body.files || [];
        $('driveMsg').textContent = files.length === 0 ? 'CSVがありません' : `${files.length} 件`;
        $('driveBody').innerHTML = files.map((f) =>
          `<tr><td>${esc(f.parent_name || '')}</td><td>${esc(f.filename)}</td><td>${esc(f.modified_time_jst || '')}</td>` +
          `<td><button type="button" class="btn-drive-preview" data-id="${esc(f.file_id)}" data-parent="${esc(f.parent_name || '')}">プレビュー</button></td></tr>`).join('');
        $('driveTable').style.display = files.length > 0 ? 'table' : 'none';
        document.querySelectorAll('.btn-drive-preview').forEach((btn) => {
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
              await doPreview({ type: 'drive', fileId: btn.dataset.id, parentName: btn.dataset.parent }, $('driveMsg'));
            } finally { btn.disabled = false; }
          });
        });
      } finally {
        $('driveListBtn').disabled = false;
      }
    });

    $('confirmBtn').addEventListener('click', async () => {
      if (!currentSource) return;
      $('confirmMsg').textContent = '取込中…'; $('confirmMsg').className = 'pk-msg';
      $('confirmBtn').disabled = true;
      try {
        const { status, body } = await post(currentSource, 'confirm', {
          hikiate_class: $('hikiateClass').value.trim(),
          folder_name: $('folderName').value.trim(),
          overwrite: $('overwriteChk').checked ? '1' : '0',
        });
        if (status === 409 && body.code === 'duplicate') {
          $('overwriteMsg').textContent = body.error;
          $('overwriteBox').style.display = 'block';
          $('confirmMsg').textContent = '取込済みのバッチです。上書きする場合はチェックして再実行してください';
          $('confirmMsg').className = 'pk-msg err';
          return;
        }
        if (status !== 200) {
          $('confirmMsg').textContent = body.error || `エラー (${status})`; $('confirmMsg').className = 'pk-msg err';
          return;
        }
        $('confirmMsg').innerHTML =
          `${body.replaced ? '上書き' : ''}取込完了 (${body.lineCount}明細) → <a href="/apps/picking/batches/${body.batchId}">バッチ明細を確認</a>`;
        $('confirmMsg').className = 'pk-msg ok';
      } finally {
        $('confirmBtn').disabled = false;
      }
    });
  </script>
</body>
</html>
