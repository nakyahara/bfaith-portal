<!DOCTYPE html>
<!--
  倉庫の掲示モニター用ボード (2026-08-17 中原さん指示)。
  Chrome のキオスクモードで常時表示する前提:
    chrome.exe --kiosk https://picking.bfaith-wh.uk/apps/picking/board
  端末は「掲示専用 (kind=board)」で登録する = このページ以外は開けない。

  主役は「引当分類ごとに誰が速いか」(中原さん要望)。分類によって速さが根本的に違う
  (AES《単品》11.9秒 / AES《1SKU複数個》23.5秒) ため、総合順位だけでは比較にならない。

  自動更新は fetch + DOM差し替え (location.reload() だと数秒ごとに画面が白く飛ぶ)。
-->
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <style>
    :root {
      --bg: #0f1216; --panel: #171c22; --card: #1d232b; --line: #2a323c;
      --fg: #f1f3f5; --muted: #93a0ad;
      --ok: #40c057; --warn: #fab005; --bad: #fa5252; --accent: #4dabf7;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body {
      background: var(--bg); color: var(--fg);
      font-family: system-ui, -apple-system, "Segoe UI", "Hiragino Sans", "Noto Sans JP", sans-serif;
      font-variant-numeric: tabular-nums;
      padding: 1.2vh 1.2vw;
      display: flex; flex-direction: column; gap: 1.1vh;
      overflow: hidden;
    }
    header { display: flex; align-items: baseline; gap: 1.4vw; flex: 0 0 auto; }
    header h1 { font-size: 2.9vh; margin: 0; letter-spacing: 0.02em; }
    header .range { font-size: 1.9vh; color: var(--muted); }
    header .right { margin-left: auto; font-size: 1.8vh; color: var(--muted); display: flex; gap: 1vw; align-items: center; }
    .stale { color: var(--warn); }

    main { flex: 1 1 auto; display: grid; grid-template-columns: 26fr 74fr; gap: 1.1vw; min-height: 0; }
    /* min-width:0 が無いと grid の auto 最小サイズ (中身の max-content) が勝ち、
       右カラムの中身が左カラムを押し潰して端の列が画面外に出る */
    .col { display: flex; flex-direction: column; gap: 1.1vh; min-height: 0; min-width: 0; }
    .panel { background: var(--panel); border-radius: 1.2vh; padding: 1.4vh 1.2vw; min-height: 0; min-width: 0; }
    .panel h2 { font-size: 1.8vh; margin: 0 0 1.1vh; color: var(--muted); font-weight: 600; letter-spacing: 0.05em; }
    .panel h2 .sub { color: #6b7784; font-weight: 400; letter-spacing: 0; }

    /* 今日 */
    .today-big { font-size: 7.6vh; font-weight: 800; line-height: 1; white-space: nowrap; }
    .today-sub { font-size: 2.0vh; color: var(--muted); margin-top: 0.3vh; white-space: nowrap; }
    .bar { height: 1.6vh; background: #232a32; border-radius: 1vh; overflow: hidden; margin: 1.1vh 0 0.6vh; }
    .bar > i { display: block; height: 100%; background: var(--ok); }
    .kv { display: flex; justify-content: space-between; gap: 0.8vw; font-size: 1.9vh; padding: 0.35vh 0; white-space: nowrap; }
    .kv .k { color: var(--muted); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.5vw; }
    .chip { background: #232a32; border-radius: 0.8vh; padding: 0.5vh 0.7vw; font-size: 1.9vh; }
    .chip.paused { color: var(--warn); }
    .chip .cls { color: var(--muted); font-size: 1.4vh; display: block; }

    /* 総合ランキング (左カラム・コンパクト) */
    .rank-row { display: flex; align-items: center; gap: 0.5vw; padding: 0.6vh 0; border-top: 1px solid var(--line); font-size: 2.1vh; }
    .rank-row:first-child { border-top: 0; }
    .rank-row .r { color: var(--muted); width: 1.6vw; font-size: 1.7vh; }
    .rank-row .n { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
    .rank-row .i { font-weight: 800; width: 3.2vw; text-align: right; }
    .rank-row .s { color: var(--muted); width: 3.4vw; text-align: right; font-size: 1.7vh; }
    .rank-row.prov { color: var(--muted); }
    .rank-row.prov .i { color: var(--muted); }
    .up { color: var(--ok); } .dn { color: var(--warn); }

    /* 引当分類カード (メイン) */
    /* パネルを flex にして grid に残り高さを渡し、3行を等分する
       (行を内容任せにすると分類名が2行のカードで下段がはみ出す) */
    .cls-panel { display: flex; flex-direction: column; overflow: hidden; }
    .cls-grid {
      flex: 1 1 auto; min-height: 0;
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr); gap: 1.0vh 1.0vw;
    }
    .ccard { background: var(--card); border-radius: 1vh; padding: 1.0vh 0.9vw; min-width: 0; overflow: hidden; }
    .ccard .chead { display: flex; align-items: baseline; gap: 0.5vw; }
    .ccard .cname {
      flex: 1 1 0; min-width: 0; font-size: 1.9vh; font-weight: 700; line-height: 1.25;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .ccard .cavg { font-size: 2.6vh; font-weight: 800; white-space: nowrap; }
    .ccard .cavg small { font-size: 1.5vh; color: var(--muted); font-weight: 600; margin-left: 0.15vw; }
    .ccard .cmeta { font-size: 1.4vh; color: #6b7784; margin: 0.15vh 0 0.6vh; }
    .crow { display: flex; align-items: center; gap: 0.5vw; font-size: 2.0vh; padding: 0.42vh 0; border-top: 1px solid #262e37; }
    .crow .r { color: var(--muted); width: 1.1vw; font-size: 1.6vh; }
    .crow .n { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .crow .s { font-weight: 700; width: 3.0vw; text-align: right; }
    .crow .q { color: #6b7784; width: 3.0vw; text-align: right; font-size: 1.5vh; }
    .crow.top .n { font-weight: 800; }
    .crow.prov { color: var(--muted); }
    .crow.prov .s { color: var(--muted); font-weight: 600; }

    /* 日別 (右下・横並び) */
    .days { display: flex; gap: 1.0vw; }
    .day { flex: 1 1 0; min-width: 0; text-align: center; }
    .day .d { font-size: 1.5vh; color: var(--muted); }
    .day .v { font-size: 2.1vh; font-weight: 700; }
    .day .db { height: 0.9vh; background: #232a32; border-radius: 1vh; overflow: hidden; margin-top: 0.3vh; }
    .day .db > i { display: block; height: 100%; background: var(--accent); }

    footer { flex: 0 0 auto; font-size: 1.5vh; color: var(--muted); display: flex; gap: 1.6vw; }
    .err { color: var(--bad); }
  </style>
</head>
<body>
  <header>
    <h1>📦 ピッキング実績</h1>
    <span class="range" id="range">読み込み中…</span>
    <span class="right">
      <span id="clock"></span>
      <span id="status"></span>
    </span>
  </header>

  <main>
    <div class="col">
      <div class="panel">
        <h2>本日の進捗</h2>
        <div class="today-big" id="todayDone">-</div>
        <div class="today-sub">全 <span id="todayTotal">-</span> 明細中 (残り <span id="todayRemain">-</span>)</div>
        <div class="bar"><i id="todayBar" style="width:0%"></i></div>
        <div class="kv"><span class="k">バッチ</span><span><b id="todayBatches">-</b></span></div>
        <div class="kv"><span class="k">秒/明細</span><span><b id="todaySpl">-</b></span></div>
      </div>
      <div class="panel">
        <h2>いま作業中</h2>
        <div class="chips" id="active"><span class="chip">-</span></div>
      </div>
      <div class="panel" style="flex:1 1 auto; overflow:hidden">
        <h2>総合 <span class="sub">(分類の重さを補正した指数)</span></h2>
        <div id="rank"></div>
      </div>
    </div>

    <div class="col">
      <div class="panel cls-panel" style="flex:1 1 auto">
        <h2 id="clsTitle">引当分類別 — この分類は誰が速いか <span class="sub">(秒/明細)</span></h2>
        <div class="cls-grid" id="classes"></div>
      </div>
      <div class="panel">
        <h2>日別 <span class="sub">(全体の秒/明細)</span></h2>
        <div class="days" id="byDate"></div>
      </div>
    </div>
  </main>

  <footer>
    <span id="note"></span>
    <span id="err" class="err"></span>
  </footer>

  <script>
    var WINDOW_DAYS = <%- JSON.stringify(windowDays) %>;
    var RELOAD_MS = 20000;          // データ再取得の間隔 (前回の完了/失敗から数える)
    var FETCH_TIMEOUT_MS = 12000;   // これを超えたら諦めて次の周期へ (ハングで更新が止まらないように)
    var HARD_RELOAD_MS = 6 * 3600 * 1000;   // 6時間ごとにページ自体を作り直す (長期表示のメモリ対策)
    var TOP_PER_CLASS = 3;          // 各分類カードに載せる人数 (3列×3行が画面に収まる上限)
    var startedAt = Date.now();
    var lastOk = 0;
    var gen = 0;                    // 応答の世代。古い応答が新しい表示を上書きしないように

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function fmt1(n) { return n == null ? '-' : Number(n).toFixed(1); }
    function mmdd(d) { return d ? d.slice(5).replace('-', '/') : '-'; }

    function renderClock() {
      var d = new Date();
      var p = function (n) { return String(n).padStart(2, '0'); };
      document.getElementById('clock').textContent = p(d.getHours()) + ':' + p(d.getMinutes());
    }

    function renderToday(t) {
      document.getElementById('todayDone').textContent = t.doneLines;
      document.getElementById('todayTotal').textContent = t.totalLines;
      document.getElementById('todayBatches').textContent = t.doneCount + ' / ' + t.batchCount;
      document.getElementById('todayRemain').textContent = t.remainingLines;
      document.getElementById('todaySpl').textContent = fmt1(t.secPerLine);
      var pct = t.totalLines > 0 ? Math.round((t.doneLines / t.totalLines) * 100) : 0;
      document.getElementById('todayBar').style.width = pct + '%';

      var active = document.getElementById('active');
      if (!t.active.length) {
        active.innerHTML = '<span class="chip" style="color:var(--muted)">作業中のバッチはありません</span>';
      } else {
        active.innerHTML = t.active.map(function (a) {
          return '<span class="chip' + (a.paused ? ' paused' : '') + '">' +
            (a.paused ? '⏸ ' : '▶ ') + esc(a.name) +
            '<span class="cls">' + esc(a.folder || '') + ' ' + esc(a.hikiateClass || '') + '</span></span>';
        }).join('');
      }
    }

    function renderRank(s) {
      document.getElementById('rank').innerHTML = s.workers.map(function (w, i) {
        var cls = w.index == null ? '' : (w.index >= 100 ? 'up' : (w.index < 85 ? 'dn' : ''));
        return '<div class="rank-row' + (w.provisional ? ' prov' : '') + '">' +
          '<span class="r">' + (w.provisional ? '–' : (i + 1)) + '</span>' +
          '<span class="n">' + esc(w.name) + '</span>' +
          '<span class="i ' + cls + '">' + (w.index == null ? '-' : w.index) + '</span>' +
          '<span class="s">' + fmt1(w.secPerLine) + '秒</span>' +
        '</div>';
      }).join('') || '<div style="color:var(--muted)">データがありません</div>';
    }

    function renderClasses(s) {
      document.getElementById('classes').innerHTML = s.baseline.map(function (c) {
        var rows = c.workers.slice(0, TOP_PER_CLASS).map(function (w, i) {
          return '<div class="crow' + (w.provisional ? ' prov' : (i === 0 ? ' top' : '')) + '">' +
            '<span class="r">' + (w.provisional ? '–' : (i + 1)) + '</span>' +
            '<span class="n">' + esc(w.name) + '</span>' +
            '<span class="s">' + fmt1(w.secPerLine) + '</span>' +
            '<span class="q">' + w.lines + '件</span>' +
          '</div>';
        }).join('');
        var rest = c.workers.length - TOP_PER_CLASS;
        return '<div class="ccard">' +
          '<div class="chead"><span class="cname">' + esc(c.key) + '</span>' +
            '<span class="cavg">' + fmt1(c.avgSec) + '<small>秒</small></span></div>' +
          '<div class="cmeta">全体平均 / ' + c.lines + '件 ・ ' + c.workerCount + '名' +
            (rest > 0 ? ' (他' + rest + '名)' : '') + '</div>' +
          rows +
        '</div>';
      }).join('') || '<div style="color:var(--muted)">データがありません</div>';
    }

    function renderDays(s) {
      var recent = s.byDate.slice(-7);
      var worst = recent.reduce(function (m, d) { return Math.max(m, d.secPerLine); }, 1);
      document.getElementById('byDate').innerHTML = recent.map(function (d) {
        return '<div class="day"><div class="d">' + mmdd(d.date) + '</div>' +
          '<div class="v">' + fmt1(d.secPerLine) + '</div>' +
          '<div class="db"><i style="width:' + Math.round((d.secPerLine / worst) * 100) + '%"></i></div>' +
          '<div class="d">' + d.lines + '件</div></div>';
      }).join('') || '<span style="color:var(--muted)">データがありません</span>';
    }

    function render(data) {
      var s = data.stats;
      document.getElementById('range').textContent =
        mmdd(s.since) + '〜' + mmdd(s.until) + ' の' + s.days + '日間 ・ ' + s.total.lines + '明細';
      document.getElementById('clsTitle').innerHTML =
        '引当分類別 — この分類は誰が速いか <span class="sub">(秒/明細・上位' + TOP_PER_CLASS + '名)</span>';

      renderToday(data.today);
      renderRank(s);
      renderClasses(s);
      renderDays(s);

      var note = '総合の指数 100 = 全体平均どおり (分類の重さを補正) / '
        + '分類別は' + s.minClassLines + '明細未満・総合は' + s.minLines + '明細未満を参考値として順位から外す / '
        + s.outlierSec + '秒超の明細は除外';
      if (s.total.excluded.lines > 0) note += ' (' + s.total.excluded.lines + '件)';
      document.getElementById('note').textContent = note;
    }

    /**
     * 1回だけ取得して、完了(成功/失敗)してから次を予約する。
     * setInterval にしないのは、応答が遅いときにリクエストが積み上がるため。
     * AbortController で必ず打ち切り、世代番号で古い応答を捨てる (Codexレビュー medium)。
     */
    function tick() {
      var myGen = ++gen;
      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, FETCH_TIMEOUT_MS);
      var done = false;
      var finish = function (fn) {
        clearTimeout(timer);
        if (done || myGen !== gen) return;   // 二重実行・古い応答は無視
        done = true;
        // ⭐描画で例外が出ても必ず次を予約する (finally)。ここで抜けると常時表示が
        //   二度と更新されないまま古い数字を映し続ける (Codexレビュー medium)
        try {
          fn();
        } catch (e) {
          try {
            document.getElementById('err').textContent = '表示エラー (' + e.message + ')';
            document.getElementById('status').textContent = '○';
            document.getElementById('status').className = 'stale';
          } catch (ignored) { /* DOMごと壊れている場合は次の周期に賭ける */ }
        } finally {
          // ページ自体の作り直しは「更新に成功している間だけ」行う。
          // サーバー停止中に reload すると、保持していた最後の正常表示までブラウザの
          // エラー画面に置き換わってしまう
          if (lastOk && Date.now() - startedAt > HARD_RELOAD_MS && Date.now() - lastOk < RELOAD_MS * 2) {
            location.reload();
          } else {
            setTimeout(tick, RELOAD_MS);
          }
        }
      };

      fetch('/apps/picking/api/board?days=' + WINDOW_DAYS, { credentials: 'same-origin', signal: ctrl.signal })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (d) {
          if (!d || !d.ok) throw new Error('bad payload');
          finish(function () {
            render(d);
            lastOk = Date.now();
            document.getElementById('err').textContent = '';
            document.getElementById('status').textContent = '●';
            document.getElementById('status').className = '';
          });
        })
        .catch(function (e) {
          finish(function () {
            // 前回の表示はそのまま残す (真っ白にするより情報が多い)
            var msg = e.name === 'AbortError' ? '応答なし (タイムアウト)' : '通信エラー (' + e.message + ')';
            document.getElementById('err').textContent =
              msg + (lastOk ? ' / 最終更新 ' + new Date(lastOk).toLocaleTimeString('ja-JP') : '');
            document.getElementById('status').textContent = '○';
            document.getElementById('status').className = 'stale';
          });
        });
    }

    renderClock();
    setInterval(renderClock, 10000);
    tick();
  </script>
</body>
</html>
