<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    /* ↩ 棚戻し (例外処理監査 PR-4)。通常ピッキング画面と同じ並び: ロケ (大) → 画像 → 数量 (大) → 商品名 → SKU */
    .pk-wrap { max-width: 720px; margin: 0 auto; padding: 10px 12px 60px; }
    .muted { color: #868e96; font-size: 0.85em; }
    .card { background: #fff; border: 1px solid #dee2e6; border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; border-left: 6px solid #1971c2; }
    .kind { font-weight: 800; font-size: 1.0em; color: #1971c2; }
    .chip { display: inline-block; border-radius: 999px; padding: 2px 10px; font-size: .85em; font-weight: 700; background: #e7f5ff; color: #1864ab; margin-left: 6px; }
    .chip.excess { background: #fff3bf; color: #e8590c; } .chip.wrong { background: #ffe3e3; color: #c92a2a; }
    .prow { display: flex; gap: 12px; align-items: center; margin-top: 8px; }
    .timg { flex: 0 0 auto; width: 128px; height: 128px; border: 1px solid #e9ecef; border-radius: 10px;
      background: #f8f9fa center/contain no-repeat; display: flex; align-items: center; justify-content: center; color: #ced4da; font-size: 30px; }
    .pinfo { flex: 1 1 auto; min-width: 0; }
    .qty { font-size: 2.2em; font-weight: 800; line-height: 1.1; }
    .qty .x { font-size: 0.5em; font-weight: 600; color: #868e96; margin-right: 4px; }
    .pname { font-size: 1.05em; font-weight: 700; line-height: 1.3; margin-top: 2px; }
    .claimed-tag { background: #fff3bf; border-radius: 4px; padding: 1px 8px; font-size: 0.85em; }
    h2 { font-size: 1.05em; margin: 14px 0 6px; }
    /* ロケは1行で読めるように (iPhone 幅で 15文字が折り返さない)。ボタンは下に全幅 = タップしやすい */
    .loc-row { display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; border: 1px solid #dee2e6; border-radius: 12px; background: #fff; margin-bottom: 8px; }
    .loc-row.picked { border: 2px solid #1971c2; background: #e7f5ff; }
    .loc-row .loc { min-width: 0; font-family: ui-monospace, Consolas, monospace; font-size: 1.6em; font-weight: 800; letter-spacing: 0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .loc-row .sub { font-size: .55em; color: #495057; font-weight: 600; font-family: system-ui, sans-serif; letter-spacing: 0; white-space: normal; }
    .loc-row button { width: 100%; padding: 14px 16px; font-size: 1.05em; font-weight: 700; border-radius: 10px; border: none; background: #2b8a3e; color: #fff; cursor: pointer; }
    .manual { display: none; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 6px; }
    .manual input { padding: 12px; font-size: 1.15em; border: 1px solid #ced4da; border-radius: 10px; font-family: ui-monospace, Consolas, monospace; }
    .manual button { padding: 14px 16px; font-size: 1.05em; font-weight: 700; border-radius: 10px; border: none; background: #2b8a3e; color: #fff; }
    .ghost { width: 100%; padding: 12px; margin-top: 8px; border: 1px solid #ced4da; border-radius: 10px; background: #fff; font-size: 1em; font-weight: 700; color: #495057; }
    .b-claim { width: 100%; padding: 14px; margin-top: 8px; border: none; border-radius: 10px; background: #1971c2; color: #fff; font-size: 1.05em; font-weight: 700; }
    .cancel-link { margin-top: 18px; width: 100%; padding: 12px; border: none; background: none; color: #868e96; font-size: 1em; cursor: pointer; }
    .done-box { background: #d3f9d8; border: 2px solid #2b8a3e; border-radius: 12px; padding: 16px; text-align: center; font-size: 1.15em; font-weight: 800; color: #2b8a3e; }
    #workerPick { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 50; align-items: flex-end; justify-content: center; }
    .sheet { background: #fff; border-radius: 16px 16px 0 0; padding: 18px 16px calc(18px + env(safe-area-inset-bottom)); width: 100%; max-width: 520px; }
    .sheet h3 { margin: 0 0 12px; font-size: 1.1em; }
    .sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .worker-opt { padding: 18px 8px; font-size: 1.15em; font-weight: 600; border: 1px solid #ced4da; border-radius: 12px; background: #f8f9fa; cursor: pointer; }
    .sheet-cancel { margin-top: 12px; width: 100%; padding: 12px; border: none; background: none; color: #868e96; font-size: 1em; cursor: pointer; }
  </style>
</head>
<body>
  <%- include('_floor_alerts') %>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">↩ 棚戻し</span>
    </div>
    <div class="header-right">
      <a href="/apps/picking/" class="btn-logout">← バッチ一覧</a>
    </div>
  </header>

  <%
    const t = task;
    const reason = t.incident_kind === 'excess' ? { cls: 'excess', label: '余り (バッチに多く入っていた)' }
      : t.incident_kind === 'wrong_item' ? { cls: 'wrong', label: '品違い (間違って入っていた商品)' } : null;
    const finished = ['returned', 'fulfilled', 'received', 'cancelled'].includes(t.status);
  %>
  <div class="pk-wrap">
    <div class="card">
      <div class="kind">↩ 棚戻し (棚へ戻す)<% if (reason) { %><span class="chip <%= reason.cls %>"><%= reason.label %></span><% } %></div>
      <div class="muted">依頼元: <%= t.folder_name || t.batch_folder || '-' %><%= t.slip_seq ? ` #${t.slip_seq}` : '' %> / 依頼: <%= t.requested_by || '-' %> (計測対象外)
        <% if (t.status === 'claimed') { %><span class="claimed-tag">対応中: <%= t.claimed_by %></span><% } %></div>
      <div class="prow">
        <%# 画像は img[src] (CSS 属性への埋め込みはエスケープ文脈が違う — Codex R1)。URL は router で http(s)/同一オリジンに制限済み %>
        <div class="timg"><% if (t.imageUrl) { %><img src="<%= t.imageUrl %>" alt="" referrerpolicy="no-referrer" style="max-width:100%; max-height:100%; object-fit:contain"><% } else { %>📦<% } %></div>
        <div class="pinfo">
          <div class="qty"><span class="x">×</span><%= t.req_qty %>個</div>
          <div class="pname"><%= t.product_name || t.sku %></div>
          <div class="muted"><%= t.sku %></div>
        </div>
      </div>
    </div>

    <% if (finished) { %>
      <div class="done-box">
        <% if (t.status === 'cancelled') { %>この棚戻しは取り下げられました<% } else { %>✅ 戻しました<%= t.returnedLabel ? ` → ${t.returnedLabel}` : '' %><%= t.returned_by ? ` (${t.returned_by})` : '' %><% } %>
      </div>
      <a href="/apps/picking/" class="ghost" style="display:block; text-align:center; text-decoration:none">← バッチ一覧へ</a>
    <% } else { %>
      <h2>どこへ戻しますか？ — 戻した棚をタップ (記録して事務へ伝えます)</h2>
      <% if (t.locationLabel) { %>
        <div class="loc-row picked" data-block="<%= t.block || '' %>" data-location="<%= t.location %>" data-source="<%= t.location_source === 'stock' ? 'stock' : 'picked' %>">
          <div class="loc"><%= t.locationLabel %><div class="sub"><%= t.location_source === 'stock' ? '在庫ロケの候補 (ロジザード)' : '取った場所 (このバッチのピックロケ)' %></div></div>
          <button type="button" class="here">ここへ戻した</button>
        </div>
      <% } else { %>
        <div class="muted" style="margin-bottom:6px">取った場所は分かりません (バッチに無い商品)。下の在庫ロケ候補か、手入力で記録してください</div>
      <% } %>
      <div id="cands"><div class="muted">在庫ロケの候補を取得中…</div></div>
      <button type="button" class="ghost" id="manualBtn">別の場所へ戻した (ロケを入力)</button>
      <div class="manual" id="manual">
        <input type="text" id="mBlock" placeholder="ブロック (例: P3FA)" style="width:130px" autocapitalize="characters">
        <input type="text" id="mLoc" placeholder="ロケ (例: 002-013-03)" style="flex:1 1 160px" inputmode="numeric">
        <button type="button" id="mOk">ここへ戻した</button>
      </div>
      <% if (t.status === 'requested') { %>
        <button type="button" class="b-claim" id="claimBtn">対応する (自分が担当になる — まだ戻していない)</button>
      <% } %>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <button type="button" class="cancel-link" id="cancelBtn">取り下げる (棚に戻さない・管理者)</button>
      <% } else { %>
        <div class="muted" style="text-align:center; margin-top:18px">戻せないときは管理者に伝えてください (取り下げは管理者がログインして行います)</div>
      <% } %>
    <% } %>
  </div>

  <div id="workerPick">
    <div class="sheet">
      <h3>だれが戻しましたか？</h3>
      <div class="sheet-grid">
        <% for (const w of workers) { %>
          <button class="worker-opt" data-code="<%= w.code %>" data-name="<%= w.name %>"><%= w.name %></button>
        <% } %>
      </div>
      <button class="sheet-cancel" id="wpCancel" type="button">やめる</button>
    </div>
  </div>

  <script>
    const $ = (s) => document.querySelector(s);
    const TASK = <%- JSON.stringify({ id: task.id, status: task.status, sku: task.sku, finished }).replace(/</g, '\\u003c') %>;
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    let pending = null;   // { act, body }
    let sending = false;

    async function send(act, body, code) {
      if (sending) return;
      sending = true;
      try {
        const res = await fetch(`/apps/picking/api/tasks/${TASK.id}/${act}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ worker_code: code, ...body }),
        });
        const b = await res.json().catch(() => ({}));
        if (!res.ok) { alert(b.error || `エラー (${res.status})`); if (res.status === 409) location.reload(); return; }
        if (act === 'fulfill') {
          // 記録できた → 一覧へ (次の棚戻し・通常バッチへ)。通知は DB の outbox が正本 (送れなければポーラーが再送)
          const note = b.notify === 'sent' ? '事務へ通知しました' : b.replayed ? '記録済みです (再送)' : '事務への通知は自動で再送します';
          document.querySelector('.pk-wrap').insertAdjacentHTML('afterbegin',
            `<div class="done-box">✅ 戻しました → ${esc([b.returnedBlock, b.returnedLocation].filter(Boolean).join('-'))}<br><small>${note}。一覧に戻ります</small></div>`);
          setTimeout(() => { location.href = '/apps/picking/'; }, 1500);
          return;
        }
        if (act === 'cancel') { location.href = '/apps/picking/'; return; }
        location.reload();
      } finally { sending = false; }
    }
    // 毎回名前をタップ (picking 本体・旧 /tasks と同じ運用 — 誰が戻したかを記録する)
    function withWorker(act, body) { pending = { act, body }; $('#workerPick').style.display = 'flex'; }
    document.querySelectorAll('.worker-opt').forEach((btn) => btn.addEventListener('click', () => {
      localStorage.setItem('pk_task_worker', btn.dataset.code);
      $('#workerPick').style.display = 'none';
      if (pending) send(pending.act, pending.body, btn.dataset.code);
      pending = null;
    }));
    $('#wpCancel').addEventListener('click', () => { $('#workerPick').style.display = 'none'; pending = null; });

    function hereClicked(block, location, label, source) {
      if (!confirm(`${label} へ戻したとして記録します。よろしいですか?`)) return;
      withWorker('fulfill', { returned_block: block || null, returned_location: location, returned_source: source || 'manual' });
    }
    // 取った場所 (サーバー描画) と 在庫ロケ候補 (fetch) の「ここへ戻した」— 委譲 (SKU/ロケは data 属性から)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.loc-row .here');
      if (!btn) return;
      const row = btn.closest('.loc-row');
      hereClicked(row.dataset.block, row.dataset.location, row.querySelector('.loc').firstChild.textContent.trim(), row.dataset.source || 'stock');
    });
    if ($('#manualBtn')) {
      $('#manualBtn').addEventListener('click', () => { $('#manual').style.display = 'flex'; $('#mLoc').focus(); });
      $('#mOk').addEventListener('click', () => {
        const block = $('#mBlock').value.trim().toUpperCase();
        const loc = $('#mLoc').value.trim();
        if (!loc) { alert('ロケを入力してください (例: 002-013-03)'); return; }
        if (!/^[A-Za-z0-9][A-Za-z0-9_\-.]*$/.test(loc) || (block && !/^[A-Za-z0-9][A-Za-z0-9_\-.]*$/.test(block))) { alert('ロケの形式が不正です (英数字と - のみ)'); return; }
        hereClicked(block, loc, block ? `${block}-${loc}` : loc, 'manual');
      });
    }
    if ($('#claimBtn')) $('#claimBtn').addEventListener('click', () => withWorker('claim', {}));
    if ($('#cancelBtn')) $('#cancelBtn').addEventListener('click', () => {
      if (!confirm('この棚戻しを取り下げます (棚に戻さない)。管理者に伝えてください。よろしいですか?')) return;
      withWorker('cancel', {});
    });

    // 在庫ロケ候補 (ロジザード・良品・フリー在庫の多い順)。取れないときは取った場所と手入力だけ
    async function loadCandidates() {
      const box = $('#cands');
      if (!box || TASK.finished) return;
      try {
        const r = await fetch(`/apps/picking/api/return-tasks/${TASK.id}/candidates`);
        const c = await r.json();
        if (!r.ok) { box.innerHTML = `<div class="muted">候補を取得できません (${esc(c.error || r.status)})</div>`; return; }
        if (!c.configured) { box.innerHTML = '<div class="muted">在庫ロケの参照が設定されていません (取った場所か手入力で記録してください)</div>'; return; }
        if (!c.fetched) { box.innerHTML = '<div class="muted">ロジザードの在庫ロケを取得できませんでした (取った場所か手入力で記録してください)</div>'; return; }
        const head = `<div class="muted" style="margin:4px 0">ロジザードの在庫ロケ (良品・フリー在庫の多い順)${c.stamp ? ` — ${esc(c.stamp)}` : ''}${c.stale ? ' ⚠ 在庫データが古い可能性' : ''}</div>`;
        if (c.rows.length === 0) {
          box.innerHTML = head + '<div class="muted">この商品のフリー在庫があるロケはありません</div>';
          return;
        }
        box.innerHTML = head + c.rows.map((row) => `
          <div class="loc-row" data-block="${esc(row.block)}" data-location="${esc(row.location)}" data-source="stock">
            <div class="loc">${esc(row.label)}<div class="sub">フリー ${esc(row.free)}${row.expiry ? ` / 期限 ${esc(row.expiry)}` : ''}</div></div>
            <button type="button" class="here">ここへ戻した</button>
          </div>`).join('') + (c.truncated ? `<div class="muted">他 ${esc(c.truncated)} ロケは省略</div>` : '');
      } catch {
        box.innerHTML = '<div class="muted">候補の取得に失敗しました (取った場所か手入力で記録してください)</div>';
      }
    }
    loadCandidates();
  </script>
</body>
</html>
