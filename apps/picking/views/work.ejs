<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#111418">
  <title><%= title %></title>
  <link rel="manifest" href="/apps/picking/manifest.json">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <style>
    /* 前腕装着・歩行中の1〜2秒のチラ見で読めることが最優先 (要件§5.1/§6)。
       暗背景+高コントラスト・巨大文字。装飾は最小限 */
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body { height: 100%; }
    /* position:fixed でページ自体のスクロールを完全に殺す。
       iOS SafariはURLバーの伸縮で 100% と可視領域がずれ、わずかに縦スクロールできて
       画面上部 (ロケーション) が切れる (2026-08-12 実機写真で確認) */
    body {
      position: fixed; inset: 0; width: 100%;
      background: #111418; color: #f1f3f5;
      font-family: -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
      display: flex; flex-direction: column;
      overflow: hidden; user-select: none; -webkit-user-select: none;
      overscroll-behavior: none; touch-action: manipulation;
      padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
    }
    @supports (height: 100dvh) { body { height: 100dvh; } }
    .bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 14px; font-size: 15px; color: #adb5bd; flex: 0 0 auto;
    }
    .bar a { color: #74c0fc; text-decoration: none; padding: 4px 8px; }
    #progress { font-variant-numeric: tabular-nums; font-weight: 600; }
    #offline { display: none; background: #e8590c; color: #fff; text-align: center;
      padding: 4px; font-size: 14px; flex: 0 0 auto; }
    #syncerr { display: none; background: #c92a2a; color: #fff; text-align: center;
      padding: 8px; font-size: 15px; flex: 0 0 auto; }

    .screen { flex: 1 1 auto; display: none; flex-direction: column; min-height: 0; }
    .screen.active { display: flex; }

    /* ── ピック画面 ── */
    /* ロケーションは絶対に1行 (折り返すと桁の見間違いが起きる)。JSが幅に合わせて縮小する */
    #loc {
      text-align: center; font-weight: 800; letter-spacing: 0.01em;
      font-size: 54px; line-height: 1.15; white-space: nowrap; overflow: hidden;
      font-variant-numeric: tabular-nums; padding: 2px 8px 0;
    }
    /* ロケ色分け (2026-08-12 中原さん採用):
       背景色=棚 (今と次が同じ色=同じ棚=近い、色が違う=移動が来る、を読まずに判断できる)
       左帯=ブロック (P3FA等は4つしかないので「この色=このブロック」を覚えられる。
       棚色が変わって左帯まで変わったら別ブロックへの大移動の予告)
       右帯は透明のダミー (左帯の分だけ中央がずれないよう左右対称にする) */
    #loc {
      margin: 0 10px; border-radius: 10px;
      border-left: 10px solid transparent; border-right: 10px solid transparent;
    }
    /* 画像は縦持ちでは高さ約17%に抑える (商品名3行 + 商品コード + NEXTサインの確保が優先 — 実機FB 2026-08-25) */
    #imgbox {
      flex: 0 1 17vh; height: 17vh; min-height: 80px; margin: 4px 14px;
      display: flex; align-items: center; justify-content: center;
      background: #1c2127; border-radius: 12px; overflow: hidden;
    }
    #imgbox .noimg { color: #495057; font-size: 15px; }
    #imgbox img { max-width: 100%; max-height: 100%; object-fit: contain; }
    #details { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 2px; justify-content: center; }
    #qty {
      text-align: center; font-weight: 800; line-height: 1;
      font-size: clamp(44px, 14vw, 80px); font-variant-numeric: tabular-nums;
      padding: 2px 0;
    }
    #qty.multi { color: #ffd43b; }   /* 2個以上は強調 (取忘れ/取りすぎ防止) */
    #qty .x { font-size: 0.45em; font-weight: 600; color: #868e96; margin-right: 6px; }
    /* 商品名は3行まで見せる (2行だと長い商品名が「…」で切れて末尾のバリエーションが読めない — 現場FB 2026-08-25)。
       23px/700 — 同じロケに複数SKUがある現場では商品の取り違えが最大リスク (Codexレビュー 2026-08-23) */
    #pname {
      text-align: center; font-size: 23px; font-weight: 700; line-height: 1.3; padding: 0 14px; color: #f1f3f5;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    #pname .suffix { color: #5c636a; font-size: 0.8em; font-weight: 500; }
    /* 商品コードは商品名の下に控えめに出す (2026-08-25 中原さん指示。商品名だけでは特定しづらい品の照合用) */
    #psku {
      text-align: center; font-size: 16px; font-weight: 600; color: #868e96; font-variant-numeric: tabular-nums;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 14px; letter-spacing: .02em;
    }

    #nextBtn {
      flex: 0 0 18%; min-height: 84px; margin: 0 10px 10px; border: none; border-radius: 16px;
      background: #1971c2; color: #fff; font-size: 30px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; cursor: pointer;
    }
    /* 背の低い端末 (iPhone SE等) は更に詰めて商品名2行を死守する */
    @media (orientation: portrait) and (max-height: 720px) {
      #loc { font-size: 44px; }
      #imgbox { flex-basis: 13vh; height: 13vh; }
      #qty { font-size: clamp(38px, 11vw, 60px); }
      #pname { font-size: 20px; }
      #psku { font-size: 14px; }
      #nextBtn { flex-basis: 16%; min-height: 72px; font-size: 26px; }
      #band { --sign-h: 48px; }
      #nextloc { font-size: 24px; padding: 4px 12px; }
    }

    /* ── 動線の帯 (2026-08-25 中原さん提案・要件定義 ピッキングNEXTサイン_要件定義_20260823.md 改訂2) ──
       「次へ」を押した後の画面で、今のロケの真上に「前の場所からどう動くか」を細い帯で出す
       (歩きながら見る画面に案内を置く。押す前に読んで覚える方式は記憶頼みで定着しなかった)。
       3ゾーン [動作 | 連の移動 | 段]。動作が無いときは2ゾーン。重い移動 (折り返す/階段/大きく移動/案内できず) はアンバー枠。
       ロケより目立たせない (主役はロケコード)。押せるのは青い「次へ」だけ */
    #band { margin: 6px 10px 2px; height: var(--sign-h); flex: 0 0 auto; }
    .signbox {
      --sign-h: 54px;
      --icon-h: 24px; --n-size: 28px; --verb-size: 17px; --dan-size: 21px; --rel-size: 26px; --code-size: 22px; --sub-size: 12px;
      --heavy: #ffb020; --heavy-text: #ffc078; --ren-color: #4dabf7;
      border-radius: 10px; background: #1c2127; border: 2px solid #3a4250; border-left-width: 8px;
      display: flex; flex-direction: column; justify-content: center;
      padding: 2px 6px; position: relative; overflow: hidden;
    }
    #band.empty { display: none; }
    .signbox.heavy { border-color: var(--heavy); }
    .signbox .zones { display: grid; grid-template-columns: 34% 1fr 30%; flex: 1 1 auto; min-height: 0; }
    .signbox .zones.two { grid-template-columns: 1fr 30%; }
    /* 帯は横1行: 各ゾーンの中身 (アイコン・数字・補足) を横に並べる */
    .signbox .zone { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6px; min-width: 0; padding: 0 4px; }
    .signbox .zone + .zone { border-left: 1px solid #3a4250; }
    .signbox .zone .main { display: flex; align-items: center; justify-content: center; gap: 4px; min-width: 0; max-width: 100%; }
    .signbox .zone .sub { font-size: var(--sub-size); font-weight: 700; color: #868e96; line-height: 1.1; text-align: center; white-space: nowrap; }
    .signbox .act .icon { height: var(--icon-h); width: auto; max-width: 100%; }
    .signbox .act .verb { font-size: var(--verb-size); font-weight: 800; line-height: 1.1; text-align: center; word-break: keep-all; overflow-wrap: normal; }
    .signbox.heavy .act .verb { color: var(--heavy-text); }
    .signbox.heavy .act svg .st { stroke: var(--heavy-text); } .signbox.heavy .act svg .hd { fill: var(--heavy-text); }
    .signbox .ren .icon { height: calc(var(--icon-h) * .9); width: auto; flex: 0 1 auto; max-width: 45%; }
    .signbox .ren .n { font-size: var(--n-size); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--ren-color); }
    .signbox .ren .n small { font-size: .47em; font-weight: 700; color: #d0d5dd; margin-left: 2px; }
    .signbox .ren svg .st { stroke: var(--ren-color); } .signbox .ren svg .hd { fill: var(--ren-color); }
    .signbox .ren .here { font-size: calc(var(--n-size) * .8); font-weight: 800; color: var(--ren-color); }
    .signbox .ren .here::before { content: "●"; font-size: .55em; margin-right: 8px; vertical-align: middle; }
    .signbox .ren .code { font-size: var(--code-size); font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; min-width: 0; }
    .signbox .dan .v { font-size: var(--dan-size); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .signbox .dan .v small { font-size: .78em; font-weight: 700; margin-left: 1px; }
    .signbox .dan .v.pk small { font-size: .55em; margin-right: 2px; }   /* 「ポケット」は長いので控えめに */
    .signbox .dan .rel { font-size: var(--rel-size); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
    .signbox .dan .rel + .v { font-size: calc(var(--dan-size) * .8); color: #dee2e6; }
    .signbox .start { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; color: #adb5bd; }
    .signbox svg .st { stroke: #f1f3f5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .signbox svg .hd { fill: #f1f3f5; } .signbox svg .mk { fill: var(--heavy); } .signbox svg .blk { fill: #343a40; stroke: #495057; stroke-width: 2; }
    /* 「次へ」の上: 次ロケのコード1行だけ (左帯 = 次の棚の色。今のロケ背景と同じ色なら近い、を一瞥で) */
    #nextloc {
      margin: 0 10px 6px; padding: 5px 12px; border-radius: 12px; background: #1c2127; border: 2px solid #3a4250; border-left-width: 10px;
      display: flex; align-items: baseline; gap: 10px; flex: 0 0 auto;
      font-size: 27px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: .01em; white-space: nowrap; overflow: hidden;
    }
    #nextloc .lbl { font-size: 13px; color: #868e96; font-weight: 600; letter-spacing: .06em; flex: 0 0 auto; }
    #nextloc.last { color: #adb5bd; font-size: 20px; }
    #nextBtn:active { background: #1864ab; }
    .subrow { display: flex; gap: 10px; padding: 0 10px 4px; flex: 0 0 auto; }
    .subrow button {
      flex: 1; padding: 10px 0; font-size: 16px; border-radius: 10px; border: 1px solid #343a40;
      background: #1c2127; color: #adb5bd; cursor: pointer;
    }

    /* ── 横向き (前腕ホルダーは横装着が実運用: 2026-08-12 実機確認) ──
       左=数量・商品名・次ロケ / 中=画像 / 右=縦いっぱいの「次へ」 */
    @media (orientation: landscape) {
      #scr-pick.active {
        display: grid; gap: 4px 10px; padding: 0 10px 8px;
        grid-template-columns: 1.15fr 1fr minmax(96px, 16vw);
        grid-template-rows: auto auto 1fr auto auto;
        grid-template-areas:
          "band band next"
          "loc  loc  next"
          "det  img  next"
          "sub  img  next"
          "nl   nl   next";
      }
      #loc { grid-area: loc; font-size: 44px; }
      #band { grid-area: band; margin: 0; }
      .signbox { --sign-h: 44px; }
      #nextloc { grid-area: nl; margin: 0; font-size: 22px; padding: 3px 10px; }
      #details { grid-area: det; justify-content: center; min-height: 0; }
      #qty { font-size: clamp(48px, 16vh, 88px); }
      #imgbox { grid-area: img; margin: 0; height: auto; flex: none; }
      #nextBtn { grid-area: next; margin: 0 0 4px; min-height: 0; font-size: 26px; }
      .subrow { grid-area: sub; padding: 0; align-items: end; }
    }

    /* ── 開始/完了/ブロック画面 ── */
    .center { flex: 1; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 14px; padding: 20px; text-align: center; }
    .center h2 { font-size: 22px; font-weight: 700; }
    .center .meta { color: #868e96; font-size: 16px; line-height: 1.7; }
    .bigbtn {
      width: 100%; max-width: 420px; padding: 26px 0; border: none; border-radius: 16px;
      background: #2f9e44; color: #fff; font-size: 28px; font-weight: 700; cursor: pointer;
    }
    .stats { font-size: 18px; line-height: 2; font-variant-numeric: tabular-nums; }
    .stats b { font-size: 1.3em; }
  </style>
</head>
<body>
  <%- include('_floor_alerts') %>
  <div class="bar">
    <a href="/apps/picking/">← 一覧</a>
    <span id="progress"></span>
    <span><span id="workerTag" style="cursor:pointer; padding:4px;"></span> <span id="clock"></span></span>
  </div>
  <div id="offline">オフライン — 操作は保存され、復帰後に自動送信されます</div>
  <div id="syncerr"></div>

  <!-- 開始画面 -->
  <div class="screen" id="scr-start">
    <div class="center">
      <h2><%= state.batch.hikiate_class %></h2>
      <div class="meta">
        明細 <%= state.lines.length %> / 数量 <%= state.batch.total_qty %><br>
        <%= state.batch.folder_name || '' %> <%= state.batch.composition %>
      </div>
      <button class="bigbtn" id="startBtn">ピッキング開始</button>
    </div>
  </div>

  <!-- ピック画面 -->
  <div class="screen" id="scr-pick">
    <div id="band" class="signbox" aria-live="polite"></div>
    <div id="loc"></div>
    <div id="imgbox"><span class="noimg">画像なし</span></div>
    <div id="details">
      <div id="qty"></div>
      <div id="pname"></div>
      <div id="psku"></div>
    </div>
    <div class="subrow">
      <button id="backBtn">← 前へ</button>
      <button id="pauseBtn">⏸ 中断</button>
      <button id="shortBtn" style="color:#ffa8a8; border-color:#5c2e2e;">⚠ 欠品</button>
    </div>
    <div id="nextloc"><span class="lbl">次</span><span id="nextlocCode"></span></div>
    <button id="nextBtn">次へ ▶</button>
  </div>

  <!-- 中断中画面 -->
  <div class="screen" id="scr-paused">
    <div class="center">
      <h2>⏸ 中断中</h2>
      <div class="meta" id="pausedMeta"></div>
      <button class="bigbtn" id="resumeBtn">▶ 再開する</button>
      <button id="cancelBtn" style="background:none; border:1px solid #5c2e2e; color:#ffa8a8; border-radius:10px; padding:10px 18px; font-size:15px; cursor:pointer;">このバッチのピッキングを取消す (最初に戻す)</button>
    </div>
  </div>

  <!-- 完了画面 -->
  <div class="screen" id="scr-done">
    <div class="center">
      <!-- どの出荷フォルダを終えたかを離れた場所からでも読めるサイズで出す (2026-08-14 中原さん要望) -->
      <div id="doneTitle" style="font-size: clamp(28px, 9vw, 56px); font-weight: 800; color: #69db7c; line-height: 1.25; margin-bottom: 10px;">✅ ピッキング完了</div>
      <div class="stats" id="doneStats"></div>
      <a href="/apps/picking/" class="bigbtn" style="display:block; text-decoration:none; line-height:1.2; padding:20px 0;">一覧へ戻る</a>
      <button id="undoDoneBtn" style="background:#1c2127; color:#adb5bd; border:1px solid #343a40; border-radius:10px; padding:10px 18px; font-size:15px; cursor:pointer;">← 誤操作で完了した (最後の明細に戻る)</button>
    </div>
  </div>

  <!-- 他作業者ブロック画面 -->
  <div class="screen" id="scr-blocked">
    <div class="center">
      <h2>作業中のバッチです</h2>
      <div class="meta" id="blockedMsg"></div>
      <button class="bigbtn" id="takeoverBtn" style="background:#e8590c;">交代して続ける</button>
      <div class="meta" style="font-size:13px;">担当を選び間違えたときや、実際に人が替わったときに使います</div>
    </div>
  </div>

  <!-- 欠品数量シート (2段階: 数量選択 → 送信確認。誤タップでの記録+LINE通知を防ぐ) -->
  <div id="shortSheet" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:50; align-items:center; justify-content:center;">
    <div style="background:#1c2127; border-radius:14px; padding:20px; max-width:340px; width:90%; text-align:center;">
      <div id="shortStep1">
        <h3 style="margin:0 0 6px; font-size:1.05em;">⚠ 欠品の数量</h3>
        <div id="shortInfo" style="color:#adb5bd; font-size:0.9em; margin-bottom:12px;"></div>
        <div style="display:flex; align-items:center; justify-content:center; gap:18px; margin-bottom:16px;">
          <button id="shortMinus" style="width:56px; height:56px; font-size:28px; border-radius:12px; border:1px solid #343a40; background:#111418; color:#f1f3f5;">−</button>
          <span id="shortQty" style="font-size:44px; font-weight:800; min-width:70px; font-variant-numeric:tabular-nums;">1</span>
          <button id="shortPlus" style="width:56px; height:56px; font-size:28px; border-radius:12px; border:1px solid #343a40; background:#111418; color:#f1f3f5;">＋</button>
        </div>
        <button id="shortConfirm" style="width:100%; padding:14px; border:none; border-radius:12px; background:#e03131; color:#fff; font-size:1.1em; font-weight:700; cursor:pointer;">欠品として記録する</button>
        <button id="shortCancel" style="width:100%; margin-top:8px; padding:10px; border:none; background:none; color:#868e96; font-size:1em; cursor:pointer;">キャンセル</button>
      </div>
      <div id="shortStep2" style="display:none;">
        <h3 style="margin:0 0 10px; font-size:1.05em;">⚠ 確認</h3>
        <div id="shortStep2Info" style="color:#f1f3f5; font-size:1.0em; line-height:1.7; margin-bottom:16px;"></div>
        <div style="color:#adb5bd; font-size:0.9em; margin-bottom:16px;">欠品として記録し、管理者へLINEで通知を送信しますか?</div>
        <button id="shortYes" style="width:100%; padding:16px; border:none; border-radius:12px; background:#e03131; color:#fff; font-size:1.15em; font-weight:700; cursor:pointer;">はい、送信する</button>
        <button id="shortNo" style="width:100%; margin-top:8px; padding:12px; border:1px solid #343a40; border-radius:12px; background:#111418; color:#adb5bd; font-size:1.05em; cursor:pointer;">いいえ、やめる</button>
      </div>
    </div>
  </div>

  <!-- 中断理由シート -->
  <div id="pauseSheet" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:50; align-items:center; justify-content:center;">
    <div style="background:#1c2127; border-radius:14px; padding:20px; max-width:340px; width:90%;">
      <h3 style="margin:0 0 12px; font-size:1.05em; text-align:center;">中断の理由</h3>
      <div style="display:grid; gap:10px;">
        <% for (const r of pauseReasons) { %>
          <button class="pause-opt" data-reason="<%= r %>" style="padding:16px 8px; font-size:1.05em; border:1px solid #343a40; border-radius:10px; background:#111418; color:#f1f3f5; cursor:pointer;"><%= r %></button>
        <% } %>
      </div>
      <button id="pauseCancel" style="width:100%; margin-top:12px; padding:10px; border:none; background:none; color:#868e96; font-size:1em; cursor:pointer;">キャンセル</button>
    </div>
  </div>

  <!-- 作業者選択 (共用端末モード) -->
  <div id="workerPick" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:50; align-items:center; justify-content:center;">
    <div style="background:#1c2127; border-radius:14px; padding:20px; max-width:340px; width:90%;">
      <h3 style="margin:0 0 12px; font-size:1.05em;">作業者を選んでください</h3>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
        <% for (const w of workers) { %>
          <button class="worker-opt" data-code="<%= w.code %>" data-name="<%= w.name %>"
            style="padding:16px 8px; font-size:1.05em; border:1px solid #343a40; border-radius:10px; background:#111418; color:#f1f3f5; cursor:pointer;"><%= w.name %></button>
        <% } %>
      </div>
    </div>
  </div>

  <script src="/apps/picking/next-sign.js"></script>
  <script>
    const BATCH = <%- JSON.stringify({
      id: state.batch.id, status: state.batch.status, worker: state.batch.worker,
      startedAt: state.batch.started_at, lineCount: state.lines.length,
      totalQty: state.batch.total_qty, currentSeq: state.currentSeq,
      pauseReason: state.batch.pause_reason || null,
      folderName: state.batch.folder_name || null,
    }).replace(/</g, '\\u003c') %>;
    const LINES = <%- JSON.stringify(state.lines.map((l) => ({
      seq: l.seq, loc: l.locationLabel, sku: l.sku, name: l.product_name || '',
      qty: l.qty, status: l.status, img: l.imageUrl,
      block: l.block || '', location: l.location || '',   // NEXTサインの判定用 (生のロケ)
    }))).replace(/</g, '\\u003c') %>;
    // ロケーション動線マスタ (面)。判定は next-sign.js (サーバーと同じコード)
    const FACES = <%- JSON.stringify(faces || []).replace(/</g, '\\u003c') %>;
    const FACE_INDEX = window.NextSign ? NextSign.buildIndex(FACES) : null;
    // セッションログイン時は email が入る。共用端末モードは null
    const SESSION_WORKER = <%- JSON.stringify(worker).replace(/</g, '\\u003c') %>;
    const DEVICE_MODE = !SESSION_WORKER;
    // 計測の識別子: 選択された作業者名を最優先 (ログイン中でも「実際にピッキングする人」を選ぶ運用)。
    // 未選択のセッションユーザーのみ本人 (email) として扱う
    let ME = localStorage.getItem('pk_worker_name') || SESSION_WORKER || null;
    function workerCode() { return localStorage.getItem('pk_worker_code') || null; }
    // 明細ごとの「最後に完了させた next の op_id」(backの取り消し対象指定に使う)
    const NEXTOPS = <%- JSON.stringify(state.lastNextOps || {}).replace(/</g, '\\u003c') %>;

    const $ = (id) => document.getElementById(id);
    const QKEY = `pk_queue_${BATCH.id}`;

    // ── ローカル状態: サーバー状態 + 未送信キューを再適用して復元 ──
    let queue = [];
    try { queue = JSON.parse(localStorage.getItem(QKEY) || '[]'); } catch {}
    for (const op of queue) {
      if (op.event === 'pause') BATCH.status = 'paused';
      if (op.event === 'resume') BATCH.status = 'picking';
      if (op.event === 'cancel') BATCH.cancelling = true;   // リロード後も flush が処理して一覧へ戻す
      const line = LINES.find((l) => l.seq === op.line_seq);
      if (!line) continue;
      if (op.event === 'next') { line.status = 'done'; NEXTOPS[op.line_seq] = op.op_id; }
      if (op.event === 'shortage') { line.status = 'shortage'; line.shortage_qty = op.shortage_qty; NEXTOPS[op.line_seq] = op.op_id; }
      if (op.event === 'back') { line.status = 'pending'; line.shortage_qty = null; }
    }
    // 中断中 (paused) も「開始済み」。中断中に画面を開き直してから再開すると、これが false のままで
    // render() が開始画面に飛び「再開できない」ように見えた (2026-08-25 出荷_02 中原さん報告)
    let started = BATCH.status === 'picking' || BATCH.status === 'paused' || queue.some((op) => op.event === 'start');

    function currentIdx() { return LINES.findIndex((l) => l.status === 'pending'); }

    // ── 画面切替・描画 ──
    function show(id) {
      document.querySelectorAll('.screen').forEach((s) => s.classList.remove('active'));
      $(id).classList.add('active');
    }

    // 楽天白抜き画像 (公開URL)。読み込み失敗時はプレースホルダに戻す。
    // 次の明細を先読みしておく (棚間の移動中にロードを済ませる)
    function renderImage(l) {
      const box = $('imgbox');
      if (!l.img) { box.innerHTML = '<span class="noimg">画像なし</span>'; return; }
      const img = new Image();
      img.onload = () => { box.innerHTML = ''; box.appendChild(img); };
      img.onerror = () => { box.innerHTML = '<span class="noimg">画像なし</span>'; };
      img.src = l.img;
      if (!img.complete) box.innerHTML = '<span class="noimg">…</span>';
      const idx = LINES.indexOf(l);
      const next = LINES.slice(idx + 1).find((x) => x.status === 'pending');
      if (next && next.img) { const pre = new Image(); pre.src = next.img; }
    }

    function splitName(name) {
      // 商品名末尾の資材/ライン識別サフィックス (_梱機プ 等) は視認ノイズなので淡色で分離
      const m = name.match(/^(.*)(_[^_]{1,8})$/);
      return m ? { main: m[1], suffix: m[2] } : { main: name, suffix: '' };
    }

    // ── ロケ色分け (2026-08-12 中原さん採用。ラベル形式 = ブロック-棚3桁-連3桁-段2桁) ──
    // 背景色 = 棚番号 mod 8。連続する棚番号 (002→003) が必ず別色になるので、ルート上の
    // 「棚が変わった」がほぼ確実に色変化として見える。8色では「色→棚」の暗記は成立しないが、
    // 狙いは暗記ではなく「今と次が同じ色か」の比較判断 (色覚多様性を考慮し隣接indexは色相を離す)。
    // 白太字 (大サイズ) が読めるようダーク寄りの色のみ。テキストが常に主役で色は補助。
    const SHELF_BG = [
      '#1864ab', // 青
      '#9c5700', // 橙
      '#6741d9', // 紫
      '#6e6600', // オリーブ
      '#0b7285', // ティール
      '#a61e4d', // マゼンタ
      '#2f7d32', // 緑
      '#545b62', // グレー
    ];
    // 左帯 = ブロック。実在ブロックは4つ (2026-08-12 実データ) なので固定の明色で「覚える」が成立する。
    // 未知のブロックが増えても文字列ハッシュで安定した色が付く (再デプロイ不要)
    const KNOWN_BLOCKS = ['P3FA', 'P3FB', 'P3FD', 'P3FF'];
    const BLOCK_COLORS = ['#ffa94d', '#4dabf7', '#69db7c', '#e599f7', '#ffd43b', '#ff8787'];
    function blockColor(block) {
      let i = KNOWN_BLOCKS.indexOf(block);
      if (i === -1) {
        let h = 5381;
        for (const c of block) h = (h * 33 + c.charCodeAt(0)) >>> 0;
        i = h % BLOCK_COLORS.length;
      }
      return BLOCK_COLORS[i % BLOCK_COLORS.length];
    }
    // 「次 → P3FB-002-016-04」のような接頭辞付きでも拾えるよう末尾アンカーのみ。
    // 形式外のラベル (8桁でない生ロケ等) は null → 無着色・そのまま読み上げ (fail-soft)
    function locParts(label) {
      const m = /(?:^|[ →])(?:(\S+)-)?(\d{3})-(\d{3})-(\d{2})$/.exec(String(label || ''));
      return m
        ? { block: m[1] || null, shelf: parseInt(m[2], 10), ren: parseInt(m[3], 10), dan: parseInt(m[4], 10) }
        : null;
    }
    function paintLoc(el, label) {
      const p = locParts(label);
      el.style.backgroundColor = p ? SHELF_BG[p.shelf % SHELF_BG.length] : '';
      el.style.borderLeftColor = (p && p.block) ? blockColor(p.block) : 'transparent';
    }

    // ── 音声読み上げ (2026-08-12 中原さん要望): ロケと数量を耳で受け取り、画面を見ずに歩き出せる ──
    // 読み上げ = 「(ブロックが変わった時だけ) ブロック名、」+「棚の連の段、N個」。
    // 毎回フルコードを読むと冗長なので、色分けと同じ思想で「変わった時だけブロックを言う」。
    // iOS制約: 初回speakはユーザー操作起点が必要 → トグル押下/最初のタップでアンロックする。
    // ⚠ サイレントスイッチONのiPhoneは読み上げも消音される (倉庫端末は音量ON運用が前提)
    // 読み上げは常時オン (2026-08-23 中原さん決定。トグルは撤去)。端末のサイレントスイッチで消音はできる
    const voiceOn = true;
    let lastSpokenSeq = null;
    let lastSpokenBlock = null;
    function speak(text) {
      if (!('speechSynthesis' in window)) return;
      try {
        speechSynthesis.cancel();   // 前の読み上げが残っていたら打ち切って最新を優先
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'ja-JP';
        u.rate = 1.1;
        speechSynthesis.speak(u);
      } catch { /* 読み上げは補助機能。失敗しても画面表示があるので無音のまま続行 */ }
    }
    function speakLine(l, force) {
      if (!voiceOn || !l) return;
      if (!force && l.seq === lastSpokenSeq) return;   // 同じ明細の再render (画像後追い等) では繰り返さない
      const p = locParts(l.loc);
      // 数量2以上は「複数」を前置して聞き逃しを防ぐ (2026-08-14 中原さん要望。
      // 数字の聞き間違いより「複数かどうか」を先に耳で確定させる)
      const qtyPart = l.qty >= 2 ? `複数、${l.qty}個` : `${l.qty}個`;
      let text;
      if (p) {
        // ブロック名は1文字ずつ区切って「ピー サン エフ ビー」と読ませる
        const blockPart = (p.block && p.block !== lastSpokenBlock) ? `${p.block.split('').join(' ')}、` : '';
        text = `${blockPart}${p.shelf}の${p.ren}の${p.dan}、${qtyPart}`;
      } else {
        text = `${l.loc}、${qtyPart}`;   // 形式外ラベルはそのまま
      }
      // 動作語 (折り返す/N つ目/N 段目) は読まない — 2026-08-25 現場FB「情報量が多すぎる」。
      // 読み上げは ロケ+個数 だけ。動線は画面のNEXTサインで見る
      speak(text);
      lastSpokenSeq = l.seq;
      if (p && p.block) lastSpokenBlock = p.block;
    }

    function render() {
      const idx = currentIdx();
      const done = LINES.filter((l) => l.status !== 'pending').length;
      $('progress').textContent = `${Math.min(done + 1, LINES.length)} / ${LINES.length}`;
      if (BATCH.status === 'paused') {
        $('pausedMeta').textContent = `理由: ${BATCH.pauseReason || '-'} (中断時間は計測から除外されます)`;
        show('scr-paused');
        return;
      }
      if (BATCH.status === 'done' && queue.length === 0 || idx === -1) {
        renderDone();
        return;
      }
      if (!started) { show('scr-start'); return; }
      const l = LINES[idx];
      $('loc').textContent = l.loc;
      paintLoc($('loc'), l.loc);
      speakLine(l);
      fitText($('loc'));
      const next = LINES.slice(idx + 1).find((x) => x.status === 'pending');
      // 帯 = 「直前に取った場所」から今の場所への動き (ルート順で手前の完了済み明細)
      let prev = null;
      for (let i = idx - 1; i >= 0; i--) if (LINES[i].status !== 'pending') { prev = LINES[i]; break; }
      renderBand(prev, l);
      renderNextLoc(next);
      renderImage(l);
      $('qty').innerHTML = `<span class="x">×</span>${l.qty}`;
      $('qty').className = l.qty >= 2 ? 'multi' : '';
      const n = splitName(l.name);
      $('pname').innerHTML = `${esc(n.main)}<span class="suffix">${esc(n.suffix)}</span>`;
      $('psku').textContent = l.sku;
      $('backBtn').style.visibility = LINES.some((x) => x.status === 'done') ? 'visible' : 'hidden';
      show('scr-pick');
      fitText($('loc'));   // 表示後 (幅確定後) にもう一度フィットさせる
    }

    // ── NEXTサイン描画 ──
    // 矢印 (SVG)。高さは CSS の --icon-h、幅は viewBox 比
    const SW = 14;
    const head = (x, y, dir) => {
      const s = SW * 1.25;
      const pts = { l: `${x},${y} ${x + s},${y - s} ${x + s},${y + s}`, r: `${x},${y} ${x - s},${y - s} ${x - s},${y + s}`,
                    u: `${x},${y} ${x - s},${y + s} ${x + s},${y + s}`, d: `${x},${y} ${x - s},${y - s} ${x + s},${y - s}` }[dir];
      return `<polygon class="hd" points="${pts}"/>`;
    };
    const svg = (inner, vb = '0 0 120 80') => `<svg class="icon" viewBox="${vb}" aria-hidden="true">${inner}</svg>`;
    const ICONS = {
      left:    () => svg(`<path class="st" stroke-width="${SW}" d="M112 40 H28"/>${head(16, 40, 'l')}`),
      right:   () => svg(`<path class="st" stroke-width="${SW}" d="M8 40 H92"/>${head(104, 40, 'r')}`),
      // 振り向く: 右から上がって左へ降りる (棚に向かって左へ進む向き — 2026-08-23 中原さん)
      turn:    () => svg(`<path class="st" stroke-width="${SW}" d="M66 68 V34 a20 20 0 0 0 -40 0 V56"/>${head(26, 68, 'd')}`, '0 0 90 80'),
      // 折り返す: 右端で回って左へ戻るヘアピン
      hairpin: () => svg(`<path class="st" stroke-width="${SW}" d="M20 22 H112 a18 18 0 0 1 0 36 H60"/>${head(48, 58, 'l')}<rect class="blk" x="16" y="36" width="100" height="8" rx="3"/>`, '0 0 160 80'),
      around:  () => svg(`<polygon class="blk" points="60,64 60,48 72,48 72,36 84,36 84,24 100,24 100,64"/><path class="st" stroke-width="${SW}" d="M28 66 V16 H132 V50"/>${head(132, 64, 'd')}`, '0 0 160 80'),
      across:  () => svg(`<polygon class="blk" points="44,68 44,52 58,52 58,38 72,38 72,24 86,24 86,68"/><path class="st" stroke-width="${SW}" d="M20 40 H104"/>${head(116, 40, 'r')}`, '0 0 140 80'),
      far:     () => svg(`<path class="st" stroke-width="${SW}" d="M16 40 H128"/>${head(140, 40, 'r')}<circle class="mk" cx="160" cy="40" r="11"/>`, '0 0 180 80'),
      pouch:   () => svg(`<path class="st" stroke-width="6" d="M22 28 H58 L62 66 H18 Z M30 28 a10 10 0 0 1 20 0"/><path class="st" stroke-width="4" d="M26 44 H54"/>`, '0 0 80 80'),
      unknown: () => svg(`<path class="st" stroke-width="7" d="M40 70 C40 70 14 46 14 30 a26 26 0 0 1 52 0 C66 46 40 70 40 70 Z"/><text x="40" y="40" text-anchor="middle" font-size="30" font-weight="800" fill="#f1f3f5">?</text>`, '0 0 80 80'),
    };
    // descriptor (next-sign.js の describe) → 帯のHTML。3ゾーン [動作|連|段]、動作なしは2ゾーン
    function signHtml(d) {
      const act = d.act && d.act.icon
        ? `<div class="zone act"><div class="main">${ICONS[d.act.icon] ? ICONS[d.act.icon]() : ''}</div><div class="verb">${esc(d.act.verb)}</div></div>` : '';
      let renMain = '', renSub = '';
      const r = d.ren || {};
      if (r.here) { renMain = `<span class="here">ここ</span>`; renSub = r.sub || ''; }
      else if (r.code) { renMain = `<span class="code">${esc(r.code)}</span>`; renSub = r.words || ''; }
      else { renMain = `${r.icon && ICONS[r.icon] ? ICONS[r.icon]() : ''}<span class="n">${r.n}${r.unit ? `<small>${esc(r.unit)}</small>` : ''}</span>`; renSub = r.words || ''; }
      const ren = `<div class="zone ren"><div class="main">${renMain}</div>${renSub ? `<div class="sub">${esc(renSub)}</div>` : ''}</div>`;
      let dan = '<div class="zone dan"><div class="sub">—</div></div>';
      if (d.dan) {
        const abs = d.dan.label === 'ポケット'
          ? `<span class="v pk"><small>ポケット</small>${d.dan.abs}</span>`
          : `<span class="v">${d.dan.abs}<small>段目</small></span>`;
        dan = `<div class="zone dan">${d.dan.rel ? `<div class="main"><span class="rel">${esc(d.dan.rel)}</span></div>` : ''}<div class="main">${abs}</div></div>`;
      }
      return `<div class="zones${act ? '' : ' two'}">${act}${ren}${dan}</div>`;
    }
    // 帯: prev (直前に取った場所) → cur (今の場所) の動き。1件目は「開始」。マスタ未取得なら帯ごと消す
    function renderBand(prev, cur) {
      const el = $('band');
      if (!window.NextSign || !FACE_INDEX) { el.className = 'signbox empty'; el.innerHTML = ''; return; }
      if (!prev) { el.className = 'signbox'; el.innerHTML = '<div class="start">▶ 開始 — 最初の場所</div>'; return; }
      const d = NextSign.describe(FACE_INDEX, { block: prev.block, location: prev.location }, { block: cur.block, location: cur.location });
      el.className = d.heavy ? 'signbox heavy' : 'signbox';
      el.innerHTML = signHtml(d);
    }
    // 「次へ」の上: 次ロケのコード1行。左帯は次の棚の色 (今のロケ背景と同じ色 = 同じ棚 = 近い)
    function renderNextLoc(next) {
      const el = $('nextloc');
      if (!next) { el.className = 'last'; $('nextlocCode').textContent = 'これが最後の商品'; el.style.borderLeftColor = '#3a4250'; return; }
      el.className = '';
      $('nextlocCode').textContent = next.loc;
      const p = locParts(next.loc);
      el.style.borderLeftColor = p ? SHELF_BG[p.shelf % SHELF_BG.length] : '#3a4250';
    }

    // 1行に収まるまでフォントを縮める (ロケーションの折り返し禁止。桁の見間違い防止)
    function fitText(el) {
      const landscape = matchMedia('(orientation: landscape)').matches;
      const max = landscape ? 44 : (window.innerHeight <= 720 ? 44 : 54);   // CSSの段階縮小と揃える
      let size = max;
      el.style.fontSize = size + 'px';
      // scrollWidth が収まるまで2pxずつ縮小 (下限22px)
      while (size > 22 && el.scrollWidth > el.clientWidth) {
        size -= 2;
        el.style.fontSize = size + 'px';
      }
    }
    window.addEventListener('resize', () => {
      const idx = currentIdx();
      if (idx !== -1 && started) { $('loc').textContent = LINES[idx].loc; fitText($('loc')); }
    });

    function renderDone() {
      // 「出荷_28 完了しました。」— フォルダ名が無い手動取込バッチは従来表示のまま
      const folderJa = BATCH.folderName ? BATCH.folderName.replace('_', ' ') : null;
      if (folderJa) $('doneTitle').textContent = `✅ ${folderJa} 完了しました`;
      // 作業からの遷移時のみ完了を読み上げ (完了済みバッチを開いただけでは喋らない)
      if (voiceOn && lastSpokenSeq != null) {
        speak(folderJa ? `${folderJa}、ピッキング完了` : 'ピッキング完了');
        lastSpokenSeq = null;
      }
      const startMs = BATCH.startedAt ? Date.parse(BATCH.startedAt) : null;
      const secs = startMs ? Math.max(0, Math.round((Date.now() - startMs) / 1000)) : null;
      const perLine = secs != null && LINES.length > 0 ? (secs / LINES.length).toFixed(1) : '-';
      const shorts = LINES.filter((l) => l.status === 'shortage');
      $('doneStats').innerHTML =
        `明細 <b>${LINES.length}</b> 件 / 数量 <b>${BATCH.totalQty}</b><br>` +
        (secs != null ? `所要 <b>${Math.floor(secs / 60)}</b> 分 ${secs % 60} 秒 (約${perLine}秒/明細)` : '') +
        (shorts.length > 0
          ? `<br><span style="color:#ffa8a8">⚠ 欠品 ${shorts.length} 件</span><br>` +
            shorts.map((l) => `<span style="font-size:0.75em; color:#ffa8a8">${esc(l.loc)} ${esc(l.sku)} 欠品${l.shortage_qty}</span>`).join('<br>')
          : '');
      show('scr-done');
    }

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // ── 操作 → ローカル即時反映 + キュー投入 (通信を待たない: 要件§6 <200ms) ──
    function opId() { return `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`; }

    function enqueue(event, lineSeq, undoOpId, extra) {
      const op = {
        op_id: opId(), event, line_seq: lineSeq ?? null,
        undo_op_id: undoOpId ?? null, client_at: new Date().toISOString(),
        worker_code: workerCode(),   // 共用端末モードの作業者 (セッション時は null で無視される)
        ...(extra || {}),
      };
      if (event === 'next' || event === 'shortage') NEXTOPS[lineSeq] = op.op_id;
      queue.push(op);
      localStorage.setItem(QKEY, JSON.stringify(queue));
      flush();
    }

    $('startBtn').addEventListener('click', () => {
      started = true;
      enqueue('start', null);
      render();
    });

    $('nextBtn').addEventListener('click', () => {
      const idx = currentIdx();
      if (idx === -1) return;
      LINES[idx].status = 'done';
      enqueue('next', LINES[idx].seq);
      if (navigator.vibrate) navigator.vibrate(15);
      render();
    });

    function doBack() {
      const doneLines = LINES.filter((l) => l.status === 'done' || l.status === 'shortage');
      if (doneLines.length === 0) return;
      const last = doneLines[doneLines.length - 1];
      last.status = 'pending';
      last.shortage_qty = null;
      if (BATCH.status === 'done') BATCH.status = 'picking';   // 完了直後の取り消し (サーバーも同挙動)
      enqueue('back', last.seq, NEXTOPS[last.seq] || null);
      render();
    }
    $('backBtn').addEventListener('click', doBack);
    $('undoDoneBtn').addEventListener('click', doBack);

    // ロケ表示のタップ = 再読み上げ (聞き逃し対策。ブロック名も含めて読み直す)
    $('loc').addEventListener('click', () => {
      const idx = currentIdx();
      if (started && idx !== -1) { lastSpokenBlock = null; speakLine(LINES[idx], true); }
    });
    // iOS は最初のユーザー操作で speechSynthesis をアンロックする必要がある (capture=ボタン処理より先)
    document.addEventListener('click', () => { speak(''); }, { once: true, capture: true });

    // ── 欠品 (数量ステッパー: 既定=全量欠品。一部だけ取れたときは減らす) ──
    let shortTarget = null;
    let shortVal = 1;
    $('shortBtn').addEventListener('click', () => {
      const idx = currentIdx();
      if (idx === -1) return;
      shortTarget = LINES[idx];
      shortVal = shortTarget.qty;
      $('shortInfo').textContent = `${shortTarget.loc}｜${shortTarget.sku} (指示 ${shortTarget.qty}個)`;
      $('shortQty').textContent = shortVal;
      $('shortSheet').style.display = 'flex';
    });
    $('shortMinus').addEventListener('click', () => { if (shortVal > 1) $('shortQty').textContent = --shortVal; });
    $('shortPlus').addEventListener('click', () => { if (shortTarget && shortVal < shortTarget.qty) $('shortQty').textContent = ++shortVal; });
    function closeShortSheet() {
      $('shortSheet').style.display = 'none';
      $('shortStep1').style.display = 'block';
      $('shortStep2').style.display = 'none';
    }
    $('shortCancel').addEventListener('click', closeShortSheet);
    // 1段階目: 数量確定 → 確認画面へ (ここではまだ何も記録しない)
    $('shortConfirm').addEventListener('click', () => {
      if (!shortTarget) return;
      $('shortStep2Info').innerHTML =
        `${esc(shortTarget.loc)}<br><b>${esc(splitName(shortTarget.name).main)}</b><br>欠品 <b style="font-size:1.4em">${shortVal}</b> 個 (指示 ${shortTarget.qty} 個)`;
      $('shortStep1').style.display = 'none';
      $('shortStep2').style.display = 'block';
    });
    // 2段階目: はい=記録+LINE通知 / いいえ=何もせず閉じる (誤タップ対策)
    $('shortYes').addEventListener('click', () => {
      if (!shortTarget) return;
      closeShortSheet();
      shortTarget.status = 'shortage';
      shortTarget.shortage_qty = shortVal;
      enqueue('shortage', shortTarget.seq, null, { shortage_qty: shortVal });
      if (navigator.vibrate) navigator.vibrate([30, 50, 30]);
      render();
    });
    $('shortNo').addEventListener('click', closeShortSheet);

    // ── 中断 / 再開 / 取消 ──
    $('pauseBtn').addEventListener('click', () => { $('pauseSheet').style.display = 'flex'; });
    $('pauseCancel').addEventListener('click', () => { $('pauseSheet').style.display = 'none'; });
    document.querySelectorAll('.pause-opt').forEach((btn) => btn.addEventListener('click', () => {
      $('pauseSheet').style.display = 'none';
      BATCH.status = 'paused';
      BATCH.pauseReason = btn.dataset.reason;
      enqueue('pause', null, null, { pause_reason: btn.dataset.reason });
      render();
    }));
    $('resumeBtn').addEventListener('click', () => {
      BATCH.status = 'picking';
      BATCH.pauseReason = null;
      enqueue('resume', null, null);
      render();
    });
    $('cancelBtn').addEventListener('click', () => {
      if (!confirm('このバッチのピッキングを取り消して最初に戻します。よろしいですか?\n(進捗と時間の記録は破棄されます)')) return;
      // 直接fetchせずキューに積む (先行する操作の順序を守る。オフラインでも復帰後に処理される
      // — Codex PR4 high)。送信完了は flush() が検知して一覧へ戻す
      $('syncerr').textContent = '取消を送信しています… (完了すると一覧に戻ります)';
      $('syncerr').style.background = '#495057';
      $('syncerr').style.display = 'block';
      $('resumeBtn').disabled = true;
      $('cancelBtn').disabled = true;
      enqueue('cancel', null, null);
    });

    // ── キュー送信 (直列・冪等再送) ──
    let flushing = false;
    async function flush() {
      if (flushing) return;
      flushing = true;
      try {
        while (queue.length > 0) {
          const op = queue[0];
          let res;
          try {
            res = await fetch(`/apps/picking/api/batches/${BATCH.id}/events`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(op),
            });
          } catch {
            $('offline').style.display = 'block';
            setTimeout(flush, 3000);   // ネットワーク断: 3秒後に再送 (opは残す)
            return;
          }
          $('offline').style.display = 'none';
          if (res.ok) {
            const body = await res.json();
            if (body.batchStatus) BATCH.status = body.batchStatus;
            if (body.startedAt) BATCH.startedAt = body.startedAt;
            queue.shift();
            localStorage.setItem(QKEY, JSON.stringify(queue));
            if (op.event === 'cancel') {
              // 取消がサーバーに届いたら一覧へ (それ以前の操作は上で順に確定済み)
              localStorage.removeItem(QKEY);
              location.href = '/apps/picking/';
              return;
            }
            if (BATCH.status === 'done' && queue.length === 0) render();
            continue;
          }
          // 業務エラー: サーバーが正。キューを破棄してサーバー状態に合わせ直す
          const body = await res.json().catch(() => ({}));
          queue = [];
          localStorage.removeItem(QKEY);
          $('syncerr').textContent = `同期エラー: ${body.error || res.status} — 画面を再読み込みします`;
          $('syncerr').style.display = 'block';
          setTimeout(() => location.reload(), 2500);
          return;
        }
      } finally {
        flushing = false;
      }
    }

    // ── スワイプ操作 (誤タップ対策の併用手段。ボタンはそのまま残す) ──
    // 左スワイプ = 次へ / 右スワイプ = 前へ戻る。60px以上の水平移動で発火
    let touchStart = null;
    document.addEventListener('touchstart', (e) => {
      if (e.touches.length !== 1) { touchStart = null; return; }
      touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY, at: Date.now() };
    }, { passive: true });
    document.addEventListener('touchend', (e) => {
      if (!touchStart || !started) return;
      if (!$('scr-pick').classList.contains('active')) return;
      const dx = e.changedTouches[0].clientX - touchStart.x;
      const dy = e.changedTouches[0].clientY - touchStart.y;
      touchStart = null;
      if (Math.abs(dx) < 60 || Math.abs(dy) > Math.abs(dx)) return;   // 縦振れ・短距離は無視
      if (dx < 0) $('nextBtn').click();
      else doBack();
    }, { passive: true });

    // ── Bluetoothリモコンのキー操作 (JX-05等のHIDリング 2026-08-15 中原さん要望) ──
    // ページ送り系モードのリングはBluetoothキーボードとして矢印/PageUp/Down等を送る。
    //   前進系キー = 次へ (画面下タップと同じ) / 後退系キー = 今のロケを再読み上げ
    //   (誤押下で作業が巻き戻らないよう「戻る」はキーに割り当てない。戻るは画面ボタンで)
    // ⚠ リングのカメラ/音量モードはiOSが音量キーとして消費し、ブラウザには届かない。
    //   対応外キーは画面下に小さくキー名を出す = どのモードで何が届くかの現地調整用
    const KEYS_NEXT = ['ArrowDown', 'ArrowRight', 'PageDown', ' ', 'Enter', 'MediaTrackNext'];
    const KEYS_SPEAK = ['ArrowUp', 'ArrowLeft', 'PageUp', 'MediaTrackPrevious'];
    let lastRemoteKeyAt = 0;
    function sheetOpen() {
      return ['shortSheet', 'pauseSheet', 'workerPick'].some((id) => {
        const el = $(id);
        return el && el.style.display !== 'none' && el.style.display !== '';
      });
    }
    function keyToast(msg) {
      let el = $('keyToast');
      if (!el) {
        el = document.createElement('div');
        el.id = 'keyToast';
        el.style.cssText = 'position:fixed; bottom:8px; left:50%; transform:translateX(-50%); background:#343a40; color:#dee2e6; padding:4px 12px; border-radius:8px; font-size:13px; z-index:99; opacity:0.9; pointer-events:none;';
        document.body.appendChild(el);
      }
      el.textContent = msg;
      el.style.display = 'block';
      clearTimeout(el._t);
      el._t = setTimeout(() => { el.style.display = 'none'; }, 2000);
    }
    document.addEventListener('keydown', (e) => {
      if (e.repeat) return;                                    // 長押しの自動リピートで連打しない
      const tag = (e.target && e.target.tagName) || '';
      if (/INPUT|TEXTAREA|SELECT/.test(tag)) return;           // 入力欄への打鍵は素通し
      if (sheetOpen()) return;                                  // 欠品/中断/作業者シート表示中は無効
      if (!started || !$('scr-pick').classList.contains('active')) return;   // 作業中のみ
      if (KEYS_NEXT.includes(e.key)) {
        e.preventDefault();
        const now = Date.now();
        if (now - lastRemoteKeyAt < 350) return;               // チャタリング・二重送信ガード
        lastRemoteKeyAt = now;
        $('nextBtn').click();
      } else if (KEYS_SPEAK.includes(e.key)) {
        e.preventDefault();
        const idx = currentIdx();
        if (idx !== -1 && voiceOn) { lastSpokenBlock = null; speakLine(LINES[idx], true); }
      } else if (e.key !== 'Unidentified') {
        keyToast(`未割当キー: ${e.key}`);                       // リング設定調整の手がかり
      }
    });

    // ── 画像の後追い反映 (取込直後は解決がバックグラウンド進行中のことがある) ──
    // 画像なしの明細が残っている間だけ5秒間隔で最大12回ポーリングし、届き次第反映する
    let imgPolls = 0;
    async function pollImages() {
      if (!LINES.some((l) => !l.img) || imgPolls >= 12) return;
      imgPolls++;
      try {
        const res = await fetch(`/apps/picking/api/batches/${BATCH.id}/images`);
        if (res.ok) {
          const body = await res.json();
          let updated = false;
          for (const l of LINES) {
            if (!l.img && body.images && body.images[l.seq]) { l.img = body.images[l.seq]; updated = true; }
          }
          if (updated) {
            const idx = currentIdx();
            if (idx !== -1 && started) renderImage(LINES[idx]);
          }
          if (!LINES.some((l) => !l.img)) return;   // 全部揃ったら終了
        }
      } catch { /* オフライン中は次回に任せる */ }
      setTimeout(pollImages, 5000);
    }
    pollImages();

    // ── Wake Lock (iOS 16.4+)。タブ復帰時に再取得 ──
    let wakeLock = null;
    async function acquireWakeLock() {
      try {
        if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen');
      } catch { /* 低電力モード等で拒否されても作業は継続できる */ }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') { acquireWakeLock(); flush(); }
    });
    window.addEventListener('online', flush);

    // ── 経過時間表示 ──
    setInterval(() => {
      if (!BATCH.startedAt || BATCH.status === 'done') return;
      const s = Math.max(0, Math.round((Date.now() - Date.parse(BATCH.startedAt)) / 1000));
      $('clock').textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }, 1000);

    // ── 初期化・作業者交代 ──
    function refreshWorkerTag() {
      $('workerTag').textContent = ME ? `👤${ME}` : '';
    }
    function boot() {
      refreshWorkerTag();
      if ((BATCH.status === 'picking' || BATCH.status === 'paused')
          && BATCH.worker && BATCH.worker !== ME && queue.length === 0) {
        $('blockedMsg').textContent = `${BATCH.worker} さんが${BATCH.status === 'paused' ? '中断中' : '作業中'}です`;
        show('scr-blocked');
        return;
      }
      acquireWakeLock();
      flush();
      render();
    }

    // 選択シートは2モード: boot=これから作業する人を選ぶ / takeover=作業中の担当を交代する
    let pickMode = 'boot';
    function openPicker(mode) { pickMode = mode; $('workerPick').style.display = 'flex'; }

    async function doTakeover() {
      try {
        const res = await fetch(`/apps/picking/api/batches/${BATCH.id}/events`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ op_id: opId(), event: 'takeover', worker_code: workerCode() }),
        });
        if (res.ok) {
          BATCH.worker = ME;
          boot();
        } else {
          const b = await res.json().catch(() => ({}));
          alert(b.error || '交代に失敗しました');
        }
      } catch {
        alert('通信エラーです。電波のある場所でもう一度お試しください');
      }
    }

    document.querySelectorAll('.worker-opt').forEach((btn) => btn.addEventListener('click', () => {
      localStorage.setItem('pk_worker_code', btn.dataset.code);
      localStorage.setItem('pk_worker_name', btn.dataset.name);
      ME = btn.dataset.name;
      $('workerPick').style.display = 'none';
      refreshWorkerTag();
      if (pickMode === 'takeover') doTakeover();
      else boot();
    }));

    $('takeoverBtn').addEventListener('click', () => openPicker('takeover'));
    // 作業中に👤タグをタップ → 交代 (開始前なら単なる選び直し)
    $('workerTag').addEventListener('click', () => {
      openPicker(BATCH.status === 'picking' ? 'takeover' : 'boot');
    });

    if (DEVICE_MODE && !ME) {
      openPicker('boot');   // 作業者を選んでから boot する
    } else {
      boot();
    }
  </script>
</body>
</html>
