<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="manifest" href="/apps/picking/manifest.json">
  <link rel="apple-touch-icon" href="/favicon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    /* スマホ前提のカード型一覧 (テーブルはやめる)。PCでも同じカードが並ぶ */
    .pk-wrap { max-width: 720px; margin: 0 auto; padding: 10px 12px 40px; }
    .pk-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
    .pk-bar input[type=date] { padding: 7px; font-size: 16px; }
    .muted { color: #868e96; font-size: 0.85em; }
    .pk-empty { color: #868e96; padding: 40px 0; text-align: center; }

    .card {
      background: #fff; border: 1px solid #dee2e6; border-radius: 12px;
      padding: 12px 14px; margin-bottom: 10px;
      display: flex; gap: 12px; align-items: center;
    }
    .card.done { opacity: 0.55; }
    .card-main { flex: 1 1 auto; min-width: 0; }
    .card-title { font-weight: 700; font-size: 0.98em; line-height: 1.35; margin-bottom: 4px; }
    .card-meta { color: #495057; font-size: 0.85em; display: flex; flex-wrap: wrap; gap: 2px 12px; }
    .card-meta b { font-size: 1.05em; }
    .st { display: inline-block; border-radius: 4px; padding: 1px 8px; background: #e9ecef; font-size: 0.85em; white-space: nowrap; }
    .st.ready { background: #d0ebff; } .st.picking { background: #fff3bf; }
    .st.paused { background: #ffe8cc; } .st.done { background: #d3f9d8; }
    .st.cancelled { background: #f1f3f5; color: #868e96; }

    .card-actions { flex: 0 0 auto; display: flex; flex-direction: column; gap: 6px; align-items: stretch; }
    .btn-work {
      display: block; padding: 14px 22px; border: none; border-radius: 10px;
      background: #1971c2; color: #fff; font-size: 1.05em; font-weight: 700; cursor: pointer;
      text-align: center; white-space: nowrap;
    }
    .btn-work.resume { background: #e8590c; }
    .btn-detail { text-align: center; font-size: 0.85em; color: #495057; text-decoration: none; padding: 4px; }

    /* 担当者選択オーバーレイ (作業ボタンを押したときに出す) */
    #workerPick { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 50;
      align-items: flex-end; justify-content: center; }
    .sheet { background: #fff; border-radius: 16px 16px 0 0; padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
      width: 100%; max-width: 520px; }
    .sheet h3 { margin: 0 0 4px; font-size: 1.1em; }
    .sheet .target { color: #495057; font-size: 0.9em; margin-bottom: 12px; }
    .sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .worker-opt {
      padding: 18px 8px; font-size: 1.15em; font-weight: 600;
      border: 1px solid #ced4da; border-radius: 12px; background: #f8f9fa; cursor: pointer;
    }
    .worker-opt.last { border-color: #1971c2; background: #e7f5ff; }
    .sheet-cancel { margin-top: 12px; width: 100%; padding: 12px; border: none; background: none;
      color: #868e96; font-size: 1em; cursor: pointer; }
  </style>
</head>
<body>
  <%- include('_floor_alerts') %>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">📱 ピッキング支援</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/apps/picking/board" class="btn-logout">🏆 実績</a>
      <% if (isAdmin) { %>
        <a href="/apps/picking/admin/import" class="btn-logout">📥 CS03002取込</a>
        <a href="/apps/picking/admin/summary" class="btn-logout">📊 サマリ</a>
        <a href="/apps/picking/admin/stats" class="btn-logout">📈 実績(30日)</a>
        <a href="/apps/picking/admin/devices" class="btn-logout">📱 端末・作業者</a>
        <a href="/apps/picking/admin/locations" class="btn-logout">🧭 動線マスタ</a>
      <% } %>
      <% if (!deviceMode) { %><a href="/" class="btn-logout">ダッシュボード</a><% } %>
    </div>
  </header>

  <div class="pk-wrap">
    <% if (typeof openTasks !== 'undefined' && openTasks > 0) { %>
      <a href="/apps/picking/tasks" style="display:block; background:#ffe3e3; border:2px solid #e03131; border-radius:12px; padding:12px 16px; margin-bottom:10px; font-size:1.1em; font-weight:800; color:#c92a2a; text-decoration:none;">
        🔴 再ピック・棚戻し <%= openTasks %>件 — タップして対応
      </a>
    <% } %>
    <div class="pk-bar">
      <form method="get" action="/apps/picking/">
        <input type="date" name="date" value="<%= workDate %>" onchange="this.form.submit()">
      </form>
      <span class="muted"><%= batches.length %> バッチ</span>
      <button id="refreshBtn" type="button" style="margin-left:auto; padding:8px 18px; font-size:15px; border:1px solid #ced4da; border-radius:8px; background:#fff; cursor:pointer;">🔄 更新</button>
    </div>

    <% if (batches.length === 0) { %>
      <div class="pk-empty">
        バッチがありません。<% if (isAdmin) { %><a href="/apps/picking/admin/import">CS03002 を取り込む</a><% } else { %>取込が済むとここに表示されます。<% } %>
      </div>
    <% } %>

    <div style="display:flex; gap:8px; margin:10px 0; flex-wrap:wrap;">
      <button type="button" class="fa-send" data-kind="cart" style="padding:12px 14px; border:1px solid #e03131; color:#e03131; background:#fff; border-radius:10px; font-weight:700">🛒 ピッキングカートを送って</button>
      <button type="button" class="fa-send" data-kind="trolley" style="padding:12px 14px; border:1px solid #e03131; color:#e03131; background:#fff; border-radius:10px; font-weight:700">🧺 台車を送って</button>
      <button type="button" class="fa-send" data-kind="lift" style="padding:12px 14px; border:1px solid #e03131; color:#e03131; background:#fff; border-radius:10px; font-weight:700">🛗 リフトの中身を出して</button>
    </div>
    <script>
      document.querySelectorAll('.fa-send').forEach(function (btn) {
        btn.addEventListener('click', function () {
          btn.disabled = true;
          fetch('/apps/picking/api/floor-alerts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kind: btn.dataset.kind }) })
            .then(function (r) { return r.json(); })
            .then(function (b) { alert(b.ok ? (b.existed ? 'すでに依頼中です (梱包の画面に表示中)' : '梱包の画面に表示しました') : (b.error || 'エラー')); })
            .catch(function () { alert('通信エラー。もう一度お試しください'); })
            .finally(function () { btn.disabled = false; });
        });
      });
    </script>
    <% for (const b of batches) { %>
      <div class="card <%= b.status === 'done' ? 'done' : '' %>">
        <div class="card-main">
          <div class="card-title"><%= b.origin === 'repick' ? '🔴' : '' %><%= b.folder_name || '' %> <%= b.hikiate_class %></div>
          <% if (b.origin === 'repick') { %>
            <div style="font-size:.85rem; color:#c5221f; font-weight:600;">
              依頼元 <%= b.origin_ref || '-' %> / 依頼: <%= b.requested_by || '-' %> (計測対象外)
            </div>
          <% } %>
          <div class="card-meta">
            <span>明細 <b><%= b.line_count %></b></span>
            <span>数量 <b><%= b.total_qty %></b></span>
            <span><%= b.composition %></span>
            <span class="st <%= b.status %>"><%= statusLabels[b.status] || b.status %><%
              %><%= b.status === 'picking' && b.worker ? `: ${b.worker}` : '' %></span>
            <% if (b.done_lines > 0 && b.status !== 'done') { %><span>進捗 <%= b.done_lines %>/<%= b.line_count %></span><% } %>
          </div>
        </div>
        <div class="card-actions">
          <% if (b.status === 'ready' || b.status === 'picking') { %>
            <button class="btn-work <%= b.status === 'picking' ? 'resume' : '' %>" data-id="<%= b.id %>">
              <%= b.status === 'picking' ? '再開' : '▶ 作業' %>
            </button>
          <% } %>
          <a class="btn-detail" href="/apps/picking/batches/<%= b.id %>">明細</a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- 担当者選択 (作業ボタン→誰がやるかをタップ→開始画面へ) -->
  <div id="workerPick">
    <div class="sheet">
      <h3>だれがピッキングしますか?</h3>
      <div class="target" id="pickTarget"></div>
      <div class="sheet-grid" id="workerList">
        <% for (const w of workers) { %>
          <button class="worker-opt" data-code="<%= w.code %>" data-name="<%= w.name %>"><%= w.name %></button>
        <% } %>
      </div>
      <% if (workers.length === 0) { %>
        <p class="muted">作業者が未登録です。管理者が「端末・作業者」から追加してください。</p>
      <% } %>
      <button class="sheet-cancel" id="pickCancel">キャンセル</button>
    </div>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const DEVICE_MODE = <%- JSON.stringify(deviceMode) %>;
    let targetBatchId = null;

    function goWork() { location.href = `/apps/picking/work/${targetBatchId}`; }

    const HAS_WORKERS = document.querySelectorAll('.worker-opt').length > 0;
    document.querySelectorAll('.btn-work').forEach((btn) => btn.addEventListener('click', () => {
      targetBatchId = btn.dataset.id;
      // ログイン中でも必ず担当者を選ぶ (中原さん要望 8/12。実際にピッキングする人 ≠ ログイン者のため)。
      // 作業者マスタが空の場合のみ、ログインユーザー本人として直行する
      if (!DEVICE_MODE && !HAS_WORKERS) return goWork();
      // 前回選んだ人をハイライト (タップは毎回必要 = 使い回し端末での選び忘れ防止)
      const last = localStorage.getItem('pk_worker_code');
      document.querySelectorAll('.worker-opt').forEach((o) => o.classList.toggle('last', o.dataset.code === last));
      $('pickTarget').textContent = btn.closest('.card').querySelector('.card-title').textContent.trim();
      $('workerPick').style.display = 'flex';
    }));

    document.querySelectorAll('.worker-opt').forEach((btn) => btn.addEventListener('click', () => {
      localStorage.setItem('pk_worker_code', btn.dataset.code);
      localStorage.setItem('pk_worker_name', btn.dataset.name);
      goWork();
    }));
    $('pickCancel').addEventListener('click', () => { $('workerPick').style.display = 'none'; });

    // ── 一覧の更新 (RPA取込は随時来るため、開きっぱなしでも追従する) ──
    $('refreshBtn').addEventListener('click', () => location.reload());
    // 10秒ごとに軽量チェックし、バッチの増減・状態変化があった時だけ再読込
    // (毎回フルリロードしない = チラつかない・進捗数字だけの変化では動かない)
    const SIG = <%- JSON.stringify(batches.map((b) => `${b.id}:${b.status}`).join(',')) %>;
    const DATE = <%- JSON.stringify(workDate) %>;
    setInterval(async () => {
      const pickOpen = $('workerPick') && $('workerPick').style.display === 'flex';
      if (document.visibilityState !== 'visible' || pickOpen) return;
      try {
        const res = await fetch(`/apps/picking/api/batches-signature?date=${DATE}`);
        if (!res.ok) return;
        const body = await res.json();
        if (body.sig !== SIG) location.reload();
      } catch { /* オフライン中は次回 */ }
    }, 10000);
    // PWA復帰・タブ復帰の瞬間にも最新化 (読込から15秒以上経過時)
    const loadedAt = Date.now();
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - loadedAt > 15000) location.reload();
    });
  </script>
</body>
</html>
