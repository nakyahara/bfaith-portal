<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>楽天→Yahoo!ショッピング 商品移行 (RYS)</title>
  <link rel="icon" type="image/png" href="/favicon.png"><link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand fw-bold" href="/apps/rakuten-yahoo-sync/">楽天→Yahoo!ショッピング 商品移行</a>
    <div class="ms-auto d-flex align-items-center gap-2">
      <span class="badge bg-warning text-dark">Phase <%= phase %></span>
      <a href="/" class="btn btn-outline-light btn-sm">ポータルに戻る</a>
    </div>
  </nav>

  <div class="container py-4">
    <div class="alert <%= status.healthy ? 'alert-success' : 'alert-danger' %>">
      <strong><%= status.healthy ? '✅ env 設定 OK' : '⚠️ 必須 env 不足' %></strong>
      <% if (!status.healthy) { %>
        <div class="mt-2">未設定: <code><%= status.missing_required.join(', ') %></code></div>
      <% } %>
      <div class="mt-2 small">
        実 publish: <strong><%= status.publish_enabled ? 'ON (RYS_PUBLISH_ENABLED=1)' : 'OFF (default、 dry-run only)' %></strong>
      </div>
    </div>

    <% if (notionStats) { %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Notion 商品マスター cache (notion_overrides)</strong>
        <div class="btn-group btn-group-sm">
          <button class="btn btn-outline-secondary" onclick="runSync(true)">🧪 dry-run</button>
          <button class="btn btn-primary" onclick="runSync(false)">▶️ 本 sync 実行</button>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-3">
            <div class="text-muted small">取込済み</div>
            <div class="h3 mb-0"><%= notionStats.total || 0 %> <small class="text-muted">件</small></div>
          </div>
          <div class="col-md-3">
            <div class="text-muted small">Yahoo!タイトル入力済</div>
            <div class="h4 mb-0"><%= notionStats.with_title || 0 %></div>
          </div>
          <div class="col-md-3">
            <div class="text-muted small">売価入力済</div>
            <div class="h4 mb-0"><%= notionStats.with_price || 0 %></div>
          </div>
          <div class="col-md-3">
            <div class="text-muted small">配送方法選択済</div>
            <div class="h4 mb-0"><%= notionStats.with_delivery || 0 %></div>
          </div>
        </div>
        <% if (syncState) { %>
        <hr>
        <div class="small text-muted">
          最終 sync (成功): <code><%= syncState.last_successful_sync_at || '—' %></code><br>
          最終 sync (試行): <code><%= syncState.last_attempted_sync_at || '—' %></code>
          (errors: <%= syncState.last_error_count || 0 %>)<br>
          last_sync_run_id: <code><%= syncState.last_sync_run_id || '—' %></code>
        </div>
        <% } else { %>
        <hr>
        <div class="small text-muted">まだ sync を実行していません。 「dry-run」 で取込件数の試算 → 「本 sync 実行」 で DB へ書き込みします。</div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (readiness) { %>
    <div class="card mb-3">
      <div class="card-header"><strong>readiness 集計 (jobs テーブル)</strong></div>
      <div class="card-body row">
        <div class="col"><div class="text-muted small">total</div><div class="h4"><%= readiness.total %></div></div>
        <div class="col"><div class="text-muted small">pending</div><div class="h4"><%= readiness.pending %></div></div>
        <div class="col"><div class="text-success small">ok</div><div class="h4 text-success"><%= readiness.ok %></div></div>
        <div class="col"><div class="text-danger small">blocked</div><div class="h4 text-danger"><%= readiness.blocked %></div></div>
      </div>
    </div>
    <% } %>

    <% if (typeof publish !== 'undefined' && publish) { %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <strong>publish 状況 (publish_idempotency)</strong>
          <span class="badge <%= publishEnabled ? 'bg-success' : 'bg-secondary' %> ms-2">
            <%= publishEnabled ? 'RYS_PUBLISH_ENABLED=1 (ON)' : 'RYS_PUBLISH_ENABLED=0 (OFF)' %>
          </span>
        </div>
        <% if (publishEnabled) { %>
        <button class="btn btn-danger btn-sm" onclick="openPublishModal()">▶️ 1 商品 publish</button>
        <% } %>
      </div>
      <div class="card-body row">
        <div class="col"><div class="text-muted small">total</div><div class="h4"><%= publish.total %></div></div>
        <div class="col"><div class="text-warning small">in_progress</div><div class="h4 text-warning"><%= publish.in_progress %></div></div>
        <div class="col"><div class="text-success small">success</div><div class="h4 text-success"><%= publish.success %></div></div>
        <div class="col"><div class="text-danger small">failed</div><div class="h4 text-danger"><%= publish.failed %></div></div>
        <div class="col"><div class="text-info small">not_impl</div><div class="h4 text-info"><%= publish.not_implemented %></div></div>
      </div>
      <% if (!publishEnabled) { %>
      <div class="card-footer small text-muted">
        実 publish は kill-switch で停止中です。 Render env に <code>RYS_PUBLISH_ENABLED=1</code> を set すると有効化されます。
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Publish モーダル (RYS_PUBLISH_ENABLED=1 のときのみ表示) -->
    <% if (typeof publishEnabled !== 'undefined' && publishEnabled) { %>
    <div id="publishModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050;">
      <div class="card" style="max-width:520px; margin:80px auto;">
        <div class="card-header bg-danger text-white">
          <strong>⚠️ 1 商品で実 publish</strong>
        </div>
        <div class="card-body">
          <div class="alert alert-warning small">
            これは <strong>実際に Yahoo!ショッピングへ商品を登録する</strong> 操作です。 readiness が ok の商品のみ進みます。 idempotency_key で 2 回目以降は dedupe されます。
          </div>
          <div class="mb-3">
            <label class="form-label">item_code (= 楽天 itemNumber)</label>
            <input type="text" class="form-control" id="pub_itemCode" placeholder="例: seaweedp">
          </div>
          <div class="mb-3">
            <label class="form-label">manage_number (省略可、 warehouse 経由で自動解決)</label>
            <input type="text" class="form-control" id="pub_manageNumber">
          </div>
          <div class="mb-3">
            <label class="form-label">productCategory (Yahoo)</label>
            <input type="text" class="form-control" id="pub_productCategory" placeholder="例: 1933">
          </div>
          <div class="mb-3">
            <label class="form-label">pathName (売り場)</label>
            <input type="text" class="form-control" id="pub_pathName" placeholder="例: 食品 > 海藻">
          </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
          <button class="btn btn-secondary" onclick="closePublishModal()">キャンセル</button>
          <button class="btn btn-danger" onclick="executePublish()">実行</button>
        </div>
      </div>
    </div>
    <% } %>

    <div class="card mb-3">
      <div class="card-header"><strong>必須 env (REQUIRED)</strong></div>
      <table class="table table-sm mb-0">
        <thead><tr><th>Key</th><th>用途</th><th>Status</th><th>値 / 長さ</th></tr></thead>
        <tbody>
          <% for (const r of status.required) { %>
            <tr class="<%= r.set ? '' : 'table-danger' %>">
              <td><code><%= r.key %></code></td>
              <td><%= r.purpose %></td>
              <td><%= r.set ? '✅ set' : '❌ unset' %></td>
              <td>
                <% if (!r.set) { %>—<% } else if (r.value !== undefined) { %><code><%= r.value %></code>
                <% } else { %><small class="text-muted">length=<%= r.length %></small><% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="card-header"><strong>進捗</strong></div>
      <div class="card-body">
        <ol class="mb-0">
          <li>E-1 ✅ skeleton + env 確認画面</li>
          <li>E-2 ✅ Notion 商品マスター sync (289 件取込)</li>
          <li>E-3 ✅ delivery / variation / readiness resolver 移植</li>
          <li>E-4 ✅ field-mapper + dry-run pipeline</li>
          <li><strong>E-5a (現在)</strong>: publish インフラ (idempotency + dual check) ← イマココ</li>
          <li>E-5b: vps-proxy 拡張 + 実 publish (RYS_PUBLISH_ENABLED=1 で初稼働)</li>
        </ol>
      </div>
    </div>

    <div id="syncResult" class="mt-3"></div>
  </div>

<script>
function openPublishModal() { document.getElementById('publishModal').style.display = 'block'; }
function closePublishModal() { document.getElementById('publishModal').style.display = 'none'; }

async function executePublish() {
  const itemCode = document.getElementById('pub_itemCode').value.trim();
  if (!itemCode) { alert('item_code を入力してください'); return; }
  const body = {
    manageNumber: document.getElementById('pub_manageNumber').value.trim() || undefined,
    productCategory: document.getElementById('pub_productCategory').value.trim() || undefined,
    pathName: document.getElementById('pub_pathName').value.trim() || undefined,
  };
  if (!confirm(`item_code=${itemCode} で実 publish を実行します。 良いですか?`)) return;
  const out = document.getElementById('syncResult');
  out.innerHTML = '<div class="alert alert-info">実 publish 実行中... (画像 download → JPEG 変換 → uploadItemImage → editItem)</div>';
  closePublishModal();
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/publish/execute/' + encodeURIComponent(itemCode), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    const klass = data.status === 'success' ? 'alert-success'
      : data.status === 'dedupe' ? 'alert-secondary'
      : data.status === 'readiness_blocked' ? 'alert-warning'
      : 'alert-danger';
    // Codex E-5b R1 M-1: JSON.stringify を innerHTML 直挿入する代わりに textContent で escape
    const wrap = document.createElement('div');
    wrap.className = 'alert ' + klass;
    const head = document.createElement('strong');
    head.textContent = data.status || 'unknown';
    const pre = document.createElement('pre');
    pre.textContent = JSON.stringify(data, null, 2);
    wrap.appendChild(head);
    wrap.appendChild(pre);
    out.replaceChildren(wrap);
    if (data.status === 'success' || data.status === 'dedupe') setTimeout(() => location.reload(), 2500);
  } catch (e) {
    const wrap = document.createElement('div');
    wrap.className = 'alert alert-danger';
    wrap.textContent = 'network error: ' + e.message;
    out.replaceChildren(wrap);
  }
}

async function runSync(dryRun) {
  const btn = event.target;
  btn.disabled = true;
  btn.innerText = '実行中...';
  const out = document.getElementById('syncResult');
  out.innerHTML = '<div class="alert alert-info">Notion sync 実行中... (271 件で 30 秒前後)</div>';
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/notion/sync', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dryRun, mode: 'full' }),
    });
    const data = await res.json();
    if (!res.ok) {
      out.innerHTML = '<div class="alert alert-danger"><strong>fail</strong><pre>' + JSON.stringify(data, null, 2) + '</pre></div>';
    } else {
      const errors = (data.errors || []).length;
      const klass = errors > 0 ? 'alert-warning' : 'alert-success';
      out.innerHTML = '<div class="alert ' + klass + '">'
        + '<strong>' + (dryRun ? 'dry-run 完了' : 'sync 完了') + '</strong>'
        + '<div class="mt-2 small">runId: <code>' + data.runId + '</code></div>'
        + '<table class="table table-sm mt-2"><tbody>'
        + '<tr><th>取込ページ</th><td>' + data.totalPages + '</td></tr>'
        + '<tr><th>insert</th><td>' + (data.inserted || 0) + '</td></tr>'
        + '<tr><th>update</th><td>' + (data.updated || 0) + '</td></tr>'
        + '<tr><th>skip</th><td>' + (data.skipped || 0) + '</td></tr>'
        + '<tr><th>delete</th><td>' + (data.deleted || 0) + '</td></tr>'
        + '<tr><th>errors</th><td>' + errors + '</td></tr>'
        + '<tr><th>duration</th><td>' + data.durationMs + ' ms</td></tr>'
        + '</tbody></table>'
        + (errors > 0 ? '<details><summary>errors 詳細</summary><pre>' + JSON.stringify(data.errors, null, 2) + '</pre></details>' : '')
        + '</div>';
      if (!dryRun) setTimeout(() => location.reload(), 2000);
    }
  } catch (e) {
    out.innerHTML = '<div class="alert alert-danger">network error: ' + e.message + '</div>';
  } finally {
    btn.disabled = false;
    btn.innerText = dryRun ? '🧪 dry-run' : '▶️ 本 sync 実行';
  }
}
</script>
</body>
</html>
