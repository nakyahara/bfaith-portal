<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Yahoo商品移行</title>
  <link rel="icon" type="image/png" href="/favicon.png"><link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body { background: #f5f5f7; }
    .navbar-brand { font-weight: 700; }
    .badge-safety {
      background: #fff3cd; color: #8a6d3b; border: 1px solid #ffe69c; padding: .3em .65em;
      border-radius: .5em; font-weight: 600;
    }
    .badge-live {
      background: #d1f5d3; color: #155724; border: 1px solid #95dc9b; padding: .3em .65em;
      border-radius: .5em; font-weight: 600;
    }
    .product-card {
      background: #fff; border-radius: .75rem; padding: 1rem 1.25rem; margin-bottom: .75rem;
      box-shadow: 0 1px 2px rgba(0,0,0,.04); display: grid;
      grid-template-columns: 56px 1fr auto; gap: 1rem; align-items: center;
      cursor: pointer;
    }
    .product-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .product-card .actions, .product-card .actions a, .product-card .actions button { cursor: pointer; }
    /* drawer */
    .drawer-backdrop {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,.4); z-index: 1080;
    }
    .drawer-backdrop.show { display: block; }
    .drawer-panel {
      position: fixed; top: 0; right: 0; width: 680px; max-width: 95vw; height: 100%;
      background: #fff; box-shadow: -4px 0 12px rgba(0,0,0,.15); z-index: 1090;
      transform: translateX(100%); transition: transform .25s ease; overflow-y: auto;
    }
    .drawer-backdrop.show .drawer-panel { transform: translateX(0); }
    .drawer-section { padding: 1rem 1.25rem; border-bottom: 1px solid #eee; }
    .drawer-section:last-child { border-bottom: none; }
    .drawer-section h6 { margin-bottom: .5rem; font-weight: 600; color: #333; }
    .drawer-section dl { margin: 0; }
    .drawer-section dt { font-size: .8rem; color: #6c757d; font-weight: normal; margin-top: .3rem; }
    .drawer-section dd { margin: 0 0 .25rem 0; font-size: .95rem; }
    .drawer-history-row { font-size: .85rem; padding: .35rem 0; border-bottom: 1px solid #f4f4f4; }
    .drawer-history-row:last-child { border-bottom: none; }
    .thumb-placeholder {
      width: 56px; height: 56px; border-radius: .5rem; background: #e9ecef;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 1.3rem; color: #6c757d;
    }
    .product-title { font-weight: 600; font-size: 1.05rem; color: #212529; margin: 0; }
    .product-meta  { color: #6c757d; font-size: .87rem; margin-top: .15rem; }
    .product-reason {
      background: #fff8e1; border-left: 3px solid #ffb300; padding: .4rem .7rem;
      margin-top: .5rem; border-radius: .25rem; font-size: .9rem; color: #5d4037;
    }
    .product-done-meta {
      background: #e8f5e9; border-left: 3px solid #43a047; padding: .4rem .7rem;
      margin-top: .5rem; border-radius: .25rem; font-size: .87rem; color: #1b5e20;
    }
    .status-dot { font-size: 1.4rem; line-height: 1; }
    .actions { display: flex; flex-direction: column; gap: .35rem; align-items: stretch; min-width: 160px; }
    .actions .btn { white-space: nowrap; }
    .filter-chip { font-size: .9rem; padding: .4rem .9rem; border-radius: 2em; }
    .summary-card { background: #fff; border-radius: .75rem; padding: 1.25rem; margin-bottom: 1rem; }
    .next-todo li { margin: .35rem 0; }
    .category-pill {
      display: inline-block; background: #fff8e1; color: #5d4037; padding: .15em .7em;
      border-radius: 1em; font-size: .85rem; margin: .15rem .3rem .15rem 0;
    }
    /* E-6-3 一括選択モード */
    .bulk-checkbox-wrap { display: none; padding-right: .75rem; }
    body.bulk-mode .product-card { cursor: default; grid-template-columns: 28px 56px 1fr auto; }
    body.bulk-mode .bulk-checkbox-wrap { display: flex; align-items: center; }
    .bulk-bar {
      position: sticky; top: 0; z-index: 1040; background: #fff8c5; border: 1px solid #f0d97a;
      border-radius: .5rem; padding: .6rem 1rem; margin-bottom: .75rem;
      display: none; justify-content: space-between; align-items: center;
    }
    body.bulk-mode .bulk-bar { display: flex; }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="/apps/rakuten-yahoo-sync/">Yahoo商品移行</a>
    <div class="ms-auto d-flex align-items-center gap-2">
      <% if (publishEnabled) { %>
        <span class="badge-live">本番モード: ON</span>
      <% } else { %>
        <span class="badge-safety">テストモード: 本登録しません</span>
      <% } %>
      <button class="btn btn-outline-light btn-sm js-open-exclusion-mgmt">
        🚫 移行除外管理
        <% if (typeof exclusionCount !== 'undefined' && exclusionCount.total > 0) { %>
          <span class="badge bg-warning text-dark ms-1"><%= exclusionCount.total %></span>
        <% } %>
      </button>
      <button class="btn btn-outline-light btn-sm js-open-image-exclusion-mgmt" title="楽天画像のファイル名に特定の文字列が入っているとき、 その画像を Yahoo に登録しない">
        🖼️ 画像除外パターン
      </button>
      <a href="/" class="btn btn-outline-light btn-sm">ポータルに戻る</a>
    </div>
  </nav>

  <div class="container py-4" style="max-width: 1100px;">
    <!-- 👇 今日やること (案 C ヘッダー) -->
    <div class="summary-card">
      <h5 class="mb-3">📋 きょうやること</h5>
      <ol class="next-todo mb-0">
        <li>
          <strong>Notion を最新にする</strong>
          <% if (syncState?.last_successful_sync_at) { %>
            <span class="text-muted small">
              （前回: <code><%= syncState.last_successful_sync_at %></code>
              <% if (syncDaysAgo !== null) { %>
                ・<%= syncDaysAgo %> 日前
                <% if (syncDaysAgo >= 3) { %>
                  <span class="text-danger">⚠ 古いです、 取り込み推奨</span>
                <% } %>
              <% } %>）
            </span>
          <% } else { %>
            <span class="text-muted small">（まだ取り込んでいません）</span>
          <% } %>
          <button class="btn btn-sm btn-outline-primary ms-2" onclick="runSync()">いま取り込む</button>
        </li>
        <li>
          <strong>楽天↔Yahoo 差分を取り直す</strong>
          <span class="text-muted small">（毎朝自動、 今すぐ取りたい時だけボタン）</span>
          <button class="btn btn-sm btn-outline-info ms-2 js-trigger-diff-sync">いま再取得</button>
          <%# Phase E-9 中原さん指摘修正: 「Notion 修正待ち」 の横にあると Notion から取ってる
              ように見える → 楽天 RMS から取得するボタンなので 「楽天↔Yahoo 差分」 行に移動。
              ラベルも 「楽天 RMS から」 を明示。 %>
          <% if (typeof rakutenTitleMissing !== 'undefined' && rakutenTitleMissing > 0) { %>
            <button class="btn btn-sm btn-outline-info ms-2 js-backfill-rakuten-title"
                    title="楽天 RMS の getItem API で商品名を直接取得します (Notion は経由しません)。 取得後、 修正必要リストに 「何の商品か」 が表示されます">
              📥 楽天 RMS から商品名取得 (<%= rakutenTitleMissing %> 件未取得)
            </button>
          <% } %>
          <%# Phase E-11-b: Yahoo カテゴリ学習。 既存 130 件から逆引きで learn、 publish 自動推定の基盤。 %>
          <% if (typeof yahooCategoryMissing !== 'undefined' && (yahooCategoryMissing > 0 || (typeof yahooCategoryLearnedGenres !== 'undefined' && yahooCategoryLearnedGenres === 0)) ) { %>
            <button class="btn btn-sm btn-outline-info ms-2 js-yahoo-category-learn"
                    title="既存 Yahoo!ショッピング出品から Yahoo カテゴリと path を取得し、 楽天 genre との対応辞書を作ります。 学習後の publish は自動推定されます">
              📚 Yahoo カテゴリ学習<% if (yahooCategoryMissing > 0) { %> (<%= yahooCategoryMissing %> 件未取得)<% } %><% if (typeof yahooCategoryLearnedGenres !== 'undefined' && yahooCategoryLearnedGenres > 0) { %> (学習済 <%= yahooCategoryLearnedGenres %> genre)<% } %>
            </button>
          <% } %>
        </li>
        <li>
          <strong><%= summary.actionable %> 商品</strong> が Yahoo に出せます
          <a href="?filter=actionable" class="btn btn-sm btn-outline-success ms-2">出せる商品を見る</a>
        </li>
        <li>
          <strong><%= summary.fixable %> 商品</strong> が Notion 修正待ち
          <a href="?filter=fixable" class="btn btn-sm btn-outline-warning ms-2">修正リストを見る</a>
          <% if (summary.fixable > 0 && Object.keys(fixableByCategory).length > 0) { %>
            <div class="mt-2">
              <% for (const cat of Object.keys(fixableByCategory).sort((a, b) => fixableByCategory[b] - fixableByCategory[a])) { %>
                <a href="?filter=fixable" class="category-pill text-decoration-none">
                  <%= cat %> <strong><%= fixableByCategory[cat] %></strong> 件
                </a>
              <% } %>
            </div>
          <% } %>
        </li>
        <li>
          <strong><%= summary.done %> 商品</strong> 移行済み
          <% if (summary.done > 0) { %>
            <a href="?filter=done" class="btn btn-sm btn-outline-secondary ms-2">移行済みを見る</a>
          <% } %>
        </li>
      </ol>
      <% if (!publishEnabled) { %>
        <div class="alert alert-warning mt-3 mb-0 py-2 small">
          ⚠️ いま <strong>テストモード</strong> です。 「Yahoo に出す」 ボタンを押しても **本番に登録されません** (確認のみ)。
          本登録するには管理者が Render の <code>RYS_PUBLISH_ENABLED=1</code> を設定する必要があります。
        </div>
      <% } %>
    </div>

    <!-- env が足りなければ警告 -->
    <% if (!status.healthy) { %>
      <div class="alert alert-danger">
        <strong>⚠ 設定が足りません:</strong> <code><%= status.missing_required.join(', ') %></code>
        <span class="small text-muted ms-2">（管理者が Render env を設定する必要があります）</span>
      </div>
    <% } %>

    <!-- 👇 商品リスト (案 B カードベース) -->
    <div class="summary-card">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="mb-0">🛒 商品リスト</h5>
        <div class="d-flex gap-2 align-items-center">
          <!-- E-6-3: 一括選択モード toggle + 失敗再実行 -->
          <% if (filter === 'actionable' && summary.actionable > 0) { %>
            <button class="btn btn-sm btn-outline-info js-toggle-bulk-mode">☑ 一括選択モード</button>
          <% } %>
          <button class="btn btn-sm btn-outline-warning js-retry-failed-publish" title="失敗中の publish をまとめて再実行">🔁 失敗中を再実行</button>
          <form method="GET" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="filter" value="<%= filter %>">
            <input class="form-control form-control-sm" type="search" name="q" placeholder="商品コード / タイトルで絞り込み"
                   value="<%= search %>" style="width: 240px;">
            <% if (search) { %>
              <a href="?filter=<%= filter %>" class="btn btn-sm btn-outline-secondary">クリア</a>
            <% } %>
          </form>
        </div>
      </div>

      <!-- E-6-3: 一括選択中のバー -->
      <div class="bulk-bar">
        <div>
          ☑ <strong id="bulkSelectedCount">0</strong> 商品選択中
          <button class="btn btn-sm btn-link js-bulk-select-all">すべて選択</button>
          <button class="btn btn-sm btn-link js-bulk-deselect-all">すべて解除</button>
        </div>
        <div>
          <button class="btn btn-sm btn-success js-bulk-publish-execute" disabled>▶️ 選択した N 商品を一括登録</button>
          <button class="btn btn-sm btn-outline-secondary js-toggle-bulk-mode">キャンセル</button>
        </div>
      </div>

      <div class="mb-3">
        <a href="?filter=all" class="btn btn-sm filter-chip <%= filter === 'all' ? 'btn-dark' : 'btn-outline-secondary' %>">全部 (<%= summary.total %>)</a>
        <a href="?filter=actionable" class="btn btn-sm filter-chip <%= filter === 'actionable' ? 'btn-success' : 'btn-outline-success' %>">🟢 出せる (<%= summary.actionable %>)</a>
        <a href="?filter=fixable" class="btn btn-sm filter-chip <%= filter === 'fixable' ? 'btn-warning' : 'btn-outline-warning' %>">🟡 修正必要 (<%= summary.fixable %>)</a>
        <a href="?filter=done" class="btn btn-sm filter-chip <%= filter === 'done' ? 'btn-secondary' : 'btn-outline-secondary' %>">✅ 移行済み (<%= summary.done %>)</a>
        <% if (summary.excluded > 0) { %>
          <a href="?filter=excluded" class="btn btn-sm filter-chip <%= filter === 'excluded' ? 'btn-danger' : 'btn-outline-danger' %>">🚫 除外中 (<%= summary.excluded %>)</a>
        <% } %>
        <% if (summary.stale > 0) { %>
          <a href="?filter=stale" class="btn btn-sm filter-chip <%= filter === 'stale' ? 'btn-secondary' : 'btn-outline-secondary' %>">⚪ 楽天で消えた (<%= summary.stale %>)</a>
        <% } %>
        <% if (summary.orphan > 0) { %>
          <a href="?filter=orphan" class="btn btn-sm filter-chip <%= filter === 'orphan' ? 'btn-info' : 'btn-outline-info' %>">📦 救済 (<%= summary.orphan %>)</a>
        <% } %>
      </div>

      <% if (products.length === 0) { %>
        <div class="text-center text-muted py-5">
          <% if (search) { %>
            「<%= search %>」 に一致する商品はありません。
          <% } else { %>
            <% if (filter === 'actionable') { %>
              出せる商品はまだありません。 Notion から取り込んでみてください。
            <% } else if (filter === 'fixable') { %>
              修正が必要な商品はありません。 🎉
            <% } else if (filter === 'done') { %>
              移行済みの商品はまだありません。
            <% } else { %>
              商品データがありません。 Notion から取り込んでみてください。
            <% } %>
          <% } %>
        </div>
      <% } else { %>
        <% for (const p of products) { %>
          <div class="product-card js-open-detail" data-item-code="<%= p.itemCode %>" role="button" tabindex="0" aria-label="<%= p.itemCode %> の詳細を見る">
            <% if (p.status === 'actionable') { %>
              <div class="bulk-checkbox-wrap">
                <input type="checkbox" class="form-check-input js-bulk-checkbox" data-item-code="<%= p.itemCode %>" aria-label="<%= p.itemCode %> を一括選択">
              </div>
            <% } else { %>
              <div class="bulk-checkbox-wrap"></div>
            <% } %>
            <div class="thumb-placeholder">
              <%= (p.yahooTitle || p.rakutenTitle || p.itemCode).slice(0, 1).toUpperCase() %>
            </div>
            <div>
              <p class="product-title">
                <span class="status-dot">
                  <% if (p.status === 'actionable') { %>🟢
                  <% } else if (p.status === 'fixable') { %>🟡
                  <% } else if (p.status === 'done') { %>✅
                  <% } else if (p.status === 'excluded') { %>🚫
                  <% } else if (p.status === 'stale') { %>⚪
                  <% } else if (p.status === 'orphan') { %>📦
                  <% } else { %>⚪<% } %>
                </span>
                <%# Phase E-9 中原さん依頼: 何の商品か分かるよう yahoo_title が無いとき 楽天タイトルを fallback で見せる %>
                <% if (p.yahooTitle) { %>
                  <%= p.yahooTitle %>
                <% } else if (p.rakutenTitle) { %>
                  <%= p.rakutenTitle %>
                  <span class="badge bg-light text-dark border ms-1 small" title="Yahoo!タイトルが未入力のため、 楽天の商品名を表示しています">楽天タイトル</span>
                <% } else { %>
                  (タイトル未入力)
                <% } %>
                <%# Codex R2 D-2: 「Yahoo に手動 publish された除外商品」 の「移行済み (除外指定済)」 バッジ %>
                <% if (p.status === 'excluded' && p.isDone) { %>
                  <span class="badge bg-success ms-1 small">移行済み (除外指定済)</span>
                <% } %>
              </p>
              <div class="product-meta">
                <code><%= p.itemCode %></code>
                <% if (p.yahooPrice) { %> ・ ¥<%= p.yahooPrice.toLocaleString() %><% } %>
                <% if (p.delivery) { %> ・ <%= p.delivery %><% } %>
              </div>

              <% if (p.status === 'fixable' && p.primaryReason) { %>
                <div class="product-reason">
                  💡 <%= p.primaryReason %>
                  <% if (p.reasons.length > 1) { %>
                    <span class="text-muted small">（他 <%= p.reasons.length - 1 %> 件の修正項目）</span>
                  <% } %>
                </div>
              <% } %>

              <% if (p.status === 'done') { %>
                <div class="product-done-meta">
                  ✅ <% if (p.yahooObservedCode) { %>Yahoo で観測済み<% } else if (p.publishCompletedAt) { %>
                    <code><%= p.publishCompletedAt %></code> に登録<% } else { %>登録済み<% } %>
                </div>
              <% } %>

              <% if (p.status === 'excluded') { %>
                <div class="product-reason" style="background: #ffeaea; border-left-color: #d9534f;">
                  🚫 <%= p.exclusionKind === 'permanent' ? '永続除外' : '一時除外' %>
                  <% if (p.exclusionReason) { %>： <%= p.exclusionReason %><% } %>
                  <% if (p.exclusionAt) { %>
                    <span class="text-muted small">（<%= p.exclusionAt %>）</span>
                  <% } %>
                </div>
              <% } %>

              <% if (p.status === 'stale') { %>
                <div class="product-reason" style="background: #f0f0f0; border-left-color: #6c757d;">
                  ⚪ 楽天で確認できなくなった (連続欠落カウント済み)
                </div>
              <% } %>

              <% if (p.status === 'orphan') { %>
                <div class="product-reason" style="background: #e0f2ff; border-left-color: #17a2b8;">
                  📦 Notion にはあるが現在の楽天差分にない (廃番 / 候補化前 / 楽天未登録)
                </div>
              <% } %>
            </div>
            <div class="actions">
              <% if (p.status === 'actionable') { %>
                <button class="btn btn-success btn-sm js-publish-btn"
                        data-item-code="<%= p.itemCode %>"
                        data-yahoo-title="<%= p.yahooTitle || '' %>"
                        data-yahoo-price="<%= p.yahooPrice || 0 %>"
                        data-delivery="<%= p.delivery || '' %>">
                  <% if (publishEnabled) { %>▶️ Yahoo に出す<% } else { %>🧪 登録テスト<% } %>
                </button>
                <% if (p.notionPageId) { %>
                  <a href="<%= notionPageUrl(p.notionPageId) %>" target="_blank" class="btn btn-outline-secondary btn-sm">📝 Notion で開く</a>
                <% } %>
              <% } else if (p.status === 'fixable') { %>
                <% if (p.notionPageId) { %>
                  <a href="<%= notionPageUrl(p.notionPageId) %>" target="_blank" class="btn btn-warning btn-sm">📝 Notion で修正</a>
                <% } %>
              <% } else if (p.status === 'done' || p.status === 'excluded' || p.status === 'stale' || p.status === 'orphan') { %>
                <% if (p.notionPageId) { %>
                  <a href="<%= notionPageUrl(p.notionPageId) %>" target="_blank" class="btn btn-outline-secondary btn-sm">📝 Notion で開く</a>
                <% } %>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- 👇 システム設定 (アコーディオン、 普段閉じてる) -->
    <div class="summary-card">
      <details>
        <summary class="text-muted" style="cursor: pointer;">⚙ システム設定 (管理者向け)</summary>
        <div class="mt-3">
          <h6>環境変数</h6>
          <table class="table table-sm">
            <thead><tr><th>Key</th><th>用途</th><th>状態</th></tr></thead>
            <tbody>
              <% for (const r of status.required) { %>
                <tr class="<%= r.set ? '' : 'table-danger' %>">
                  <td><code><%= r.key %></code></td>
                  <td class="small"><%= r.purpose %></td>
                  <td><%= r.set ? '✅' : '❌' %></td>
                </tr>
              <% } %>
              <% for (const o of status.optional) { %>
                <tr>
                  <td><code><%= o.key %></code></td>
                  <td class="small"><%= o.purpose %></td>
                  <td><%= o.set ? '✅' : '—' %></td>
                </tr>
              <% } %>
            </tbody>
          </table>

          <% if (publishSummary) { %>
            <h6 class="mt-4">Yahoo 登録履歴 (内部集計)</h6>
            <p class="small">
              total <%= publishSummary.total %> ・ 進行中 <%= publishSummary.in_progress %> ・
              成功 <%= publishSummary.success %> ・ 失敗 <%= publishSummary.failed %> ・
              テスト <%= publishSummary.not_implemented %>
            </p>
          <% } %>
          <p class="small text-muted">
            実 publish は <code>RYS_PUBLISH_ENABLED</code> = <%= publishEnabled ? '1 (ON)' : '0 (OFF)' %>。
            これは Render の環境変数で管理者が切り替えます。
          </p>
        </div>
      </details>
    </div>

    <div id="actionResult"></div>
  </div>

  <!-- 一括 publish 進行モーダル (Phase E-6-3) -->
  <div id="bulkPublishModal" class="modal" tabindex="-1" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1080;">
    <div class="card" style="max-width: 640px; margin: 60px auto;">
      <div class="card-header">
        <strong id="bulkPublishTitle">一括登録中...</strong>
      </div>
      <div class="card-body">
        <div id="bulkPublishProgress" class="mb-3">
          <div class="progress" style="height: 8px;">
            <div id="bulkPublishProgressBar" class="progress-bar bg-success" style="width: 0%;"></div>
          </div>
          <div class="small text-muted mt-1" id="bulkPublishProgressText">準備中...</div>
        </div>
        <div id="bulkPublishResults" style="max-height: 320px; overflow-y: auto;"></div>
      </div>
      <div class="card-footer d-flex justify-content-end gap-2">
        <button class="btn btn-secondary btn-sm js-close-bulk-publish-modal" disabled>閉じる</button>
      </div>
    </div>
  </div>

  <!-- 商品詳細ドロワー (Phase E-6-2) -->
  <div id="detailDrawerBackdrop" class="drawer-backdrop" role="dialog" aria-modal="true" aria-labelledby="detailDrawerTitle">
    <div id="detailDrawerPanel" class="drawer-panel">
      <div class="drawer-section" style="display:flex; justify-content:space-between; align-items:center; padding-top:.75rem; padding-bottom:.75rem;">
        <h5 id="detailDrawerTitle" class="mb-0">商品詳細</h5>
        <button class="btn-close js-close-detail-drawer" aria-label="閉じる"></button>
      </div>
      <div id="detailDrawerContent">
        <div class="drawer-section text-muted small">読み込み中...</div>
      </div>
    </div>
  </div>

  <!-- 楽天↔Yahoo 差分再取得 進行モーダル (Phase E-7-e) -->
  <div id="diffSyncModal" class="modal" tabindex="-1" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1050;">
    <div class="card" style="max-width: 580px; margin: 80px auto;">
      <div class="card-body">
        <h5 id="diffSyncTitle">楽天↔Yahoo 差分を再取得中...</h5>
        <div id="diffSyncBody" class="mt-3">
          <div class="text-muted small">Yahoo の全商品リスト + 楽天の全商品リストを取得 → 差分を計算します。 1〜2 分かかります。</div>
        </div>
        <div class="text-end mt-3">
          <button class="btn btn-secondary btn-sm js-close-diff-sync-modal">閉じる</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 🚫 移行除外管理モーダル (Phase E-7-c) -->
  <div id="exclusionModal" class="modal" tabindex="-1" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1050; overflow-y:auto;">
    <div class="card" style="max-width: 820px; margin: 40px auto;">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>🚫 移行除外管理</strong>
        <button class="btn-close js-close-exclusion-modal" aria-label="閉じる"></button>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          「Yahoo に出さない」 と決めた商品を覚えておく場所です。
          <strong>一時除外</strong> = 後で気が変わるかも、 <strong>永続除外</strong> = もうずっと触らない、 の 2 種類があります。
        </p>

        <!-- 新規除外フォーム -->
        <div class="border rounded p-3 mb-3 bg-light">
          <h6 class="mb-2">＋ 新しく除外する</h6>
          <div class="row g-2 align-items-end">
            <div class="col-md-4">
              <label class="form-label small">楽天商品コード (item_code)</label>
              <input type="text" class="form-control form-control-sm" id="excludeItemCodeInput" placeholder="例: foo-bar-001">
            </div>
            <div class="col-md-3">
              <label class="form-label small">種類</label>
              <select class="form-select form-select-sm" id="excludeKindInput">
                <option value="temporary">一時除外 (後で見直すかも)</option>
                <option value="permanent">永続除外 (もうずっと触らない)</option>
              </select>
            </div>
            <div class="col-md-5">
              <label class="form-label small">理由 (検索可)</label>
              <input type="text" class="form-control form-control-sm" id="excludeReasonInput" placeholder="例: 価格が合わないため">
            </div>
          </div>
          <div class="text-end mt-2">
            <button class="btn btn-warning btn-sm js-do-exclude">この商品を除外する</button>
          </div>
          <div id="excludeFormError" class="alert alert-danger small mt-2 mb-0" style="display:none;"></div>
        </div>

        <!-- 現在の除外一覧 -->
        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
          <h6 class="mb-0">📋 現在の除外 (<span id="exclusionTotalCount">0</span> 件)</h6>
          <form class="d-flex gap-2" onsubmit="return false;">
            <select class="form-select form-select-sm" id="exclusionListKindFilter" style="width:auto;">
              <option value="">全種類</option>
              <option value="temporary">一時除外</option>
              <option value="permanent">永続除外</option>
            </select>
            <input type="search" class="form-control form-control-sm" id="exclusionListSearch" placeholder="商品コード / 理由で検索" style="width:240px;">
          </form>
        </div>
        <div id="exclusionListContainer">
          <div class="text-muted text-center py-4">読み込み中...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🖼️ 画像除外パターン管理モーダル (Phase E-8) -->
  <div id="imageExclusionModal" class="modal" tabindex="-1" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1050; overflow-y:auto;">
    <div class="card" style="max-width: 820px; margin: 40px auto;">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>🖼️ 画像除外パターン</strong>
        <button class="btn-close js-close-image-exclusion-modal" aria-label="閉じる"></button>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          楽天画像の <strong>URL に特定の文字列が入っているとき</strong>、 その画像を Yahoo に登録しません。
          部分一致 + 大文字小文字の区別なしです。 例: <code>coupon</code> を指定すると <code>https://.../my-coupon.jpg</code> も除外されます。
          <strong>クーポン画像 (coupon)</strong> と <strong>レビュー特典画像 (review)</strong> は最初から組込みで除外されています (削除不可)。
        </p>

        <!-- 新規パターン追加フォーム -->
        <div class="border rounded p-3 mb-3 bg-light">
          <h6 class="mb-2">＋ 新しく除外パターンを追加</h6>
          <div class="row g-2 align-items-end">
            <div class="col-md-5">
              <label class="form-label small">マッチする文字列</label>
              <input type="text" class="form-control form-control-sm" id="imgPatternInput" placeholder="例: campaign">
            </div>
            <div class="col-md-7">
              <label class="form-label small">理由 (UI で見えます)</label>
              <input type="text" class="form-control form-control-sm" id="imgPatternReasonInput" placeholder="例: キャンペーン用ファイル名">
            </div>
          </div>
          <div class="text-end mt-2">
            <button class="btn btn-warning btn-sm js-add-image-pattern">この文字列を除外パターンに追加</button>
          </div>
          <div id="imgPatternFormError" class="alert alert-danger small mt-2 mb-0" style="display:none;"></div>
        </div>

        <!-- 現在のパターン一覧 -->
        <h6 class="mb-2">📋 いま有効な除外パターン</h6>
        <div id="imageExclusionListContainer">
          <div class="text-muted text-center py-4">読み込み中...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notion sync 結果モーダル -->
  <div id="syncModal" class="modal" tabindex="-1" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1050;">
    <div class="card" style="max-width: 580px; margin: 80px auto;">
      <div class="card-body">
        <h5 id="syncTitle">Notion 取り込み中...</h5>
        <div id="syncBody" class="mt-3"></div>
        <div class="text-end mt-3">
          <button class="btn btn-secondary btn-sm" onclick="closeSyncModal()">閉じる</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Publish 確認 + 進行状況モーダル (Phase E-9 中原さん指摘: 押した後何も起きてないように見える) -->
  <div id="pubModal" class="modal" tabindex="-1" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1050;">
    <div class="card" style="max-width: 580px; margin: 80px auto;">
      <div class="card-header bg-warning" id="pubModalHeader">
        <strong id="pubModalTitle">Yahoo に登録しますか?</strong>
      </div>
      <!-- 確認 view -->
      <div class="card-body" id="pubModalConfirmBody">
        <div id="pubModalSafety" class="alert alert-warning small mb-3">
          <% if (!publishEnabled) { %>
            これは <strong>テスト実行</strong> です。 Yahoo には登録されません。
          <% } else { %>
            これは <strong>本番</strong> です。 Yahoo!ショッピングに商品が登録され、 取り消せません。
          <% } %>
        </div>
        <p class="mb-2">登録対象:</p>
        <ul class="mb-3">
          <li>商品コード: <code id="pubItemCode"></code></li>
          <li>タイトル: <span id="pubTitle"></span></li>
          <li>売価: ¥<span id="pubPrice"></span></li>
          <li>配送方法: <span id="pubDelivery"></span></li>
        </ul>
        <% if (publishEnabled) { %>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="pubConfirmCheckbox">
            <label class="form-check-label" for="pubConfirmCheckbox">
              <strong>取り消せないことを理解しました</strong>
            </label>
          </div>
        <% } %>
      </div>
      <!-- 進行中 view -->
      <div class="card-body" id="pubModalProgressBody" style="display:none;">
        <div class="text-center py-3">
          <div class="spinner-border text-warning mb-3" role="status" style="width:3rem; height:3rem;"></div>
          <div><strong id="pubProgressStep">⚙️ Yahoo に登録中...</strong></div>
          <div class="small text-muted mt-2">商品コード: <code id="pubProgressItemCode"></code></div>
          <div class="small text-muted mt-1" id="pubProgressTime">経過: 0 秒</div>
          <div class="small text-muted mt-3">
            <p class="mb-1">楽天画像の取得 → JPEG 変換 → Yahoo!ショッピングへの登録を順に実行しています。</p>
            <p class="mb-0">通常 30 秒〜 2 分かかります。 完了するまでこの画面は閉じないでください。</p>
          </div>
        </div>
      </div>
      <!-- 結果 view -->
      <div class="card-body" id="pubModalResultBody" style="display:none;">
        <div id="pubResultMain"></div>
        <details class="mt-2">
          <summary class="small text-muted">詳細 (技術情報)</summary>
          <pre id="pubResultRaw" style="font-size:.75rem; max-height: 240px; overflow:auto; background:#f8f9fa; padding:8px; border-radius:4px;"></pre>
        </details>
      </div>
      <div class="card-footer d-flex justify-content-end gap-2" id="pubModalFooter">
        <button class="btn btn-secondary" id="pubCancelBtn" onclick="closePublishConfirm()">キャンセル</button>
        <button class="btn btn-warning" id="pubConfirmBtn" onclick="executePublish()">
          <% if (publishEnabled) { %>本番登録する<% } else { %>テスト実行する<% } %>
        </button>
      </div>
    </div>
  </div>

<script>
// ───── Notion sync ─────
function openSyncModal() { document.getElementById('syncModal').style.display = 'block'; }
function closeSyncModal() { document.getElementById('syncModal').style.display = 'none'; location.reload(); }

async function runSync() {
  openSyncModal();
  document.getElementById('syncTitle').textContent = 'Notion 取り込み中...';
  const body = document.getElementById('syncBody');
  body.innerHTML = '<div class="text-muted small">30 秒前後かかります。</div>';
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/notion/sync', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ dryRun: false, mode: 'full' }),
    });
    const data = await res.json();
    document.getElementById('syncTitle').textContent = res.ok ? '取り込み完了' : '取り込みに失敗しました';
    const wrap = document.createElement('div');
    if (res.ok) {
      const errors = (data.errors || []).length;
      wrap.innerHTML = '<div class="alert ' + (errors > 0 ? 'alert-warning' : 'alert-success') + '">'
        + '<div>新規取込: <strong>' + (data.inserted || 0) + '</strong></div>'
        + '<div>更新: <strong>' + (data.updated || 0) + '</strong></div>'
        + '<div>変更なし: <strong>' + (data.skipped || 0) + '</strong></div>'
        + (data.deleted > 0 ? '<div>削除: <strong>' + data.deleted + '</strong></div>' : '')
        + (errors > 0 ? '<div class="text-danger">エラー: <strong>' + errors + '</strong></div>' : '')
        + '</div>';
    } else {
      const msg = document.createElement('pre');
      msg.style.fontSize = '.8rem';
      msg.textContent = JSON.stringify(data, null, 2);
      wrap.appendChild(msg);
    }
    body.replaceChildren(wrap);
  } catch (e) {
    const div = document.createElement('div');
    div.className = 'alert alert-danger';
    div.textContent = 'ネットワークエラー: ' + e.message;
    body.replaceChildren(div);
  }
}

// ───── Publish ─────
let _pubItemCode = null;
let _pubTimerId = null;
let _pubAutoReloadId = null;

function showPubView(name) {
  // name: 'confirm' | 'progress' | 'result'
  document.getElementById('pubModalConfirmBody').style.display = name === 'confirm' ? '' : 'none';
  document.getElementById('pubModalProgressBody').style.display = name === 'progress' ? '' : 'none';
  document.getElementById('pubModalResultBody').style.display = name === 'result' ? '' : 'none';
}

function openPublishConfirm(itemCode, title, price, delivery) {
  _pubItemCode = itemCode;
  document.getElementById('pubItemCode').textContent = itemCode;
  document.getElementById('pubTitle').textContent = title || '(未入力)';
  document.getElementById('pubPrice').textContent = price ? price.toLocaleString() : '0';
  document.getElementById('pubDelivery').textContent = delivery || '(未設定)';
  const cb = document.getElementById('pubConfirmCheckbox');
  if (cb) cb.checked = false;
  // 確認 view にリセット
  showPubView('confirm');
  document.getElementById('pubModalHeader').className = 'card-header bg-warning';
  document.getElementById('pubModalTitle').textContent = 'Yahoo に登録しますか?';
  document.getElementById('pubCancelBtn').style.display = '';
  document.getElementById('pubCancelBtn').disabled = false;
  document.getElementById('pubCancelBtn').textContent = 'キャンセル';
  const confirmBtn = document.getElementById('pubConfirmBtn');
  confirmBtn.style.display = '';
  confirmBtn.disabled = false;
  document.getElementById('pubModal').style.display = 'block';
}

// Codex E-6 R1 High-1: 商品データを onclick に injection しない。
//   data-* attribute (EJS escaped output 済) を addEventListener で読む。
document.addEventListener('DOMContentLoaded', () => {
  for (const btn of document.querySelectorAll('.js-publish-btn')) {
    btn.addEventListener('click', (ev) => {
      const ds = ev.currentTarget.dataset;
      const price = Number(ds.yahooPrice) || 0;
      openPublishConfirm(ds.itemCode, ds.yahooTitle, price, ds.delivery);
    });
  }
});
function closePublishConfirm() {
  // 進行中タイマー / 自動 reload を必ず止める (modal close で leak しない)
  if (_pubTimerId) { clearInterval(_pubTimerId); _pubTimerId = null; }
  if (_pubAutoReloadId) { clearTimeout(_pubAutoReloadId); _pubAutoReloadId = null; }
  document.getElementById('pubModal').style.display = 'none';
}

async function executePublish() {
  const cb = document.getElementById('pubConfirmCheckbox');
  if (cb && !cb.checked) {
    alert('「取り消せないことを理解しました」 にチェックを入れてください。');
    return;
  }
  // Phase E-9 中原さん指摘: 確認 view → 進行中 view に切り替えて modal を開きっぱなしにする。
  //   これで 「押した後に何も起きてない」 ように見える問題を解消。
  showPubView('progress');
  document.getElementById('pubModalHeader').className = 'card-header bg-info text-white';
  document.getElementById('pubModalTitle').textContent = '⚙️ Yahoo に登録しています...';
  document.getElementById('pubProgressItemCode').textContent = _pubItemCode || '';
  document.getElementById('pubProgressStep').textContent = '⚙️ Yahoo に登録中...';
  // 進行 view 中はキャンセル/実行ボタンは見せない
  document.getElementById('pubCancelBtn').style.display = 'none';
  document.getElementById('pubConfirmBtn').style.display = 'none';
  // 経過時間タイマー
  const startedAt = Date.now();
  if (_pubTimerId) { clearInterval(_pubTimerId); }
  _pubTimerId = setInterval(() => {
    const sec = Math.round((Date.now() - startedAt) / 1000);
    const m = Math.floor(sec / 60), s = sec % 60;
    document.getElementById('pubProgressTime').textContent =
      '経過: ' + (m > 0 ? m + ' 分 ' + s + ' 秒' : s + ' 秒');
  }, 1000);

  let data, error;
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/publish/execute/' + encodeURIComponent(_pubItemCode), {
      method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({}),
    });
    data = await res.json();
  } catch (e) {
    error = e;
  }
  // タイマー停止
  if (_pubTimerId) { clearInterval(_pubTimerId); _pubTimerId = null; }

  // 結果 view へ
  showPubView('result');
  const main = document.getElementById('pubResultMain');
  const rawPre = document.getElementById('pubResultRaw');

  if (error) {
    document.getElementById('pubModalHeader').className = 'card-header bg-danger text-white';
    document.getElementById('pubModalTitle').textContent = '❌ ネットワークエラー';
    const wrap = document.createElement('div');
    wrap.className = 'alert alert-danger';
    wrap.textContent = 'ネットワークエラー: ' + error.message;
    main.replaceChildren(wrap);
    rawPre.textContent = String(error.stack || error.message || '');
  } else {
    const klass = data.status === 'success' ? 'alert-success'
      : data.status === 'dedupe' ? 'alert-secondary'
      : data.status === 'readiness_blocked' ? 'alert-warning'
      : data.status === 'not_implemented' ? 'alert-info'
      : 'alert-danger';
    const headerKlass = data.status === 'success' ? 'card-header bg-success text-white'
      : data.status === 'readiness_blocked' ? 'card-header bg-warning'
      : data.status === 'not_implemented' ? 'card-header bg-info text-white'
      : data.status === 'dedupe' ? 'card-header bg-secondary text-white'
      : 'card-header bg-danger text-white';
    document.getElementById('pubModalHeader').className = headerKlass;
    document.getElementById('pubModalTitle').textContent = labelForStatus(data.status);

    const wrap = document.createElement('div');
    wrap.className = 'alert ' + klass + ' mb-2';
    const head = document.createElement('strong');
    head.textContent = labelForStatus(data.status);
    wrap.appendChild(head);
    if (data.status === 'success') {
      const note = document.createElement('div');
      note.className = 'small mt-2';
      note.innerHTML = '画面を更新して 「移行済み」 タブに反映します...<br>' +
        '<span class="small text-muted">※ Yahoo!ショッピング側で実際に商品ページが表示されるまで 数分かかる場合があります</span>';
      wrap.appendChild(note);
    } else if (data.status === 'readiness_blocked' && data.reasons?.length) {
      const ul = document.createElement('ul');
      ul.className = 'mb-0 mt-2 small';
      for (const r of data.reasons.slice(0, 5)) {
        const li = document.createElement('li');
        li.textContent = typeof r === 'string' ? r : (r.message || JSON.stringify(r));
        ul.appendChild(li);
      }
      wrap.appendChild(ul);
    }
    main.replaceChildren(wrap);
    rawPre.textContent = JSON.stringify(data, null, 2);

    if (data.status === 'success') {
      _pubAutoReloadId = setTimeout(() => location.reload(), 3000);
    }
  }

  // 結果 view では 「閉じる」 だけ。 success は auto-reload するが、 手動で閉じるオプションも残す。
  const cancelBtn = document.getElementById('pubCancelBtn');
  cancelBtn.style.display = '';
  cancelBtn.disabled = false;
  cancelBtn.textContent = '閉じる';
}

function labelForStatus(s) {
  switch (s) {
    case 'success': return '✅ Yahoo に登録できました';
    case 'dedupe': return '⚠ すでに登録済みです (重複防止)';
    case 'readiness_blocked': return '🟡 まだ Notion 修正が必要です';
    case 'not_implemented': return '🧪 テスト実行完了 (本登録は OFF です)';
    case 'flag_off': return '🔒 本登録は OFF です';
    case 'in_progress_conflict': return '⚠ 別の処理が進行中です';
    case 'publish_failed': return '❌ Yahoo 登録に失敗しました';
    case 'lease_lost': return '⚠ 処理が競合しました (確認が必要)';
    default: return '⚠ 結果: ' + s;
  }
}

// ───── 移行除外管理 (Phase E-7-c) ─────
const KIND_LABELS = { temporary: '一時除外', permanent: '永続除外' };

function openExclusionModal() {
  // Codex E-8 R1 M-4: 他モーダルが開いてたら閉じる (closeAllModals は下方で定義、 hoist 不要)
  if (typeof closeAllModals === 'function') closeAllModals();
  document.getElementById('exclusionModal').style.display = 'block';
  // フォームクリア
  document.getElementById('excludeItemCodeInput').value = '';
  document.getElementById('excludeReasonInput').value = '';
  document.getElementById('excludeKindInput').value = 'temporary';
  hideExcludeFormError();
  refreshExclusionList();
}

function closeExclusionModal() {
  document.getElementById('exclusionModal').style.display = 'none';
}

function showExcludeFormError(msg) {
  const el = document.getElementById('excludeFormError');
  el.textContent = msg;
  el.style.display = 'block';
}

function hideExcludeFormError() {
  const el = document.getElementById('excludeFormError');
  el.style.display = 'none';
  el.textContent = '';
}

async function refreshExclusionList() {
  const kind = document.getElementById('exclusionListKindFilter').value;
  const search = document.getElementById('exclusionListSearch').value;
  const params = new URLSearchParams();
  if (kind) params.set('kind', kind);
  if (search) params.set('q', search);
  const container = document.getElementById('exclusionListContainer');
  container.innerHTML = '<div class="text-muted text-center py-4">読み込み中...</div>';
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/exclusions?' + params.toString());
    const data = await res.json();
    document.getElementById('exclusionTotalCount').textContent = (data.counts && data.counts.total) || 0;
    if (!data.items || data.items.length === 0) {
      container.innerHTML = '<div class="text-muted text-center py-4">該当する除外はありません。</div>';
      return;
    }
    const table = document.createElement('table');
    table.className = 'table table-sm table-hover';
    const thead = document.createElement('thead');
    thead.innerHTML = '<tr><th>商品コード</th><th>種類</th><th>理由</th><th>除外日時</th><th class="text-end">操作</th></tr>';
    table.appendChild(thead);
    const tbody = document.createElement('tbody');
    for (const it of data.items) {
      const tr = document.createElement('tr');
      const tdCode = document.createElement('td');
      tdCode.innerHTML = '<code></code>';
      tdCode.querySelector('code').textContent = it.item_code;
      tr.appendChild(tdCode);

      const tdKind = document.createElement('td');
      const badge = document.createElement('span');
      badge.className = it.exclude_kind === 'permanent' ? 'badge bg-danger' : 'badge bg-warning text-dark';
      badge.textContent = KIND_LABELS[it.exclude_kind] || it.exclude_kind;
      tdKind.appendChild(badge);
      tr.appendChild(tdKind);

      const tdReason = document.createElement('td');
      tdReason.textContent = it.reason;
      tdReason.style.maxWidth = '280px';
      tdReason.style.wordBreak = 'break-word';
      tr.appendChild(tdReason);

      const tdDate = document.createElement('td');
      tdDate.className = 'small text-muted';
      tdDate.textContent = it.excluded_at;
      tr.appendChild(tdDate);

      const tdActions = document.createElement('td');
      tdActions.className = 'text-end';
      const restoreBtn = document.createElement('button');
      restoreBtn.className = 'btn btn-sm btn-outline-success me-1';
      restoreBtn.textContent = '↩ 復元';
      restoreBtn.addEventListener('click', () => restoreExclusion(it.item_code));
      tdActions.appendChild(restoreBtn);

      const changeKindBtn = document.createElement('button');
      changeKindBtn.className = 'btn btn-sm btn-outline-secondary';
      changeKindBtn.textContent = it.exclude_kind === 'permanent' ? '→ 一時除外に' : '→ 永続除外に';
      changeKindBtn.addEventListener('click', () => changeKind(it.item_code, it.exclude_kind === 'permanent' ? 'temporary' : 'permanent'));
      tdActions.appendChild(changeKindBtn);

      tr.appendChild(tdActions);
      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    container.replaceChildren(table);
  } catch (e) {
    container.innerHTML = '<div class="alert alert-danger small">読み込みエラー: ' + (e.message || 'unknown') + '</div>';
  }
}

async function doExclude() {
  hideExcludeFormError();
  const itemCode = document.getElementById('excludeItemCodeInput').value.trim();
  const excludeKind = document.getElementById('excludeKindInput').value;
  const reason = document.getElementById('excludeReasonInput').value.trim();
  if (!itemCode) { showExcludeFormError('商品コードを入力してください'); return; }
  if (!reason) { showExcludeFormError('理由を入力してください'); return; }
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/exclusions', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ itemCode, excludeKind, reason }),
    });
    const data = await res.json();
    if (!res.ok) {
      if (data.code === 'EXCLUSION_ALREADY_ACTIVE') {
        showExcludeFormError('この商品は既に除外されています (種類変更したい場合は下の 「→ ◯◯ に」 ボタンを使ってください)');
      } else {
        showExcludeFormError(data.error || ('エラー: HTTP ' + res.status));
      }
      return;
    }
    document.getElementById('excludeItemCodeInput').value = '';
    document.getElementById('excludeReasonInput').value = '';
    await refreshExclusionList();
  } catch (e) {
    showExcludeFormError('ネットワークエラー: ' + e.message);
  }
}

async function restoreExclusion(itemCode) {
  const reason = prompt('復元理由 (任意、 後で履歴で確認できます):', '');
  if (reason === null) return; // cancel
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/exclusions/restore', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ itemCode, reason: reason || null }),
    });
    const data = await res.json();
    if (!res.ok) {
      alert('復元失敗: ' + (data.error || 'HTTP ' + res.status));
      return;
    }
    await refreshExclusionList();
  } catch (e) {
    alert('ネットワークエラー: ' + e.message);
  }
}

async function changeKind(itemCode, newKind) {
  const newLabel = KIND_LABELS[newKind];
  const reason = prompt('「' + itemCode + '」 を ' + newLabel + ' に変更します。\n理由を入力してください:', '');
  if (reason === null) return;
  if (!reason.trim()) {
    alert('理由を入力してください (空白不可)');
    return;
  }
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/exclusions/change-kind', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ itemCode, newKind, reason }),
    });
    const data = await res.json();
    if (!res.ok) {
      alert('変更失敗: ' + (data.error || 'HTTP ' + res.status));
      return;
    }
    await refreshExclusionList();
  } catch (e) {
    alert('ネットワークエラー: ' + e.message);
  }
}

// ───── 楽天↔Yahoo 差分再取得 (Phase E-7-e) ─────
function openDiffSyncModal() {
  document.getElementById('diffSyncModal').style.display = 'block';
}
function closeDiffSyncModal() {
  document.getElementById('diffSyncModal').style.display = 'none';
  // 成功時はリロードして集計反映
  if (window._diffSyncSucceeded) location.reload();
}
async function triggerDiffSync() {
  openDiffSyncModal();
  window._diffSyncSucceeded = false;
  const title = document.getElementById('diffSyncTitle');
  const body = document.getElementById('diffSyncBody');
  title.textContent = '楽天↔Yahoo 差分を再取得中...';
  body.innerHTML = '<div class="text-muted small">Yahoo の全商品リスト + 楽天の全商品リストを取得 → 差分を計算します。 1〜2 分かかります。</div>';
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/diff-sync/trigger', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({}),
    });
    const data = await res.json();
    const wrap = document.createElement('div');
    if (res.ok && data.status === 'ok') {
      window._diffSyncSucceeded = true;
      title.textContent = '✅ 再取得完了';
      const baseline = data.baseline || {};
      const diff = data.diff || {};
      wrap.innerHTML =
        '<div class="alert alert-success">' +
        '<div>Yahoo 観測商品数: <strong>' + (baseline.itemsObserved || 0) + '</strong> 件</div>' +
        '<div>楽天商品数: <strong>' + (diff.rakutenTotal || 0) + '</strong> 件</div>' +
        '<div>新規候補: <strong>' + (diff.newlyDetected || 0) + '</strong> 件</div>' +
        '<div>Yahoo 出た (resolved): <strong>' + (diff.resolved || 0) + '</strong> 件</div>' +
        '<div>楽天消えた (stale): <strong>' + (diff.staleFlipped || 0) + '</strong> 件</div>' +
        '<div class="small text-muted mt-2">所要時間: ' + (data.durationMs || 0) + ' ms</div>' +
        '</div>';
    } else if (res.status === 409) {
      title.textContent = '⚠ 別の同期が走っています';
      const msg = document.createElement('div');
      msg.className = 'alert alert-warning';
      msg.textContent = data.error || '別の sync が実行中です。 数分後にやり直してください。';
      wrap.appendChild(msg);
    } else if (res.status === 412) {
      title.textContent = '⚠ Yahoo baseline が古い / 未確立';
      const msg = document.createElement('div');
      msg.className = 'alert alert-warning';
      msg.textContent = (data.error || 'Yahoo baseline guard で停止しました。') + ' (管理者対応推奨)';
      wrap.appendChild(msg);
    } else {
      title.textContent = '❌ 再取得に失敗しました';
      const msg = document.createElement('div');
      msg.className = 'alert alert-danger';
      msg.textContent = data.error || ('HTTP ' + res.status);
      wrap.appendChild(msg);
    }
    body.replaceChildren(wrap);
  } catch (e) {
    title.textContent = '❌ 通信エラー';
    const div = document.createElement('div');
    div.className = 'alert alert-danger';
    div.textContent = 'ネットワークエラー: ' + e.message;
    body.replaceChildren(div);
  }
}

// ───── 商品詳細ドロワー (Phase E-6-2) ─────
// Codex R1 Medium-1: open 時の focus を覚えて、 閉じた時に復帰させる (キーボード操作のアクセシビリティ)
let _drawerPreviouslyFocused = null;

// Codex R1 High: 可変文字列を innerHTML に連結しない。 static class のみ wrap、 message は textContent。
function drawerMessage(className, message) {
  const div = document.createElement('div');
  div.className = className;
  div.textContent = message;
  return div;
}

function openDetailDrawer(itemCode) {
  const backdrop = document.getElementById('detailDrawerBackdrop');
  const content = document.getElementById('detailDrawerContent');
  document.getElementById('detailDrawerTitle').textContent = '商品詳細: ' + itemCode;
  content.replaceChildren(drawerMessage('drawer-section text-muted small', '読み込み中...'));
  backdrop.classList.add('show');
  _drawerPreviouslyFocused = document.activeElement;
  // close button に focus 移動 (drawer 内のキーボード操作)
  setTimeout(() => {
    const closeBtn = backdrop.querySelector('.js-close-detail-drawer');
    if (closeBtn) closeBtn.focus();
  }, 50);
  fetchDetailAndRender(itemCode);
}

function closeDetailDrawer() {
  document.getElementById('detailDrawerBackdrop').classList.remove('show');
  // focus 復帰
  if (_drawerPreviouslyFocused && typeof _drawerPreviouslyFocused.focus === 'function') {
    try { _drawerPreviouslyFocused.focus(); } catch (_) {}
  }
  _drawerPreviouslyFocused = null;
}

async function fetchDetailAndRender(itemCode) {
  const content = document.getElementById('detailDrawerContent');
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/products/' + encodeURIComponent(itemCode) + '/detail');
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      // Codex R1 High: data.error は server から来た任意文字列 → textContent で出す
      content.replaceChildren(drawerMessage(
        'drawer-section alert alert-danger small',
        '読み込み失敗: ' + (data.error || ('HTTP ' + res.status))
      ));
      return;
    }
    const data = await res.json();
    // Phase E-9: ドロワーのヘッダーにも楽天タイトル fallback を入れる
    const titleHeader = data.notion?.yahoo_title || data.candidate?.rakuten_title || itemCode;
    document.getElementById('detailDrawerTitle').textContent = '商品詳細: ' + titleHeader + ' (' + itemCode + ')';
    content.replaceChildren(buildDetailContent(data));
    // Phase E-8: 楽天画像セクションを非同期で追加 (楽天 RMS fetch 失敗時もドロワーは出す)
    loadRakutenImagesIntoDrawer(itemCode);
  } catch (e) {
    // Codex R1 High: e.message も textContent で出す
    content.replaceChildren(drawerMessage(
      'drawer-section alert alert-danger small',
      'ネットワークエラー: ' + e.message
    ));
  }
}

// Codex E-8 R1 M-1: 楽天 RMS 由来 URL を a.href / img.src に入れる前に scheme allowlist で検査。
//   javascript:/data: 等を弾く。
// Phase E-9 hotfix: 楽天 RMS は protocol-relative URL (`//image.rakuten.co.jp/...`) で
//   返してくることが多いので、 そのケースは https: 補完して通す。
//   (E-8 deploy 後、 中原さん画面で kept 18 枚が表示されない事故から修正)
function safeImageUrl(u) {
  if (typeof u !== 'string') return '';
  const s = u.trim();
  if (!s) return '';
  if (/^https?:\/\//i.test(s)) return s;
  if (/^\/\//.test(s)) return 'https:' + s;
  return '';
}

async function loadRakutenImagesIntoDrawer(itemCode) {
  const content = document.getElementById('detailDrawerContent');
  if (!content) return;
  const sec = el('div', { className: 'drawer-section', id: 'drawer-rakuten-images-section' });
  sec.appendChild(el('h6', { text: '🖼️ 楽天画像 (Yahoo 移行プレビュー)' }));
  sec.appendChild(el('div', { className: 'text-muted small', text: '楽天 RMS から取得中...' }));
  content.appendChild(sec);
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/products/' + encodeURIComponent(itemCode) + '/rakuten-images');
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      sec.replaceChildren();
      sec.appendChild(el('h6', { text: '🖼️ 楽天画像 (Yahoo 移行プレビュー)' }));
      sec.appendChild(el('div', { className: 'small text-warning', text: '楽天画像の取得に失敗: ' + (data.error || ('HTTP ' + res.status)) }));
      return;
    }
    const data = await res.json();
    sec.replaceChildren();
    sec.appendChild(el('h6', { text: '🖼️ 楽天画像 (Yahoo 移行プレビュー)' }));
    sec.appendChild(el('div', { className: 'small text-muted mb-2',
      text: 'Yahoo 移行: ' + data.keptCount + ' 枚 / 除外: ' + data.excludedCount + ' 枚 (楽天 manage_number=' + data.manageNumber + ')'
    }));
    // kept
    if (data.kept && data.kept.length > 0) {
      const keptWrap = el('div', { className: 'mb-2' });
      keptWrap.appendChild(el('div', { className: 'small fw-bold', text: '✅ Yahoo に登録される画像 (' + data.kept.length + ')' }));
      const gallery = el('div'); gallery.style.display = 'flex'; gallery.style.flexWrap = 'wrap'; gallery.style.gap = '6px';
      for (const k of data.kept) {
        const safeUrl = safeImageUrl(k.url);
        if (!safeUrl) continue;
        const a = el('a'); a.href = safeUrl; a.target = '_blank'; a.rel = 'noopener';
        const img = el('img'); img.src = safeUrl; img.alt = ''; img.loading = 'lazy';
        img.style.width = '70px'; img.style.height = '70px'; img.style.objectFit = 'cover'; img.style.border = '1px solid #ccc'; img.style.borderRadius = '3px';
        a.appendChild(img); gallery.appendChild(a);
      }
      keptWrap.appendChild(gallery);
      sec.appendChild(keptWrap);
    }
    // excluded
    if (data.excluded && data.excluded.length > 0) {
      const excWrap = el('div');
      excWrap.appendChild(el('div', { className: 'small fw-bold text-danger', text: '🚫 除外される画像 (' + data.excluded.length + ')' }));
      for (const x of data.excluded) {
        const row = el('div'); row.style.display = 'flex'; row.style.alignItems = 'center'; row.style.gap = '8px';
        row.style.padding = '4px 0'; row.style.borderBottom = '1px solid #f4f4f4';
        const safeUrl = safeImageUrl(x.url);
        if (safeUrl) {
          const a = el('a'); a.href = safeUrl; a.target = '_blank'; a.rel = 'noopener';
          const img = el('img'); img.src = safeUrl; img.alt = ''; img.loading = 'lazy';
          img.style.width = '50px'; img.style.height = '50px'; img.style.objectFit = 'cover'; img.style.border = '1px solid #ccc'; img.style.borderRadius = '3px';
          img.style.opacity = '0.5';
          a.appendChild(img); row.appendChild(a);
        } else {
          const ph = el('div'); ph.style.width = '50px'; ph.style.height = '50px'; ph.style.border = '1px dashed #ccc';
          ph.style.display = 'flex'; ph.style.alignItems = 'center'; ph.style.justifyContent = 'center';
          ph.style.fontSize = '.7rem'; ph.style.color = '#999'; ph.textContent = 'URL不可';
          row.appendChild(ph);
        }
        const meta = el('div', { className: 'small' });
        const badge = el('span', { className: 'badge ' + (x.source === 'builtin' ? 'bg-secondary' : 'bg-warning text-dark'),
          text: x.source === 'builtin' ? '組込み' : 'ユーザー追加' });
        meta.appendChild(badge);
        meta.appendChild(el('span', { className: 'ms-2', text: 'マッチ: ' }));
        meta.appendChild(el('code', { text: x.matchedPattern }));
        row.appendChild(meta);
        excWrap.appendChild(row);
      }
      sec.appendChild(excWrap);
    }
    if ((data.kept?.length || 0) === 0 && (data.excluded?.length || 0) === 0) {
      sec.appendChild(el('div', { className: 'text-muted small', text: '(楽天画像なし)' }));
    }
  } catch (e) {
    sec.replaceChildren();
    sec.appendChild(el('h6', { text: '🖼️ 楽天画像 (Yahoo 移行プレビュー)' }));
    sec.appendChild(el('div', { className: 'small text-warning', text: '楽天画像の取得エラー: ' + e.message }));
  }
}

function fragment() { return document.createDocumentFragment(); }
function el(tag, opts = {}) {
  const e = document.createElement(tag);
  if (opts.className) e.className = opts.className;
  if (opts.text !== undefined) e.textContent = opts.text;
  if (opts.html !== undefined) e.innerHTML = opts.html;
  return e;
}
function dlSection(title, items) {
  const sec = el('div', { className: 'drawer-section' });
  sec.appendChild(el('h6', { text: title }));
  const dl = el('dl');
  for (const [label, value] of items) {
    if (value === null || value === undefined || value === '') continue;
    const dt = el('dt', { text: label });
    const dd = el('dd');
    if (typeof value === 'string' || typeof value === 'number') {
      dd.textContent = String(value);
    } else if (value instanceof Node) {
      dd.appendChild(value);
    }
    dl.appendChild(dt);
    dl.appendChild(dd);
  }
  if (dl.children.length === 0) sec.appendChild(el('div', { className: 'text-muted small', text: '(データなし)' }));
  else sec.appendChild(dl);
  return sec;
}

function buildDetailContent(data) {
  const frag = fragment();

  // 基本情報 (candidate)
  if (data.candidate) {
    // Phase E-11-d: Yahoo カテゴリ自動推定の表示行
    const ycr = data.yahooCategoryResolved || {};
    const ycrLabel = (() => {
      if (!ycr.category) return '(未解決)';
      const src = ycr.source === 'notion' ? '✓ Notion 確定値' :
                  ycr.source === 'learned' ? '🤖 自動推定 (sample=' + (ycr.sampleCount || '?') + ')' :
                  ycr.source;
      return ycr.category + ' / ' + (ycr.path || '(path 無し)') + ' [' + src + ']';
    })();

    frag.appendChild(dlSection('🛒 候補メタ', [
      ['楽天商品コード', data.candidate.item_code],
      ['楽天 manage_number', data.candidate.rakuten_manage_number],
      ['楽天タイトル', data.candidate.rakuten_title || '(未取得)'],
      ['楽天 genreId', data.candidate.rakuten_genre_id || '(未取得)'],
      ['楽天 genre 階層', data.candidate.rakuten_genre_path || '(未取得)'],
      ['Yahoo カテゴリ (推定)', ycrLabel],
      ['候補ステータス', data.candidate.status],
      ['初検出日時', data.candidate.first_detected_at],
      ['最終検出日時', data.candidate.last_detected_at],
      ['楽天最終観測', data.candidate.last_seen_in_rakuten_at],
      ['Yahoo 最終比較', data.candidate.last_checked_yahoo_baseline_at],
      ['楽天で連続欠落数', data.candidate.missing_rakuten_count],
      ['stale 化日時', data.candidate.stale_at],
      ['resolved 日時', data.candidate.resolved_at],
    ]));
  } else {
    frag.appendChild(el('div', { className: 'drawer-section text-muted small', text: '⚠ migration_candidates に登録なし (orphan 扱い)' }));
  }

  // Notion
  if (data.notion) {
    const pageLink = data.notionPageUrl ? (() => {
      const a = el('a', { text: 'Notion で開く' });
      a.href = data.notionPageUrl; a.target = '_blank'; a.rel = 'noopener noreferrer';
      return a;
    })() : null;
    frag.appendChild(dlSection('📝 Notion 上書き値', [
      ['Yahoo!タイトル', data.notion.yahoo_title],
      ['売価', data.notion.yahoo_price !== null && data.notion.yahoo_price !== undefined ? '¥' + Number(data.notion.yahoo_price).toLocaleString() : null],
      ['佐川価格', data.notion.yahoo_price_sagawa !== null && data.notion.yahoo_price_sagawa !== undefined ? '¥' + Number(data.notion.yahoo_price_sagawa).toLocaleString() : null],
      ['配送方法', data.notion.notion_delivery_label],
      ['税率', data.notion.notion_tax_rate],
      // Phase E-11-d: Notion master の確定 Yahoo!カテゴリ + path (列が無ければ null)
      ['Yahoo!カテゴリ (Notion)', data.notion.notion_product_category || '(未入力)'],
      ['Yahoo!path (Notion)', data.notion.notion_path || '(未入力)'],
      ['Notion ステータス', data.notion.notion_status],
      ['Notion 同期日時', data.notion.synced_at],
      ['Notion ページ', pageLink],
    ]));
  } else {
    frag.appendChild(el('div', { className: 'drawer-section', html: '<h6>📝 Notion 上書き値</h6><div class="text-muted small">(Notion 商品マスターに該当行なし)</div>' }));
  }

  // Yahoo 観測
  if (data.yahoo) {
    frag.appendChild(dlSection('✅ Yahoo!ショッピング観測', [
      ['Yahoo ItemCode', data.yahoo.yahoo_item_code],
      ['HasSubCode', data.yahoo.has_sub_code ? 'true' : 'false'],
      ['最終観測日時', data.yahoo.last_seen_at],
      ['source', data.yahoo.source],
    ]));
  } else {
    frag.appendChild(el('div', { className: 'drawer-section', html: '<h6>✅ Yahoo!ショッピング観測</h6><div class="text-muted small">(まだ Yahoo に居ません)</div>' }));
  }

  // readiness
  if (data.readiness) {
    const sec = el('div', { className: 'drawer-section' });
    sec.appendChild(el('h6', { text: '🔍 readiness 評価' }));
    const dl = el('dl');
    dl.appendChild(el('dt', { text: 'ステータス' }));
    dl.appendChild(el('dd', { text: data.readiness.status || '(未評価)' }));
    if (data.readiness.lastReadinessAt) {
      dl.appendChild(el('dt', { text: '最終評価日時' }));
      dl.appendChild(el('dd', { text: data.readiness.lastReadinessAt }));
    }
    if (data.readiness.blockedReasonsTranslated?.length > 0) {
      dl.appendChild(el('dt', { text: '不備理由' }));
      const dd = el('dd');
      const ul = el('ul'); ul.style.margin = '0'; ul.style.paddingLeft = '1.2em';
      for (const r of data.readiness.blockedReasonsTranslated) {
        ul.appendChild(el('li', { text: r.message + (r.notionField ? '（' + r.notionField + '）' : '') }));
      }
      dd.appendChild(ul);
      dl.appendChild(dd);
    }
    sec.appendChild(dl);
    frag.appendChild(sec);
  }

  // publish 履歴
  const pubSec = el('div', { className: 'drawer-section' });
  pubSec.appendChild(el('h6', { text: '▶️ Yahoo 登録履歴' }));
  if (!data.publishHistory || data.publishHistory.length === 0) {
    pubSec.appendChild(el('div', { className: 'text-muted small', text: '(登録試行なし)' }));
  } else {
    for (const p of data.publishHistory) {
      const row = el('div', { className: 'drawer-history-row' });
      const status = el('span');
      status.textContent = (p.status === 'success' ? '✅ ' : p.status === 'failed' ? '❌ ' : p.status === 'not_implemented' ? '🧪 ' : '⚪ ') + p.status;
      row.appendChild(status);
      row.appendChild(el('span', { className: 'text-muted small ms-2', text: (p.completed_at || p.created_at || '') + (p.attempt > 1 ? ' (試行 ' + p.attempt + ')' : '') }));
      if (p.error_message) {
        row.appendChild(el('div', { className: 'small text-danger', text: p.error_message }));
      }
      pubSec.appendChild(row);
    }
  }
  frag.appendChild(pubSec);

  // 除外履歴
  const excSec = el('div', { className: 'drawer-section' });
  excSec.appendChild(el('h6', { text: '🚫 除外履歴' }));
  if (!data.exclusionHistory || data.exclusionHistory.length === 0) {
    excSec.appendChild(el('div', { className: 'text-muted small', text: '(除外履歴なし)' }));
  } else {
    for (const ex of data.exclusionHistory) {
      const row = el('div', { className: 'drawer-history-row' });
      const kindLabel = ex.exclude_kind === 'permanent' ? '永続除外' : '一時除外';
      const status = ex.restored_at ? '↩ 復元済み' : '🔴 active';
      row.appendChild(el('strong', { text: kindLabel }));
      row.appendChild(el('span', { className: 'ms-2 small', text: status }));
      row.appendChild(el('div', { className: 'small', text: '理由: ' + (ex.reason || '(なし)') }));
      row.appendChild(el('div', { className: 'small text-muted', text: '除外: ' + ex.excluded_at + (ex.excluded_by ? ' / ' + ex.excluded_by : '') }));
      if (ex.restored_at) {
        row.appendChild(el('div', { className: 'small text-muted', text: '復元: ' + ex.restored_at + (ex.restored_by ? ' / ' + ex.restored_by : '') + (ex.restored_reason ? ' / 理由: ' + ex.restored_reason : '') }));
      }
      excSec.appendChild(row);
    }
  }
  frag.appendChild(excSec);

  return frag;
}

// ───── 一括 publish (Phase E-6-3) ─────
const bulkSelected = new Set();
function updateBulkBar() {
  const count = bulkSelected.size;
  document.getElementById('bulkSelectedCount').textContent = String(count);
  const btn = document.querySelector('.js-bulk-publish-execute');
  if (btn) {
    btn.textContent = '▶️ 選択した ' + count + ' 商品を一括登録';
    btn.disabled = count === 0;
  }
}
function toggleBulkMode() {
  const on = document.body.classList.toggle('bulk-mode');
  if (!on) {
    bulkSelected.clear();
    document.querySelectorAll('.js-bulk-checkbox').forEach((cb) => { cb.checked = false; });
  }
  updateBulkBar();
}
function bulkSelectAll() {
  for (const cb of document.querySelectorAll('.js-bulk-checkbox')) {
    cb.checked = true;
    bulkSelected.add(cb.dataset.itemCode);
  }
  updateBulkBar();
}
function bulkDeselectAll() {
  bulkSelected.clear();
  document.querySelectorAll('.js-bulk-checkbox').forEach((cb) => { cb.checked = false; });
  updateBulkBar();
}

function openBulkPublishModal(title, itemCodes = []) {
  const modal = document.getElementById('bulkPublishModal');
  document.getElementById('bulkPublishTitle').textContent = title || '一括登録中...';
  document.getElementById('bulkPublishProgressBar').style.width = '0%';
  document.getElementById('bulkPublishProgressText').textContent = '⏳ サーバーに送信中...';
  document.getElementById('bulkPublishResults').innerHTML = '';
  document.querySelector('.js-close-bulk-publish-modal').disabled = true;
  modal.style.display = 'block';
  // Phase E-9 中原さん指摘: 「押した直後に何も起きてないように見える」 を解消。
  //   送信前に対象 itemCode を 「⏳ 待機中」 として全部表示する。
  if (itemCodes.length > 0) {
    const wrap = document.getElementById('bulkPublishResults');
    wrap.innerHTML = '';
    for (const code of itemCodes) {
      const row = document.createElement('div');
      row.className = 'small py-1 border-bottom bulk-item-row';
      row.id = 'bulk-item-' + cssId(code);
      row.dataset.itemCode = code;
      row.innerHTML = '<span class="bulk-item-status">⏳</span> <code>' + escapeHtml(code) + '</code> <span class="bulk-item-label text-muted">待機中</span>';
      wrap.appendChild(row);
    }
  }
}
function cssId(s) { return String(s).replace(/[^a-zA-Z0-9_-]/g, '_'); }
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function closeBulkPublishModal() {
  document.getElementById('bulkPublishModal').style.display = 'none';
  // 成功あれば reload して件数集計を更新
  if (window._bulkPublishSucceededCount > 0) location.reload();
}
function setBulkProgress(batch) {
  const done = (batch.succeeded || 0) + (batch.failed || 0);
  const total = batch.total || 0;
  const pct = total > 0 ? Math.round(done * 100 / total) : 0;
  document.getElementById('bulkPublishProgressBar').style.width = pct + '%';
  document.getElementById('bulkPublishProgressText').textContent =
    done + '/' + total + ' 完了 (成功 ' + (batch.succeeded || 0) + ' / 失敗 ' + (batch.failed || 0) + ')'
    + (batch.status === 'running' ? ' — ⚙️ 処理中…' : '');
}

// Phase E-9 中原さん指摘: 1 商品ずつ状態が見えるよう、 poll 毎に各 item の行を更新する。
function updateBulkResultRow(item) {
  const id = 'bulk-item-' + cssId(item.item_code);
  let row = document.getElementById(id);
  if (!row) {
    // 開始前 itemCode リストに無かった (retry-failed 等) → 新規 append
    const wrap = document.getElementById('bulkPublishResults');
    row = document.createElement('div');
    row.className = 'small py-1 border-bottom bulk-item-row';
    row.id = id;
    row.dataset.itemCode = item.item_code;
    wrap.appendChild(row);
  }
  const statusIcon = item.status === 'success' ? '✅'
    : item.status === 'failed' ? '❌'
    : item.status === 'running' ? '🔄'
    : item.status === 'dedupe' ? '⚠'
    : item.status === 'flag_off' ? '🔒'
    : item.status === 'readiness_blocked' ? '🟡'
    : '⏳';
  const label = item.status === 'success' ? 'Yahoo に登録しました'
    : item.status === 'failed' ? '失敗'
    : item.status === 'running' ? '楽天から取得 → Yahoo に登録中…'
    : item.status === 'dedupe' ? '重複検出 (既に処理済み)'
    : item.status === 'flag_off' ? '本番モード OFF のためスキップ'
    : item.status === 'readiness_blocked' ? 'Notion 必須項目に不足 — スキップ'
    : item.status === 'pending' ? '待機中'
    : (item.status || '?');
  // background highlight for running row
  row.style.backgroundColor = item.status === 'running' ? '#fff3cd' : '';
  let html = '<span class="bulk-item-status">' + statusIcon + '</span> '
           + '<code>' + escapeHtml(item.item_code) + '</code> '
           + '<span class="bulk-item-label">' + escapeHtml(label) + '</span>';
  if (item.error_message) {
    html += '<div class="text-danger small ms-3">' + escapeHtml(item.error_message) + '</div>';
  }
  row.innerHTML = html;
}

async function pollBulkBatch(batchId) {
  while (true) {
    try {
      const res = await fetch('/apps/rakuten-yahoo-sync/api/publish/bulk/' + batchId + '?withItems=1');
      const data = await res.json();
      if (!data.batch) break;
      setBulkProgress(data.batch);
      // Phase E-9: poll 毎に items を更新 (running も含む)
      for (const it of (data.items || [])) updateBulkResultRow(it);
      if (data.batch.status !== 'running') {
        document.querySelector('.js-close-bulk-publish-modal').disabled = false;
        window._bulkPublishSucceededCount = data.batch.succeeded || 0;
        document.getElementById('bulkPublishTitle').textContent =
          data.batch.status === 'completed' ? '✅ 一括登録完了' :
          data.batch.status === 'failed' ? '❌ 一括登録失敗' : '⚠ 一括登録中止';
        break;
      }
    } catch (e) {
      document.getElementById('bulkPublishProgressText').textContent = '進捗取得エラー: ' + e.message;
      document.querySelector('.js-close-bulk-publish-modal').disabled = false;
      break;
    }
    await new Promise((r) => setTimeout(r, 600));
  }
}

async function executeBulkPublish() {
  const itemCodes = Array.from(bulkSelected);
  if (itemCodes.length === 0) return;
  openBulkPublishModal('一括登録中... (' + itemCodes.length + ' 商品)');
  window._bulkPublishSucceededCount = 0;
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/publish/bulk/start', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ itemCodes, triggeredBy: 'manual' }),
    });
    const data = await res.json();
    if (!res.ok || !data.batchId) {
      document.getElementById('bulkPublishTitle').textContent = '❌ 開始失敗';
      document.getElementById('bulkPublishProgressText').textContent = data.error || ('HTTP ' + res.status);
      document.querySelector('.js-close-bulk-publish-modal').disabled = false;
      return;
    }
    await pollBulkBatch(data.batchId);
  } catch (e) {
    document.getElementById('bulkPublishTitle').textContent = '❌ ネットワークエラー';
    document.getElementById('bulkPublishProgressText').textContent = e.message;
    document.querySelector('.js-close-bulk-publish-modal').disabled = false;
  }
}

async function retryFailedPublish() {
  if (!confirm('失敗中の publish をまとめて再実行します。\nよろしいですか?')) return;
  openBulkPublishModal('失敗中の publish を再実行中...');
  window._bulkPublishSucceededCount = 0;
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/publish/bulk/retry-failed', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ limit: 50 }),
    });
    const data = await res.json();
    if (data.batchId === null && data.total === 0) {
      document.getElementById('bulkPublishTitle').textContent = '⚠ 失敗中の publish はありません';
      document.querySelector('.js-close-bulk-publish-modal').disabled = false;
      return;
    }
    if (!res.ok || !data.batchId) {
      document.getElementById('bulkPublishTitle').textContent = '❌ 開始失敗';
      document.getElementById('bulkPublishProgressText').textContent = data.error || ('HTTP ' + res.status);
      document.querySelector('.js-close-bulk-publish-modal').disabled = false;
      return;
    }
    await pollBulkBatch(data.batchId);
  } catch (e) {
    document.getElementById('bulkPublishTitle').textContent = '❌ ネットワークエラー';
    document.getElementById('bulkPublishProgressText').textContent = e.message;
    document.querySelector('.js-close-bulk-publish-modal').disabled = false;
  }
}

// ───── 楽天タイトル backfill (Phase E-9) ─────
async function backfillRakutenTitle(evt) {
  const btn = evt.currentTarget;
  if (!btn || btn.disabled) return;
  const original = btn.textContent;
  btn.disabled = true;
  btn.textContent = '取得中...';
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/rakuten-title-backfill', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ limit: 200 }),
    });
    const data = await res.json();
    if (!res.ok) {
      alert('取得失敗: ' + (data.error || ('HTTP ' + res.status)));
      btn.disabled = false; btn.textContent = original;
      return;
    }
    // 成功: 取得件数 / 残件数 を表示してリロード
    const msg = `楽天タイトル ${data.updated} 件取得しました (残 ${data.remaining} 件)。 ページを再読み込みします。`;
    alert(msg);
    location.reload();
  } catch (e) {
    alert('ネットワークエラー: ' + e.message);
    btn.disabled = false; btn.textContent = original;
  }
}

// ───── Yahoo カテゴリ学習 (Phase E-11-b) ─────
async function yahooCategoryLearn(evt) {
  const btn = evt.currentTarget;
  if (!btn || btn.disabled) return;
  if (!confirm('楽天移行候補商品が Yahoo にも出ているもの (overlap 行) のカテゴリと path を ' +
    '楽天 genre と紐付けて学習辞書を作ります。\n' +
    '対象は数十〜数百件、 1 回押せばたいてい完了します。\n続行しますか?')) return;
  const original = btn.innerHTML;
  btn.disabled = true;
  btn.textContent = '取得中...';
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/yahoo-category/backfill-and-learn', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ limit: 500 }),
    });
    const data = await res.json();
    if (!res.ok) {
      alert('取得失敗: ' + (data.error || ('HTTP ' + res.status)));
      btn.disabled = false; btn.innerHTML = original;
      return;
    }
    const lrn = data.learning || {};
    const remainMsg = data.remaining > 0
      ? '\n残 ' + data.remaining + ' 件 (もう一度押すと続きを取れます)'
      : '\n対象全件完了';
    alert('Yahoo カテゴリ取得 ' + data.updated + ' 件 / 失敗 ' + data.failed + ' 件\n' +
      '学習辞書: ' + (lrn.genresLearned || 0) + ' genre / ' + (lrn.mappingRowsUpserted || 0) + ' 対応' +
      remainMsg);
    location.reload();
  } catch (e) {
    alert('ネットワークエラー: ' + e.message);
    btn.disabled = false; btn.innerHTML = original;
  }
}

// ───── 画像除外パターン管理 (Phase E-8) ─────
// Codex E-8 R1 M-4: モーダル open 前に他モーダル (移行除外、 Notion sync, publish 確認、 一括 publish) を閉じる helper。
function closeAllModals() {
  const ids = ['exclusionModal', 'syncModal', 'pubModal', 'bulkPublishModal', 'diffSyncModal', 'imageExclusionModal'];
  for (const id of ids) {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  }
}
function openImageExclusionModal() {
  closeAllModals();
  document.getElementById('imageExclusionModal').style.display = 'block';
  document.getElementById('imgPatternInput').value = '';
  document.getElementById('imgPatternReasonInput').value = '';
  hideImagePatternFormError();
  refreshImageExclusionList();
}
function closeImageExclusionModal() {
  document.getElementById('imageExclusionModal').style.display = 'none';
}
function showImagePatternFormError(msg) {
  const el = document.getElementById('imgPatternFormError');
  el.textContent = msg;
  el.style.display = 'block';
}
function hideImagePatternFormError() {
  const el = document.getElementById('imgPatternFormError');
  el.style.display = 'none';
  el.textContent = '';
}
async function refreshImageExclusionList() {
  const container = document.getElementById('imageExclusionListContainer');
  container.replaceChildren();
  container.appendChild(el('div', { className: 'text-muted text-center py-4', text: '読み込み中...' }));
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/image-exclusion/patterns');
    const data = await res.json();
    container.replaceChildren();
    if (!data.patterns || data.patterns.length === 0) {
      container.appendChild(el('div', { className: 'text-muted text-center py-4', text: '(パターンなし)' }));
      return;
    }
    const list = el('div', { className: 'list-group' });
    for (const p of data.patterns) {
      const row = el('div', { className: 'list-group-item d-flex align-items-center gap-2' });
      const badge = el('span', { className: 'badge ' + (p.source === 'builtin' ? 'bg-secondary' : 'bg-warning text-dark'),
        text: p.source === 'builtin' ? '組込み' : 'ユーザー追加' });
      row.appendChild(badge);
      const main = el('div', { className: 'flex-grow-1' });
      const codeEl = el('code', { text: p.pattern });
      main.appendChild(codeEl);
      const reasonDiv = el('div', { className: 'small text-muted', text: p.reason });
      main.appendChild(reasonDiv);
      if (p.created_at) {
        main.appendChild(el('div', { className: 'small text-muted', text: '登録: ' + p.created_at + (p.created_by ? ' / ' + p.created_by : '') }));
      }
      row.appendChild(main);
      if (p.source === 'custom' && p.id) {
        const btn = el('button', { className: 'btn btn-sm btn-outline-danger', text: '削除' });
        btn.addEventListener('click', () => deleteImagePattern(p.id, p.pattern));
        row.appendChild(btn);
      } else {
        row.appendChild(el('span', { className: 'text-muted small', text: '(削除不可)' }));
      }
      list.appendChild(row);
    }
    container.appendChild(list);
  } catch (e) {
    container.replaceChildren();
    container.appendChild(el('div', { className: 'alert alert-danger small', text: '読み込み失敗: ' + e.message }));
  }
}
async function addImagePattern() {
  hideImagePatternFormError();
  const pattern = document.getElementById('imgPatternInput').value.trim();
  const reason = document.getElementById('imgPatternReasonInput').value.trim();
  if (!pattern || !reason) {
    showImagePatternFormError('文字列と理由を両方入力してください');
    return;
  }
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/image-exclusion/patterns', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pattern, reason }),
    });
    const data = await res.json();
    if (!res.ok) {
      showImagePatternFormError(data.error || ('HTTP ' + res.status));
      return;
    }
    document.getElementById('imgPatternInput').value = '';
    document.getElementById('imgPatternReasonInput').value = '';
    refreshImageExclusionList();
  } catch (e) {
    showImagePatternFormError('ネットワークエラー: ' + e.message);
  }
}
async function deleteImagePattern(id, pattern) {
  if (!confirm('パターン 「' + pattern + '」 を削除しますか?\n削除すると、 以降の Yahoo 移行ではこの文字列を含む画像も登録対象になります。')) return;
  try {
    const res = await fetch('/apps/rakuten-yahoo-sync/api/image-exclusion/patterns/' + encodeURIComponent(id), { method: 'DELETE' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      alert('削除失敗: ' + (data.error || ('HTTP ' + res.status)));
      return;
    }
    refreshImageExclusionList();
  } catch (e) {
    alert('ネットワークエラー: ' + e.message);
  }
}

// 起動時 event 配線
document.addEventListener('DOMContentLoaded', () => {
  document.querySelector('.js-open-exclusion-mgmt')?.addEventListener('click', openExclusionModal);
  document.querySelector('.js-open-image-exclusion-mgmt')?.addEventListener('click', openImageExclusionModal);
  document.querySelector('.js-backfill-rakuten-title')?.addEventListener('click', backfillRakutenTitle);
  document.querySelector('.js-yahoo-category-learn')?.addEventListener('click', yahooCategoryLearn);
  document.querySelectorAll('.js-close-image-exclusion-modal').forEach((el) => el.addEventListener('click', closeImageExclusionModal));
  document.querySelector('.js-add-image-pattern')?.addEventListener('click', addImagePattern);
  document.querySelectorAll('.js-close-exclusion-modal').forEach((el) => el.addEventListener('click', closeExclusionModal));
  document.querySelector('.js-do-exclude')?.addEventListener('click', doExclude);
  document.getElementById('exclusionListKindFilter')?.addEventListener('change', refreshExclusionList);
  document.getElementById('exclusionListSearch')?.addEventListener('input', () => {
    clearTimeout(window._exclusionSearchTimer);
    window._exclusionSearchTimer = setTimeout(refreshExclusionList, 300);
  });
  // E-7-e
  document.querySelector('.js-trigger-diff-sync')?.addEventListener('click', triggerDiffSync);
  document.querySelectorAll('.js-close-diff-sync-modal').forEach((el) => el.addEventListener('click', closeDiffSyncModal));

  // E-6-2: card クリック → drawer 表示。
  //   action buttons (.actions 内) と bulk checkbox のクリックは drawer を開かない。
  for (const card of document.querySelectorAll('.js-open-detail')) {
    card.addEventListener('click', (ev) => {
      if (ev.target.closest('.actions')) return;
      if (ev.target.closest('.bulk-checkbox-wrap')) return;
      if (document.body.classList.contains('bulk-mode')) return; // bulk mode 中は drawer 開かない
      const code = ev.currentTarget.dataset.itemCode;
      if (code) openDetailDrawer(code);
    });
    card.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        if (ev.target.closest('.actions')) return;
        if (ev.target.closest('.bulk-checkbox-wrap')) return;
        if (document.body.classList.contains('bulk-mode')) return;
        ev.preventDefault();
        const code = ev.currentTarget.dataset.itemCode;
        if (code) openDetailDrawer(code);
      }
    });
  }

  // E-6-3: 一括選択 + 一括 publish
  document.querySelectorAll('.js-toggle-bulk-mode').forEach((el) => el.addEventListener('click', toggleBulkMode));
  document.querySelector('.js-bulk-select-all')?.addEventListener('click', bulkSelectAll);
  document.querySelector('.js-bulk-deselect-all')?.addEventListener('click', bulkDeselectAll);
  document.querySelector('.js-bulk-publish-execute')?.addEventListener('click', executeBulkPublish);
  document.querySelector('.js-retry-failed-publish')?.addEventListener('click', retryFailedPublish);
  document.querySelectorAll('.js-close-bulk-publish-modal').forEach((el) => el.addEventListener('click', closeBulkPublishModal));
  for (const cb of document.querySelectorAll('.js-bulk-checkbox')) {
    cb.addEventListener('change', (ev) => {
      const code = ev.currentTarget.dataset.itemCode;
      if (ev.currentTarget.checked) bulkSelected.add(code);
      else bulkSelected.delete(code);
      updateBulkBar();
    });
  }
  document.querySelectorAll('.js-close-detail-drawer').forEach((el) => el.addEventListener('click', closeDetailDrawer));
  // backdrop click (panel 外をクリック) で閉じる
  document.getElementById('detailDrawerBackdrop')?.addEventListener('click', (ev) => {
    if (ev.target === ev.currentTarget) closeDetailDrawer();
  });
  // ESC で閉じる
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape') closeDetailDrawer();
  });
});
</script>
</body>
</html>
