<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .iw-wrap { max-width: 900px; margin: 0 auto; padding: 12px 16px; }
    .iw-box { background: #f8f9fa; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px; }
    .iw-box h2 { font-size: 1.0em; margin: 0 0 10px; }
    .iw-box p.hint { font-size: 0.85em; color: #495057; margin: 0 0 10px; line-height: 1.6; }
    .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .row input[type=text] { padding: 7px; width: 220px; }
    .row select { padding: 7px; }
    .row button { padding: 7px 18px; cursor: pointer; }
    .msg { font-size: 0.9em; } .msg.err { color: #c92a2a; } .msg.ok { color: #2b8a3e; }
    table.iw-list { width: 100%; border-collapse: collapse; font-size: 0.88em; }
    table.iw-list th, table.iw-list td { border-bottom: 1px solid #dee2e6; padding: 6px 8px; text-align: left; vertical-align: top; }
    table.iw-list th { background: #f1f3f5; white-space: nowrap; }
    tr.revoked td, tr.inactive td { color: #adb5bd; text-decoration: line-through; }
    .btn-sm { padding: 3px 10px; font-size: 0.85em; cursor: pointer; }
    .ng { color: #c92a2a; }
    .code-big { font-size: 2em; font-weight: 700; letter-spacing: 0.2em; font-family: ui-monospace, Menlo, monospace; }
    code { background: #e9ecef; padding: 1px 5px; border-radius: 4px; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">🎋 いろは在庫化 作業アプリ 管理</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="<%= base %>/" class="btn-logout">📱 作業画面</a>
      <a href="/" class="btn-logout">ダッシュボード</a>
    </div>
  </header>

  <div class="iw-wrap">

    <div class="iw-box">
      <h2>🗂 Notion 連携 (カードの取得)</h2>
      <p class="hint">
        カードの一覧は Notion「在庫化作業管理」から取得したキャッシュを表示します (進捗の正本は当面 Notion)。
        作業画面を開くと3分おきに自動で最新化され、iPad の「🔄 いま更新」でも取り直せます。
      </p>
      <% if (!cache.configured) { %>
        <p class="msg err">⚠ Notion 連携が未設定です (NOTION_TOKEN / INBOUND_CHECK_NOTION_DB_ID)</p>
      <% } %>
      <table class="iw-list">
        <tr><th>キャッシュ枚数</th><td><%= cache.total %> 枚
          (<%= cache.byStatus.map(s => `${s.status}: ${s.c}`).join(' / ') || 'なし' %>)</td></tr>
        <tr><th>最終取得</th><td><%= cache.lastRefreshAt ? new Date(cache.lastRefreshAt).toLocaleString('ja-JP') : 'まだ取得していません' %></td></tr>
        <% if (cache.lastRefreshError) { %>
          <tr><th class="ng">直近のエラー</th><td class="ng"><%= cache.lastRefreshError %></td></tr>
        <% } %>
        <% if (cache.truncated) { %>
          <tr><th class="ng">⚠ 取得打ち切り</th><td class="ng">カードが多すぎて一部だけ取得しています (未完了1000枚/完了500枚が上限)</td></tr>
        <% } %>
      </table>
    </div>

    <% if (isAdmin) { %>
    <div class="iw-box">
      <h2>🚚 Notion → アプリ正本化 (移行ツール)</h2>
      <p class="hint">
        Notion のカードを <code>f_iroha_tasks</code> に取り込みます (要件定義 v1.1 §F)。
        <b>「調査 (dry-run)」は読むだけ</b>で DB を変えません。結果と CSV を確認してから「本取込」。何度取り込んでも同じカードは増えません (page ID で冪等)。
        施設名ステータスのカードは「作業中 + その施設」で仮置きし<b>要確認</b>になります。完了カードも終了として取り込みます (一覧には出ません)。
      </p>
      <% if (migration && !migration.error) { %>
      <table class="iw-kv" style="margin-bottom:10px">
        <tr><th>tasks の件数</th><td>
          <% const bs = migration.counts.byStatus || {}; %>
          合計 <%= migration.counts.total %>
          (未着手 <%= bs.not_started || 0 %> / 作業中 <%= bs.in_progress || 0 %> / 保留 <%= bs.on_hold || 0 %> / 棚入待ち <%= bs.ready_for_stocking || 0 %> / 終了 <%= bs.closed || 0 %>)
        </td></tr>
        <tr><th>要確認</th><td><%= migration.review %> 件 (取込時に状態を推定 / 取消の要確認)</td></tr>
        <tr><th>孤立 (task に紐づかない)</th><td>作業時間 <%= migration.orphans.sessions.length %> ページ / 写真 <%= migration.orphans.media.length %> ページ</td></tr>
        <tr><th>直近の調査</th><td><%= migration.lastPlanAt || '(未実行。サーバー再起動で消えます)' %></td></tr>
      </table>
      <% } else if (migration && migration.error) { %>
        <p class="msg err">状態を取得できません: <%= migration.error %></p>
      <% } %>
      <div class="row" style="margin-bottom:8px">
        <input type="text" id="migSince" placeholder="差分取込の起点 (省略=全件。例: 2026-09-03T08:00:00Z)" style="min-width:320px">
        <button onclick="migSurvey()">🔍 調査 (dry-run)</button>
        <a class="btn-sm" href="<%= base %>/admin/migration/plan.csv">📄 CSV</a>
        <span class="msg" id="migMsg"></span>
      </div>
      <div class="row" style="margin-bottom:8px">
        <input type="text" id="migConfirm" placeholder="本取込するには APPLY と入力" maxlength="10">
        <button onclick="migApply()">📥 本取込</button>
      </div>
      <pre id="migOut" style="white-space:pre-wrap;font-size:.82rem;background:#f6f7f9;border:1px solid #dde;border-radius:6px;padding:10px;max-height:420px;overflow:auto;display:none"></pre>
    </div>
    <% } %>

    <div class="iw-box">
      <h2>🧰 作業のやり方の選択肢 (資材セット・保管箱)</h2>
      <p class="hint">
        iPad の「作業のやり方」編集で<b>タップして選ぶ</b>候補です。作業仕様マスタ (Excel) にある値は自動で補充されます。
        初見のものは iPad からも職員PINで追加できます。画像 (http リンク) を付けると iPad の候補にサムネイルが出ます。
      </p>
      <% for (const kind of ['material', 'container']) { const label = kind === 'material' ? '資材セット' : '保管箱'; const list = (options && options[kind]) || []; %>
        <h3 style="margin:12px 0 6px"><%= label %> (有効 <%= list.filter(o => o.active).length %>)</h3>
        <% if (isAdmin) { %>
        <div class="row" style="margin-bottom:8px">
          <input type="text" id="opt-<%= kind %>" placeholder="<%= label %>を追加 (例: <%= kind === 'material' ? 'D-8' : '20Lコンテナ' %>)" maxlength="100">
          <button onclick="addOption('<%= kind %>')">追加</button>
          <span class="msg" id="optMsg-<%= kind %>"></span>
        </div>
        <% } %>
        <table class="iw-list">
          <tr><th>値</th><th>画像</th><th>状態</th><% if (isAdmin) { %><th></th><% } %></tr>
          <% for (const o of list) { %>
            <tr class="<%= o.active ? '' : 'inactive' %>">
              <td><%= o.code %></td>
              <td><% if (o.image_url) { %><a href="<%= o.image_url %>" target="_blank" rel="noopener">画像</a><% } else { %>-<% } %></td>
              <td><%= o.active ? '有効' : '無効' %></td>
              <% if (isAdmin) { %><td>
                <button class="btn-sm" onclick="setOptionImage(<%= o.id %>)">画像リンク</button>
                <button class="btn-sm" onclick="toggleOption(<%= o.id %>, <%= o.active ? 'false' : 'true' %>)"><%= o.active ? '無効にする' : '戻す' %></button>
              </td><% } %>
            </tr>
          <% } %>
          <% if (list.length === 0) { %><tr><td colspan="4">まだありません (作業仕様マスタを取り込むと自動で入ります)</td></tr><% } %>
        </table>
      <% } %>
    </div>

    <div class="iw-box">
      <h2>👤 作業者 (いろは名簿)</h2>
      <p class="hint">
        iPad の名前タップに出る名簿です。<b>スタッフマスタ (B-Faith) とは別</b>で、いろはの利用者・職員をここで管理します。
        「棚入完了」への変更は<b>職員</b>だけができます。名前はフルネームでなく現場の呼び名 (表示名) で登録してください。
      </p>
      <% if (isAdmin) { %>
      <div class="row" style="margin-bottom:10px">
        <input type="text" id="wName" placeholder="表示名 (例: たにがわ)" maxlength="30">
        <select id="wType"><option value="member">利用者</option><option value="staff">職員</option></select>
        <button onclick="addWorker()">追加</button>
        <span class="msg" id="wMsg"></span>
      </div>
      <% } %>
      <table class="iw-list">
        <tr><th>表示名</th><th>区分</th><th>PIN</th><th>状態</th><% if (isAdmin) { %><th></th><% } %></tr>
        <% for (const w of workers) { %>
          <tr class="<%= w.active ? '' : 'inactive' %>">
            <td><%= w.display_name %></td>
            <td><%= w.worker_type === 'staff' ? '職員' : '利用者' %></td>
            <td><% if (w.worker_type === 'staff') { %><%= w.pin_set ? '設定済み' : '未設定' %><% } else { %>-<% } %></td>
            <td><%= w.active ? '有効' : '無効' %></td>
            <% if (isAdmin) { %>
              <td>
                <% if (w.worker_type === 'staff') { %>
                  <button class="btn-sm" onclick="setPin(<%= w.id %>)"><%= w.pin_set ? 'PIN再設定' : 'PIN設定' %></button>
                <% } %>
                <button class="btn-sm" onclick="toggleWorker(<%= w.id %>, <%= w.active ? 'false' : 'true' %>)">
                <%= w.active ? '無効にする' : '戻す' %></button></td>
            <% } %>
          </tr>
        <% } %>
        <% if (workers.length === 0) { %><tr><td colspan="5">まだ登録されていません</td></tr><% } %>
      </table>
      <p class="hint" style="margin-top:8px">職員には <b>PIN (4〜8桁の数字)</b> を設定してください。iPad で「棚入完了」に変えるときの本人確認に使います
        (名前は誰でも選べるため、PINが無いと職員限定の操作ができません)。</p>
    </div>

    <% if (isAdmin) { %>
    <div class="iw-box">
      <h2>📱 iPad の登録</h2>
      <p class="hint">
        いろはの iPad で <code><%= base %>/enroll</code> を開き、ここで発行した6桁コードを入れると登録されます
        (10分間・1台1回。入荷受付チェックと同じ方式)。
      </p>
      <div class="row">
        <input type="text" id="ecLabel" placeholder="端末名 (例: いろはiPad 1号機)" maxlength="40">
        <button onclick="issueCode()">📱 iPad の登録コードを発行</button>
        <span class="msg" id="ecMsg"></span>
      </div>
      <div id="ecOut" style="display:none;margin-top:10px">
        <span class="code-big" id="ecCode"></span>
        <span class="msg" id="ecNote"></span>
      </div>
      <% if (enrollCodes.length > 0) { %>
        <p class="hint" style="margin-top:10px">発行済みで未使用のコード:
          <%= enrollCodes.map(c => `${c.label} (期限 ${new Date(c.expires_at).toLocaleTimeString('ja-JP')})`).join(' / ') %></p>
      <% } %>
      <table class="iw-list" style="margin-top:10px">
        <tr><th>端末</th><th>登録</th><th>最終利用</th><th></th></tr>
        <% for (const d of devices) { %>
          <tr class="<%= d.revoked_at ? 'revoked' : '' %>">
            <td><%= d.label %></td>
            <td><%= new Date(d.created_at).toLocaleDateString('ja-JP') %> (<%= d.created_by || '-' %>)</td>
            <td><%= d.last_seen_at ? new Date(d.last_seen_at).toLocaleString('ja-JP') : '-' %></td>
            <td><% if (!d.revoked_at) { %><button class="btn-sm" onclick="revokeDevice(<%= d.id %>)">解除</button><% } %></td>
          </tr>
        <% } %>
        <% if (devices.length === 0) { %><tr><td colspan="4">登録された端末はありません</td></tr><% } %>
      </table>
    </div>
    <% } %>

    <div class="iw-box">
      <h2>⏱ 作業時間セッション (直近50件)</h2>
      <p class="hint">開始/終了はサーバー時刻で記録します。<b>終了忘れは自動で確定しません</b> —
        6時間を超えて「作業中」のものは ⚠ が付くので、確認のうえ「取り消し」してください (行は消えず、集計から外れるだけ)。</p>
      <table class="iw-list">
        <tr><th>開始</th><th>カード</th><th>作業者</th><th>時間</th><th>終了</th><% if (isAdmin) { %><th></th><% } %></tr>
        <% for (const s of sessions) { %>
          <tr class="<%= s.voided_at ? 'revoked' : '' %>">
            <td style="white-space:nowrap"><%= new Date(s.started_at).toLocaleString('ja-JP') %></td>
            <td><%= s.title_snapshot || s.page_id %></td>
            <td><%= s.worker_name %></td>
            <td class="<%= s.warn_long ? 'ng' : '' %>"><%= s.warn_long ? '⚠ ' : '' %><%= Math.floor(s.elapsed_seconds / 60) %>分<%= s.ended_at ? '' : ' (作業中)' %></td>
            <td><%= s.voided_at ? '取り消し済み' : (s.end_reason === 'done' ? 'できあがり' : s.end_reason === 'pause' ? '中断' : s.end_reason === 'admin' ? '管理者' : '-') %></td>
            <% if (isAdmin) { %>
              <td><% if (!s.voided_at) { %><button class="btn-sm" onclick="voidSession(<%= s.id %>)">取り消し</button><% } %></td>
            <% } %>
          </tr>
        <% } %>
        <% if (sessions.length === 0) { %><tr><td colspan="6">まだ記録はありません</td></tr><% } %>
      </table>
    </div>

    <div class="iw-box">
      <h2>📷 完成写真・動画の送信 (直近50件)</h2>
      <p class="hint">
        iPad から受け取った写真・動画は、裏のキューが Drive へ保存し、Notion カードの「完成写真」に貼ります
        (2分間隔で自動再試行)。<%= driveConfigured ? '' : '⚠ IROHA_WORK_DRIVE_FOLDER_ID が未設定のため保存できません。' %>
        10回失敗すると止まるので「再実行」で再開してください。
      </p>
      <table class="iw-list">
        <tr><th>受信</th><th>カード</th><th>種類</th><th>状態</th><th>撮影者</th><% if (isAdmin) { %><th></th><% } %></tr>
        <% for (const m of media) { %>
          <tr class="<%= m.deleted_at ? 'revoked' : '' %>">
            <td style="white-space:nowrap"><%= new Date(m.created_at).toLocaleString('ja-JP') %></td>
            <td><%= m.product_code || m.page_id %></td>
            <td><%= m.kind === 'photo' ? '📷写真' : '🎥動画' %> (<%= Math.round((m.size || 0) / 1024) %>KB)</td>
            <td>
              <% if (m.deleted_at) { %>削除済み
              <% } else if (m.status === 'synced') { %>✅ Notionまで反映
              <% } else if (m.status === 'uploaded') { %>☁ Drive保存済み (Notion待ち)
              <% } else { %>⏳ 送信待ち<% } %>
              <% if (m.error) { %><div class="ng"><%= m.error %></div><% } %>
              <% if (m.drive_url) { %><a href="<%= m.drive_url %>" target="_blank" rel="noopener">開く</a><% } %>
            </td>
            <td><%= m.worker_name || '-' %></td>
            <% if (isAdmin) { %>
              <td><% if (!m.deleted_at && m.error) { %><button class="btn-sm" onclick="retryMedia(<%= m.id %>)">再実行</button><% } %></td>
            <% } %>
          </tr>
        <% } %>
        <% if (media.length === 0) { %><tr><td colspan="6">まだありません</td></tr><% } %>
      </table>
      <% if (pageSync.length > 0) { %>
        <p class="hint" style="margin-top:10px"><b>Notion貼り直し待ち:</b>
          <% for (const s of pageSync) { %>
            <span><%= s.page_id.slice(0, 8) %>… (<%= s.attempt_count %>回<%= s.error ? ` / ${s.error}` : '' %>)
              <% if (isAdmin && s.error) { %><button class="btn-sm" onclick="retrySync('<%= s.page_id %>')">再実行</button><% } %></span>
          <% } %>
        </p>
      <% } %>
    </div>

    <div class="iw-box">
      <h2>📋 操作履歴 (直近50件)</h2>
      <p class="hint">iPad からのステータス変更などを、成功・失敗とも記録しています (だれが・どの端末で・何を)。</p>
      <table class="iw-list">
        <tr><th>日時</th><th>操作</th><th>内容</th><th>作業者</th><th>端末</th><th>結果</th></tr>
        <% for (const e of events) { %>
          <tr>
            <td style="white-space:nowrap"><%= new Date(e.at).toLocaleString('ja-JP') %></td>
            <td><%= e.action === 'status_change' ? 'ステータス変更' : e.action %></td>
            <td><%= (e.from_value || '?') %> → <%= (e.to_value || '?') %></td>
            <td><%= e.worker_name || '-' %></td>
            <td><%= e.device_label || '-' %></td>
            <td><%= e.ok ? '✅' : '' %><span class="ng"><%= e.ok ? '' : ('❌ ' + (e.error || '')) %></span></td>
          </tr>
        <% } %>
        <% if (events.length === 0) { %><tr><td colspan="6">まだ操作はありません</td></tr><% } %>
      </table>
    </div>

  </div>

  <script>
    const BASE = '<%= base %>';
    async function post(path, body) {
      const r = await fetch(BASE + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
      return { status: r.status, json: await r.json().catch(() => ({})) };
    }
    function setMsg(id, kind, text) { const el = document.getElementById(id); el.className = 'msg ' + kind; el.textContent = text; }

    function migShow(obj) { const el = document.getElementById('migOut'); el.style.display = 'block'; el.textContent = typeof obj === 'string' ? obj : JSON.stringify(obj, null, 1); }
    async function migSurvey() {
      const since = document.getElementById('migSince').value.trim();
      setMsg('migMsg', '', '調査中… (Notion を全件読みます。数十秒かかることがあります)');
      const { status, json } = await post('/admin/migration/survey', { since: since || null });
      if (!json.ok) { setMsg('migMsg', 'err', json.message || ('調査に失敗 (' + status + ')')); migShow(json); return; }
      setMsg('migMsg', json.truncated ? 'err' : 'ok', (json.truncated ? '⚠ 取得が打ち切られました (上限超え) ' : '') + json.count + ' 枚を調査しました (DB は変えていません)');
      migShow({ 取得: json.at, 差分起点: json.since, 枚数: json.count, ステータス別: json.byStatus, 写像の内訳: json.summary.byMapped,
        取込予定: json.summary.willImport, 取り込まない: json.summary.rejected, 要確認: json.summary.needsReview, 警告: json.summary.warnings,
        データの問題: json.issues, 孤立: json.orphans, 照合: { 欠け: json.reconcile.missing.length, 余り: json.reconcile.extra.length, tasks: json.reconcile.tasksByStatus },
        要確認と取り込まない行: json.review, 保存ファイル: json.file });
    }
    async function migApply() {
      const confirm = document.getElementById('migConfirm').value.trim();
      if (confirm !== 'APPLY') { setMsg('migMsg', 'err', '本取込するには APPLY と入力してください'); return; }
      if (!window.confirm('直近の調査結果を f_iroha_tasks に取り込みます。よろしいですか?')) return;
      setMsg('migMsg', '', '取込中…');
      const { status, json } = await post('/admin/migration/apply', { confirm });
      if (!json.ok) { setMsg('migMsg', 'err', json.message || ('取込に失敗 (' + status + ')')); migShow(json); return; }
      setMsg('migMsg', 'ok', '取り込みました: 追加 ' + json.inserted + ' / 更新 ' + json.updated + ' / 変化なし ' + json.kept + ' / 飛ばした ' + json.skipped);
      migShow(json);
      document.getElementById('migConfirm').value = '';
    }
    async function addOption(kind) {
      const code = document.getElementById('opt-' + kind).value.trim();
      if (!code) { setMsg('optMsg-' + kind, 'err', '値を入れてください'); return; }
      const { json } = await post('/admin/options', { kind, code });
      if (json.ok) location.reload();
      else setMsg('optMsg-' + kind, 'err', json.message || '追加できませんでした');
    }
    async function toggleOption(id, active) {
      const { json } = await post('/admin/options/' + id + '/active', { active });
      if (json.ok) location.reload();
      else alert(json.message || '変更できませんでした');
    }
    async function setOptionImage(id) {
      const url = prompt('画像のリンク (https://…)。空にすると外します');
      if (url == null) return;
      const { json } = await post('/admin/options/' + id + '/image', { image_url: url.trim() });
      if (json.ok) location.reload();
      else alert(json.message || '設定できませんでした');
    }
    async function addWorker() {
      const name = document.getElementById('wName').value.trim();
      const type = document.getElementById('wType').value;
      if (!name) { setMsg('wMsg', 'err', '表示名を入れてください'); return; }
      const { json } = await post('/admin/workers', { display_name: name, worker_type: type });
      if (json.ok) location.reload();
      else setMsg('wMsg', 'err', json.message || '追加できませんでした');
    }
    async function toggleWorker(id, active) {
      const { json } = await post('/admin/workers/' + id + '/active', { active });
      if (json.ok) location.reload();
      else alert(json.message || '変更できませんでした');
    }
    async function setPin(id) {
      const pin = prompt('この職員のPIN (4〜8桁の数字) を入力してください');
      if (pin == null) return;
      const { json } = await post('/admin/workers/' + id + '/pin', { pin: pin.trim() });
      if (json.ok) { alert('PINを設定しました'); location.reload(); }
      else alert(json.message || '設定できませんでした');
    }
    async function issueCode() {
      const label = document.getElementById('ecLabel').value.trim();
      if (!label) { setMsg('ecMsg', 'err', '端末名を入れてください'); return; }
      const { json } = await post('/admin/enroll-codes', { label });
      if (!json.ok) { setMsg('ecMsg', 'err', json.message || '発行できませんでした'); return; }
      setMsg('ecMsg', 'ok', '');
      document.getElementById('ecOut').style.display = 'block';
      document.getElementById('ecCode').textContent = json.code;
      document.getElementById('ecNote').textContent = '「' + json.label + '」用 ・ ' + json.ttlMinutes + '分間有効 ・ 1回だけ使えます';
    }
    async function retryMedia(id) {
      const { json } = await post('/admin/media/' + id + '/retry');
      if (json.ok) location.reload();
      else alert(json.message || '再実行できませんでした');
    }
    async function retrySync(pageId) {
      const { json } = await post('/admin/media-sync/retry', { page_id: pageId });
      if (json.ok) location.reload();
      else alert(json.message || '再実行できませんでした');
    }
    async function voidSession(id) {
      const reason = prompt('取り消しの理由 (例: 終了ボタンの押し忘れ)');
      if (reason == null) return;
      const { json } = await post('/admin/sessions/' + id + '/void', { reason });
      if (json.ok) location.reload();
      else alert(json.message || '取り消しできませんでした');
    }
    async function revokeDevice(id) {
      if (!confirm('この端末の登録を解除しますか? (その iPad は使えなくなります)')) return;
      const { json } = await post('/admin/devices/' + id + '/revoke');
      if (json.ok) location.reload();
      else alert(json.message || '解除できませんでした');
    }
  </script>
</body>
</html>
