<%- include('../../product-hub/views/_header') %>
<style>
  /* ★共通ヘッダは「商品登録ハブ」用のナビを持っている。この画面では別アプリの導線でしかなく、
     押すと迷子になるので丸ごと隠して、下の自前のバーだけを見せる */
  body > .topbar:first-of-type { display: none; }

  .wrap { max-width: 1280px; }
  .pu-note { font-size: 12px; color: #64748b; }
  .dim { color: #94a3b8; }
  .code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 12px; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }

  /* ── 見出し・手順 ───────────────────────────── */
  .card h2 { display: flex; align-items: center; gap: 9px; font-size: 15px; }
  .step { display: inline-flex; align-items: center; justify-content: center;
          width: 22px; height: 22px; border-radius: 50%; background: #1e293b; color: #fff;
          font-size: 12px; font-weight: 700; flex: 0 0 auto; }
  .h2-sub { font-size: 12px; font-weight: 400; color: #64748b; }
  .h2-right { margin-left: auto; font-size: 12px; font-weight: 400; }

  /* ── 冒頭のひとこと ─────────────────────────── */
  .lede { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px;
          padding: 11px 14px; font-size: 13px; margin-bottom: 16px; }
  .lede b { color: #1d4ed8; }
  .lede details { margin-top: 7px; }
  .lede summary { cursor: pointer; font-size: 12px; color: #1d4ed8; }
  .lede .howto { margin: 8px 0 0; padding-left: 18px; font-size: 12px; color: #334155; line-height: 1.8; }

  /* ── 1. コード入力 ──────────────────────────── */
  .pu-input { display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap; }
  .pu-input textarea { min-height: 72px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }

  /* ── 2. 新原価 ─────────────────────────────── */
  .cost-row { display: grid; grid-template-columns: 170px minmax(0, 1fr) 110px 120px; gap: 10px;
              align-items: center; padding: 5px 0; border-bottom: 1px solid #f1f5f9; }
  .cost-row:last-child { border-bottom: 0; }
  .cost-row .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  input.cost-in { width: 120px; text-align: right; flex: 0 0 auto; }

  /* ── 3. 表 ────────────────────────────────── */
  table.pu { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.pu th { text-align: left; color: #64748b; font-size: 11px; font-weight: 600;
                border-bottom: 2px solid #e2e8f0; padding: 7px 10px; white-space: nowrap; }
  table.pu th.num { text-align: right; }
  table.pu td { border-bottom: 1px solid #f1f5f9; padding: 9px 10px; vertical-align: middle; }
  table.pu td.nw, table.pu th.nw { white-space: nowrap; }
  /* 理由の文章は幅を決めておく。決めないと判定の列だけ伸びて、価格の列が潰れる */
  td .bad, td .pu-warn { max-width: 280px; }
  /* 詳しく表示のときは列が増える。潰し合うより少し詰めて、それでも足りなければ横スクロール */
  body.show-detail table.pu { min-width: 1180px; }
  body.show-detail table.pu td, body.show-detail table.pu th { padding-left: 7px; padding-right: 7px; }
  table.pu tbody tr:hover td { background: #f8fafc; }
  /* 商品のまとまり。同じ商品のモール違いが続けて並ぶので、境目をはっきりさせる */
  tr.grp td { background: #f8fafc !important; border-top: 2px solid #e2e8f0; border-bottom: 0;
              padding: 9px 10px 6px; }
  .grp-name { font-weight: 700; font-size: 13px; }
  .grp-meta { font-size: 12px; color: #64748b; margin-left: 8px; }
  tr.blocked td:not(.keep) { opacity: .62; }
  /* ★セレクタは input.〜 にする: 共通ヘッダの `input[type=number] { width:100% }` は
     属性セレクタぶん詳細度が高く、`.price-in` だけだと負けて全幅になり、
     商品名の列が1文字幅まで潰れる (2026-08-30 の画面崩れ) */
  input.price-in { width: 100px; text-align: right; font-size: 14px; font-weight: 600; }
  .cur { font-size: 14px; }

  /* 詳しい列は既定で隠す。「一度に全部見せる」と、どこを見ればよいか分からなくなるため */
  .col-detail { display: none; }
  body.show-detail .col-detail { display: table-cell; }
  /* セルの中の補足行 (取得元など)。列と同じトグルで出し入れする */
  .detail-line { display: none; }
  body.show-detail .detail-line { display: block; }
  .tgl { display: inline-flex; align-items: center; gap: 6px; color: #475569; cursor: pointer; }
  .tgl input { width: auto; }

  /* ── しるし ───────────────────────────────── */
  .chip { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px;
          font-weight: 600; white-space: nowrap; }
  .c-go { background: #dcfce7; color: #166534; }
  .c-caution { background: #fef3c7; color: #92400e; }
  .c-stop { background: #fee2e2; color: #b91c1c; }
  .c-confirmed { background: #dcfce7; color: #166534; }
  .c-rule { background: #fef3c7; color: #92400e; }
  .c-sales { background: #e0f2fe; color: #0369a1; }
  .c-unresolved { background: #fee2e2; color: #b91c1c; }
  .c-set { background: #fef3c7; color: #92400e; }
  .c-kind-recovery { background: #ede9fe; color: #5b21b6; }
  .c-kind-normal { background: #f1f5f9; color: #475569; }
  .tag { display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 4px;
         background: #f1f5f9; color: #64748b; }
  .tag-warn { background: #fff7ed; color: #9a3412; }
  .mall { font-weight: 700; font-size: 12px; white-space: nowrap; }
  .m-rakuten { color: #bf0000; } .m-yahoo { color: #ff0033; } .m-amazon { color: #b45309; }
  .m-aupay { color: #eb5505; } .m-qoo10 { color: #e4002b; }
  .up { color: #b91c1c; font-weight: 700; }     /* 値上げ (株価と同じ向き) */
  .down { color: #1d4ed8; font-weight: 700; }   /* 値下げ */
  .bad { color: #b91c1c; font-size: 11px; line-height: 1.5; }
  .ok { color: #166534; font-size: 11px; }
  /* 色が全部つられて変わる、のような「操作の効き方が見た目と違う」注意書き */
  .pu-warn { font-size: 11px; color: #9a3412; background: #fff7ed; border: 1px solid #fed7aa;
             border-radius: 4px; padding: 3px 6px; margin-top: 4px; line-height: 1.45; }

  /* ── 記録ボタンの帯 ─────────────────────────── */
  .sticky-actions { position: sticky; bottom: 0; background: #fff; border-top: 1px solid #e2e8f0;
                    padding: 11px 0 2px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .sum { font-size: 13px; color: #334155; }
  .sum b { font-variant-numeric: tabular-nums; }
  .sum .s-stop { color: #b91c1c; }
  .hidden { display: none; }
</style>
<div class="topbar">
  <a href="/">← ポータル</a>
  <span class="app-title">💴 価格一括改定</span>
  <span class="spacer"></span>
  <span class="user"><%= displayName %></span>
</div>
<div class="wrap">
  <div class="lede">
    <b>この画面では価格は変わりません。</b>
    いまの価格と粗利を見て、新しい売価を「記録」するところまでです。実際にモールへ送るのは、記録した履歴を開いてから。
    <details>
      <summary>使い方 (3ステップ) と、気をつけること</summary>
      <ol class="howto">
        <li><b>NE商品コードを入れて「出品を検索」</b> — 楽天・Yahoo・au PAY・Qoo10 の出品と、いまの価格を集めます (数十秒)。</li>
        <li><b>新しい売価を入れる</b> — 原価が変わったなら先に「新原価」を入れて計算し直します。粗利はその場で出ます。</li>
        <li><b>「この内容を記録する」</b> — 履歴ができます。送信はその履歴の画面から、確認欄に入力してはじめて実行されます。</li>
      </ol>
      <ul class="howto">
        <li>Amazon はこのツールから更新しません (別ツールがあるため)。チェックリストとしてだけ記録します。</li>
        <li>0円・小数・−30%超の値下げ・原価割れなどは、そもそも記録しても送れません (⛔ が付きます)。</li>
        <li>送ったあとに元へ戻したいときは、履歴の画面の「元の価格に戻す」から。</li>
      </ul>
    </details>
  </div>

  <div class="card">
    <h2><span class="step">1</span>NE商品コードを入れる</h2>
    <div class="pu-input">
      <div style="flex:1; min-width:320px;">
        <textarea id="codes" placeholder="abc-001&#10;abc-002&#10;(改行・カンマ・空白区切り。最大 <%= limits.maxNeCodes %> コード)"></textarea>
        <div class="pu-note">入れた単品と、それを含むセット商品もまとめて探します (セット行は初期状態では未選択)。</div>
      </div>
      <button class="btn btn-primary" id="resolve-btn" type="button">出品を検索</button>
    </div>
    <div id="resolve-msg" class="pu-note" style="margin-top:8px;"></div>
  </div>

  <div class="card hidden" id="cost-card">
    <h2><span class="step">2</span>新しい原価 (税抜)<span class="h2-sub">値上げ連絡があった分だけ・空欄なら今の原価のまま</span></h2>
    <div id="cost-list"></div>
    <button class="btn btn-sm" id="recost-btn" type="button" style="margin-top:10px;">新原価で計算し直す</button>
    <span class="pu-note" style="margin-left:8px;">セットの原価は構成から自動で計算し直します。</span>
  </div>

  <div class="card hidden" id="rows-card">
    <h2><span class="step">3</span>新しい売価を入れる
      <span class="h2-right"><label class="tgl"><input type="checkbox" id="detail-tgl">詳しく表示 (出品コード・引き当て・原価・送料)</label></span>
    </h2>
    <div style="overflow-x:auto;">
      <table class="pu" id="rows-table">
        <thead>
          <tr>
            <th style="width:30px;"><input type="checkbox" id="sel-all" title="すべて選ぶ / 外す"></th>
            <th>モール</th>
            <th class="col-detail">出品コード / SKU</th>
            <th class="col-detail">引き当て</th>
            <th class="num">いまの価格</th>
            <th class="num">新しい売価</th>
            <th class="num">変更</th>
            <th class="num">概算粗利</th>
            <th class="col-detail">原価・送料</th>
            <th>判定</th>
            <th></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="sticky-actions">
      <span class="sum" id="sum"></span>
      <input type="text" id="run-note" placeholder="メモ (値上げ連絡の出所など)" style="max-width:320px;">
      <button class="btn btn-primary" id="save-btn" type="button">この内容を記録する</button>
      <span class="pu-note" id="save-msg"></span>
    </div>
  </div>

  <div class="card hidden" id="manual-card">
    <h2><span class="step">4</span>Amazon は手で直す<span class="h2-sub">記録すると履歴画面でチェックを付けられます</span></h2>
    <div style="overflow-x:auto;">
      <table class="pu" id="manual-table">
        <thead><tr><th>モール</th><th>商品</th><th>出品コード</th><th class="num">参考価格</th><th>メモ</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>これまでの記録</h2>
    <% if (runs.length === 0) { %>
      <div class="pu-note">まだ記録はありません。</div>
    <% } else { %>
      <table class="pu">
        <thead><tr><th>日時 (JST)</th><th>種別</th><th class="num">行数</th><th>メモ</th><th>実行者</th><th></th></tr></thead>
        <tbody>
          <% runs.forEach(function (r) { %>
            <tr>
              <td class="code"><%= toJst(r.created_at) %></td>
              <td><span class="chip c-kind-<%= r.kind === 'recovery' ? 'recovery' : 'normal' %>"><%= r.kind === 'recovery' ? '↩︎ 復旧' : '通常' %></span></td>
              <td class="num"><%= r.op_count %></td>
              <td><%= r.note || '' %></td>
              <td class="pu-note"><%= r.created_by %></td>
              <td><a href="/apps/price-update/runs/<%= r.run_id %>">開く →</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script>
  const MALL_LABEL = { rakuten: '楽天', yahoo: 'Yahoo', amazon: 'Amazon', aupay: 'au PAY', qoo10: 'Qoo10' };
  const CONF_LABEL = { confirmed: '確定', rule: '規則推定', sales: '実績のみ', unresolved: '未解決' };
  // ★href に入れてよいのは http(s) だけ (javascript: を踏ませない)
  const safeUrl = (u) => {
    const v = String(u == null ? '' : u).trim();
    const lower = v.toLowerCase();
    return (lower.indexOf('https://') === 0 || lower.indexOf('http://') === 0) ? v : null;
  };
  let previewId = null;
  let rows = [];
  let inputCodes = [];

  const $ = (id) => document.getElementById(id);
  const yen = (v) => (v == null ? '—' : Number(v).toLocaleString());
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  async function api(path, body) {
    const res = await fetch(path, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const json = await res.json().catch(() => null);
    if (!res.ok || !json || json.ok === false) throw new Error(json && json.error ? json.error : ('HTTP ' + res.status));
    return json;
  }

  function costOverridesFromForm() {
    const out = {};
    document.querySelectorAll('.cost-in').forEach((el) => {
      const v = el.value.trim();
      if (v !== '') out[el.dataset.code] = Number(v);
    });
    return out;
  }

  async function doResolve() {
    const codes = $('codes').value;
    $('resolve-msg').textContent = '検索中… (モールAPIに問い合わせるので数十秒かかることがあります)';
    $('resolve-btn').disabled = true;
    try {
      const r = await api('/apps/price-update/api/resolve', { codes, costOverrides: costOverridesFromForm() });
      previewId = r.previewId;
      rows = r.rows;
      inputCodes = codes.split(/[\s,、\r\n\t]+/).map((s) => s.trim()).filter(Boolean);
      const msgs = [];
      if (r.unknownCodes.length) msgs.push('商品マスタに無いコード: ' + r.unknownCodes.join(', '));
      if (r.notices.length) msgs.push(r.notices.join(' / '));
      msgs.push('プレビュー有効期限 ' + new Date(r.expiresAt).toLocaleTimeString());
      $('resolve-msg').textContent = msgs.join(' — ');
      renderCosts();
      render();
    } catch (e) {
      $('resolve-msg').textContent = 'エラー: ' + e.message;
    } finally {
      $('resolve-btn').disabled = false;
    }
  }

  function renderCosts() {
    const codes = [...new Set(rows.filter((r) => r.rowKind === 'single').map((r) => r.neCode))];
    if (codes.length === 0) { $('cost-card').classList.add('hidden'); return; }
    $('cost-card').classList.remove('hidden');
    $('cost-list').innerHTML = codes.map((c) => {
      const row = rows.find((r) => r.neCode === c);
      return '<div class="cost-row">'
        + '<span class="code">' + esc(c) + '</span>'
        + '<span class="nm" title="' + esc(row.productName || '') + '">' + esc(row.productName || '') + '</span>'
        + '<span class="pu-note num">現 ' + yen(row.cost) + ' 円</span>'
        + '<input type="number" class="cost-in" data-code="' + esc(c) + '" min="0" step="1" placeholder="新原価">'
        + '</div>';
    }).join('');
  }

  // 発送まわり: モール側の設定 (これが売価差の理由になる) と、NE側の配送方法 (概算粗利の送料の根拠)。
  // 既定では隠す列に入れている — 毎回読む値ではないが、粗利が合わない時にここを見る
  function shippingLines(r) {
    const parts = [];
    const s = r.mallShipping;
    if (r.mall === 'rakuten' && s) {
      const bits = [];
      if (s.methodGroup != null) bits.push(esc(s.methodLabel || s.methodGroup));
      if (s.postageIncluded === true) bits.push('送料込み');
      if (s.postageIncluded === false) bits.push('送料別');
      if (s.singleItemShipping === 1) bits.push('単品配送');
      if (bits.length) parts.push('<div class="pu-note">モール設定: ' + bits.join(' / ') + '</div>');
    } else if (r.mall === 'yahoo' && s) {
      // 送料設定 (PostageSet) が商品ごとに変わる = 実質の配送方法。Delivery は今のところ全商品 "1"
      const bits = [];
      if (s.postageSet) bits.push('送料設定 ' + esc(s.postageLabel || s.postageSet));
      if (s.delivery) bits.push('配送 ' + esc(s.delivery));
      if (s.shipWeight) bits.push(esc(s.shipWeight) + 'g');
      if (bits.length) parts.push('<div class="pu-note">モール設定: ' + bits.join(' / ') + '</div>');
    }
    // 粗利に使っている配送関係費。どこから引いた値かを必ず添える
    if (r.shipping != null) {
      const src = r.shippingSource === 'mall'
        ? '<span class="ok">送料 ' + esc(r.shippingLabel || '') + ' ' + yen(r.shipping) + '円</span>'
        : (r.shippingSource === 'unknown'
          ? '<span class="bad">送料は不明 — 商品マスタの ' + yen(r.shipping) + '円で計算</span>'
          : '<span class="pu-note">送料 ' + esc(r.shippingLabel || r.neDeliveryMethod || '') + ' ' + yen(r.shipping) + '円</span>');
      parts.push('<div>' + src + '</div>');
    }
    if (r.neDeliveryMethod) {
      parts.push('<div class="pu-note">NE: ' + esc(r.neDeliveryMethod)
        + (r.productShipping != null ? ' ' + yen(r.productShipping) + '円' : '') + '</div>');
    }
    return parts.join('');
  }

  /** 変更幅。値上げ ▲ / 値下げ ▼ で、率と金額を1目盛りで読めるようにする */
  function deltaCell(r, ev) {
    if (!ev || ev.changeRatio == null) return '<span class="dim">—</span>';
    const pct = ev.changeRatio * 100;
    const up = pct >= 0;
    const diff = (r.newPrice != null && r.price != null) ? Math.round(Number(r.newPrice) - Number(r.price)) : null;
    return '<span class="' + (up ? 'up' : 'down') + '">' + (up ? '▲' : '▼') + ' '
      + (up ? '+' : '') + pct.toFixed(1) + '%</span>'
      + (diff != null ? '<div class="pu-note">' + (diff > 0 ? '+' : '') + yen(diff) + ' 円</div>' : '');
  }

  /** 概算粗利。★新売価が空の間は「今の価格での粗利」— どちらの値かを必ず添える */
  function grossCell(r, ev) {
    if (!ev || ev.estimate.gross == null) return '<span class="dim">—</span>';
    const body = '<div>' + yen(Math.round(ev.estimate.gross)) + ' 円</div>'
      + '<div class="pu-note">' + (ev.estimate.rate * 100).toFixed(1) + '%</div>';
    const pre = r.newPrice == null ? '<div class="tag">いまの価格で</div>' : '';
    // 送料が不明なままの粗利は当てにならない。隠す列ではなく、粗利のすぐ横で知らせる
    const post = r.shippingSource === 'unknown' ? '<div class="tag tag-warn">送料不明</div>' : '';
    return pre + body + post;
  }

  /** 判定。★止まった理由も注意書きも、どちらも消さずに出す (片方だけ出すと危ない) */
  function evalCell(r, ev) {
    const notes = [];
    // ★同じ文言が guard の warns にも入っていることがある (記録時に混ぜているため)。二度出さない
    if (r.sharedNote && !(ev && (ev.warns || []).includes(r.sharedNote))) {
      notes.push('<div class="pu-warn">' + esc(r.sharedNote) + '</div>');
    }
    if (!ev) return (notes.join('') || '<span class="dim">—</span>');
    const blocked = ev.blocks.length > 0;
    const chip = blocked ? '<span class="chip c-stop">⛔ 送れません</span>'
      : (ev.warns.length ? '<span class="chip c-caution">⚠️ 注意</span>'
        : '<span class="chip c-go">✅ 更新できます</span>');
    const detail = (ev.blocks.length ? '<div class="bad">' + ev.blocks.map(esc).join('<br>') + '</div>' : '')
      + (ev.warns.length ? '<div class="pu-warn">' + ev.warns.map(esc).join('<br>') + '</div>' : '');
    return chip + detail + notes.join('');
  }

  /** 同じ商品のモール違いを続けて並べる (横並びで比べられると、値付けのばらつきに気づける) */
  function groupRows(list) {
    const groups = [];
    const byCode = new Map();
    list.forEach((r) => {
      let g = byCode.get(r.neCode);
      if (!g) {
        g = { neCode: r.neCode, rowKind: r.rowKind, name: r.productName, via: r.viaCode,
              cost: r.cost, costSource: r.costSource, rows: [] };
        byCode.set(r.neCode, g);
        groups.push(g);
      }
      g.rows.push(r);
    });
    return groups;
  }

  function render() {
    const updatable = rows.filter((r) => !r.manual);
    const manual = rows.filter((r) => r.manual);
    $('rows-card').classList.toggle('hidden', updatable.length === 0);
    $('manual-card').classList.toggle('hidden', manual.length === 0);

    const html = groupRows(updatable).map((g) => {
      const head = '<tr class="grp"><td colspan="11">'
        + '<span class="grp-name">' + esc(g.name || '(名称なし)') + '</span>'
        + (g.rowKind === 'set' ? ' <span class="chip c-set">セット</span>' : '')
        + '<span class="grp-meta code">' + esc(g.neCode) + '</span>'
        + (g.via ? '<span class="grp-meta">← ' + esc(g.via) + ' から</span>' : '')
        + '<span class="grp-meta">原価 ' + yen(g.cost) + ' 円'
        + (g.costSource ? ' (' + esc(g.costSource) + ')' : '') + '</span>'
        + '</td></tr>';

      return head + g.rows.map((r) => {
        const ev = r.evaluation;
        return '<tr class="' + (ev && !ev.canUpdate ? 'blocked' : '') + '">'
          + '<td><input type="checkbox" class="sel" data-key="' + r.key + '" ' + (r.selected ? 'checked' : '') + '></td>'
          + '<td><span class="mall m-' + r.mall + '">' + esc(MALL_LABEL[r.mall] || r.mall) + '</span></td>'
          + '<td class="col-detail code">' + esc(r.listingCode || '')
          // Yahoo のカラバリは「当たった色」と「送り先の商品コード」が別。両方見せる
          + (r.matchedSubCode ? '<div class="pu-note">' + esc(r.matchedSubCode) + '</div>'
            : (r.skuCode ? '<div class="pu-note">SKU ' + esc(r.skuCode) + '</div>' : ''))
          + '</td>'
          + '<td class="col-detail"><span class="chip c-' + r.confidence + '">' + esc(CONF_LABEL[r.confidence]) + '</span>'
          + '<div class="pu-note">' + esc(r.resolveSource || '') + '</div></td>'
          + '<td class="num"><span class="cur">' + yen(r.price) + '</span>'
          + '<div class="pu-note detail-line">' + esc(r.priceSource || r.note || '取得できず') + '</div></td>'
          + '<td class="num keep"><input type="number" class="price-in" data-key="' + r.key + '" min="1" step="1" value="' + (r.newPrice == null ? '' : r.newPrice) + '"></td>'
          + '<td class="num nw">' + deltaCell(r, ev) + '</td>'
          + '<td class="num">' + grossCell(r, ev) + '</td>'
          + '<td class="col-detail">' + (shippingLines(r) || '<span class="dim">—</span>') + '</td>'
          + '<td class="keep">' + evalCell(r, ev) + '</td>'
          + '<td class="nw">' + (safeUrl(r.url) ? '<a href="' + esc(safeUrl(r.url)) + '" target="_blank" rel="noopener">開く</a>' : '') + '</td>'
          + '</tr>';
      }).join('');
    }).join('');
    $('rows-table').querySelector('tbody').innerHTML = html;

    // 「いま何行を送ることになるのか」を記録ボタンのすぐ横に出す
    const sel = updatable.filter((r) => r.selected);
    const go = sel.filter((r) => r.evaluation && r.evaluation.canUpdate && r.newPrice != null);
    const stop = sel.filter((r) => r.evaluation && !r.evaluation.canUpdate);
    const empty = sel.filter((r) => r.newPrice == null);
    $('sum').innerHTML = '選択 <b>' + sel.length + '</b> 行 / 送れる <b>' + go.length + '</b> 行'
      + (stop.length ? ' / <span class="s-stop">⛔ <b>' + stop.length + '</b> 行</span>' : '')
      + (empty.length ? ' / <span class="dim">売価が空 ' + empty.length + ' 行</span>' : '');

    $('manual-table').querySelector('tbody').innerHTML = manual.map((r) => (
      '<tr>'
      + '<td><span class="mall m-' + r.mall + '">' + esc(MALL_LABEL[r.mall] || r.mall) + '</span></td>'
      + '<td>' + esc(r.productName || '') + '<div class="pu-note code">' + esc(r.neCode) + '</div></td>'
      + '<td class="code">' + esc(r.listingCode || '') + '</td>'
      + '<td class="num">' + yen(r.price) + '<div class="pu-note">' + esc(r.priceSource || '') + '</div></td>'
      + '<td class="pu-note">' + esc(r.note || '') + '</td>'
      + '<td>' + (safeUrl(r.url) ? '<a href="' + esc(safeUrl(r.url)) + '" target="_blank" rel="noopener">開く</a>' : '') + '</td>'
      + '</tr>'
    )).join('');

    document.querySelectorAll('.price-in').forEach((el) => { el.onchange = onInputChange; });
    document.querySelectorAll('.sel').forEach((el) => { el.onchange = onInputChange; });
    syncSelAll();
    if (saving) setInputsDisabled(true);   // 記録中に応答が来て描き直しても入力は止めたまま
  }

  function syncSelAll() {
    const all = [...document.querySelectorAll('.sel')];
    const on = all.filter((el) => el.checked).length;
    $('sel-all').checked = all.length > 0 && on === all.length;
    $('sel-all').indeterminate = on > 0 && on < all.length;
  }

  // 入力のたびにサーバへ送らないよう少しまとめる。
  // ★送信は直列化する (応答が前後して古い入力でサーバ側スナップショットを上書きしないため)。
  // ★保存前には必ず flush し、失敗したら保存を中止する
  //   (待たない/握り潰すと、画面の入力とサーバ側スナップショット = 監査記録 がずれる)
  let timer = null;
  let chain = Promise.resolve();
  let enqueueSeq = 0;
  let saving = false;   // 記録中は再描画しても入力を止めたままにする

  /** 送信内容は「キューに入れた時点の画面」で固定する (実行時に読むと、その間の入力とずれる) */
  function snapshotPayload() {
    const payload = [];
    document.querySelectorAll('.price-in').forEach((el) => {
      const sel = document.querySelector('.sel[data-key="' + el.dataset.key + '"]');
      payload.push({ key: el.dataset.key, newPrice: el.value === '' ? null : el.value, selected: !!(sel && sel.checked) });
    });
    return payload;
  }

  function enqueuePreview() {
    const mySeq = ++enqueueSeq;
    const payload = snapshotPayload();
    const run = () => sendPreview(payload, mySeq);
    chain = chain.then(run, run);   // 前回が失敗していても最新入力を送り直す
    return chain;
  }
  function onInputChange() {
    syncSelAll();
    clearTimeout(timer);
    timer = setTimeout(function () { timer = null; enqueuePreview(); }, 250);
  }
  function setInputsDisabled(v) {
    document.querySelectorAll('.price-in, .sel, .cost-in, #sel-all').forEach((el) => { el.disabled = v; });
  }
  /**
   * 保存前: 入力を止めて、キューが完全に静止するまで待つ。失敗していれば例外を投げる。
   * ★ここでは入力を戻さない。記録API の応答を待つ間に入力されると、
   *   画面の最新値が記録されないまま保存が確定してしまう。戻すのは保存に失敗した時だけ (save 側)
   */
  async function flushPreview() {
    saving = true;
    setInputsDisabled(true);
    if (timer) { clearTimeout(timer); timer = null; enqueuePreview(); }
    let last;
    do { last = chain; await chain; } while (last !== chain);
  }

  async function sendPreview(payload, mySeq) {
    if (!previewId) return;
    try {
      const r = await api('/apps/price-update/api/preview', { previewId, rows: payload });
      // 自分より新しい入力が既にキューに入っているなら描き直さない
      // (古い応答で表を作り直すと、入力中の値が前の値へ巻き戻る)
      if (mySeq === enqueueSeq) {
        rows = r.rows;
        render();
        $('save-msg').textContent = '';
      }
    } catch (e) {
      // ★握り潰さない。失敗を飲み込むと「画面の入力が反映されていないのに記録できてしまう」
      $('save-msg').textContent = 'エラー: ' + e.message;
      throw e;
    }
  }

  async function save() {
    if (!previewId) return;
    $('save-btn').disabled = true;
    $('save-msg').textContent = '記録中…';
    try {
      await flushPreview();   // 直前の入力を確実にサーバへ反映してから記録する
      const r = await api('/apps/price-update/api/runs', { previewId, note: $('run-note').value });
      location.href = '/apps/price-update/runs/' + r.runId;
    } catch (e) {
      // 失敗した時だけ入力を戻す (成功時は画面遷移するまで止めたまま)
      saving = false;
      setInputsDisabled(false);
      $('save-msg').textContent = 'エラー: ' + e.message;
      $('save-btn').disabled = false;
    }
  }

  $('resolve-btn').onclick = doResolve;
  $('recost-btn').onclick = doResolve;
  $('save-btn').onclick = save;
  $('detail-tgl').onchange = function () { document.body.classList.toggle('show-detail', this.checked); };
  $('sel-all').onchange = function () {
    const on = this.checked;
    document.querySelectorAll('.sel').forEach((el) => { el.checked = on; });
    onInputChange();   // 選び直しもふつうの入力と同じ道を通す (サーバ側の記録とずれないように)
  };
</script>
