<%- include('../../product-hub/views/_header') %>
<style>
  /* ★共通ヘッダは「商品登録ハブ」用のナビを持っている。この画面では別アプリの導線でしかないので隠す */
  body > .topbar:first-of-type { display: none; }

  .wrap { max-width: 1280px; }
  .pu-note { font-size: 12px; color: #64748b; }
  .dim { color: #94a3b8; }
  .code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 12px; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }

  /* ── 見出しカード ───────────────────────────── */
  .run-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .run-id { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 17px; font-weight: 700; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px 18px; margin-top: 12px; }
  .meta dt { font-size: 11px; color: #64748b; }
  .meta dd { margin: 2px 0 0; font-size: 13px; word-break: break-all; }
  .tally { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .tally .chip b { font-variant-numeric: tabular-nums; }

  /* ── 表 ────────────────────────────────────── */
  table.pu { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.pu th { text-align: left; color: #64748b; font-size: 11px; font-weight: 600;
                border-bottom: 2px solid #e2e8f0; padding: 7px 10px; white-space: nowrap; }
  table.pu th.num { text-align: right; }
  table.pu td { border-bottom: 1px solid #f1f5f9; padding: 9px 10px; vertical-align: middle; }
  table.pu td.nw { white-space: nowrap; }
  td .bad, td .pu-warn { max-width: 300px; }
  body.show-detail table.pu { min-width: 1120px; }
  tr.grp td { background: #f8fafc; border-top: 2px solid #e2e8f0; border-bottom: 0; padding: 9px 10px 6px; }
  .grp-name { font-weight: 700; font-size: 13px; }
  .grp-meta { font-size: 12px; color: #64748b; margin-left: 8px; }
  .col-detail { display: none; }
  body.show-detail .col-detail { display: table-cell; }
  .tgl { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 400;
         color: #475569; cursor: pointer; margin-left: auto; }
  .tgl input { width: auto; }
  .card h2 { display: flex; align-items: center; gap: 9px; font-size: 15px; }
  .price-move { white-space: nowrap; }
  .price-move .from { color: #64748b; }
  .price-move .to { font-weight: 700; font-size: 14px; }
  .up { color: #b91c1c; font-weight: 700; }     /* 値上げ (株価と同じ向き) */
  .down { color: #1d4ed8; font-weight: 700; }   /* 値下げ */

  /* ── しるし ───────────────────────────────── */
  .chip { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px;
          font-weight: 600; white-space: nowrap; }
  .s-previewed { background: #e0f2fe; color: #0369a1; }
  .s-blocked_preview, .s-blocked { background: #fee2e2; color: #991b1b; }
  .s-manual_required { background: #fef3c7; color: #92400e; }
  .s-manual_done { background: #dcfce7; color: #166534; }
  .s-executing { background: #ede9fe; color: #5b21b6; }
  .s-confirmed { background: #dcfce7; color: #166534; }
  .s-noop { background: #f1f5f9; color: #475569; }
  .s-conflict { background: #fef3c7; color: #92400e; }
  .s-failed { background: #fee2e2; color: #991b1b; }
  .s-unknown { background: #fde68a; color: #7c2d12; }
  .s-skipped { background: #f1f5f9; color: #64748b; }
  .kind-recovery { background: #ede9fe; color: #5b21b6; }
  .mall { font-weight: 700; font-size: 12px; white-space: nowrap; }
  .m-rakuten { color: #bf0000; } .m-yahoo { color: #ff0033; } .m-amazon { color: #b45309; }
  .m-aupay { color: #eb5505; } .m-qoo10 { color: #e4002b; }
  .bad { color: #b91c1c; font-size: 11px; line-height: 1.5; }
  /* 「操作の効き方が見た目と違う」注意書き (例: Yahoo のカラバリは全色つられて変わる) */
  .pu-warn { font-size: 11px; color: #9a3412; background: #fff7ed; border: 1px solid #fed7aa;
             border-radius: 4px; padding: 3px 6px; margin-top: 4px; line-height: 1.45; }

  /* ── 実行・復旧 ────────────────────────────── */
  .exec-box { border: 2px solid #fecaca; background: #fff7f7; border-radius: 10px; padding: 14px 16px; }
  .exec-box h3 { margin: 0 0 8px; font-size: 15px; color: #991b1b; }
  .exec-gates { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
  .exec-gate { font-size: 12px; border-radius: 999px; padding: 3px 10px; border: 1px solid; }
  .exec-gate.ng { color: #64748b; border-color: #e2e8f0; background: #f8fafc; }
  .exec-gate.ok { color: #166534; border-color: #86efac; background: #f0fdf4; font-weight: 600; }
  .exec-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
  .exec-confirm { font-family: inherit; font-size: 13px; padding: 6px 10px; border: 1px solid #cbd5e1;
                  border-radius: 7px; width: 150px; }
  .btn-danger { background: #b91c1c; color: #fff; border-color: #b91c1c; }
  .btn-danger:disabled { opacity: .45; }
  .exec-result { margin-top: 10px; font-size: 13px; }
  .exec-result b { font-variant-numeric: tabular-nums; }
  .rec-box { border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 10px; padding: 14px 16px; }
  .rec-box h3 { margin: 0 0 8px; font-size: 15px; color: #334155; }
  .btn-rec { background: #fff; color: #b91c1c; border: 1px solid #fca5a5; }
  /* 監査用の記録。ふだんは畳んでおく */
  details.audit summary { cursor: pointer; font-size: 13px; font-weight: 600; }
  details.audit table { margin-top: 10px; }
</style>
<%
  // 復旧 run で戻せなかった行 (作成時に引き当て直せなかった行)。追記イベントから読む
  var notRestored = [];
  (run.events || []).forEach(function (e) {
    if (e.event !== 'recovery_incomplete' || !e.detail_json) return;
    try { notRestored = notRestored.concat(JSON.parse(e.detail_json).notRestored || []); } catch (err) { /* 壊れた記録は無視 */ }
  });
  var STATE_LABEL = {
    previewed: '記録のみ', blocked_preview: 'ガードで停止',
    manual_required: '手動更新まち', manual_done: '手動更新済み',
    executing: '送信中', confirmed: '更新済み (確認ずみ)', noop: '同じ価格だった',
    conflict: '価格が違うので送らず', failed: '失敗', unknown: '結果が不明',
    blocked: 'ガードで停止', skipped: '送っていない',
  };
  var CONF_LABEL = { confirmed: '確定', rule: '規則推定', sales: '実績のみ', unresolved: '未解決' };
  // ★モール名は画面のどこでも日本語で揃える (表だけ英語のままだと別物に見える)。
  //   正本は mall-capabilities.js。ここに写すとモールを足した時に直し忘れる
  //   (2026-09-07: LINEギフトの行が生の `linegift` のまま出ていた)
  var MALL_LABEL = mallLabels;
  // ★href に入れてよいのは http(s) だけ (javascript: を踏ませない)
  var safeUrl = function (u) {
    var v = String(u == null ? '' : u).trim();
    var lower = v.toLowerCase();
    return (lower.indexOf('https://') === 0 || lower.indexOf('http://') === 0) ? v : null;
  };
  // 状態の内訳 (この履歴がいまどうなっているのかを、行を数えなくても分かるように)
  var tally = [];
  var tallyIdx = {};
  (run.operations || []).forEach(function (o) {
    if (tallyIdx[o.state] == null) { tallyIdx[o.state] = tally.length; tally.push({ state: o.state, n: 0 }); }
    tally[tallyIdx[o.state]].n++;
  });
  // 商品ごとのまとまり (同じ商品のモール違いを続けて並べる)
  var groups = [];
  var groupIdx = {};
  (run.operations || []).forEach(function (o) {
    var k = JSON.stringify([o.ne_code, o.row_kind || '']);
    if (groupIdx[k] == null) {
      groupIdx[k] = groups.length;
      groups.push({ neCode: o.ne_code, rowKind: o.row_kind, name: o.product_name, ops: [] });
    }
    groups[groupIdx[k]].ops.push(o);
  });
%>
<div class="topbar">
  <a href="/apps/price-update">← 価格一括改定</a>
  <span class="app-title">💴 記録の詳細</span>
  <span class="spacer"></span>
  <span class="user"><%= displayName %></span>
</div>
<div class="wrap" data-run-id="<%= run.run_id %>">
  <div class="card">
    <div class="run-head">
      <span class="run-id"><%= run.run_id %></span>
      <% if (run.kind === 'recovery') { %>
        <span class="chip kind-recovery">↩︎ 復旧 run</span>
        <% if (run.source_run_id) { %>
          <span class="pu-note">元: <a href="/apps/price-update/runs/<%= run.source_run_id %>"><%= run.source_run_id %></a></span>
        <% } %>
      <% } %>
    </div>
    <dl class="meta">
      <div><dt>記録した日時 (JST)</dt><dd class="code"><%= toJst(run.created_at, { seconds: true }) %></dd></div>
      <div><dt>実行者</dt><dd><%= run.created_by %></dd></div>
      <div><dt>対象コード</dt><dd class="code"><%= run.neCodes.join(', ') %></dd></div>
      <div><dt>メモ</dt><dd><%= run.note || '—' %></dd></div>
    </dl>
    <div class="tally">
      <% tally.forEach(function (t) { %>
        <span class="chip s-<%= t.state %>"><%= STATE_LABEL[t.state] || t.state %> <b><%= t.n %></b></span>
      <% }); %>
    </div>
  </div>

  <% if (notRestored.length > 0) { %>
    <div class="card">
      <div class="exec-box">
        <h3>⚠️ 戻せなかった行が <%= notRestored.length %> 行あります</h3>
        <div class="pu-note">この復旧では下の行を戻せていません。モールの画面で実際の価格を確認してください。</div>
        <table class="pu" style="margin-top:8px;">
          <thead><tr><th>モール</th><th>NEコード</th><th>出品コード / SKU</th><th>理由</th></tr></thead>
          <tbody>
            <% notRestored.forEach(function (x) { %>
              <tr>
                <td><span class="mall m-<%= x.mall %>"><%= MALL_LABEL[x.mall] || x.mall %></span></td>
                <td class="code"><%= x.neCode %></td>
                <td class="code"><%= x.listingCode || '' %><% if (x.skuCode) { %> / <%= x.skuCode %><% } %></td>
                <td class="pu-note"><%= x.reason %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="card">
    <div class="exec-box" id="exec-box">
      <h3>モールの価格を実際に書き換えます</h3>
      <div id="exec-status" class="pu-note">確認中…</div>
      <div id="exec-gates" class="exec-gates"></div>
      <div id="exec-form" style="display:none;">
        <div id="exec-warn"></div>
        <div class="exec-row">
          <input class="exec-confirm" id="exec-confirm" placeholder="実行する" autocomplete="off"
               aria-label="確認欄: 実行する と入力してください">
          <button class="btn btn-danger" id="exec-btn" type="button" disabled>送る</button>
          <span class="pu-note" id="exec-count"></span>
        </div>
        <div class="pu-note" style="margin-top:8px;">
          押し間違いで走らないよう、確認欄に <b>実行する</b> と入力してからボタンを押してください。
          1件目は試運転です — 送ったあとに価格を取り直し、その通りになっているか確かめます。
          確かめられなかった時・想定していない応答が返った時は、そこで止めて残りは送りません。
        </div>
      </div>
      <div class="exec-result" id="exec-result"></div>
    </div>
  </div>

  <div class="card" id="rec-card" style="display:none;">
    <div class="rec-box">
      <h3>↩︎ 元の価格に戻す</h3>
      <div class="pu-note" id="rec-status"></div>
      <div id="rec-form" style="display:none; margin-top:10px;">
        <button class="btn btn-rec" id="rec-btn" type="button">戻すための履歴を作る</button>
        <div class="pu-note" style="margin-top:6px;">
          戻す先の価格は<b>この履歴の記録から取ります</b> — 打ち間違えようがありません。
          押すと「戻すための履歴」ができるだけで、まだ何も送りません。
        </div>
      </div>
      <div class="pu-note" id="rec-result" style="margin-top:8px;"></div>
    </div>
  </div>

  <div class="card">
    <h2>行 (<%= run.operations.length %>)
      <label class="tgl"><input type="checkbox" id="detail-tgl">詳しく表示 (出品コード・引き当て)</label>
    </h2>
    <div style="overflow-x:auto;">
      <table class="pu">
        <thead>
          <tr>
            <th>状態</th><th>モール</th>
            <th class="col-detail">出品コード / SKU</th>
            <th class="col-detail">引き当て</th>
            <th class="num">価格 (記録時 → 新売価)</th>
            <th class="num">変更</th>
            <th>判定</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% groups.forEach(function (g) { %>
            <tr class="grp"><td colspan="8">
              <span class="grp-name"><%= g.name || '(名称なし)' %></span>
              <% if (g.rowKind === 'set') { %><span class="chip s-manual_required">セット</span><% } %>
              <span class="grp-meta code"><%= g.neCode %></span>
            </td></tr>
            <% g.ops.forEach(function (o) { %>
              <% var guard = o.guard_json ? JSON.parse(o.guard_json) : null; %>
              <% var ratio = (o.expected_current_price && o.new_price)
                   ? ((o.new_price - o.expected_current_price) / o.expected_current_price) * 100 : null; %>
              <tr data-op="<%= o.operation_id %>">
                <td>
                  <span class="chip s-<%= o.state %>" data-state-cell><%= STATE_LABEL[o.state] || o.state %></span>
                </td>
                <td><span class="mall m-<%= o.mall %>"><%= MALL_LABEL[o.mall] || o.mall %></span></td>
                <td class="col-detail code"><%= o.listing_code || '' %><% if (o.sku_code) { %><div class="pu-note">SKU <%= o.sku_code %></div><% } %></td>
                <td class="col-detail"><%= CONF_LABEL[o.confidence] || o.confidence %><div class="pu-note"><%= o.price_source || '' %></div></td>
                <td class="num price-move">
                  <span class="from"><%= o.expected_current_price == null ? '—' : o.expected_current_price.toLocaleString() %></span>
                  <span class="dim">→</span>
                  <span class="to"><%= o.new_price == null ? '—' : o.new_price.toLocaleString() %></span>
                </td>
                <td class="num nw">
                  <% if (ratio == null) { %><span class="dim">—</span>
                  <% } else { %><span class="<%= ratio >= 0 ? 'up' : 'down' %>"><%= ratio >= 0 ? '▲ +' : '▼ ' %><%= ratio.toFixed(1) %>%</span><% } %>
                </td>
                <td>
                  <% if (guard && guard.blocks && guard.blocks.length) { %><div class="bad"><%= guard.blocks.join(' / ') %></div><% } %>
                  <%# ★注意書きはブロック理由があっても消さない。「1色のつもりが全色」は隠すと危ない %>
                  <% if (guard && guard.warns && guard.warns.length) { %><div class="pu-warn"><%= guard.warns.join(' / ') %></div><% } %>
                  <% if (!(guard && (((guard.blocks || []).length) || ((guard.warns || []).length)))) { %><span class="dim">—</span><% } %>
                </td>
                <td>
                  <% if (o.initial_state === 'manual_required') { %>
                    <button class="btn btn-sm manual-btn" data-op="<%= o.operation_id %>" data-done="<%= o.state === 'manual_done' ? '0' : '1' %>">
                      <%= o.state === 'manual_done' ? '取り消す' : '手動更新した' %>
                    </button>
                  <% } %>
                  <% var href = safeUrl(o.product_url); if (href) { %><a href="<%= href %>" target="_blank" rel="noopener">開く</a><% } %>
                </td>
              </tr>
            <% }); %>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="pu-note" id="manual-msg" style="margin-top:8px;"></div>
  </div>

  <div class="card">
    <details class="audit">
      <summary>イベント (追記のみ・<%= run.events.length %> 件)</summary>
      <table class="pu">
        <thead><tr><th>日時 (JST)</th><th>操作者</th><th>イベント</th><th>対象</th><th>詳細</th></tr></thead>
        <tbody>
          <% run.events.forEach(function (e) { %>
            <tr>
              <td class="code"><%= toJst(e.at, { seconds: true }) %></td>
              <td class="pu-note"><%= e.actor %></td>
              <td><%= STATE_LABEL[e.event] || e.event %></td>
              <td class="code"><%= e.operation_id || '(run)' %></td>
              <td class="pu-note code"><%= e.detail_json || '' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </details>
  </div>
</div>

<script>
  // ★run_id を script の中に直書きしない (終了タグ相当の文字列で JS を抜けられるため)。
  //   属性から読む — テンプレート側の出力タグが HTML として必ずエスケープしてくれる
  const RUN_ID = document.querySelector('[data-run-id]').dataset.runId;
  const API = location.pathname.replace(/\/runs\/.*$/, '/api/runs/') + encodeURIComponent(RUN_ID);
  const $ = (id) => document.getElementById(id);
  const n = (v) => (Number.isFinite(Number(v)) ? Number(v) : 0);   // API の値を数として扱う (文字列を HTML に流さない)
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  // ★日時は DB に UTC で入っている。サーバ側 (format.js) と同じ関数をここでも使い、
  //   画面の表示を JST に揃える (2つの実装がずれると run を取り違える)
  <%- toJstClientSrc %>

  $('detail-tgl').onchange = function () { document.body.classList.toggle('show-detail', this.checked); };

  document.querySelectorAll('.manual-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const done = btn.dataset.done === '1';
      btn.disabled = true;
      try {
        const res = await fetch(API + '/manual', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ operationId: btn.dataset.op, done: done }),
        });
        const json = await res.json();
        if (!res.ok || json.ok === false) throw new Error(json.error || ('HTTP ' + res.status));
        location.reload();
      } catch (e) {
        $('manual-msg').textContent = 'エラー: ' + e.message;
        btn.disabled = false;
      }
    });
  });

  // ── 実行 ─────────────────────────────────────────────
  const MALL_LABEL = <%- mallLabelsJson %>;   // 正本 = mall-capabilities.js (script 安全な形にして渡される)

  async function loadExecutable() {
    let info;
    try {
      const res = await fetch(API + '/executable', { headers: { Accept: 'application/json' } });
      info = await res.json();
      if (!res.ok || info.ok === false) throw new Error(info.error || ('HTTP ' + res.status));
    } catch (e) {
      $('exec-status').textContent = '実行できるか確認できませんでした: ' + e.message;
      return;
    }

    const gates = Object.entries(info.gates || {});
    $('exec-gates').innerHTML = gates.map(([mall, g]) =>
      '<span class="exec-gate ' + (g.enabled ? 'ok' : 'ng') + '" title="' + esc(g.enabled ? '' : g.reason) + '">'
      + (g.enabled ? '● ' : '○ ') + esc(MALL_LABEL[mall] || mall) + ' '
      + esc(g.enabled ? '送れます' : '止まっています') + '</span>').join('');

    if (info.claim) {
      // ★claim は「実行を始めた」印であって「終わった」印ではない。
      //   途中で止まった run もここに入るので、完了だと言い切らない
      // ★実行済みの履歴でも、行がどうなったかの内訳 (noTargetReason) を出す。
      //   claim で return してしまうと、結果不明・失敗の注意が誰にも見えない (Codex R2 高)
      $('exec-status').innerHTML = 'この履歴は <b>' + esc(toJst(info.claim.claimed_at, true))
        + '</b> に <b>' + esc(info.claim.claimed_by) + '</b> が実行を開始しています。'
        + '同じ内容をもう一度送ることはしません。'
        + '<b>まだ途中の場合もあります</b> — 上の内訳と下の行で1行ずつ状態を確認してください'
        + ' (「送信中」のまま残っている行は、モールの画面で実際の価格を確かめてください)。'
        + (info.noTargetReason ? '<div style="margin-top:6px;">' + esc(info.noTargetReason) + '</div>' : '');
      return;
    }
    if (!info.targets) {
      // ★理由まで出す。「送る行がありません」だけだと、送られたのか送られていないのかが分からない
      //   (2026-09-07: LINEギフト1行だけの履歴で、現場は価格を変えたつもりになっていた)
      $('exec-status').textContent = info.noTargetReason
        || '送る行がありません (記録時のガードを通った行だけが対象です)。';
      return;
    }
    if (!info.canExecute) {
      $('exec-status').textContent = info.canExecuteReason || '実行の権限がありません。';
      return;
    }

    $('exec-status').innerHTML = '送る対象は <b>' + n(info.targets) + ' 行</b>。'
      + '<b>送った価格は自動では戻せません</b> — 新売価が正しいか、下の表でもう一度確かめてください。';
    $('exec-count').textContent = '(' + n(info.targets) + ' 行)';
    // ★ボタンの文言はこの履歴で実際に送るモールから作る。
    //   「楽天へ送る」と決め打ちにしていたので、Yahoo の履歴でも楽天と書いてあった (中原さん 9/1)
    // ★送る前に「効き方が見た目と違う行」を必ず見せる。
    //   例: Yahoo のカラバリは1色ぶんのつもりでも、その商品の色が全部同じ価格になる
    const warns = info.warnings || [];
    $('exec-warn').innerHTML = warns.length === 0 ? '' :
      '<div class="pu-warn" style="margin:8px 0;"><b>送る前に確認してください (' + n(warns.length) + ' 行)</b>'
      + '<ul style="margin:4px 0 0 18px; padding:0;">'
      + warns.map((w) => '<li>' + esc(w.neCode || '')
        + (w.listingCode ? ' (' + esc(w.listingCode) + ')' : '') + ' — ' + esc(w.warn) + '</li>').join('')
      + '</ul></div>';

    const sendMalls = gates.filter(([, g]) => g.enabled).map(([m]) => MALL_LABEL[m] || m);
    $('exec-btn').textContent = (sendMalls.length > 0 ? sendMalls.join('・') + 'へ送る' : '送る');
    $('exec-form').style.display = '';

    const confirm = $('exec-confirm');
    const btn = $('exec-btn');
    const sync = () => { btn.disabled = confirm.value.trim() !== '実行する'; };
    confirm.addEventListener('input', sync);
    sync();

    btn.addEventListener('click', async function () {
      btn.disabled = true;
      confirm.disabled = true;
      $('exec-result').innerHTML = '<span class="pu-note">送信中… 画面を閉じても送信は止まりません。終わるまでお待ちください。</span>';
      try {
        const res = await fetch(API + '/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ confirm: confirm.value.trim() }),
        });
        const json = await res.json();
        if (!res.ok || json.ok === false) throw new Error(json.message || json.error || ('HTTP ' + res.status));
        showSummary(json.summary);
        setTimeout(() => location.reload(), 2500);
      } catch (e) {
        $('exec-result').innerHTML = '<span style="color:#991b1b;">エラー: ' + esc(e.message) + '</span>'
          + '<div class="pu-note">送ったかどうかが分からない場合は、この画面を再読み込みして行の状態を確認してください。'
          + '同じ履歴を二重に実行することはできません。</div>';
        confirm.disabled = false;
        confirm.value = '';
        btn.disabled = true;
      }
    });
  }

  function showSummary(s) {
    if (!s) { $('exec-result').textContent = '終わりました。'; return; }
    const parts = [
      ['更新済み', s.applied], ['同じ価格', s.noop], ['価格が違う', s.conflict],
      ['失敗', s.failed], ['結果が不明', s.unknown], ['送っていない', s.skipped],
    ].map(([k, v]) => esc(k) + ' <b>' + n(v) + '</b>').join(' / ');
    $('exec-result').innerHTML = parts
      + (s.stopped ? '<div style="color:#991b1b; margin-top:4px;">途中で止めました: ' + esc(s.stopped) + '</div>' : '')
      + (n(s.unknown) > 0 ? '<div style="color:#991b1b; margin-top:4px;">★結果が不明な行は自動では送り直しません。'
        + 'モールの画面で実際の価格を確認してください。</div>' : '')
      + '<div class="pu-note">画面を更新します…</div>';
  }

  loadExecutable();

  // ── 元の価格に戻す ─────────────────────────────────
  async function loadRecoverable() {
    let info;
    try {
      const res = await fetch(API + '/recoverable', { headers: { Accept: 'application/json' } });
      info = await res.json();
      if (!res.ok || info.ok === false) return;
    } catch { return; }

    const unexecuted = (info.existing || []).filter((r) => !r.executed);
    const notRestorable = info.notRestorable || [];
    // ★戻せる行が 0 でも「変わったのに戻せない行」があれば必ず出す。
    //   ここで隠すと、その行の存在自体が画面から消える (Codex R4)
    if (!n(info.rows) && notRestorable.length === 0 && unexecuted.length === 0) return;
    $('rec-card').style.display = '';

    const notRestorableHtml = notRestorable.length === 0 ? '' :
      '<div style="color:#991b1b; margin-top:6px;">※ <b>' + notRestorable.length
      + ' 行</b>は価格が変わったのに戻す先が分かりません。モールの画面で実際の価格を確認してください。<ul style="margin:4px 0 0 18px;">'
      + notRestorable.map((x) => '<li>' + esc(x.neCode)
        + (x.listingCode ? ' (' + esc(x.listingCode) + (x.skuCode ? ' / ' + esc(x.skuCode) : '') + ')' : '')
        + ' — ' + esc(x.reason) + '</li>').join('')
      + '</ul></div>';

    if (unexecuted.length > 0) {
      $('rec-status').innerHTML = '戻すための履歴は<b>もう作ってあります</b>: '
        + unexecuted.map((r) => '<a href="/apps/price-update/runs/' + encodeURIComponent(r.run_id) + '">' + esc(r.run_id) + '</a>').join(' / ')
        + '。そちらを開いて実行してください。'
        + notRestorableHtml;   // ★どの分岐でも「戻せない行」は消さない (Codex R5)
      return;
    }
    if (!n(info.rows)) {
      // 戻せる行は無いが、戻せない行はある (上の early return を抜けてきた)
      $('rec-status').innerHTML = '<b>送る前の価格に戻せる行はありません。</b>' + notRestorableHtml;
      return;
    }
    if (!info.canCreate) {
      // 権限が無くても「戻せない行」は見せる (知らせるべき事実であって、操作ではない)
      $('rec-status').innerHTML = esc(info.canCreateReason || '権限がありません。') + notRestorableHtml;
      return;
    }
    const done = (info.existing || []).filter((r) => r.executed);
    $('rec-status').innerHTML = 'この履歴で<b>価格が変わった行が ' + n(info.rows) + ' 行</b>あります。'
      + '送る前の価格に戻せます。' + notRestorableHtml;
    if (done.length > 0) {
      // 一度戻した履歴をもう一度戻す = いまの価格を当時の価格で上書きする。明示のチェックを求める
      $('rec-status').innerHTML += '<div style="color:#991b1b; margin-top:6px;">※ この履歴は既に一度戻しています ('
        + done.map((r) => esc(r.run_id)).join(', ') + ')。'
        + 'もう一度戻すと、<b>いまの価格を当時の価格で上書きします</b>。'
        + 'その後に別の理由で値付けし直していた場合、それも消えます。</div>'
        + '<label style="display:block; margin-top:6px;"><input type="checkbox" id="rec-repeat"> '
        + 'それでも、もう一度戻す</label>';
    }
    $('rec-form').style.display = '';

    $('rec-btn').addEventListener('click', async function () {
      $('rec-btn').disabled = true;
      $('rec-result').textContent = '作成中…';
      try {
        const repeat = $('rec-repeat');
        const res = await fetch(API + '/recovery', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ confirmRepeat: !!(repeat && repeat.checked) }),
        });
        const json = await res.json();
        if (!res.ok || json.ok === false) {
          if (json.runId) {
            $('rec-result').innerHTML = esc(json.message) + ' → <a href="/apps/price-update/runs/'
              + encodeURIComponent(json.runId) + '">開く</a>';
            return;
          }
          // ★1行も戻せなかった時も、どの行がなぜ戻せないのかを必ず見せる。
          //   「見つかりません」だけだと、モールの画面で何を確認すればよいか分からない
          if (json.error === 'recovery_no_target' && (json.notRestored || []).length > 0) {
            $('rec-result').innerHTML = '<span style="color:#991b1b;">' + esc(json.message) + '</span>'
              + '<ul style="margin:6px 0 0 18px;">'
              + json.notRestored.map((m) => '<li>' + esc(m.neCode || '')
                + (m.listingCode ? ' (' + esc(m.listingCode)
                  + (m.skuCode ? ' / ' + esc(m.skuCode) : '') + ')' : '')
                + ' — ' + esc(m.reason) + '</li>').join('')
              + '</ul>';
            $('rec-btn').disabled = false;
            return;
          }
          throw new Error(json.message || json.error || ('HTTP ' + res.status));
        }
        const missed = json.notRestored || [];
        const link = '/apps/price-update/runs/' + encodeURIComponent(json.runId);
        if (missed.length > 0) {
          // ★戻せなかった行があるまま黙って移動しない。何が戻らないのかをここで見せる
          $('rec-result').innerHTML = '作りました (' + n(json.rows) + ' 行)。'
            + '<span style="color:#991b1b;">ただし ' + missed.length + ' 行は戻せません:</span><ul style="margin:6px 0 0 18px;">'
            + missed.map((m) => '<li>' + esc(m.neCode) + ' — ' + esc(m.reason) + '</li>').join('')
            + '</ul><a href="' + link + '">作った履歴を開く</a>';
          return;
        }
        $('rec-result').innerHTML = '作りました (' + n(json.rows) + ' 行)。移動します…';
        location.href = link;
      } catch (e) {
        $('rec-result').innerHTML = '<span style="color:#991b1b;">エラー: ' + esc(e.message) + '</span>';
        $('rec-btn').disabled = false;
      }
    });
  }

  loadRecoverable();
</script>
