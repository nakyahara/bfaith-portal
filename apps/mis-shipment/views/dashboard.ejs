<%- include('_header', { nav: 'dashboard' }) %>

  <main class="mis-main mis-dashboard">
    <div class="mis-page-head">
      <div>
        <h2>📊 誤出荷ダッシュボード</h2>
        <div class="mis-sub">誤出荷件数率 = 件数 ÷ 同じ期間の出荷件数</div>
      </div>
      <a href="/apps/mis-shipment" class="mis-btn">← 一覧へ戻る</a>
    </div>

    <!-- 期間切替 -->
    <form id="period-form" class="mis-panel period-form">
      <div class="mis-field">
        <label class="mis-field-label" for="period-select">期間</label>
        <select name="period" id="period-select">
          <option value="month" selected>当月</option>
          <option value="week">今週 (月〜日)</option>
          <option value="custom">カスタム期間</option>
        </select>
      </div>
      <div class="mis-field custom-only" hidden>
        <label class="mis-field-label" for="period-from">開始日</label>
        <input type="date" name="from" id="period-from">
      </div>
      <div class="mis-field custom-only" hidden>
        <label class="mis-field-label" for="period-to">終了日</label>
        <input type="date" name="to" id="period-to">
      </div>
      <button type="submit" class="mis-btn">適用</button>
      <span id="period-label" class="period-label-text"></span>
    </form>

    <div id="dashboard-body">
      <p class="loading">読み込み中...</p>
    </div>
  </main>

  <!-- Chart.js (CDN、月次推移グラフ用) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js" defer></script>
  <script src="/apps/mis-shipment/public/dashboard.js" defer></script>
  <script defer>document.addEventListener('DOMContentLoaded', () => misShipmentDashboard.init());</script>
</body>
</html>
