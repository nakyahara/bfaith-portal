<% const sfx = sideId ? '_' + sideId : '' %>
<% const key = sideId || 'single' %>

<div class="form-row">
  <label class="label" for="mall_order_id<%= sfx %>">注文番号 または NE 伝票番号 <em>*</em></label>
  <div class="order-id-row">
    <input type="text" id="mall_order_id<%= sfx %>" name="mall_order_id<%= sfx %>" maxlength="100"
           class="order-id-input" data-side="<%= sideId %>"
           placeholder="503-1234567-1234567 / 1438443" autocomplete="off" enterkeyhint="search">
    <button type="button" class="mis-btn btn-lookup" data-side="<%= sideId %>">🔍 検索</button>
  </div>
  <small class="hint">
    モール側受注番号 (Amazon: 503-xxx / 楽天: 373343-xxx 等) でも、NE 伝票番号 (1438443 等) でも探せます。
    貼り付けると自動で検索します。
  </small>
</div>

<label class="form-row order-unknown">
  <input type="checkbox" name="order_id_unknown<%= sfx %>" class="order-unknown-check" data-side="<%= sideId %>">
  <span>注文番号が分からない (在庫紛失など。チェックすると商品情報なしで登録します)</span>
</label>

<div class="lookup-result" id="lookup-result-<%= key %>" hidden>
  <h4>✅ 見つかりました (登録時にサーバがもう一度取り直します)</h4>
  <dl class="lookup-info">
    <dt>モール</dt><dd data-field="mall">-</dd>
    <dt>モール受注番号</dt><dd data-field="mall_order_id">-</dd>
    <dt>NE 伝票番号</dt><dd data-field="slip_no">-</dd>
    <dt>商品名</dt><dd data-field="product_name">-</dd>
    <dt>SKU</dt><dd data-field="sku">-</dd>
    <dt>注文日</dt><dd data-field="order_date">-</dd>
    <dt>注文数量</dt><dd data-field="ordered_qty">-</dd>
  </dl>
  <p class="matched-note" hidden></p>
  <p class="multi-line-warn" hidden>⚠️ この注文は明細が複数あります (ここには先頭の明細を表示しています)</p>
</div>

<div class="lookup-error" id="lookup-error-<%= key %>" hidden>
  <p data-role="lookup-error-message">⚠️ 注文がマスターに見つかりませんでした。次のどれかを選んでください:</p>
  <ul class="lookup-options">
    <li>番号を直して、もう一度「🔍 検索」を押す</li>
    <li>上の「注文番号が分からない」にチェックする (在庫紛失など)</li>
    <li>番号は合っている (古い受注などでマスターに無い) → モールを手で選んで進む</li>
  </ul>
  <div class="form-row manual-mall-row" hidden>
    <label class="label" for="manual_mall<%= sfx %>">モール (手で指定) <em>*</em></label>
    <select id="manual_mall<%= sfx %>" name="manual_mall<%= sfx %>" class="manual-mall-select" data-side="<%= sideId %>">
      <option value="">選択してください</option>
      <option value="amazon">Amazon</option>
      <option value="rakuten">楽天</option>
      <option value="yahoo">Yahoo</option>
      <option value="linegift">LINEギフト</option>
      <option value="mercari">メルカリ</option>
      <option value="aupay">auPAY</option>
      <option value="qoo10">Qoo10</option>
      <option value="other">その他</option>
    </select>
  </div>
  <button type="button" class="mis-btn toggle-manual-btn" data-side="<%= sideId %>">📝 モールを手で選んで進む</button>
</div>

<% if (mixUp) { %>
  <%- include('_qty_loss', { sfx: sfx }) %>
<% } %>
