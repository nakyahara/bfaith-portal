<%
  // AMC 商品ラベルのバーコード印字 (Company DB構想 21 A1・発注アプリの po_barcode_labels に保存)。商品の画面だけ。動き = public/me-amclabel.js
  //   al = router の amcLabel (apps/master-edit/amc-label.mjs amcLabelScreen の答え + STATUSES・WORDS・HINTS)
  //   🚨 バーコードの 3 つを混ぜない: ① JAN・FNSKU (Company DB) / ② ここ = AMC が刷るラベルの印字 / ③ 入庫で弊社が BC シールを貼るか (入荷アプリ・読むだけ)
  const hh = (x) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const W = al.WORDS || {};
  const lab = al.label || null;
  const curStatus = lab ? lab.status : 'unregistered';
  const curValue = lab ? (lab.barcodeValue || '') : '';
  const norm = (v) => String(v ?? '').trim().toUpperCase();
  const cands = al.cands && al.cands.ok ? al.cands.candidates : [];
  const excluded = al.cands && al.cands.ok ? al.cands.excluded : [];
  const hit = curValue ? cands.findIndex((c) => norm(c.value) === norm(curValue)) : -1;
  const initPick = !curValue ? 'none' : hit >= 0 ? 'c' + hit : 'keep';
  const ro = !al.canWrite;
  const D = ro ? ' disabled' : '';
  const statusBadge = { printed: 'ok', requested: 'info', unset: 'warn', not_needed: 'mute', unregistered: 'warn' };
  const typeWord = (t) => (t === 'fnsku' ? 'FNSKU' : t === 'jan' ? 'JAN' : 'その他');
  const initStatus = lab ? lab.status : 'unset';
  const pageData = al.target ? {
    base, code, canWrite: !!al.canWrite, version: lab ? lab.version : null, status: initStatus, value: curValue, pick: initPick,
    inbound: al.inbound || null, words: W, hints: al.HINTS || {},
    cands: cands.map((c) => ({ kind: c.kind, row: c.row, listing_id: c.listing_id || null, value: c.value })),
  } : null;
%>
<section class="panel" id="sec-amc" aria-labelledby="h-amc">
  <div class="panel-h">
    <span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-tag"/></svg></span>
    <h2 id="h-amc">AMC 商品ラベルのバーコード印字</h2><span class="sub">発注アプリに保存されます (右の「保存する」とは別)</span>
    <span class="right"><a class="hint" href="/apps/purchase-orders/admin?grp=barcode" target="_blank" rel="noopener">発注アプリで見る <svg class="ic s" style="vertical-align:-2px" aria-hidden="true"><use href="#i-ext"/></svg></a></span>
  </div>
  <% if (!al.canSee) { %>
    <div class="callout info" id="amc-why"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= al.why %>。発注アプリの権限がある人が入れます。</div></div>
  <% } else if (al.error) { %>
    <div class="callout err" id="amc-why"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= al.error %>。少し待ってから画面を開き直してください。</div></div>
  <% } else if (!al.target) { %>
    <div class="amc-off" id="amc-off">
      <span class="b mute">対象外</span><span><%= al.reasonWords %></span>
      <% if (lab) { %><span class="hint">発注アプリに前の記録があります (<%= W[lab.status] || lab.status %><%= lab.barcodeValue ? ' · ' + lab.barcodeValue : '' %>) · 発注アプリのバーコードタブの「対象外の行」に出ます</span><% } %>
      <span class="hint">対象 = 仕入先が AMC で、自社商品 (売上分類 1) の単品。新商品は商品管理リストに出てから (NE に登録した翌朝から)。</span>
    </div>
  <% } else { %>
    <p class="hint amc-lead">AMC が刷る商品パッケージのラベルに載せるバーコードです。JAN・FNSKU の登録 (この画面の JAN・Amazon SKU) や、入庫で貼る BC シール (入荷アプリ) とは別のものです。</p>
    <div class="callout warn" id="amc-mismatch"<%= al.mismatch ? '' : ' hidden' %>><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow" id="amc-mismatch-t"><%= al.mismatch || '' %></div></div>
    <% if (ro && al.why) { %><div class="callout info" id="amc-ro"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">見るだけです: <%= al.why %></div></div><% } %>

    <div class="f"><div class="lab">いま</div>
      <div class="ctl" id="amc-now">
        <span class="b <%= statusBadge[curStatus] || 'mute' %>" id="amc-now-st"><%= W[curStatus] || curStatus %></span>
        <span class="mono" id="amc-now-v"><%= curValue || '値なし' %></span>
        <% if (lab) { %><span class="hint" id="amc-now-by"><%= lab.updatedBy || '—' %> · <%= String(lab.updatedAt || '').slice(0, 10) %><%= lab.source === 'csv' ? ' · CSV で取込' : '' %></span><% } else { %><span class="hint">発注アプリにまだ行がありません (未登録 = 発注するときに印字を頼む対象)</span><% } %>
        <% if (al.vendorCode) { %><span class="linkchip"><span class="n2">AMC 管理番号</span> <span class="mono"><%= al.vendorCode %></span></span><% } %>
      </div></div>

    <div class="f" data-row="amc.status"><div class="lab" id="lab-amc-status">状態</div>
      <div class="ctl col" style="gap:6px">
        <div class="seg" role="group" id="amc-status" aria-labelledby="lab-amc-status" data-value="<%= initStatus %>">
          <% for (const s of al.STATUSES) { %><button type="button" data-v="<%= s %>" aria-pressed="<%= s === initStatus ? 'true' : 'false' %>"<%= s === initStatus ? ' class="on"' : '' %><%= D %>><%= W[s] %></button><% } %>
        </div>
        <span class="hint" id="amc-status-hint"><%= (al.HINTS || {})[initStatus] || '' %><%= !lab ? ' · 保存すると発注アプリに行ができます' : '' %></span>
      </div></div>

    <div class="f" data-row="amc.value" style="align-items:start"><div class="lab" id="lab-amc-value" style="padding-top:8px">刷る値</div>
      <div class="ctl col" style="gap:8px">
        <% if (al.cands && !al.cands.ok) { %><div class="callout err" style="margin:0"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= al.cands.error %>。手で打つか、今の値のままにできます。</div></div><% } %>
        <div class="amc-cands" role="radiogroup" aria-labelledby="lab-amc-value" id="amc-cands">
          <% cands.forEach((c, i) => { %>
          <label class="amc-cand"><input type="radio" name="amc-pick" value="c<%= i %>"<%= initPick === 'c' + i ? ' checked' : '' %><%= D %>>
            <span class="body"><span class="v mono"><%= c.value %></span><span class="b <%= c.kind === 'fnsku' ? 'info' : 'vio' %>"><%= typeWord(c.kind) %></span><% if (hit === i) { %><span class="b ok">いまの値</span><% } %>
              <span class="meta"><%= c.kind === 'fnsku' ? c.mall_words + ' · 出品 SKU ' + c.listing_code + ' · ' + c.listing_status_words : 'この商品の JAN (Company DB)' %></span></span></label>
          <% }) %>
          <% if (initPick === 'keep') { %>
          <label class="amc-cand keep"><input type="radio" name="amc-pick" value="keep" checked<%= D %>>
            <span class="body"><span class="v mono"><%= curValue %></span><span class="b warn">候補に無い</span><span class="meta">今の値のまま (Company DB のこの商品の FNSKU・JAN に無い値。刷ってある値を確かめてください)</span></span></label>
          <% } %>
          <label class="amc-cand"><input type="radio" name="amc-pick" value="manual"<%= D %>>
            <span class="body"><span class="v">手で打つ</span><span class="meta">候補に無いときだけ · 理由が要ります</span></span></label>
          <label class="amc-cand"><input type="radio" name="amc-pick" value="none"<%= initPick === 'none' ? ' checked' : '' %><%= D %>>
            <span class="body"><span class="v">値なし</span><span class="meta">まだ決まっていない・不要のとき</span></span></label>
        </div>
        <% if (!cands.length && al.cands && al.cands.ok) { %><span class="hint" id="amc-nocand">Company DB にこの商品の FNSKU (1 個だけの Amazon の出品) も JAN もありません。JAN はこの画面の「JAN」で、FNSKU は Amazon の出品が Company DB に入ってから選べます。</span><% } %>
        <div class="po-sub" id="amc-manual" hidden>
          <div class="f" data-row="amc.manual_value"><label class="lab" for="amc-mv">値</label><div class="ctl"><input class="in w-m mono" id="amc-mv" maxlength="64" autocomplete="off" spellcheck="false" placeholder="例: X0019R42C5 / 4901234567894"<%= D %>><span class="hint" id="amc-mv-type"></span><span class="hint">FNSKU (X0 で始まる 10 文字) か JAN (8 桁・13 桁・チェック数字まで確かめます)</span></div></div>
          <div class="f" data-row="amc.manual_other"><div class="lab">例外の形</div><div class="ctl"><label class="amc-chk"><input type="checkbox" id="amc-mx"<%= D %>> FNSKU・JAN の形ではない値を刷る (例外)</label><span class="hint">ふつうは使いません · 理由に「なぜこの形か」を書いてください</span></div></div>
          <div class="f" data-row="amc.manual_reason"><label class="lab" for="amc-mr">理由<span class="req">必須</span></label><div class="ctl"><input class="in w-l" id="amc-mr" maxlength="200" autocomplete="off" placeholder="例: 米国の FNSKU を刷った (Company DB に無い)"<%= D %>></div></div>
        </div>
        <% if (excluded.length) { %>
        <details class="more" id="amc-excluded"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>選べない FNSKU (<%= excluded.length %>)</summary>
          <div class="body"><% for (const x of excluded) { %><div class="amc-ex"><span class="mono"><%= x.value %></span> <span class="hint"><%= x.mall_words %> · 出品 SKU <%= x.listing_code %> · <%= x.why %> (この商品 1 個のパッケージには刷らない)</span></div><% } %></div>
        </details>
        <% } %>
        <span class="fmsg" id="amc-warn" aria-live="polite"></span>
      </div></div>

    <div class="f" data-row="amc.note"><label class="lab" for="amc-note">メモ</label><div class="ctl"><input class="in w-l" id="amc-note" maxlength="500" autocomplete="off" placeholder="—" value="<%= lab ? lab.note || '' : '' %>"<%= D %>></div></div>

    <div class="f"><div class="lab">入荷アプリ</div><div class="ctl">
      <% if (al.inbound) { %><span>入庫で BC シール: <b id="amc-seal"><%= al.inbound.bc_seal %></b></span><% } else { %><span class="muted" id="amc-seal">入荷アプリにまだ値がありません</span><% } %>
      <span class="hint">読むだけ · 入荷アプリの値は自動では合わせません (食い違うときは上に印)</span></div></div>

    <% if (!ro) { %>
    <div class="po-foot">
      <span class="hint">発注アプリに保存されます (Company DB の「保存する」とは別) · 選んだ候補は保存のときに Company DB でもう一度確かめます · ほかの人が先に直していたら保存せずに知らせます</span>
      <span class="msgline" id="amc-msg" role="status" aria-live="polite"></span>
      <button class="btn pri" type="button" id="amc-save" disabled>ラベルの印字を保存</button>
    </div>
    <% } %>
    <script type="application/json" id="me-amc"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
  <% } %>
</section>
