<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
  <%- include('_header') %>
  <%
    // 🆕 0081 ロジザード登録の CSV (logizard_bc_upload.csv・CompanyDB構想 23 v4 §5')。今の GAS の「新規商品マスタを CSV 出力」(人が H 列などを手で入れる) の置き換え (GAS は予備)。
    //   作る → 「ロジザードに取り込む」(🆕 2026-10-17・miniPC が取りに来て ① 取込 → ② 書き出し・帳面 = apps/lz-bc-import) / 予備 = ダウンロードして手で・Stream Deck の auto-barcode.js・GAS。
    //   画面の動き = public/me-lzcsv.js (取り込みの様子は数秒おきに読み直す)
    const C = cands;
    const canAct = canApprove && !dbError && !!C && C.db_ready && mirror.ok && !mirror.stale;   // 🆕 #1721 R2: 写しが古い = 作れない (DB も断る)
    const dis = canAct ? '' : ' disabled';
    const when = (v) => (v ? String(v).replace('T', ' ').slice(0, 16) : '—');
    const kindBadge = { fnsku: 'info', jan: 'vio', lz_assign: 'mute' };
    const pageData = canAct ? { base, ready: C.ready.map((x) => ({ sku_id: x.sku_id, rule_row: x.rule_row, code: x.code })), stale: !!mirror.stale } : { base, ready: [], stale: !!mirror.stale };
    // 🆕「ロジザードに取り込む」: 画面の JS が読み直して描く (最初の値はここから)
    Object.assign(pageData, { canImport: !!canImport, importMessage, bc, importBlock, exports: exports.map((e) => ({ id: e.id, sha: e.sha, rows: e.rows, state: e.state, in_lz: e.in_lz ?? null, in_lz_total: e.in_lz_total ?? null, in_lz_collide: e.in_lz_collide ?? null })), words: BC_STATE_WORDS, nightWords: BC_NIGHT_WORDS });
    // 🆕 2026-10-21「まだ取り込んでいない」= ボタンで取り込んでいないだけ (手で取り込んだかもしれない) → 「ボタンではまだ」・写しに全部ある = 手で取り込み済み
    const inLzAll = (e) => e.in_lz_total > 0 && e.in_lz === e.in_lz_total;
    const bcCell = (e) => {
      const s = bc && bc.byExport[e.id];
      const viaBtn = !!(s && (s.imported_job || s.active_job || s.unresolved_job));
      if (inLzAll(e) && !viaBtn) return 'ロジザードにもうあります (手で取り込み済み)';
      return s && s.last ? s.last.state_words : 'ボタンではまだ';
    };
    // 🆕 2026-10-24 (中原さん「ダウンロードを押しても落ちない」): ポータルが断ると決まっている CSV (lz-bc-import の recordDownload と同じ決まり) =
    //   ダウンロードのボタンを押せない形にして理由を添える。ほかの断り (取り消した・記録を残せない) は押した時にその行に出す (画面の動き = me-lzcsv.js・部品 = me-download.js)
    const dlWhy = (e) => {
      const s = bc && bc.byExport[e.id];
      if (!s) return null;
      if (s.unresolved_job) return `取り込み (#${s.unresolved_job}) が「取り込めたか分からない」のままです。下の③で確かめて記してから、ダウンロードできます`;
      if (s.active_job) return `いまボタンでロジザードに取り込んでいます (#${s.active_job})。終わってから (取り込み中はダウンロードできません)`;
      if (s.imported_ok_job) return `ボタンで取り込んだ CSV です (#${s.imported_ok_job})。手でもう一度取り込まないでください (ダウンロードできません)`;
      return null;
    };
  %>
  <div class="page" id="lzc" data-base="<%= base %>">
    <nav class="crumb" aria-label="いまの場所"><a href="<%= base %>/" data-list-back>商品・セット</a><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg><span aria-current="page">ロジザード登録の CSV</span></nav>
    <div class="ph">
      <div>
        <h1>ロジザード登録の CSV</h1>
        <div class="lead">新商品をロジザードに登録する CSV (logizard_bc_upload.csv) を作ります。<b style="color:var(--text)">作る → 「ロジザードに取り込む」</b> (miniPC がその CSV をロジザードに取り込み、バーコードマスタ.csv も書き出す)。
          バーコード・有効期限区分・入荷日管理は新商品の登録で入れた値がそのまま入ります (GAS のシートに手で入れなくてよい)。同じ商品は 2 回出しません。
          <span class="hint" id="lzc-manual">ボタンが使えないとき (miniPC が止まっている など) は、ダウンロードして手でロジザードに取り込めます (Stream Deck の auto-barcode.js でも可)。ボタンと手の両方で取り込まない。</span>
          <span class="hint" id="lzc-gas">この画面が使えないとき (開けない・作れない) だけ、予備として今までどおり GAS (ロジザード情報連携シート) で作れます (H 列に商品の画面のバーコードを入れる)。</span></div>
      </div>
      <div class="ph-actions"><a class="btn" href="<%= base %>/manual#lz-barcode"><svg class="ic" aria-hidden="true"><use href="#i-book"/></svg>つかいかた</a></div>
    </div>
    <% if (dbError) { %><div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t"><%= dbError %></div></div></div><% } %>
    <% if (!canApprove) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= approveMessage %></div></div><% } %>
    <% if (C && !C.db_ready) { %><div class="callout warn" id="lzc-notready"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow">Company DB に 0081 (ロジザード登録の CSV) がまだ入っていないか、権限の流し直しの前です。それまでは予備の GAS で作ってください。</div></div><% } %>
    <% if (C && C.db_ready && C.copy && C.copy.state !== 'checked') { %><div class="callout warn" id="lzc-copy"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">ロジザードのバーコードマスタの写し: <%= C.copy.words %></div><div class="hint">保存のときに写しと照らせていないバーコードは、新しい写し (<%= FRESH_HOURS %> 時間の中) で照らし直せるまで CSV に出しません (下の「止まっている商品」)。</div></div></div><% } %>
    <% if (!mirror.ok) { %><div class="callout err" id="lzc-mirror"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">ロジザードの商品の一覧の写しを読めません</div><div class="hint"><%= mirror.reason %> · ロジザードにまだ無い商品か確かめられないので、CSV は作れません。</div></div></div>
    <% } else if (mirror.stale) { %><div class="callout warn" id="lzc-mirror"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">ロジザードの商品の一覧の写しが古い (<%= when(mirror.list_as_of) %>)</div><div class="hint">毎晩取り込む写しが <%= FRESH_HOURS %> 時間の中にありません。もうロジザードに登録した商品が混ざるかもしれないので、CSV は作れません。毎晩の取り込みの後に作るか、急ぐときは予備の GAS で作ってください。</div></div></div>
    <% } else { %><div class="hint" id="lzc-mirror" style="margin:0 0 12px">ロジザードの商品の一覧の写し: <%= when(mirror.list_as_of) %> (<%= Number(mirror.rows).toLocaleString('ja-JP') %> 件) · バーコードマスタ: <%= when(mirror.bc_as_of) %></div><% } %>

    <% if (C && C.db_ready) { %>
    <section class="panel" aria-labelledby="h-lzready">
      <div class="panel-h"><span class="hico" aria-hidden="true">①</span><h2 id="h-lzready">CSV にする商品</h2><span class="sub">ポータルで登録した単品で、ロジザードにまだ無い · ロジザードにもうある <%= C.in_lz %> 件は出しません</span></div>
      <% if (!C.ready.length) { %><div class="empty">今 CSV にできる商品はありません。<% if (C.held.length) { %>下の「止まっている商品」を直すと出せます。<% } %></div><% } else { %>
      <div class="tblwrap">
        <table class="tbl" id="lzc-ready">
          <caption class="sr">CSV にする商品</caption>
          <thead><tr><th scope="col">商品ID (コード)</th><th scope="col">名前</th><th scope="col">バーコード</th><th scope="col">有効期限区分</th><th scope="col">入荷日管理</th><th scope="col">仕入単価</th><th scope="col">取引先</th></tr></thead>
          <tbody>
          <% for (const x of C.ready) { %>
            <tr data-sku="<%= x.sku_id %>">
              <td class="code"><a href="<%= base %>/sku/<%= encodeURIComponent(x.code) %>"><%= x.code %></a></td>
              <td><%= x.name %></td>
              <td><span class="mono"><%= x.value || '空欄' %></span> <span class="b <%= kindBadge[x.kind] || 'mute' %>"><%= x.kind === 'lz_assign' ? 'ロジザードが番号を付ける' : KINDS[x.kind] %></span><% if (x.rechecked) { %> <span class="b ok" data-rechecked="1">写しと照らし直した</span><% } %><% for (const n of x.notes) { %><div class="hint"><%= n %></div><% } %></td>
              <td><span class="mono"><%= x.expiry_code %></span> <span class="hint"><%= x.expiry_code === '02' ? 'あり' : 'なし' %></span></td>
              <td><span class="mono"><%= x.inbound_code %></span> <span class="hint"><%= x.inbound_code === '1' ? 'あり' : x.inbound_unknown ? 'なし (登録で入力なし)' : 'なし' %></span></td>
              <td><%= x.cost == null ? '0 (原価なし)' : x.cost %></td>
              <td class="mono"><%= x.supplier %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
      <div class="buildbar">
        <button class="btn pri" type="button" id="lzc-build"<%= dis %>><svg class="ic" aria-hidden="true"><use href="#i-file"/></svg><%= C.ready.length %> 件の CSV を<%= canImport ? '作る' : '作ってダウンロード' %></button>
        <span class="hint">作ると帳面に残り、この商品は次から出しません (取り消すと出し直せる) · ファイル名 logizard_bc_upload.csv (Shift_JIS)</span>
        <% if (C.rest) { %><span class="b warn" id="lzc-rest">残り <%= C.rest %> 件は次の回 (1 回の CSV は <%= C.max %> 件まで)</span><% } %>
      </div>
      <% } %>
      <div class="msgline" id="lzc-msg" role="status" aria-live="polite"></div>
    </section>

    <% if (C.held.length) { %>
    <section class="panel" aria-labelledby="h-lzheld">
      <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-lock"/></svg></span><h2 id="h-lzheld">止まっている商品 (<%= C.held.length %>)</h2><span class="sub">直すと上に出ます</span></div>
      <div class="tblwrap"><table class="tbl" id="lzc-held"><thead><tr><th scope="col">コード</th><th scope="col">名前</th><th scope="col">止まっている理由</th></tr></thead><tbody>
        <% for (const x of C.held) { %>
        <tr><td class="code"><a href="<%= base %>/sku/<%= encodeURIComponent(x.code) %>"><%= x.code %></a></td><td><%= x.name %></td>
          <td><% for (const h of x.holds) { %><div class="why-blk" data-hold="<%= h %>"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><span><%= (x.hold_notes && x.hold_notes[h]) || HOLD_WORDS[h] || h %><%= x.value && (h === 'lz_taken' || h === 'dup_in_file') ? ' (' + x.value + ')' : '' %></span></div><% } %></td></tr>
        <% } %>
      </tbody></table></div>
    </section>
    <% } %>

    <section class="panel" aria-labelledby="h-lzexp">
      <div class="panel-h"><span class="hico" aria-hidden="true">②</span><h2 id="h-lzexp">作った CSV</h2><span class="sub">新しい順 · 「ロジザードに取り込む」で miniPC が取り込む · 予備 = ダウンロードして手で · 取り込めなかったら取り消して作り直す</span></div>
      <% if (!exports.length) { %><div class="empty">まだありません</div><% } else { %>
      <div class="tblwrap"><table class="tbl" id="lzc-exports"><thead><tr><th scope="col">#</th><th scope="col">作った</th><th scope="col">件数</th><th scope="col">商品</th><th scope="col">状態</th><th scope="col">ロジザード</th><th scope="col"></th></tr></thead><tbody>
        <% for (const e of exports) { %>
        <tr data-export="<%= e.id %>"><td class="mono">#<%= e.id %></td><td><%= when(e.created_at) %> <span class="hint"><%= e.actor_id %></span></td><td><%= e.rows %></td><td class="hint"><%= e.codes %><%= e.rows > 6 ? ' …' : '' %></td>
          <td><% if (e.state === 'issued') { %><span class="b ok">出した</span><% } else { %><span class="b mute">取り消した</span> <span class="hint"><%= when(e.voided_at) %> · <%= e.void_reason %></span><% } %></td>
          <td data-bc-cell="<%= e.id %>"><span class="hint"><%= bcCell(e) %></span></td>
          <td><% if (e.state === 'issued' && canApprove) { const w = dlWhy(e); %><button class="btn sm" type="button" data-lz-dl="<%= e.id %>"<%= w ? ' disabled' : '' %>><svg class="ic s" aria-hidden="true"><use href="#i-download"/></svg>ダウンロード</button> <button class="btn sm ghost" type="button" data-void="<%= e.id %>">取り消す</button>
            <div class="hint" data-lz-dl-why="<%= e.id %>"<%= w ? '' : ' hidden' %>><%= w || '' %></div><div class="msgline" data-lz-dl-msg="<%= e.id %>" role="status" aria-live="polite"></div><% } %></td></tr>
        <% } %>
      </tbody></table></div>
      <% } %>
      <div class="msgline" id="lzc-bc-msg" role="status" aria-live="polite"></div>
    </section>

    <section class="panel" aria-labelledby="h-lzbc" id="lzc-bc">
      <div class="panel-h"><span class="hico" aria-hidden="true">③</span><h2 id="h-lzbc">ロジザードへの取り込み (miniPC)</h2><span class="sub">① 新商品の取込 (商品マスタ / 新商品バーコード登録) → ② バーコード情報の書き出し (共有ドライブのバーコードマスタ.csv をポータルが上書き) · 夜 23:45〜01:30 は取り込まない</span></div>
      <% if (bcError) { %><div class="callout err"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= bcError %></div></div><% } %>
      <% if (!canImport && !bcError) { %><div class="hint" id="lzc-bc-who"><%= importMessage %></div><% } %>
      <div id="lzc-bc-runner" class="hint"><% if (bc) { %>miniPC: <%= bc.runner.alive ? '来ている' : '来ていない' %><% } %></div>
      <div id="lzc-bc-export" class="hint"></div>
      <div id="lzc-bc-latest"></div>
      <details id="lzc-bc-recent-wrap"><summary>最近の取り込み</summary><div id="lzc-bc-recent"></div></details>
    </section>
    <% } %>
    <script type="application/json" id="me-lzc"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
  </div>
  <%- include('_footer') %>
  <% if (canApprove && C && C.db_ready) { %><script src="<%= base %>/public/me-download.js?v=<%= assetV %>" defer></script><script src="<%= base %>/public/me-lzcsv.js?v=<%= assetV %>" defer></script><% } %>
</body>
</html>
