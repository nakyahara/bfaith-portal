<%
  // 発注の設定 (発注アプリに保存・10/9 中原さん)。新商品の登録 (mode = new: 下書きの保存と一緒に送る) と商品の画面 (mode = sku: 別の「発注の設定を保存」) の 1 つの部品。
  // 代表 (色違い) の画面 (Company DB構想 20 §⑩) にも同じ include で差し込める (渡すもの = os・mode・dis・stepNo・base・code)。動き = public/me-order.js
  //   os = apps/master-edit/order-settings.mjs orderScreen の答え { canSee, canWrite, why, data, supplier }
  const hh = (x) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const d = os && os.data && os.data.ok ? os.data : null;
  const cur = (d && d.row) || {};
  const ro = !os || !os.canWrite || (mode === 'new' && !!dis);
  const D = ro ? ' disabled' : '';
  // 新商品の登録では、下書きの保存の「未保存」に数える (data-dirty-field)。商品の画面では Company DB の保存と混ぜない (me-order.js が自分で数える)
  const track = (name, label) => (mode === 'new' ? ' data-dirty-field="po_' + name + '"' : ' data-po-dirty="' + name + '"') + ' data-label="' + hh(label) + '"';
  const normSup = (v) => { const t = String(v ?? '').trim(); return /^\d+$/.test(t) ? String(parseInt(t, 10)) : t; };
  const sup = normSup(os && os.supplier);
  // 🆕 2026-10-13 (入力なし): 新商品の登録では、グループの なし / 今ある / 新しく作る を初めは選ばない形 (選ぶまで保存できない・「なし」= 入力なし)
  const condMode = cur.condition_id ? 'pick' : (mode === 'new' ? '' : 'none');
  const matMode = cur.material_group_id ? 'pick' : (mode === 'new' ? '' : 'none');
  // 新商品の登録の「入力なし」(public/me-none.js・サーバー = lib/master-register-blanks.mjs と同じ名前)。商品の画面には出さない
  //   出すかどうかは API と同じ関数 (order-settings.mjs の orderNoneApplies = #1706 Codex R1 M2)。渡されていない画面 = 出さない
  const noneOn = mode === 'new' && !ro && typeof orderNoneApplies === 'function' && orderNoneApplies(os);
  const none = (key, label) => (noneOn ? '<label class="nonechk"><input type="checkbox" data-none="order_settings.' + key + '" aria-label="' + hh(label) + 'を入力なしにする"><span>入力なし</span></label>' : '');
  const part = (key) => (noneOn ? ' data-none-part="order_settings.' + key + '"' : '');
  const segPo = (id, value, opts, label) => '<div class="seg" role="group" id="' + id + '" aria-label="' + hh(label) + '" data-value="' + value + '"' + track(id, label) + '>'
    + opts.map(([v, t]) => '<button type="button" data-v="' + v + '" aria-pressed="' + (value === v ? 'true' : 'false') + '"' + (value === v ? ' class="on"' : '') + D + '>' + hh(t) + '</button>').join('') + '</div>';
  const num = (v) => (v == null ? '' : String(v));
  const condLabel = (c) => c.id + ' — ' + (c.name || '') + (c.supplier ? ' (仕入先 ' + c.supplier + ')' : '');
  // 🆕 ⑤-1 / ⑤-2 (CompanyDB構想 27 §2.4): 先方品番・入数 (発注アプリの先方番号対応表・仕入先ごと)。
  //   商品の画面 = vendorSettings (order-settings.mjs vendorScreen の答え・router が渡す)・新商品の登録 (単品だけ) = vendorNew (router が渡す)。
  //   どちらも無い画面 (まとまりの登録・代表の画面) = 出さない
  const vs = mode === 'sku' && typeof vendorSettings !== 'undefined' ? vendorSettings : null;
  const vendorNewOn = mode === 'new' && typeof vendorNew !== 'undefined' && vendorNew === true;
  const vEditable = vs && vs.editable ? vs.editable : { supplier: null, error: null };
  const vRows = vs && vs.data && vs.data.ok ? vs.data.rows : [];
  const vSup = (c) => (vs && vs.data && vs.data.ok && vs.data.suppliers[c] ? vs.data.suppliers[c] : { name: '', lead_days: null, known: false });
  const vCanWrite = !!(vs && vs.canWrite);
  const vPrimary = vs ? normSup(vs.primarySupplier) : '';
  const pageData = d ? {
    mode, base, code: code || null, canWrite: !ro, noneOn, supplier: sup || null, vendorOn: !!vs || vendorNewOn,
    seen: d.row ? d.row.updated_at : null,
    conditions: d.conditions.map((c) => ({ id: c.id, supplier: c.supplier })),
    lotSource: d.lotSource, neLot: d.neLot,
  } : null;
%>
<section class="panel" id="sec-order" aria-labelledby="h-order" data-po-mode="<%= mode %>">
  <div class="panel-h">
    <% if (mode === 'new') { %><span class="stepno" data-step="sec-order" aria-hidden="true"><%= stepNo %></span><% } else { %><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-cart"/></svg></span><% } %>
    <h2 id="h-order">発注の設定</h2><span class="sub">発注アプリに保存されます<%= mode === 'sku' ? ' (右の「保存する」とは別)' : ' (あとでも可)' %><%= typeof subExtra === 'undefined' ? '' : subExtra %></span>
    <span class="right"><a class="hint" href="/apps/purchase-orders/admin?grp=attrs" target="_blank" rel="noopener">発注アプリで見る <svg class="ic s" style="vertical-align:-2px" aria-hidden="true"><use href="#i-ext"/></svg></a></span>
  </div>
  <% if (!os || !os.canSee) { %>
    <div class="callout info" id="po-why"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= os ? os.why : '発注アプリの設定を読めません' %>。発注アプリの権限がある人が入れます。</div></div>
  <% } else if (!d) { %>
    <div class="callout err" id="po-why"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= os.why || '発注アプリの設定を読めません' %>。少し待ってから画面を開き直してください<%= mode === 'new' ? ' (空のまま下書きにして、あとで商品の画面で入れることもできます)' : '' %>。</div></div>
  <% } else { %>
    <% if (d.lotSource !== 'app') { %>
    <div class="callout info" id="po-lot-ne"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow">いまの発注のすすめる数は NE のロット<%= d.neLot ? ' (' + d.neLot + ' 個)' : '' %>を使っています。NE のロットを発注アプリに写した後は、ここの発注ロットを使います。</div></div>
    <% } else if (d.neLot && cur.order_lot != null && Number(cur.order_lot) !== Number(d.neLot)) { %>
    <div class="callout warn" id="po-lot-diff"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow">NE のロット (<%= d.neLot %> 個) と違います。発注のすすめる数はここの値 (<%= cur.order_lot %> 個) を使います。NE だけで直したロットなら、ここも直してください。</div></div>
    <% } %>
    <% if (ro && os.why) { %><div class="callout info" id="po-why"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">見るだけです: <%= os.why %></div></div><% } %>

    <div class="f" data-row="order_settings.order_lot"><label class="lab" for="po-order_lot">発注ロット</label>
      <div class="ctl"><input class="in w-s" id="po-order_lot" inputmode="numeric" autocomplete="off" placeholder="—" value="<%= num(cur.order_lot) %>"<%- track('order_lot', '発注ロット') %><%- part('order_lot') %><%= D %>><span class="unit">個ずつ</span><%- none('order_lot', '発注ロット') %>
        <span class="hint">発注のすすめる数をこの数の倍数にそろえます · 空 = すすめる数が出ません<%= d.neLot ? ' · NE のロット ' + d.neLot + ' 個' : '' %></span></div></div>

    <div class="f" data-row="order_settings.condition_id" style="align-items:start"><div class="lab" style="padding-top:8px">発注条件グループ</div>
      <div class="ctl col" style="gap:8px">
        <%- segPo('po-cond-mode', condMode, [['none', 'なし'], ['pick', '今あるグループ'], ['new', '新しく作る']], '発注条件グループ') %><% if (noneOn) { %><span class="hint">使わないときは「なし」(= 入力なし)</span><% } %>
        <div id="po-cond-pick"<%= condMode === 'pick' ? '' : ' hidden' %>>
          <%# グループを名前・ID で絞る (10/16 中原さん「グループ名で検索できるように」・public/me-order.js の絞り込み) %>
          <input type="search" class="in w-l po-gq" id="po-cond-q" data-for="po-condition_id" autocomplete="off" spellcheck="false" placeholder="🔍 名前・ID で絞る" aria-label="発注条件グループを名前・ID で絞る" aria-controls="po-condition_id" style="margin-bottom:6px"<%= D %>>
          <div class="hint" id="po-cond-q-n" role="status" aria-live="polite" hidden></div>
          <select class="in w-l" id="po-condition_id" aria-label="発注条件グループを選ぶ"<%- track('condition_id', '発注条件グループ') %><%= D %>>
            <option value="">(選ぶ)</option>
            <% for (const c of d.conditions) { const mine = !!sup && c.supplier === sup; const sel = c.id === cur.condition_id; if (!mine && !sel && mode === 'sku') continue; %><option value="<%= c.id %>" data-sup="<%= c.supplier %>"<%= sel ? ' selected' : '' %>><%= condLabel(c) %><%= !mine && sel ? ' · 代表の仕入先ではない' : '' %></option><% } %>
          </select>
          <div class="hint" id="po-cond-hint">代表の仕入先<%= sup ? ' (' + sup + ')' : '' %> のグループだけ選べます (最低金額・最低数量など)</div>
        </div>
        <div class="po-sub" id="po-cond-new"<%= condMode === 'new' ? '' : ' hidden' %>>
          <div class="ttl"><svg class="ic" style="color:var(--accent)" aria-hidden="true"><use href="#i-plus"/></svg>新しい発注条件グループ (代表の仕入先<span id="po-cond-new-sup"><%= sup ? ' ' + sup : '' %></span> に作ります)</div>
          <div class="f" data-row="order_settings.new_condition.display_name"><label class="lab" for="po-nc-name">名前</label><div class="ctl"><input class="in w-m" id="po-nc-name" maxlength="100" autocomplete="off" placeholder="例: ○○商事 3 万円以上"<%- track('nc_name', '新しい発注条件グループの名前') %><%= D %>></div></div>
          <div class="f" data-row="order_settings.new_condition.condition_id"><label class="lab" for="po-nc-id">ID</label><div class="ctl"><input class="in w-m mono" id="po-nc-id" maxlength="64" autocomplete="off" spellcheck="false" placeholder="例: maruma-30000"<%- track('nc_id', '新しい発注条件グループの ID') %><%= D %>><span class="hint">発注アプリでの呼び名 · あとで変えられません</span></div></div>
          <div class="f" data-row="order_settings.new_condition.condition_type"><label class="lab" for="po-nc-type">決まり</label><div class="ctl"><select class="in w-m" id="po-nc-type"<%- track('nc_type', '新しい発注条件の決まり') %><%= D %>>
            <option value="">(選ぶ)</option>
            <% for (const t of d.types) { %><option value="<%= t.type %>|<%= t.unit %>"><%= t.label %></option><% } %>
          </select></div></div>
          <div class="f" data-row="order_settings.new_condition.condition_value"><label class="lab" for="po-nc-value">値</label><div class="ctl"><input class="in w-s" id="po-nc-value" inputmode="decimal" autocomplete="off" placeholder="0"<%- track('nc_value', '新しい発注条件の値') %><%= D %>><span class="unit" id="po-nc-unit"></span></div></div>
        </div>
      </div></div>

    <div class="f" data-row="order_settings.material_group_id" style="align-items:start"><div class="lab" style="padding-top:8px">原料グループ</div>
      <div class="ctl col" style="gap:8px">
        <%- segPo('po-mat-mode', matMode, [['none', 'なし'], ['pick', '今あるグループ'], ['new', '新しく作る']], '原料グループ') %><% if (noneOn) { %><span class="hint">使わないときは「なし」(= 入力なし)</span><% } %>
        <div id="po-mat-pick"<%= matMode === 'pick' ? '' : ' hidden' %>>
          <input type="search" class="in w-l po-gq" id="po-mat-q" data-for="po-material_group_id" autocomplete="off" spellcheck="false" placeholder="🔍 名前・ID で絞る (例: ダウン)" aria-label="原料グループを名前・ID で絞る" aria-controls="po-material_group_id" style="margin-bottom:6px"<%= D %>>
          <div class="hint" id="po-mat-q-n" role="status" aria-live="polite" hidden></div>
          <select class="in w-l" id="po-material_group_id" aria-label="原料グループを選ぶ"<%- track('material_group_id', '原料グループ') %><%= D %>>
            <option value="">(選ぶ)</option>
            <% for (const m of d.materials) { %><option value="<%= m.id %>"<%= m.id === cur.material_group_id ? ' selected' : '' %>><%= m.id %> — <%= m.name %><%= m.min != null ? ' (最低 ' + m.min + (m.unit || '') + ')' : '' %></option><% } %>
          </select>
          <div class="hint">自社で作る商品の原料 (同じ原料を使う商品をまとめて最低発注量を見る)</div>
        </div>
        <div class="po-sub" id="po-mat-new"<%= matMode === 'new' ? '' : ' hidden' %>>
          <div class="ttl"><svg class="ic" style="color:var(--accent)" aria-hidden="true"><use href="#i-plus"/></svg>新しい原料グループ</div>
          <div class="f" data-row="order_settings.new_material.name"><label class="lab" for="po-nm-name">名前</label><div class="ctl"><input class="in w-m" id="po-nm-name" maxlength="100" autocomplete="off" placeholder="例: 木工用オレンジオイル"<%- track('nm_name', '新しい原料グループの名前') %><%= D %>></div></div>
          <div class="f" data-row="order_settings.new_material.group_id"><label class="lab" for="po-nm-id">ID</label><div class="ctl"><input class="in w-m mono" id="po-nm-id" maxlength="64" autocomplete="off" spellcheck="false" placeholder="例: orange-oil"<%- track('nm_id', '新しい原料グループの ID') %><%= D %>><span class="hint">あとで変えられません</span></div></div>
          <div class="f" data-row="order_settings.new_material.min_order_qty"><label class="lab" for="po-nm-min">最低発注量</label><div class="ctl"><input class="in w-s" id="po-nm-min" inputmode="decimal" autocomplete="off" placeholder="空 = なし"<%- track('nm_min', '最低発注量') %><%= D %>>
            <input class="in" style="width:70px" id="po-nm-unit" maxlength="20" autocomplete="off" placeholder="単位" aria-label="最低発注量の単位"<%- track('nm_unit', '最低発注量の単位') %><%= D %>></div></div>
        </div>
      </div></div>

    <details class="more"<%= cur.case_lot != null || cur.case_group || cur.capacity_per_unit != null ? ' open' : '' %>>
      <summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>ケース・容量 (使う商品だけ)</summary>
      <div class="body">
        <% if (noneOn) { %><div class="hint" style="padding:4px 0 6px">使わない商品は、欄ごとに「入力なし」を押します</div><% } %>
        <div class="f" data-row="order_settings.case_lot"><label class="lab" for="po-case_lot">ケースロット</label><div class="ctl"><input class="in w-s" id="po-case_lot" inputmode="numeric" autocomplete="off" placeholder="—" value="<%= num(cur.case_lot) %>"<%- track('case_lot', 'ケースロット') %><%- part('case_lot') %><%= D %>><span class="unit">個 / ケース</span><%- none('case_lot', 'ケースロット') %><span class="hint">ケース単位で発注する仕入先だけ · 発注の計算に使う弊社の個数 (「先方 1 単位 = 弊社 n 個」の入数・箱に何個入っているかとは別)</span></div></div>
        <div class="f" data-row="order_settings.case_group"><label class="lab" for="po-case_group">ケースグループ</label><div class="ctl"><input class="in w-m" id="po-case_group" maxlength="100" autocomplete="off" placeholder="—" value="<%= cur.case_group || '' %>"<%- track('case_group', 'ケースグループ') %><%- part('case_group') %><%= D %>><%- none('case_group', 'ケースグループ') %><span class="hint">同じケースに混ぜて入れられる商品に同じ名前</span></div></div>
        <div class="f" data-row="order_settings.capacity_per_unit"><label class="lab" for="po-capacity_per_unit">容量 / 個</label><div class="ctl"><input class="in w-s" id="po-capacity_per_unit" inputmode="decimal" autocomplete="off" placeholder="—" value="<%= num(cur.capacity_per_unit) %>"<%- track('capacity_per_unit', '容量/個') %><%- part('capacity_per_unit') %><%= D %>><%- none('capacity_per_unit', '容量 / 個') %><span class="hint">原料グループの最低発注量を見るとき (例: 100ml の商品 = 100)</span></div></div>
      </div>
    </details>

    <% if (mode === 'sku' && !ro) { %>
    <div class="po-foot">
      <span class="hint">発注アプリに保存されます (Company DB の「保存する」とは別) · ほかの人が先に直していたら保存せずに知らせます</span>
      <span class="msgline" id="po-msg" role="status" aria-live="polite"></span>
      <button class="btn pri" type="button" id="po-save" disabled>発注の設定を保存</button>
    </div>
    <% } %>
    <% if (vendorNewOn) { %>
    <%# 新商品の登録 (単品): 代表の仕入先の先方品番・入数 (任意・「入力なし」には数えない)。下書きの保存と一緒に送る = 知らせ v2 で発注アプリへ %>
    <div class="po-sub" id="po-vendor" style="margin-top:12px">
      <div class="ttl"><svg class="ic" aria-hidden="true"><use href="#i-tag"/></svg>先方品番・入数 (代表の仕入先・使う仕入先だけ)</div>
      <div class="f" data-row="order_settings.vendor_code"><label class="lab" for="po-vendor_code">先方品番</label><div class="ctl"><input class="in w-m mono" id="po-vendor_code" maxlength="100" autocomplete="off" spellcheck="false" placeholder="例: AC-1234"<%- track('vendor_code', '先方品番') %><%= D %>><span class="hint">仕入先の品番 (発注書の CSV・出荷明細の番号)。使わない仕入先は空のまま</span></div></div>
      <div class="f" data-row="order_settings.qty_per_unit"><label class="lab" for="po-qty_per_unit">入数</label><div class="ctl"><span class="unit">先方 1 単位 = 弊社</span><input class="in w-s" id="po-qty_per_unit" inputmode="decimal" autocomplete="off" placeholder="1"<%- track('qty_per_unit', '入数 (先方 1 単位 = 弊社 n 個)') %><%= D %>><span class="unit">個</span><span class="hint">入荷予定の換算 (出荷明細の数 × この数) · 空 = 1 · ケースロット・箱の入数とは別</span></div></div>
    </div>
    <% } %>
    <% if (vs && vs.canSee) { %>
    <%# 商品の画面: 先方品番・入数 (仕入先ごと・発注アプリの対応表 = 正本を直接読む)。1 行ずつ「保存」「消す」= 発注の設定の保存とは別 %>
    <div class="po-sub" id="po-vendor" style="margin-top:14px" data-can-write="<%= vCanWrite ? '1' : '' %>">
      <div class="ttl"><svg class="ic" aria-hidden="true"><use href="#i-tag"/></svg>先方品番・入数 (仕入先ごと)<span class="right" style="margin-left:auto"><a class="hint" href="/apps/purchase-orders/admin?grp=vendormap<%= vEditable.supplier ? '&sup=' + encodeURIComponent(vEditable.supplier) : '' %>" target="_blank" rel="noopener">対応表で見る <svg class="ic s" style="vertical-align:-2px" aria-hidden="true"><use href="#i-ext"/></svg></a></span></div>
      <div class="hint" style="padding-bottom:6px">入数 = 先方 1 単位 (出荷明細の数 1) が弊社の何個か (入荷予定の換算・空 = 1)。発注のケースロット・箱に何個入っているかとは別です。1 行ずつ保存します (ほかの人が先に直していたら保存せずに知らせます)。</div>
      <% if (!vs.data || !vs.data.ok) { %>
        <div class="callout err"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= vs.why || '発注アプリの先方番号対応表を読めません' %></div></div>
      <% } else { %>
        <% if (!vCanWrite && vs.why) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">見るだけです: <%= vs.why %></div></div><% } %>
        <% if (vEditable.error) { %><div class="callout info" id="po-vendor-why"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow">先方品番を足す・直すことはできません: <%= vEditable.error %></div></div><% } %>
        <% if (vEditable.supplier && vPrimary && vPrimary !== vEditable.supplier) { %><div class="callout warn" id="po-vendor-supdiff"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow">代表の仕入先 (<%= vPrimary %>) と商品管理リストの仕入先 (<%= vEditable.supplier %>) が違います。直せるのは発注アプリと同じ <%= vEditable.supplier %> の行です (NE に届くと揃います)。</div></div><% } %>
        <% const showRows = vRows.slice(); if (vEditable.supplier && !vRows.some((r) => r.supplier_code === vEditable.supplier)) showRows.push({ supplier_code: vEditable.supplier, vendor_code: '', qty_per_unit: null, updated_at: null, add: true }); %>
        <% if (!showRows.length) { %><div class="hint" id="po-vendor-none">対応表にこの商品の行はありません</div><% } %>
        <% for (const r of showRows) { const si = vSup(r.supplier_code); const mine = !!vEditable.supplier && r.supplier_code === vEditable.supplier; const w = vCanWrite && mine; %>
        <div class="f po-vrow" data-sup="<%= r.supplier_code %>" data-base="<%= r.updated_at || '' %>" data-mine="<%= mine ? '1' : '' %>" style="align-items:start">
          <div class="lab" style="padding-top:8px"><span class="mono"><%= r.supplier_code %></span> <%= si.name %></div>
          <div class="ctl col" style="gap:6px">
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
              <input class="in w-m mono po-v-code" maxlength="100" autocomplete="off" spellcheck="false" placeholder="<%= r.add ? '先方品番 (まだ無い)' : '先方品番' %>" aria-label="先方品番 (<%= r.supplier_code %>)" value="<%= r.vendor_code || '' %>"<%= w ? '' : ' disabled' %>>
              <span class="unit">先方 1 単位 = 弊社</span><input class="in w-s po-v-qpu" inputmode="decimal" autocomplete="off" placeholder="1" aria-label="入数 (<%= r.supplier_code %>・先方 1 単位 = 弊社 n 個)" value="<%= r.qty_per_unit == null ? '' : r.qty_per_unit %>"<%= w ? '' : ' disabled' %>><span class="unit">個</span>
              <% if (w) { %><button class="btn pri sm po-v-save" type="button" disabled><%= r.add ? '足す' : '保存' %></button><% } %>
              <% if (vCanWrite && !r.add) { %><button class="btn soft sm po-v-del" type="button">消す</button><% } %>
            </div>
            <% if (!mine && !r.add) { %><span class="hint">この商品の仕入先 (発注アプリの決まり) ではないので直せません · 古い行なら「消す」</span><% } %>
            <% if (si.lead_days != null) { %><span class="hint po-v-lead">標準リードタイム <%= si.lead_days %> 日 (仕入先の値・<a href="/apps/purchase-orders/admin?grp=suppliers" target="_blank" rel="noopener">発注アプリの仕入先</a>)</span><% } %>
            <span class="msgline po-v-msg" role="status" aria-live="polite"></span>
          </div>
        </div>
        <% } %>
        <% if (vs.data.pending.length) { %>
        <div class="callout info" id="po-vendor-pending"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow">仮登録 (出荷明細で見た、まだ結んでいない番号) があります:
          <% for (const p of vs.data.pending) { %><span class="linkchip"><span class="mono"><%= p.supplier_code %></span> <span class="mono"><%= p.vendor_code %></span><%= p.vendor_name ? ' ' + p.vendor_name : '' %><%= p.provisional_qty_per_unit ? ' (入数 ' + p.provisional_qty_per_unit + ')' : '' %></span><% } %>
          · 結ぶのは <a href="/apps/purchase-orders/admin?grp=vendormap" target="_blank" rel="noopener">発注アプリの対応表</a> で (自動では結びません)</div></div>
        <% } %>
      <% } %>
    </div>
    <% } else if (vs && !vs.canSee) { %>
    <div class="hint" id="po-vendor" style="margin-top:12px">先方品番・入数: <%= vs.why %></div>
    <% } %>
    <script type="application/json" id="me-order"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
  <% } %>
</section>
