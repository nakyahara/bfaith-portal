<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
  <%- include('_header') %>
  <%
    const ENT = { sku: 'SKU', product: '商品', sku_component: '構成', sku_cost: '原価', supplier_sku: '仕入先ごとの商品' };
    const OP = { INSERT: '追加', UPDATE: '変更', DELETE: '削除' };
    const WHO = { portal_master_edit: 'マスタの入力', company_db_load: '夜間ロード', sql: 'SQL' };
    const val = (v) => (v === null || v === undefined ? '' : typeof v === 'object' ? JSON.stringify(v) : String(v));
  %>
  <div class="me-wrap">
    <p class="muted" style="font-size: 0.85em;"><a href="<%= base %>/">← 一覧へ</a><% if (h) { %> ・ <a href="<%= base %>/sku/<%= encodeURIComponent(h.sku.code) %>">← <%= h.sku.code %> へ</a><% } %></p>
    <% if (dbError) { %><div class="band err"><%= dbError %></div><% } %>
    <% if (h) { %>
    <h2 style="font-size: 1.1em;"><%= h.sku.code %> の変更の記録 <span class="muted" style="font-size: 0.8em;"><%= h.sku.name %></span></h2>
    <p class="muted" style="font-size: 0.85em;">新しい順に 200 件まで。誰が (人のメール / 夜間ロード) ・どこから・なぜ、を DB のトリガーが同じ取引で残しています。</p>
    <div class="tbox">
      <table class="me">
        <thead><tr><th>時刻</th><th>対象</th><th>操作</th><th>項目</th><th>前</th><th>後</th><th>誰が</th><th>どこから</th><th>理由</th></tr></thead>
        <tbody>
          <% if (!h.events.length) { %><tr><td colspan="9" class="muted">記録はまだありません</td></tr><% } %>
          <% for (const e of h.events) { %>
          <tr>
            <td style="white-space: nowrap;"><%= String(e.recorded_at).slice(0, 19) %></td>
            <td><%= ENT[e.entity_type] || e.entity_type %></td>
            <td><%= OP[e.operation] || e.operation %></td>
            <td><%= e.attribute || '' %></td>
            <td style="max-width: 260px; word-break: break-all;"><%= val(e.old_value) %></td>
            <td style="max-width: 260px; word-break: break-all;"><%= val(e.new_value) %></td>
            <td><%= e.actor_id || e.actor_type %></td>
            <td><%= WHO[e.source_system] || e.source_system %></td>
            <td><%= e.reason_text || '' %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (h.requests.length) { %>
    <h3 style="font-size: 1em; margin-top: 16px;">構成の依頼</h3>
    <div class="tbox">
      <table class="me">
        <thead><tr><th>依頼した時刻</th><th>依頼した構成</th><th>状態</th><th>依頼した人</th><th>理由</th><th>閉じた時刻</th></tr></thead>
        <tbody>
          <% for (const r of h.requests) { %>
          <tr>
            <td style="white-space: nowrap;"><%= String(r.created_at).slice(0, 19) %></td>
            <td><%= (r.rows || []).map((x) => x.code + '×' + x.qty).join(', ') %></td>
            <td><%= r.status === 'open' ? '依頼中' : r.status === 'applied' ? 'NE に入った (閉じた)' : (r.close_reason === 'withdrawn' ? '取り下げ' : '次の依頼で置き換え') %></td>
            <td><%= r.requested_by %></td>
            <td><%= r.reason || '' %></td>
            <td><%= r.closed_at ? String(r.closed_at).slice(0, 19) : '' %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
    <% } %>
  </div>
</body>
</html>
