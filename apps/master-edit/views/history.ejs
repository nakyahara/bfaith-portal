<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
  <%- include('_header') %>
  <%
    // 人の言葉 (列の名前・JSON を出さない)・時刻は日本時間 (apps/master-edit/ui-format.mjs)。見て分かる項目が無い行 (version だけ など) は数えない
    const rows = h ? h.events.map((e) => ({ e, w: ui.eventWords(e) })).filter((x) => x.w) : [];
  %>
  <div class="me-wrap">
    <p class="muted" style="font-size: 0.85em;"><a href="<%= base %>/">← 一覧へ</a><% if (h) { %> ・ <a href="<%= base %>/sku/<%= encodeURIComponent(h.sku.code) %>">← <%= h.sku.code %> へ</a><% } %></p>
    <% if (dbError) { %><div class="band err"><%= dbError %></div><% } %>
    <% if (h) { %>
    <h2 style="font-size: 1.1em;"><%= h.sku.code %> の変更の記録 <span class="muted" style="font-size: 0.8em;"><%= h.sku.name %></span></h2>
    <p class="muted" style="font-size: 0.85em;">新しい順に 200 件まで。時刻は日本時間。誰が (人のメール / 夜間の取り込み) ・どこから・なぜ、を DB のトリガーが同じ取引で残しています。</p>
    <div class="tbox">
      <table class="me">
        <thead><tr><th>時刻 (日本時間)</th><th>何を</th><th>前</th><th>後</th><th>誰が</th><th>どこから</th><th>理由</th></tr></thead>
        <tbody>
          <% if (!rows.length) { %><tr><td colspan="7" class="muted">記録はまだありません</td></tr><% } %>
          <% for (const { e, w } of rows) { %>
          <tr>
            <td style="white-space: nowrap;"><%= ui.fmtJst(e.recorded_at, { nowMs }) %></td>
            <td><%= w.what %></td>
            <td style="max-width: 260px; word-break: break-all;"><%= w.from %></td>
            <td style="max-width: 260px; word-break: break-all;"><%= w.to %></td>
            <td><%= ui.actorWords(e) %></td>
            <td><%= ui.sourceWords(e.source_system) %></td>
            <td><%= e.reason_text || '' %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (h.requests.length) { %>
    <h3 style="font-size: 1em; margin-top: 16px;">構成の依頼</h3>
    <div class="tbox">
      <table class="me">
        <thead><tr><th>依頼した時刻</th><th>依頼した構成</th><th>状態</th><th>依頼した人</th><th>理由</th><th>閉じた時刻</th></tr></thead>
        <tbody>
          <% for (const r of h.requests) { %>
          <tr>
            <td style="white-space: nowrap;"><%= ui.fmtJst(r.created_at, { nowMs }) %></td>
            <td><%= (r.rows || []).map((x) => x.code + '×' + x.qty).join(', ') %></td>
            <td><%= r.status === 'open' ? '依頼中' : r.status === 'applied' ? 'NE に入った (閉じた)' : (r.close_reason === 'withdrawn' ? '取り下げ' : '次の依頼で置き換え') %></td>
            <td><%= r.requested_by %></td>
            <td><%= r.reason || '' %></td>
            <td><%= r.closed_at ? ui.fmtJst(r.closed_at, { nowMs }) : '' %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
    <% } %>
  </div>
</body>
</html>
