<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
<%
  // 1 つの seller SKU (新しいデザイン・第 2 段 10/5)。左 = Amazon の情報 (見るだけ)・構成 (1 行目が代表)・削除 (下に分けて理由が必須) / 右 = 保存すると変わること。
  // 保存・削除の送り方 (POST /api/amazon/save・/api/amazon/delete) は前と同じ。画面の動き = public/me-amazon.js
  const cur = page ? page.cur : null;
  const map = cur ? cur.map : null;
  const deleted = !!map && map.state === 'deleted';
  const canSave = !!page && canEdit && !dbError && !amazonClosed;
  const dis = canSave ? '' : ' disabled';
  const RES = { manual: '人', imported: 'SKU マスタから', exact: 'FBM の完全一致', normalized: 'FBM の完全一致 (正規化)', map: '対応表' };
  const REG = { draft: '下書き', ne_pending: 'NE登録待ち', ne_confirmed: 'NE確認済み', distributable: '配る対象', available: '登録済み', quarantined: '要確認', cancelled: 'やめた' };
  const REG_BADGE = { draft: 'warn', ne_pending: 'warn', ne_confirmed: 'ok', distributable: 'ok', available: 'ok', quarantined: 'err', cancelled: 'mute' };
  const startRows = cur ? (deleted ? [] : cur.components) : [];
  const startName = map ? map.name : (cur && cur.listing && cur.listing.title) || '';
  const title = map ? map.name : (cur && cur.listing && cur.listing.title) || '';
  const iconBtns = (i, code) => { const who = i + ' 行目' + (code ? ' (' + code + ')' : ''); return '<button type="button" class="iconbtn" data-act="up" aria-label="' + who + ' を上へ"' + dis + '><svg class="ic s" aria-hidden="true"><use href="#i-up"/></svg></button><button type="button" class="iconbtn" data-act="down" aria-label="' + who + ' を下へ"' + dis + '><svg class="ic s" aria-hidden="true"><use href="#i-down"/></svg></button><button type="button" class="iconbtn del" data-act="del" aria-label="' + who + ' を外す"' + dis + '><svg class="ic s" aria-hidden="true"><use href="#i-trash"/></svg></button>'; };
  const pageData = page ? { base, sku, canSave, maxComponents: MAX_MAP_COMPONENTS, maxQty: MAX_MAP_QTY, isNew: !map, deleted } : null;
%>
  <%- include('_header', { hasSave: canSave }) %>
  <div class="page" id="amazon-sku-page">
    <nav class="crumb" aria-label="いまの場所"><a href="<%= base %>/amazon/" data-list-back>Amazon SKU</a><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg><span class="mono" aria-current="page"><%= sku %></span></nav>
    <% if (dbError) { %><div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t"><%= dbError %></div><div class="hint">つながったら画面を開き直してください。</div></div></div><% } %>
    <% if (page) { %>
    <div class="ph" id="sku-ph">
      <div>
        <div class="idrow">
          <span class="code-pill"><%= sku %></span>
          <span class="b <%= page.channel === 'FBM' ? 'vio' : 'mute' %>"><%= page.channel ? (CHANNELS[page.channel] || page.channel) : 'FBA / FBM 分からない' %></span>
          <% if (!map) { %><span class="b warn">対応なし</span><% } else if (deleted) { %><span class="b mute"><%= MAP_STATES[map.state] || map.state %></span><% } else { %><span class="b ok"><span class="dot" aria-hidden="true"></span><%= MAP_STATES[map.state] || map.state %></span><% } %>
          <% if (map && map.origin === 'legacy') { %><span class="b mute">切替の日の移行</span><% } %>
        </div>
        <h1><%= title || (map ? sku : '新しい対応') %></h1>
        <div class="meta">
          <% if (page.lastRequest) { %><span>最後に保存した人 <%= page.lastRequest.actor_id %></span><span class="dotsep" aria-hidden="true"></span><span><%= ui.fmtJst(page.lastRequest.finished_at, { nowMs }) %></span><% } else if (map) { %><span>変えた <%= ui.fmtJst(map.changed_at, { nowMs }) %> · <%= map.changed_by || '' %></span><% } else { %><span>まだ Company DB に対応がありません</span><% } %>
        </div>
      </div>
      <div class="ph-actions"><% if (cur.listing) { %><a class="btn" href="<%= base %>/amazon/sku/history?sku=<%= encodeURIComponent(sku) %>"><svg class="ic" aria-hidden="true"><use href="#i-history"/></svg>変更の記録</a><% } %></div>
    </div>

    <% if (amazonClosed) { %><div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow"><div class="t">いまは保存できません (<%= amazonClosedWhy %>)</div><div class="hint">見るだけです。切替日までは、この SKU の対応の正は miniPC の SKU マスタ (/apps/warehouse の「SKUマスタ」) です。</div></div></div><% } %>
    <% if (!canEdit) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= gateMessage %></div></div><% } %>
    <% if (!map) { %>
      <div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><div class="t">この seller SKU の対応は Company DB にまだありません</div><div class="hint"><% if (cur.components.length) { %>下の構成は夜間の取り込みが作った今の構成 (miniPC の SKU マスタ・FBM の完全一致から) です。<% } %>保存すると、この seller SKU の対応を新しく作ります。</div></div></div>
    <% } else if (deleted) { %>
      <div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-trash"/></svg><div class="grow"><div class="t">削除済み (墓標) です</div><div class="hint"><%= ui.fmtJst(map.deleted_at, { nowMs }) %> · <%= map.deleted_by %> 「<%= map.deleted_reason %>」。夜間の取り込みはこの出品の構成を作り直しません。保存すると、同じ seller SKU をもう一度登録します (登録日は新しくなります)。</div></div></div>
    <% } %>

    <form class="edit" id="f" novalidate data-base="<%= base %>" data-sku="<%= sku %>" data-versions="<%= JSON.stringify(cur.versions) %>" data-can-save="<%= canSave ? '1' : '0' %>">
      <div>
        <section class="panel soft" aria-labelledby="h-listing">
          <div class="panel-h"><span class="hico" aria-hidden="true" style="color:var(--text2);background:rgba(255,255,255,.05)"><svg class="ic"><use href="#i-lock"/></svg></span><h2 id="h-listing">出品 (Amazon の情報)</h2><span class="sub">見るだけ · 夜間の取り込みが入れます</span></div>
          <% if (cur.listing) { %>
          <div class="listing">
            <div><div class="k">タイトル</div><div class="v"><%= cur.listing.title || '—' %></div></div>
            <div><div class="k">ASIN</div><div class="v mono"><%= cur.listing.asin || '—' %></div></div>
            <div><div class="k">FNSKU</div><div class="v<%= cur.fnsku ? ' mono' : ' muted' %>"><%= cur.fnsku || 'まだ無い' %></div></div>
            <div><div class="k">出品の状態</div><div class="v"><%= cur.listing.status %></div></div>
            <div><div class="k">出品のコード</div><div class="v mono"><%= cur.listing.listing_code %></div></div>
            <% if (map) { %><div><div class="k">対応を登録</div><div class="v"><%= ui.fmtJst(map.registered_at, { nowMs }) %> · <%= map.registered_by || '' %></div></div><% } %>
            <% if (page.related.length) { %><div style="grid-column:1 / -1"><div class="k">同じ NE の商品を使う seller SKU</div><div class="v"><% for (const r of page.related) { %><a class="linkchip" href="?sku=<%= encodeURIComponent(r.seller_sku) %>" title="<%= r.name %>"><span class="mono"><%= r.seller_sku %></span></a><% } %></div></div><% } %>
          </div>
          <% } else { %>
          <div class="hint">Company DB にこの seller SKU の出品はまだありません。保存すると出品も作ります (ASIN・FNSKU は夜間の取り込みが付けます)。</div>
          <% } %>
        </section>

        <section class="panel" aria-labelledby="h-comp">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-box"/></svg></span><h2 id="h-comp"><%= !map ? '新しい対応' : deleted ? 'もう一度登録する' : '対応を直す' %></h2><span class="sub">この SKU 1 個 = 下の NE の商品 × 数</span></div>
          <div class="f" data-row="name"><label class="lab" for="name">名前 (社内)</label><div class="ctl"><input class="in w-l" id="name" value="<%= startName %>" maxlength="255" autocomplete="off" data-dirty-field="name" data-label="名前 (社内)"<%= dis %>></div></div>
          <div class="f wide" data-row="components">
            <div class="scrollx"><table class="comp" id="comp" data-dirty-field="components" data-label="構成"><caption class="sr">構成 (コードを打つと名前が出ます・1 行目が代表)</caption>
              <thead><tr><th scope="col">#</th><th scope="col">NE の商品 (コードを打つと名前が出ます)</th><th scope="col">数</th><th scope="col">登録の状態</th><th scope="col">どこから</th><th scope="col"><span class="sr">並べ替え・外す</span></th></tr></thead>
              <tbody id="comp-rows">
                <% startRows.forEach((c, i) => { %>
                <tr class="comp-row">
                  <td class="no"><%= i + 1 %></td>
                  <td><input class="in mono c-code" style="width:150px" value="<%= c.code %>" autocomplete="off" spellcheck="false" aria-label="<%= i + 1 %> 行目の NE コード"<%= dis %>> <span class="c-name"><%= c.name %><%= c.sku_kind === 'exception' ? ' (例外の SKU)' : '' %></span><% if (i === 0) { %><span class="repbadge">代表</span><% } %></td>
                  <td><input class="in c-qty" style="width:70px;text-align:right" inputmode="numeric" autocomplete="off" value="<%= c.qty %>" aria-label="<%= i + 1 %> 行目 (<%= c.code %>) の数"<%= dis %>></td>
                  <td class="c-reg"><% if (c.reg_state) { %><span class="b <%= REG_BADGE[c.reg_state] || 'mute' %>"><%= REG[c.reg_state] || c.reg_state %></span><% } else { %><span class="muted">—</span><% } %></td>
                  <td class="hint"><%= RES[c.resolution] || c.resolution %></td>
                  <td class="acts"><%- iconBtns(i + 1, c.code) %></td>
                </tr>
                <% }) %>
              </tbody>
            </table></div>
            <template id="comp-tpl"><tr class="comp-row"><td class="no"></td><td><input class="in mono c-code" style="width:150px" autocomplete="off" spellcheck="false" placeholder="NE コード" aria-label="NE コード"> <span class="c-name"></span></td><td><input class="in c-qty" style="width:70px;text-align:right" inputmode="numeric" autocomplete="off" value="1" aria-label="数"></td><td class="c-reg"></td><td class="hint">人</td><td class="acts"><%- iconBtns('', '') %></td></tr></template>
            <div style="display:flex;gap:12px;align-items:center;margin-top:6px;flex-wrap:wrap"><button class="btn sm" type="button" id="comp-add"<%= dis %>><svg class="ic s" aria-hidden="true"><use href="#i-plus"/></svg>NE の商品を足す</button>
              <span class="hint">1 行目が代表 (↑↓ で並べ替え) · 1〜<%= MAX_MAP_COMPONENTS %> 行 · 数は 1〜<%= MAX_MAP_QTY %> · NE で確かめた商品 (NE確認済み・登録済み) だけ使えます</span></div>
          </div>
        </section>

        <% if (map && !deleted) { %>
        <details class="danger-zone" id="del-box">
          <summary><svg class="ic" aria-hidden="true"><use href="#i-trash"/></svg>この対応を削除する (墓標にする)</summary>
          <div style="margin-top:10px" class="hint">構成を全部外して「削除済み」にします。行は消えずに残り、夜間の取り込みもこの出品の構成を作り直しません。同じ seller SKU はあとでもう一度登録できます。1 件ずつ・理由が要ります。</div>
          <div class="f"><label class="lab" for="del-reason">理由<span class="req">必須</span></label>
            <div class="ctl"><input class="in w-l" id="del-reason" maxlength="200" autocomplete="off" placeholder="なぜ削除するか (例: 3 個組の出品をやめる)"<%= dis %>><button class="btn danger" type="button" id="del" disabled>削除する</button></div></div>
          <div class="msgline" id="del-msg" role="status" aria-live="polite"></div>
        </details>
        <% } %>
      </div>

      <aside class="side" aria-label="保存">
        <section class="panel savebox hud" id="savebox" aria-labelledby="h-save" tabindex="-1">
          <div class="mobilebar"><span class="grow"><b class="mb-n">未保存の変更はありません</b></span><button class="btn soft sm" type="button" id="savebox-toggle" aria-expanded="false" aria-controls="savebox">確認して保存</button></div>
          <div class="panel-h" style="margin-bottom:10px"><h2 id="h-save">保存すると変わること</h2><span class="right"><span class="b mute count" id="save-count">0 件</span></span></div>
          <ul class="diff" id="save-diff" aria-live="polite"></ul>
          <div class="empty" id="save-empty"><% if (canSave) { %>まだ何も変えていません。<br>古い表 (miniPC の SKU マスタ) と FBA 補充には、翌朝 7:00 の写しで届きます。<% } else { %>この画面ではいま保存できません。<% } %></div>
          <div class="impact" id="save-impact" hidden><div class="it">保存するとこうなる</div><ul id="save-impact-list"></ul></div>
          <% if (canSave) { %>
          <label class="lab2" for="reason">理由 (なくてもよい)</label>
          <input class="in" id="reason" maxlength="200" autocomplete="off" placeholder="例: ギフトの中身を変えた">
          <button class="btn pri lg block" id="save" disabled type="button" aria-keyshortcuts="Control+S">保存する <span class="kbd" aria-hidden="true">Ctrl</span><span class="kbd" aria-hidden="true">S</span></button>
          <div class="below"><button class="btn ghost sm" type="button" id="revert" disabled><svg class="ic s" aria-hidden="true"><use href="#i-undo"/></svg>変更を元に戻す</button><span>通信が切れて押し直しても大丈夫</span></div>
          <% } %>
          <div class="msgline" id="msg" role="status" aria-live="polite"></div>
          <div id="result" aria-live="polite"></div>
        </section>
      </aside>
    </form>
    <% if (map && !deleted && canSave) { %>
    <div class="modal-bg" id="del-bg">
      <div class="modal danger" role="alertdialog" aria-modal="true" aria-labelledby="del-t" aria-describedby="del-d">
        <h2 id="del-t"><svg class="ic l" aria-hidden="true"><use href="#i-trash"/></svg><span class="mono"><%= sku %></span> の対応を削除します</h2>
        <div class="hint" id="del-d" style="color:var(--text2)">構成は全部外れ、「削除済み (墓標)」になります。古い表と FBA 補充には翌朝 7:00 の写しで届きます。</div>
        <ul><li>理由: <span id="del-why"></span></li></ul>
        <div class="mbtns"><button class="btn ghost" type="button" id="del-stay">やめる</button><button class="btn danger" type="button" id="del-go">削除する</button></div>
      </div>
    </div>
    <% } %>
    <script type="application/json" id="me-amazon"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
    <% } %>
  </div>
  <%- include('_footer') %>
  <% if (page) { %><script src="<%= base %>/public/me-amazon.js?v=<%= assetV %>" defer></script><% } %>
</body>
</html>
