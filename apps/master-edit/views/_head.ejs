<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <%# この画面だけのファビコン (箱 = 商品・画面の色)。SVG を読めないブラウザは上の共通の PNG のまま %>
  <link rel="icon" type="image/svg+xml" href="<%= locals.base || '/apps/master-edit' %>/public/favicon.svg?v=<%= locals.assetV || '' %>">
<% if (locals.ui2) { %>
  <%# 新しいデザイン (一覧・1 つの商品・つかいかた・誤り)。CSS はこの画面だけのもの 1 つ (ポータル共通の style.css は読まない = 色がぶつからない) %>
  <meta name="color-scheme" content="dark">
  <link rel="stylesheet" href="<%= base %>/public/master-edit.css?v=<%= assetV %>">
  <script src="<%= base %>/public/me-shell.js?v=<%= assetV %>" defer></script>
<% } else { %>
  <%# まだ作り直していない画面 (新商品・NE 登録の CSV・Amazon・変更の記録) は今までの見た目のまま (第 2 段で作り直す) %>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .me-wrap { max-width: 1280px; margin: 0 auto; padding: 12px 16px 60px; }
    .me-box { background: #f8f9fa; border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; }
    .me-box p.hint { font-size: 0.86em; color: #495057; margin: 0; line-height: 1.6; }
    .band { border-radius: 6px; padding: 8px 12px; margin-bottom: 10px; font-size: 0.9em; line-height: 1.5; }
    .band.err { background: #ffe3e3; color: #a61e1e; border: 1px solid #ffa8a8; }
    .band.warn { background: #fff3bf; color: #7a5a00; border: 1px solid #ffe066; }
    .band.info { background: #e7f5ff; color: #1864ab; border: 1px solid #a5d8ff; }
    .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; font-size: 0.9em; }
    .row select, .row input { padding: 5px 6px; font-size: 0.95em; }
    table.me { width: 100%; border-collapse: collapse; font-size: 0.84em; background: #fff; }
    table.me th, table.me td { border-bottom: 1px solid #dee2e6; padding: 5px 6px; text-align: left; vertical-align: top; }
    table.me th { background: #f1f3f5; white-space: nowrap; }
    table.me td.n { text-align: right; white-space: nowrap; }
    .tbox { overflow: auto; border: 1px solid #dee2e6; }
    .muted { color: #868e96; }
    .tag { display: inline-block; padding: 0 6px; border-radius: 8px; font-size: 0.8em; background: #fff3bf; color: #7a5a00; margin-left: 4px; white-space: nowrap; }
    .tag.gray { background: #e9ecef; color: #495057; }
    .flag { display: inline-block; padding: 0 6px; border-radius: 8px; font-size: 0.8em; background: #ffe3e3; color: #a61e1e; margin-right: 3px; white-space: nowrap; }
    .btn-sm { padding: 4px 12px; font-size: 0.88em; cursor: pointer; white-space: nowrap; }
    .btn-sm:disabled { opacity: 0.35; cursor: default; }
    .msg { font-size: 0.9em; margin: 6px 0; white-space: pre-wrap; } .msg.err { color: #c92a2a; } .msg.ok { color: #2b8a3e; }
    .pager { margin: 8px 0; font-size: 0.9em; display: flex; gap: 12px; }
  </style>
<% } %>
