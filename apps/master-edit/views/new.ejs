<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
  <style>
    .sec { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 8px 14px; margin-bottom: 10px; }
    .sec h3 { font-size: 0.95em; margin: 2px 0 8px; color: #343a40; }
    .fl { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 6px; font-size: 0.9em; }
    .fl label.k { color: #495057; min-width: 7em; }
    .fl input[type=text], .fl select, .fl textarea { padding: 4px 6px; font-size: 0.95em; }
    .req::after { content: ' *'; color: #c92a2a; }
    .sub { font-size: 0.82em; color: #868e96; }
    .kinds a { margin-right: 10px; }
    .kinds a.on { font-weight: 700; text-decoration: none; color: #1f2430; }
    #comp input.c-code { width: 11em; } #comp input.c-qty { width: 4em; text-align: right; }
    .bar { position: sticky; bottom: 0; background: #fff; border-top: 2px solid #dee2e6; padding: 8px 0; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .result { background: #fff; border: 1px solid #adb5bd; border-radius: 8px; padding: 8px 14px; margin: 8px 0; font-size: 0.88em; }
    .result li { margin: 2px 0; }
  </style>
</head>
<body>
  <%- include('_header') %>
  <%
    const isSet = kind === 'set';
    const canSave = !!page && canEdit && !dbError && !entryClosed && !!shippingRates;
    const dis = canSave ? '' : ' disabled';
    const SALES = { 1: '1 自社', 2: '2 取引先限定', 3: '3 仕入', 4: '4 輸出' };
  %>
  <div class="me-wrap">
    <p class="sub"><a href="<%= base %>/">← 一覧へ</a> ・ <a href="<%= base %>/manual">📖 つかいかた</a></p>
    <% if (dbError) { %><div class="band err"><%= dbError %></div><% } %>
    <% if (page && entryClosed) { %><div class="band warn">切替前です (<%= entryWhy || ('段階: ' + phaseText) %>): 新商品はまだ NE・product-hub で登録します。この画面は見るだけです (登録を押しても「切替前」で断られ、何も変わりません)。</div><% } %>
    <% if (!canEdit) { %><div class="band info"><%= gateMessage %></div><% } %>
    <% if (page && !shippingRates) { %><div class="band err">送料の表が読めないので、発送方法を選べません (登録できません)。</div><% } %>

    <h2 style="font-size: 1.15em; margin: 6px 0;">新商品の登録</h2>
    <p class="kinds">種類: <a href="?kind=single" class="<%= isSet ? '' : 'on' %>"><%= isSet ? '' : '● ' %>単品</a> <a href="?kind=set" class="<%= isSet ? 'on' : '' %>"><%= isSet ? '● ' : '' %>セット</a>
      <span class="sub">(* = 必ず入れる)</span></p>

    <% if (page) { %>
    <form id="f" onsubmit="return false" data-base="<%= base %>" data-kind="<%= kind %>" data-can-save="<%= canSave ? '1' : '0' %>">
      <div class="sec"><h3>基本</h3>
        <div class="fl"><label class="k req">商品コード</label><input type="text" id="code" size="24" maxlength="30" autocomplete="off"<%= dis %>>
          <button type="button" class="btn-sm" id="code-check"<%= dis %>>確かめる</button>
          <span class="sub" id="code-msg">小文字の英字・数字・- _ だけ (30 字まで)・大文字は使えません・使ったことのないコード</span></div>
        <div class="fl"><label class="k req">名前</label><input type="text" data-field="name" size="60" maxlength="255"<%= dis %>>
          <span class="sub">資材の印 (_白ビ袋 など) は付けない</span></div>
      </div>

      <div class="sec"><h3>お金</h3>
        <div class="fl"><label class="k req">売価</label><input type="text" data-field="standard_price" size="10" placeholder="円"<%= dis %>> 円 <span class="sub">(標準売価・税込)</span></div>
        <% if (!isSet) { %>
        <div class="fl"><label class="k">原価</label><input type="text" id="cost-jpy" size="10" placeholder="円"<%= dis %>> 円
          <span class="sub">今日から</span> 理由 <input type="text" id="cost-reason" size="24" maxlength="200" placeholder="空なら「新商品の登録」"<%= dis %>></div>
        <% } %>
      </div>

      <% if (!isSet) { %>
      <div class="sec"><h3>税・分類・仕入先</h3>
        <div class="fl"><label class="k req">税率</label>
          <label><input type="radio" name="tax_rate" data-field="tax_rate" value="0.08"<%= dis %>> 8%</label>
          <label><input type="radio" name="tax_rate" data-field="tax_rate" value="0.1"<%= dis %>> 10%</label></div>
        <div class="fl"><label class="k">売上分類</label><select data-field="sales_class"<%= dis %>>
          <option value="">(あとで)</option>
          <% for (const [k, v] of Object.entries(SALES)) { %><option value="<%= k %>"><%= v %></option><% } %>
        </select></div>
        <div class="fl"><label class="k">代表の仕入先</label><select data-field="primary_supplier"<%= dis %>>
          <option value="">(あとで)</option>
          <% for (const s of page.activeSuppliers) { %><option value="<%= s.code %>"><%= s.code %> <%= s.name %></option><% } %>
        </select><span class="sub">先方品番・入数・ロットは <a href="/apps/purchase-orders">発注アプリ ↗</a></span></div>
      </div>
      <% } %>

      <div class="sec"><h3>物流</h3>
        <div class="fl"><label class="k req">発送方法</label>
          <% if (shippingRates) { %>
          <select data-field="shipping_code" id="shipping"<%= dis %>>
            <option value="">(選ぶ)</option>
            <% for (const r of shippingRates) { %><option value="<%= r.code %>"><%= r.code %> <%= r.method || '' %> / <%= fmt.yen(r.cost) %> 円</option><% } %>
          </select>
          <span class="sub">送料コード → 方法と金額は送料の表から ・ product-hub の楽天の配送方法は対応表から (無ければカードに「要確認」)</span>
          <% } else { %><span class="tag gray">送料の表が読めません</span><% } %></div>
        <div class="fl"><label class="k">推奨保有月数</label><input type="text" data-field="reorder_months" size="5"<%= dis %>> か月</div>
        <% if (!isSet) { %>
        <div class="fl"><label class="k">ロジザード</label>
          有効期限の管理 <label><input type="radio" name="expiry_managed" data-field="expiry_managed" value="0" checked<%= dis %>> なし</label>
          <label><input type="radio" name="expiry_managed" data-field="expiry_managed" value="1"<%= dis %>> あり</label>
          ・ 入荷日の管理 <label><input type="radio" name="inbound_date_managed" data-field="inbound_date_managed" value="0" checked<%= dis %>> なし</label>
          <label><input type="radio" name="inbound_date_managed" data-field="inbound_date_managed" value="1"<%= dis %>> あり</label>
          <span class="sub">(最初の値だけ。あとはロジザードが正)</span></div>
        <% } %>
      </div>

      <% if (isSet) { %>
      <div class="sec"><h3>構成 <span class="sub">(NE に登録して、NE の構成が同じと確かめたら今の構成になります)</span></h3>
        <table class="me" id="comp">
          <thead><tr><th>#</th><th>構成品</th><th>数量</th><th>税</th><th>分類</th><th>原価</th><th>取扱</th><th></th></tr></thead>
          <tbody id="comp-rows"></tbody>
        </table>
        <template id="comp-tpl"><tr class="comp-row"><td class="no"></td><td><input type="text" class="c-code" placeholder="商品コード"> <span class="c-name sub"></span></td><td><input type="text" class="c-qty" value="1"></td><td class="c-tax"></td><td class="c-sales"></td><td class="c-cost n"></td><td class="c-handling"></td><td><button type="button" class="btn-sm" data-act="up">↑</button><button type="button" class="btn-sm" data-act="down">↓</button><button type="button" class="btn-sm" data-act="del">×</button></td></tr></template>
        <div class="fl" style="margin-top: 6px;"><button type="button" class="btn-sm" id="comp-add"<%= dis %>>+ 構成品</button>
          <span class="sub">1〜<%= MAX_COMPONENTS %> 行・数量 1〜999・同じ品は 1 行・セットは入れられません ・ 並びも入れたとおり</span></div>
        <div class="fl"><label class="k">セット自身の取扱</label>
          <label><input type="radio" name="handling_own" data-field="handling_own" value="active" checked<%= dis %>> 取扱中</label>
          <label><input type="radio" name="handling_own" data-field="handling_own" value="discontinued"<%= dis %>> 中止</label></div>
        <div class="fl"><label class="k">売上分類の上書き</label><select data-field="set_sales_class_override"<%= dis %>>
          <option value="">— (構成品から)</option>
          <% for (const [k, v] of Object.entries(SALES)) { %><option value="<%= k %>"><%= v %></option><% } %>
        </select><span class="sub">構成品から導けないときだけ</span></div>
        <div class="fl"><label class="k">例外原価</label><input type="text" id="xcost-jpy" size="10" placeholder="円"<%= dis %>> 円
          理由 <input type="text" id="xcost-reason" size="24" maxlength="200"<%= dis %>><span class="sub">空なら構成品の原価の合計</span></div>
      </div>
      <% } %>

      <div class="sec"><h3>product-hub の出品カード</h3>
        <div class="fl"><label><input type="checkbox" id="card-create" checked<%= dis %>> 出品カードを作る (保存すると product-hub のボードにカードができます)</label></div>
        <div class="fl"><label class="k">公式ページ URL</label><input type="text" id="official-url" size="60" placeholder="https://..."<%= dis %>></div>
        <div class="fl"><label class="k">Amazon URL</label><input type="text" id="amazon-url" size="60" placeholder="https://..."<%= dis %>></div>
        <div class="fl"><label class="k">ASIN</label><input type="text" id="asin" size="14" maxlength="10" placeholder="B0XXXXXXXX"<%= dis %>></div>
        <div class="fl"><label class="k">参考 URL</label><textarea id="ref-urls" rows="3" cols="60" placeholder="1 行に 1 つ (<%= MAX_REFERENCE_URLS %> 個まで)"<%= dis %>></textarea></div>
        <% if (!isSet) { %>
        <div class="fl"><label class="k">セット商品を作るか</label>
          <% for (const [k, v] of Object.entries(setPlanChoices)) { %><label><input type="radio" name="set_plan" value="<%= k %>"<%= dis %>> <%= v %></label><% } %>
          <label><input type="radio" name="set_plan" value="" checked<%= dis %>> まだ決めない</label></div>
        <div class="fl"><label class="k">作らない理由</label><select id="set-reason"<%= dis %>>
          <option value="">(作らないときに選ぶ)</option>
          <% for (const [k, v] of Object.entries(setDecisionReasons)) { %><option value="<%= k %>"><%= v %></option><% } %>
        </select> メモ <input type="text" id="set-text" size="30" maxlength="500" placeholder="その他の理由・保留のメモ"<%= dis %>></div>
        <% } %>
      </div>

      <div class="sec"><h3>Yahoo!向け追記</h3>
        <div class="fl"><label class="k">Yahoo!売価</label><input type="text" id="y-price" size="10" inputmode="numeric"<%= dis %>> 円
          <label class="k" style="min-width: auto;">Yahoo!売価 (佐川)</label><input type="text" id="y-price-sagawa" size="10" inputmode="numeric"<%= dis %>> 円
          <span class="sub">1 円以上 (決めていなければ空のまま・0 は入れない)</span></div>
        <div class="fl"><label class="k">配送方法</label><select id="y-delivery"<%= dis %>>
          <option value="">(楽天と同じ)</option>
          <% for (const d of yahooDeliveries) { %><option value="<%= d %>"><%= d %></option><% } %>
        </select><span class="sub">楽天と違う配送にするときだけ</span></div>
        <div class="fl"><label class="k">Yahoo!カテゴリID</label><input type="text" id="y-category" size="12"<%= dis %>>
          <label class="k" style="min-width: auto;">Yahoo!path</label><input type="text" id="y-path" size="40" maxlength="500"<%= dis %>></div>
        <div class="sub">税率は Company DB の税率を使います (ここでは入れません)。</div>
      </div>

      <div class="bar">
        <label>理由 (任意) <input type="text" id="reason" size="30" maxlength="200"<%= dis %>></label>
        <button type="button" class="btn-sm" id="save"<%= dis %>>登録 (下書き)</button>
        <span class="sub">NE・ロジザードへの登録 (新規登録の CSV) は次の段階で足します</span>
      </div>
    </form>
    <div class="msg" id="msg"></div>
    <div id="result"></div>
    <% } %>
  </div>

<script>
(() => {
  const form = document.getElementById('f');
  if (!form) return;
  const D = form.dataset;
  const $ = (id) => document.getElementById(id);
  const isSet = D.kind === 'set';
  const canSave = D.canSave === '1';
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const HANDLING = { active: '取扱中', discontinued: '中止', unknown: '不明' };
  function uuid() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    const b = new Uint8Array(16); crypto.getRandomValues(b); b[6] = (b[6] & 15) | 64; b[8] = (b[8] & 63) | 128;
    const h = Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
    return h.slice(0, 8) + '-' + h.slice(8, 12) + '-' + h.slice(12, 16) + '-' + h.slice(16, 20) + '-' + h.slice(20);
  }
  // 登録 1 回に 1 つ (通信が切れて押し直しても 2 回入らない)
  let requestId = uuid();
  const val = (id) => { const e = $(id); return e ? e.value.trim() : ''; };
  function fieldValue(name) {
    const list = Array.from(form.querySelectorAll('[data-field="' + name + '"]'));
    if (!list.length) return undefined;
    if (list[0].type === 'radio') { const on = list.find((e) => e.checked); return on ? on.value : ''; }
    return list[0].value;
  }

  // ── 商品コードを確かめる ──
  const codeMsg = $('code-msg');
  async function checkCode() {
    const code = $('code').value;
    if (!code) return;
    try {
      const r = await fetch(D.base + '/api/code-check?code=' + encodeURIComponent(code), { headers: { Accept: 'application/json' } });
      const j = await r.json().catch(() => ({}));
      codeMsg.style.color = j.ok ? '#2b8a3e' : '#c92a2a';
      codeMsg.textContent = j.ok ? '使えます' : (j.message || j.error || ('HTTP ' + r.status));
    } catch (e) { codeMsg.style.color = '#c92a2a'; codeMsg.textContent = '確かめられません (通信)'; }
  }
  const cc = $('code-check'); if (cc) cc.addEventListener('click', checkCode);

  // ── セットの構成 ──
  const rowsEl = $('comp-rows');
  function renumber() { Array.from(document.querySelectorAll('#comp-rows tr.comp-row')).forEach((tr, i) => { tr.querySelector('.no').textContent = String(i + 1); }); }
  async function lookup(tr) {
    const code = tr.querySelector('.c-code').value.trim();
    const set = (cls, v) => { tr.querySelector(cls).textContent = v; };
    if (!code) { set('.c-name', ''); return; }
    try {
      const r = await fetch(D.base + '/api/lookup?code=' + encodeURIComponent(code), { headers: { Accept: 'application/json' } });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) { set('.c-name', j.error || '見つかりません'); ['.c-tax', '.c-sales', '.c-cost', '.c-handling'].forEach((c) => set(c, '')); return; }
      const x = j.item;
      set('.c-name', x.name + (x.kind !== 'single' ? ' (単品でない = 構成品にできません)' : ''));
      set('.c-tax', x.tax_rate == null ? '未' : String(Math.round(x.tax_rate * 100)));
      set('.c-sales', x.sales_class == null ? '未' : String(x.sales_class));
      set('.c-cost', x.cost_jpy == null ? '未' : x.cost_jpy.toLocaleString('ja-JP'));
      set('.c-handling', HANDLING[x.handling] || x.handling);
    } catch (e) { set('.c-name', '引き当てできません (通信)'); }
  }
  function addRow() {
    const tpl = $('comp-tpl');
    rowsEl.appendChild(tpl.content.firstElementChild.cloneNode(true));
    renumber();
    if (!canSave) rowsEl.lastElementChild.querySelectorAll('input, button').forEach((e) => { e.disabled = true; });
  }
  if (rowsEl) {
    rowsEl.addEventListener('click', (ev) => {
      const b = ev.target.closest('button[data-act]'); if (!b || b.disabled) return;
      const tr = b.closest('tr');
      if (b.dataset.act === 'del') tr.remove();
      if (b.dataset.act === 'up' && tr.previousElementSibling) tr.parentNode.insertBefore(tr, tr.previousElementSibling);
      if (b.dataset.act === 'down' && tr.nextElementSibling) tr.parentNode.insertBefore(tr.nextElementSibling, tr);
      renumber();
    });
    rowsEl.addEventListener('change', (ev) => { if (ev.target.classList.contains('c-code')) lookup(ev.target.closest('tr')); });
    addRow(); addRow();
  }
  const addBtn = $('comp-add');
  if (addBtn) addBtn.addEventListener('click', () => { addRow(); rowsEl.lastElementChild.querySelector('.c-code').focus(); });

  // ── 集める ──
  function collect() {
    const values = {};
    const keys = isSet ? ['name', 'standard_price', 'shipping_code', 'reorder_months', 'handling_own', 'set_sales_class_override']
      : ['name', 'standard_price', 'shipping_code', 'tax_rate', 'sales_class', 'primary_supplier', 'reorder_months', 'expiry_managed', 'inbound_date_managed'];
    for (const k of keys) { const v = fieldValue(k); if (v !== undefined && v !== '') values[k] = v; }
    if (isSet) {
      values.components = Array.from(document.querySelectorAll('#comp-rows tr.comp-row'))
        .map((tr) => ({ code: tr.querySelector('.c-code').value.trim(), qty: tr.querySelector('.c-qty').value.trim() }))
        .filter((r) => r.code || (r.qty && r.qty !== '1'));
      if (val('xcost-jpy')) values.exception_cost = { jpy: val('xcost-jpy'), reason: val('xcost-reason') };
    } else if (val('cost-jpy')) values.cost = { jpy: val('cost-jpy'), reason: val('cost-reason') };
    const card = {
      create: $('card-create').checked,
      official_url: val('official-url'), amazon_url: val('amazon-url'), asin: val('asin'),
      reference_urls: val('ref-urls').split(/\r?\n/).map((s) => s.trim()).filter(Boolean),
      yahoo: { price: val('y-price'), price_sagawa: val('y-price-sagawa'), delivery_label: val('y-delivery'), category_id: val('y-category'), path: val('y-path') },
    };
    if (!isSet) {
      const plan = form.querySelector('input[name="set_plan"]:checked');
      if (plan && plan.value) card.set_decision = { decision: plan.value, reason_code: plan.value === 'none' ? val('set-reason') : '', reason_text: val('set-text') };
    }
    return { request_id: requestId, kind: D.kind, code: $('code').value, reason: val('reason'), values, card };
  }

  // ── 登録 ──
  function setMsg(text, cls) { const m = $('msg'); m.className = 'msg ' + (cls || ''); m.textContent = text || ''; }
  function showResult(j) {
    const li = (a) => a.map((x) => '<li>' + x + '</li>').join('');
    const skuUrl = D.base + '/sku/' + encodeURIComponent(j.code);
    let html = '<div class="result"><b>登録しました (下書き)' + (j.replayed ? ' (前に登録した結果)' : '') + '</b>: <a href="' + esc(skuUrl) + '">' + esc(j.code) + ' を開く</a>'
      + '<ul><li>税率 ' + esc(j.tax && j.tax.rate != null ? Math.round(j.tax.rate * 100) + '% (' + j.tax.class + ')' : '未決') + ' ・ 原価 ' + esc(j.cost ? j.cost.jpy.toLocaleString('ja-JP') + ' 円' : '未入力')
      + ' ・ 発送方法 ' + esc(j.shipping ? j.shipping.code + ' ' + (j.shipping.method || '') : '') + '</li></ul>';
    if (j.card) {
      html += '<div>product-hub の出品カード: <b>' + esc(j.card_label || j.card.status) + '</b>'
        + (j.card.status === 'done' && j.card.draft_id ? ' <a href="/apps/product-hub/detail/' + encodeURIComponent(j.card.draft_id) + '">カードを開く ↗</a>' : '')
        + (j.card.status !== 'done' ? ' <span class="sub">(商品の画面の「カードをもう一度作る」か、product-hub のボードを開くと作り直します)</span>' : '') + '</div>';
    }
    if (j.ne_steps && j.ne_steps.length) html += '<div><b>このあと:</b></div><ul>' + li(j.ne_steps.map(esc)) + '</ul>';
    if (j.warnings && j.warnings.length) html += '<div><b>気をつけること:</b></div><ul>' + li(j.warnings.map(esc)) + '</ul>';
    $('result').innerHTML = html + '</div>';
  }
  function showError(j, status) {
    let html = '<div class="result"><b style="color:#c92a2a">' + esc(j.error || ('HTTP ' + status)) + '</b>';
    if (j.reason === 'set_underivable' && Array.isArray(j.blockers)) html += '<ul>' + j.blockers.map((b) => '<li>' + esc(b) + '</li>').join('') + '</ul>';
    $('result').innerHTML = html + '</div>';
  }
  const saveBtn = $('save');
  if (saveBtn && canSave) saveBtn.addEventListener('click', async () => {
    const body = collect();
    // Yahoo!売価の 0 はサーバーと同じく断る (空 = 入れない)
    const zero = ['y-price', 'y-price-sagawa'].filter((id) => /^[0０]+$/.test(val(id)));
    if (zero.length) { setMsg('Yahoo!売価は 1 円以上で入れてください (決めていなければ空のまま)', 'err'); return; }
    saveBtn.disabled = true; setMsg('登録しています…'); $('result').innerHTML = '';
    let r, j;
    try {
      r = await fetch(D.base + '/api/new', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
      j = await r.json().catch(() => ({}));
    } catch (e) {
      saveBtn.disabled = false; setMsg('通信できませんでした。もう一度「登録」を押してください (同じ登録は 2 回入りません)', 'err'); return;
    }
    if (r.ok && j.ok) { setMsg('登録しました', 'ok'); showResult(j); return; }   // 登録した後はボタンを押せないまま (同じ商品を 2 回作らない)
    setMsg('', 'err');
    showError(j, r.status);
    requestId = uuid();   // 返事が来た = この番号の登録は終わった。直してもう一度押すときは新しい番号
    saveBtn.disabled = false;
  });
})();
</script>
</body>
</html>
