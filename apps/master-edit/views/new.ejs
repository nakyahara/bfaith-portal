<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
<%
  // 新商品の登録 (画面 D)。新しいデザイン (第 2 段 10/5): 上から順に入れる 1 ページ・上に飛び先の帯・右に「下書き保存まで あと N つ」。
  // 保存の送り方 (POST /api/new) と中身は前と同じ。画面の動き = public/me-new.js
  const isSet = kind === 'set';
  // 送料の表が読めなくても下書きはできる (発送方法は必須でない・2026-10-08 中原さん。選んだときだけサーバーが送料の表で確かめる)
  const canSave = !!page && canEdit && !dbError && !entryClosed;
  const dis = canSave ? '' : ' disabled';
  const SALES = { 1: '1 自社', 2: '2 取引先限定', 3: '3 仕入', 4: '4 輸出' };
  // 切り替えボタン (税率・売上分類・ロジザード・取扱・カード・セット商品)。押された状態は aria-pressed・見出し (lab-…) と結ぶ
  const h = (x) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const seg = (id, field, current, opts, label) => '<div class="seg" role="group" id="' + id + '" aria-labelledby="lab-' + id + '" data-field="' + field + '" data-dirty-field="' + field + '" data-label="' + label + '" data-value="' + current + '">'
    + opts.map(([v, t, small]) => '<button type="button" data-v="' + h(v) + '" aria-pressed="' + (current === v ? 'true' : 'false') + '"' + (current === v ? ' class="on"' : '') + dis + '>' + h(t) + (small ? ' <small>' + h(small) + '</small>' : '') + '</button>').join('') + '</div>';
  const compRow = (i) => '<tr class="comp-row"><td class="no">' + i + '</td><td><input class="in mono c-code" style="width:150px" autocomplete="off" spellcheck="false" placeholder="商品コード" aria-label="' + i + ' 行目の構成品のコード"' + dis + '> <span class="c-name"></span></td>'
    + '<td><input class="in c-qty" style="width:70px;text-align:right" inputmode="numeric" autocomplete="off" value="1" aria-label="' + i + ' 行目の数"' + dis + '></td><td class="c-tax"></td><td class="c-sales"></td><td class="c-cost n"></td><td class="c-handling"></td>'
    + '<td class="acts"><button type="button" class="iconbtn" data-act="up" aria-label="' + i + ' 行目を上へ"' + dis + '><svg class="ic s" aria-hidden="true"><use href="#i-up"/></svg></button><button type="button" class="iconbtn" data-act="down" aria-label="' + i + ' 行目を下へ"' + dis + '><svg class="ic s" aria-hidden="true"><use href="#i-down"/></svg></button><button type="button" class="iconbtn del" data-act="del" aria-label="' + i + ' 行目を外す"' + dis + '><svg class="ic s" aria-hidden="true"><use href="#i-trash"/></svg></button></td></tr>';
  // 区切り (上の飛び先の帯と同じ順)。番号は種類で変わる
  const secs = isSet
    ? [['sec-code', 'コードと名前'], ['sec-comp', '構成'], ['sec-money', 'お金'], ['sec-ship', '発送'], ['sec-card', '出品カード'], ['sec-yahoo', 'Yahoo!']]
    : [['sec-code', 'コードと名前'], ['sec-money', 'お金'], ['sec-tax', '税・分類・仕入先'], ['sec-ship', '発送'], ['sec-card', '出品カード'], ['sec-yahoo', 'Yahoo!']];
  const no = (id) => secs.findIndex((x) => x[0] === id) + 1;
  // 画面の JS に渡す値 (JSON = EJS の出力を JS の値の位置に直に置かない)
  const pageData = page ? { base, kind, canSave, maxComponents: MAX_COMPONENTS, maxRefs: MAX_REFERENCE_URLS, secs } : null;
%>
  <%- include('_header', { hasSave: canSave }) %>
  <div class="page" id="new-page">
    <nav class="crumb" aria-label="いまの場所"><a href="<%= base %>/" data-list-back>商品・セット</a><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg><span aria-current="page">新商品の登録</span></nav>
    <div class="ph">
      <div>
        <h1>新商品の登録</h1>
        <div class="lead">上から順に入れると下書きができます。NE への登録は、そのあと「NE 登録の CSV」で行います。</div>
      </div>
      <div class="ph-actions"><a class="btn" href="<%= base %>/manual#new"><svg class="ic" aria-hidden="true"><use href="#i-book"/></svg>つかいかた</a></div>
    </div>

    <% if (dbError) { %><div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t"><%= dbError %></div><div class="hint">つながったら画面を開き直してください。</div></div></div><% } %>
    <% if (page && entryClosed) { %><div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow"><div class="t">切替前です (<%= entryWhy || ('段階: ' + phaseText) %>)</div><div class="hint">新商品はまだ NE・product-hub で登録します。この画面は見るだけです (登録を押しても「切替前」で断られ、何も変わりません)。</div></div></div><% } %>
    <% if (!canEdit) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= gateMessage %></div></div><% } %>
    <% if (page && !shippingRates) { %><div class="callout err"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">送料の表が読めないので、発送方法を選べません</div><div class="hint">発送方法は空のまま下書きにして、あとで商品の画面で入れられます。いま選ぶときは、少し待ってから画面を開き直してください。</div></div></div><% } %>

    <% if (page) { %>
    <form class="edit" id="f" novalidate data-kind="<%= kind %>" data-can-save="<%= canSave ? '1' : '0' %>">
      <div>
        <nav class="jump" id="jump" aria-label="区切りへ飛ぶ">
          <% for (const [id, t] of secs) { %><a href="#<%= id %>" data-sec="<%= id %>"><span class="n"><%= no(id) %></span> <%= t %></a><% } %>
        </nav>
        <div class="kindcards" role="group" aria-label="種類">
          <a class="kindcard<%= isSet ? '' : ' on' %>" href="?kind=single"<%- isSet ? '' : ' aria-current="page"' %>><span class="kico"><svg class="ic l" aria-hidden="true"><use href="#i-tag"/></svg></span><span><span class="kt">単品</span><br><span class="ks">1 つの商品 (仕入れたもの・作ったもの)</span></span><span class="radio" aria-hidden="true"></span></a>
          <a class="kindcard<%= isSet ? ' on' : '' %>" href="?kind=set"<%- isSet ? ' aria-current="page"' : '' %>><span class="kico"><svg class="ic l" aria-hidden="true"><use href="#i-box"/></svg></span><span><span class="kt">セット</span><br><span class="ks">単品を組み合わせる (ギフト・まとめ買い)</span></span><span class="radio" aria-hidden="true"></span></a>
        </div>

        <section class="panel" id="sec-code" aria-labelledby="h-code">
          <div class="panel-h"><span class="stepno" data-step="sec-code" aria-hidden="true"><%= no('sec-code') %></span><h2 id="h-code">コードと名前</h2></div>
          <div class="f" data-row="code"><label class="lab" for="code">商品コード<span class="req">必須</span></label>
            <div class="ctl"><input class="in w-m mono" id="code" maxlength="30" autocomplete="off" spellcheck="false" data-dirty-field="code" data-label="商品コード" placeholder="例: abc-honey-300"<%= dis %>>
              <button type="button" class="btn sm" id="code-check"<%= dis %>>確かめる</button>
              <span class="fmsg" id="code-msg" role="status" aria-live="polite"></span>
              <span class="hint" style="flex-basis:100%">小文字の英字・数字・- _ だけ (30 字まで)・大文字は使えません・使ったことのないコード · 打つとその場で確かめます</span></div></div>
          <div class="f" data-row="name"><label class="lab" for="f-name">名前<span class="req">必須</span></label>
            <div class="ctl"><input class="in w-l" id="f-name" maxlength="255" autocomplete="off" data-field="name" data-dirty-field="name" data-label="名前" placeholder="例: 北海道産 小豆 こしあん 500g"<%= dis %>><span class="hint">資材の印 (_白ビ袋 など) は付けない</span></div></div>
        </section>

        <% if (isSet) { %>
        <section class="panel" id="sec-comp" aria-labelledby="h-comp">
          <div class="panel-h"><span class="stepno" data-step="sec-comp" aria-hidden="true"><%= no('sec-comp') %></span><h2 id="h-comp">構成</h2><span class="sub">NE に登録して、NE の構成が同じと確かめたら「今の構成」になります</span></div>
          <div class="f wide" data-row="components" style="padding-top:0">
            <div class="scrollx"><table class="comp" id="comp" data-dirty-field="components" data-label="構成"><caption class="sr">構成 (コードを打つと名前が出ます)</caption>
              <thead><tr><th scope="col">#</th><th scope="col">構成品 (コードを打つと名前が出ます)</th><th scope="col">数</th><th scope="col">税</th><th scope="col">分類</th><th scope="col" class="n">原価</th><th scope="col">取扱</th><th scope="col"><span class="sr">並べ替え・外す</span></th></tr></thead>
              <tbody id="comp-rows"><%- compRow(1) %><%- compRow(2) %></tbody>
            </table></div>
            <template id="comp-tpl"><%- compRow(0) %></template>
            <div style="display:flex;gap:12px;align-items:center;margin:6px 0 14px;flex-wrap:wrap"><button class="btn sm" type="button" id="comp-add"<%= dis %>><svg class="ic s" aria-hidden="true"><use href="#i-plus"/></svg>構成品を足す</button><span class="hint">1〜<%= MAX_COMPONENTS %> 品 · 数は 1〜999 · 同じ品は 1 行 · セットは入れられません · 並びも入れたとおり</span></div>
          </div>
          <div class="tiles" id="set-tiles" aria-live="polite">
            <div class="tile" id="t-tax"><div class="tl2">税率<span class="est">見込み</span></div><div class="tv">—</div><div class="tr">構成品を入れると出ます</div></div>
            <div class="tile" id="t-sales"><div class="tl2">売上分類<span class="est">見込み</span></div><div class="tv">—</div><div class="tr">いちばん小さい番号</div></div>
            <div class="tile" id="t-cost"><div class="tl2">原価 (合計)<span class="est">見込み</span></div><div class="tv">—</div><div class="tr">構成品の原価 × 数</div></div>
            <div class="tile" id="t-price"><div class="tl2">単品の売価の合計<span class="est">見込み</span></div><div class="tv">—</div><div class="tr">セットの売価とくらべる</div></div>
          </div>
          <div class="hint" style="margin-top:8px">「見込み」は構成品の今の値から画面が出したものです。決まるのは保存のとき (サーバーが同じ決まりで計算し、決まらなければ理由を出して断ります)。</div>
          <details class="more">
            <summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>例外のとき (ふだんは使いません) — セット自身の取扱・売上分類の上書き・例外原価</summary>
            <div class="body">
              <div class="f" data-row="handling_own"><div class="lab" id="lab-handling-own">セット自身の取扱</div><div class="ctl"><%- seg('handling-own', 'handling_own', 'active', [['active', '取扱中'], ['discontinued', '中止']], 'セット自身の取扱') %></div></div>
              <div class="f" data-row="set_sales_class_override"><label class="lab" for="f-set_sales_class_override">売上分類の上書き</label>
                <div class="ctl"><select class="in w-m" id="f-set_sales_class_override" data-field="set_sales_class_override" data-dirty-field="set_sales_class_override" data-label="売上分類の上書き"<%= dis %>>
                  <option value="">— (構成品から)</option>
                  <% for (const [k, v] of Object.entries(SALES)) { %><option value="<%= k %>"><%= v %></option><% } %>
                </select><span class="hint" id="override-hint">構成品から導けないときだけ (未入力・輸出 4 と 1〜3 の混在)</span></div></div>
              <div class="f" data-row="exception_cost"><label class="lab" for="xcost-jpy">例外原価</label>
                <div class="ctl"><span class="yen"><input class="in w-s" id="xcost-jpy" inputmode="numeric" autocomplete="off" data-dirty-field="exception_cost" data-label="例外原価" placeholder="0"<%= dis %>></span><span class="unit">円</span><span class="hint">空なら構成品の原価の合計</span></div></div>
            </div>
          </details>
        </section>
        <% } %>

        <section class="panel" id="sec-money" aria-labelledby="h-money">
          <div class="panel-h"><span class="stepno" data-step="sec-money" aria-hidden="true"><%= no('sec-money') %></span><h2 id="h-money">お金</h2></div>
          <div class="f" data-row="standard_price"><label class="lab" for="f-standard_price">売価<span class="req">必須</span></label>
            <div class="ctl"><span class="yen"><input class="in w-s" id="f-standard_price" inputmode="numeric" autocomplete="off" data-field="standard_price" data-dirty-field="standard_price" data-label="売価" placeholder="0"<%= dis %>></span><span class="unit">円</span><span class="hint">標準売価 · 税込</span></div></div>
          <% if (!isSet) { %>
          <div class="f" data-row="cost"><label class="lab" for="cost-jpy">原価<span class="opt">あとでも可</span></label>
            <div class="ctl"><span class="yen"><input class="in w-s" id="cost-jpy" inputmode="numeric" autocomplete="off" data-dirty-field="cost" data-label="原価" placeholder="0"<%= dis %>></span><span class="unit">円</span><span class="hint">今日から</span></div></div>
          <% } %>
        </section>

        <% if (!isSet) { %>
        <section class="panel" id="sec-tax" aria-labelledby="h-tax">
          <div class="panel-h"><span class="stepno" data-step="sec-tax" aria-hidden="true"><%= no('sec-tax') %></span><h2 id="h-tax">税・分類・仕入先</h2></div>
          <div class="f" data-row="tax_rate"><div class="lab" id="lab-f-tax_rate">税率<span class="req">必須</span></div>
            <div class="ctl"><%- seg('f-tax_rate', 'tax_rate', '', [['0.08', '8%', '軽減 · 食品'], ['0.1', '10%', '標準']], '税率') %><span class="misslabel" id="tax-miss"><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg>まだ選んでいません</span></div></div>
          <div class="f" data-row="sales_class"><div class="lab" id="lab-f-sales_class">売上分類<span class="opt">あとでも可</span></div>
            <div class="ctl"><%- seg('f-sales_class', 'sales_class', '', [...Object.entries(SALES).map(([k, v]) => [k, v]), ['', 'あとで']], '売上分類') %></div></div>
          <div class="f" data-row="primary_supplier"><label class="lab" for="f-primary_supplier">代表の仕入先<span class="req">必須</span></label>
            <div class="ctl"><select class="in w-m" id="f-primary_supplier" data-field="primary_supplier" data-dirty-field="primary_supplier" data-label="代表の仕入先"<%= dis %>>
              <option value="">(選ぶ)</option>
              <% for (const s of page.activeSuppliers) { %><option value="<%= s.code %>"><%= s.code %> <%= s.name %></option><% } %>
            </select><span class="hint">NE で必須の項目です</span><a class="hint" href="/apps/purchase-orders" target="_blank" rel="noopener">先方品番・入数・ロットは 発注アプリ ↗</a></div></div>
        </section>
        <% } %>

        <section class="panel" id="sec-ship" aria-labelledby="h-ship">
          <div class="panel-h"><span class="stepno" data-step="sec-ship" aria-hidden="true"><%= no('sec-ship') %></span><h2 id="h-ship">発送</h2></div>
          <div class="f" data-row="shipping_code"><label class="lab" for="shipping">発送方法<span class="opt">あとでも可</span></label>
            <div class="ctl">
              <% if (shippingRates) { %>
              <select class="in w-m" id="shipping" data-field="shipping_code" data-dirty-field="shipping_code" data-label="発送方法"<%= dis %>>
                <option value="">(あとで)</option>
                <% for (const r of shippingRates) { %><option value="<%= r.code %>"><%= r.code %> <%= r.method || '' %> / <%= fmt.yen(r.cost) %> 円</option><% } %>
              </select>
              <span class="hint">届いてサイズを見てから決めるときは空のまま (あとで商品の画面で入れる) · 送料コード → 方法と金額は送料の表から · product-hub の楽天の配送方法は対応表から (無ければカードに「要確認」)</span>
              <% } else { %><span class="lockval"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg>送料の表が読めません</span><% } %>
            </div></div>
          <div class="f" data-row="reorder_months"><label class="lab" for="f-reorder_months">推奨保有月数<span class="opt">あとでも可</span></label>
            <div class="ctl"><span class="stepper"><button type="button" data-step="-1" aria-label="1 か月へらす"<%= dis %>>−</button><input id="f-reorder_months" inputmode="decimal" autocomplete="off" data-field="reorder_months" data-dirty-field="reorder_months" data-label="推奨保有月数" placeholder="—"<%= dis %>><button type="button" data-step="1" aria-label="1 か月ふやす"<%= dis %>>＋</button></span><span class="unit">か月</span></div></div>
          <% if (!isSet) { %>
          <div class="f" data-row="expiry_managed"><div class="lab">ロジザード</div>
            <div class="ctl"><span class="hint" id="lab-f-expiry" style="color:var(--text2)">有効期限の管理</span><%- seg('f-expiry', 'expiry_managed', '0', [['0', 'なし'], ['1', 'あり']], '有効期限の管理') %>
              <span class="hint" id="lab-f-inbound" style="color:var(--text2);margin-left:8px">入荷日の管理</span><%- seg('f-inbound', 'inbound_date_managed', '0', [['0', 'なし'], ['1', 'あり']], '入荷日の管理') %>
              <span class="hint">最初の値だけ · あとはロジザードが正</span></div></div>
          <% } %>
        </section>

        <section class="panel" id="sec-card" aria-labelledby="h-card">
          <div class="panel-h"><span class="stepno" data-step="sec-card" aria-hidden="true"><%= no('sec-card') %></span><h2 id="h-card">出品カード (product-hub)</h2>
            <span class="right"><span class="sr" id="lab-card-create">出品カードを作るか</span><%- seg('card-create', 'card_create', '1', [['1', 'カードを作る'], ['0', '作らない']], '出品カード') %></span></div>
          <div class="hint" id="card-off-note" hidden style="margin-bottom:6px">カードは作りません (保存しても product-hub のボードにカードはできません)。</div>
          <div id="card-fields">
            <div class="f" data-row="card.official_url"><label class="lab" for="official-url">公式ページ URL</label><div class="ctl"><input class="in w-l" id="official-url" autocomplete="off" data-dirty-field="official_url" data-label="公式ページ URL" placeholder="https://"<%= dis %>></div></div>
            <div class="f" data-row="card.amazon_url"><label class="lab" for="amazon-url">Amazon URL</label><div class="ctl"><input class="in w-l" id="amazon-url" autocomplete="off" data-dirty-field="amazon_url" data-label="Amazon URL" placeholder="https://www.amazon.co.jp/dp/…  (貼ると ASIN を読み取ります)"<%= dis %>></div></div>
            <div class="f" data-row="card.asin"><label class="lab" for="asin">ASIN</label><div class="ctl"><input class="in w-s mono" id="asin" maxlength="10" autocomplete="off" spellcheck="false" data-dirty-field="asin" data-label="ASIN" placeholder="B0XXXXXXXX"<%= dis %>><span class="fmsg ok" id="asin-msg" role="status" hidden><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg>Amazon URL から読み取りました</span></div></div>
            <div class="f" data-row="card.reference_urls" style="align-items:start"><div class="lab" id="lab-refs" style="padding-top:8px">参考 URL</div>
              <div class="ctl col" style="gap:0" id="refs" role="group" aria-labelledby="lab-refs" data-dirty-field="reference_urls" data-label="参考 URL">
                <div id="ref-rows"><div class="urlrow"><span class="idx" aria-hidden="true">1</span><input class="in ref-url" autocomplete="off" aria-label="参考 URL 1" placeholder="https://"<%= dis %>><button class="iconbtn del" type="button" data-ref-del aria-label="参考 URL 1 を外す"<%= dis %>><svg class="ic s" aria-hidden="true"><use href="#i-x"/></svg></button></div></div>
                <div><button class="btn sm" type="button" id="ref-add"<%= dis %>><svg class="ic s" aria-hidden="true"><use href="#i-plus"/></svg>URL を足す</button> <span class="hint"><%= MAX_REFERENCE_URLS %> 個まで</span></div>
              </div></div>
            <% if (!isSet) { %>
            <div class="f" data-row="card.set_decision"><div class="lab" id="lab-set-plan">セット商品を作るか</div>
              <div class="ctl"><%- seg('set-plan', 'set_plan', '', [...Object.entries(setPlanChoices), ['', 'まだ決めない']], 'セット商品を作るか') %></div></div>
            <div class="f" id="row-set-reason" hidden><label class="lab" for="set-reason">作らない理由・メモ</label>
              <div class="ctl"><select class="in w-m" id="set-reason" data-dirty-field="set_reason" data-label="作らない理由"<%= dis %>>
                <option value="">(作らないときに選ぶ)</option>
                <% for (const [k, v] of Object.entries(setDecisionReasons)) { %><option value="<%= k %>"><%= v %></option><% } %>
              </select><input class="in w-m" id="set-text" maxlength="500" autocomplete="off" data-dirty-field="set_text" data-label="セット商品のメモ" aria-label="メモ (その他の理由・保留のメモ)" placeholder="メモ (その他の理由・保留のメモ)"<%= dis %>></div></div>
            <% } %>
          </div>
        </section>

        <details class="panel soft" id="sec-yahoo">
          <summary><span class="stepno" data-step="sec-yahoo" aria-hidden="true" style="width:26px;height:26px;font-size:13px"><%= no('sec-yahoo') %></span>Yahoo! を楽天と変えるときだけ <span class="b mute" id="yahoo-sum">ふだんは空のまま</span><svg class="ic s chev" aria-hidden="true"><use href="#i-chevr"/></svg></summary>
          <div class="body">
            <div class="f" data-row="card.yahoo.price"><label class="lab" for="y-price">Yahoo!売価</label>
              <div class="ctl"><span class="yen"><input class="in w-s" id="y-price" inputmode="numeric" autocomplete="off" data-dirty-field="y_price" data-label="Yahoo!売価" placeholder="0"<%= dis %>></span><span class="unit">円</span>
                <label class="hint" for="y-price-sagawa" style="color:var(--text2);margin-left:10px">Yahoo!売価 (佐川)</label><span class="yen"><input class="in w-s" id="y-price-sagawa" inputmode="numeric" autocomplete="off" data-dirty-field="y_price_sagawa" data-label="Yahoo!売価 (佐川)" placeholder="0"<%= dis %>></span><span class="unit">円</span>
                <span class="hint">1 円以上 (決めていなければ空のまま・0 は入れない)</span></div></div>
            <div class="f" data-row="card.yahoo.delivery_label"><label class="lab" for="y-delivery">配送方法</label>
              <div class="ctl"><select class="in w-m" id="y-delivery" data-dirty-field="y_delivery" data-label="Yahoo!の配送方法"<%= dis %>>
                <option value="">(楽天と同じ)</option>
                <% for (const d of yahooDeliveries) { %><option value="<%= d %>"><%= d %></option><% } %>
              </select><span class="hint">楽天と違う配送にするときだけ</span></div></div>
            <div class="f" data-row="card.yahoo.category_id"><label class="lab" for="y-category">Yahoo!カテゴリID</label>
              <div class="ctl"><input class="in w-s mono" id="y-category" autocomplete="off" data-dirty-field="y_category" data-label="Yahoo!カテゴリID"<%= dis %>>
                <label class="hint" for="y-path" style="color:var(--text2);margin-left:10px">Yahoo!path</label><input class="in w-m" id="y-path" maxlength="500" autocomplete="off" data-dirty-field="y_path" data-label="Yahoo!path"<%= dis %>></div></div>
            <div class="hint">税率は Company DB の税率を使います (ここでは入れません)。</div>
          </div>
        </details>
      </div>

      <aside class="side" aria-label="下書きの保存">
        <section class="panel savebox hud" id="savebox" aria-labelledby="h-save" tabindex="-1">
          <div class="mobilebar"><span class="grow"><b class="mb-n">未保存の変更はありません</b></span><button class="btn soft sm" type="button" id="savebox-toggle" aria-expanded="false" aria-controls="savebox">確認して保存</button></div>
          <h2 class="sr" id="h-save">下書きの保存</h2>
          <div class="remain" id="remain" aria-live="polite">下書き保存まで あと<b>—</b>つ</div>
          <div class="hint" style="margin-bottom:4px">① がそろえば下書きにできます。② ③ はあとでも入れられます (押すとその欄へ)</div>
          <ul class="checklist" id="checklist"></ul>
          <% if (canSave) { %>
          <label class="lab2" for="reason">理由 (なくてもよい)</label>
          <input class="in" id="reason" maxlength="200" autocomplete="off" placeholder="例: 10 月の新商品">
          <% } %>
          <button class="btn pri lg block" id="save" disabled type="button" aria-keyshortcuts="Control+S">下書きを保存する</button>
          <div class="below"><span>保存すると「下書き」になり、その商品の画面を開きます</span></div>
          <div class="msgline" id="msg" role="status" aria-live="polite"></div>
          <div id="result" aria-live="polite"></div>
        </section>
        <section class="panel" aria-labelledby="h-after">
          <div class="panel-h" style="margin-bottom:8px"><h2 id="h-after">登録のあと</h2></div>
          <ol class="after-steps">
            <li class="first">下書き (この画面) — ① がそろったら</li>
            <li>NE 登録の CSV を作って配る — ② がそろったら · <a href="<%= base %>/reg-csv">NE 登録の CSV</a></li>
            <li>NE の画面で取り込む → 申告</li>
            <li>翌朝の確かめ (NE と同じか)</li>
            <li>登録済み = 業務で使える</li>
          </ol>
          <div class="hint">出品カードは保存のすぐあとに product-hub のボードにできます。</div>
        </section>
      </aside>
    </form>
    <script type="application/json" id="me-new"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
    <% } %>
  </div>
  <%- include('_footer') %>
  <% if (page) { %><script src="<%= base %>/public/me-new.js?v=<%= assetV %>" defer></script><% } %>
</body>
</html>
