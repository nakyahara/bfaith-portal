<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
  <%- include('_header') %>
  <%
    const SALES = { 1: '1 自社', 2: '2 取引先限定', 3: '3 仕入', 4: '4 輸出' };
    const pageHref = (offset) => '?' + new URLSearchParams({ ...Object.fromEntries(Object.entries(filters).filter(([k, v]) => v && k !== 'offset')), ...(offset ? { offset: String(offset) } : {}) }).toString();
  %>
  <div class="me-wrap">
    <% if (dbError) { %><div class="band err"><%= dbError %></div><% } %>
    <% if (closed) { %><div class="band warn">いまは保存できません (<%= closedWhy %>)。この画面は見るだけです。切替日までは商品マスタの正は NE・/register です。</div><% } %>
    <% if (!canEdit) { %><div class="band info"><%= gateMessage %></div><% } %>
    <div class="me-box">
      <p class="hint">
        Company DB の商品・セットの一覧です。コードを押すと 1 つずつ見て直せます。<b>*</b> = 構成品から導いた値 (セットの税率・原価の合計・売上分類)。
        「未入力」で、まだ入っていない項目の商品だけを出せます (今の /register の「未登録」の代わり)。
        <a href="manual">📖 つかいかた</a> ・ <a href="amazon/">🛒 Amazon SKU の対応</a> ・ <a href="/apps/master-decisions/">⚖️ マスタの判断 (NE との差)</a>
        ・ <a href="new?kind=single">＋ 新商品 (単品)</a> ・ <a href="new?kind=set">＋ 新商品 (セット)</a>
      </p>
    </div>

    <form method="get" action="" class="row">
      <input name="q" value="<%= filters.q %>" placeholder="コード・名前・JAN で検索" size="26">
      <label>区分 <select name="kind"><option value="">全部</option><% for (const [k, v] of Object.entries(KINDS)) { %><option value="<%= k %>"<%= filters.kind === k ? ' selected' : '' %>><%= v %></option><% } %></select></label>
      <label>状態 <select name="state"><option value="">全部</option><% for (const [k, v] of Object.entries(STATES)) { %><option value="<%= k %>"<%= filters.state === k ? ' selected' : '' %>><%= v %></option><% } %></select></label>
      <label>カード <select name="card"><option value="">全部</option><% for (const [k, v] of Object.entries(CARD_FILTERS)) { %><option value="<%= k %>"<%= filters.card === k ? ' selected' : '' %>><%= v %></option><% } %></select></label>
      <label>登録 <select name="reg"><option value="">全部</option><% for (const [k, v] of Object.entries(REG_STATES)) { %><option value="<%= k %>"<%= filters.reg === k ? ' selected' : '' %>><%= v %></option><% } %></select></label>
      <label>未入力 <select name="missing"><option value="">—</option><% for (const [k, v] of Object.entries(MISSING)) { %><option value="<%= k %>"<%= filters.missing === k ? ' selected' : '' %>><%= v %></option><% } %></select></label>
      <label><input type="checkbox" name="diff" value="1"<%= filters.diff ? ' checked' : '' %><%= data.diffAvailable ? '' : ' disabled' %>> NEとの差あり</label>
      <button class="btn-sm" type="submit">表示</button>
      <span class="muted"><%= data.total.toLocaleString('ja-JP') %> 件<% if (data.latestRun) { %> ・ 最新の照合 <%= String(data.latestRun.observed_at || '').slice(0, 16) %><% } %></span>
    </form>

    <div class="tbox">
      <table class="me">
        <thead><tr><th>コード</th><th>名前</th><th>区分</th><th>状態</th><th>登録</th><th>税</th><th>売価</th><th>原価</th><th>分類</th><th>仕入先</th><th>⚠</th></tr></thead>
        <tbody>
          <% if (!data.rows.length) { %><tr><td colspan="11" class="muted"><%= dbError ? '読めません' : '当てはまる商品がありません' %></td></tr><% } %>
          <% for (const r of data.rows) { %>
          <tr>
            <td><a href="sku/<%= encodeURIComponent(r.code) %>"><%= r.code %></a></td>
            <td><%= r.name %></td>
            <td><%= KINDS[r.kind] || r.kind %></td>
            <td><%= STATES[r.state] || r.state %></td>
            <td><%= r.reg_state === 'none' ? '—' : (REG_STATES[r.reg_state] || r.reg_state) %></td>
            <td class="n"><%= r.tax_rate == null ? '' : fmt.tax(r.tax_rate) %><%= r.tax_derived ? '*' : '' %></td>
            <td class="n"><%= fmt.yen(r.standard_price) %></td>
            <td class="n"><%= fmt.yen(r.cost) %><%= r.cost_derived ? '*' : '' %></td>
            <td><%= r.sales_class == null ? '' : r.sales_class %><%= r.sales_derived && r.sales_class != null ? '*' : '' %></td>
            <td><%= r.kind === 'set' ? '—' : (r.primary_supplier || '') %></td>
            <td><% for (const f of r.flags) { %><span class="flag"><%= f %></span><% } %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="pager">
      <% if (data.offset > 0) { %><a href="<%= pageHref(Math.max(0, data.offset - data.limit)) %>">← 前の <%= data.limit %> 件</a><% } %>
      <% if (data.total > data.offset + data.rows.length) { %><a href="<%= pageHref(data.offset + data.limit) %>">次の <%= data.limit %> 件 →</a><% } %>
      <% if (data.total) { %><span class="muted"><%= data.offset + 1 %>〜<%= data.offset + data.rows.length %> 件目</span><% } %>
    </div>
    <p class="muted" style="font-size: 0.82em;">売上分類: <%= Object.values(SALES).join(' / ') %> ・ 登録 = 新商品の登録の進み (— = 切替の前からある商品) ・ Amazon SKU の対応は「🛒 Amazon SKU の対応」の画面で見ます。</p>
  </div>
</body>
</html>
