<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
<%
  const c = page ? page.cur : null;
  const F = page ? page.fields : {};
  const isSet = !!c && c.sku_kind === 'set';
  // 登録をやめた商品 (cancelled) はサーバーが必ず断る (400 cancelled_sku) = 見るだけ (#1589 Codex R2 M3)
  const cancelled = !!c && !!c.registration && c.registration.state === 'cancelled';
  const canSave = !!page && canEdit && !dbError && !closed && c.sku_kind !== 'exception' && !cancelled;
  const L = page ? page.locks.fields : {};
  const SALES = { 1: '1 自社', 2: '2 取引先限定', 3: '3 仕入', 4: '4 輸出' };
  const HANDLING = { active: '取扱中', discontinued: '中止', unknown: '不明' };
  const SRC = { ne: 'NE から', manual: '人が入れた', set_calc: '構成品の合計', override_zero: '0 円の上書き', imported: '取込' };
  const COST_ST = { COMPLETE: '確定', OVERRIDDEN: '上書き', INCOMPLETE: '足りない', UNKNOWN: '不明' };
  const NE_LBL = { csv: 'NE へ CSV', manual: 'NE の画面で', none: 'NE へ送らない' };
  const h = (s) => String(s ?? '').replace(/[&<>"']/g, (x) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[x]));
  const yen = (v) => (v == null ? '' : Number(v).toLocaleString('ja-JP'));
  const labelOf = (f) => (FIELD_DEFS[f] || {}).label || f;
  const neOf = (f) => NE_LBL[(FIELD_DEFS[f] || {}).ne] || '';
  // 欄を直せるか = 保存を開いている・名簿の人・持ち主が Company DB・CSV の鍵が無い (どれかが欠ければ 🔒 の値で見せる = 押しても断られる欄を出さない)
  const editable = (f) => canSave && !!F[f] && F[f].editable && !L[f];
  const lockWhy = (f) => {
    if (L[f]) {
      const ids = L[f].exports.map((x) => '#' + x).join('・');
      return L[f].why === 'reg'
        ? '<span class="lockwhy">NE に送った値 (ファイル ' + h(ids) + ')</span>'
        : '<span class="lockwhy">NE に取り込む CSV (ファイル ' + h(ids) + ') が出ているので直せません · <a href="/apps/master-decisions/csv">マスタの判断 ↗</a></span>';
    }
    if (F[f] && !F[f].editable) return '<span class="b warn" title="この項目の正はまだ NE・/register です">切替前</span>';
    return '';
  };
  const lockval = (text, mono) => '<span class="lockval"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><span' + (mono ? ' class="mono"' : '') + '>' + h(text) + '</span></span>';
  const meta = (f) => 'data-field="' + f + '" data-dirty-field="' + f + '" data-label="' + h(labelOf(f)) + '" data-ne="' + h(neOf(f)) + '"';
  // 1 行 (見出し + 欄)。ctl = 直せるときの欄 / lockText = 直せないときに見せる値 / forId = <label for> の相手 (切り替えボタンは null)
  const row = (f, label, ctl, lockText, { forId = null, hint = '', mono = false, wide = false } = {}) => {
    const can = editable(f);
    const lab = forId && can ? '<label class="lab" for="' + forId + '" id="lab-' + f + '">' + h(label) + '</label>' : '<div class="lab" id="lab-' + f + '">' + h(label) + '</div>';
    return '<div class="f' + (wide ? ' wide' : '') + '" data-row="' + f + '">' + lab + '<div class="ctl">' + (can ? ctl : lockval(lockText, mono) + lockWhy(f)) + (hint ? '<span class="hint">' + hint + '</span>' : '') + '</div></div>';
  };
  // 切り替えボタン (取扱・税率・売上分類)。押された状態は aria-pressed・見出しと結ぶ
  const seg = (f, current, opts) => '<div class="seg" role="group" aria-labelledby="lab-' + f + '" ' + meta(f) + ' data-value="' + h(current ?? '') + '">'
    + opts.map(([v, t, small]) => '<button type="button" data-v="' + h(v) + '" aria-pressed="' + (String(current ?? '') === v ? 'true' : 'false') + '"' + (String(current ?? '') === v ? ' class="on"' : '') + '>' + h(t) + (small ? ' <small>' + h(small) + '</small>' : '') + '</button>').join('') + '</div>';
  const taxText = (v) => (v == null ? '未入力' : Number(v) === 0.08 ? '8% 軽減' : Number(v) === 0.1 ? '10% 標準' : fmt.tax(v) + '%');
  const shipText = c ? (c.shipping_code ? c.shipping_code + ' · ' + (c.shipping_method || '—') + ' / ' + (c.shipping_cost == null ? '—' : yen(c.shipping_cost) + ' 円') : '未入力') : '';
  const supName = (code) => { const s = page && (page.activeSuppliers.find((x) => x.code === code) || page.suppliers.find((x) => x.code === code)); return s ? s.name : ''; };
  // 最近の変更 (人の言葉にできる行だけ)
  const recent = page ? page.recent.filter((e) => !(e.entity_type === 'sku_cost' && e.attribute === 'valid_to')).map((e) => ({ e, w: ui.eventWords(e) })).filter((x) => x.w) : [];
  const last = page && page.recent.length ? page.recent[0] : null;
  // 先の日付の原価 (read.mjs readFutureCostLocks = サーバーの cost_future / set_cost_future と同じ条件)。該当する原価の欄だけ理由つきで閉じる
  const FC = page ? page.locks.futureCost : { own: null, parents: [] };
  const futureCost = !!c && !isSet && (!!FC.own || FC.parents.length > 0);
  const futureWhy = !FC ? '' : FC.own ? ui.fmtDay(FC.own.valid_from, page.today) + ' から始まる原価 (' + yen(FC.own.cost_jpy) + ' 円) がもう入っているので、今日からの原価はここでは入れられません'
    : FC.parents.length ? 'この商品を使うセット ' + FC.parents.map((x) => x.code + ' (' + ui.fmtDay(x.valid_from, page.today) + ' から)').join('・') + ' に先の日付の原価が入っているので、セットの原価を今日から計算し直せません = この商品の原価はここでは変えられません' : '';
  const reg = c && c.registration ? c.registration.state : null;
  const REG_BADGE = { draft: 'warn', ne_pending: 'info', ne_confirmed: 'info', distributable: 'info', available: 'ok', quarantined: 'err', cancelled: 'mute' };
  const dv = isSet ? page.derived : null;
  const compKey = (rows) => rows.map((x) => x.code + '×' + x.qty).join(', ');
  // 画面の JS に渡す値 (JSON = EJS の出力を JS の値の位置に直に置かない)
  const pageData = page ? {
    code: c.code, kind: c.sku_kind, base, today: page.today, todayLabel: ui.fmtDay(page.today), canSave,
    costNow: c.cost_today ? c.cost_today.cost_jpy : null, xcostNow: c.open_cost ? c.open_cost.cost_jpy : null,
    usedIn: page.usedIn.map((u) => ({ code: u.code, name: u.name, qty: u.qty })), amazon: page.amazon,
    regBuilt: page.regItems.filter((i) => i.state === 'built').map((i) => String(i.export_id)), regFields: REG_FIELDS,
    handling: c.handling, handlingOwn: c.handling_own ?? null, reg,
    request: !!c.component_request, currentComps: isSet ? c.components.map((x) => ({ code: x.code, qty: x.qty })) : [],
    maxComponents: MAX_COMPONENTS,
  } : null;
%>
  <%- include('_header', { hasSave: canSave }) %>
  <div class="page" id="sku-page">
  <% if (dbError) { %><div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t"><%= dbError %></div><div class="hint">つながったら画面を開き直してください。</div></div></div><% } %>
  <% if (page) { %>
    <nav class="crumb" aria-label="いまの場所"><a href="<%= base %>/" data-list-back>商品・セット</a><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg><span class="mono" aria-current="page"><%= c.code %></span></nav>
    <div class="ph" id="sku-ph">
      <div>
        <div class="idrow">
          <span class="code-pill"><%= c.code %></span>
          <% if (isSet) { %><span class="b vio"><svg class="ic" aria-hidden="true"><use href="#i-box"/></svg>セット · <%= c.components.length %> 品</span><% } else { %><span class="b mute"><%= KINDS[c.sku_kind] || c.sku_kind %></span><% } %>
          <% if (isSet) { %><span class="b <%= c.handling === 'discontinued' ? 'mute' : 'ok' %>"><% if (c.handling !== 'discontinued') { %><span class="dot" aria-hidden="true"></span><% } %><%= HANDLING[c.handling] || c.handling %></span><% } %>
          <% if (reg) { %><span class="b <%= REG_BADGE[reg] || 'mute' %>"><% if (reg === 'available') { %><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg><% } %><%= REG_STATES[reg] || reg %></span><% } %>
          <% if (isSet && c.component_request) { %><span class="b warn">構成の依頼あり</span><% } %>
        </div>
        <h1><%= c.name %></h1>
        <div class="meta">
          <% if (last) { %><span>最後に直した人 <%= ui.actorWords(last) %></span><span class="dotsep" aria-hidden="true"></span><span><%= ui.fmtJst(last.recorded_at, { nowMs }) %></span><% } else { %><span>変更の記録はまだありません</span><% } %>
          <% if (!isSet && c.primary_supplier) { %><span class="dotsep" aria-hidden="true"></span><span>仕入先 <%= c.primary_supplier %> <%= supName(c.primary_supplier) %></span><% } %>
          <% if (page.registered) { %><span class="dotsep" aria-hidden="true"></span><span id="registered-on">登録日 <%= page.registered.date ? page.registered.date.replace(/-/g, '/') + ' (' + page.registered.label + ')' : '— (分かりません)' %></span><% } %>
        </div>
      </div>
      <div class="ph-actions" style="align-items:center">
        <% if (!isSet && c.sku_kind !== 'exception') { %>
          <div class="handling-top" data-row="handling"><span class="t" id="lab-handling">取扱</span>
            <% if (editable('handling')) { %><%- seg('handling', c.handling, [['active', '取扱中'], ['discontinued', '中止']]) %><% } else { %><%- lockval(HANDLING[c.handling] || c.handling) %><%- lockWhy('handling') %><% } %>
          </div>
        <% } %>
        <a class="btn" href="<%= base %>/sku/<%= encodeURIComponent(c.code) %>/history"><svg class="ic" aria-hidden="true"><use href="#i-history"/></svg>変更の記録</a>
      </div>
    </div>
    <div class="stickyid" id="sku-sticky" hidden>
      <span class="code-pill"><%= c.code %></span><span class="nm"><%= c.name %></span>
      <span class="right"><button class="unsaved" type="button" id="sticky-unsaved" hidden>● 未保存</button>
        <% if (editable('name')) { %><button class="btn sm" type="button" data-jump="f-name">名前を直す</button><% } %></span>
    </div>

    <% if (closed) { %><div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow"><div class="t">いまは保存できません (<%= closedWhy %>)</div><div class="hint">見るだけです。切替日までは、この商品の正は NE・/register です。</div></div></div><% } %>
    <% if (!canEdit) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= gateMessage %></div></div><% } %>
    <% if (c.sku_kind === 'exception') { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow">例外の SKU (NE に無い商品) はこの画面では直せません。</div></div><% } %>
    <% if (reg === 'draft' && !page.locks.regExports.length) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><div class="t">下書きです (新商品の登録)</div><div class="hint">NE・ロジザードへの登録はまだです。値はこの画面で直せます。NE への登録は「NE 登録の CSV」で行います。</div></div><a class="btn sm" href="<%= base %>/reg-csv">NE 登録の CSV を開く</a></div><% } %>
    <% if (cancelled) { %><div class="callout warn" id="cancelled-band"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow"><div class="t">この商品は登録をやめました (やめた)</div><div class="hint">登録をやめた商品は直せません (見るだけです)。使うときは、新しい商品として登録し直してください。</div></div></div><% } %>
    <% if (reg === 'quarantined') { %><div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">要確認</div><div class="hint">切替の後に夜間の処理が NE で見つけた、登録の記録の無い商品です。業務ではまだ使えません。</div></div></div><% } %>
    <% if (page.locks.regExports.length) { %>
      <div class="callout lock"><svg class="ic l" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">
        <div class="t">NE に送った <%= REG_FIELDS.length %> つの欄には鍵がかかっています</div>
        <div class="hint">NE 登録の CSV (ファイル <%= page.locks.regExports.map((x) => '#' + x).join('・') %>) を配ったので、NE に送った値 (<%= REG_FIELDS.map(labelOf).join('・') %>) はここでは直せません。直したいときは:</div>
        <ol><li>NE 登録の CSV で そのファイルを「使わない」にする (NE で何をしたかも書く)</li><li>ここで値を直す</li><li>もう一度 CSV を作って配る</li></ol></div>
        <a class="btn sm" href="<%= base %>/reg-csv">NE 登録の CSV を開く</a></div>
    <% } %>
    <% if (page.locks.taxParentCodes.length) { %><div class="callout lock"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">税率は、この商品を使うセット <%= page.locks.taxParentCodes.join('・') %> の NE 登録の CSV (配った後) にも入っているので直せません。</div></div><% } %>

    <form class="edit" id="f" onsubmit="return false" novalidate data-token="<%= page.token %>" data-event-id="<%= page.seenEventId %>" data-can-save="<%= canSave ? '1' : '0' %>">
      <div>
      <% if (!isSet) { %>
        <section class="panel" id="p-money" aria-labelledby="h-money">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-yen"/></svg></span><h2 id="h-money">お金</h2><span class="sub">売価と原価</span></div>
          <%- row('standard_price', '標準売価', '<span class="yen"><input class="in w-s" id="f-standard_price" inputmode="numeric" autocomplete="off" ' + meta('standard_price') + ' data-unit=" 円" value="' + h(c.standard_price ?? '') + '"></span><span class="unit">円</span>', c.standard_price == null ? '未入力' : yen(c.standard_price) + ' 円', { forId: 'f-standard_price', hint: '税込' }) %>
          <div class="f wide" data-row="cost" style="align-items:start">
            <div class="lab" id="lab-cost">原価</div>
            <div class="ctl col">
              <div class="costhead">
                <div><div class="lbl">いまの原価</div>
                  <div class="bignum"><% if (c.cost_today) { %><%= yen(c.cost_today.cost_jpy) %><small>円</small><% } else { %><span class="b err">未入力</span><% } %></div>
                  <% if (c.cost_today) { %><div class="when"><%= ui.fmtDay(c.cost_today.valid_from, page.today) %> から · <%= SRC[c.cost_today.cost_source] || c.cost_today.cost_source %></div><% } %>
                </div>
                <%# 原価の予約 (設計 18・ops.cost_reservations) の帯を置く場所。裏側ができるまで空 (何も出さない) %>
                <div class="slot" id="cost-next-slot"></div>
                <div class="acts">
                  <% if (editable('cost') && !futureCost) { %><button class="btn soft" type="button" id="btn-cost-open" aria-expanded="false" aria-controls="cost-add"><svg class="ic" aria-hidden="true"><use href="#i-plus"/></svg>原価を変える</button><% } else if (!editable('cost')) { %><%- lockWhy('cost') %><% } %>
                </div>
              </div>
              <% const tl = ui.costTimeline(page.costs, page.today); %>
              <% if (tl && tl.segs.length) { %>
                <div class="tl" aria-hidden="true"><div class="tl-track">
                  <% for (const s of tl.segs) { %><div class="tl-seg <%= s.kind %>" style="left:calc(<%= s.left.toFixed(3) %>% + 2px);width:calc(<%= s.width.toFixed(3) %>% - 4px)"><b><%= s.value %></b><span><%= s.label %></span></div><% } %>
                  <div class="tl-today" style="left:<%= tl.todayLeft.toFixed(3) %>%"><span><%= tl.todayLabel %></span></div>
                </div><div class="tl-axis"><% for (const m of tl.months) { %><span style="left:<%= m.left.toFixed(3) %>%"><%= m.label %></span><% } %></div></div>
                <div class="tl-legend" aria-hidden="true"><span><i class="past"></i>これまで</span><span><i class="now"></i>いま</span><% if (tl.hasFuture) { %><span><i class="fut"></i>先の日付から</span><% } %></div>
              <% } %>
              <% if (futureCost) { %><div class="callout warn" id="cost-future" style="margin:6px 0 10px"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= futureWhy %>。</div></div><% } %>
              <% if (editable('cost') && !futureCost) { %>
              <div class="cost-add" id="cost-add" hidden>
                <div class="ttl"><svg class="ic" style="color:var(--accent)" aria-hidden="true"><use href="#i-clock"/></svg>原価を変える (<%= ui.fmtDay(page.today) %> 今日から)</div>
                <div class="f"><label class="lab" for="cost-jpy">新しい原価</label><div class="ctl"><span class="yen"><input class="in w-s" id="cost-jpy" inputmode="numeric" autocomplete="off" placeholder="0" <%- meta('cost') %> data-unit=" 円"></span><span class="unit">円</span><span id="cost-delta" aria-live="polite"></span></div></div>
                <%# 理由はふだん「メーカーからの値上げ通知」(中原さん 10/5) = 選ぶだけ。その他のときだけ書く。送る文 = 選んだ文そのもの / その他は書いた文 %>
                <div class="f"><span class="lab" id="lab-cost-reason">理由 <span class="req">必須</span></span><div class="ctl">
                  <div class="reason-pick" role="radiogroup" aria-labelledby="lab-cost-reason" id="cost-reason-pick">
                    <% ['メーカーからの値上げ通知', 'メーカーからの値下げ通知', '仕入先を変えた', '入力の誤りを直す'].forEach((t, i) => { %><label class="rp"><input type="radio" name="cost-reason-pick" value="<%= t %>"<%= i === 0 ? ' checked' : '' %>><span><%= t %></span></label><% }) %>
                    <label class="rp"><input type="radio" name="cost-reason-pick" value="" data-other="1"><span>その他</span></label>
                  </div>
                  <input class="in w-full" id="cost-reason" maxlength="200" autocomplete="off" aria-label="その他の理由" placeholder="その他の理由を書く (例: 送料込みの仕入値に変わった)" hidden>
                </div></div>
                <div class="foot"><span class="hint">今日から変わります。いまの原価は昨日で終わります (過去の粗利は変わりません)。入れたら右の「保存する」で確定します。</span>
                  <button class="btn ghost" type="button" id="cost-cancel">やめる</button></div>
              </div>
              <% } %>
              <details class="more"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>これまでの原価 (<%= page.costs.length %>)</summary>
                <div class="body"><div class="tblwrap"><table class="tbl"><thead><tr><th scope="col">期間</th><th scope="col" class="n">原価</th><th scope="col">出どころ</th><th scope="col">状態</th><th scope="col">理由</th><th scope="col">入れた人</th></tr></thead><tbody>
                  <% if (!page.costs.length) { %><tr><td colspan="6" class="muted">まだありません</td></tr><% } %>
                  <% for (const x of page.costs) { %><tr><td><%= ui.fmtDay(x.valid_from, page.today) %> 〜 <%= x.valid_to ? ui.fmtDay(x.valid_to, page.today) : 'いま' %></td><td class="n"><%= yen(x.cost_jpy) %> 円</td><td><%= SRC[x.cost_source] || x.cost_source %></td><td><%= COST_ST[x.cost_status] || x.cost_status %></td><td class="muted"><%= x.reason || '' %></td><td class="muted"><%= x.created_by_id || (x.created_by_type === 'system' ? '夜間の取り込み' : x.created_by_type) %></td></tr><% } %>
                </tbody></table></div></div>
              </details>
            </div>
          </div>
        </section>

        <section class="panel" id="p-logi" aria-labelledby="h-logi">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-truck"/></svg></span><h2 id="h-logi">物流</h2><span class="sub">送料・持つ量・JAN</span></div>
          <% if (shippingRates) { %>
            <%- row('shipping_code', '送料', '<select class="in w-m" id="f-shipping_code" ' + meta('shipping_code') + '>' + (!c.shipping_code ? '<option value="" selected>(未入力)</option>' : '') + shippingRates.map((r) => '<option value="' + h(r.code) + '"' + (r.code === c.shipping_code ? ' selected' : '') + '>' + h(r.code) + ' · ' + h(r.method || '') + ' / ' + yen(r.cost) + ' 円</option>').join('') + (c.shipping_code && !shippingRates.some((r) => r.code === c.shipping_code) ? '<option value="' + h(c.shipping_code) + '" selected>' + h(c.shipping_code) + ' (表に無い)</option>' : '') + '</select>', shipText, { forId: 'f-shipping_code', hint: '方法と金額は送料の表から決まります' }) %>
          <% } else { %>
            <div class="f" data-row="shipping_code"><div class="lab">送料</div><div class="ctl"><%- lockval(shipText) %><span class="lockwhy">送料の表が読めないので直せません</span></div></div>
          <% } %>
          <%- row('reorder_months', '推奨保有月数', '<span class="stepper"><button type="button" data-step="-1" aria-label="1 か月へらす">−</button><input id="f-reorder_months" inputmode="decimal" autocomplete="off" ' + meta('reorder_months') + ' data-unit=" か月" value="' + h(c.reorder_months ?? '') + '" placeholder="—"><button type="button" data-step="1" aria-label="1 か月ふやす">＋</button></span><span class="unit">か月</span>', c.reorder_months == null ? '未入力' : c.reorder_months + ' か月', { forId: 'f-reorder_months', hint: '発注の目安に使います (0〜60・小数は 1 桁まで)' }) %>
          <% if (c.sku_kind === 'single') { %>
            <%- row('jan', 'JAN', '<div class="ctl col" style="gap:6px;width:100%"><div class="tokens" id="jan-tokens" role="group" aria-labelledby="lab-jan">' + page.jan.map((j) => '<span class="tok" data-jan="' + h(j) + '"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>' + h(j) + '<button type="button" aria-label="JAN ' + h(j) + ' を外す">×</button></span>').join('') + '<input id="jan-in" inputmode="numeric" autocomplete="off" aria-label="JAN を足す (8 桁か 13 桁)" placeholder="JAN を足す (8 桁か 13 桁) → Enter"></div><input type="hidden" id="f-jan" ' + meta('jan') + ' value="' + h(page.jan.join(', ')) + '"><span class="fmsg" id="jan-msg" aria-live="polite"></span><span class="hint">桁とチェック数字をその場で確かめます · ほかの商品の JAN は入れられません · 5 つまで · ロジザード・product-hub でも使います。NE の JAN は NE の画面で</span></div>', page.jan.length ? page.jan.join('・') : 'なし', { mono: true }) %>
            <div class="f"><div class="lab">ロジザード</div><div class="ctl"><%- lockval('有効期限の管理 ' + (c.expiry_managed ? 'あり' : 'なし') + ' · 入荷日の管理 ' + (c.inbound_date_managed == null ? '不明' : (c.inbound_date_managed ? 'あり' : 'なし'))) %><span class="hint">ロジザードが正 (ここでは見るだけ)</span></div></div>
          <% } %>
        </section>

        <section class="panel" aria-labelledby="h-tax">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-percent"/></svg></span><h2 id="h-tax">税・分類</h2></div>
          <%- row('tax_rate', '税率', seg('tax_rate', c.tax_rate == null ? '' : String(c.tax_rate), [['0.08', '8%', '軽減'], ['0.1', '10%', '標準']]) + (c.tax_rate == null ? '<span class="misslabel"><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg>まだ入っていません</span>' : ''), taxText(c.tax_rate)) %>
          <%- row('sales_class', '売上分類', seg('sales_class', c.sales_class == null ? '' : String(c.sales_class), Object.entries(SALES).map(([k, v]) => [k, v])) + (c.sales_class == null ? '<span class="misslabel"><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg>まだ入っていません</span>' : ''), c.sales_class == null ? '未入力' : SALES[c.sales_class]) %>
        </section>

        <section class="panel" aria-labelledby="h-sup">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-building"/></svg></span><h2 id="h-sup">仕入先</h2><span class="right"><a href="/apps/purchase-orders" class="hint">先方品番・入数・ロットは 発注アプリ <svg class="ic s" style="vertical-align:-2px" aria-hidden="true"><use href="#i-ext"/></svg></a></span></div>
          <%- row('primary_supplier', '代表の仕入先', '<select class="in w-m" id="f-primary_supplier" ' + meta('primary_supplier') + '>' + (!c.primary_supplier ? '<option value="" selected>(なし)</option>' : '') + page.activeSuppliers.map((s) => '<option value="' + h(s.code) + '"' + (s.code === c.primary_supplier ? ' selected' : '') + '>' + h(s.code) + ' · ' + h(s.name) + '</option>').join('') + (c.primary_supplier && !page.activeSuppliers.some((s) => s.code === c.primary_supplier) ? '<option value="' + h(c.primary_supplier) + '" selected>' + h(c.primary_supplier) + ' (取引停止)</option>' : '') + '</select>', c.primary_supplier ? c.primary_supplier + ' · ' + supName(c.primary_supplier) : 'なし', { forId: 'f-primary_supplier', hint: '選べるのは取引中で、NE への登録の申告が済んだ仕入先だけです' }) %>
          <div class="f"><div class="lab">この商品の仕入先</div><div class="ctl"><% if (!page.suppliers.length) { %><span class="muted">まだありません</span><% } %><% for (const s of page.suppliers) { %><span class="linkchip"><span class="mono"><%= s.code %></span> <%= s.name %><span class="n2"><%= s.vendor_code ? ' 先方品番 ' + s.vendor_code : '' %><%= s.is_primary ? ' · ★代表' : '' %></span></span><% } %></div></div>
        </section>

        <section class="panel" id="p-basic" aria-labelledby="h-basic">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-tag"/></svg></span><h2 id="h-basic">基本</h2><span class="sub">名前・代表 (取扱は上の見出しの横)</span></div>
          <%- row('name', '名前', '<input class="in w-l" id="f-name" autocomplete="off" ' + meta('name') + ' value="' + h(c.name) + '">', c.name, { forId: 'f-name' }) %>
          <%- row('parent_code', '代表 (親)', '<input class="in w-s mono" id="f-parent_code" autocomplete="off" placeholder="なし" ' + meta('parent_code') + ' value="' + h(c.parent_code || '') + '">', c.parent_code ? c.parent_code + ' ' + (c.parent_name || '') : 'なし', { forId: 'f-parent_code', mono: false, hint: h((c.parent_name ? c.parent_name + ' · ' : '') + (c.parent_set_by === 'manual' ? '人が決めた · ' : c.parent_set_by === 'load' ? 'NE から · ' : '')) + '親の商品のコード · 空 = 代表なし' }) %>
        </section>
      <% } else { %>
        <% if (c.component_request) { const rq = c.component_request; const curMap = new Map(c.components.map((x) => [x.code, x.qty])); const reqMap = new Map(rq.rows.map((x) => [x.code, x.qty]));
             const removed = c.components.filter((x) => !reqMap.has(x.code)); const added = rq.rows.filter((x) => !curMap.has(x.code)); const qtyCh = rq.rows.filter((x) => curMap.has(x.code) && curMap.get(x.code) !== x.qty);
             const todo = [...removed.map((x) => x.code + ' (' + (x.name || '') + ') を外し'), ...added.map((x) => x.code + ' (' + (x.name || '') + ') を ' + x.qty + ' 個 入れ'), ...qtyCh.map((x) => x.code + ' の数を ' + curMap.get(x.code) + ' → ' + x.qty + ' にし')]; %>
        <section class="panel" aria-labelledby="h-req">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-layers"/></svg></span><h2 id="h-req">構成の依頼の進み</h2><span class="sub"><%= rq.reason ? '「' + rq.reason + '」 · ' : '' %><%= rq.requested_by %> <%= ui.fmtJst(rq.created_at, { nowMs }) %> · 依頼は保存してすぐには効かず、NE で確かめた後に「今の構成」になります</span></div>
          <ol class="steps" aria-label="構成の依頼の進み">
            <li class="step done"><div class="dot"><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg></div><div class="t">依頼した</div><div class="s"><%= ui.fmtJst(rq.created_at, { nowMs }) %></div></li>
            <li class="step cur" aria-current="step"><div class="dot">2</div><div class="t">NE で構成を直す</div><div class="s">NE の画面で</div><span class="here">いまここ</span></li>
            <li class="step"><div class="dot">3</div><div class="t">翌朝の確かめ</div><div class="s">NE の構成が依頼と同じか</div></li>
            <li class="step"><div class="dot">4</div><div class="t">今の構成になる</div><div class="s">依頼を閉じる</div></li>
          </ol>
          <div class="nextline"><svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg><span class="grow"><b>NE でやること (構成の依頼):</b> <%= todo.length ? todo.join('、') + 'てください。' : '構成品の並びを依頼のとおりにしてください。' %>並びも下の「依頼」のとおりに (依頼した構成: <%= compKey(rq.rows) %> · 今の構成: <%= compKey(c.components) || 'なし' %>)。</span></div>
        </section>
        <% } %>
        <% const BK = { mismatch: 'NE の構成が依頼と違う', stale: '依頼から日がたっても NE の構成が違う', unrequested_diff: '依頼が無いのに NE の構成が今の構成と違う' }; %>
        <% for (const b of page.breaches) { %>
          <div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">NE でやること (食い違い: <%= BK[b.kind] || b.kind %>) · <%= ui.fmtJst(b.created_at, { nowMs }) %></div>
            <div class="hint">NE の構成: <%= (b.details.observed || []).map((x) => x.code + '×' + x.qty).join(', ') || 'なし' %> · あるべき構成: <%= (b.details.expected || []).map((x) => x.code + '×' + x.qty).join(', ') || 'なし' %></div>
            <div class="hint">NE の画面で構成 (構成品・数量・並び) を直すか、この画面で依頼を直してください。</div></div></div>
        <% } %>

        <section class="panel" aria-labelledby="h-comp">
          <% const rqRows = c.component_request ? c.component_request.rows : null; const startMode = rqRows ? 'cmp' : 'now'; %>
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-box"/></svg></span><h2 id="h-comp">構成</h2>
            <span class="right"><div class="seg" id="set-mode" role="group" aria-label="構成の見せ方">
              <% if (rqRows) { %><button type="button" data-v="cmp" class="on" aria-pressed="true">くらべる</button><% } %>
              <button type="button" data-v="now"<%- startMode === 'now' ? ' class="on" aria-pressed="true"' : ' aria-pressed="false"' %>>今の構成</button>
              <button type="button" data-v="edit" aria-pressed="false"><%= rqRows ? '依頼を直す' : '構成を変える (依頼する)' %></button>
            </div></span></div>
          <% if (rqRows) { %>
          <div id="set-cmp" data-mode="cmp">
            <div class="scrollx"><table class="comp"><caption class="sr">今の構成と依頼の構成のくらべ</caption>
              <thead><tr><th scope="col"><span class="sr">どうなる</span></th><th scope="col">構成品</th><th scope="col">今 → 依頼</th><th scope="col" style="text-align:right">原価</th><th scope="col">取扱</th><th scope="col">どうなる</th></tr></thead>
              <tbody>
              <% const curM = new Map(c.components.map((x) => [x.code, x])); const reqM = new Map(rqRows.map((x) => [x.code, x]));
                 const order = [...rqRows.map((x) => x.code), ...c.components.map((x) => x.code).filter((k) => !reqM.has(k))];
                 for (const code of order) { const a = curM.get(code); const b = reqM.get(code); const x = b || a;
                   const kind = !a ? 'add' : !b ? 'rm' : a.qty !== b.qty ? 'qty' : 'same'; %>
                <tr class="<%= kind %>"><td class="mk" aria-hidden="true"><%= { add: '＋', rm: '−', qty: '±', same: '＝' }[kind] %></td>
                  <td><a class="code" href="<%= base %>/sku/<%= encodeURIComponent(code) %>"><%= code %></a><span class="nmx"><%= x.name || '' %></span></td>
                  <td class="qty"><%= a ? '×' + a.qty : '—' %><span class="arrow" aria-label="から">→</span><%= b ? '×' + b.qty : '—' %></td>
                  <td class="n"><%= x.cost_jpy == null ? '未入力' : yen(x.cost_jpy) + ' 円' %></td><td><%= HANDLING[x.handling] || x.handling %></td>
                  <td<%- kind === 'rm' ? ' style="color:var(--err)"' : kind === 'add' ? ' style="color:var(--ok)"' : kind === 'qty' ? ' style="color:var(--warn)"' : ' class="hint"' %>><%= { add: '足す', rm: '外す', qty: '数を変える', same: 'そのまま' }[kind] %></td></tr>
              <% } %>
              </tbody>
            </table></div>
          </div>
          <% } %>
          <div id="set-now" data-mode="now"<%= startMode === 'now' ? '' : ' hidden' %>>
            <div class="scrollx"><table class="comp"><caption class="sr">今の構成 (NE で確かめた構成)</caption>
              <thead><tr><th scope="col">#</th><th scope="col">今の構成品 (NE で確かめた構成)</th><th scope="col">数</th><th scope="col">税</th><th scope="col">分類</th><th scope="col" style="text-align:right">原価</th><th scope="col">取扱</th></tr></thead>
              <tbody>
                <% if (!c.components.length) { %><tr><td colspan="7" class="muted">構成品がありません</td></tr><% } %>
                <% c.components.forEach((x, i) => { %><tr class="same"><td><%= i + 1 %></td><td><a class="code" href="<%= base %>/sku/<%= encodeURIComponent(x.code) %>"><%= x.code %></a><span class="nmx"><%= x.name %></span></td><td class="qty">×<%= x.qty %></td><td><%= x.tax_rate == null ? '未入力' : fmt.tax(x.tax_rate) + '%' %></td><td><%= x.sales_class ?? '未入力' %></td><td class="n"><%= x.cost_jpy == null ? '未入力' : yen(x.cost_jpy) + ' 円' %></td><td><%= HANDLING[x.handling] || x.handling %></td></tr><% }) %>
              </tbody>
            </table></div>
          </div>
          <% const compEditable = editable('components'); const editRows = rqRows || c.components; %>
          <div id="set-edit" data-mode="edit" hidden>
            <% if (!compEditable) { %><div class="callout lock" style="margin:4px 0"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">構成は直せません。<%- lockWhy('components') || (canSave ? '' : '保存を開いていないか、保存できる名簿の人ではありません。') %></div></div><% } %>
            <div class="scrollx"><table class="comp" id="comp" <%- compEditable ? meta('components') : '' %> data-editable="<%= compEditable ? '1' : '0' %>"><caption class="sr">依頼する構成 (コードを打つと名前が出ます)</caption>
              <thead><tr><th scope="col">#</th><th scope="col">構成品 (コードを打つと名前が出ます)</th><th scope="col">数</th><th scope="col">税</th><th scope="col">分類</th><th scope="col" style="text-align:right">原価</th><th scope="col">取扱</th><th scope="col"><span class="sr">並べ替え・外す</span></th></tr></thead>
              <tbody id="comp-rows">
              <% editRows.forEach((x, i) => { %>
                <tr class="comp-row">
                  <td class="no"><%= i + 1 %></td>
                  <td><input class="in mono c-code" style="width:150px" aria-label="<%= i + 1 %> 行目の構成品のコード" value="<%= x.code %>"<%= compEditable ? '' : ' disabled' %>> <span class="c-name"><%= x.name %></span></td>
                  <td><input class="in c-qty" style="width:70px;text-align:right" inputmode="numeric" aria-label="<%= i + 1 %> 行目 (<%= x.code %>) の数" value="<%= x.qty %>"<%= compEditable ? '' : ' disabled' %>></td>
                  <td class="c-tax"><%= x.tax_rate == null ? '未' : fmt.tax(x.tax_rate) %></td><td class="c-sales"><%= x.sales_class ?? '未' %></td><td class="c-cost n"><%= x.cost_jpy == null ? '未' : yen(x.cost_jpy) %></td><td class="c-handling"><%= HANDLING[x.handling] || x.handling %></td>
                  <td class="acts"><button type="button" class="iconbtn" data-act="up" aria-label="<%= i + 1 %> 行目 (<%= x.code %>) を上へ"<%= compEditable ? '' : ' disabled' %>><svg class="ic s" aria-hidden="true"><use href="#i-up"/></svg></button><button type="button" class="iconbtn" data-act="down" aria-label="<%= i + 1 %> 行目 (<%= x.code %>) を下へ"<%= compEditable ? '' : ' disabled' %>><svg class="ic s" aria-hidden="true"><use href="#i-down"/></svg></button><button type="button" class="iconbtn del" data-act="del" aria-label="<%= i + 1 %> 行目 (<%= x.code %>) を外す"<%= compEditable ? '' : ' disabled' %>><svg class="ic s" aria-hidden="true"><use href="#i-trash"/></svg></button></td>
                </tr>
              <% }) %>
              </tbody>
            </table></div>
            <template id="comp-tpl"><tr class="comp-row"><td class="no"></td><td><input class="in mono c-code" style="width:150px" aria-label="構成品のコード" placeholder="商品コード"> <span class="c-name"></span></td><td><input class="in c-qty" style="width:70px;text-align:right" inputmode="numeric" aria-label="数" value="1"></td><td class="c-tax"></td><td class="c-sales"></td><td class="c-cost n"></td><td class="c-handling"></td><td class="acts"><button type="button" class="iconbtn" data-act="up" aria-label="上へ"><svg class="ic s" aria-hidden="true"><use href="#i-up"/></svg></button><button type="button" class="iconbtn" data-act="down" aria-label="下へ"><svg class="ic s" aria-hidden="true"><use href="#i-down"/></svg></button><button type="button" class="iconbtn del" data-act="del" aria-label="外す"><svg class="ic s" aria-hidden="true"><use href="#i-trash"/></svg></button></td></tr></template>
            <div style="display:flex;gap:12px;align-items:center;margin-top:6px;flex-wrap:wrap"><button class="btn sm" type="button" id="comp-add"<%= compEditable ? '' : ' disabled' %>><svg class="ic s" aria-hidden="true"><use href="#i-plus"/></svg>構成品を足す</button>
              <span class="hint">1〜<%= MAX_COMPONENTS %> 品 · 数は 1〜999 · 同じ品は 1 行 · セットは入れられません · 並び = NE の並び · 今の構成に戻すと依頼を取り下げます</span></div>
          </div>
          <div style="margin-top:14px">
            <div class="hint" style="margin-bottom:8px">計算で決まる値 (今の構成から · ここでは入れません)</div>
            <% const t = (d) => (d.tax.taxRate == null ? '未決' : fmt.tax(d.tax.taxRate) + '%'); const rqd = dv.requested; %>
            <div class="tiles">
              <div class="tile"><div class="tl2">税率<span class="fx">計算</span></div><div class="tv"><%= t(dv.current) %></div><div class="tr"><%= dv.current.tax.taxClass === 'MIXED' ? '8% と 10% の混在' : '' %><%= rqd ? ' 依頼どおりなら ' + t(rqd) : '' %></div></div>
              <div class="tile"><div class="tl2">売上分類<span class="fx">計算</span></div><div class="tv"><%= dv.current.salesClass == null ? '未決' : SALES[dv.current.salesClass] %></div><div class="tr"><%= dv.current.salesSource === 'override' ? '上書き' : '' %><%= rqd ? ' 依頼どおりなら ' + (rqd.salesClass == null ? '未決' : rqd.salesClass) : '' %></div></div>
              <div class="tile"><div class="tl2">原価 (合計)<span class="fx">計算</span></div><div class="tv"><%= dv.current.cost.status === 'COMPLETE' ? yen(dv.current.cost.jpy) : '—' %><small> 円</small></div><div class="tr"><%= dv.current.cost.status === 'COMPLETE' ? '' : '合計できない' %><%= rqd ? ' 依頼どおりなら ' + (rqd.cost.status === 'COMPLETE' ? yen(rqd.cost.jpy) + ' 円' : '合計できない') : '' %></div></div>
              <div class="tile"><div class="tl2">単品の売価の合計<span class="fx">計算</span></div><div class="tv"><%= dv.current.price_sum == null ? '—' : yen(dv.current.price_sum) %><small> 円</small></div><div class="tr"><%= rqd ? '依頼どおりなら ' + (rqd.price_sum == null ? '—' : yen(rqd.price_sum) + ' 円') : '' %></div></div>
            </div>
            <div class="hint" style="margin-top:8px">保存している値: 税 <%= c.tax_rate == null ? '未入力' : fmt.tax(c.tax_rate) + '%' %> (<%= { STANDARD_10: '標準', REDUCED_8: '軽減', MIXED: '混在', UNKNOWN: '不明' }[c.tax_class] || c.tax_class || '—' %>) · 原価 <%= c.cost_today ? yen(c.cost_today.cost_jpy) + ' 円 (' + (SRC[c.cost_today.cost_source] || c.cost_today.cost_source) + ')' : '未入力' %> · 取扱 <%= HANDLING[c.handling] || c.handling %></div>
            <% for (const b of dv.current.blockers) { %><div class="blk"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><span>今の構成: <%= b %></span></div><% } %>
            <% for (const w of dv.current.warnings) { %><div class="wrn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>今の構成: <%= w %></span></div><% } %>
            <% if (rqd) { for (const b of rqd.blockers) { %><div class="blk"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><span>依頼の構成: <%= b %></span></div><% } for (const w of rqd.warnings) { %><div class="wrn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>依頼の構成: <%= w %></span></div><% } } %>
          </div>
        </section>

        <section class="panel" id="p-basic" aria-labelledby="h-basic">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-tag"/></svg></span><h2 id="h-basic">基本</h2></div>
          <%- row('name', 'セット名', '<input class="in w-l" id="f-name" autocomplete="off" ' + meta('name') + ' value="' + h(c.name) + '">', c.name, { forId: 'f-name' }) %>
          <% const ps = dv.current.price_sum; const diffP = ps != null && c.standard_price != null ? c.standard_price - ps : null; %>
          <%- row('standard_price', '標準売価', '<span class="yen"><input class="in w-s" id="f-standard_price" inputmode="numeric" autocomplete="off" ' + meta('standard_price') + ' data-unit=" 円" value="' + h(c.standard_price ?? '') + '"></span><span class="unit">円</span>', c.standard_price == null ? '未入力' : yen(c.standard_price) + ' 円', { forId: 'f-standard_price', hint: ps == null ? '単品の売価の合計は出せません' : '単品の売価の合計 ' + yen(ps) + ' 円' + (diffP == null || diffP === 0 ? '' : diffP < 0 ? 'より ' + yen(-diffP) + ' 円安い' : 'より ' + yen(diffP) + ' 円高い') }) %>
          <%- row('handling_own', '希望する取扱', seg('handling_own', c.handling_own ?? '', [['active', '取扱中'], ['discontinued', '中止']]) + (c.handling_own == null ? '<span class="hint">いまは決めていません (構成品から決めています)</span>' : ''), c.handling_own == null ? '決めていない (構成品から)' : HANDLING[c.handling_own]) %>
          <div class="f"><div class="lab">いまの実際の状態</div><div class="ctl"><span class="b <%= c.handling === 'discontinued' ? 'mute' : 'ok' %>"><% if (c.handling !== 'discontinued') { %><span class="dot" aria-hidden="true"></span><% } %><%= HANDLING[c.handling] || c.handling %></span><span class="hint"><%= c.components.some((x) => x.handling === 'discontinued') ? '中止の構成品があるので中止です。' : c.handling_own === 'discontinued' ? 'セット自身を中止にしているので中止です。' : '' %>構成品が 1 つでも中止になると、セットも中止になります</span></div></div>
        </section>
        <section class="panel" aria-labelledby="h-logi">
          <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-truck"/></svg></span><h2 id="h-logi">物流</h2></div>
          <% if (shippingRates) { %>
            <%- row('shipping_code', '送料', '<select class="in w-m" id="f-shipping_code" ' + meta('shipping_code') + '>' + (!c.shipping_code ? '<option value="" selected>(未入力)</option>' : '') + shippingRates.map((r) => '<option value="' + h(r.code) + '"' + (r.code === c.shipping_code ? ' selected' : '') + '>' + h(r.code) + ' · ' + h(r.method || '') + ' / ' + yen(r.cost) + ' 円</option>').join('') + (c.shipping_code && !shippingRates.some((r) => r.code === c.shipping_code) ? '<option value="' + h(c.shipping_code) + '" selected>' + h(c.shipping_code) + ' (表に無い)</option>' : '') + '</select>', shipText, { forId: 'f-shipping_code', hint: '方法と金額は送料の表から決まります' }) %>
          <% } else { %>
            <div class="f" data-row="shipping_code"><div class="lab">送料</div><div class="ctl"><%- lockval(shipText) %><span class="lockwhy">送料の表が読めないので直せません</span></div></div>
          <% } %>
          <%- row('reorder_months', '推奨保有月数', '<span class="stepper"><button type="button" data-step="-1" aria-label="1 か月へらす">−</button><input id="f-reorder_months" inputmode="decimal" autocomplete="off" ' + meta('reorder_months') + ' data-unit=" か月" value="' + h(c.reorder_months ?? '') + '" placeholder="—"><button type="button" data-step="1" aria-label="1 か月ふやす">＋</button></span><span class="unit">か月</span>', c.reorder_months == null ? '未入力' : c.reorder_months + ' か月', { forId: 'f-reorder_months' }) %>
        </section>
        <details class="more panel soft" style="padding:14px 18px"<%= c.set_sales_class_override != null || (c.open_cost && c.open_cost.cost_source !== 'set_calc') ? ' open' : '' %>>
          <summary style="border:0;padding:0"><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>例外のとき (ふだんは使いません) — 売上分類の上書き・例外原価</summary>
          <div class="body">
            <%- row('set_sales_class_override', '売上分類の上書き', '<select class="in w-m" id="f-set_sales_class_override" ' + meta('set_sales_class_override') + '><option value=""' + (c.set_sales_class_override == null ? ' selected' : '') + '>— 構成品から' + (dv.current.salesFromComponents != null ? ' (いまは ' + dv.current.salesFromComponents + ')' : '') + '</option>' + Object.entries(SALES).map(([k, v]) => '<option value="' + k + '"' + (String(c.set_sales_class_override) === k ? ' selected' : '') + '>' + v + '</option>').join('') + '</select>', c.set_sales_class_override == null ? '構成品から' : SALES[c.set_sales_class_override], { forId: 'f-set_sales_class_override', hint: '構成品から決まらないとき (未入力の構成品・輸出 4 が混ざる) だけ' }) %>
            <div class="f" data-row="exception_cost"><div class="lab">例外原価</div><div class="ctl"><span class="muted">いま: <%= c.open_cost ? yen(c.open_cost.cost_jpy) + ' 円 (' + (SRC[c.open_cost.cost_source] || c.open_cost.cost_source) + ' · ' + ui.fmtDay(c.open_cost.valid_from, page.today) + ' から)' : '未入力' %></span></div></div>
            <% if (FC.own) { %><div class="f"><div class="lab">新しい例外原価</div><div class="ctl"><%- lockval('入れられません') %><span class="lockwhy" id="xcost-future"><%= futureWhy %></span></div></div>
            <% } else if (editable('exception_cost')) { %>
              <div class="f"><label class="lab" for="xcost-jpy">新しい例外原価</label><div class="ctl"><span class="yen"><input class="in w-s" id="xcost-jpy" inputmode="numeric" autocomplete="off" placeholder="0" <%- meta('exception_cost') %> data-unit=" 円"></span><span class="unit">円</span><span class="hint">今日 (<%= ui.fmtDay(page.today) %>) から</span></div></div>
              <div class="f"><label class="lab" for="xcost-reason">理由 <span class="req">必須</span></label><div class="ctl"><input class="in w-full" id="xcost-reason" maxlength="200"></div></div>
              <div class="f"><div class="lab">合計に戻す</div><div class="ctl"><label style="display:inline-flex;gap:8px;align-items:center"><input type="checkbox" id="xcost-clear" data-field="exception_cost" data-dirty-field="exception_cost" data-label="例外原価" data-ne="<%= neOf('exception_cost') %>"> 例外原価をやめる (構成品の合計に戻す)</label></div></div>
            <% } else { %><div class="f"><div class="lab">新しい例外原価</div><div class="ctl"><%- lockval('直せません') %><%- lockWhy('exception_cost') %></div></div><% } %>
          </div>
        </details>
      <% } %>
      </div>

      <aside class="side" aria-label="保存と関わり">
        <section class="panel savebox hud" id="savebox" aria-labelledby="h-save" tabindex="-1">
          <div class="mobilebar"><span class="grow"><b class="mb-n">未保存の変更はありません</b></span><button class="btn soft sm" type="button" id="savebox-toggle" aria-expanded="false" aria-controls="savebox">確認して保存</button></div>
          <div class="panel-h" style="margin-bottom:10px"><h2 id="h-save">保存すると変わること</h2><span class="right"><span class="b mute count" id="save-count">0 件</span></span></div>
          <ul class="diff" id="save-diff" aria-live="polite"></ul>
          <div class="empty" id="save-empty"><% if (canSave) { %>まだ何も変えていません。<br>変えた欄は黄色く光り、ここに「前 → 後」が出ます。<% } else { %>この画面ではいま保存できません。<% } %></div>
          <div class="impact" id="save-impact" hidden><div class="it">保存するとこうなる</div><ul id="save-impact-list"></ul></div>
          <% if (canSave) { %>
          <label class="lab2" for="reason" id="reason-lab">理由 (なくてもよい)</label>
          <input class="in" id="reason" maxlength="200" autocomplete="off" placeholder="例: 仕入値の改定">
          <div class="needreason" id="needreason" hidden><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg><span id="needreason-t"></span></div>
          <button class="btn pri lg block" id="save" type="button" disabled aria-keyshortcuts="Control+S">保存する <span class="kbd" aria-hidden="true">Ctrl</span><span class="kbd" aria-hidden="true">S</span></button>
          <div class="below"><button class="btn ghost sm" type="button" id="revert" disabled><svg class="ic s" aria-hidden="true"><use href="#i-undo"/></svg>変更を元に戻す</button><span>通信が切れて押し直しても大丈夫</span></div>
          <% } %>
          <div class="msgline" id="msg" role="status" aria-live="polite"></div>
          <div id="result" aria-live="polite"></div>
        </section>

        <section class="panel" aria-labelledby="h-use">
          <div class="panel-h" style="margin-bottom:10px"><h2 id="h-use">使われ方</h2></div>
          <div class="kv">
            <% if (!isSet) { %><div class="row"><span class="k">セット <%= page.usedIn.length %> 件</span><span class="v"><% if (!page.usedIn.length) { %><span class="muted">なし</span><% } %><% for (const u of page.usedIn) { %><a class="linkchip" href="<%= base %>/sku/<%= encodeURIComponent(u.code) %>" title="<%= u.name %>"><span class="mono"><%= u.code %></span>×<%= u.qty %></a><% } %></span></div><% } %>
            <div class="row"><span class="k">Amazon SKU</span><span class="v"><% if (page.amazon) { %><a class="linkchip" href="<%= base %>/amazon/?q=<%= encodeURIComponent(c.code) %>"><%= page.amazon %> 件を見る</a><% } else { %><span class="muted">0 件</span><% } %></span></div>
            <div class="row"><span class="k">NE の待ち</span><span class="v"><% if (page.csvRows.length) { %><span class="b warn">NE に取り込む CSV <%= page.csvRows.length %> 列</span><span class="hint" style="display:block"><%= page.csvRows.map((r) => r.col + (r.child ? '(' + r.child + ')' : '')).join('・') %> · <a href="/apps/master-decisions/csv">マスタの判断 ↗</a></span><% } else if (isSet && c.component_request) { %><span class="b warn">構成の依頼 1 件</span><% } else { %><span class="b ok"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>なし</span><% } %></span></div>
          </div>
        </section>

        <% if (extras) { const st = extras.stock; const stockN = isSet ? extras.buildable : extras.qty; %>
        <%# 参考 (ほかのアプリの値・読むだけ): 在庫 = ロジザード (セットは構成品から作れる数)・注文残 = 発注アプリの台帳 (apps/master-edit/extras.mjs) %>
        <section class="panel refbox" aria-labelledby="h-ref" id="ref-box">
          <div class="panel-h" style="margin-bottom:10px"><h2 id="h-ref">在庫・注文残</h2><span class="sub">参考 (ほかのアプリの値)</span></div>
          <div class="kv">
            <div class="row"><span class="k"><%= isSet ? '作れる数' : '在庫' %> (ロジザード)</span><span class="v">
              <% if (!st || !st.ok) { %><span class="when bad" id="ref-stock-when">読めない<%= st && st.error ? ' (' + st.error + ')' : '' %></span>
              <% } else { %><span class="big" id="ref-stock"><%= stockN == null ? '—' : stockN.toLocaleString('ja-JP') %></span>
                <span class="when<%= st.stale ? ' stale' : '' %>" id="ref-stock-when" style="display:block"><%= st.stale ? '古い · ' : '' %><%= ui.fmtJst(st.asOf, { nowMs }) %> 時点<%= isSet ? ' · 構成品の在庫 ÷ 数 の小さい方' : '' %></span><% } %>
            </span></div>
            <% const fx = extras.fba; %>
            <%# FBA (JP) = Company DB の在庫の日次 (朝の SP-API のレポート・最新の complete の日)。この SKU 1 個だけの出品の合計 (まとめ売り・セットの出品は下に別に・合計に入れない) %>
            <div class="row"><span class="k">FBA (JP) 販売可能</span><span class="v">
              <% if (!fx || !fx.ok) { %><span class="when bad" id="ref-fba-when">読めない<%= fx && fx.error ? ' (' + fx.error + ')' : '' %></span>
              <% } else { %><span class="big" id="ref-fba"><%= fx.total ? fx.total.available.toLocaleString('ja-JP') : '—' %></span>
                <span class="when<%= fx.day.stale ? ' stale' : '' %>" id="ref-fba-when" style="display:block"><%= fx.day.stale ? '古い · ' : '' %><%= ui.fmtJst(fx.day.asOf, { nowMs }) %> 時点 (Amazon の朝のレポート)<%= fx.day.newer ? ' · ' + ui.fmtDay(fx.day.newer.date) + ' は' + fx.day.newer.words + 'ので前の日の値' : '' %></span>
                <% if (!fx.total) { %><span class="hint" id="ref-fba-none" style="display:block">この SKU 1 個だけの出品が、その日の FBA のレポートにありません</span><% } %>
              <% } %>
            </span></div>
            <% if (fx && fx.ok && fx.total) { const T = fx.total; const allUnknown = T.unknown === fx.rows.length; const fc = (n) => allUnknown ? '不明' : n.toLocaleString('ja-JP') + (T.unknown ? ' +不明' : ''); %>
            <table id="ref-fba-parts"><thead><tr><th scope="col">FBA の内訳</th><th scope="col" class="n">数</th></tr></thead><tbody>
              <tr><td>販売可能</td><td class="n"><%= T.available.toLocaleString('ja-JP') %></td></tr>
              <tr><td>FC 移管中</td><td class="n"><%= fc(T.transfer) %></td></tr>
              <tr><td>FC 処理中</td><td class="n"><%= fc(T.processing) %></td></tr>
              <tr><td>出荷待ち (注文の引き当て)</td><td class="n"><%= fc(T.customer) %></td></tr>
              <tr><td>入荷待ち (納品の途中)</td><td class="n"><%= T.inbound.toLocaleString('ja-JP') %></td></tr>
            </tbody></table>
            <% if (T.unknown) { %><div class="hint" id="ref-fba-unknown">不明 = その出品 SKU が Amazon の RESTOCK レポートに無かった (0 ではなく分からない)</div><% } %>
            <% if (fx.rows.length > 1) { %><div class="hint" id="ref-fba-skus">出品 SKU <%= fx.rows.length %> つの合計: <%= fx.rows.map((r) => r.code + ' ' + r.available.toLocaleString('ja-JP')).join(' · ') %></div><% } else { %><div class="hint" id="ref-fba-skus">出品 SKU <%= fx.rows[0].code %></div><% } %>
            <% } %>
            <% if (fx && fx.ok && fx.bundles.length) { %>
            <div class="hint" id="ref-fba-bundles" style="margin-top:4px">まとめ売り・セットの出品 (上の数に入れていない): <%= fx.bundles.slice(0, 6).map((b) => b.code + (b.others ? ' (ほか ' + b.others + ' 品と' + (b.qty > 1 ? '・×' + b.qty : '') + ')' : ' ×' + b.qty) + ' = ' + (b.available == null ? '—' : b.available.toLocaleString('ja-JP'))).join(' · ') %><%= fx.bundles.length > 6 ? ' · ほか ' + (fx.bundles.length - 6) + ' 件' : '' %></div>
            <% } %>
            <% if (!isSet) { const bo = extras.backorder; %>
            <div class="row"><span class="k">注文残 (発注アプリ)</span><span class="v">
              <% if (bo && bo.denied) { %><span class="when" id="ref-po-why">注文残 (発注アプリの権限がないので出せません)</span>
              <% } else if (!bo || !bo.ok) { %><span class="when bad" id="ref-po-why">読めない</span>
              <% } else { %><span class="big" id="ref-po"><%= bo.total.toLocaleString('ja-JP') %></span><% if (!bo.lines.length) { %> <span class="when">なし</span><% } %><% } %>
            </span></div>
            <% if (bo && bo.ok && bo.lines.length) { %>
            <table id="ref-po-lines"><thead><tr><th scope="col">発注日</th><th scope="col">仕入先</th><th scope="col" class="n">数</th><th scope="col">納期</th></tr></thead><tbody>
              <% for (const l of bo.lines.slice(0, 8)) { %><tr><td><%= ui.fmtJst(l.issuedAt, { nowMs }).replace(/ \d\d:\d\d$/, '') %></td><td class="sup"><%= l.supplierName || l.supplierCode %></td><td class="n"><%= Number(l.remaining).toLocaleString('ja-JP') %></td><td><%= l.due ? ui.fmtDay(l.due, page.today) + (l.dueKind === 'promised' ? ' 回答' : ' 希望') : '未定' %></td></tr><% } %>
            </tbody></table>
            <% if (bo.lines.length > 8) { %><div class="hint">ほか <%= bo.lines.length - 8 %> 件</div><% } %>
            <a class="hint" href="/apps/purchase-orders">発注アプリで見る <svg class="ic s" style="vertical-align:-2px" aria-hidden="true"><use href="#i-ext"/></svg></a>
            <% } %>
            <% } %>
          </div>
        </section>
        <% } %>

        <% if (page.regItems.length || page.card) { %>
        <section class="panel" aria-labelledby="h-reg" id="card-box" data-base="<%= base %>" data-code="<%= c.code %>">
          <div class="panel-h" style="margin-bottom:10px"><h2 id="h-reg">この商品の登録</h2></div>
          <div class="kv">
            <% if (page.regItems.length) { %><div class="row"><span class="k">NE 登録の CSV</span><span class="v"><% for (const i of page.regItems) { %><span class="b <%= ['verified'].includes(i.state) ? 'ok' : ['failed', 'superseded'].includes(i.state) ? 'mute' : 'info' %>" style="margin:0 4px 4px 0">ファイル #<%= i.export_id %><%= i.trial ? ' · 試し用' : '' %></span><span class="hint" style="display:block"><%= REG_ITEM_STATES[i.state] || i.state %></span><% } %><a class="hint" href="<%= base %>/reg-csv">NE 登録の CSV を開く →</a></span></div><% } %>
            <% if (page.card) { const cr = page.card.result || {}; %>
            <div class="row"><span class="k">出品カード</span><span class="v">
              <span class="b <%= page.card.status === 'done' ? 'ok' : page.card.status === 'conflict' || page.card.status === 'failed' ? 'err' : 'warn' %>"><% if (page.card.status === 'done') { %><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg><% } %><%= CARD_STATUS_LABELS[page.card.status] || page.card.status %></span>
              <% if (page.card.status === 'done' && cr.draft_id) { %> <a class="hint" href="/apps/product-hub/detail/<%= cr.draft_id %>">product-hub で開く ↗</a><% } %>
              <% if (page.card.status === 'conflict' && cr.conflict_draft_id) { %> <a class="hint" href="/apps/product-hub/detail/<%= cr.conflict_draft_id %>">同じコードのカード ↗</a><% } %>
              <% if (page.card.status === 'conflict' && cr.ambiguous && Array.isArray(cr.conflict_draft_ids)) { %><% cr.conflict_draft_ids.forEach((d) => { %> <a class="hint" href="/apps/product-hub/detail/<%= d %>">#<%= d %> ↗</a><% }) %><% } %>
              <span class="hint" style="display:block">試した回数 <%= page.card.attempts %><%= page.card.last_error ? ' · ' + page.card.last_error : '' %></span>
              <% if (page.card.status !== 'done' && canEdit && !dbError && !cancelled) { %><button type="button" class="btn sm" id="card-retry" style="margin-top:6px">カードをもう一度作る</button><% } %>
              <% if (page.card.status === 'conflict' && cr.conflict_draft_id && canEdit && !dbError && !cancelled) { %><button type="button" class="btn sm" id="card-link" data-draft="<%= cr.conflict_draft_id %>" style="margin-top:6px">既存のカード (#<%= cr.conflict_draft_id %>) をこの商品に結ぶ</button><% } %>
              <% if (page.card.status !== 'done') { %><span class="hint" style="display:block">カードは登録の後に作ります。うまくいかなかったときは、product-hub のボードを開いたときにも作り直します。</span><% } %>
              <% if (page.card.status === 'conflict' && cr.ambiguous) { %><span class="hint" style="display:block">同じ商品コードのカードが product-hub に 2 枚以上あります。どれに結ぶか決められないので「結ぶ」は出しません。product-hub で 1 枚に片付けてから「カードをもう一度作る」を押してください。</span>
              <% } else if (page.card.status === 'conflict') { %><span class="hint" style="display:block">同じ商品コードのカードが product-hub にもうあります。そのカードがこの商品のものなら「結ぶ」を押してください (カードの空の欄だけ、この登録の値で埋めます。入っている欄は変えません)。違う商品なら product-hub でそのカードを片付けてから「もう一度作る」。</span><% } %>
              <% if (page.card.status === 'done' && cr.outcome === 'linked' && Array.isArray(cr.not_applied) && cr.not_applied.length) { %><span class="hint" style="display:block">結んだときにカードに入っていたので変えなかった欄: <%= cr.not_applied.map((x) => x.label + ' (カード ' + x.card + ' / 登録 ' + x.entered + ')').join('・') %> · product-hub で確かめてください</span><% } %>
              <span class="msgline" id="card-msg" role="status" aria-live="polite"></span>
            </span></div>
            <% } %>
          </div>
        </section>
        <% } %>

        <section class="panel" aria-labelledby="h-recent">
          <div class="panel-h" style="margin-bottom:10px"><h2 id="h-recent">最近の変更</h2><span class="right"><a href="<%= base %>/sku/<%= encodeURIComponent(c.code) %>/history" class="hint">ぜんぶ見る →</a></span></div>
          <% if (!recent.length) { %><div class="hint">まだありません</div><% } else { %>
          <ul class="mini-hist">
            <% for (const x of recent.slice(0, 4)) { %><li><%= x.w.text %><span class="w"><%= ui.fmtJst(x.e.recorded_at, { nowMs }) %> · <%= ui.actorWords(x.e) %><%= x.e.reason_text ? ' · ' + x.e.reason_text : '' %></span></li><% } %>
          </ul>
          <% } %>
        </section>
      </aside>
    </form>
    <script type="application/json" id="me-page"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
  <% } %>
  </div>
  <%- include('_footer') %>
  <% if (page) { %><script src="<%= base %>/public/me-sku.js?v=<%= assetV %>" defer></script><% } %>
</body>
</html>
