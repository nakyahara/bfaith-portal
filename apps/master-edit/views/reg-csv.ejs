<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
  <%- include('_header') %>
  <%
    // NE 登録の CSV (🆕 10/20 中原さん「過去の履歴表示が邪魔なうえにまとまりごとでアップしないといけないから面倒。ボタンをワンクリックしたら CSV が作成できるように。画面遷移がおおい」):
    //   上から ① 次の CSV (ボタン 1 つ = 単品 1 つ・セット 1 つのファイルを作ってダウンロード) ② NE で取り込む (ダウンロード・「取り込んだ」のボタン 1 つ)
    //   ③ 直すもの (1 行ずつ・商品の画面へのリンク) ④ NE にもうある商品 (短い 1 行)。前のファイル・まとまりの回は「これまでの記録」にたたむ。
    //   分け方は lib の regPlan (= buildRegAll と同じ決まり)。画面の動き = public/me-regcsv.js
    const S = summary;
    const canAct = canApprove && !dbError && !closed && !!S && S.applied;
    const dis = canAct ? '' : ' disabled';
    const kindLabel = { products: '単品', sets: 'セット' };
    const STATE_BADGE = { built: 'warn', issued: 'info', declared: 'info', closed: 'mute' };
    const CLOSE_BADGE = { finished: 'ok', superseded: 'mute', rejected_all: 'err' };
    const RESULT_DESC = { ok: ['i-check', 'NE の履歴が「処理成功」で、失敗の件数が無い'], partial: ['i-warn', '「処理成功」でも、メッセージに「N件失敗」がある'], rejected_all: ['i-x', '取り込めなかった'] };
    const COL_WORDS = { name: '名前', cost: '原価', price: '売価', supplier: '仕入先', tax_rate: '税率', handling: '取扱区分', parent: '代表商品コード', children: '構成', jan: 'JAN' };
    const when = (v) => (v ? ui.fmtJst(v, { nowMs }) : '');
    const shortSha = (s) => (s ? String(s).slice(0, 8) + '…' + String(s).slice(-6) : '');
    // 🆕 0095: 代表 (親) の門の 1 行 (ずれた商品のコードは商品の画面へのリンク = そこで「NE の代表を採用する」)
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    const gateHtml = (g) => esc(g.pre) + g.codes.map((x) => `<a href="${esc(base)}/sku/${esc(encodeURIComponent(x))}">${esc(x)}</a>`).join('・') + esc(g.post);
    const skuLink = (code) => `<a class="mono" href="${esc(base)}/sku/${esc(encodeURIComponent(code))}">${esc(code)}</a>`;
    // 🆕 0098: 「NE にあるので登録済みにする」の行ごと (DB の確かめ = S.dine[コード])。押せる = ボタン 1 つ (public/me-draft-in-ne.js)・押せない = DB の理由の最初の 1 つ
    const DINE_BUTTON = 'NE にあるので登録済みにする';
    const dineOf = (code) => (S && S.dine && Object.prototype.hasOwnProperty.call(S.dine, code) ? S.dine[code] : null);
    const dineHtml = (code) => {
      const d = dineOf(code);
      if (!d) return '';
      if (!d.canGo) return d.why.length ? `<span class="hint" data-dine-why="${esc(code)}">(登録済みにはまだできません: ${esc(d.why[0].text)})</span>` : '';
      return `<span class="dine-row" data-dine-row><button class="btn sm pri" type="button" data-dine-code="${esc(code)}" data-dine-hash="${esc(d.checkHash)}"${canAct ? '' : ' disabled'}>${esc(DINE_BUTTON)}</button>`
        + `${d.diffs.length ? `<span class="hint">NE とちがう所: ${esc(d.diffs.join('・'))}</span>` : ''}<span class="msgline" data-dine-msg role="status" aria-live="polite"></span></span>`;
    };
    const steps = (e) => {
      const done = (x) => ({ t: x, cls: 'done' });
      if (e.state === 'built') return [done('作った'), { t: '配る (ダウンロード)', cls: 'cur' }, { t: 'NE で取り込む' }, { t: '翌朝の確かめ (自動)' }];
      if (e.state === 'issued') return [done('作った'), done('配った'), { t: 'NE で取り込む', cls: 'cur' }, { t: '翌朝の確かめ (自動)' }];
      if (e.state === 'declared') return [done('作った'), done('配った'), done('申告した'), { t: '翌朝の確かめ (自動)', cls: 'cur' }];
      if (e.close_reason === 'finished') {
        // 🆕 10/24: 翌朝の確かめで NE に無かった (取り込めなかった) 商品がある = 「確かめ終わった」に見せない (その商品は「次の CSV」に戻る)
        const nf = notInNe(e);
        return [done('作った'), done('配った'), ...(e.declared_at ? [done('申告した')] : []), nf ? { t: `NE に入らなかった ${nf} 件 (次の CSV に戻した)`, cls: 'bad' } : done('翌朝の確かめ')];
      }
      return [done('作った'), { t: CLOSE_REASONS[e.close_reason] || '閉じた', cls: 'bad' }];
    };
    // 🆕 10/24 (中原さん「セット商品を作成した場合の NE への登録 CSV が DL できない・動線もおかしい」): ブラウザは 2 つ目の自動のダウンロードを黙って止める =
    //   ファイルごとに大きなダウンロードのボタン (押した 1 回 = 1 つ)・NE の取り込み先・「NE に取り込んだ」はダウンロードした後だけ押せる (画面の動き = me-regcsv.js)
    const NE_UPLOAD_URL = 'https://main.next-engine.com/User_Syohin_Csvupload_Item/upload';
    // セットも同じ NE の画面 ([商品] → [商品管理の一括登録]) の「CSV のアップロード」で「セット商品情報 CSV」を選んで取り込む
    //   (NE の画面の写し = AI_reference の captures_ne_syohin_up・つかいかた #reg-csv と同じ。セットだけの別の画面は無い)
    const NE_SET_UPLOAD_URL = NE_UPLOAD_URL;
    const NE_PICK = { products: '商品 CSV', sets: 'セット商品情報 CSV' };
    const neUrl = (e) => (e.kind === 'sets' ? NE_SET_UPLOAD_URL : NE_UPLOAD_URL);
    // ダウンロードできるのは配ってから 2 時間 (DB の ops.ne_reg_file。lib の download_until)。許可が先に切れたときは押した時に DB が答える (409 の文をカードに出す)
    const dlOpen = (e) => e.download_open === true;   // DB の時計 (lib の download_open)
    const needDl = canAct ? ' data-need-dl disabled' : ' disabled';   // ダウンロードするまで押せない (JS がこのブラウザでダウンロードした印を見て外す)
    const notInNe = (e) => e.items.filter((i) => i.state === 'failed' && i.failed_reason === 'not_in_ne').length;
    let P = null, toDownload = [], toImport = [], toCheck = [], partials = [], trialDone = [], waitingItems = 0, againCodes = [];
    if (S && S.applied) {
      P = S.plan;
      const open = S.exports.filter((e) => e.state !== 'closed');
      toDownload = open.filter((e) => e.state === 'built');
      toImport = open.filter((e) => e.state === 'issued' && e.items.some((i) => i.state === 'issued'));
      // 🆕 10/24: 「NE に取り込んだ」を押したファイル = 翌朝の確かめ待ち (このブラウザでダウンロードしていなければ一言・本番 #22 = 落とさずに押した)
      toCheck = open.filter((e) => e.state === 'declared');
      partials = open.flatMap((e) => e.items.filter((i) => i.state === 'partial').map((i) => ({ e, i })));
      waitingItems = open.filter((e) => !toDownload.includes(e) && !toImport.includes(e) && !toCheck.includes(e)).reduce((a, e) => a + e.items.filter((i) => ['issued', 'import_declared'].includes(i.state)).length, 0);
      // 🆕 10/24: 前の CSV で NE に入らなかった (翌朝 NE に無かった) 商品が「次の CSV」に戻っている = その一言
      const inPlan = new Set([...P.singles, ...P.groups.flatMap((g) => g.codes), ...P.sets].map((c) => String(c).toLowerCase()));
      againCodes = [...new Set(S.exports.flatMap((e) => e.items.filter((i) => i.state === 'failed' && i.failed_reason === 'not_in_ne' && inPlan.has(String(i.code).toLowerCase())).map((i) => i.code)))];
      // 試し用のセットのファイルが全部 NE で確かめ済み = この形を「実機で確かめた」にする (中原さんの番)
      trialDone = S.exports.filter((e) => e.trial && e.items.length && e.items.every((i) => i.state === 'verified') && e.verify && e.verify.can && !e.verify_recorded && !(S.verified[e.kind] && S.verified[e.kind].ok));
    }
    // 一部だけ違う品目の 1 行 (NE の値 / CSV の値)
    const diffText = (i) => {
      const cols = i.last_check && i.last_check.detail && i.last_check.detail.compare && i.last_check.detail.compare.cols;
      if (!cols) return '';
      const sh = (v) => { const s = typeof v === 'object' && v !== null ? JSON.stringify(v) : String(v ?? '(空)'); return s.length > 60 ? s.slice(0, 60) + '…' : s; };
      return Object.entries(cols).filter(([, x]) => !x.ok).map(([c, x]) => `${COL_WORDS[c] || c} (NE「${sh(x.observed && x.observed.v !== undefined ? x.observed.v : x.observed)}」/ CSV「${sh(x.expected)}」)`).join('・');
    };
    const nPlan = P ? P.singles.length + P.groups.reduce((a, g) => a + g.codes.length, 0) + P.sets.length : 0;
  %>
  <div class="page" id="rc" data-base="<%= base %>">
    <nav class="crumb" aria-label="いまの場所"><a href="<%= base %>/" data-list-back>商品・セット</a><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg><span aria-current="page">NE 登録の CSV</span></nav>
    <div class="ph">
      <div>
        <h1>NE 登録の CSV</h1>
        <div class="lead">新商品 (下書き) を NE に登録する CSV です。<b style="color:var(--text)">ボタンを押すと CSV ができます → ファイルごとにダウンロード → NE の「商品一括登録」で取り込む → 「NE に取り込んだ」を押す → 翌朝、自動で確かめます</b>。</div>
      </div>
      <div class="ph-actions"><a class="btn" href="<%= base %>/manual#reg-csv"><svg class="ic" aria-hidden="true"><use href="#i-book"/></svg>つかいかた</a></div>
    </div>
    <% if (dbError) { %><div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t"><%= dbError %></div></div></div><% } %>
    <% if (closed) { %><div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow"><div class="t">いまは使えません (<%= closedWhy %>)</div><div class="hint">見るだけです。</div></div></div><% } %>
    <% if (!canApprove) { %><div class="callout info"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><%= approveMessage %></div></div><% } %>
    <% if (S && !S.applied) { %><div class="callout warn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow">NE 登録の CSV の表 (migration 0053) がまだ入っていません。</div></div><% } %>
    <% if (S && S.applied) { %>
    <% if (S.parent_gate_all) { %><div class="callout warn" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow"><div class="t"><%- gateHtml(S.parent_gate_all) %></div><div class="hint">配ったファイルの申告・「取り込めなかった」商品だけの作り直し・使わないはできます。</div></div></div><% } %>
    <% if (P.not_today) { %><div class="callout warn" id="rc-not-today"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">今朝の照合がまだなので、いまは CSV を作れません</div><div class="hint">照合が終わると (ふつうは朝のうちに) 作れます。<%= S.today ? '' : `今日 (${S.today_jst}) の照合の回がまだ` %><%= S.ne_codes.current ? '' : '・NE のコードが今日の分でない' %></div></div></div><% } %>

    <section class="panel" id="next" aria-labelledby="h-next">
      <div class="panel-h"><span class="hico" aria-hidden="true">①</span><h2 id="h-next">次の CSV</h2><span class="sub">いま作れる商品を全部まとめます</span></div>
      <% if (nPlan) { %>
      <p class="next-sum" style="margin:2px 0 10px;font-size:15px">
        <% if (P.singles.length || P.groups.length) { %>単品 <b><%= P.singles.length + P.groups.reduce((a, g) => a + g.codes.length, 0) %></b> 件<% if (P.groups.length) { %> (色違い・サイズ違い <%= P.groups.length %> まとまり <%= P.groups.reduce((a, g) => a + g.codes.length, 0) %> 件を含む)<% } %><% } %><% if (P.sets.length) { %><%= P.singles.length || P.groups.length ? ' と ' : '' %>セット <b><%= P.sets.length %></b> 件<% } %>
      </p>
      <% const chipN = P.singles.length + P.groups.length + P.sets.length; %>
      <% const chipsHtml = () => { let h = ''; for (const c of P.singles) h += `<span class="compchip">${skuLink(c)}</span>`; for (const g of P.groups) h += `<span class="compchip" title="${esc(g.codes.join('・'))}">${skuLink(g.codes[0])}<span class="hint">${g.codes.length > 1 ? ` ほか ${g.codes.length - 1} 件` : ""} (まとまり ${esc(g.group_code)})</span></span>`; for (const c of P.sets) h += `<span class="compchip"><span class="b vio">セット</span> ${skuLink(c)}</span>`; return h; }; %>
      <% if (chipN <= 24) { %><div class="kidchips" id="next-items" style="display:flex;flex-wrap:wrap;gap:6px"><%- chipsHtml() %></div>
      <% } else { %><details class="more" id="next-items-more"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>入る商品を見る</summary><div class="body kidchips" id="next-items" style="display:flex;flex-wrap:wrap;gap:6px"><%- chipsHtml() %></div></details><% } %>
      <div class="buildbar">
        <button class="btn pri lg" type="button" data-act="build-all"<%= canAct && P.files.length ? '' : ' disabled' %>><svg class="ic" aria-hidden="true"><use href="#i-file"/></svg>NE 登録の CSV を作る</button>
        <span class="hint" id="next-hint"><%= P.files.length > 1 ? `押すと CSV が ${P.files.length} つ (${P.files.filter((f) => f.kind === 'products').length ? '単品' + (P.files.filter((f) => f.kind === 'products').length > 1 ? ' ' + P.files.filter((f) => f.kind === 'products').length + ' つ' : '') : ''}${P.files.some((f) => f.kind === 'products') && P.files.some((f) => f.kind === 'sets') ? '・' : ''}${P.files.some((f) => f.kind === 'sets') ? 'セット' : ''}) できます。下に出るボタンで 1 つずつダウンロードしてください` : '押すと CSV ができて、そのままダウンロードされます' %></span>
      </div>
      <% if (againCodes.length) { %><div class="hint" id="next-again" style="margin-top:6px">前の CSV で NE に入らなかった商品 (<%= againCodes.join('・') %>) も入っています。今度は NE で取り込んでから「NE に取り込んだ」を押してください。</div><% } %>
      <% if (P.files.some((f) => f.kind === 'sets' && f.trial)) { %><div class="hint" style="margin-top:6px">セットの CSV はまだ試しの段階です (1 回 <%= S.trial_rows %> 行まで)。NE で確かめられたら、下の「NE で取り込む」にボタンが出ます。</div><% } %>
      <% if (canAct && P.files.length) { %>
      <details class="more" id="pick-some"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>一部を外して作る</summary>
        <div class="body"><div class="hint" style="margin-bottom:6px">外したい商品の印を外してから、上のボタンを押します (色違い・サイズ違いは、まとまりごと)。</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px 18px">
          <% for (const c of P.singles) { %><label class="check-row"><input type="checkbox" class="pick" checked value="<%= c %>" data-codes="<%= JSON.stringify([c]) %>"<%= dis %>><span class="mono"><%= c %></span></label><% } %>
          <% for (const g of P.groups) { %><label class="check-row"><input type="checkbox" class="pick" checked value="<%= g.group_code %>" data-codes="<%= JSON.stringify(g.codes) %>"<%= dis %>><span><span class="mono"><%= g.group_code %></span> のまとまり <%= g.codes.length %> 件</span></label><% } %>
          <% for (const c of P.sets) { %><label class="check-row"><input type="checkbox" class="pick" checked value="<%= c %>" data-codes="<%= JSON.stringify([c]) %>"<%= dis %>><span><span class="b vio">セット</span> <span class="mono"><%= c %></span></span></label><% } %>
          </div></div>
      </details>
      <% } else if (!canAct) { %>
        <div style="display:none"><% for (const c of [...P.singles, ...P.sets]) { %><input type="checkbox" class="pick" value="<%= c %>" disabled><% } %></div>
      <% } %>
      <% } else { %>
      <div class="empty" id="next-empty">いま CSV にできる商品はありません。<% if (!S.candidates.length && !(S.variation || []).length) { %><br>新商品は <a href="<%= base %>/new?kind=single">新商品の登録</a> で下書きにします。<% } %></div>
      <% } %>
      <% if (P.sets_waiting.length) { %><div class="hint" id="sets-waiting" style="margin-top:8px">セット <%= P.sets_waiting.map((x) => x.code).join('・') %> は、構成品が NE に入ってから作れます (構成品を NE に取り込んだ翌朝から)。</div><% } %>
      <%# 試しのセット (#Codex R1 Medium 2・3): 次の CSV が空でも理由つきで出す %>
      <% if (P.sets_later.length) { %><div class="hint" style="margin-top:6px" id="sets-later">セット <%= P.sets_later.join('・') %> は、<%= P.set_trial_waiting ? 'いま NE で確かめている試しのセットの CSV が終わってから' : '次の回に' %>作ります (セットの CSV はまだ試しの段階で、1 回 <%= S.trial_rows %> 行まで)。</div><% } %>
      <% if (P.sets_too_big.length) { %><div class="why-wrn" style="margin-top:6px" id="sets-too-big"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>セット <%= P.sets_too_big.join('・') %> は構成品が多く、1 つの CSV の行の上限 (<%= P.set_trial ? S.trial_rows : S.max_rows %> 行) を超えるので作れません<%= P.set_trial ? ' (セットの試しが確かめられると 1,000 行まで作れます)' : '' %>。</span></div><% } %>
      <div class="msgline" id="build-msg" role="status" aria-live="polite"></div>
    </section>

    <% if (toDownload.length || toImport.length || toCheck.length || trialDone.length || waitingItems) { %>
    <section class="panel" id="todo" aria-labelledby="h-todo">
      <div class="panel-h"><span class="hico" aria-hidden="true">②</span><h2 id="h-todo">NE で取り込む</h2><span class="sub">ファイルごとに ダウンロード → NE で取り込む → 「NE に取り込んだ」</span></div>
      <%# 🆕 10/24: ファイル 1 つ = カード 1 枚。上から順にすること (ダウンロード → NE のどこで何を選ぶか → 「NE に取り込んだ」)。単品とセットの文は混ぜない %>
      <% const dlSteps = (e, first) => { const kl = kindLabel[e.kind]; return `
        <ol class="dlsteps" aria-label="${esc(kl)}の CSV ですること">
          <li data-step="dl">${first}</li>
          <li data-step="ne"><span>NE の [商品] → [商品管理の一括登録] で「<b>${esc(NE_PICK[e.kind])}</b>」を選んで取り込む</span>
            <a class="btn sm" href="${esc(neUrl(e))}" target="_blank" rel="noopener noreferrer" data-ne-link><svg class="ic s" aria-hidden="true"><use href="#i-up"/></svg>NE の商品一括登録を開く ↗</a></li>
          <li data-step="declare">${e.kind === 'sets'
            ? '<span><b>取り込んだら「NE に取り込んだ」を押す</b> (セットは必ず押します。押すと翌朝 NE で確かめます)</span>'
            : '<span>取り込んだら「NE に取り込んだ」を押す (押し忘れても、翌朝 NE に出ていれば自動で確かめます)</span>'}
            <span class="acts"><button class="btn pri" type="button" data-act="declare-quick" data-result="ok"${e.state === 'issued' ? needDl : ' disabled'}><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>NE に取り込んだ</button>
            <span class="hint" data-need-dl-hint>${e.state === 'issued' ? `ダウンロードした後に押せます (先に「${esc(kl)}の CSV をダウンロード」)` : '先にダウンロードしてください'}</span></span></li>
        </ol>`; }; %>
      <% for (const e of toDownload) { const kl = kindLabel[e.kind]; %>
      <article class="filecard todo-card exp" data-id="<%= e.export_id %>" data-kind="<%= e.kind %>" data-sha="<%= e.sha256 %>" data-state="<%= e.state %>" data-file-name="<%= e.file_name %>" aria-label="<%= kl %> <%= e.item_count %> 件の CSV">
        <div class="fh"><span class="ttl"><%= kl %> <%= e.item_count %> 件の CSV</span><span class="b <%= e.kind === 'sets' ? 'vio' : 'mute' %>"><%= kl %></span><span class="b warn" data-dl-badge>まだダウンロードしていません</span></div>
        <div class="fmeta"><span><%= when(e.created_at) %> に作った</span></div>
        <%- dlSteps(e, `<button class="btn pri lg" type="button" data-act="issue"${dis}><svg class="ic" aria-hidden="true"><use href="#i-dl"/></svg>${esc(kl)}の CSV をダウンロード</button><span class="hint">ダウンロードしてから 2 時間、もう一度ダウンロードできます</span>`) %>
        <div class="msgline" data-msg-card role="status" aria-live="polite"></div>
      </article>
      <% } %>
      <% for (const e of toImport) { const notImp = e.items.some((i) => i.last_check && i.last_check.detail && i.last_check.detail.not_imported === true); const kl = kindLabel[e.kind]; const open2 = dlOpen(e); %>
      <article class="filecard todo-card exp" data-id="<%= e.export_id %>" data-kind="<%= e.kind %>" data-sha="<%= e.sha256 %>" data-state="<%= e.state %>" data-file-name="<%= e.file_name %>" data-dl-until="<%= e.download_until || '' %>" aria-label="<%= kl %> <%= e.item_count %> 件の CSV">
        <div class="fh"><span class="ttl"><%= kl %> <%= e.item_count %> 件の CSV</span><span class="b <%= e.kind === 'sets' ? 'vio' : 'mute' %>"><%= kl %></span><span class="b warn" data-dl-badge>このパソコンではまだダウンロードしていません</span></div>
        <div class="fmeta"><span><%= when(e.issued_at) %> に作った</span><span class="dotsep" aria-hidden="true"></span><span class="mono" style="font-size:12px"><%= e.file_name %></span></div>
        <% if (notImp) { %><div class="why-wrn" style="margin-top:6px"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>日がたっても NE に出てきません。まだなら NE で取り込んでください (取り込まないなら「このファイルを使わない」に)</span></div><% } %>
        <%- dlSteps(e, open2
          ? `<button class="btn pri lg" type="button" data-act="download"${dis}><svg class="ic" aria-hidden="true"><use href="#i-dl"/></svg>${esc(kl)}の CSV をダウンロード</button><span class="hint">${esc(when(e.download_until))} までダウンロードできます (作ってから 2 時間)</span>`
          : `<span class="why-wrn" data-dl-expired><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>ダウンロードの期限 (${esc(when(e.download_until))}・作ってから 2 時間) を過ぎました。まだ NE に取り込んでいなければ、このファイルを「使わない」にして、もう一度「NE 登録の CSV を作る」を押してください。</span></span>`
            + `<button class="btn danger sm" type="button" data-act="open-supersede"${dis}>このファイルを使わない</button>`) %>
        <details class="more"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>NE で失敗があったとき (「N件失敗」・全部だめ)</summary>
          <div class="body">
            <div class="f"><label class="lab" for="qm-<%= e.export_id %>">NE のメッセージ</label><div class="ctl"><input class="in w-l" id="qm-<%= e.export_id %>" name="quick_message" maxlength="1000" autocomplete="off" placeholder="例: 3件成功しました。1件失敗しました。"></div></div>
            <div class="acts">
              <button class="btn" type="button" data-act="declare-quick" data-result="partial"<%- needDl %>><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg>一部失敗した (N件失敗)</button>
              <button class="btn danger sm" type="button" data-act="declare-quick" data-result="rejected_all"<%- needDl %>><svg class="ic s" aria-hidden="true"><use href="#i-x"/></svg>全部だめだった</button>
            </div>
            <div class="hint">失敗を知らせると、翌朝、入らなかった商品が「次の CSV」に戻ります (直してからもう一度作れます)。</div>
          </div>
        </details>
        <% if (canAct) { %><div class="acts skip-dl"><button class="btn ghost sm" type="button" data-act="skip-dl">ダウンロードせずに取り込んだ (別のパソコンで落とした など)</button></div><% } %>
        <div class="msgline" data-msg-card role="status" aria-live="polite"></div>
      </article>
      <% } %>
      <% for (const e of toCheck) { const kl = kindLabel[e.kind]; const open2 = dlOpen(e); %>
      <article class="filecard todo-card exp" data-id="<%= e.export_id %>" data-kind="<%= e.kind %>" data-sha="<%= e.sha256 %>" data-state="<%= e.state %>" data-file-name="<%= e.file_name %>" data-dl-until="<%= e.download_until || '' %>" aria-label="<%= kl %> <%= e.item_count %> 件の CSV">
        <div class="fh"><span class="ttl"><%= kl %> <%= e.item_count %> 件の CSV</span><span class="b <%= e.kind === 'sets' ? 'vio' : 'mute' %>"><%= kl %></span><span class="b info"><span class="dot" aria-hidden="true"></span>「NE に取り込んだ」を記録しました</span></div>
        <div class="hint" style="margin-top:4px"><%= when(e.declared_at) %> に記録。翌朝の照合で NE と同じか確かめます (何もしなくて大丈夫です)。</div>
        <%# 本番 #22 (10/24): ダウンロードせずに「NE に取り込んだ」を押した = このまま翌朝「取り込めなかった」になる前に、ここで直せるように %>
        <div class="why-wrn" data-not-dl hidden style="margin-top:8px"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>このパソコンでは、このファイルをまだダウンロードしていません。NE に取り込んでいないときは、<%= open2 ? '下の「もう一度ダウンロード」で落として、NE で取り込んでください' : 'このファイルを「使わない」にして、もう一度「NE 登録の CSV を作る」を押してください' %>。このままだと翌朝「取り込めなかった」になり、その商品は次の日の「次の CSV」に戻ります。</span></div>
        <div class="acts">
          <% if (open2) { %><button class="btn sm" type="button" data-act="download"<%= dis %>><svg class="ic s" aria-hidden="true"><use href="#i-dl"/></svg>もう一度ダウンロード</button><span class="hint"><%= when(e.download_until) %> まで</span><% } %>
          <a class="btn sm" href="<%= neUrl(e) %>" target="_blank" rel="noopener noreferrer" data-ne-link><svg class="ic s" aria-hidden="true"><use href="#i-up"/></svg>NE の商品一括登録を開く ↗</a>
          <button class="btn danger sm" type="button" data-act="open-supersede" data-not-dl hidden<%= dis %>>このファイルを使わない</button>
        </div>
        <div class="msgline" data-msg-card role="status" aria-live="polite"></div>
      </article>
      <% } %>
      <% for (const e of trialDone) { %>
      <article class="filecard todo-card exp" data-id="<%= e.export_id %>" data-kind="<%= e.kind %>" data-sha="<%= e.sha256 %>" data-state="<%= e.state %>">
        <div class="fh"><span class="ttl">試しの<%= kindLabel[e.kind] %>の CSV が NE で確かめられました</span></div>
        <div class="hint" style="margin-top:4px">NE の画面も見て問題なければ押してください。次からは 1 回で <%= S.max_rows.toLocaleString('ja-JP') %> 行まで作れます。</div>
        <div class="acts">
          <button class="btn pri" type="button" data-act="verified" data-kind="<%= e.kind %>" data-result="ok"<%= dis %>><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>問題なし (この形で本番にする)</button>
          <button class="btn danger sm" type="button" data-act="verified" data-kind="<%= e.kind %>" data-result="ng"<%= dis %>>問題があった</button>
        </div>
        <div class="msgline" data-msg-card role="status" aria-live="polite"></div>
      </article>
      <% } %>
      <% if (waitingItems) { %><div class="hint" id="wait-line"><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg> 取り込んだ <%= waitingItems %> 件は、翌朝の確かめを待っています (何もしなくて大丈夫です)。</div><% } %>
    </section>
    <% } %>

    <% if (P.fix.length || P.held.length || partials.length) { %>
    <section class="panel" id="fix" aria-labelledby="h-fix">
      <div class="panel-h"><span class="hico" aria-hidden="true">③</span><h2 id="h-fix">直すもの</h2><span class="sub">商品の画面で直すと、次の CSV に入ります</span></div>
      <ul class="fixlist" style="margin:0;padding-left:0;list-style:none;display:grid;gap:8px">
        <% for (const f of P.fix) { %><li class="why-blk" data-code="<%= f.code %>"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><span><% if (f.kind === 'group') { %>まとまり <span class="mono"><%= f.code %></span><% } else { %><%- skuLink(f.code) %><% } %>: <% f.why.forEach((b, n) => { %><%= n ? ' / ' : '' %><% if (f.gate && b === f.gate.text) { %><%- gateHtml(f.gate) %><% } else { %><%= b %><% } %><% }) %></span></li><% } %>
        <% for (const h of P.held) { %><li class="why-wrn" data-group="<%= h.group_code %>"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>色違い・サイズ違いのまとまり <span class="mono"><%= h.group_code %></span> の <%= h.codes.join('・') %> は、<%- h.because.map(skuLink).join('・') %> がそろうと一緒に入ります (まとまりは同じ CSV に入れます)</span></li><% } %>
        <% for (const { e, i } of partials) { %><li class="why-wrn" data-partial="<%= i.code %>"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span><%- skuLink(i.code) %>: NE に入りましたが、NE とちがう所があります — <%= diffText(i) || 'くわしくは「これまでの記録」' %>。<% if (dineOf(i.code) && dineOf(i.code).canGo) { %>この商品は「<%= DINE_BUTTON %>」を押すと、今の Company DB の値のまま登録済みになります (NE とちがう所は『NEへ送る』で NE に送れます)<% } else { %>NE の画面で CSV の値に直すと翌朝そろいます (NE の値の方が正しいときは「これまでの記録」でこのファイルを「使わない」に)<% } %> <%- dineHtml(i.code) %></span></li><% } %>
      </ul>
    </section>
    <% } %>

    <% if (P.in_ne.length) { %>
    <section class="panel" id="in-ne" aria-labelledby="h-in-ne">
      <div class="panel-h"><span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-info"/></svg></span><h2 id="h-in-ne">NE にもうある商品</h2></div>
      <div>NE に同じコードの商品がもうあるので、CSV にしません (NE の画面で先に登録した商品)。NE の商品をそのまま使うときは「<%= DINE_BUTTON %>」を押します (NE とちがう所は『NEへ送る』に出ます)。</div>
      <ul class="fixlist" id="in-ne-list" style="margin:8px 0 0;padding-left:0;list-style:none;display:grid;gap:8px">
        <% for (const x of P.in_ne) { %><li data-in-ne="<%= x.code %>"><%- skuLink(x.code) %> <%- dineHtml(x.code) || '<span class="hint">ここでは下書きのまま残ります</span>' %></li><% } %>
      </ul>
    </section>
    <% } %>

    <details class="panel soft" id="history">
      <summary><svg class="ic" aria-hidden="true"><use href="#i-file"/></svg>これまでの記録 <span class="b mute">ファイル <%= S.exports.length %></span><svg class="ic s chev" aria-hidden="true"><use href="#i-chevr"/></svg></summary>
      <div class="body">
      <div class="ready" style="margin-top:0">
        <% if (S.today) { %><span class="ok"><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg>今日 (<%= S.today_jst %>) の照合 あり · <%= S.run %></span><% } else { %><span class="err"><svg class="ic s" aria-hidden="true"><use href="#i-x"/></svg>今日 (<%= S.today_jst %>) の照合の回がまだ = 作れません<%= S.run ? ' (最後 ' + S.run + ')' : '' %></span><% } %>
        <% if (S.ne_codes.current) { %><span class="ok"><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg>NE の元のコード 今日の分</span><% } else { %><span class="err"><svg class="ic s" aria-hidden="true"><use href="#i-x"/></svg>NE の元のコード まだ / 古い (作れません)</span><% } %>
        <% for (const [k, v] of Object.entries(S.verified)) { %>
          <% if (v.ok) { %><span class="ok"><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg><%= kindLabel[k] %>の CSV の形 (<%= v.schema %>) = 実機で確かめた · 本番 (<%= S.max_rows %> 行まで)</span><% } else { %><span class="warn"><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg><%= kindLabel[k] %>の CSV の形 (<%= v.schema %>) は まだ実機で確かめていない<%= v.trial_gate === false ? ' · 行の上限なし (' + S.max_rows + ' 行まで・最初のファイルが翌朝 NE とそろえば記録します)' : ' = 試し用 (' + S.trial_rows + ' 行まで)' %></span><% } %>
        <% } %>
      </div>
      <details class="more"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>CSV の列の見出しと、気をつけること</summary>
        <div class="body hint">
          <% for (const [k, v] of Object.entries(S.verified)) { %><div><b style="color:var(--text2)"><%= kindLabel[k] %></b> <span class="mono" style="font-size:12px;overflow-wrap:anywhere"><%= v.header %></span></div><% } %>
          <div style="margin-top:6px">色違い・サイズ違いの子は、ふつうの単品と同じ CSV に入ります (代表商品コードの列 = まとまりのコード)。まとまりの NE 登録待ちの子は全部いっしょに入れます。
          配った後も、商品の画面で値を直せます (代表 (親) と、確かめが終わる前のセットの構成は変えられません)。直した値は翌朝の照合のあと「NEへ送る」で NE に送れます。
          全部成功なら「取り込んだ」は押さなくても、翌朝の照合が配った値と NE を全部の列で比べて確かめます。NE の履歴の状態が「処理成功」でも、メッセージに「N件失敗」があったときは <b style="color:var(--text)">必ず「一部失敗した」を押して</b>ください (押さないと、入らなかった商品は「待ち」のままで作り直せません)。
          単品の JAN は NE に送りません (JAN の列は常に empty・JAN は Company DB に残ります)。</div>
        </div>
      </details>
      <div id="files" style="margin-top:14px">
      <% if (!S.exports.length) { %><div class="empty">まだありません。</div><% } %>
      <% for (const e of S.exports) { const open = e.state !== 'closed'; %>
      <article class="filecard exp<%= open ? '' : ' closed' %>" data-id="<%= e.export_id %>" data-kind="<%= e.kind %>" data-sha="<%= e.sha256 %>" data-state="<%= e.state %>" data-file-name="<%= e.file_name %>" aria-labelledby="ft-<%= e.export_id %>">
        <div class="fh"><span class="ttl" id="ft-<%= e.export_id %>">ファイル #<%= e.export_id %></span><span class="b <%= e.kind === 'sets' ? 'vio' : 'mute' %>"><%= kindLabel[e.kind] %></span><% if (e.trial) { %><span class="b warn">試し用</span><% } %>
          <span class="b <%= open ? STATE_BADGE[e.state] : (CLOSE_BADGE[e.close_reason] || 'mute') %>"><% if (open) { %><span class="dot" aria-hidden="true"></span><% } %><%= EXPORT_STATES[e.state] || e.state %><%= e.close_reason ? ` (${CLOSE_REASONS[e.close_reason] || e.close_reason})` : '' %></span></div>
        <div class="fmeta">
          <span><%= e.item_count %> 商品 / <%= e.row_count %> 行</span><span class="dotsep" aria-hidden="true"></span>
          <span><%= e.created_by %> · <%= when(e.created_at) %> に作った</span>
          <% if (e.issued_at) { %><span class="dotsep" aria-hidden="true"></span><span><%= e.issued_by %> · <%= when(e.issued_at) %> に配った</span><% } %>
          <% if (e.declared_at) { %><span class="dotsep" aria-hidden="true"></span><span><%= e.declared_by %> · <%= when(e.declared_at) %> に申告</span><% } %>
          <% if (e.closed_at) { %><span class="dotsep" aria-hidden="true"></span><span><%= when(e.closed_at) %> に閉じた</span><% } %>
          <span class="dotsep" aria-hidden="true"></span><span class="shabox" title="sha256 <%= e.sha256 %>">sha256 <%= shortSha(e.sha256) %></span><span class="muted">形 <%= e.schema_version %></span>
          <% if (e.file_name) { %><span class="muted mono" style="font-size:12px"><%= e.file_name %></span><% } %>
        </div>
        <ol class="ministeps" aria-label="ファイル #<%= e.export_id %> の進み">
          <% steps(e).forEach((s, i) => { %><% if (i) { %><li class="arr" aria-hidden="true">›</li><% } %><li class="ms<%= s.cls ? ' ' + s.cls : '' %>"<%- s.cls === 'cur' ? ' aria-current="step"' : '' %>><% if (s.cls === 'done') { %><svg class="ic s" aria-hidden="true"><use href="#i-check"/></svg><% } %><%= s.t %></li><% }) %>
        </ol>
        <div class="tblwrap">
          <table class="tbl">
            <thead><tr><th scope="col">コード</th><th scope="col">状態</th><th scope="col">翌朝の確かめ</th><th scope="col">メモ</th></tr></thead>
            <tbody>
            <% for (const i of e.items) { %>
              <tr><td class="code"><a href="<%= base %>/sku/<%= encodeURIComponent(i.code) %>"><%= i.code %></a></td><td><%= ITEM_STATES[i.state] || i.state %></td>
                <td><% if (i.last_check) { %><%= CHECK_OUTCOMES[i.last_check.outcome] || i.last_check.outcome %> <span class="muted" style="font-size:12.5px"><%= i.last_check.compare_run_id %></span><% } else { %><span class="muted">まだ</span><% } %>
                  <% if (i.last_check && i.last_check.detail && i.last_check.detail.auto_block) { %><div class="why-wrn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>自動では確かめません: <%= (typeof AUTO_BLOCKS !== 'undefined' && AUTO_BLOCKS[i.last_check.detail.auto_block]) || i.last_check.detail.auto_block %> = 「取り込んだと申告 (任意)」をすると翌朝確かめます</span></div><% } %>
                  <% if (i.last_check && i.last_check.detail && i.last_check.detail.not_imported === true) { %><div class="why-wrn"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>配ってから日がたっても NE に無い = 取り込まれていないらしい (NE で取り込むか、使わないにする)</span></div><% } %>
                  <% if (i.last_check && i.last_check.detail && i.last_check.detail.compare && i.last_check.detail.compare.cols) { %>
                    <% for (const [col, x] of Object.entries(i.last_check.detail.compare.cols)) { if (x.ok) continue; %><div class="why-blk"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><span><%= col %>: NE <%= JSON.stringify(x.observed && x.observed.v !== undefined ? x.observed.v : x.observed) %> / 目標 <%= JSON.stringify(x.expected) %></span></div><% } %>
                  <% } %></td>
                <td class="muted"><%= i.failed_reason ? `取り込めなかった (${i.failed_reason})` : '' %><%= i.superseded_reason ? `${i.superseded_reason} / ${i.superseded_correction}` : '' %></td></tr>
            <% } %>
            </tbody>
          </table>
        </div>
        <% if (open) { %>
        <div class="acts">
          <% if (e.state === 'built') { %>
            <button class="btn pri" type="button" data-act="issue"<%= dis %>><svg class="ic" aria-hidden="true"><use href="#i-dl"/></svg>配る (ダウンロード)</button>
          <% } else if (e.state === 'issued') { %>
            <span class="hint"><%= e.kind === 'sets' ? 'セットは、NE に取り込んだら必ず申告してください (翌朝の照合で確かめます)' : 'NE に取り込んで全部成功なら、翌朝の照合で自動で確かめます (申告は要りません)。「N件失敗」・全部だめのときは必ず申告' %></span>
            <% if (dlOpen(e)) { %><button class="btn" type="button" data-act="download"<%= dis %>><svg class="ic" aria-hidden="true"><use href="#i-dl"/></svg>もう一度ダウンロード</button><% } else { %><span class="hint" data-dl-expired>ダウンロードの期限 (<%= when(e.download_until) %>) を過ぎました</span><% } %>
            <button class="btn sm" type="button" data-act="show-declare" aria-expanded="false" aria-controls="dr-d-<%= e.export_id %>"<%= dis %>>取り込んだと申告 (N件失敗・全部だめのときは必ず)</button>
          <% } else { %>
            <span class="hint">翌朝の照合で NE と同じか確かめます (何もしなくて大丈夫です)</span>
            <% if (dlOpen(e)) { %><button class="btn sm" type="button" data-act="download"<%= dis %>><svg class="ic s" aria-hidden="true"><use href="#i-dl"/></svg>もう一度ダウンロード</button><% } else { %><span class="hint" data-dl-expired>ダウンロードの期限 (<%= when(e.download_until) %>) を過ぎました</span><% } %>
            <button class="btn sm" type="button" data-act="show-declare" aria-expanded="false" aria-controls="dr-d-<%= e.export_id %>"<%= dis %>>申告をし直す</button>
          <% } %>
          <span class="spacer"></span>
          <button class="btn danger sm" type="button" data-act="show-supersede" aria-expanded="false" aria-controls="dr-s-<%= e.export_id %>"<%= dis %>>このファイルを使わない</button>
        </div>
        <% if (e.state !== 'built') { %>
        <div class="drawer" id="dr-d-<%= e.export_id %>" data-drawer="declare" hidden>
          <div class="panel-h" style="margin-bottom:6px"><h3 style="font-size:15.5px">取り込んだと申告</h3><span class="sub"><%= e.kind === 'sets' ? 'セットは全部成功でも申告します (申告すると翌朝の照合で確かめます)' : '全部成功なら要りません (翌朝の照合で確かめます)' %>。一部失敗 (「N件失敗」)・全部だめのときは必ず、NE の画面の結果をそのまま書きます (申告しないと入らなかった商品が待ちのまま)</span></div>
          <div class="f" style="align-items:start"><div class="lab" style="padding-top:12px">取り込んだファイル</div><div class="ctl col">
            <label class="drop" data-drop>
              <span class="fileico"><svg class="ic l" aria-hidden="true"><use href="#i-file"/></svg></span>
              <span><span class="big" data-drop-t>NE に取り込んだ CSV をここに落とす (押して選んでも)</span><br><span class="hint" data-drop-s>その場で、配ったファイル #<%= e.export_id %> と同じか照合します · 64 文字を写す必要はありません</span></span>
              <input type="file" accept=".csv,text/csv" data-sha-file aria-label="NE に取り込んだ CSV のファイル (配ったファイル #<%= e.export_id %> と同じか照合します)">
            </label>
            <details class="more"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>ファイルが手元に無いとき: sha256 を貼る</summary>
              <div class="body"><input class="in w-full mono" name="sha256" maxlength="64" autocomplete="off" spellcheck="false" data-dirty-field="declare" data-label="sha256" aria-label="ファイルの sha256 (64 文字)" placeholder="64 文字 (NE に取り込んだファイルのもの)"></div></details>
          </div></div>
          <div class="f"><div class="lab" id="lr-<%= e.export_id %>">NE の結果<span class="req">必須</span></div><div class="ctl col"><div class="choices" role="radiogroup" aria-labelledby="lr-<%= e.export_id %>">
            <% for (const [k, v] of Object.entries(RESULTS)) { const d = RESULT_DESC[k] || ['i-info', '']; %><label class="choice r-<%= k %>"><input type="radio" name="result-<%= e.export_id %>" value="<%= k %>" data-dirty-field="declare" data-label="NE の結果"><span class="ct"><svg class="ic s" aria-hidden="true"><use href="#<%= d[0] %>"/></svg><%= v.replace(/ \(.*\)$/, '') %></span><span class="cs"><%= d[1] %></span></label><% } %>
          </div></div></div>
          <div class="f"><label class="lab" for="nem-<%= e.export_id %>">NE のメッセージ</label><div class="ctl"><input class="in w-l" id="nem-<%= e.export_id %>" name="ne_message" maxlength="1000" autocomplete="off" data-dirty-field="declare" data-label="NE のメッセージ" placeholder="例: 1件成功しました。"></div></div>
          <div class="f"><label class="lab" for="imp-<%= e.export_id %>">取り込んだ時刻<span class="opt">なくてもよい</span></label><div class="ctl"><input class="in w-m" type="datetime-local" step="1" id="imp-<%= e.export_id %>" name="imported_at" data-dirty-field="declare" data-label="取り込んだ時刻"><button class="btn ghost sm" type="button" data-now>いまの時刻を入れる</button><span class="hint">日本時間 · 配った時刻より前・今より後は入れられません</span></div></div>
          <div class="f"><label class="lab" for="note-<%= e.export_id %>">メモ<span class="opt">なくてもよい</span></label><div class="ctl"><input class="in w-l" id="note-<%= e.export_id %>" name="note" maxlength="500" autocomplete="off" data-dirty-field="declare" data-label="メモ"></div></div>
          <div class="drawer-foot"><div class="msgline" data-msg role="status" aria-live="polite"></div><button class="btn ghost" type="button" data-act="close-drawer">やめる</button><button class="btn pri" type="button" data-act="declare"<%= dis %>>申告する</button></div>
        </div>
        <% } %>
        <div class="drawer" id="dr-s-<%= e.export_id %>" data-drawer="supersede" hidden>
          <div class="panel-h" style="margin-bottom:6px"><h3 style="font-size:15.5px">このファイルを使わない</h3><span class="sub">配った後なら、NE で何をしたかも書きます (この後に作り直せます)</span></div>
          <div class="f"><label class="lab" for="sr-<%= e.export_id %>">理由<span class="req">必須</span></label><div class="ctl"><input class="in w-l" id="sr-<%= e.export_id %>" name="reason" maxlength="500" autocomplete="off" data-dirty-field="supersede" data-label="使わない理由" placeholder="例: 売価を直したい"></div></div>
          <div class="f"><label class="lab" for="sc-<%= e.export_id %>">NE で何をしたか<span class="req">必須</span></label><div class="ctl"><input class="in w-l" id="sc-<%= e.export_id %>" name="correction" maxlength="500" autocomplete="off" data-dirty-field="supersede" data-label="NE で何をしたか" placeholder="例: NE には取り込んでいない / NE で取り込んだ商品を消した"></div></div>
          <div class="f wide"><label class="check-row"><input type="checkbox" name="confirm" data-dirty-field="supersede" data-label="NE の状態を確かめた"><span>NE の状態を確かめた (取り込んでいない・取り込んだものは直した / 消した)</span></label></div>
          <div class="drawer-foot"><div class="msgline" data-msg role="status" aria-live="polite"></div><button class="btn ghost" type="button" data-act="close-drawer">やめる</button><button class="btn danger" type="button" data-act="supersede"<%= dis %>>使わないにする</button></div>
        </div>
        <% } else if (e.trial && e.items.length && e.items.every((i) => i.state === 'verified') && e.verify && e.verify.can) { %>
        <div class="callout info" style="margin:12px 0 0"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><div class="t">試し用の商品が全部 NE で確かめ済みです</div><div class="hint">実機で NE の画面も見て問題なければ、この形を「実機で確かめた」にします (本番の行数で作れるようになります)。</div></div></div>
        <div class="acts">
          <button class="btn pri" type="button" data-act="verified" data-kind="<%= e.kind %>" data-result="ok"<%= dis %>><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>この形を「実機で確かめた」にする</button>
          <button class="btn danger sm" type="button" data-act="verified" data-kind="<%= e.kind %>" data-result="ng"<%= dis %>>問題があった (ng)</button>
        </div>
        <% } else if (e.trial && e.items.length && e.items.every((i) => i.state === 'verified')) { %>
        <%# 🆕 10/12 (中原さん): 引退した版 (v1 など)・試し用の門の無い版の試し用のファイル = 実機の確かめのボタンは出さない (API は export_mismatch で断る)。決まり = lib の regVerifyTargetOf %>
        <div class="callout info" style="margin:12px 0 0" data-verify-none="<%= e.verify ? e.verify.why : 'mismatch' %>"><svg class="ic" aria-hidden="true"><use href="#i-info"/></svg><div class="grow"><div class="t">試し用の商品は全部 NE で確かめ済みです</div><div class="hint"><%= (e.verify && e.verify.message) || 'このファイルの形は今の形と違うので、このファイルでは実機の確かめを記録できません' %></div><% if (e.verify && e.verify.why === 'retired' && e.verify.rule_why) { %><div class="hint">引退の理由: <%= e.verify.rule_why %></div><% } %></div></div>
        <% } %>
        <div class="msgline" data-msg-card role="status" aria-live="polite"></div>
      </article>
      <% } %>
      </div>
      <% if (S.variation && S.variation.length) { %>
      <%# 色違い・サイズ違いのまとまりの回 (記録だけ。作るのは上の「次の CSV」= ふつうの単品と同じ CSV に入る) %>
      <div id="vcands" style="margin-top:14px">
        <h3 style="font-size:15px;margin:0 0 6px">色違い・サイズ違いのまとまり (登録した回)</h3>
        <% for (const g of S.variation) { %>
        <article class="filecard vgroup" data-gid="<%= g.group_product_id %>" aria-labelledby="vg-<%= g.group_product_id %>">
          <div class="fh"><span class="ttl" id="vg-<%= g.group_product_id %>"><span class="mono"><%= g.group_code %></span> <%= g.group_name || '' %></span><span class="b info">まとまり · <%= g.rounds.length %> 回</span></div>
          <% for (const r of g.rounds) { %>
          <div class="vround" style="border-top:1px dashed var(--line-soft);padding:8px 0">
            <div style="display:flex;gap:8px 14px;align-items:center;flex-wrap:wrap"><b><%= r.no ? '回 ' + r.no : '回の分からない子' %></b><span class="hint"><%= r.created_at ? when(r.created_at) + ' に登録' : '' %> · 子 <%= r.kids.length %> 件<%= r.pending !== r.kids.length ? ' (ファイルあり ' + (r.kids.length - r.pending) + ' 件)' : '' %></span></div>
            <div class="kidchips" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px">
            <% for (const k of r.kids) { %><a class="compchip" href="<%= base %>/sku/<%= encodeURIComponent(k.code) %>" title="<%= k.blockers.join(' / ') %>"><span class="mono"><%= k.code %></span><% if (k.live) { %> <span class="b mute">#<%= k.live.export_id %></span><% } else if (k.blockers.length) { %> <span class="b err">止まる</span><% } %></a><% } %>
            </div>
          </div>
          <% } %>
        </article>
        <% } %>
      </div>
      <% } %>
      </div>
    </details>
    <% } %>
  </div>
  <%- include('_footer') %>
  <% if (S && S.applied) { %><script src="<%= base %>/public/me-download.js?v=<%= assetV %>" defer></script><script src="<%= base %>/public/me-regcsv.js?v=<%= assetV %>" defer></script><% } %>
  <% if (canAct && S.dine && Object.values(S.dine).some((d) => d.canGo)) { %><script src="<%= base %>/public/me-draft-in-ne.js?v=<%= assetV %>" defer></script><% } %>
</body>
</html>
