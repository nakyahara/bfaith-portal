<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
  <style>
    .sec { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 8px 14px; margin-bottom: 10px; }
    .sec h3 { font-size: 0.95em; margin: 2px 0 8px; color: #343a40; }
    .sub { font-size: 0.82em; color: #868e96; }
    .blk { color: #c92a2a; font-size: 0.85em; } .wrn { color: #7a5a00; font-size: 0.85em; }
    .exp { border: 1px solid #ced4da; border-radius: 6px; padding: 6px 10px; margin: 8px 0; }
    .exp .acts { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 6px; }
    .exp form { border-top: 1px dashed #dee2e6; margin-top: 6px; padding-top: 6px; display: none; }
    .exp form.show { display: block; }
    .exp form .fl { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 4px 0; font-size: 0.88em; }
    code.sha { font-size: 0.78em; word-break: break-all; }
  </style>
</head>
<body>
  <%- include('_header') %>
  <%
    const S = summary;
    const canAct = canApprove && !dbError && !closed && !!S && S.applied;
    const dis = canAct ? '' : ' disabled';
    const kindLabel = { products: '単品', sets: 'セット' };
  %>
  <div class="me-wrap" id="rc" data-base="<%= base %>">
    <p class="sub"><a href="<%= base %>/">← 一覧へ</a> ・ <a href="<%= base %>/manual#reg-csv">📖 つかいかた (NE 登録の CSV)</a></p>
    <h2 style="font-size: 1.15em; margin: 6px 0;">📤 NE 登録の CSV (新商品を NE に登録する)</h2>
    <% if (dbError) { %><div class="band err"><%= dbError %></div><% } %>
    <% if (closed) { %><div class="band warn">いまは使えません (<%= closedWhy %>)。見るだけです。</div><% } %>
    <% if (!canApprove) { %><div class="band info"><%= approveMessage %></div><% } %>
    <% if (S && !S.applied) { %><div class="band warn">NE 登録の CSV の表 (migration 0052) がまだ入っていません。</div><% } %>
    <% if (S && S.applied) { %>
    <div class="me-box"><p class="hint">
      新商品 (下書き) を NE の「商品一括登録」で取り込む CSV にします。<b>作る → 配る (ダウンロード) → NE で取り込む → 取り込んだと申告 → 翌朝の照合で NE 確認済み</b>。
      配った後は、その商品の NE に送る欄 (名前・売価・原価・税率・仕入先・取扱区分・代表・JAN・セットの構成) は直せません。直すときは、そのファイルを「使わない」にして、NE で何をしたかを書いてください。
      NE の履歴の状態が「処理成功」でも、メッセージに「N件失敗」があれば <b>一部失敗</b> で申告します。
    </p></div>

    <div class="sec"><h3>今日の照合と形</h3>
      <div class="sub">今日 (<%= S.today_jst %>) の照合の回: <%= S.run || 'なし' %> <%= S.today ? '' : '(今日の回がまだ = 作れません)' %> ・ NE の元のコード: <%= S.ne_codes.current ? '今日の回' : 'まだ / 古い (作れません)' %></div>
      <% for (const [k, v] of Object.entries(S.verified)) { %>
        <div class="sub"><%= kindLabel[k] %> (<%= v.schema %>): <% if (v.ok) { %><span class="tag gray">実機で確かめた = 本番 (<%= S.max_rows %> 行まで)</span><% } else { %><span class="tag">実機でまだ = 試し用 (<%= S.trial_rows %> 行まで)</span><% } %> <span class="muted"><%= v.header %></span></div>
      <% } %>
    </div>

    <div class="sec"><h3>CSV にする商品 (下書き・NE 登録待ち)</h3>
      <% if (!S.candidates.length) { %><div class="muted">下書き・NE 登録待ちの商品はありません。</div><% } else { %>
      <table class="me" id="cands">
        <thead><tr><th></th><th>コード</th><th>種類</th><th>登録</th><th>止まる理由・気をつけること</th></tr></thead>
        <tbody>
        <% for (const c of S.candidates) { %>
          <tr>
            <td><input type="checkbox" class="pick" data-kind="<%= c.kind %>" value="<%= c.code %>"<%= c.blockers.length || !canAct ? ' disabled' : '' %>></td>
            <td><a href="<%= base %>/sku/<%= encodeURIComponent(c.code) %>"><%= c.code %></a></td>
            <td><%= kindLabel[c.kind] %></td>
            <td><%= REG_STATES[c.state] || c.state %><%= c.live ? ` ・ ファイル #${c.live.export_id} (${ITEM_STATES[c.live.state] || c.live.state})` : '' %></td>
            <td><% for (const b of c.blockers) { %><div class="blk">✖ <%= b %></div><% } %><% for (const w of c.warnings) { %><div class="wrn">⚠ <%= w %></div><% } %><%= !c.blockers.length && !c.warnings.length ? '作れます' : '' %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
      <div class="row" style="margin-top: 6px;">
        <button type="button" class="btn-sm" data-act="build" data-kind="products"<%= dis %>>選んだ単品の CSV を作る</button>
        <button type="button" class="btn-sm" data-act="build" data-kind="sets"<%= dis %>>選んだセットの CSV を作る</button>
        <span class="sub">単品とセットは別のファイル。セットは構成品が全部 NE 確認済みのときだけ。</span>
      </div>
      <% } %>
    </div>

    <div class="sec"><h3>ファイル</h3>
      <% if (!S.exports.length) { %><div class="muted">まだありません。</div><% } %>
      <% for (const e of S.exports) { %>
        <div class="exp" data-id="<%= e.export_id %>" data-sha="<%= e.sha256 %>">
          <div><b>#<%= e.export_id %></b> <%= kindLabel[e.kind] %> <%= e.trial ? '【試し用】' : '' %> ・ <b><%= EXPORT_STATES[e.state] || e.state %></b><%= e.close_reason ? ` (${CLOSE_REASONS[e.close_reason] || e.close_reason})` : '' %>
            ・ <%= e.item_count %> 商品 / <%= e.row_count %> 行 ・ <%= e.created_by %> <%= String(e.created_at).slice(0, 16) %> ・ <span class="sub"><%= e.file_name %></span></div>
          <div class="sub">sha256 <code class="sha"><%= e.sha256 %></code> ・ 形 <%= e.schema_version %></div>
          <table class="me" style="margin-top: 4px;">
            <thead><tr><th>コード</th><th>状態</th><th>翌朝の確かめ</th><th>メモ</th></tr></thead>
            <tbody>
            <% for (const i of e.items) { %>
              <tr><td><a href="<%= base %>/sku/<%= encodeURIComponent(i.code) %>"><%= i.code %></a></td><td><%= ITEM_STATES[i.state] || i.state %></td>
                <td><%= i.last_check ? `${i.last_check.compare_run_id} ${CHECK_OUTCOMES[i.last_check.outcome] || i.last_check.outcome}` : '—' %>
                  <% if (i.last_check && i.last_check.detail && i.last_check.detail.compare && i.last_check.detail.compare.cols) { %>
                    <% for (const [col, x] of Object.entries(i.last_check.detail.compare.cols)) { if (x.ok) continue; %><div class="blk">✖ <%= col %>: NE <%= JSON.stringify(x.observed && x.observed.v !== undefined ? x.observed.v : x.observed) %> / 目標 <%= JSON.stringify(x.expected) %></div><% } %>
                  <% } %></td>
                <td class="sub"><%= i.failed_reason ? `取り込めなかった (${i.failed_reason})` : '' %><%= i.superseded_reason ? `${i.superseded_reason} / ${i.superseded_correction}` : '' %></td></tr>
            <% } %>
            </tbody>
          </table>
          <% if (e.state !== 'closed') { %>
          <div class="acts">
            <button type="button" class="btn-sm" data-act="issue"<%= dis %>><%= e.state === 'built' ? '配る (ダウンロード)' : 'もう一度ダウンロード' %></button>
            <% if (e.state !== 'built') { %><button type="button" class="btn-sm" data-act="show-declare"<%= dis %>>取り込んだと申告</button><% } %>
            <button type="button" class="btn-sm" data-act="show-supersede"<%= dis %>>使わない</button>
          </div>
          <form class="declare" onsubmit="return false">
            <div class="fl">ファイルの sha256 (NE に取り込んだファイルのもの・コピーして貼る) <input type="text" name="sha256" size="70" maxlength="64"></div>
            <div class="fl">結果 <% for (const [k, v] of Object.entries(RESULTS)) { %><label><input type="radio" name="result" value="<%= k %>"> <%= v %></label><% } %></div>
            <div class="fl">NE の履歴のメッセージ <input type="text" name="ne_message" size="60" maxlength="1000" placeholder="例: 1件成功しました。"></div>
            <div class="fl">取り込んだ時刻 (任意) <input type="datetime-local" name="imported_at"> メモ <input type="text" name="note" size="30" maxlength="500"></div>
            <div class="fl"><button type="button" class="btn-sm" data-act="declare"<%= dis %>>申告する</button></div>
          </form>
          <form class="supersede" onsubmit="return false">
            <div class="fl">理由 <input type="text" name="reason" size="50" maxlength="500" placeholder="例: 売価を直したい"></div>
            <div class="fl">NE で何をしたか <input type="text" name="correction" size="60" maxlength="500" placeholder="例: NE には取り込んでいない / NE で取り込んだ商品を消した"></div>
            <div class="fl"><label><input type="checkbox" name="confirm"> NE の状態を確かめた (取り込んでいない・取り込んだものは直した / 消した)</label></div>
            <div class="fl"><button type="button" class="btn-sm" data-act="supersede"<%= dis %>>使わないにする</button></div>
          </form>
          <% } else if (e.trial && e.items.length && e.items.every((i) => i.state === 'verified')) { %>
          <div class="acts"><span class="sub">試し用の商品が全部 NE で確かめ済みです。実機で NE の画面も見て問題なければ:</span>
            <button type="button" class="btn-sm" data-act="verified" data-kind="<%= e.kind %>" data-result="ok"<%= dis %>>この形を「実機で確かめた」にする</button>
            <button type="button" class="btn-sm" data-act="verified" data-kind="<%= e.kind %>" data-result="ng"<%= dis %>>問題があった (ng)</button></div>
          <% } %>
          <div class="msg"></div>
        </div>
      <% } %>
    </div>
    <% } %>
  </div>

<script>
(() => {
  const base = document.getElementById('rc').dataset.base;
  const uuid = () => {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    const b = new Uint8Array(16); crypto.getRandomValues(b); b[6] = (b[6] & 15) | 64; b[8] = (b[8] & 63) | 128;
    const h = Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
    return h.slice(0, 8) + '-' + h.slice(8, 12) + '-' + h.slice(12, 16) + '-' + h.slice(16, 20) + '-' + h.slice(20);
  };
  const buildIds = { products: uuid(), sets: uuid() };   // 作る 1 回に 1 つ (押し直しても 2 つ作らない)
  async function post(path, body) {
    const r = await fetch(base + path, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) });
    const j = await r.json().catch(() => ({}));
    return { ok: r.ok && j.ok !== false, status: r.status, j };
  }
  const errText = (j, status) => (j.error || ('HTTP ' + status)) + (Array.isArray(j.items) ? '\n' + j.items.map((x) => x.code + ': ' + (x.blockers || []).join(' / ')).join('\n') : '');
  document.addEventListener('click', async (ev) => {
    const b = ev.target.closest('button[data-act]'); if (!b || b.disabled) return;
    const box = b.closest('.exp');
    const msg = box ? box.querySelector('.msg') : null;
    const say = (t, ok) => { if (msg) { msg.className = 'msg ' + (ok ? 'ok' : 'err'); msg.textContent = t; } else alert(t); };
    const act = b.dataset.act;
    if (act === 'show-declare' || act === 'show-supersede') { box.querySelector(act === 'show-declare' ? 'form.declare' : 'form.supersede').classList.toggle('show'); return; }
    b.disabled = true;
    try {
      if (act === 'build') {
        const kind = b.dataset.kind;
        const codes = Array.from(document.querySelectorAll('input.pick:checked')).filter((x) => x.dataset.kind === kind).map((x) => x.value);
        if (!codes.length) { alert('作る商品に印を付けてください'); b.disabled = false; return; }
        const r = await post('/api/reg-csv/exports', { kind, codes, request_id: buildIds[kind] });
        if (!r.ok) { alert(errText(r.j, r.status)); buildIds[kind] = uuid(); b.disabled = false; return; }
        location.reload(); return;
      }
      const id = box.dataset.id;
      if (act === 'issue') {
        const r = await post('/api/reg-csv/exports/' + id + '/issue', {});
        if (!r.ok || r.j.refused) { say(r.j.refused ? '使わないにした商品があるので配れません (ファイルを閉じました)。作り直してください' : errText(r.j, r.status)); b.disabled = false; return; }
        location.href = base + '/api/reg-csv/exports/' + id + '/file';
        setTimeout(() => location.reload(), 1500); return;
      }
      if (act === 'declare') {
        const f = box.querySelector('form.declare');
        const res = f.querySelector('input[name=result]:checked');
        if (!res) { say('結果を選んでください'); b.disabled = false; return; }
        const at = f.imported_at.value ? new Date(f.imported_at.value).toISOString() : null;
        const r = await post('/api/reg-csv/exports/' + id + '/declare', { sha256: f.sha256.value.trim(), result: res.value, ne_message: f.ne_message.value, imported_at: at, note: f.note.value });
        if (!r.ok) { say(errText(r.j, r.status)); b.disabled = false; return; }
        location.reload(); return;
      }
      if (act === 'supersede') {
        const f = box.querySelector('form.supersede');
        const r = await post('/api/reg-csv/exports/' + id + '/supersede', { reason: f.reason.value, correction: f.correction.value, confirm: f.confirm.checked });
        if (!r.ok) { say(errText(r.j, r.status)); b.disabled = false; return; }
        location.reload(); return;
      }
      if (act === 'verified') {
        const r = await post('/api/reg-csv/verified', { kind: b.dataset.kind, result: b.dataset.result, export_id: id });
        if (!r.ok) { say(errText(r.j, r.status)); b.disabled = false; return; }
        location.reload(); return;
      }
    } catch (e) { say('通信できませんでした'); b.disabled = false; }
  });
})();
</script>
</body>
</html>
