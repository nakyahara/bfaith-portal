<%
  // ロジザードに送るバーコード (CompanyDB構想 23 v4・0080)。商品の画面の単品だけ。動き = public/me-lzbarcode.js
  //   lz = router の lzBarcode (lib/logizard-barcode.mjs lzBarcodeView の答え + KINDS・VIA)
  //   🚨 バーコードは 4 つを混ぜない: ① JAN・FNSKU (Company DB の識別子) ② AMC ラベルの印字 ③ 入庫の BC シール ④ ここ = ロジザードに初めて載せるときの 1 本
  //   値は人が打つ (手元の FNSKU か JAN) か「空欄」(ロジザードが番号を付ける)。Amazon の出品とは切り離す (違えば参考の印だけ)
  const K = lz.KINDS || {}, VIA = lz.VIA || {};
  const ok = !lz.error;
  const ro = !ok || !lz.canWrite;
  const D = ro ? ' disabled' : '';
  const cur = ok ? (lz.kind === 'lz_assign' ? '空欄' : (lz.value || '')) : '';
  const pageData = ok && lz.ready ? { base, code, canWrite: !!lz.canWrite, kind: lz.kind || null, value: lz.value || '', seenRow: lz.rule_row || null } : null;
%>
<section class="panel" id="sec-lzbc" aria-labelledby="h-lzbc">
  <div class="panel-h">
    <span class="hico" aria-hidden="true"><svg class="ic"><use href="#i-box"/></svg></span>
    <h2 id="h-lzbc">ロジザードのバーコード</h2><span class="sub">ロジザードに登録するときの 1 本 · 右の「保存する」とは別</span>
  </div>
  <p class="hint lzbc-lead">商品に付いているバーコードを打ちます (FNSKU = X00 で始まる 10 文字 / JAN = 8・13 けた)。バーコードが無い商品は「空欄」= ロジザードが番号を付けます (値札で刷って貼る)。
    JAN の欄・AMC ラベルの印字・Amazon の出品とは別のものです。</p>
  <% if (!ok) { %>
    <div class="callout err" id="lzbc-why"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><%= lz.error %>。少し待ってから画面を開き直してください。</div></div>
  <% } else { %>
    <% if (lz.ready && !lz.kind && !lz.issued) { %><div class="callout warn" id="lzbc-none"><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><div class="grow"><div class="t">まだ入っていません</div><div class="hint"><%= lz.legacy ? '前の「決め方」だけが残っています。' : '' %>商品に付いているバーコードを打つか「空欄」を選んで保存してください。</div></div></div><% } %>
    <% if (ro && lz.why) { %><div class="callout info" id="lzbc-ro"><svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg><div class="grow">見るだけです: <%= lz.why %></div></div><% } %>
    <div class="f lzbc-now"><div class="lab">いま</div>
      <div class="ctl col" style="gap:4px">
        <div class="lzbc-ans"><span class="v mono" id="lzbc-v"><%= cur || '—' %></span><% if (lz.kind) { %><span class="b <%= lz.kind === 'fnsku' ? 'info' : lz.kind === 'jan' ? 'vio' : 'mute' %>"><%= K[lz.kind] || lz.kind %></span><% } %><% if (lz.issued) { %><span class="b ok">CSV #<%= lz.issued.export_id %> に出した</span><% } %></div>
        <% if (lz.rule_row && lz.kind) { %><span class="hint" id="lzbc-by"><%= VIA[lz.via] || lz.via %> · <%= lz.actor_id || '—' %> · <%= String(lz.created_at || '').slice(0, 16) %></span><% } %>
        <% for (const n of (lz.notes || [])) { %><span class="hint lzbc-note"><svg class="ic s" aria-hidden="true"><use href="#i-info"/></svg><%= n %></span><% } %>
        <%# 🆕 #1719 R1 High 2: ロジザードの写しが読めない・空・古いときに保存した値 = 照らせていない印 %>
        <%# 🆕 #1719 R8: ほかの商品の Amazon の FNSKU・JAN・ロジザードのバーコードと重なっている (取り込みは止めない = ここで知らせる) %>
        <% if (lz.clash) { %><span class="fmsg err" id="lzbc-clash" data-kind="<%= lz.clash.kind %>"><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg><%= lz.clash.note %></span><% } %>
        <% if (lz.unchecked) { %><span class="fmsg warn" id="lzbc-unchecked" data-state="<%= lz.lz_copy_state %>"><svg class="ic s" aria-hidden="true"><use href="#i-warn"/></svg><%= lz.unchecked %></span><% } %>
      </div></div>
    <% if (pageData && lz.canWrite) { %>
    <div class="f" data-row="lzbc.value"><label class="lab" for="lzbc-in">バーコード</label>
      <div class="ctl">
        <input class="in w-m mono" id="lzbc-in" autocomplete="off" spellcheck="false" maxlength="20" placeholder="X00… / 4901234567894" value="<%= lz.kind && lz.kind !== 'lz_assign' ? lz.value : '' %>">
        <label class="nonechk"><input type="checkbox" id="lzbc-blank"<%= lz.kind === 'lz_assign' ? ' checked' : '' %>><span>空欄 (ロジザードが番号を付ける)</span></label>
        <span class="fmsg" id="lzbc-msg2" aria-live="polite"></span>
      </div></div>
    <div class="po-foot">
      <span class="hint">Company DB に保存されます (右の「保存する」とは別) · ほかの商品と同じバーコードは保存できません</span>
      <span class="msgline" id="lzbc-msg" role="status" aria-live="polite"></span>
      <button class="btn pri" type="button" id="lzbc-save" disabled>バーコードを保存</button>
    </div>
    <% } %>
    <% if ((lz.ref && (lz.ref.fnskus.length || lz.ref.jans.length))) { %>
    <details class="more" id="lzbc-ref"><summary><svg class="ic s" aria-hidden="true"><use href="#i-chevr"/></svg>参考: Company DB の FNSKU・JAN</summary>
      <div class="body"><% for (const x of lz.ref.fnskus) { %><div class="amc-ex"><span class="b info">FNSKU</span> <span class="mono"><%= x.value %></span> <span class="hint">Amazon 日本 · 出品 SKU <%= x.listing_code %></span></div><% } %>
        <% for (const x of lz.ref.jans) { %><div class="amc-ex"><span class="b vio">JAN</span> <span class="mono"><%= x.value %></span> <span class="hint">この商品の JAN</span></div><% } %>
        <span class="hint">参考だけ (違っても保存できます · ロジザードには打った値を送ります)</span></div>
    </details>
    <% } %>
    <script type="application/json" id="me-lzbc"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
  <% } %>
</section>
