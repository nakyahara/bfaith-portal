<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('_head') %>
</head>
<body>
  <%- include('_header') %>
  <%
    // 🆕 2026-10-21 (スタッフ「下書きのカードがどこから確認できるのか分かりにくい」): まだ終わっていない登録を 2 か所まとめて見る (読むだけ)。
    //   ① マスタの入力の下書き (Company DB・登録の状態が下書き)  ② product-hub のセットの下書き (新商品の登録で「セット商品を作る = 作る」にしたもの・まだセットとして登録していない)
    const when = (t) => ui.fmtJst(t, { nowMs });
    const KIND_WORDS = { single: '単品', set: 'セット', exception: '例外' };
    const memText = (ms) => (ms || []).map((m) => m.code + ' × ' + m.qty).join('・');
    const PH_STATUS = { draft: '下書き', on_hold: '保留' };
  %>
  <div class="page" id="drafts-page">
    <div class="ph">
      <div>
        <h1>下書き</h1>
        <div class="lead">まだ登録が終わっていない商品です。下書きは 2 か所にあります: マスタの入力 (NE にまだ登録していない商品) と、product-hub のセットの下書き (単品の登録で「セット商品を作る」にしたセット)。</div>
      </div>
      <div class="ph-actions">
        <a class="btn" href="<%= base %>/new?kind=set"><svg class="ic" aria-hidden="true"><use href="#i-box"/></svg>新しいセット</a>
        <a class="btn pri" href="<%= base %>/new?kind=single"><svg class="ic" aria-hidden="true"><use href="#i-plus"/></svg>新しい単品</a>
      </div>
    </div>
    <% if (dbError) { %><div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t"><%= dbError %></div></div></div><% } %>

    <section class="panel" id="drafts-ph" aria-labelledby="drafts-ph-h">
      <div class="panel-h"><h2 id="drafts-ph-h">product-hub のセットの下書き</h2>
        <% if (ph && ph.rows) { %><span class="b <%= ph.rows.length ? 'warn' : 'ok' %>" id="drafts-ph-n"><%= ph.rows.length %> 件</span><% } %>
        <span class="sub">単品の登録で決めたセット。まだマスタの入力にセットとして登録していないもの</span></div>
      <% if (ph && ph.error) { %>
        <div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t">product-hub のカードを読めません</div><div class="hint"><%= ph.error %></div></div></div>
      <% } else if (!ph || !ph.rows.length) { %>
        <div class="empty">ありません</div>
      <% } else { %>
        <div class="tblwrap"><table class="tbl" id="drafts-ph-tbl"><caption class="sr">product-hub のセットの下書き</caption>
          <thead><tr><th scope="col">セット商品コード</th><th scope="col">名前</th><th scope="col">構成</th><th scope="col">作った日</th><th scope="col">いま</th><th scope="col"><span class="sr">開く</span></th></tr></thead>
          <tbody>
          <% for (const r of ph.rows) { %>
            <tr data-ph-draft="<%= r.draft_id %>">
              <td class="code"><%= r.code %><span class="sub">product-hub #<%= r.draft_id %></span></td>
              <td class="nm"><%= r.name %></td>
              <td><%= memText(r.members) %><span class="sub">単品 <a href="<%= base %>/sku/<%= encodeURIComponent(r.parent_code) %>"><%= r.parent_code %></a> から</span></td>
              <td><%= when(r.created_at) %></td>
              <td><% if (r.cdb_code) { %><span class="b info">マスタの入力にもあります</span><span class="sub">カードを結ぶのを待っています</span><% } else { %><span class="b warn">まだ登録していません</span><% } %><% if (PH_STATUS[r.status] && r.status !== 'draft') { %> <span class="b mute"><%= PH_STATUS[r.status] %></span><% } %></td>
              <td style="white-space:nowrap">
                <a class="btn soft sm" href="<%= r.card_url %>" target="_blank" rel="noopener">product-hub で開く ↗</a>
                <% if (r.cdb_code) { %><a class="btn ghost sm" href="<%= base %>/sku/<%= encodeURIComponent(r.cdb_code) %>">商品の画面</a>
                <% } else if (canEdit) { %><a class="btn sm" href="<%= base %>/new?kind=set&amp;from_card=<%= r.draft_id %>" data-take="<%= r.draft_id %>">セットとして登録する</a><% } %>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table></div>
        <div class="hint" style="margin-top:10px">「セットとして登録する」= このコード・名前・構成でセットの登録の画面を開きます。登録すると、この下書きがそのままセットの出品カードになります (新しいカードは作りません)。<% if (ph.rows.length >= DRAFT_LIST_MAX) { %> 新しい順に <%= DRAFT_LIST_MAX %> 件まで出しています。<% } %></div>
      <% } %>
    </section>

    <section class="panel" id="drafts-cdb" aria-labelledby="drafts-cdb-h">
      <div class="panel-h"><h2 id="drafts-cdb-h">マスタの入力の下書き</h2>
        <% if (cdb && cdb.ready) { %><span class="b <%= cdb.total ? 'warn' : 'ok' %>" id="drafts-cdb-n"><%= cdb.total %> 件</span><% } %>
        <span class="sub">登録した商品のうち、NE にまだ登録していないもの</span></div>
      <% if (!cdb) { %>
        <div class="empty">Company DB につながらないので出せません</div>
      <% } else if (cdb.error) { %>
        <div class="callout err" role="alert"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><div class="grow"><div class="t">下書きを読めません</div><div class="hint"><%= cdb.error %></div></div></div>
      <% } else if (!cdb.ready) { %>
        <div class="empty">Company DB に登録の状態の表がまだありません</div>
      <% } else if (!cdb.rows.length) { %>
        <div class="empty">ありません</div>
      <% } else { %>
        <div class="tblwrap"><table class="tbl" id="drafts-cdb-tbl"><caption class="sr">マスタの入力の下書き</caption>
          <thead><tr><th scope="col">商品コード</th><th scope="col">名前</th><th scope="col">種類</th><th scope="col">作った日</th><th scope="col">作った人</th></tr></thead>
          <tbody>
          <% for (const r of cdb.rows) { %>
            <tr data-cdb-draft="<%= r.code %>">
              <td><a class="code" href="<%= base %>/sku/<%= encodeURIComponent(r.code) %>"><%= r.code %></a></td>
              <td class="nm"><%= r.name %></td>
              <td><%= KIND_WORDS[r.kind] || r.kind %></td>
              <td><%= when(r.created_at) %></td>
              <td class="muted"><%= r.created_by %></td>
            </tr>
          <% } %>
          </tbody>
        </table></div>
        <div class="hint" style="margin-top:10px">NE への登録は「<a href="<%= base %>/reg-csv">NE 登録の CSV</a>」で。<% if (cdb.total > cdb.rows.length) { %> 新しい順に <%= cdb.rows.length %> 件まで出しています。全部は <a href="<%= base %>/?reg=draft">商品・セットの一覧 (登録が下書き)</a> で。<% } else { %> 一覧で絞るときは <a href="<%= base %>/?reg=draft">商品・セットの一覧 (登録が下書き)</a>。<% } %></div>
      <% } %>
    </section>
  </div>
  <%- include('_footer') %>
</body>
</html>
