<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .fbx-wrap { max-width: 960px; margin: 0 auto; padding: 12px 16px; }
    .fbx-box { background: #f8f9fa; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px; }
    .fbx-box h2 { font-size: 1.0em; margin: 0 0 10px; }
    .fbx-box p.hint { font-size: 0.85em; color: #495057; margin: 0 0 10px; line-height: 1.6; }
    .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .row input[type=text], .row input[type=file] { padding: 7px; }
    .row select { padding: 7px; min-width: 260px; }
    .row button { padding: 7px 18px; cursor: pointer; }
    .msg { font-size: 0.9em; white-space: pre-wrap; } .msg.err { color: #c92a2a; } .msg.ok { color: #2b8a3e; }
    table.fbx-list { width: 100%; border-collapse: collapse; font-size: 0.88em; }
    table.fbx-list th, table.fbx-list td { border-bottom: 1px solid #dee2e6; padding: 6px 8px; text-align: left; vertical-align: top; }
    table.fbx-list th { background: #f1f3f5; white-space: nowrap; }
    tr.revoked td, tr.inactive td { color: #adb5bd; text-decoration: line-through; }
    .btn-sm { padding: 3px 10px; font-size: 0.85em; cursor: pointer; }
    .ng { color: #c92a2a; }
    .code-big { font-size: 2em; font-weight: 700; letter-spacing: 0.2em; font-family: ui-monospace, Menlo, monospace; }
    .st { font-size: 0.8em; font-weight: 700; border-radius: 6px; padding: 2px 8px; }
    .st.active { background: #D3F9D8; color: #2B8A3E; }
    .st.setup { background: #FFF3BF; color: #997404; }
    .st.done, .st.cancelled { background: #E9ECEF; color: #868E96; }
    details.issues { margin-top: 6px; font-size: 0.85em; }
    code { background: #e9ecef; padding: 1px 5px; border-radius: 4px; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">📦 FBA箱詰め記録 管理</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="<%= base %>/" class="btn-logout">📱 作業画面</a>
      <a href="/" class="btn-logout">ダッシュボード</a>
    </div>
  </header>

  <div class="fbx-wrap">

    <div class="fbx-box">
      <h2>🚀 納品回</h2>
      <p class="hint">
        <b>通常は何もしなくてよい</b>: picking-prep の「処理を実行」が終わると納品回が自動でできて、いろはの iPad にすぐ出ます
        (いろはも iPad の「作業開始」から作れます)。ここは自動作成が失敗したとき・作り直したいとき用。<br>
        STA のパックリスト Excel は<b>出力の前までに</b>各納品回の「📎 Excel添付」で付けてください (作業の前でも途中でも後でも可。P1/P2 で別ファイルならそれぞれ添付)。
      </p>
      <% if (pickingError) { %><p class="msg err">⚠ picking-prep のデータを読めません: <%= pickingError %></p><% } %>
      <div class="row">
        <select id="pk-run">
          <option value="">ピッキング実行を選ぶ…</option>
          <% for (const r of pickingRuns) { %>
            <option value="<%= r.id %>" <%= r.boxRun ? 'disabled' : '' %>>#<%= r.id %> — <%= r.delivery_date ? r.delivery_date + ' 納品分' : (r.run_at || '').slice(0, 16) %> (<%= r.plan_sheet_count %>シート)<%= r.boxRun ? ' — 納品回 #' + r.boxRun.id + ' 作成済み' : '' %></option>
          <% } %>
        </select>
        <button id="pk-go2">📦 納品回をつくる (Excel なし)</button>
      </div>
      <details style="margin-top:8px"><summary class="hint" style="cursor:pointer">旧: Excel を同時に添付して作る</summary>
        <div class="row" style="margin-top:6px">
          <input type="file" id="pk-excel" accept=".xlsx">
          <button id="pk-go">Excel と一緒に納品回をつくる</button>
        </div>
      </details>
      <div class="msg" id="pk-msg"></div>
    </div>

    <div class="fbx-box">
      <h2>🗂 納品回</h2>
      <table class="fbx-list">
        <tr><th>#</th><th>タイトル</th><th>状態</th><th>商品/グループ</th><th>作成</th><th>操作</th></tr>
        <% for (const r of runs) { %>
          <tr>
            <td><%= r.id %></td>
            <td><%= r.title %></td>
            <td><span class="st <%= r.status %>"><%= { setup:'準備中', active:'作業中', done:'完了', cancelled:'取消' }[r.status] || r.status %></span></td>
            <td><%= r.row_count %>商品 / <%= r.group_count %>グループ</td>
            <td><%= (r.created_at || '').slice(0, 16).replace('T', ' ') %><br><small><%= r.created_by || '' %></small></td>
            <td>
              <button class="btn-sm run-detail" data-id="<%= r.id %>">進捗</button>
              <% if (r.status === 'setup') { %>
                <button class="btn-sm run-activate" data-id="<%= r.id %>">✅ 有効化 (iPadに出す)</button>
              <% } %>
              <% if (r.status === 'active' || r.status === 'done') { %>
                <button class="btn-sm run-images" data-id="<%= r.id %>">🖼 画像</button>
                <button class="btn-sm run-excel" data-id="<%= r.id %>">📎 Excel添付</button>
                <button class="btn-sm run-export" data-id="<%= r.id %>">📤 Excel出力</button>
                <a class="btn-sm" href="<%= base %>/print/boxes?run=<%= r.id %>" target="_blank">🖨 箱札</a>
              <% } %>
              <% if (r.status === 'active') { %>
                <button class="btn-sm run-done" data-id="<%= r.id %>">🏁 完了にする</button>
              <% } %>
              <% if (r.status === 'setup' || r.status === 'active') { %>
                <button class="btn-sm run-cancel" data-id="<%= r.id %>">取消</button>
              <% } %>
            </td>
          </tr>
        <% } %>
        <% if (runs.length === 0) { %><tr><td colspan="6">まだありません</td></tr><% } %>
      </table>
      <div class="msg" id="run-msg"></div>
      <div id="run-detail-out"></div>
      <input type="file" id="attach-file" accept=".xlsx" style="display:none">
    </div>

    <div class="fbx-box" id="export-box" style="display:none">
      <h2>📤 Excel 出力 — <span id="ex-title"></span></h2>
      <p class="hint">
        出荷前チェックの⛔が消えたら出力できます。出力はアップロードした原本 (STA のパックリスト) の対象セルだけを書き換えたファイルで、
        ファイル名も原本と同じです。ダウンロード → STA の「輸送箱の梱包情報」でアップロード → 期限は STA 画面で入力 → ここで「STA にアップした」を記録 (納品回が完了になります)。
      </p>
      <div id="ex-body"></div>
    </div>

    <div class="fbx-box">
      <h2>👤 作業者 (いろは名簿)</h2>
      <p class="hint">iPad の名前タップに出る名簿。職員は 🔑PIN を設定すると、取消・不足確定・箱の開け直し・箱の取消ができます。<br>
        名簿の追加・PIN設定は <b>iPad の「👥 名簿」からいろはの職員が自分で行えます</b> (職員PINが必要。PIN持ちの職員がいない最初の1回だけ PIN なしで登録可)。ここは本社側の補助です。</p>
      <div class="row">
        <input type="text" id="w-name" placeholder="表示名 (例: たなか)" maxlength="30">
        <select id="w-type"><option value="member">利用者</option><option value="staff">職員</option></select>
        <button id="w-add" <%= isAdmin ? '' : 'disabled title="管理者のみ"' %>>追加</button>
      </div>
      <table class="fbx-list" style="margin-top:8px">
        <tr><th>名前</th><th>区分</th><th>PIN</th><th>操作</th></tr>
        <% for (const w of workers) { %>
          <tr class="<%= w.active ? '' : 'inactive' %>">
            <td><%= w.display_name %></td>
            <td><%= w.worker_type === 'staff' ? '職員' : '利用者' %></td>
            <td><%= w.worker_type === 'staff' ? (w.pin_set ? '設定済み' : '未設定') : '—' %></td>
            <td>
              <% if (isAdmin) { %>
                <% if (w.worker_type === 'staff') { %><button class="btn-sm w-pin" data-id="<%= w.id %>">PIN設定</button><% } %>
                <button class="btn-sm w-toggle" data-id="<%= w.id %>" data-active="<%= w.active %>"><%= w.active ? '無効にする' : '有効に戻す' %></button>
              <% } %>
            </td>
          </tr>
        <% } %>
      </table>
      <div class="msg" id="w-msg"></div>
    </div>

    <% if (isAdmin) { %>
    <div class="fbx-box">
      <h2>📦 資材 (段ボール) — 外寸は Excel の幅・長さ・高さ欄に入ります</h2>
      <p class="hint">外寸 cm が空の資材で作った箱は、Excel の寸法欄が空のまま出力され STA 画面で手入力になります。自重 g は重量補助 (PR3) 用です。</p>
      <table class="fbx-list" id="mat-table">
        <tr><th>コード</th><th>名前</th><th>自重g</th><th>幅cm</th><th>長さcm</th><th>高さcm</th><th>並び</th><th>有効</th><th></th></tr>
        <% for (const m of materials) { %>
          <tr class="mat-row" data-code="<%= m.code %>">
            <td><code><%= m.code %></code></td>
            <td><input type="text" class="m-name" value="<%= m.name %>" maxlength="30" style="width:150px"></td>
            <td><input type="number" class="m-tare" value="<%= m.tare_g == null ? '' : m.tare_g %>" style="width:70px"></td>
            <td><input type="number" step="0.1" class="m-w" value="<%= m.width_cm == null ? '' : m.width_cm %>" style="width:70px"></td>
            <td><input type="number" step="0.1" class="m-l" value="<%= m.length_cm == null ? '' : m.length_cm %>" style="width:70px"></td>
            <td><input type="number" step="0.1" class="m-h" value="<%= m.height_cm == null ? '' : m.height_cm %>" style="width:70px"></td>
            <td><input type="number" class="m-sort" value="<%= m.sort %>" style="width:50px"></td>
            <td><input type="checkbox" class="m-active" <%= m.active ? 'checked' : '' %>></td>
            <td><button class="btn-sm m-save">保存</button></td>
          </tr>
        <% } %>
        <tr class="mat-row" data-code="">
          <td><input type="text" class="m-code" placeholder="例: box120" maxlength="20" style="width:90px"></td>
          <td><input type="text" class="m-name" placeholder="名前" maxlength="30" style="width:150px"></td>
          <td><input type="number" class="m-tare" style="width:70px"></td>
          <td><input type="number" step="0.1" class="m-w" style="width:70px"></td>
          <td><input type="number" step="0.1" class="m-l" style="width:70px"></td>
          <td><input type="number" step="0.1" class="m-h" style="width:70px"></td>
          <td><input type="number" class="m-sort" value="5" style="width:50px"></td>
          <td><input type="checkbox" class="m-active" checked></td>
          <td><button class="btn-sm m-save">追加</button></td>
        </tr>
      </table>
      <div class="msg" id="m-msg"></div>
    </div>

    <div class="fbx-box">
      <h2>📱 iPad の登録</h2>
      <p class="hint">
        「登録コードを発行」→ iPad で <code><%= base %>/enroll</code> を開いて6桁を入力。コードは<b>10分・1回</b>だけ有効。
        2台目はコードを<b>発行し直して</b>ください (発行すると前の未使用コードは無効になります)。
      </p>
      <div class="row">
        <input type="text" id="e-label" placeholder="端末名 (例: いろはiPad 1号)" maxlength="40">
        <button id="e-issue">登録コードを発行</button>
      </div>
      <div class="msg" id="e-out"></div>
      <% if (enrollCodes.length > 0) { %>
        <p class="hint">未使用のコード: <% for (const c of enrollCodes) { %><code><%= c.label %></code> (期限 <%= new Date(c.expires_at).toLocaleTimeString('ja-JP') %>) <% } %></p>
      <% } %>
      <table class="fbx-list" style="margin-top:8px">
        <tr><th>端末</th><th>登録</th><th>最終アクセス</th><th>操作</th></tr>
        <% for (const d of devices) { %>
          <tr class="<%= d.revoked_at ? 'revoked' : '' %>">
            <td><%= d.label %></td>
            <td><%= (d.created_at || '').slice(0, 16).replace('T', ' ') %></td>
            <td><%= d.last_seen_at ? d.last_seen_at.slice(0, 16).replace('T', ' ') : '—' %></td>
            <td><% if (!d.revoked_at) { %><button class="btn-sm d-revoke" data-id="<%= d.id %>">解除</button><% } %></td>
          </tr>
        <% } %>
        <% if (devices.length === 0) { %><tr><td colspan="4">登録された端末はありません</td></tr><% } %>
      </table>
    </div>
    <% } %>

    <div class="fbx-box">
      <h2>📜 操作履歴 (直近50件)</h2>
      <table class="fbx-list">
        <tr><th>日時</th><th>操作</th><th>回</th><th>作業者</th><th>端末</th><th>内容</th></tr>
        <% for (const e of events) { %>
          <tr>
            <td><%= (e.at || '').slice(5, 16).replace('T', ' ') %></td>
            <td><%= e.action %><%= e.ok ? '' : ' ❌' %></td>
            <td><%= e.run_id || '' %></td>
            <td><%= e.worker_name || '' %></td>
            <td><%= e.device_label || '' %></td>
            <td style="max-width:320px; overflow-wrap:anywhere"><small><%= e.payload || e.error || '' %></small></td>
          </tr>
        <% } %>
      </table>
    </div>

  </div>

  <script>
    const BASE = '<%= base %>';
    const $ = s => document.querySelector(s);
    const REASON_JA = { missing: '現物がない', damaged: '破損', bad_label: 'ラベル不良', wrong_item: '商品違い', expiry_issue: '期限が合わない',
      hq_order: '本社指示', stock_short: '在庫が少ない', not_shipped: '今回は納品しない', other: 'その他' };
    // 不足の理由 (内訳があれば「破損 2 + 今回は納品しない 3」)
    const shortageJa = (x) => {
      try { const d = JSON.parse(x.shortage_detail || 'null'); if (Array.isArray(d)) return d.map(y => `${REASON_JA[y.reason] || y.reason} ${y.qty}`).join(' + '); } catch { /* noop */ }
      return REASON_JA[x.shortage_reason] || x.shortage_reason || '';
    };
    async function post(url, body) {
      const r = await fetch(BASE + url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
      return r.json().catch(() => ({ ok: false, message: 'HTTP ' + r.status }));
    }
    const setMsg = (el, kind, text) => { el.className = 'msg ' + (kind || ''); el.textContent = text; };

    // 納品回の作成
    $('#pk-go').addEventListener('click', async () => {
      const runId = $('#pk-run').value;
      const file = $('#pk-excel').files[0];
      const msg = $('#pk-msg');
      if (!runId) return setMsg(msg, 'err', 'ピッキング実行を選んでください');
      if (!file) return setMsg(msg, 'err', 'パックリストExcel (.xlsx) を選んでください');
      setMsg(msg, '', '解析・突合しています…');
      const fd = new FormData();
      fd.append('source_run_id', runId);
      fd.append('excel', file);
      const r = await fetch(BASE + '/admin/runs', { method: 'POST', body: fd });
      const j = await r.json().catch(() => ({ ok: false, message: 'HTTP ' + r.status }));
      if (!j.ok) {
        let t = j.message || '作成できませんでした';
        if (j.issues) t += '\n' + j.issues.map(i => `- [${i.kind}] ${i.sheet || ''} 行${i.excelRow || ''} ${i.fnsku || ''}`).join('\n');
        return setMsg(msg, 'err', t);
      }
      let t = `✅ 納品回 #${j.runId} を作成しました (準備中)。突合結果を確認して「有効化」してください`;
      if (!j.fingerprintKnown) t += `\n⚠ 新しいテンプレ形式です (fingerprint=${j.fingerprint})。初回はExcel出力後にSTAアップロードまで必ず確認`;
      if (j.issues.length > 0) t += '\n注意:\n' + j.issues.map(i => `- [${i.kind}] ${i.sheet || ''} 行${i.excelRow || ''} ${i.fnsku || ''} ${i.excelQty != null ? `Excel:${i.excelQty} vs picking:${i.pickingQty}` : ''}`).join('\n');
      setMsg(msg, 'ok', t);
      setTimeout(() => location.reload(), j.issues.length > 0 ? 8000 : 1500);
    });

    // 商品画像の状態 (なぜ出ないか) と取り直し
    document.querySelectorAll('.run-images').forEach(b => b.addEventListener('click', async () => {
      const runId = Number(b.dataset.id);
      const out = $('#run-detail-out');
      out.innerHTML = '読み込み中…';
      const r = await fetch(`${BASE}/admin/runs/${runId}/images`);
      const j = await r.json().catch(() => ({ ok: false }));
      if (!j.ok) { out.innerHTML = `<p class="msg err">${escH(j.message || '読み込めませんでした')}</p>`; return; }
      const lr = j.lastRun;
      out.innerHTML = `<h3 style="margin:14px 0 6px">🖼 商品画像 — 回 #${runId}</h3>
        <p class="hint">
          設定: ${j.configured ? '✅ miniPC 接続 (WAREHOUSE_SERVICE_TOKEN あり)' : '<b class="ng">⛔ WAREHOUSE_SERVICE_TOKEN が未設定 — Render の環境変数を確認してください</b>'} / ${escH(j.warehouseUrl)}<br>
          SKU属性 (FNSKU→ASIN): ${j.attrs.error ? `<b class="ng">読めません: ${escH(j.attrs.error)}</b>` : `${j.attrs.count} 件`}<br>
          画像あり <b>${j.counts.withImage}</b> / ${j.counts.total} 商品 ${j.counts.noAsin ? `<b class="ng">(ASIN 不明 ${j.counts.noAsin})</b>` : ''}<br>
          ${lr ? `直近の取得 (${escH((lr.at || '').slice(11, 16))}): ${lr.skipped ? `skip=${escH(lr.skipped)} ${escH(lr.message || lr.error || '')}` : `取得${lr.fetched} / 画像なし${lr.none} / 失敗${lr.failed}${lr.noAsin ? ` (ASIN不明 ${lr.noAsin})` : ''}`}${(lr.errors || []).length ? '<br>' + lr.errors.map(escH).join('<br>') : ''}` : '(まだ取得していません)'}
        </p>
        ${j.counts.withImage < j.counts.total - j.counts.noAsin ? '<p class="hint">未取得の商品は裏で取りに行っています (1商品 0.6 秒)。しばらくして「🖼 画像」をもう一度開くと増えます。急ぐときは下のボタン。</p>' : ''}
        <div class="row"><button id="img-refresh">🔄 今すぐ取り直す</button></div>
        <table class="fbx-list" style="margin-top:8px"><tr><th>画像</th><th>FNSKU</th><th>SKU</th><th>ASIN</th><th>状態</th></tr>
        ${j.items.map(x => `<tr>
          <td>${x.imageUrl ? `<img src="${escH(x.imageUrl)}" referrerpolicy="no-referrer" style="width:40px;height:40px;object-fit:contain">` : '—'}</td>
          <td><code>${escH(x.fnsku)}</code></td><td>${escH(x.sku || '')}</td>
          <td>${x.asin ? `${escH(x.asin)} <small>(${escH(x.asinFrom)})</small>` : '<b class="ng">不明</b>'}</td>
          <td>${x.cache ? `${escH(x.cache.status)}${x.cache.error_message ? ' — ' + escH(x.cache.error_message) : ''}` : '未取得'}</td></tr>`).join('')}
        </table>`;
      $('#img-refresh').addEventListener('click', async () => {
        $('#img-refresh').disabled = true;
        $('#img-refresh').textContent = '取得中… (商品数 × 0.6 秒。裏で動いていれば終わるまで待ちます)';
        const jj = await post(`/admin/runs/${runId}/images/refresh`);
        const skipJa = { in_flight: 'いま取得中です', not_configured: 'miniPC への接続が未設定です', throttled: '少し前に取得したばかりです', error: 'エラー' };
        alert(jj.ok
          ? (jj.result.skipped ? `${skipJa[jj.result.skipped] || jj.result.skipped}${jj.result.message ? '\n' + jj.result.message : ''}${jj.result.error ? '\n' + jj.result.error : ''}`
            : `取得: ${jj.result.fetched} / 画像なし: ${jj.result.none} / 失敗: ${jj.result.failed}${jj.result.noAsin ? ` (ASIN不明 ${jj.result.noAsin})` : ''}${jj.result.remaining ? `\nまだ ${jj.result.remaining} 件残っています。もう一度押してください` : ''}`)
          : (jj.message || '失敗'));
        b.click();
      });
      out.scrollIntoView({ behavior: 'smooth' });
    }));

    // 納品回の作成 (Excel なし) — picking 実行から
    $('#pk-go2').addEventListener('click', async () => {
      const runId = $('#pk-run').value;
      const msg = $('#pk-msg');
      if (!runId) return setMsg(msg, 'err', 'ピッキング実行を選んでください');
      const j = await post('/admin/runs/from-picking', { source_run_id: Number(runId) });
      if (!j.ok) return setMsg(msg, 'err', j.message || '作成できませんでした');
      setMsg(msg, 'ok', j.already ? `納品回 #${j.runId} は作成済みです` : `✅ 納品回 #${j.runId} を作成しました (iPad に出ます)。Excel は出力の前までに「📎 Excel添付」で付けてください`);
      setTimeout(() => location.reload(), 1200);
    });

    // Excel 添付 (納品回ごと。P1/P2 で別ファイルなら 2 回)
    let attachRunId = null;
    document.querySelectorAll('.run-excel').forEach(b => b.addEventListener('click', () => { attachRunId = b.dataset.id; $('#attach-file').value = ''; $('#attach-file').click(); }));
    $('#attach-file').addEventListener('change', async () => {
      const file = $('#attach-file').files[0];
      if (!file || !attachRunId) return;
      const msg = $('#run-msg');
      setMsg(msg, '', `#${attachRunId} に ${file.name} を添付しています (解析・突合)…`);
      const fd = new FormData();
      fd.append('excel', file);
      const r = await fetch(`${BASE}/admin/runs/${attachRunId}/excel`, { method: 'POST', body: fd });
      const j = await r.json().catch(() => ({ ok: false, message: 'HTTP ' + r.status }));
      if (!j.ok) {
        let t = j.message || '添付できませんでした';
        if (j.issues) t += '\n' + j.issues.map(i => `- ${i.kind} ${i.sheetName || ''}`).join('\n');
        return setMsg(msg, 'err', t);
      }
      let t = `✅ 添付しました: ` + j.groups.map(g => `${g.sheetName} ← ${g.packingGroupId} (一致${g.matched}${g.qty_mismatch ? ' / 数量差' + g.qty_mismatch : ''}${g.excel_only ? ' / Excelのみ' + g.excel_only : ''}${g.picking_only ? ' / Excelに無い' + g.picking_only : ''})`).join('、');
      if (j.unassignedGroups && j.unassignedGroups.length) t += `\nまだ Excel が無いグループが ${j.unassignedGroups.length} つあります (別プランの Excel を添付してください)`;
      if (j.warnings && j.warnings.length) t += '\n注意:\n' + j.warnings.slice(0, 15).map(w => `- [${w.kind}] ${w.group || ''} ${w.fnsku || ''}${w.excelQty != null ? ` Excel:${w.excelQty}` : ''}${w.pickingQty != null ? ` picking:${w.pickingQty}` : ''}${w.boxes != null ? ` 箱${w.boxes} > 上限${w.maxBoxColumns}` : ''}`).join('\n');
      setMsg(msg, 'ok', t);
      setTimeout(() => openExportPanel(Number(attachRunId)), 600);
    });

    // 納品回の操作
    document.querySelectorAll('.run-activate').forEach(b => b.addEventListener('click', async () => {
      const j = await post(`/admin/runs/${b.dataset.id}/activate`);
      setMsg($('#run-msg'), j.ok ? 'ok' : 'err', j.ok ? '有効化しました (iPadに出ます)' : j.message);
      if (j.ok) setTimeout(() => location.reload(), 800);
    }));
    document.querySelectorAll('.run-done').forEach(b => b.addEventListener('click', async () => {
      if (!confirm('この納品回を完了にしますか? (以後 iPad から入力できません)')) return;
      let j = await post(`/admin/runs/${b.dataset.id}/finish`, { acknowledge: false });
      if (!j.ok && j.error === 'incomplete') {
        const list = j.rows.slice(0, 15).map(x => `- ${x.planNo || ''} ${(x.name || '').slice(0, 30)}: 残り ${x.remaining}`).join('\n');
        if (!confirm(`${j.message}\n\n${list}${j.rows.length > 15 ? '\n…' : ''}\n\n残りを「今回は納品しない」として完了しますか?`)) return;
        j = await post(`/admin/runs/${b.dataset.id}/finish`, { acknowledge: true });
      }
      setMsg($('#run-msg'), j.ok ? 'ok' : 'err', j.ok ? `完了にしました${j.notShipped ? ` (納品しない商品 ${j.notShipped} 行)` : ''}` : j.message);
      if (j.ok) setTimeout(() => location.reload(), 800);
    }));
    document.querySelectorAll('.run-cancel').forEach(b => b.addEventListener('click', async () => {
      if (!confirm('この納品回を取消にしますか?')) return;
      const j = await post(`/admin/runs/${b.dataset.id}/status`, { status: 'cancelled' });
      setMsg($('#run-msg'), j.ok ? 'ok' : 'err', j.ok ? '取消しました' : j.message);
      if (j.ok) setTimeout(() => location.reload(), 800);
    }));
    document.querySelectorAll('.run-detail').forEach(b => b.addEventListener('click', async () => {
      const r = await fetch(`${BASE}/admin/runs/${b.dataset.id}`);
      const j = await r.json().catch(() => ({ ok: false }));
      const out = $('#run-detail-out');
      if (!j.ok) { out.innerHTML = '<p class="msg err">読み込めませんでした</p>'; return; }
      const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));
      out.innerHTML = `<h3 style="margin:14px 0 6px">回 #${j.run.id} ${esc(j.run.title)} の進捗</h3>` +
        j.groups.map(g => {
          const rows = j.rows.filter(x => x.pack_group_id === g.id);
          const boxes = j.boxes.filter(x => x.pack_group_id === g.id);
          const done = rows.filter(x => x.placed + (x.shortage_qty || 0) >= x.planned_qty).length;
          return `<p><b>${esc(g.sheet_name)}</b> (${esc(g.packing_group_id)}) — 行 ${done}/${rows.length} 完了 / 箱 ${boxes.length} (閉 ${boxes.filter(x => x.status === 'closed').length})</p>
          <table class="fbx-list"><tr><th>行</th><th>プランNo</th><th>FNSKU</th><th>商品</th><th>予定</th><th>送る数 (修正)</th><th>入力済</th><th>担当</th></tr>` +
            rows.map(x => `<tr><td>${x.excel_row ?? ''}</td><td>${esc(x.plan_no || '')}</td><td><code>${esc(x.fnsku)}</code></td>
              <td>${esc((x.product_name || '').slice(0, 40))}${x.match_state === 'picking_only' ? ' <span class="ng">(Excelに無い)</span>' : ''}</td><td>${x.planned_qty}</td>
              <td>${x.shortage_qty ? `<b class="ng">${x.planned_qty} → ${x.planned_qty - x.shortage_qty}</b> <small>(${esc(shortageJa(x))}${x.shortage_by ? ' / ' + esc(x.shortage_by) : ''})</small>` : '—'}</td>
              <td>${x.placed}</td>
              <td>${esc(x.label_worker || '')}${x.check_worker ? ' / ✅' + esc(x.check_worker) : ''}</td></tr>`).join('') +
          `</table>
          <p>箱: ${boxes.map(x => `${esc(x.box_code)}(${x.total_qty}個${x.measured_weight_kg ? '・' + x.measured_weight_kg + 'kg' : ''}${x.status === 'closed' ? '・閉' : ''})`).join(' / ') || 'なし'}</p>`;
        }).join('');
    }));

    // ─── Excel 出力 (PR2): 出荷前チェック → 出力 → ダウンロード → STAアップ済み ───
    const escH = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));
    async function openExportPanel(runId) {
      const box = $('#export-box'), body = $('#ex-body');
      box.style.display = '';
      body.innerHTML = '読み込み中…';
      const r = await fetch(`${BASE}/admin/runs/${runId}/readiness`);
      const j = await r.json().catch(() => ({ ok: false }));
      if (!j.ok) { body.innerHTML = `<p class="msg err">${escH(j.message || '読み込めませんでした')}</p>`; return; }
      const rd = j.readiness;
      const stJa = { setup: '準備中', active: '作業中', done: '完了', cancelled: '取消' };
      $('#ex-title').textContent = `#${rd.run.id} ${rd.run.title} (${stJa[rd.run.status] || rd.run.status} / データ版 ${rd.run.dataVersion})`;
      const detail = (x) =>
        (x.rows ? `<ul style="margin:4px 0 0 18px">${x.rows.map(y => `<li>${y.planNo ? '<b>' + escH(y.planNo) + '</b> ' : ''}${escH((y.name || '').slice(0, 40))} <code>${escH(y.fnsku)}</code> 予定${y.planned} 入力${y.placed}${y.shortage ? ` <b class="ng">送る数 ${y.planned} → ${y.sendQty}</b>` : ''}${y.matchState ? ' [' + escH(y.matchState) + ']' : ''}${y.reasonJa || y.reason ? ' (' + escH(y.reasonJa || y.reason) + ')' : ''}</li>`).join('')}</ul>` : '') +
        (x.boxes ? `<ul style="margin:4px 0 0 18px">${x.boxes.map(y => `<li>${escH(y.code)}${y.amazonName && y.amazonBoxNo !== y.boxNo ? ' → Amazon ' + escH(y.amazonName) : ''} (${y.qty}個)</li>`).join('')}</ul>` : '');
      body.innerHTML = `
        <h3 style="margin:8px 0 4px">出荷前チェック</h3>
        ${rd.ok ? '<p class="msg ok">✅ ブロッカーなし — 出力できます</p>' : rd.blockers.map(x => `<div class="msg err">⛔ ${escH(x.message)}${detail(x)}</div>`).join('')}
        ${rd.warnings.map(x => `<div class="msg" style="color:#B5651D">⚠ ${escH(x.message)}${detail(x)}</div>`).join('')}
        <h3 style="margin:14px 0 4px">箱 ↔ Amazon 箱番号</h3>
        ${rd.groups.map(g => `<p style="margin:4px 0"><b>${escH(g.sheetName)}</b> — ${g.excelAttached ? `Excel 添付済み (${escH(g.packingGroupId || '')}${g.excelFileId ? ' / file#' + g.excelFileId : ''}) / テンプレ上限 ${g.maxBoxColumns}` : '<span class="ng">Excel 未添付</span>'} — ${g.boxes.length} 箱 / 行: ${escH(Object.entries(g.rowCounts || {}).map(([k, v]) => k + ' ' + v).join(', '))}</p>
          <table class="fbx-list"><tr><th>箱札</th><th>Amazon</th><th>個数</th><th>実測kg</th><th>資材</th><th>外寸 幅×長さ×高さ</th><th>状態</th></tr>
          ${g.boxes.map(b => `<tr><td>${escH(b.code)}</td><td ${b.amazonBoxNo !== b.boxNo ? 'class="ng"' : ''}>${escH(b.amazonName)}</td><td>${b.qty}</td><td>${b.weightKg ?? ''}</td><td>${escH(b.material || '')}</td>
            <td>${b.dims && b.dims.width ? `${b.dims.width}×${b.dims.length}×${b.dims.height}` : '<span class="ng">未設定 (STA画面で入力)</span>'}</td><td>${b.status === 'closed' ? '閉' : '開'}</td></tr>`).join('')}
          </table>`).join('')}
        <h3 style="margin:14px 0 4px">期限一覧 (STA 画面へ転記 — Excel には書きません)</h3>
        ${rd.expiries.length === 0 ? '<p class="hint">期限の記録はありません</p>' : `<table class="fbx-list"><tr><th>FNSKU</th><th>SKU</th><th>商品</th><th>期限</th><th>個数</th></tr>
          ${rd.expiries.map(e => `<tr><td><code>${escH(e.fnsku)}</code></td><td>${escH(e.sku)}</td><td>${escH((e.name || '').slice(0, 40))}</td><td><b>${escH(e.expiry)}</b></td><td>${e.qty}</td></tr>`).join('')}</table>
          <button class="btn-sm" id="ex-copy" style="margin-top:6px">📋 期限一覧をコピー (タブ区切り)</button>`}
        <h3 style="margin:14px 0 4px">出力履歴</h3>
        ${j.exports.length === 0 ? '<p class="hint">まだ出力していません</p>' : `<table class="fbx-list"><tr><th>#</th><th>ファイル</th><th>データ版</th><th>作成</th><th>状態</th><th>操作</th></tr>
          ${j.exports.map(e => `<tr><td>${e.id}</td><td>${escH(e.file_name || '')}</td><td>${e.data_version}</td><td>${(e.created_at || '').slice(0, 16).replace('T', ' ')}<br><small>${escH(e.created_by || '')}</small></td>
            <td>${e.sta_uploaded ? '<span class="st active">STAアップ済み</span>' : (e.stale ? '<span class="st cancelled">旧版 (出力後にデータ変更あり)</span>' : '<span class="st setup">最新</span>')}</td>
            <td><a class="btn-sm" href="${BASE}/admin/exports/${e.id}/download">⬇ ダウンロード</a>
              ${!e.stale && !e.sta_uploaded && !rd.run.staUploadedAt && !(rd.fileStates || []).some(f => f.fileId === e.excel_file_id && f.uploaded) ? `<button class="btn-sm ex-sta" data-id="${e.id}">✅ STA にアップした</button>` : ''}</td></tr>`).join('')}</table>`}
        <div class="row" style="margin-top:12px">
          <button id="ex-go" ${rd.ok ? '' : 'disabled'}>📤 Excel を出力する${rd.exportState.latest && !rd.exportState.stale ? ' (同じ内容の再出力)' : ''}</button>
          <button id="ex-close">閉じる</button>
        </div>
        <div class="msg" id="ex-msg"></div>`;
      $('#ex-close').addEventListener('click', () => { box.style.display = 'none'; });
      $('#ex-copy')?.addEventListener('click', async () => {
        const tsv = ['FNSKU\tSKU\t商品\t期限\t個数', ...rd.expiries.map(e => [e.fnsku, e.sku, e.name, e.expiry, e.qty].join('\t'))].join('\n');
        try { await navigator.clipboard.writeText(tsv); setMsg($('#ex-msg'), 'ok', '期限一覧をコピーしました'); }
        catch { setMsg($('#ex-msg'), 'err', 'コピーできませんでした (表を選択してコピーしてください)'); }
      });
      $('#ex-go').addEventListener('click', async () => {
        $('#ex-go').disabled = true;
        setMsg($('#ex-msg'), '', '原本に書き込んで検算しています…');
        const jj = await post(`/admin/runs/${runId}/exports`);
        if (!jj.ok) {
          setMsg($('#ex-msg'), 'err', (jj.message || '出力できませんでした') + (jj.readiness ? '\n' + jj.readiness.blockers.map(b => '- ' + b.message).join('\n') : ''));
          $('#ex-go').disabled = false;
          return;
        }
        const list = jj.exports || [{ exportId: jj.exportId, written: jj.written, downloadUrl: jj.downloadUrl, fileName: '' }];
        const m = $('#ex-msg');
        m.className = 'msg ok';
        m.innerHTML = `✅ 出力 ${list.length} ファイル (検算OK)${jj.stale ? '<br>⚠ 書き込み中にデータが変わりました。もう一度出力してください' : ''}<br>` +
          list.map(x => `<a href="${x.downloadUrl}">⬇ #${x.exportId} ${escH(x.fileName || 'packlist.xlsx')} (${x.written} セル)</a>`).join('<br>') +
          (list.length > 1 ? '<br><small>ファイルごとに STA の該当プランへアップロードしてください</small>' : '');
        window.location.href = list[0].downloadUrl;   // attachment なので画面は残る (2 つ目以降はリンクから)
        setTimeout(() => openExportPanel(runId), 1500);
      });
      document.querySelectorAll('.ex-sta').forEach(b => b.addEventListener('click', async () => {
        if (!confirm('この出力ファイルを STA にアップロードしましたか?\n付いている Excel が全部アップ済みになると納品回は「完了」になり、iPad から変更できなくなります')) return;
        const jj = await post(`/admin/runs/${runId}/sta-uploaded`, { export_id: Number(b.dataset.id) });
        if (!jj.ok) return setMsg($('#ex-msg'), 'err', jj.message);
        setMsg($('#ex-msg'), 'ok', jj.runDone ? 'STA アップ済みとして記録しました (全ファイル完了 → 納品回は完了)' : `STA アップ済みとして記録しました。残り: ${(jj.remaining || []).join(', ') || 'なし'}`);
        setTimeout(() => (jj.runDone ? location.reload() : openExportPanel(runId)), 900);
      }));
    }
    document.querySelectorAll('.run-export').forEach(b => b.addEventListener('click', () => {
      openExportPanel(Number(b.dataset.id));
      $('#export-box').scrollIntoView({ behavior: 'smooth' });
    }));

    // 資材 (管理者)
    document.querySelectorAll('.m-save').forEach(b => b.addEventListener('click', async () => {
      const tr = b.closest('tr');
      const v = cls => { const el = tr.querySelector(cls); return el ? el.value : ''; };
      const j = await post('/admin/materials', {
        code: tr.dataset.code || v('.m-code'), name: v('.m-name'), tare_g: v('.m-tare'),
        width_cm: v('.m-w'), length_cm: v('.m-l'), height_cm: v('.m-h'), sort: v('.m-sort'),
        active: tr.querySelector('.m-active').checked,
      });
      setMsg($('#m-msg'), j.ok ? 'ok' : 'err', j.ok ? '保存しました' : j.message);
      if (j.ok) setTimeout(() => location.reload(), 600);
    }));

    // 作業者
    $('#w-add')?.addEventListener('click', async () => {
      const j = await post('/admin/workers', { display_name: $('#w-name').value, worker_type: $('#w-type').value });
      setMsg($('#w-msg'), j.ok ? 'ok' : 'err', j.ok ? '追加しました' : j.message);
      if (j.ok) setTimeout(() => location.reload(), 600);
    });
    document.querySelectorAll('.w-toggle').forEach(b => b.addEventListener('click', async () => {
      const j = await post(`/admin/workers/${b.dataset.id}/active`, { active: b.dataset.active !== '1' });
      if (j.ok) location.reload(); else setMsg($('#w-msg'), 'err', j.message);
    }));
    document.querySelectorAll('.w-pin').forEach(b => b.addEventListener('click', async () => {
      const pin = prompt('職員PIN (4〜8桁の数字)');
      if (!pin) return;
      const j = await post(`/admin/workers/${b.dataset.id}/pin`, { pin });
      setMsg($('#w-msg'), j.ok ? 'ok' : 'err', j.ok ? 'PINを設定しました' : j.message);
      if (j.ok) setTimeout(() => location.reload(), 600);
    }));

    // 端末登録
    $('#e-issue')?.addEventListener('click', async () => {
      const j = await post('/admin/enroll-codes', { label: $('#e-label').value });
      const out = $('#e-out');
      if (!j.ok) return setMsg(out, 'err', j.message);
      out.className = 'msg ok';
      out.innerHTML = `iPad で <code>${BASE}/enroll</code> を開き、この6桁を入力: <span class="code-big">${j.code}</span> (${j.ttlMinutes}分間有効)`;
    });
    document.querySelectorAll('.d-revoke').forEach(b => b.addEventListener('click', async () => {
      if (!confirm('この端末の登録を解除しますか?')) return;
      const j = await post(`/admin/devices/${b.dataset.id}/revoke`);
      if (j.ok) location.reload();
    }));
  </script>
</body>
</html>
