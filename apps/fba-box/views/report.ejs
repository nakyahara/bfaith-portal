<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>本社向け一覧 — <%= rep.run.title %></title>
<!--
  FBA箱詰め記録 — 本社向けの納品まとめ (中原さん 2026-09-10)。
  いろはが iPad で「作業を終える」と Google チャットにこのページのリンクが届く (notify.js)。
  本社はここを見て 送り状 (個口数・箱ごとのサイズと重さ) と STA の輸送箱ラベル (梱包グループごとの箱・重さ・外寸・
  Amazon の箱番号) を用意する。予定と違う商品は赤。データ = report.js の buildRunReport (読むだけ)
  iPad からも「完了した回の結果」として同じ画面を開く (from=ipad, 中原さん 2026-09-17)。完了した回は Google チャットへの
  知らせの状態と「もう一度送る」を出す (notify)
  画面の順 (中原さん 2026-09-18): いちばん上に ①プラン×区分 (通常・危険物・大型) ごとの箱の数 ②数量の変更・キャンセルが要る
  商品だけ ③期限のある商品だけ。それ以外 (知らせ・グループごとの箱と商品の表・箱の中身) は折りたたみで、はじめは閉じている
  (知らせだけは、送れていないときに開いて出す = 失敗を畳んで隠さない)
-->
<style>
  :root{--ink:#241A12;--sub:#6B5B4E;--faint:#A0938A;--ground:#F7F4F1;--surface:#fff;--line:#E3DAD2;--well:#F1EAE3;
    --accent:#B5651D;--red:#C92A2A;--red-fill:#FFE3E3;--red-line:#F1AEB5;--amber:#8A4B00;--amber-fill:#FDF0DC;--ok:#2B8A3E;--ok-fill:#E3F5E8;
    --font:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Hiragino Kaku Gothic ProN","Yu Gothic UI","Meiryo","Noto Sans JP",sans-serif}
  *{box-sizing:border-box}
  [hidden]{display:none!important}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.6}
  .top{position:sticky;top:0;z-index:5;background:var(--surface);border-bottom:1px solid var(--line);padding:10px 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .top a.back{color:var(--accent);text-decoration:none;font-weight:700;border:1px solid var(--accent);border-radius:8px;padding:5px 10px;font-size:.9rem}
  .top h1{margin:0;font-size:1.1rem}
  .chip{display:inline-block;border-radius:999px;padding:2px 10px;font-size:.8rem;font-weight:700}
  .chip.done{background:var(--ok-fill);color:var(--ok)} .chip.active{background:var(--amber-fill);color:var(--amber)} .chip.other{background:var(--well);color:var(--sub)}
  .top .when{color:var(--sub);font-size:.85rem}
  .top .sp{flex:1}
  .top button{border:0;background:var(--accent);color:#fff;font-weight:700;border-radius:8px;padding:6px 14px;cursor:pointer;font-size:.9rem}
  main{max-width:1100px;margin:0 auto;padding:14px 14px 60px}
  .lead{color:var(--sub);margin:2px 0 12px}
  .note-active{background:var(--amber-fill);color:var(--amber);border-radius:8px;padding:8px 12px;margin-bottom:12px;font-weight:700}
  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px}
  .tile{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
  .tile .k{font-size:.8rem;color:var(--sub)} .tile .v{font-size:1.4rem;font-weight:800;font-variant-numeric:tabular-nums}
  .tile .v small{font-size:.85rem;font-weight:700;color:var(--sub)}
  .tile.bad{background:var(--red-fill);border-color:var(--red-line)} .tile.bad .v{color:var(--red)}
  .tile.warn{background:var(--amber-fill);border-color:#EBC98E} .tile.warn .v{color:var(--amber)}
  section.grp{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:16px}
  h2{margin:0 0 4px;font-size:1.15rem} h2 small{color:var(--sub);font-weight:400;font-size:.8rem}
  h3{margin:16px 0 6px;font-size:1rem}
  .hint{color:var(--sub);font-size:.85rem;margin:0 0 6px}
  .scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table{border-collapse:collapse;width:100%;font-size:.9rem}
  th,td{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top;white-space:nowrap}
  th{background:var(--well);font-size:.78rem;color:var(--sub);font-weight:700}
  td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
  td.name{white-space:normal;min-width:14em}
  tr.alert td{background:var(--red-fill)}
  tr.alert td.diff{color:var(--red);font-weight:800}
  tr.total td{font-weight:800;border-top:2px solid var(--line);background:var(--well)}
  .code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.85rem}
  .muted{color:var(--faint)} .red{color:var(--red);font-weight:700} .amber{color:var(--amber);font-weight:700}
  .copy{margin-top:8px;border:1px solid var(--accent);background:var(--surface);color:var(--accent);font-weight:700;border-radius:8px;padding:5px 12px;cursor:pointer;font-size:.85rem}
  .copied{margin-left:8px;color:var(--ok);font-size:.85rem}
  summary{cursor:pointer;font-weight:700;touch-action:manipulation}
  details table{margin-top:6px}
  details.boxd{border-bottom:1px solid var(--line);padding:6px 0}
  /* いちばん上の 3 つ (①箱の数 ②数量の変更・キャンセル ③期限) — 中原さん 2026-09-18 */
  section.sum h2{font-size:1.2rem;margin-bottom:6px}
  table.plan td,table.plan th{text-align:center;white-space:nowrap}
  table.plan td.pl,table.plan th.pl{text-align:left;font-weight:800}
  table.plan .bx{font-size:1.5rem;font-weight:800;font-variant-numeric:tabular-nums}
  table.plan .sub{display:block;color:var(--sub);font-size:.78rem}
  table.plan td.none{color:var(--faint)}
  tr.subhead td{background:var(--well);font-weight:800;font-size:.85rem}
  td.act{white-space:normal;min-width:9em}
  td.act .why{display:block;color:var(--sub);font-size:.85rem;margin-top:2px} td.act .why.amber{color:var(--amber)}
  .noin{display:none}
  .tag{display:inline-block;border-radius:6px;padding:1px 8px;font-size:.8rem;font-weight:800;margin-right:4px}
  .tag.red{background:var(--red-fill);color:var(--red)} .tag.amber{background:var(--amber-fill);color:var(--amber)}
  .okline{color:var(--ok);font-weight:700;margin:4px 0}
  .pendline{background:var(--amber-fill);color:var(--amber);border-radius:8px;padding:6px 10px;margin:8px 0 0;font-size:.9rem}
  /* その下は折りたたみ (はじめは閉じている) */
  .morehead{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:22px 0 8px}
  .morehead h2{margin:0} .morehead .hint{margin:0}
  .morehead button{border:1px solid var(--accent);background:var(--surface);color:var(--accent);font-weight:700;border-radius:8px;padding:5px 12px;cursor:pointer;font-size:.85rem;touch-action:manipulation}
  details.acc{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin-bottom:10px}
  details.acc>summary{font-size:1.05rem;font-weight:800}
  details.acc>summary small{color:var(--sub);font-weight:400;font-size:.8rem;margin-left:6px}
  details.acc[open]>summary{padding-bottom:8px;margin-bottom:8px;border-bottom:1px solid var(--line)}
  details.notify>summary small.nsum{font-weight:700}
  .notify .nsum.ok{color:var(--ok)} .notify .nsum.bad{color:var(--red)} .notify .nsum.wait{color:var(--amber)}
  .notify .nbtn{margin-top:10px;border:0;border-radius:10px;padding:12px 20px;font-size:1rem;font-weight:800;cursor:pointer;touch-action:manipulation}
  .notify .nbtn.primary{background:var(--accent);color:#fff} .notify .nbtn.plain{background:var(--well);color:var(--ink)}
  .notify .nbtn:disabled{opacity:.45;cursor:default}
  .notify .confirm{margin-top:10px;background:var(--amber-fill);border-radius:10px;padding:12px 14px}
  .notify .confirm p{margin:0 0 4px}
  .notify .nmsg{margin:8px 0 0;font-weight:700} .notify .nmsg.ok{color:var(--ok)} .notify .nmsg.err{color:var(--red)}
  footer{color:var(--faint);font-size:.8rem;text-align:center;margin-top:18px}
  footer a{color:var(--accent)}
  /* スマホ: 商品名の列を細くして、予定・入れた・差 を 1 画面に入れる (表そのものは枠の中で横にスクロール) */
  @media (max-width:600px){
    th,td{padding:5px 6px}
    td.name{min-width:8.5em;font-size:.85rem}
    .top h1{font-size:1rem}
    section.grp,details.acc{padding:12px 10px}
    /* ① 5 列を 1 画面に: 重さと個数を 2 行に割る / ②③ No の列をやめて商品名の上に出す (「すること」「期限」を外に出さない) */
    table.plan td,table.plan th{padding:5px 3px}
    table.plan .bx{font-size:1.25rem}
    table.plan .sub{font-size:.72rem} table.plan .sub span{display:block} table.plan .sub .dot{display:none}
    .cno{display:none} .noin{display:block;color:var(--sub)}
  }
  @media print{
    .top button,.copy,.top a.back,.notify,.morehead button,.morehead .hint{display:none}
    .top{position:static;border:none}
    body{background:#fff;font-size:12px}
    section.grp{break-inside:avoid-page;border:none;padding:0}
    details.acc{border:none;padding:0}
    details.acc:not([open]){display:none}   /* 印刷は開いているところだけ */
    tr.alert td{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  }
</style>
</head>
<body>
<%
  const jst = (iso) => iso ? new Date(iso).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
  const t = rep.totals;
  const statusJa = { done: '完了', active: '作業中', setup: '準備中', cancelled: '取消' }[rep.run.status] || rep.run.status;
  const statusCls = rep.run.status === 'done' ? 'done' : (rep.run.status === 'active' ? 'active' : 'other');
  const signed = (n) => n > 0 ? '+' + n : (n < 0 ? '−' + Math.abs(n) : '—');
%>
<header class="top">
  <% if (from === 'ipad') { %><a class="back" href="<%= base %>/">‹ 回の一覧</a><% } else { %><a class="back" href="<%= base %>/admin">‹ 管理画面</a><% } %>
  <h1>📦 <%= rep.run.title %></h1>
  <span class="chip <%= statusCls %>"><%= statusJa %></span>
  <% if (rep.run.doneAt) { %><span class="when">完了 <%= jst(rep.run.doneAt) %></span><% } %>
  <span class="sp"></span>
  <button type="button" onclick="window.print()">🖨 印刷</button>
</header>
<main>
  <% if (from === 'ipad') { %>
    <p class="lead">この回の<b>最終結果</b>です (見るだけの画面です。ここからは直せません)。上から ①箱の数 ②数量の変更・キャンセルが要る商品 ③期限のある商品。箱や商品の細かい表は、その下を押すと開きます。</p>
  <% } else { %>
    <p class="lead">上から ①プランごとの箱の数 ②Seller Central で数量の変更・キャンセルが要る商品 ③期限のある商品 です。送り状・箱ラベル用の細かい表は、その下を押すと開きます。数は iPad の記録そのまま (出荷前チェック・Excel 出力と同じ) です。</p>
  <% } %>
  <% if (rep.run.status !== 'done') { %>
    <div class="note-active">まだ作業中です。数は変わることがあります (いろはが「作業を終える」と Google チャットに知らせが届きます)</div>
  <% } %>

  <div class="tiles">
    <div class="tile"><div class="k">箱 (個口)</div><div class="v"><%= t.boxes %> <small>箱</small></div></div>
    <div class="tile"><div class="k">重さの合計</div><div class="v"><%= t.weightKg %> <small>kg</small></div></div>
    <div class="tile"><div class="k">送る商品</div><div class="v"><%= t.kinds %> <small>種類</small> <%= t.placed %> <small>個</small></div></div>
    <div class="tile <%= t.diffRows > 0 ? 'bad' : '' %>"><div class="k">予定と違う商品</div><div class="v"><%= t.diffRows %> <small>件</small></div></div>
    <% if (t.placedExtra > 0) { %><div class="tile bad"><div class="k">STA のプランに無い商品</div><div class="v"><%= t.placedExtra %> <small>個</small></div></div><% } %>
    <% if (t.overLimitBoxes > 0) { %><div class="tile bad"><div class="k"><%= rep.limitKg %>kg を超えた箱</div><div class="v"><%= t.overLimitBoxes %> <small>箱</small></div></div><% } %>
    <% if (t.openBoxes > 0) { %><div class="tile warn"><div class="k">まだ閉じていない箱</div><div class="v"><%= t.openBoxes %> <small>箱</small></div></div><% } %>
    <% if (t.noDims > 0) { %><div class="tile warn"><div class="k">外寸が未登録の箱</div><div class="v"><%= t.noDims %> <small>箱</small></div></div><% } %>
  </div>

  <% const pb = rep.planBoxes; %>
  <section class="grp sum" id="sum-boxes">
    <h2>① プランごとの箱の数 <small>通常・危険物・大型 が それぞれ何箱か</small></h2>
    <% if (pb.plans.length === 0 && pb.others.length === 0) { %>
      <p class="hint">まだ箱も商品もありません</p>
    <% } else { %>
      <div class="scroll"><table class="plan">
        <tr><th class="pl">プラン</th><% for (const k of pb.kinds) { %><th><%= k %></th><% } %><th>合計</th></tr>
        <% for (const p of pb.plans) { %>
          <tr>
            <td class="pl"><%= p.plan %></td>
            <% for (const c of p.cells) { %>
              <% if (!c.exists) { %><td class="none">—</td><% } else { %>
                <td><span class="bx"><%= c.boxes %></span> 箱<span class="sub"><span><%= c.weightKg %> kg</span><span class="dot"> ・ </span><span><%= c.qty %> 個</span></span><% if (c.noWeight > 0) { %><span class="sub amber">重さ未入力 <%= c.noWeight %> 箱</span><% } %></td>
              <% } %>
            <% } %>
            <td><span class="bx"><%= p.boxes %></span> 箱<span class="sub"><span><%= p.weightKg %> kg</span><span class="dot"> ・ </span><span><%= p.qty %> 個</span></span></td>
          </tr>
        <% } %>
        <% for (const o of pb.others) { %>
          <tr>
            <td class="pl"><%= o.name %></td>
            <td class="none" colspan="<%= pb.kinds.length %>">区分 (通常・危険物・大型) を名前から読めないグループです</td>
            <td><span class="bx"><%= o.boxes %></span> 箱<span class="sub"><span><%= o.weightKg %> kg</span><span class="dot"> ・ </span><span><%= o.qty %> 個</span></span></td>
          </tr>
        <% } %>
        <% if (pb.plans.length + pb.others.length > 1) { %>
          <tr class="total">
            <td class="pl">合計</td>
            <% for (const c of pb.kindTotals) { %><td><%= c.exists ? c.boxes + ' 箱' : '' %></td><% } %>
            <td><%= pb.total.boxes %> 箱<span class="sub"><span><%= pb.total.weightKg %> kg</span><span class="dot"> ・ </span><span><%= pb.total.qty %> 個</span></span></td>
          </tr>
        <% } %>
      </table></div>
      <p class="hint">箱 = 中身のある箱だけです (取り消した箱・空の箱は数えません)。「—」は、この回に無い区分です。</p>
    <% } %>
  </section>

  <section class="grp sum" id="sum-changes">
    <h2>② 数量の変更・キャンセルが要る商品 <small><%= rep.changes.length %> 件 — 予定と違う数を箱に入れた商品だけ</small></h2>
    <% if (rep.changes.length === 0 && rep.pendingRows === 0) { %><p class="okline">ありません (すべて予定どおりの数を箱に入れました)</p><% } %>
    <% if (rep.changes.length === 0 && rep.pendingRows > 0) { %><p class="hint">いまのところ、ありません</p><% } %>
    <% if (rep.changes.length > 0) { %>
      <div class="scroll"><table>
        <tr><th class="cno">No</th><th>商品</th><th>すること</th></tr>
        <% let chgGroup = null; for (const c of rep.changes) { %>
          <% if (c.groupId !== chgGroup) { chgGroup = c.groupId; %>
            <tr class="subhead"><td colspan="3"><%= c.group %> <span class="muted">(<%= rep.changes.filter((x) => x.groupId === c.groupId).length %> 件)</span></td></tr>
          <% } %>
          <tr>
            <td class="code cno"><%= c.planNo || '' %></td>
            <td class="name"><span class="code noin"><%= c.planNo || '' %></span><%= c.name %><br><span class="code muted"><%= c.fnsku %><%= c.sku ? ' / ' + c.sku : '' %></span></td>
            <td class="act">
              <% if (c.action === 'cancel') { %><span class="tag red">キャンセル</span>予定 <%= c.planned %> 個 → <b>送りません</b>
              <% } else if (c.action === 'extra') { %><span class="tag red">プランに無い</span><b><%= c.placed %></b> 個 箱に入っています
              <% } else { %><span class="tag amber">数量変更</span><%= c.planned %> → <b><%= c.placed %></b> 個<% } %>
              <% if (c.reasonJa) { %><span class="why">理由: <%= c.reasonJa %></span><% } %>
              <% if (c.remaining > 0) { %><span class="why amber">未投入 <%= c.remaining %></span><% } %>
            </td>
          </tr>
        <% } %>
      </table></div>
      <button type="button" class="copy" data-key="chg">📋 この一覧をコピー (表計算に貼れる形)</button><span class="copied"></span>
    <% } %>
    <% if (rep.pendingRows > 0) { %><p class="pendline">まだ入れ終わっていない商品が <b><%= rep.pendingRows %></b> 件あります。減らすかどうかは、作業が終わると決まります (ここには、決まった分だけ出しています)</p><% } %>
  </section>

  <section class="grp sum" id="sum-expiry">
    <h2>③ 期限のある商品 <small><%= rep.expiries.length %> 件 — STA 画面へ転記 (Excel には期限を書きません)</small></h2>
    <% if (rep.expiries.length === 0) { %>
      <p class="hint">ありません (期限を入れた商品はありません)</p>
    <% } else { %>
      <div class="scroll"><table>
        <tr><th class="cno">No</th><th>期限</th><th class="num">個数</th><th>商品</th></tr>
        <% let expGroup = null; for (const e of rep.expiries) { %>
          <% if (e.groupId !== expGroup) { expGroup = e.groupId; %>
            <tr class="subhead"><td colspan="4"><%= e.group %></td></tr>
          <% } %>
          <tr><td class="code cno"><%= e.planNo || '' %></td><td><b><%= e.expiry %></b></td><td class="num"><%= e.qty %></td><td class="name"><span class="code noin"><%= e.planNo || '' %></span><%= e.name %><br><span class="code muted"><%= e.fnsku %><%= e.sku ? ' / ' + e.sku : '' %></span></td></tr>
        <% } %>
      </table></div>
      <button type="button" class="copy" data-key="exp">📋 期限一覧をコピー</button><span class="copied"></span>
    <% } %>
  </section>

  <div class="morehead">
    <h2>細かい情報</h2>
    <button type="button" id="acc-all">すべて開く</button>
    <p class="hint">見出しを押すと開きます (印刷に出るのは、開いているところだけです)</p>
  </div>

  <% if (notify) {
       const n = notify.job;
       const sentBefore = !!(n && n.sent_count > 0);
       let cls = 'wait', label = '', detail = '';
       if (!n) { label = 'まだ送っていません'; detail = 'この回は、知らせの仕組みができる前に終わったか、STA アップ済みの記録で完了した回です'; }
       else if (n.sending) { label = '⏳ いま送っているところです'; }
       else if (n.status === 'pending' && n.attempts === 0) { label = '⏳ 送信待ちです (すぐに送ります)'; }
       else if (n.status === 'pending') { cls = 'bad'; label = `送れていません — ${n.attempts} 回うまくいかず、${jst(n.next_try_at)} にもう一度送ります`; detail = n.last_error ? `理由: ${n.last_error}` : ''; }
       else if (n.status === 'sent') { cls = 'ok'; label = `✅ 送りました (${jst(n.sent_at)})`; detail = n.sent_count > 1 ? `これまでに ${n.sent_count} 回送っています${n.resent_by ? ` ・ 最後にもう一度送った人: ${n.resent_by}` : ''}` : ''; }
       else if (n.status === 'skipped') { cls = 'bad'; label = '送っていません — 終えたとき、通知先 (Google チャット) が設定されていませんでした'; }
       else if (n.status === 'failed') { cls = 'bad'; label = `❌ 送れませんでした (${n.attempts} 回やって打ち切り)`; detail = n.last_error ? `理由: ${n.last_error}` : ''; }
       // 届いた直後は少し待つ (サーバーも too_soon で断る — Codex #1350 R1 #3)
       const cooling = !!(n && n.cooldown_until);
       const canSend = notify.webhookSet && !(n && n.sending) && !cooling;
  %>
  <%# 送れていないとき (cls=bad) は開いて出す。届いている・待っているだけのときは閉じておく (状態は見出しの横に出る) %>
  <details class="acc notify" id="notify" data-base="<%= base %>" data-run="<%= rep.run.id %>" <%= cls === 'bad' ? 'open' : '' %>>
    <summary>📨 本社の Google チャットへの知らせ <small class="nsum <%= cls %>"><%= label %></small></summary>
    <% if (detail) { %><p class="hint"><%= detail %></p><% } %>
    <% if (!notify.webhookSet) { %><p class="hint red">いまは通知先が設定されていないので、送れません (本社で設定します)</p><% } %>
    <% if (notify.webhookSet && cooling) { %><p class="hint">届いたばかりなので、もう一度送れるのは <%= jst(n.cooldown_until) %> からです (画面を読み込み直すと押せます)</p><% } %>
    <button type="button" class="nbtn primary" id="resend-open" <%= canSend ? '' : 'disabled' %>><%= sentBefore ? '🔁 もう一度送る' : '📨 送る' %></button>
    <div class="confirm" id="resend-confirm" hidden>
      <p><b>本社の Google チャットに、この回の「終わりました」の知らせを<%= sentBefore ? 'もう一度' : '' %>送ります。</b></p>
      <% if (sentBefore) { %><p class="hint">前に届いた知らせと見分けられるように、頭に【再送】と付きます</p><% } %>
      <button type="button" class="nbtn primary" id="resend-go">送る</button>
      <button type="button" class="nbtn plain" id="resend-cancel">やめる</button>
    </div>
    <p class="nmsg" id="resend-msg" role="status"></p>
  </details>
  <% } %>

  <% for (const g of rep.groups) { %>
  <% const gDiff = g.rows.filter((r) => r.alert).length; %>
  <details class="acc grpd">
    <summary><%= g.name %> <small><%= g.displayName %> ・ <%= g.boxes.length %> 箱 ・ <%= g.rows.length %> 商品<% if (gDiff > 0) { %> ・ <span class="red">予定と違う <%= gDiff %> 件</span><% } %></small></summary>
    <% if (g.packingGroupId) { %><p class="hint">梱包グループ <span class="code"><%= g.packingGroupId %></span></p><% } %>
    <% if (!g.excelAttached) { %><p class="hint">STA の Excel が未添付のため、Amazon の箱名は番号 (B1, B2…) だけです</p><% } %>

    <h3>🚚 箱 — 送り状・箱ラベル用</h3>
    <% if (g.boxes.length === 0) { %>
      <p class="hint">まだ箱がありません</p>
    <% } else { %>
      <div class="scroll"><table>
        <tr><th>Amazon の箱</th><th>箱札</th><th class="num">重さ kg</th><th>資材 (サイズ)</th><th>外寸 幅×長さ×高さ cm</th><th class="num">3辺合計</th><th class="num">個数</th><th class="num">種類</th></tr>
        <% for (const b of g.boxes) { %>
          <tr class="<%= b.overLimit ? 'alert' : '' %>">
            <td><b><%= b.amazonName %></b><% if (b.numberShifted) { %> <span class="amber">番号ずれ</span><% } %></td>
            <td class="code"><%= b.code %></td>
            <td class="num diff"><b><%= b.weightKg != null ? b.weightKg : '' %></b><% if (b.weightKg == null) { %><span class="amber">未入力</span><% } %><% if (b.overLimit) { %> <span class="red">上限超え</span><% } %></td>
            <td><%= b.material || '—' %></td>
            <td><%= b.dims ? `${b.dims.w} × ${b.dims.l} × ${b.dims.h}` : '' %><% if (!b.dims) { %><span class="amber">未登録</span><% } %></td>
            <td class="num"><%= b.sum3 != null ? b.sum3 : '' %></td>
            <td class="num"><%= b.qty %></td>
            <td class="num"><%= b.kinds %></td>
          </tr>
        <% } %>
        <tr class="total"><td colspan="2"><%= g.boxes.length %> 箱</td><td class="num"><%= Math.round(g.boxes.reduce((a, b) => a + (b.weightKg || 0), 0) * 10) / 10 %></td><td colspan="3"></td><td class="num"><%= g.boxes.reduce((a, b) => a + b.qty, 0) %></td><td></td></tr>
      </table></div>
      <button type="button" class="copy" data-key="box<%= g.id %>">📋 箱の一覧をコピー (表計算に貼れる形)</button><span class="copied"></span>
    <% } %>

    <h3>📋 商品 — 予定と箱に入れた数</h3>
    <div class="scroll"><table>
      <tr><th>No</th><th>商品</th><th class="num">予定</th><th class="num">入れた</th><th class="num">差</th><th>理由</th><th>期限</th><th>入れた箱</th></tr>
      <% for (const r of g.rows) { %>
        <tr class="<%= r.alert ? 'alert' : '' %>">
          <td class="code"><%= r.planNo || '' %></td>
          <td class="name"><%= r.name %><br><span class="code muted"><%= r.fnsku %><%= r.sku ? ' / ' + r.sku : '' %></span></td>
          <td class="num"><%= r.planned %></td>
          <td class="num"><b><%= r.placed %></b></td>
          <td class="num diff"><%= signed(r.diff) %></td>
          <td>
            <% if (r.note) { %><span class="red"><%= r.note %></span><br><% } %>
            <% if (r.reasonJa) { %><%= r.reasonJa %><% } %>
            <% if (r.remaining > 0) { %><% if (r.reasonJa) { %><br><% } %><span class="amber">未投入 <%= r.remaining %></span><% } %>
          </td>
          <td><% for (const e of r.expiries) { %><%= e.expiry %> ×<%= e.qty %><br><% } %></td>
          <td><% for (const x of r.inBoxes) { %><b><%= x.amazonName %></b> <span class="code muted"><%= x.code %></span> ×<%= x.qty %><br><% } %></td>
        </tr>
      <% } %>
      <% if (g.rows.length === 0) { %><tr><td colspan="8" class="muted">商品がありません</td></tr><% } %>
    </table></div>
  </details>
  <% } %>

  <% const allBoxes = rep.groups.flatMap((g) => g.boxes); %>
  <% if (allBoxes.length > 0) { %>
  <details class="acc" id="acc-contents">
    <summary>📦 箱の中身 <small>箱ごとに何が何個入っているか (箱を開けずに確かめたいとき)</small></summary>
    <% for (const b of allBoxes) { %>
      <details class="boxd">
        <summary><%= b.amazonName %> <span class="code muted"><%= b.code %></span> — <%= b.qty %> 個 ・ <%= b.kinds %> 種類<%= b.weightKg != null ? ` ・ ${b.weightKg} kg` : '' %></summary>
        <div class="scroll"><table>
          <tr><th>No</th><th>商品</th><th>期限</th><th class="num">個数</th></tr>
          <% for (const x of b.contents) { %>
            <tr><td class="code"><%= x.planNo || '' %></td><td class="name"><%= x.name %><br><span class="code muted"><%= x.fnsku %></span></td><td><%= x.expiry || '' %></td><td class="num"><%= x.qty %></td></tr>
          <% } %>
        </table></div>
      </details>
    <% } %>
  </details>
  <% } %>

  <footer>
    作成 <%= printedAt %> ・ 納品回 #<%= rep.run.id %> ・
    <% if (canAdmin) { %><a href="<%= base %>/admin">管理画面 (Excel 出力)</a> ・ <% } %><a href="<%= base %>/print/boxes?run=<%= rep.run.id %>" target="_blank">🖨 箱札</a>
  </footer>
</main>
<script type="application/json" id="tsv"><%- JSON.stringify(rep.tsv).replace(/</g, '\\u003c') %></script>
<script>
  // 表をそのまま表計算・STA 画面へ貼れる形 (タブ区切り) でコピーする
  const TSV = JSON.parse(document.getElementById('tsv').textContent);
  document.querySelectorAll('.copy').forEach((b) => b.addEventListener('click', async () => {
    const text = TSV[b.dataset.key] || '';
    try { await navigator.clipboard.writeText(text); }
    catch { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
    const s = b.nextElementSibling;
    if (s) { s.textContent = 'コピーしました'; setTimeout(() => { s.textContent = ''; }, 2000); }
  }));

  // 細かい情報を まとめて開く / 閉じる (外側の折りたたみだけ。箱ごとの中身は巻き込まない)
  (() => {
    const btn = document.getElementById('acc-all');
    if (!btn) return;
    const accs = () => [...document.querySelectorAll('details.acc')];
    const sync = () => { btn.textContent = accs().every((d) => d.open) ? 'すべて閉じる' : 'すべて開く'; };
    btn.addEventListener('click', () => { const open = !accs().every((d) => d.open); accs().forEach((d) => { d.open = open; }); sync(); });
    accs().forEach((d) => d.addEventListener('toggle', sync));
    sync();
  })();

  // 完了した回の知らせを、本社の Google チャットへもう一度送る。
  // 🚨 ボタンを塞ぐだけにしない: 送信そのものを sending で止める (二度押しは db 側でも 1 通にまとめる)
  (() => {
    const sec = document.getElementById('notify');
    const open = document.getElementById('resend-open');
    if (!sec || !open) return;
    const box = document.getElementById('resend-confirm'), go = document.getElementById('resend-go'),
      cancel = document.getElementById('resend-cancel'), msg = document.getElementById('resend-msg');
    const url = sec.dataset.base + '/api/runs/' + sec.dataset.run + '/notify/resend';
    let sending = false;
    // この画面を開いてからの「送る」は 1 つの操作。返事が来ずに押し直しても、サーバーは同じ ID を 1 回として扱う (Codex #1350 R1 #2)
    const rid = (window.crypto && crypto.randomUUID ? crypto.randomUUID() : '') || (Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12));
    const say = (cls, text) => { msg.className = 'nmsg ' + cls; msg.textContent = text; };
    open.addEventListener('click', () => { if (sending) return; box.hidden = false; open.hidden = true; say('', ''); });
    cancel.addEventListener('click', () => { if (sending) return; box.hidden = true; open.hidden = false; });
    go.addEventListener('click', async () => {
      if (sending) return;
      sending = true; go.disabled = true; cancel.disabled = true;
      say('', '送っています…');
      let j = null;
      try {
        const r = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ request_id: rid }) });
        j = await r.json().catch(() => null);
      } catch { j = null; }
      if (j && j.ok) {
        box.hidden = true;
        say('ok', '送りました。数秒で本社の Google チャットに届きます (このあと画面を読み込み直します)');
        setTimeout(() => location.reload(), 3000);
        return;
      }
      // 返事が来なかった: 送れたかどうか分からない。同じ操作 ID で押し直せるので、2 通にはならない
      say('err', (j && j.message) || '返事が来ませんでした。電波のよいところで、もう一度「送る」を押してください (届いていれば、2 通にはなりません)');
      sending = false; go.disabled = false; cancel.disabled = false;
    });
  })();
</script>
</body>
</html>
