<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .sw-wrap { max-width: 1050px; margin: 0 auto; padding: 12px 16px 40px; }
    .bar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
    table.t { width: 100%; border-collapse: collapse; font-size: 0.87em; }
    table.t th, table.t td { border-bottom: 1px solid #e9ecef; padding: 6px 8px; text-align: left; vertical-align: top; }
    table.t th { background: #f8f9fa; white-space: nowrap; }
    .fl { display: inline-block; background: #fff3bf; color: #e67700; border-radius: 4px;
          padding: 1px 7px; margin: 1px 3px 1px 0; font-size: 0.9em; }
    .vd { font-size: 0.85em; border-radius: 4px; padding: 1px 7px; }
    .vd.valid { background: #d3f9d8; color: #2b8a3e; }
    .vd.invalid { background: #ffe3e3; color: #c92a2a; }
    .vd.review_required { background: #fff3bf; color: #e67700; }
    .btn-sm { padding: 3px 10px; font-size: 0.85em; cursor: pointer; }
    .note { color: #868e96; font-size: 0.85em; }
    .lead { background: #e7f5ff; border: 1px solid #a5d8ff; border-radius: 8px;
            padding: 10px 14px; margin-bottom: 14px; font-size: 0.9em; }
    .empty { color: #868e96; text-align: center; padding: 40px 0; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">⚠ 異常候補</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/apps/shipping-work/admin/stats" class="btn-logout">集計</a>
      <a href="/apps/shipping-work/admin/review" class="btn-logout">確認待ち</a>
      <a href="/apps/shipping-work/admin/batches" class="btn-logout">バッチ管理</a>
      <a href="/apps/shipping-work/" class="btn-logout">カンバン</a>
    </div>
  </header>

  <div class="sw-wrap">
    <div class="lead">
      計測として疑わしいセッションの一覧です (自動では除外しません = 要件§7.4)。
      内容を見て、集計に入れないものだけ「除外」してください。<b>どちらでも時刻は消えません</b>。
    </div>
    <div class="bar">
      <form method="get" style="display:flex;gap:8px;align-items:center;margin:0">
        <input type="date" name="from" value="<%= from %>">
        〜 <input type="date" name="to" value="<%= to %>">
        <button type="submit" class="btn-sm">表示</button>
      </form>
      <span class="note"><%= sessions.length %> 件</span>
    </div>

    <% if (sessions.length === 0) { %>
      <div class="empty">この期間に異常候補はありません。</div>
    <% } else { %>
    <table class="t">
      <thead>
        <tr><th>作業日</th><th>出荷No</th><th>工程</th><th>担当</th><th>開始→終了</th><th>実作業</th>
            <th>候補の理由</th><th>判定</th><th></th></tr>
      </thead>
      <tbody>
        <% for (const s of sessions) { %>
          <tr>
            <td><%= s.work_date %></td>
            <td><a href="/apps/shipping-work/admin/batches/<%= s.batch_id %>"><%= s.shipping_no_label || s.shipping_no %></a>
                <div class="note"><%= s.bunrui_label || s.bunrui %><%= s.slip_count != null ? ' / ' + s.slip_count + '件' : '' %></div></td>
            <td><%= s.process %></td>
            <td><%= displayNames[s.worker] || s.worker.split('@')[0] %></td>
            <td><%= s.requestedAtJst %> → <%= s.endedAtJst || '—' %></td>
            <td><%= s.active_sec != null ? Math.floor(s.active_sec / 60) + '分' + String(s.active_sec % 60).padStart(2, '0') + '秒' : '—' %></td>
            <td><% for (const f of s.flags) { %><span class="fl"><%= flagLabels[f] || f %></span><% } %></td>
            <td>
              <span class="vd <%= s.validity %>"><%= s.validity === 'valid' ? (s.validity_by ? '採用済' : '未判定') : s.validity === 'invalid' ? '除外' : '確認待ち' %></span>
              <% if (s.validity_reason) { %><div class="note"><%= s.validity_reason %></div><% } %>
            </td>
            <td style="white-space:nowrap">
              <% if (!s.validity_by && s.validity === 'valid') { %>
                <button class="btn-sm" onclick="judge(<%= s.id %>, 'valid')">採用</button>
                <button class="btn-sm" onclick="judge(<%= s.id %>, 'invalid')">除外</button>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <% } %>
  </div>

  <script>
    let busy = false;
    function opId() {
      if (window.crypto?.randomUUID) return crypto.randomUUID();
      return 'op-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
    }
    async function judge(sessionId, validity) {
      if (busy) return;
      const label = validity === 'valid' ? '採用' : '除外';
      const reason = prompt(`このセッションを計測から「${label}」します。理由を入力してください (必須)`);
      if (reason === null) return;
      if (!reason.trim()) return alert('理由は必須です');
      busy = true;
      try {
        const r = await fetch(`/apps/shipping-work/api/admin/sessions/${sessionId}/judge`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ op_id: opId(), validity, reason: reason.trim() }),
        });
        let j = {};
        try { j = await r.json(); } catch {}
        if (!r.ok) return alert(j.error || `エラー (${r.status})`);
        location.reload();
      } finally { busy = false; }
    }
  </script>
</body>
</html>
