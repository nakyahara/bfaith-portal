<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>新商品企画スカウト | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/apps/product-scout/public/product-scout.css">
  <link rel="stylesheet" href="/mobile.css">
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">🔎 新商品企画スカウト</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/" class="btn-logout">← ダッシュボード</a>
      <a href="/logout" class="btn-logout">ログアウト</a>
    </div>
  </header>

  <main class="ps-main">
    <section class="ps-card">
      <p><b>調査用の一次候補です。</b>工程は商品名からの仮説です。AMCの製造可否・原価・利益・自社商品との重複は個別に確認してください。</p>
      <% if (snapshot && snapshot.algorithm_version < 2) { %>
        <p class="ps-warn">旧判定のデータです。誤分類対策と商品観測日の再集計がまだ反映されていません。</p>
      <% } %>
      <% const ownState = typeof ownImport !== 'undefined' ? ownImport : null;
         const ownAge = ownState && ownState.source_generated_at ? (Date.now() - Date.parse(ownState.source_generated_at)) / 3600000 : NaN;
         const ownReady = Number.isFinite(ownAge) && ownAge >= -5/60 && ownAge <= 48 && ownState.family_count > 0; %>
      <p class="ps-muted"><%= ownReady ? '自社参考は売上分類1のみ。カテゴリと工程が同じ商品を示しています。' : '自社照合は未完了です。照合元が未取得・空・期限切れの可能性があります。' %> 類似商品や食い合いの有無は、この表示だけでは判断できません。</p>
    </section>

    <!-- ① 信号 — 5秒で「順調 / 詰まっている / 投入待ち」が分かること -->
    <section class="ps-signal ps-signal-<%= signal.level %>">
      <div class="ps-signal-mark"><%= signal.level === 'green' ? '🟢' : (signal.level === 'yellow' ? '🟡' : (signal.level === 'red' ? '🔴' : '⬜')) %></div>
      <div class="ps-signal-body">
        <div class="ps-signal-title"><%= signal.title %></div>
        <div class="ps-signal-detail"><%= signal.detail %></div>
        <% if (snapshot) { %>
          <div class="ps-signal-meta">
            最終取り込み <%= new Date(snapshot.ingested_at).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %>
            ／ 集計対象 <%= (snapshot.after_base_filter || 0).toLocaleString() %>商品 → <%= (snapshot.concept_count || 0).toLocaleString() %>テーマ
          </div>
        <% } %>
      </div>
    </section>

    <!-- ② 工程表 — 7カテゴリ全部を常に出す。現在のカテゴリだけでは1周の停滞が見えない -->
    <section class="ps-card">
      <h2>収集の工程</h2>
      <table class="ps-table">
        <thead>
          <tr><th>カテゴリ</th><th>状態</th><th>取得</th><th class="ps-num">対象ASIN</th><th>分母の質</th><th>対象抽出日</th></tr>
        </thead>
        <tbody>
        <% if (!categories.length) { %>
          <tr><td colspan="6" class="ps-empty">まだ取り込みがありません</td></tr>
        <% } %>
        <% categories.forEach(function (c) {
             const pct = (c.asin_target && c.fetched != null) ? Math.floor(c.fetched / c.asin_target * 100) : null; %>
          <tr>
            <td><%= c.name %></td>
            <td>
              <% if (c.state === 'collecting') { %><span class="ps-badge ps-badge-run">収集中</span>
              <% } else if (c.state === 'collected') { %><span class="ps-badge ps-badge-done">取得済み</span>
              <% } else if (c.state === 'queued') { %><span class="ps-badge">投入済み</span>
              <% } else { %><span class="ps-badge ps-badge-wait">未投入</span><% } %>
            </td>
            <td>
              <% if (pct === null) { %>—
              <% } else { %>
                <div class="ps-bar"><div class="ps-bar-fill" style="width: <%= Math.min(100, pct) %>%"></div></div>
                <%# ⭐分母が不完全なら「100%」と言ってはいけない。取りこぼしが確定しているので「下限」と書く %>
                <span class="ps-pct"><%= c.complete !== 1 ? '抽出済み対象内 ' : '' %><%= pct %>%</span>
              <% } %>
            </td>
            <td class="ps-num"><%= c.asin_target ? c.asin_target.toLocaleString() : '—' %></td>
            <td>
              <% if (c.complete === 1) { %><span class="ps-ok">完全</span>
              <% } else if (c.complete === 0) { %><span class="ps-warn">不完全（約<%= (c.estimated_missing || 0).toLocaleString() %>件 取りこぼし）</span>
              <% } else { %><span class="ps-muted">不明（旧版で取得）</span><% } %>
            </td>
            <td class="ps-muted"><%= c.fetched_at ? c.fetched_at.slice(0, 10) : '—' %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </section>

    <!-- ③ テーマ一覧 — 審査対象。ASINではなく「作る商品の企画」単位 -->
    <section class="ps-card">
      <h2>
        商品テーマ
        <span class="ps-counts">
          ゲート通過 <%= counts.pass %> ／ 要確認 <%= counts.unknown %> ／ ゲート落ち <%= counts.fail %>
          ／ 判断済み <%= counts.decided %>
        </span>
      </h2>

      <div class="ps-filters">
        <span>ゲート:</span>
        <% ['pass','unknown','fail','all'].forEach(function (g) { %>
          <a class="ps-chip <%= gate === g ? 'on' : '' %>" href="?gate=<%= g %>&status=<%= status %>&page=1"><%=
            g === 'pass' ? '通過' : (g === 'unknown' ? '要確認' : (g === 'fail' ? '落ち' : 'すべて')) %></a>
        <% }); %>
        <span class="ps-sep"></span>
        <span>判断:</span>
        <% ['undecided','adopt','hold','reject','all'].forEach(function (s) { %>
          <a class="ps-chip <%= status === s ? 'on' : '' %>" href="?gate=<%= gate %>&status=<%= s %>&page=1"><%=
            s === 'undecided' ? '未判断' : (s === 'adopt' ? '採用' : (s === 'hold' ? '保留' : (s === 'reject' ? '不採用' : 'すべて'))) %></a>
        <% }); %>
      </div>

      <% if (!concepts.length) { %>
        <p class="ps-empty">該当するテーマがありません。評価未完了の候補は「要確認」で確認できます。</p>
      <% } else { %>
        <p class="ps-muted ps-range">
          <%= total.toLocaleString() %>件中 <%= (((page - 1) * pageSize) + 1).toLocaleString() %>〜<%= Math.min(total, page * pageSize).toLocaleString() %>件目
          （<%= page %> / <%= totalPages %> ページ）
        </p>
      <% } %>

      <% concepts.forEach(function (c) { %>
        <article class="ps-concept" data-id="<%= c.concept_id %>">
          <header class="ps-concept-head">
            <div>
              <span class="ps-rank">#<%= c.rank_in_snapshot %></span>
              <span class="ps-concept-name"><%= c.concept %></span>
              <span class="ps-root"><%= c.root_category_name %></span>
            </div>
            <div class="ps-gates">
              <% if (c.hard_gate === 'pass') { %><span class="ps-badge ps-badge-done">ゲート通過</span>
              <% } else if (c.hard_gate === 'fail') { %><span class="ps-badge ps-badge-ng">落ち</span>
              <% } else { %><span class="ps-badge ps-badge-wait">要確認</span><% } %>
              <% if (c.commodity === 'suspect') { %><span class="ps-badge ps-badge-ng">中華コモディティ疑い</span><% } %>
              <% if (c.big_brand === 'dominated') { %><span class="ps-badge ps-badge-wait">大手が押さえている</span><% } %>
              <% if (c.decision) { %><span class="ps-badge ps-badge-<%= c.decision %>"><%=
                c.decision === 'adopt' ? '採用' : (c.decision === 'reject' ? '不採用' : '保留') %></span><% } %>
            </div>
          </header>

          <% if (c.gate_fail_reason) { %>
            <p class="ps-reason">⛔ <%= c.gate_fail_reason %></p>
          <% } %>

          <%# ⭐自社が既にやっているテーマかどうか。重複提案を止め、
              「前に出して撤退した」を判断材料として最初に見せる %>
          <% if (c.own_count) { %>
            <p class="ps-own <%= c.own_withdrawn ? 'ps-own-withdrawn' : '' %>">
              <% if (c.own_withdrawn && !c.own_active) { %>
                🪦 <b>同カテゴリ・工程の自社商品に終売あり</b>（<%= c.own_withdrawn %>ファミリー）
              <% } else if (c.own_withdrawn) { %>
                ⚠️ <b>同カテゴリ・工程の自社商品（取扱中）</b>（<%= c.own_active %>）＋ <b>終売</b>（<%= c.own_withdrawn %>）
              <% } else { %>
                ✅ <b>同カテゴリ・工程の自社商品（取扱中）</b>（<%= c.own_active %>ファミリー）
              <% } %>
              <% if (c.own_qty180) { %>／ SKUごとの初回180日合計 <%= c.own_qty180.toLocaleString() %>個<% } %>
              <span class="ps-muted">： <%= c.own_names %></span>
            </p>
          <% } %>

          <% if (!c.own_count) { %><p class="ps-muted">自社の参考表示なし（類似商品なしを意味しません）。</p><% } %>
          <div class="ps-metrics">
            <div><b><%= c.total_monthly_sold == null ? '—' : c.total_monthly_sold.toLocaleString() %></b><span>購入表示合計（参考）</span></div>
            <div><b><%= c.product_count %></b><span>取得ASIN数</span></div>
            <div><b><%= c.brand_count %></b><span>取得ブランド数</span></div>
            <div><b><%= c.top1_share_pct == null ? '—' : c.top1_share_pct + '%' %></b><span>Top1商品数比率</span></div>
            <div><b><%= c.median_price == null ? '—' : '¥' + c.median_price.toLocaleString() %></b><span>中央価格</span></div>
            <div><b><%= c.median_fee_pct == null ? '—' : c.median_fee_pct + '%' %></b><span>販売手数料率</span></div>
            <div><b><%= c.small_size_rate_pct == null ? '—' : c.small_size_rate_pct + '%' %></b><span>寸法判明分の小型率</span></div>
            <div><b><%= c.median_review_count == null ? '—' : c.median_review_count %></b><span>レビュー中央</span></div>
          </div>

          <p class="ps-form">工程候補（推定）: <b><%= c.form %></b>　Top1: <%= c.top1_brand %>
            <%# ⭐データがいつ時点のものかを必ず出す。7カテゴリを1周する間に月販の集合は変わる %>
            <span class="ps-muted">／ 商品観測日 <%= snapshot && snapshot.algorithm_version >= 2 && c.source_fetched_at ? c.source_fetched_at.slice(0, 10) : '不明' %><%=
              c.source_complete !== 1 ? '・対象抽出の完全性未確認' : '' %></span>
          </p>

          <p class="ps-muted">購入表示を集計した参考値で、市場全体の月販や下限ではありません。新しい集計では同じ親ASINの表示は最大値を採用します。親ASIN不明の商品や観測時期の違いは残ります。ブランド比率は取得商品数ベースです。</p>
          <details class="ps-examples">
            <summary>代表商品 <%= (c.examples || []).length %>件</summary>
            <ul>
              <% (c.examples || []).forEach(function (e) {
                   // Amazonのタイトルは先頭にブランド名が入っていることが多く、
                   // ブランドを別に出すと同じ語が2回並ぶ (「大一鋼業 大一鋼業 石膏ボード…」)。
                   // ⚠️ブランドが「福井金属工芸(Fukuikinzokukogei)」でタイトルは
                   //   「福井金属工芸 Jフック…」のように、括弧の有無で食い違うことがある。
                   //   括弧より前の名前でも見る
                   var t = String(e.title || '');
                   var b = String(e.brand || '');
                   var heads = [b, b.split(/[(（]/)[0].trim()].filter(function (x) { return x.length >= 2; });
                   for (var hi = 0; hi < heads.length; hi++) {
                     if (t.indexOf(heads[hi]) === 0) {
                       t = t.slice(heads[hi].length).replace(/^[\s　]+/, '');
                       break;
                     }
                   }
                   var url = 'https://www.amazon.co.jp/dp/' + encodeURIComponent(e.asin); %>
                <li>
                  <%# ⭐商品名そのものを押せるようにする。ASINだけをリンクにしていた頃は、
                      暗号のような文字列なので誰も押そうと思わなかった %>
                  <a class="ps-ex-link" href="<%= url %>" target="_blank" rel="noopener">
                    <% if (b) { %><b><%= b %></b><% } %><%= t %><span class="ps-ext">↗</span>
                  </a>
                  <div class="ps-ex-meta">
                    <a class="ps-asin" href="<%= url %>" target="_blank" rel="noopener"><%= e.asin %></a>
                    購入表示 <%= e.monthlySold == null ? '不明' : e.monthlySold.toLocaleString() %>
                    ／ <%= e.price == null ? '価格不明' : '¥' + e.price.toLocaleString() %>
                    ／ レビュー <%= e.reviewCount == null ? '不明' : e.reviewCount.toLocaleString() %> ／ 観測 <%= e.observedAt ? e.observedAt.slice(0, 10) : '不明' %>
                  </div>
                </li>
              <% }); %>
            </ul>
            <%# この市場を実際のAmazonの検索結果で見る。数字だけでは
                「どういう売り場か」が掴めないので、判断の前に現物を見に行けるようにする %>
            <p class="ps-search">
              <a href="https://www.amazon.co.jp/s?k=<%= encodeURIComponent(c.category_path.split(' > ').slice(-1)[0]) %>"
                 target="_blank" rel="noopener">🔍 カテゴリ名でAmazonを検索する<span class="ps-ext">↗</span></a>
            </p>
          </details>

          <% if (c.decision) { %>
            <p class="ps-decided">
              <%= c.decision === 'adopt' ? '採用' : (c.decision === 'reject' ? '不採用' : '保留') %>
              <% if (c.reason_code) { %>（<%= c.reason_code %>）<% } %>
              <% if (c.comment) { %>: <%= c.comment %><% } %>
              <span class="ps-muted">— <%= c.decided_by %> <%= c.decided_at ? c.decided_at.slice(0, 10) : '' %></span>
            </p>
            <% if (c.recheck_condition) { %><p class="ps-recheck">再審査条件: <%= c.recheck_condition %></p><% } %>
          <% } %>

          <form class="ps-decide">
            <select name="decision">
              <option value="">判断を選ぶ…</option>
              <option value="adopt">採用（次の調査へ進める）</option>
              <option value="hold">保留（情報不足・時期not now）</option>
              <option value="reject">不採用</option>
            </select>
            <select name="reasonCode" class="ps-reason-select" hidden>
              <option value="">不採用の理由を選ぶ…</option>
              <% reasonCodes.forEach(function (r) { %>
                <option value="<%= r.code %>"><%= r.label %></option>
              <% }); %>
            </select>
            <input type="text" name="comment" placeholder="コメント（任意）" maxlength="500">
            <input type="text" name="recheckCondition" placeholder="再審査条件（例: 原料が30%下がれば再検討）" maxlength="200">
            <button type="submit">記録する</button>
            <span class="ps-msg"></span>
          </form>
        </article>
      <% }); %>

      <% if (totalPages > 1) { %>
        <nav class="ps-pager">
          <% if (page > 1) { %>
            <a class="ps-chip" href="?gate=<%= gate %>&status=<%= status %>&page=<%= page - 1 %>">← 前の<%= pageSize %>件</a>
          <% } %>
          <span class="ps-muted"><%= page %> / <%= totalPages %></span>
          <% if (page < totalPages) { %>
            <a class="ps-chip" href="?gate=<%= gate %>&status=<%= status %>&page=<%= page + 1 %>">次の<%= pageSize %>件 →</a>
          <% } %>
        </nav>
      <% } %>
    </section>
  </main>

  <script src="/apps/product-scout/public/product-scout.js"></script>
</body>
</html>
