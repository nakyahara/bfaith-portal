<%- include('_top', { nav: 'index' }) %>
<%# 在庫一覧 — プライスターの「在庫一覧」と同じ列の並び・同じ操作感 (縦に並ぶ価格追従ボタン / ストッパーの直接入力 / チェックして一括)。
    違い: 出品価格・数量・仕入れ価格は読むだけ (miniPC 経由の mirror 表)。変えられるのは「方針」だけで、全部 ap_policy_events に残る %>

<% if (unavailable) { %>
  <div class="banner-warn">⚠️ まだ表示できません。必要な表がこの環境にありません: <span class="code"><%= unavailable.join(', ') %></span>
    (miniPC の daily-sync が Render へ送る mirror 表です)</div>
<% } else { %>

<% if (auto && auto.error) { %>
  <div class="banner-warn">⚠️ 今日の判定を自動で作れませんでした: <%= auto.error %></div>
<% } %>

<%
  const MODE_BUTTONS = [['fba_lowest', 'FBA最安値'], ['lowest', '最安値'], ['buybox', 'カート'], ['custom', 'カスタム'], ['off', 'しない']];
  const isFba = (r) => String(r.channel || '').toUpperCase() === 'FBA';
  const advOpen = !!(filters.adv || filters.mode || filters.channel || filters.flag || filters.action || filters.price_min || filters.price_max);
  const qs = (patch) => '?' + new URLSearchParams({ ...filters, per: String(per), ...patch }).toString();
  const sortCls = (key) => (filters.sort === key ? 'sorted' : '');
  const mmdd = (d) => (d && String(d).length >= 10 ? String(d).slice(5, 7) + '/' + String(d).slice(8, 10) : '—');
%>

<div class="pt-panel">
  <div class="pt-title">
    <span class="pt-star">P</span>
    <h1>在庫一覧</h1>
    <span class="small">価格データ <b><%= freshness && freshness.snapshot_date_jst ? freshness.snapshot_date_jst : '—' %></b> (<%= freshness ? num(freshness.snapshot_rows) : '' %> SKU)
      / 手数料 <%= freshness && freshness.fees_fetched_at ? toJst(freshness.fees_fetched_at) : '—' %>
      / 販売 (確定分) 〜<%= freshness && freshness.finance_last_date_jst ? freshness.finance_last_date_jst : '—' %>
      / ルール <span class="code"><%= RULE_VERSION %></span></span>
    <span class="spacer"></span>
    <a class="btn-gray" href="/apps/amazon-pricing/api/export.csv?<%= new URLSearchParams(filters).toString() %>">在庫ダウンロード ▾</a>
  </div>

  <form method="get" action="/apps/amazon-pricing/" id="pt-search">
    <div class="pt-search-h">🔍 検索・絞り込み</div>
    <div class="pt-search-b">
      <input class="pt-kw" type="text" name="q" value="<%= filters.q %>" placeholder="キーワード, SKU, ASIN, NEコード, 商品名">
      <button class="btn-blue" type="submit">検索</button>
      <label class="btn-gray" for="adv-toggle" style="cursor:pointer">詳細検索 ≡</label>
      <input type="hidden" name="per" value="<%= per %>">
      <input type="checkbox" id="adv-toggle" class="adv-toggle" name="adv" value="1" <%= advOpen ? 'checked' : '' %>>
      <div class="adv">
        <h4>価格追従設定</h4>
        <% for (const [v, label] of [['', 'すべての商品'], ['tracking', '価格の自動変更をする'], ['off', '価格の自動変更をしない'], ['fba_lowest', 'FBA最安値'], ['lowest', '最安値'], ['buybox', 'カート価格'], ['custom', 'カスタム'], ['set', '方針あり'], ['unset', '方針なし']]) { %>
          <label class="tg"><input type="radio" name="mode" value="<%= v %>" <%= (filters.mode || '') === v ? 'checked' : '' %>><span><%= label %></span></label>
        <% } %>
        <h4>配送区分</h4>
        <% for (const [v, label] of [['', '全て'], ['FBA', 'FBAのみ'], ['FBM', '自己発送のみ']]) { %>
          <label class="tg"><input type="radio" name="channel" value="<%= v %>" <%= (filters.channel || '') === v ? 'checked' : '' %>><span><%= label %></span></label>
        <% } %>
        <h4>こだわり検索</h4>
        <label class="tg"><input type="radio" name="flag" value="" <%= !filters.flag ? 'checked' : '' %>><span>こだわり条件を設定しない</span></label>
        <% for (const [k, label] of Object.entries(flagLabels)) { %>
          <label class="tg"><input type="radio" name="flag" value="<%= k %>" <%= filters.flag === k ? 'checked' : '' %>><span><%= label %> (<%= num(stats.flags[k] || 0) %>)</span></label>
        <% } %>
        <h4>自社の判定 (ルールが今出している答え)</h4>
        <label class="tg"><input type="radio" name="action" value="" <%= !filters.action ? 'checked' : '' %>><span>すべて</span></label>
        <% for (const [k, label] of Object.entries(ACTIONS)) { %>
          <label class="tg"><input type="radio" name="action" value="<%= k %>" <%= filters.action === k ? 'checked' : '' %>><span><%= label %> (<%= num(stats.by_action[k] || 0) %>)</span></label>
        <% } %>
        <h4>出品価格</h4>
        <input type="number" name="price_min" value="<%= filters.price_min %>" placeholder="下限" style="width:110px;display:inline-block"> 〜
        <input type="number" name="price_max" value="<%= filters.price_max %>" placeholder="上限" style="width:110px;display:inline-block"> 円
        <h4>並び順</h4>
        <select name="sort" style="width:auto;display:inline-block">
          <option value="units" <%= filters.sort === 'units' ? 'selected' : '' %>>30日販売が多い順</option>
          <option value="stock" <%= filters.sort === 'stock' ? 'selected' : '' %>>数量が多い順</option>
          <option value="price" <%= filters.sort === 'price' ? 'selected' : '' %>>出品価格が高い順</option>
          <option value="gap" <%= filters.sort === 'gap' ? 'selected' : '' %>>カートより高い順</option>
          <option value="margin" <%= filters.sort === 'margin' ? 'selected' : '' %>>粗利率が低い順</option>
          <option value="sku" <%= filters.sort === 'sku' ? 'selected' : '' %>>SKU 順</option>
        </select>
        <div style="margin-top:12px">
          <button class="btn-blue" type="submit" style="padding:10px 26px;font-size:15px">検索</button>
          <a class="btn-gray" href="/apps/amazon-pricing/">条件をクリア</a>
        </div>
      </div>
    </div>
  </form>

  <div class="pt-result">
    <span>検索結果 : <b><%= num(total) %></b>件 　選択SKU数 : <b id="sel-count">0</b>件</span>
    <span class="pt-badge">出品 <%= num(stats.total) %></span>
    <span class="pt-badge" style="background:#5b21b6">方針あり <%= num(stats.with_policy) %></span>
    <% if (filters.custom_type) { %><span class="pt-badge" style="background:#6d28d9" title="型の画面の「使っている出品」から来た絞り込み。検索し直すと外れます">型「<%= typeNames[String(filters.custom_type)] || ('#' + filters.custom_type) %>」で絞り込み中 <a href="<%= qs({ custom_type: '', page: '1' }) %>" style="color:#fff;margin-left:4px">✕ 解除</a></span><% } %>
    <a href="<%= qs({ flag: 'below_floor', page: '1' }) %>" class="pt-badge" style="background:<%= (stats.flags.below_floor || 0) > 0 ? '#d9534f' : '#777' %>;text-decoration:none">⚠️ 赤字の疑い <%= num(stats.flags.below_floor || 0) %></a>
    <span class="pager">
      <% if (pages > 1) { %>
        <% if (page > 1) { %><a href="<%= qs({ page: String(page - 1) }) %>">← 前</a><% } %>
        <span><%= page %> / <%= pages %> ページ</span>
        <% if (page < pages) { %><a href="<%= qs({ page: String(page + 1) }) %>">次 →</a><% } %>
      <% } %>
    </span>
  </div>

  <div class="pt-bulk">
    <span>チェックの付いた商品を</span>
    <span class="group">価格の自動変更
      <select id="bulk-mode">
        <% for (const [k, label] of MODE_BUTTONS) { if (k === 'custom') continue; %><option value="<%= k %>"><%= label %></option><% } %>
        <% for (const t of customTypes) { %><option value="custom:<%= t.type_id %>">カスタム: <%= t.name %></option><% } %>
      </select>
      <button type="button" class="btn-gray btn-xs" id="bulk-mode-btn">記録</button>
    </span>
    <span class="group">
      <button type="button" class="btn-gray btn-xs" id="bulk-floor-btn">赤字ストッパーを「計算した下限」にする</button>
    </span>
    <span class="group">高値ストッパー ¥
      <input type="number" id="bulk-ceiling" min="1" step="1" style="width:90px" placeholder="例 2980">
      <button type="button" class="btn-gray btn-xs" id="bulk-ceiling-btn">記録</button>
    </span>
    <span class="group">
      <button type="button" class="btn-gray btn-xs" id="bulk-custom-btn">カスタム (上乗せ・最低粗利率・メモ)</button>
    </span>
    <span class="spacer"></span>
    <span>表示件数
      <% for (const n of [50, 100, 150, 300]) { %>
        <% if (n === per) { %><b><%= n %>件</b><% } else { %><a href="<%= qs({ per: String(n), page: '1' }) %>"><%= n %>件</a><% } %>
      <% } %>
    </span>
  </div>

  <div class="tbl-wrap">
  <table class="pt">
    <thead>
      <tr>
        <th><input type="checkbox" id="sel-all" title="全部チェック"></th>
        <th>ステータス</th>
        <th>更新</th>
        <th>ASIN</th>
        <th style="min-width:200px"><a href="<%= qs({ sort: 'sku', page: '1' }) %>" class="<%= sortCls('sku') %>">商品名 ▼</a><br><span class="small">SKU / NEコード</span></th>
        <th><a href="<%= qs({ sort: 'stock', page: '1' }) %>" class="<%= sortCls('stock') %>">数量 ▼</a></th>
        <th>コンディション</th>
        <th><a href="<%= qs({ sort: 'price', page: '1' }) %>" class="<%= sortCls('price') %>">出品価格 ▼</a><br>+配送料</th>
        <th>ポイント</th>
        <th><a href="<%= qs({ sort: 'gap', page: '1' }) %>" class="<%= sortCls('gap') %>">最低価格 ▼</a><br>+配送料</th>
        <th>価格の自動変更</th>
        <th>仕入れ価格<br><span class="small">(税込・NE)</span></th>
        <th><span class="lbl-gray">高値ｽﾄｯﾊﾟｰ</span><br><span class="lbl-red">赤字ｽﾄｯﾊﾟｰ</span></th>
        <th>手数料<br><a href="<%= qs({ sort: 'margin', page: '1' }) %>" class="<%= sortCls('margin') %>">粗利益 ▼</a></th>
        <th><a href="<%= qs({ sort: 'units', page: '1' }) %>" class="<%= sortCls('units') %>">売れた個数 ▼</a><br><span class="small">(30日・確定分)</span></th>
        <th style="min-width:170px">自社の判定<br><span class="small">(<%= RULE_VERSION %>)</span></th>
        <th>リサーチ</th>
      </tr>
    </thead>
    <tbody>
    <% if (rows.length === 0) { %>
      <tr><td colspan="17" class="dim" style="padding:20px;text-align:center">該当する出品がありません</td></tr>
    <% } %>
    <% let i = 0; for (const r of rows) { i += 1; %>
      <% const l = r.live; const minMargin = r.min_margin_rate == null ? DEFAULT_MIN_MARGIN_RATE : r.min_margin_rate;
         const stopped = l.flags.includes('FLOOR_CLAMP') || l.flags.includes('BELOW_STOPPER');
         const belowCost = l.flags.includes('BELOW_COST_FLOOR');
         const policyJson = JSON.stringify({ seller_sku: r.seller_sku, ne_name: r.ne_name, mode: r.mode, custom_type_id: r.custom_type_id, custom_type_name: r.custom_type_name, floor_price: r.floor_price, ceiling_price: r.ceiling_price, offset_jpy: r.offset_jpy, min_margin_rate: r.min_margin_rate, note: r.policy_note, computed_floor: r.computed_floor, has_policy: r.has_policy }); %>
      <tr class="<%= i % 2 === 0 ? 'alt' : '' %>" data-sku="<%= r.seller_sku %>" data-floor-calc="<%= r.computed_floor == null ? '' : r.computed_floor %>" data-policy="<%= policyJson %>">
        <td class="center"><input type="checkbox" class="pt-sel" value="<%= r.seller_sku %>"></td>
        <td class="center" style="white-space:nowrap">
          <% if (r.my_price != null) { %><div>出品中</div><% } else { %><div class="dim" title="<%= REASONS.NO_MY_PRICE %>">価格なし</div><% } %>
          <% if (stopped) { %><div class="badge-stop" title="<%= FLAGS.FLOOR_CLAMP %> / <%= FLAGS.BELOW_STOPPER %>">赤字<br>STOP!</div><% } else if (belowCost) { %><div class="badge-stop" title="<%= FLAGS.BELOW_COST_FLOOR %>">赤字?</div><% } %>
          <div><a class="st-btn" href="/apps/amazon-pricing/listings/<%= encodeURIComponent(r.seller_sku) %>">詳細 ▾</a></div>
          <div><button type="button" class="st-btn pt-memo">メモ ✎</button></div>
        </td>
        <td class="small pt-stamp" style="white-space:nowrap">
          <% if (r.policy_updated_at) { %><div><%= toJst(r.policy_updated_at) %></div><div title="<%= r.policy_updated_by %>"><%= String(r.policy_updated_by || '').split('@')[0] %></div><a href="/apps/amazon-pricing/history?sku=<%= encodeURIComponent(r.seller_sku) %>">方針の変動</a><% } else { %><span class="dim">方針は未設定</span><% } %>
        </td>
        <td class="code center">
          <% if (r.asin) { %><a href="https://www.amazon.co.jp/dp/<%= encodeURIComponent(r.asin) %>" target="_blank" rel="noopener"><%= r.asin %></a><% } else { %>—<% } %>
        </td>
        <td>
          <div class="pt-name"><a href="/apps/amazon-pricing/listings/<%= encodeURIComponent(r.seller_sku) %>"><%= r.ne_name || '(NE商品と未突合)' %></a></div>
          <div class="pt-sku code"><%= r.seller_sku %></div>
          <div class="small"><%= r.ne_code || '—' %><% if (r.parts > 1) { %> (セット <%= r.parts %>品)<% } %></div>
        </td>
        <td class="center"><span class="pt-box <%= r.stock == null ? 'none' : '' %>" title="<%= isFba(r) ? 'FBA 倉庫の在庫 (日次在庫スナップショット)' : '自社倉庫の在庫 (日次在庫スナップショット)' %>"><%= r.stock == null ? '—' : num(r.stock) %></span></td>
        <td class="center">新品<br><b><%= isFba(r) ? 'FBA' : '自己発送' %></b></td>
        <td>
          <div class="lbl-gray">出品価格</div>
          <div><span class="pt-yen">¥</span><span class="pt-box <%= r.my_price == null ? 'none' : '' %>"><%= yen(r.my_price) %></span></div>
          <% if (!isFba(r)) { %><div class="small">送料 (原価側): <%= yen(r.ship_cost) %></div><% } %>
          <div class="lbl-gray" style="margin-top:6px">法人価格</div>
          <div><span class="pt-yen">¥</span><span class="pt-box none" title="法人価格は M2.5 で取得予定 (D-12: 通常価格と同じにしたい)">—</span></div>
        </td>
        <td class="center"><span class="pt-box none" title="ポイントは M2.5 で取得予定 (D-10)">—</span><div class="small">未取得</div></td>
        <td style="white-space:nowrap">
          <div><b>カート価格</b></div>
          <div>¥<%= yen(r.buybox_price) %></div>
          <div class="small"><% if (r.buybox_is_mine === 1) { %><span class="chip c-ok">自社</span><% } else if (r.buybox_is_mine === 0) { %><span class="chip c-warn">他社</span><% } else if (r.buybox_price != null) { %><span class="chip c-none">不明</span><% } else { %><span class="chip c-none">カート無し</span><% } %></div>
          <div class="small">(<%= mmdd(r.snapshot_date_jst) %> 時点)</div>
        </td>
        <td>
          <div class="pt-mode-stack">
            <% for (const [k, label] of MODE_BUTTONS) { %>
              <button type="button" class="pt-mode m-<%= k %> <%= (r.mode || 'off') === k ? 'on' : '' %>" data-mode="<%= k %>" title="<%= k === 'custom' ? 'カスタムの型を選んで記録する' : (MODES[k] || label) %>"><%= label %></button>
            <% } %>
            <div class="pt-type-name" title="<%= r.mode === 'custom' ? '型: ' + (r.custom_type_name || '(型が読めない)') : '' %>"><%= r.mode === 'custom' ? (r.custom_type_name || '⚠ 型なし') : '' %></div>
          </div>
        </td>
        <td class="center" style="white-space:nowrap">
          <% if (r.cost_incl_tax == null) { %><span class="chip c-bad">原価不明</span><div class="small">NE に原価が無い</div><% } else { %><span class="pt-yen">¥</span><span class="pt-box"><%= yen(r.cost_incl_tax) %></span><% } %>
        </td>
        <td style="white-space:nowrap">
          <div class="lbl-gray">高値ｽﾄｯﾊﾟｰ</div>
          <div><span class="pt-yen">¥</span><input class="pt-inp" type="number" min="1" step="1" data-field="ceiling_price" value="<%= r.ceiling_price == null ? '' : r.ceiling_price %>" placeholder="-"></div>
          <div class="lbl-red" style="margin-top:6px">赤字ｽﾄｯﾊﾟｰ</div>
          <div><span class="pt-yen">¥</span><input class="pt-inp" type="number" min="1" step="1" data-field="floor_price" value="<%= r.floor_price == null ? '' : r.floor_price %>" placeholder="-"></div>
          <div class="small" title="原価 + 手数料 + 最低粗利率 <%= pct(minMargin, 0) %> から計算した下限。人のストッパーと高い方が効く">計算 <span class="calc-floor"><%= yen(r.computed_floor) %></span> / 実効 <b class="eff-floor"><%= yen(r.effective_floor) %></b></div>
        </td>
        <td style="white-space:nowrap">
          <div class="lbl-gray">手数料</div>
          <div class="fee-red">¥ <%= yen(r.fee_now) %></div>
          <div class="lbl-gray" style="margin-top:6px">粗利益</div>
          <% if (r.gross_now.gross == null) { %><div class="dim">—</div><% } else { %>
            <div class="<%= r.gross_now.gross < 0 ? 'neg' : '' %>">¥<%= yen(r.gross_now.gross) %></div>
            <div class="small <%= r.gross_now.rate < minMargin ? 'neg' : '' %>">(<%= pct(r.gross_now.rate) %>)</div>
          <% } %>
        </td>
        <td class="center" style="white-space:nowrap">
          <div class="lbl-gray">売れた個数</div>
          <div class="fee-red"><%= num(r.units_30d ?? 0) %>個</div>
          <div class="small">¥<%= yen(r.sales_30d) %></div>
        </td>
        <td>
          <span class="chip c-<%= l.action %> jv-chip"><%= ACTIONS[l.action] %><% if (l.proposedPrice != null) { %> → <%= yen(l.proposedPrice) %><% } %></span>
          <div class="reason jv-reason" style="max-width:190px;white-space:normal" title="<%= l.reasonText %>"><%= l.reasonText %></div>
          <% const shown = l.flags.filter((f) => f !== 'NO_SALES_30D'); %>
          <% if (shown.length) { %><div class="flags"><% for (const f of shown) { %><span class="chip <%= f === 'BELOW_COST_FLOOR' || f === 'BELOW_STOPPER' ? 'c-bad' : 'c-warn' %>" title="<%= FLAGS[f] || f %>"><%= FLAGS[f] ? FLAGS[f].split(' (')[0] : f %></span><% } %></div><% } %>
        </td>
        <td class="center" style="white-space:nowrap">
          <% if (r.asin) { %>
            <div><a class="keepa" href="https://keepa.com/#!product/5-<%= encodeURIComponent(r.asin) %>" target="_blank" rel="noopener">📈 Keepa</a></div>
            <div style="margin-top:4px"><a class="amz" href="https://www.amazon.co.jp/dp/<%= encodeURIComponent(r.asin) %>" target="_blank" rel="noopener">Amazon</a></div>
          <% } else { %>—<% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <div class="pt-result">
    <span class="pager">
      <% if (pages > 1) { %>
        <% if (page > 1) { %><a href="<%= qs({ page: String(page - 1) }) %>">← 前</a><% } %>
        <span><%= page %> / <%= pages %> ページ</span>
        <% if (page < pages) { %><a href="<%= qs({ page: String(page + 1) }) %>">次 →</a><% } %>
      <% } %>
    </span>
  </div>
</div>

<dialog id="bulk-dlg">
  <form class="dlg" id="bulk-form" method="dialog">
    <h3>チェックした出品に一括で記録する</h3>
    <div class="sub" id="bulk-desc"></div>
    <div class="field">
      <label for="bulk-reason-text">理由のメモ (任意)</label>
      <input id="bulk-reason-text" type="text" maxlength="300" placeholder="例: プライスターの D-13 突合で直す">
    </div>
    <div class="hint">1 件ずつ記録します。途中で失敗した分はスキップして続けます。価格は変わりません。</div>
    <div class="err" id="bulk-err"></div>
    <div class="small" id="bulk-prog"></div>
    <div class="actions">
      <button type="button" class="btn" id="bulk-cancel">やめる</button>
      <button type="submit" class="btn btn-primary" id="bulk-ok">記録する (価格は変わりません)</button>
    </div>
  </form>
</dialog>

<%- include('_policy_dialog') %>
<script>
  (function () {
    var MODE_LABELS = { fba_lowest: 'FBA最安値', lowest: '最安値', buybox: 'カート', custom: 'カスタム', off: 'しない' };
    function modeLabel(k) {
      if (k === 'fba_lowest') return MODE_LABELS.fba_lowest;
      if (k === 'lowest') return MODE_LABELS.lowest;
      if (k === 'buybox') return MODE_LABELS.buybox;
      if (k === 'custom') return MODE_LABELS.custom;
      return MODE_LABELS.off;
    }
    function yen(v) { return v == null ? '—' : Number(v).toLocaleString(); }
    /* 自分の API へ方針を記録する (価格は送らない。送る仕組みが無い) */
    function post(sku, body, done) {
      fetch('/apps/amazon-pricing/api/policies/' + encodeURIComponent(sku), {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      }).then(function (r) { return r.json().then(function (j) { return j; }); })
        .then(function (j) { done(null, j); })
        .catch(function (e) { done(e, null); });
    }
    function setBusy(tr, on) { tr.classList.toggle('busy', on); }
    /* 記録後: 判定の欄・実効下限・更新欄・data-policy を新しい値に */
    function applyResult(tr, j) {
      var live = j.live || {};
      var chip = tr.querySelector('.jv-chip');
      if (chip) {
        chip.textContent = (live.verdict_label || '') + (live.proposed_price != null ? ' → ' + yen(live.proposed_price) : '');
        chip.className = 'chip jv-chip c-' + (live.verdict_class || 'hold');
      }
      var rs = tr.querySelector('.jv-reason');
      if (rs) { rs.textContent = live.reason_text || ''; rs.title = live.reason_text || ''; }
      var ef = tr.querySelector('.eff-floor');
      if (ef) ef.textContent = yen(live.effective_floor);
      var st = tr.querySelector('.pt-stamp');
      if (st) st.textContent = 'いま記録 (再読み込みで詳細)';
      var p = j.policy || {};
      var cur = {};
      try { cur = JSON.parse(tr.getAttribute('data-policy')); } catch (e) { cur = {}; }
      cur.mode = p.mode; cur.floor_price = p.floor_price; cur.ceiling_price = p.ceiling_price;
      cur.offset_jpy = p.offset_jpy; cur.min_margin_rate = p.min_margin_rate; cur.note = p.note; cur.has_policy = true;
      cur.custom_type_id = p.custom_type_id == null ? null : p.custom_type_id; cur.custom_type_name = p.custom_type_name || null;
      tr.dataset.policy = JSON.stringify(cur);
      tr.querySelectorAll('button.pt-mode').forEach(function (x) { x.classList.toggle('on', x.dataset.mode === (p.mode || 'off')); });
      var tn = tr.querySelector('.pt-type-name');
      if (tn) { tn.textContent = p.mode === 'custom' ? (p.custom_type_name || '⚠ 型なし') : ''; tn.title = p.mode === 'custom' ? '型: ' + (p.custom_type_name || '') : ''; }
      var fl = tr.querySelector('input.pt-inp[data-field="floor_price"]');
      if (fl) fl.value = p.floor_price == null ? '' : p.floor_price;
      var ce = tr.querySelector('input.pt-inp[data-field="ceiling_price"]');
      if (ce) ce.value = p.ceiling_price == null ? '' : p.ceiling_price;
    }
    /* ── ストッパーの直接入力: 値を変えて Enter か欄を出ると記録 (プライスターと同じ) ── */
    document.addEventListener('change', function (ev) {
      var inp = ev.target;
      if (!inp.classList || !inp.classList.contains('pt-inp')) return;
      var tr = inp.closest('tr');
      var sku = tr.dataset.sku;
      var field = inp.dataset.field;
      var val = String(inp.value).trim();
      var body;
      if (field === 'floor_price') body = { floor_price: val === '' ? null : val, reason_code: 'inline' };
      else body = { ceiling_price: val === '' ? null : val, reason_code: 'inline' };
      inp.classList.remove('saved'); inp.classList.remove('err');
      setBusy(tr, true);
      post(sku, body, function (err, j) {
        setBusy(tr, false);
        if (err || !j.ok) { inp.classList.add('err'); showToast('記録できませんでした: ' + (err ? err.message : j.error), true); return; }
        inp.classList.add('saved');
        applyResult(tr, j);
        var label = field === 'floor_price' ? '赤字ストッパー' : '高値ストッパー';
        showToast(label + 'を ' + (val === '' ? 'なし' : yen(val) + ' 円') + ' にして記録しました。価格は変わりません', false);
      });
    });
    /* ── 価格の自動変更ボタン: 押した瞬間に記録 (プライスターと同じ)。トーストの「元に戻す」で前の値に戻せる ── */
    document.addEventListener('click', function (ev) {
      var b = ev.target.closest ? ev.target.closest('button.pt-mode, button.pt-memo') : null;
      if (!b) return;
      var tr = b.closest('tr');
      var sku = tr.dataset.sku;
      var mode = b.dataset.mode;
      if (b.classList.contains('pt-memo') || mode === 'custom') {
        /* カスタムは型を選ぶ必要があるので、ボタン 1 発ではなく方針の画面を開く (追従モードをカスタムにした状態で) */
        try { openPolicyDialog(JSON.parse(tr.getAttribute('data-policy')), mode === 'custom' ? 'custom' : null); } catch (e) { showToast('開けませんでした: ' + e.message, true); }
        return;
      }
      if (b.classList.contains('on')) return;
      var prevPolicy = {};
      try { prevPolicy = JSON.parse(tr.getAttribute('data-policy')) || {}; } catch (e) { prevPolicy = {}; }
      var prevMode = prevPolicy.mode || 'off';
      var prevType = prevMode === 'custom' ? prevPolicy.custom_type_id : null;
      setBusy(tr, true);
      post(sku, { mode: mode, reason_code: 'inline' }, function (err, j) {
        setBusy(tr, false);
        if (err || !j.ok) { showToast('記録できませんでした: ' + (err ? err.message : j.error), true); return; }
        applyResult(tr, j);
        showToast('価格の自動変更を「' + modeLabel(mode) + '」にして記録しました。価格は変わりません', false, function () {
          setBusy(tr, true);
          post(sku, { mode: prevMode, custom_type_id: prevType, reason_code: 'mistake', reason_text: '一覧の「元に戻す」' }, function (err2, j2) {
            setBusy(tr, false);
            if (err2 || !j2.ok) { showToast('戻せませんでした: ' + (err2 ? err2.message : j2.error), true); return; }
            applyResult(tr, j2);
            showToast('「' + modeLabel(prevMode) + '」に戻して記録しました', false);
          });
        });
      });
    });
    /* ── チェックと一括 ── */
    function selectedRows() {
      var out = [];
      document.querySelectorAll('input.pt-sel').forEach(function (c) { if (c.checked) out.push(c.closest('tr')); });
      return out;
    }
    function updateCount() { var n = selectedRows().length; document.getElementById('sel-count').textContent = String(n); }
    document.getElementById('sel-all').addEventListener('change', function (ev) {
      document.querySelectorAll('input.pt-sel').forEach(function (c) { c.checked = ev.target.checked; });
      updateCount();
    });
    document.addEventListener('change', function (ev) { if (ev.target.classList && ev.target.classList.contains('pt-sel')) updateCount(); });
    var bulk = { items: [], label: '' };
    var bulkDlg = document.getElementById('bulk-dlg');
    function startBulk(label, makeBody) {
      var rows = selectedRows();
      if (rows.length === 0) { showToast('先に商品にチェックを付けてください', true); return; }
      var items = []; var skipped = 0;
      rows.forEach(function (tr) {
        var body = makeBody(tr);
        if (!body) { skipped += 1; return; }
        items.push({ tr: tr, body: body });
      });
      if (items.length === 0) { showToast('記録できる行がありません (' + label + ')', true); return; }
      bulk.items = items; bulk.label = label;
      document.getElementById('bulk-desc').textContent = items.length + ' 件に「' + label + '」を記録します' + (skipped ? ' (スキップ ' + skipped + ' 件: 下限が計算できない行)' : '');
      document.getElementById('bulk-err').textContent = '';
      document.getElementById('bulk-prog').textContent = '';
      document.getElementById('bulk-reason-text').value = '';
      document.getElementById('bulk-ok').disabled = false;
      bulkDlg.showModal();
    }
    document.getElementById('bulk-cancel').addEventListener('click', function () { bulkDlg.close(); });
    document.getElementById('bulk-form').addEventListener('submit', function (ev) {
      ev.preventDefault();
      var okBtn = document.getElementById('bulk-ok');
      okBtn.disabled = true;
      var prog = document.getElementById('bulk-prog');
      var text = document.getElementById('bulk-reason-text').value;
      var queue = bulk.items.slice();
      var total = queue.length; var done = 0; var failed = 0;
      function step() {
        var it = queue.shift();
        if (!it) {
          prog.textContent = '完了: ' + (total - failed) + ' 件記録 / ' + failed + ' 件失敗';
          showToast(bulk.label + ' を ' + (total - failed) + ' 件に記録しました。価格は変わりません', failed > 0);
          setTimeout(function () { bulkDlg.close(); location.reload(); }, 900);
          return;
        }
        var body = it.body; body.reason_code = 'bulk'; body.reason_text = text;
        post(it.tr.dataset.sku, body, function (err, j) {
          done += 1;
          if (err || !j.ok) { failed += 1; document.getElementById('bulk-err').textContent = it.tr.dataset.sku + ': ' + (err ? err.message : j.error); }
          else applyResult(it.tr, j);
          prog.textContent = done + ' / ' + total;
          step();
        });
      }
      step();
    });
    document.getElementById('bulk-mode-btn').addEventListener('click', function () {
      var v = document.getElementById('bulk-mode').value;
      if (v.indexOf('custom:') === 0) {
        /* カスタムの型 (値は custom:<型の番号>) */
        var tid = v.slice(7);
        var label = 'カスタム (型 #' + tid + ')';
        document.getElementById('bulk-mode').querySelectorAll('option').forEach(function (o) { if (o.selected) label = o.textContent; });
        startBulk('価格の自動変更 = ' + label, function () { return { mode: 'custom', custom_type_id: tid }; });
        return;
      }
      startBulk('価格の自動変更 = ' + modeLabel(v), function () { return { mode: v }; });
    });
    document.getElementById('bulk-floor-btn').addEventListener('click', function () {
      startBulk('赤字ストッパー = 計算した下限', function (tr) {
        var calc = tr.dataset.floorCalc;
        if (!calc) return null;
        return { floor_price: calc };
      });
    });
    document.getElementById('bulk-ceiling-btn').addEventListener('click', function () {
      var v = String(document.getElementById('bulk-ceiling').value).trim();
      if (!v) { showToast('高値ストッパーの金額を入れてください', true); return; }
      startBulk('高値ストッパー = ' + yen(v) + ' 円', function () { return { ceiling_price: v }; });
    });
    document.getElementById('bulk-custom-btn').addEventListener('click', function () {
      var rows = selectedRows();
      if (rows.length === 0) { showToast('先に商品にチェックを付けてください', true); return; }
      var skus = rows.map(function (tr) { return tr.dataset.sku; });
      openPolicyDialogBulk(skus);
    });
  })();
</script>
<% } %>
</div>
