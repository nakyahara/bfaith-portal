<%- include('_header') %>
<div class="wrap" style="max-width:640px">
  <div class="card">
    <h2>新規商品ドラフト</h2>
    <p class="muted" style="margin-top:-6px">
      登録すると Notion 商品マスターにカードが自動作成されます。画像・参考URLは登録後の詳細画面で追加します。
    </p>
    <div class="field">
      <label class="req">商品名</label>
      <input type="text" id="f-name" placeholder="例: ○○ ギフトセット 5種入り">
    </div>
    <div class="field">
      <label class="req">NE商品コード</label>
      <input type="text" id="f-ne-code" placeholder="例: ABC-001">
      <!-- NE の代表商品コードで判定。子SKUを入れた場合は代表コードへの差し替えを提案する -->
      <div id="variation-hint" style="margin-top:6px; font-size:12px;"></div>
    </div>
    <div class="field">
      <label>公式ページURL (AI生成の参照元。参考URL / Amazon URL でも代用可)</label>
      <input type="url" id="f-official-url" placeholder="https://...">
    </div>
    <div class="field" style="display:flex; gap:12px;">
      <div style="flex:1">
        <label>売価 (税込・円)</label>
        <input type="number" id="f-price" min="0" step="1">
      </div>
      <div style="flex:1">
        <label>JANコード</label>
        <input type="text" id="f-jan" inputmode="numeric">
      </div>
    </div>
    <div style="display:flex; gap:10px; align-items:center; margin-top:16px;">
      <button class="btn btn-primary" id="create-btn">登録する</button>
      <span class="muted" id="create-result"></span>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('create-btn');
  const out = document.getElementById('create-result');

  // ─── NE バリエーション判定 (入力欄を離れたら問い合わせる) ───
  const neInput = document.getElementById('f-ne-code');
  const hint = document.getElementById('variation-hint');
  let lastChecked = null;

  neInput.addEventListener('blur', checkVariation);
  async function checkVariation() {
    const code = neInput.value.trim();
    if (!code || code === lastChecked) return;
    lastChecked = code;
    hint.textContent = 'NE商品マスタを確認中…';
    hint.style.color = '#94a3b8';
    try {
      const res = await fetch('/apps/product-hub/api/variation?ne_code=' + encodeURIComponent(code));
      const j = await res.json();
      // 応答が返る頃には別のコードが入力されているかもしれない。
      // 古い応答で上書きしないよう、現在の入力と一致するときだけ反映する (Codex medium-2)
      if (neInput.value.trim() !== code) return;
      if (!j.ok) { hint.textContent = ''; return; }
      hint.innerHTML = '';
      applyNeDefaults(j.neDefaults);
      if (j.kind === 'variation' && j.isChild) {
        // 既定でまとめる (中原さん方針)。確認は挟まないが、**入力欄をその場で代表コードに書き換える**。
        // 送信時にサーバー側だけで正規化すると、子SKU向けに書いた商品名のまま代表ページと
        // Notionカードが作られてしまう (Codex high-3)。先に見せて直す機会を作る。
        neInput.value = j.groupKey;
        lastChecked = j.groupKey;
        hint.style.color = '#166534';
        hint.textContent = '✅ 代表商品コード「' + j.groupKey + '」に変更しました ('
          + j.memberCount + ' SKU)。楽天は1ページ＝代表コード単位です。'
          + '商品名は個別SKUではなく、ページ全体の名前にしてください。';
      } else if (j.kind === 'variation') {
        hint.style.color = '#166534';
        hint.textContent = '✅ バリエーション商品です (代表コード ' + j.groupKey + ' に ' + j.memberCount + ' SKU)';
      } else if (j.kind === 'detached') {
        hint.style.color = '#64748b';
        hint.textContent = 'バリエーションから外されたSKUです。単独のページとして登録します';
      } else if (j.kind === 'single') {
        hint.style.color = '#64748b';
        hint.textContent = '単品です (NEに代表商品コードの登録なし)';
      } else if (j.kind === 'conflict') {
        hint.style.color = '#b45309';
        hint.textContent = '⚠️ NE商品マスタに同じ商品コードが重複しています。NE側を直してください';
      } else {
        hint.style.color = '#94a3b8';
        hint.textContent = 'NE商品マスタに見つかりません (未登録の新商品なら問題ありません)';
      }
    } catch (e) {
      hint.textContent = '';
    }
  }

  // NE商品マスタから **初期値だけ** 入れる (中原さん決定 2026-07-25)。
  // 以降はアプリが正なので、人が既に書いた値は絶対に上書きしない。
  // 税率は登録APIが draft_yahoo に入れる (この画面に欄が無いため)。
  let lastAutoName = null; // 直前に自動入力した値。人の編集と区別するために覚えておく

  function applyNeDefaults(ne) {
    const noteId = 'ne-default-note';
    document.getElementById(noteId)?.remove();
    const nameInput = document.getElementById('f-name');
    const current = nameInput.value.trim();
    // 空 or「前回の自動入力値のまま」なら差し替えてよい。
    // 人が手を入れていたら触らない (Codex medium-3: 別商品の自動値が残るのも防ぐ)
    const replaceable = current === '' || (lastAutoName !== null && current === lastAutoName);
    if (!replaceable) return;
    if (!ne || !ne.name) {
      // NE に無いコードへ変えたら、前回の自動入力値は消す (別商品の名前を残さない)
      if (current !== '' && current === lastAutoName) { nameInput.value = ''; lastAutoName = null; }
      return;
    }
    nameInput.value = ne.name;
    lastAutoName = ne.name;
    const note = document.createElement('div');
    note.id = noteId;
    note.className = 'muted';
    note.style.marginTop = '4px';
    note.textContent = 'NE商品マスタから初期値を入れました。売り場向けに直して構いません。';
    nameInput.insertAdjacentElement('afterend', note);
  }

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    out.textContent = '登録中… (Notionカードも作成します)';
    try {
      const res = await fetch('/apps/product-hub/api/drafts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('f-name').value,
          ne_code: document.getElementById('f-ne-code').value,
          official_url: document.getElementById('f-official-url').value,
          price: document.getElementById('f-price').value,
          jan_code: document.getElementById('f-jan').value,
        }),
      });
      const json = await res.json();
      if (!json.ok) {
        out.textContent = 'エラー: ' + (json.error || '登録に失敗しました');
        btn.disabled = false;
        return;
      }
      const notionOk = json.notion && (json.notion.outcome === 'created' || json.notion.outcome === 'adopted_existing');
      // 画像フォルダの自動作成結果 (単品のみ)。失敗してもカードはできているので注意書きだけ
      const fol = json.image_folder || {};
      const folderMsg = fol.outcome === 'created' ? ' 画像フォルダも作成しました。'
        : fol.outcome === 'reused' ? ' 画像フォルダは既存のものを紐付けました。'
        : fol.outcome === 'pending' ? ' 画像フォルダは作成中です (完了すると詳細画面に入ります)。'
        : fol.outcome === 'failed' ? ' ⚠画像フォルダの自動作成に失敗しました (詳細画面で手動設定できます)。'
        : '';
      out.textContent = (notionOk
        ? '登録しました。Notionカードも作成済み。'
        : '登録しました。') + folderMsg + '詳細画面へ移動します…';
      setTimeout(() => { location.href = '/apps/product-hub/detail/' + json.id; }, 900);
    } catch (e) {
      out.textContent = '通信エラー: ' + e.message;
      btn.disabled = false;
    }
  });
</script>
