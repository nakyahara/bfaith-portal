  document.getElementById('rk-register-btn').addEventListener('click', async () => {
    if (!(await saveRakutenFields())) return;
    if (!confirm('楽天に「非公開 (倉庫指定)」で登録します。\n売り場には表示されません。公開はRMS画面で行います。\n\nよろしいですか?')) return;
    const btn = document.getElementById('rk-register-btn');
    btn.disabled = true;
    rkResult.textContent = '楽天に登録中…';
    try {
      const json = await post(BASE + '/rakuten/register', { confirm: true });
      if (json.ok) {
        rkResult.textContent = '✅ 非公開で登録しました';
        setTimeout(() => location.reload(), 1200);
      } else {
        rkResult.textContent = '';
        const pre = document.getElementById('rk-preview');
        pre.style.display = 'block';
        pre.textContent = '❌ RMSエラー:\n' + (json.error || (json.reasons || []).join('\n'));
      }
    } finally { btn.disabled = false; }
  });

  // SKU をバリエーションから外す / 戻す (委譲。表は再描画されるため)
  document.addEventListener('click', async (ev) => {
    const ex = ev.target.closest && ev.target.closest('.exclude-sku-btn');
    const re = ev.target.closest && ev.target.closest('.restore-sku-btn');
    if (!ex && !re) return;
    const btn = ex || re;
    const code = btn.getAttribute('data-code');
    if (ex && !confirm(code + ' をこのページのバリエーションから外します。\n\n別ページにしたい場合は、後でこのコードで新規登録してください。')) return;
    btn.disabled = true;
    const json = await post(BASE + '/variation/' + (ex ? 'exclude' : 'restore'), { ne_code: code });
    if (json.ok) { location.reload(); } else { alert(json.error || '操作に失敗しました'); btn.disabled = false; }
  });

  // 子SKUのドラフトを代表商品コードにまとめる。
  // 画面に出した from/to をサーバーへ送り、実行時の再計算と一致した場合だけ適用させる
  const regroupBtn = document.getElementById('regroup-btn');
  if (regroupBtn) {
    regroupBtn.addEventListener('click', async () => {
      const from = regroupBtn.getAttribute('data-from');
      const to = regroupBtn.getAttribute('data-to');
      if (!confirm('このドラフトの商品コードを「' + from + '」から代表商品コード「' + to + '」に変更します。\n\nよろしいですか?')) return;
      regroupBtn.disabled = true;
      const json = await post(BASE + '/regroup', { expected_from: from, expected_to: to });
      if (json.ok) { location.reload(); } else { alert(json.error || 'まとめられませんでした'); regroupBtn.disabled = false; }
    });
  }

  // ─── 商品ページ表記 (化粧品・食品) ───
  (function initPageInfo() {
    const typeSel = document.getElementById('pi-type');
    if (!typeSel) return;
    const foodBox = document.getElementById('pi-food-fields');
    const originSel = document.getElementById('pi-origin-type');
    // 商品タイプに整合する商品区分だけ選べるようにする (サーバー側でも検証)
    const catSel = document.getElementById('pi-category');
    let catByType = {};
    try { catByType = JSON.parse(document.getElementById('pi-cat-by-type').textContent) || {}; } catch (e) {}

    // 商品タイプごとの表示項目 (2026-07-29 中原さん要望: タイプ連動で表示を絞る)。
    // true=表示 / false=非表示 / 'overseas'=海外製のときだけ表示。
    // ただし値が入っている項目は絶対に隠さない (掲載HTMLに載る値が見えなくなるため)
    const FIELD_RULES = {
      'pi-f-category':    { valueId: 'pi-category',    general: false, cosmetics: true,  health_food: true,  food: true },
      'pi-f-origin':      { valueId: 'pi-origin-type', general: true,  cosmetics: true,  health_food: true,  food: true },
      'pi-f-seller':      { valueId: 'pi-seller',      general: true,  cosmetics: true,  health_food: true,  food: true },
      'pi-f-importer':    { valueId: 'pi-importer',    general: false, cosmetics: 'overseas', health_food: 'overseas', food: 'overseas' },
      'pi-f-volume':      { valueId: 'pi-volume',      general: false, cosmetics: true,  health_food: true,  food: true },
      'pi-f-ingredients': { valueId: 'pi-ingredients', general: true,  cosmetics: true,  health_food: false, food: false },
    };
    // 楽天必須の *必須 マーク (validatePageInfo と対応)
    const REQ_LABELS = {
      cosmetics: ['pi-l-category', 'pi-l-origin', 'pi-l-seller'],
      health_food: ['pi-l-category', 'pi-l-origin', 'pi-l-seller', 'pi-l-volume',
        'pi-l-food-name', 'pi-l-food-ingredients', 'pi-l-food-expiry', 'pi-l-food-storage'],
    };
    const ALL_REQ_LABELS = ['pi-l-category', 'pi-l-origin', 'pi-l-seller', 'pi-l-importer', 'pi-l-volume',
      'pi-l-food-name', 'pi-l-food-ingredients', 'pi-l-food-expiry', 'pi-l-food-storage'];
    // 雑貨は楽天必須の記載がない → 入力ハードルを下げるため「(任意)」を明示 (中原さん指示 2026-08-01)
    const OPT_LABELS_GENERAL = ['pi-l-seller', 'pi-l-size', 'pi-l-ingredients', 'pi-l-usage'];

    const applyTypeVisibility = () => {
      const t = typeSel.value || 'general';
      for (const [wrapId, rule] of Object.entries(FIELD_RULES)) {
        const wrap = document.getElementById(wrapId);
        if (!wrap) continue;
        const hasValue = !!String((document.getElementById(rule.valueId) || {}).value || '').trim();
        let show = rule[t];
        if (show === 'overseas') show = originSel.value === '海外製';
        wrap.style.display = (show || hasValue) ? '' : 'none';
      }
      foodBox.style.display = (t === 'food' || t === 'health_food') ? '' : 'none';
      // *必須 マークの付け替え
      const req = new Set(REQ_LABELS[t] || []);
      if ((t === 'cosmetics' || t === 'health_food') && originSel.value === '海外製') req.add('pi-l-importer');
      for (const id of ALL_REQ_LABELS) {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('req', req.has(id));
      }
      // 雑貨のとき (任意) マーク (必須マークとは排他: 雑貨はREQ_LABELS対象外)
      for (const id of OPT_LABELS_GENERAL) {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('opt', t === 'general' && !req.has(id));
      }
      // 商品タイプに整合する商品区分だけ選べるようにする
      const allowed = catByType[t] || null;
      for (const opt of catSel.options) {
        if (!opt.value) continue;
        const ok = !allowed || allowed.includes(opt.value);
        opt.hidden = !ok;
        opt.disabled = !ok;
      }
      if (allowed && catSel.value && !allowed.includes(catSel.value)) catSel.value = '';
      updateTabBadges();
    };
    typeSel.addEventListener('change', applyTypeVisibility);
    originSel.addEventListener('change', applyTypeVisibility);
    applyTypeVisibility();

    const collect = () => ({
      product_type: typeSel.value,
      category_label: document.getElementById('pi-category').value,
      origin_type: document.getElementById('pi-origin-type').value,
      origin_country: document.getElementById('pi-origin-country').value,
      seller_name: document.getElementById('pi-seller').value,
      importer_name: document.getElementById('pi-importer').value,
      content_volume: document.getElementById('pi-volume').value,
      size_text: document.getElementById('pi-size').value,
      ingredients: document.getElementById('pi-ingredients').value,
      usage_notes: document.getElementById('pi-usage').value,
      food_name: document.getElementById('pi-food-name').value,
      food_ingredients: document.getElementById('pi-food-ingredients').value,
      food_expiry: document.getElementById('pi-food-expiry').value,
      food_storage: document.getElementById('pi-food-storage').value,
    });

    const result = document.getElementById('pi-result');
    const warnBox = document.getElementById('pi-warnings');
    async function savePageInfo() {
      const json = await post(BASE + '/page-info', collect());
      if (!json.ok) { alert(json.error || '保存に失敗しました'); return null; }
      document.getElementById('pi-html-src').value = json.html || '';
      warnBox.replaceChildren();
      if (json.warnings && json.warnings.length) {
        const div = document.createElement('div');
        div.className = 'banner-warn';
        div.style.margin = '0';
        div.textContent = '⚠️ 楽天必須記載が不足 (登録時に止まります): ' + json.warnings.join(' / ');
        warnBox.appendChild(div);
      }
      return json;
    }
    document.getElementById('pi-save-btn').addEventListener('click', async () => {
      const j = await savePageInfo();
      if (j) result.textContent = j.warnings.length ? '保存しました (必須の不足あり)' : '保存しました';
    });
    document.getElementById('pi-preview-btn').addEventListener('click', async () => {
      const j = await savePageInfo();
      if (!j) return;
      const pv = document.getElementById('pi-preview');
      pv.style.display = 'block';
      // 自前生成の表HTMLのみ (入力値はサーバー側でエスケープ済み)
      pv.innerHTML = j.html || '<span class="muted">掲載する項目がまだありません</span>';
    });
    document.getElementById('pi-copy-btn').addEventListener('click', async () => {
      const j = await savePageInfo();
      if (!j) return;
      const src = document.getElementById('pi-html-src').value;
      if (!src) { result.textContent = 'コピーする内容がありません'; return; }
      try { await navigator.clipboard.writeText(src); result.textContent = 'HTMLをコピーしました'; }
      catch (e) { result.textContent = 'コピーできませんでした (手動で選択してください)'; }
    });
  })();

  // ─── 利益シミュレーション (Notion 数式の移植)。売価入力でライブ更新 ───
  (function initProfitSim() {
    const box = document.getElementById('profit-sim');
    const body = document.getElementById('profit-sim-body');
    if (!box || !body) return; // 原価/送料が無いときは静的メッセージのみ
    const cost = Number(box.dataset.cost);
    const ship = Number(box.dataset.ship);
    const tax = Number(box.dataset.tax);
    const take = Number(box.dataset.take);
    const priceInput = document.getElementById('f-price');
    function render() {
      const price = Number(priceInput.value);
      if (!Number.isFinite(price) || price <= 0) { body.textContent = '売価を入れると利益額・利益率が出ます'; return; }
      const costIncTax = cost * (1 + tax / 100);
      const profit = price * take - costIncTax - ship;
      const margin = (profit / price) * 100;
      body.textContent = '利益額 ' + Math.round(profit).toLocaleString() + '円 / 利益率 ' + margin.toFixed(1) + '%'
        + ' — 内訳: 手取り' + Math.round(price * take).toLocaleString()
        + ' − 税込原価' + Math.round(costIncTax).toLocaleString()
        + ' − 配送費' + Math.round(ship).toLocaleString();
      body.style.color = profit < 0 ? '#dc2626' : '';
      body.style.fontWeight = profit < 0 ? '600' : '';
    }
    priceInput.addEventListener('input', render);
    render();
  })();

  // 取り込みテストデータの掃除 (取り込み由来のみ。Notion 側のカードには触らない)
  const deleteDraftBtn = document.getElementById('delete-draft-btn');
  if (deleteDraftBtn) {
    deleteDraftBtn.addEventListener('click', async () => {
      if (!confirm('この取り込みドラフトをアプリから削除します。\nNotion側のカードは削除されません。\n\nよろしいですか?')) return;
      const json = await post(BASE + '/delete');
      if (json.ok) {
        location.href = '/apps/product-hub';
      } else {
        alert(json.error || '削除に失敗しました');
      }
    });
  }

  document.getElementById('save-yahoo-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/yahoo', {
      yahoo_price: document.getElementById('y-price').value,
      yahoo_price_sagawa: document.getElementById('y-price-sagawa').value,
      delivery_label: document.getElementById('y-delivery').value,
      tax_rate: document.getElementById('y-tax').value,
      yahoo_category_id: document.getElementById('y-category-id').value,
      yahoo_path: document.getElementById('y-path').value,
    }), 'Yahoo!項目を保存しました');
  });

  const saveIpBtn = document.getElementById('save-ip-btn');
  if (saveIpBtn) {
    saveIpBtn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/image-production', {
        status: document.getElementById('ip-status').value,
        importance_tier: document.getElementById('ip-tier').value,
        production_type: document.getElementById('ip-type').value,
        aplus_content: document.getElementById('ip-aplus').value,
        aplus_related: document.getElementById('ip-aplus-related').value,
        camera_instruction_url: document.getElementById('ip-camera-url').value,
        shipping_status: document.getElementById('ip-shipping').value,
        reference_collection: document.getElementById('ip-refcol').value,
        designer: document.getElementById('ip-designer').value,
        page_composer: document.getElementById('ip-composer').value,
        request_text: document.getElementById('ip-request').value,
      }), '画像制作情報を保存しました');
    });
  }

  document.getElementById('add-ref-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/refs', { url: document.getElementById('new-ref-url').value }), '追加しました');
  });

  // ─── ASIN ⇔ Amazon URL 連動 (2026-08-01 中原さん指示) ───
  // ・ASIN を入れると URL を https://www.amazon.co.jp/dp/<ASIN> で自動生成
  // ・URL が手入力されている (自動生成形式でない) 間は ASIN 不要 → グレーアウト
  (function initAsinAmazonSync() {
    const asinEl = document.getElementById('f-asin');
    const urlEl = document.getElementById('f-amazon-url');
    const noteEl = document.getElementById('f-asin-note');
    const AUTO_PREFIX = 'https://www.amazon.co.jp/dp/';
    const isAutoUrl = (url, asin) => !!asin && url === AUTO_PREFIX + asin;
    const refresh = () => {
      const url = urlEl.value.trim();
      const manualUrl = url !== '' && !isAutoUrl(url, asinEl.value.trim());
      asinEl.disabled = manualUrl;
      asinEl.style.background = manualUrl ? '#f1f5f9' : '';
      noteEl.hidden = !manualUrl;
    };
    asinEl.addEventListener('input', () => {
      const asin = asinEl.value.trim();
      const url = urlEl.value.trim();
      // ASIN が編集できている = URL は空か自動生成値 → 追従して書き換える
      if (url === '' || isAutoUrl(url, asin) || url.startsWith(AUTO_PREFIX)) {
        urlEl.value = asin ? AUTO_PREFIX + asin : '';
      }
      refresh();
    });
    urlEl.addEventListener('input', refresh);
    refresh();
  })();

  // ─── 送料・納期の固定表示 (外注マニュアル: 全商品送料無料 / 納期ID=4 固定) ───
  (function initFixedShippingDelivery() {
    const postageUnlock = document.getElementById('rk-postage-unlock');
    const postageSel = document.getElementById('rk-postage');
    postageUnlock.addEventListener('click', (e) => {
      e.preventDefault();
      if (!confirm('弊社は全商品「送料無料 (送料込み)」がルールです。\n本当に送料別へ変更できるようにしますか？')) return;
      document.getElementById('rk-postage-fixed').style.display = 'none';
      postageSel.style.display = '';
      postageSel.value = '0';
    });
    postageSel.addEventListener('change', () => {
      if (postageSel.value === '1') {  // 送料込みへ戻したら固定表示に戻す
        document.getElementById('rk-postage-fixed').style.display = '';
        postageSel.style.display = 'none';
      }
    });
    const deliveryUnlock = document.getElementById('rk-delivery-unlock');
    const deliveryInput = document.getElementById('rk-delivery-date');
    deliveryUnlock.addEventListener('click', (e) => {
      e.preventDefault();
      if (!confirm('納期情報は全商品「4: 12時までの注文で当日発送」がルールです。\n本当に別の納期IDへ変更できるようにしますか？')) return;
      document.getElementById('rk-delivery-fixed').style.display = 'none';
      deliveryInput.style.display = '';
      deliveryInput.focus();
    });
    deliveryInput.addEventListener('input', () => {
      if (deliveryInput.value.trim() === '4') {  // 既定値に戻したら固定表示へ
        document.getElementById('rk-delivery-fixed').style.display = '';
        deliveryInput.style.display = 'none';
      }
    });
  })();
  document.querySelectorAll('.del-ref-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/refs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-image-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/images', { url: document.getElementById('new-image-url').value }), '追加しました');
  });
  document.getElementById('import-folder-btn').addEventListener('click', async () => {
    const btn = document.getElementById('import-folder-btn');
    const url = document.getElementById('import-folder-url').value.trim();
    if (!url) return alert('画像フォルダのURLを入力してください');
    const currentCount = <%= images.length %>;
    if (currentCount > 0 && !confirm('現在の商品画像 ' + currentCount + ' 枚をフォルダの内容で置き換えます。よろしいですか？')) return;
    btn.disabled = true; btn.textContent = '取込中…';
    try {
      const json = await post(BASE + '/images/import-folder', { url });
      if (!json.ok) {
        const details = []
          .concat((json.conflicts || []).map((c) => '・_' + c.num + ' が複数あります: ' + c.names.join(' / ')))
          .concat((json.skipped || []).map((s) => '・' + s.name + ' — ' + s.reason));
        alert((json.error || 'エラーが発生しました') + (details.length ? '\n\n' + details.join('\n') : ''));
        return;
      }
      let msg = json.slots.length === 0
        ? '白抜き背景をセットしました (商品画像は変更していません)'
        : '画像 ' + json.slots.length + ' 枚をセットしました' + (json.whiteBg ? ' (白抜き背景もセット)' : '');
      if (json.skipped && json.skipped.length) msg += ' / 対象外 ' + json.skipped.length + ' 件';
      const warns = (json.warnings || []).slice();
      if (json.demoted) warns.push('必須項目が欠けたため、ステータスを「下書き」に戻しました: ' + json.demoted.join(' / '));
      if (warns.length) alert(msg + '\n\n⚠ ' + warns.join('\n'));
      result.textContent = msg;
      setTimeout(() => location.reload(), warns.length ? 100 : 600);
    } finally {
      btn.disabled = false; btn.textContent = 'フォルダから自動セット';
    }
  });
  document.querySelectorAll('.del-image-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/images/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-spec-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/specs', {
      spec_key: document.getElementById('new-spec-key').value,
      spec_value: document.getElementById('new-spec-value').value,
    }), '追加しました');
  });
  document.querySelectorAll('.del-spec-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/specs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('save-ai-btn').addEventListener('click', async () => {
    const areas = document.querySelectorAll('.ai-output');
    for (const ta of areas) {
      const json = await post(BASE + '/ai-outputs', { kind: ta.dataset.kind, content: ta.value });
      if (!json.ok) { alert('保存失敗 (' + ta.dataset.kind + '): ' + (json.error || '')); return; }
    }
    result.textContent = '保存しました';
    setTimeout(() => location.reload(), 600);
  });

  // 初期表示のバッジ計算 (initPageInfo 内の applyTypeVisibility でも一度呼ばれるが、
  // pi-type が無い画面状態でも必ず一度は計算しておく)
  updateTabBadges();
</script>
