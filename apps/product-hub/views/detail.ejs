  document.getElementById('import-folder-btn').addEventListener('click', async () => {
    const btn = document.getElementById('import-folder-btn');
    const url = document.getElementById('import-folder-url').value.trim();
    if (!url) return alert('画像フォルダのURLを入力してください');
    const currentCount = <%= images.length %>;
    if (currentCount > 0 && !confirm('現在の商品画像 ' + currentCount + ' 枚をフォルダの内容で置き換えます。よろしいですか？')) return;
    btn.disabled = true; btn.textContent = '取込中…';
    try {
      const json = await post(BASE + '/images/import-folder', { url });
      if (!json.ok) {
        const details = []
          .concat((json.conflicts || []).map((c) => '・' + c.label + ' が複数あります: ' + c.names.join(' / ')))
          .concat((json.skipped || []).map((s) => '・' + s.name + ' — ' + s.reason));
        alert((json.error || 'エラーが発生しました') + (details.length ? '\n\n' + details.join('\n') : ''));
        return;
      }
      let msg = json.slots.length === 0
        ? '白抜き背景をセットしました (商品画像は変更していません)'
        : '画像 ' + json.slots.length + ' 枚をセットしました' + (json.whiteBg ? ' (白抜き背景もセット)' : '');
      if (json.skuImages) {
        msg += ' ｜ SKU画像 ' + json.skuImages.matched + ' 件取込'
          + (json.skuImages.missing.length ? ' (フォルダに無いSKU: ' + json.skuImages.missing.join(', ') + ')' : '');
      }
      if (json.skipped && json.skipped.length) msg += ' / 対象外 ' + json.skipped.length + ' 件';
      const warns = (json.warnings || []).slice();
      if (json.demoted) warns.push('必須項目が欠けたため、ステータスを「下書き」に戻しました: ' + json.demoted.join(' / '));
      if (warns.length) alert(msg + '\n\n⚠ ' + warns.join('\n'));
      result.textContent = msg;
      setTimeout(() => reloadSafely(), warns.length ? 100 : 600);
    } finally {
      btn.disabled = false; btn.textContent = 'フォルダから自動セット';
    }
  });
  // ─── 白抜き画像の受信箱 (2026-09-14): 仕入先から届いた画像を選んで _00 に登録 + 商品フォルダへ移動 ───
  (function () {
    const openBtn = document.getElementById('wb-inbox-btn');
    const modal = document.getElementById('wb-inbox-modal');
    if (!openBtn || !modal) return;
    const grid = document.getElementById('wb-inbox-grid');
    const status = document.getElementById('wb-inbox-status');
    const filter = document.getElementById('wb-inbox-filter');
    const code = openBtn.dataset.code || '';
    const hasWhiteBg = openBtn.dataset.hasWhiteBg === '1';
    let items = [];
    let busy = false;
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    function render() {
      const q = filter.value.trim().toLowerCase();
      if (!items.length) { grid.innerHTML = '<div class="muted" style="padding:16px 0;">受信箱に画像がありません</div>'; return; }
      const shown = items.filter((f) => !q || (f.name + ' ' + (f.mailSubject || '')).toLowerCase().includes(q));
      if (!shown.length) { grid.innerHTML = '<div class="muted" style="padding:16px 0;">絞り込みに一致する画像がありません</div>'; return; }
      grid.innerHTML = shown.map((f) => '<button type="button" class="wb-item" data-id="' + esc(f.id) + '">'
        + '<img src="' + esc(f.thumb) + '" alt="" loading="lazy" referrerpolicy="no-referrer">'
        + '<div class="wb-name" title="' + esc(f.name) + '">' + esc(f.displayName || f.name) + '</div>'
        + '<div class="muted">' + esc(f.receivedAt || '') + (f.mailSubject ? ' ｜ ' + esc(f.mailSubject) : '') + '</div>'
        + (f.registeredFor ? '<div class="wb-reg">登録済み: ' + esc(f.registeredFor) + '</div>' : '')
        + '</button>').join('');
    }
    async function load() {
      status.textContent = '読み込み中…';
      grid.innerHTML = '';
      try {
        const res = await fetch('/apps/product-hub/api/white-bg-inbox');
        const json = await res.json();
        if (!json.ok) { status.textContent = '⚠ ' + (json.error || 'エラーが発生しました'); return; }
        items = json.files || [];
        // 受信箱が読み取り専用 (SA が閲覧者) だと、選んでも移動できず登録もされない。選ぶ前に知らせる (2026-09-18)
        const readOnly = json.writable === false;
        status.textContent = items.length + ' 枚 (新しい順)' + (json.truncated ? ' — 多すぎるため一部だけ表示しています' : '')
          + (readOnly ? ' ｜ ⚠ この受信箱から画像を動かす権限がありません。画像フォルダがある商品では、いま選んでも移動できず登録もされません (Drive で受信箱フォルダのサービスアカウントを「コンテンツ管理者」にしてください)' : '');
        status.style.color = readOnly ? '#b45309' : '';
        render();
      } catch (e) {
        status.textContent = '⚠ 読み込みに失敗しました: ' + e.message;
      }
    }
    function close() { modal.classList.remove('open'); }
    openBtn.addEventListener('click', () => {
      // タブのパネル (display:none になりうる) や overflow の影響を受けないよう body 直下に出す
      if (modal.parentElement !== document.body) document.body.appendChild(modal);
      modal.classList.add('open'); filter.value = ''; load();
    });
    document.getElementById('wb-inbox-close').addEventListener('click', close);
    document.getElementById('wb-inbox-reload').addEventListener('click', load);
    modal.addEventListener('click', (ev) => { if (ev.target === modal && !busy) close(); });
    document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && modal.classList.contains('open') && !busy) close(); });
    filter.addEventListener('input', render);
    grid.addEventListener('click', async (ev) => {
      const el = ev.target.closest('.wb-item');
      if (!el || busy) return;
      const f = items.find((x) => x.id === el.dataset.id);
      if (!f) return;
      let msg = 'この画像を「' + code + '_00 (白抜き背景)」として登録し、商品の画像フォルダへ移動します。\n\n' + f.name;
      if (hasWhiteBg) msg += '\n\n※ 今の白抜き背景は置き換わります (フォルダにある旧ファイルは「_旧<日時>」の名前で残ります)';
      if (f.registeredFor) msg += '\n\n⚠ この画像は ' + f.registeredFor + ' の白抜き背景として登録済みです。この商品にも使いますか?';
      if (!confirm(msg)) return;
      busy = true; el.disabled = true; status.textContent = '登録中…';
      try {
        const json = await post(BASE + '/white-bg/from-inbox', { fileId: f.id });
        if (!json.ok) { alert(json.error || 'エラーが発生しました'); status.textContent = ''; return; }
        const done = '白抜き背景を登録しました (' + json.name + ')' + (json.moved ? ' — 商品フォルダへ移動しました' : '');
        const warns = json.warnings || [];
        if (warns.length) alert(done + '\n\n⚠ ' + warns.join('\n'));
        result.textContent = done;
        setTimeout(() => reloadSafely(), warns.length ? 100 : 600);
      } catch (e) {
        // 通信切断・応答が JSON でない等。サーバー側では登録まで済んでいる可能性があるので、画面を読み直して確かめてもらう (Codex R1 medium)
        alert('登録の結果を確認できませんでした (' + e.message + ')。画面を読み直して、白抜きの枠と受信箱を確認してください');
        reloadSafely();
      } finally {
        busy = false; el.disabled = false;
      }
    });
  })();
  document.querySelectorAll('.del-image-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/images/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-spec-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/specs', {
      spec_key: document.getElementById('new-spec-key').value,
      spec_value: document.getElementById('new-spec-value').value,
    }), '追加しました');
  });
  document.querySelectorAll('.del-spec-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/specs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  // タイトルカードと素材カードの両方に保存ボタンがある (どちらも全 .ai-output を保存)
  document.querySelectorAll('.save-ai-btn').forEach((saveBtn) => {
    saveBtn.addEventListener('click', async () => {
      const areas = document.querySelectorAll('.ai-output');
      for (const ta of areas) {
        const json = await post(BASE + '/ai-outputs', { kind: ta.dataset.kind, content: ta.value });
        if (!json.ok) { alert('保存失敗 (' + ta.dataset.kind + '): ' + (json.error || '')); return; }
      }
      result.textContent = '保存しました';
      setTimeout(() => reloadSafely(), 600);
    });
  });

  // ─── SKU画像の紐づけ (取り込み・転送は商品画像のボタンに同乗) ───
  (function () {
    const syncBtn = document.getElementById('sku-img-sync-btn');
    if (!syncBtn) return;
    const out = document.getElementById('sku-img-result');
    syncBtn.addEventListener('click', async () => {
      if (!confirm('楽天ページの SKU画像を書き換えます (SKU画像以外は変更されません)。よろしいですか?')) return;
      syncBtn.disabled = true;
      out.textContent = '実行中…';
      try {
        const json = await post(BASE + '/rakuten/sync-sku-images', {});
        if (!json.ok) { out.textContent = ''; alert(json.error || 'エラーが発生しました'); return; }
        out.textContent = '🔗 ' + json.synced.length + ' SKU に紐づけました'
          + (json.unmatched.length ? ' / ページ側に無いSKU: ' + json.unmatched.join(', ') : '');
        setTimeout(() => reloadSafely(), 1500);
      } catch (e) {
        out.textContent = '通信エラー: ' + e.message;
      } finally { syncBtn.disabled = false; }
    });
  })();

  // 文字数カウンタ (全AI項目)。上限があるもの (楽天タイトル128 / Yahoo!タイトル65 / キャッチコピー30)
  // は「n / 上限文字」+ 超過で赤。上限なしの素材 (特徴・仕様・注意書き) は「n文字」の単純カウント
  document.querySelectorAll('.ai-output').forEach((ta) => {
    const max = ta.dataset.max ? Number(ta.dataset.max) : null;
    const lenEl = document.querySelector('.ai-len[data-for="' + ta.dataset.kind + '"]');
    const update = () => {
      const n = ta.value.length;
      if (lenEl) {
        lenEl.textContent = max ? (n + ' / ' + max + '文字') : (n + '文字');
        lenEl.style.color = max && n > max ? '#dc2626' : '';
        lenEl.style.fontWeight = max && n > max ? '700' : '';
      }
      ta.style.borderColor = max && n > max ? '#dc2626' : '';
    };
    ta.addEventListener('input', update);
    update();
  });

  // 初期表示のバッジ計算 (initPageInfo 内の applyTypeVisibility でも一度呼ばれるが、
  // pi-type が無い画面状態でも必ず一度は計算しておく)
  updateTabBadges();
  // 属性の候補ボタン (2026-08-31)。ジャンル辞書が取得済みなら開いた時点で並ぶ
  renderAttrSuggest();

  // ─── 工程パネル (誰のボールか) ───
  // 変更したその場で保存する。保存ボタン方式だと「状態だけ変えて押し忘れ」が起き、
  // ボードに古い状態が出続けるため。押し間違いは選び直せば戻せる
  (function initWorkflowPanel() {
    const card = document.getElementById('wf-card');
    if (!card) return;
    const out = document.getElementById('wf-result');
    let advanced = false;

    async function save(tr, patch) {
      const step = tr.dataset.step;
      out.textContent = '保存中…';
      try {
        // 画面を開いた時点の updated_at を一緒に送る = 古い画面からの後勝ちをサーバーが弾ける
        const body = Object.assign({ expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }, patch);
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/steps/' + encodeURIComponent(step), {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const j = await res.json();
        if (!j.ok) {
          out.textContent = '';
          alert(j.error || '保存に失敗しました');
          // 409 = 別の人が先に動かした。古い画面のまま操作を続けさせない
          if (res.status === 409) reloadSafely();
          return false;
        }
        // 連続で操作できるよう、次の楽観ロック用に最新の updated_at を持ち直す
        if (j.version != null) tr.dataset.version = String(j.version);
        out.textContent = '保存しました';
        return j;
      } catch (e) {
        out.textContent = '';
        alert('通信エラー: ' + e.message);
        return false;
      }
    }

    // ─── セット展開判断のダイアログ (2026-09-04) ───
    const decModal = document.getElementById('setdec-modal');
    let decRow = null;
    function decChoice() {
      const el = decModal ? decModal.querySelector('input[name="setdec"]:checked') : null;
      return el ? el.value : 'none';
    }
    function decSync() {
      if (!decModal) return;
      const v = decChoice();
      const noneBox = document.getElementById('setdec-none-box');
      const exBox = document.getElementById('setdec-existing-box');
      const holdBox = document.getElementById('setdec-hold-box');
      if (noneBox) noneBox.hidden = v !== 'none';
      if (exBox) exBox.hidden = v !== 'existing';
      if (holdBox) holdBox.hidden = v !== 'hold';
      const rt = document.getElementById('setdec-reason-text');
      const reason = document.getElementById('setdec-reason');
      if (rt && reason) rt.hidden = !(v === 'none' && reason.value === 'other');
    }
    function openSetDecision(tr) {
      if (!decModal) return;
      decRow = tr;
      document.getElementById('setdec-result').textContent = '';
      decSync();
      decModal.style.display = 'block';
    }
    function closeSetDecision() { if (decModal) decModal.style.display = 'none'; }
    if (decModal) {
      decModal.querySelectorAll('input[name="setdec"]').forEach((el) => el.addEventListener('change', decSync));
      const reason = document.getElementById('setdec-reason');
      if (reason) reason.addEventListener('change', decSync);
      document.getElementById('setdec-close').addEventListener('click', closeSetDecision);
      document.getElementById('setdec-cancel').addEventListener('click', closeSetDecision);
      decModal.addEventListener('click', (ev) => { if (ev.target === decModal) closeSetDecision(); });
      // セット欄の「セットは作らない／保留にする」ボタンからも開く (2026-09-06)。
      // 判断は⑤に対する操作なので版数が要る = 工程行が無ければ開かせない
      const decOpenBtn = document.getElementById('set-decision-open');
      if (decOpenBtn) {
        decOpenBtn.addEventListener('click', function () {
          const tr = document.querySelector('tr[data-step="set_review"]');
          if (!tr) { alert('工程「セット商品作成検討」が見つかりません。画面を読み直してください'); return; }
          openSetDecision(tr);
        });
      }
      // 判断そのものを取り消す (2026-09-07)。上書き (見直す) では「まだ決めていません」に戻せない。
      // 「セットを作成」を取り消すときは、まだ手つかずのセット商品もサーバー側で取り下げる
      const decUndoBtn = document.getElementById('set-decision-undo');
      if (decUndoBtn) {
        decUndoBtn.addEventListener('click', async function () {
          const tr = document.querySelector('tr[data-step="set_review"]');
          if (!tr) { alert('工程「セット商品作成検討」が見つかりません。画面を読み直してください'); return; }
          if (!confirm('いまのセット判断を取り消しますか?\n\n'
            + '・ひとつ前の判断 (無ければ「まだ決めていません」) に戻ります\n'
            + '・「セットを作成」を取り消すときは、まだ手つかずのセット商品も一緒に取り下げます\n'
            + '  (誰かが進めているセットがある場合は取り消せません)')) return;
          decUndoBtn.disabled = true;
          try {
            const r = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-decision/undo', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }),
            });
            const j = await r.json();
            if (!j.ok) { alert(j.error || '取り消せませんでした'); decUndoBtn.disabled = false; return; }
            if (j.withdrawn) alert('判断を取り消し、セット商品「' + j.withdrawn.name + '」(' + j.withdrawn.neCode + ') を取り下げました');
            reloadSafely();
          } catch (e) {
            alert('通信エラー: ' + e.message);
            decUndoBtn.disabled = false;
          }
        });
      }
      // ダイアログから「作る」へ戻る導線 (ここでは create を選ばせないため)
      const decGotoCreate = document.getElementById('setdec-goto-create');
      if (decGotoCreate) {
        decGotoCreate.addEventListener('click', function () {
          closeSetDecision();
          // 開き方は setCreateBoxOpen に集約 (関数宣言なので、この配線が走る時点で定義済み)
          setCreateBoxOpen(document.getElementById('set-create-box'), true, function (box) {
            box.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      }
      document.getElementById('setdec-apply').addEventListener('click', async () => {
        if (!decRow) return;
        const btn = document.getElementById('setdec-apply');
        const res = document.getElementById('setdec-result');
        const v = decChoice();
        const body = {
          decision: v,
          // 工程の版数を一緒に送る = 古い画面からの後勝ちをサーバーが弾く
          expected_version: decRow.dataset.version === '' ? null : Number(decRow.dataset.version),
        };
        if (v === 'none') {
          body.reason_code = document.getElementById('setdec-reason').value;
          body.reason_text = document.getElementById('setdec-reason-text').value.trim();
          if (body.reason_code === 'other' && !body.reason_text) { res.textContent = '「その他」を選んだときは一言書いてください'; return; }
        } else if (v === 'existing') {
          const sel = document.getElementById('setdec-linked');
          if (!sel || !sel.value) { res.textContent = '紐づけるセットを選んでください'; return; }
          body.linked_set_draft_id = Number(sel.value);
        } else if (v === 'hold') {
          body.reason_text = document.getElementById('setdec-hold-note').value.trim();
        }
        btn.disabled = true;
        res.textContent = '記録中…';
        try {
          const r = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-decision', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          });
          const j = await r.json();
          if (!j.ok) {
            res.textContent = '';
            alert(j.error || '記録できませんでした');
            // 409 = 別の人が先に動かした。古い画面のまま操作を続けさせない
            if (r.status === 409) reloadSafely();
            return;
          }
          reloadSafely();
        } catch (e) {
          res.textContent = '';
          alert('通信エラー: ' + e.message);
        } finally { btn.disabled = false; }
      });
    }

    card.querySelectorAll('tr[data-step]').forEach(function (tr) {
      const state = tr.querySelector('.wf-state');
      const assignee = tr.querySelector('.wf-assignee');
      const due = tr.querySelector('.wf-due');
      const note = tr.querySelector('.wf-note');
      if (state) {
        state.addEventListener('change', async function () {
          // 「セット展開判断」は判断を記録してからでないと閉じられない (2026-09-04)。
          // ここで捕まえて判断ダイアログを開く (記録できたら工程もサーバー側で閉じる)
          if (tr.dataset.step === 'set_review' && state.value === 'done') {
            state.value = tr.dataset.prevState || 'todo';
            openSetDecision(tr);
            return;
          }
          const r = await save(tr, { state: state.value });
          // 完了で次の工程へボールが移る・工程からステータスが導出し直される (PR4) と
          // 上部の表示が変わるので読み直す。連続で複数工程を片付けたい場合もあるので、
          // 少し待ってから 1 回だけ
          const statusChanged = r && r.draftStatus && r.draftStatus !== '<%= draft.status %>';
          if (r && (state.value === 'done' || statusChanged) && !advanced) {
            advanced = true;
            setTimeout(function () { reloadSafely(); }, 900);
          }
        });
      }
      if (assignee) {
        assignee.addEventListener('change', function () { save(tr, { assignee_id: assignee.value }); });
      }
      // 未割り当ての工程を自分で引き受ける (admin 以外はこのボタンだけ)
      const claim = tr.querySelector('.wf-claim');
      if (claim) {
        claim.addEventListener('click', async function () {
          claim.disabled = true;
          const ok = await save(tr, { assignee_id: <%= myStaffId == null ? 'null' : myStaffId %> });
          if (ok) reloadSafely(); else claim.disabled = false;
        });
      }
      if (due) due.addEventListener('change', function () { save(tr, { due_date: due.value }); });
      if (note) note.addEventListener('change', function () { save(tr, { note: note.value }); });
    });

    // 「詳細画像は対象外」トグル (商品単位のフラグ。工程行は書き換えない)
    const exBtn = document.getElementById('wf-detail-excluded');
    if (exBtn) {
      exBtn.addEventListener('click', async function () {
        const next = exBtn.dataset.next === 'true';
        if (next && !confirm('この商品は詳細画像を作らない (TOP画像だけで出品ゲートを開く) 設定にします。よろしいですか?')) return;
        exBtn.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/detail-images-excluded', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ excluded: next }),
          });
          const j = await res.json();
          if (!j.ok) { alert(j.error || '切り替えに失敗しました'); exBtn.disabled = false; return; }
          reloadSafely();
        } catch (e) { alert('通信エラー: ' + e.message); exBtn.disabled = false; }
      });
    }

    // ─── モール別の展開状況 ───
    const mlOut = document.getElementById('ml-result');
    async function saveMall(tr, patch) {
      const mall = tr.dataset.mall;
      mlOut.textContent = '保存中…';
      try {
        const body = Object.assign(
          { expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }, patch);
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/malls/' + encodeURIComponent(mall), {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const j = await res.json();
        if (!j.ok) {
          mlOut.textContent = '';
          alert(j.error || '保存に失敗しました');
          if (res.status === 409) reloadSafely();
          return false;
        }
        if (j.version != null) tr.dataset.version = String(j.version);
        mlOut.textContent = '保存しました';
        // 全モールが決着すると工程「出品・展開」が閉じる → 上部の表示が変わるので読み直す
        if (j.listingCompleted) setTimeout(function () { reloadSafely(); }, 900);
        return true;
      } catch (e) {
        mlOut.textContent = '';
        alert('通信エラー: ' + e.message);
        return false;
      }
    }
    document.querySelectorAll('tr[data-mall]').forEach(function (tr) {
      const st = tr.querySelector('.ml-state');
      const asg = tr.querySelector('.ml-assignee');
      const note = tr.querySelector('.ml-note');
      const claim = tr.querySelector('.ml-claim');
      if (st) st.addEventListener('change', function () { saveMall(tr, { state: st.value }); });
      if (asg) asg.addEventListener('change', function () { saveMall(tr, { assignee_id: asg.value }); });
      if (note) note.addEventListener('change', function () { saveMall(tr, { note: note.value }); });
      if (claim) {
        claim.addEventListener('click', async function () {
          claim.disabled = true;
          const ok = await saveMall(tr, { assignee_id: <%= myStaffId == null ? 'null' : myStaffId %> });
          if (ok) reloadSafely(); else claim.disabled = false;
        });
      }
    });

    // ─── セット商品 ───
    // 構成は複数行 (§5.6)。行 = 商品コード × 個数。既定は「この商品 × 2」
    const setMembersBox = document.getElementById('set-members');
    function addMemberRow(code, qty) {
      if (!setMembersBox) return;
      const row = document.createElement('div');
      row.className = 'set-member-row';
      row.style.cssText = 'display:flex; gap:6px; align-items:center;';
      const codeInput = document.createElement('input');
      codeInput.type = 'text';
      codeInput.className = 'set-member-code';
      codeInput.setAttribute('list', 'set-member-codes');
      codeInput.placeholder = '商品コード';
      codeInput.maxLength = 100;
      codeInput.value = code || '';
      codeInput.style.cssText = 'flex:1; min-width:160px;';
      const qtyInput = document.createElement('input');
      qtyInput.type = 'number';
      qtyInput.className = 'set-member-qty';
      qtyInput.min = '1';
      qtyInput.max = '999';
      qtyInput.value = String(qty || 1);
      qtyInput.style.cssText = 'flex:0 0 80px;';
      const unit = document.createElement('span');
      unit.className = 'muted';
      unit.style.cssText = 'font-size:12px;';
      unit.textContent = '個';
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn-sm';
      del.textContent = '✕';
      del.title = 'この行を消す';
      // 最後の1行は消せない (構成が空のセットは作れない)。消せるかは押した時点で数える
      del.addEventListener('click', function () {
        if (setMembersBox.querySelectorAll('.set-member-row').length <= 1) return;
        row.remove();
      });
      row.appendChild(codeInput);
      row.appendChild(qtyInput);
      row.appendChild(unit);
      row.appendChild(del);
      setMembersBox.appendChild(row);
    }
    /** 開いた時点の初期状態: 「この商品 × 2」の1行 + 「行を追加」の配線 */
    function initSetMembers(parentCode) {
      if (!setMembersBox) return;
      addMemberRow(parentCode, 2);
      const addBtn = document.getElementById('set-member-add');
      if (addBtn) addBtn.addEventListener('click', function () { addMemberRow('', 1); });
    }
    /** 画面の行 → API に送る構成。空行は落とす (人が行を足して埋めなかった場合) */
    function readSetMembers() {
      if (!setMembersBox) return [];
      const out = [];
      const rows = setMembersBox.querySelectorAll('.set-member-row');
      for (const r of rows) {
        const code = (r.querySelector('.set-member-code').value || '').trim();
        const qty = Number(r.querySelector('.set-member-qty').value);
        if (!code) continue;
        out.push({ ne_code: code, qty: qty });
      }
      return out;
    }
    <%# ここまでが smoke の切り出し範囲 (EJS の埋め込みを混ぜない — 素の JS として動かすため)。
        HTMLエスケープした値を JS 文字列に入れない (Codex low): `'` を含む商品コードが
        `&#39;` という別のコードになって単価が引けなくなる。JSON で埋めて `<` だけ潰す %>
    initSetMembers(<%- JSON.stringify(draft.ne_code || '').replace(/</g, '\\u003c') %>);

    async function createSet(mode) {
      const out = document.getElementById('set-create-result');
      const members = readSetMembers();
      if (members.length === 0) { out.textContent = '構成を1行以上入れてください'; return; }
      // 個数はサーバーでも弾くが、押した瞬間に理由が出るほうが直しやすい
      const badQty = members.find(function (m) { return !Number.isInteger(m.qty) || m.qty < 1 || m.qty > 999; });
      if (badQty) { out.textContent = '「' + badQty.ne_code + '」の個数を 1〜999 で入れてください'; return; }
      const label = mode === 'ai' ? 'AIに書き換えてもらう' : 'コピーしてすぐ直す';
      const compo = members.map(function (m) { return m.ne_code + '×' + m.qty; }).join(' + ');
      if (!confirm('この商品からセット商品を作ります (' + label + ')。\n構成: ' + compo
        + '\n商品コードは仮コードになります。\n\nよろしいですか?')) return;
      const btns = [document.getElementById('set-ai-btn'), document.getElementById('set-copy-btn')];
      btns.forEach(function (b) { b.disabled = true; });
      out.textContent = '作成中…';
      try {
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-drafts', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: mode, name: document.getElementById('set-name').value,
            members: members,
            // 親の「セット商品作成検討」を閉じる操作なので、その工程の版数を添える
            // 🚨 JS の値の位置にテンプレートの出力タグを直に置かない。セット商品 (子) の
            // workflow.main は set トラックだけで set_review が無く、undefined = 空文字が出て
            // `parent_step_version: ,` という構文エラーになり、この画面の JS が丸ごと死んでいた
            // (2026-09-07 中原さん「本コードに差し替える が押せない」)。JSON にして埋める
            parent_step_version: <%- JSON.stringify(((workflow.main || []).find((s) => s.step_code === 'set_review') || {}).version ?? null) %>,
          }),
        });
        const j = await res.json();
        if (!j.ok) { out.textContent = ''; alert(j.error || '作成に失敗しました'); btns.forEach(function (b) { b.disabled = false; }); return; }
        out.textContent = j.neCode + ' を作りました。開きます…';
        setTimeout(function () { location.href = '/apps/product-hub/detail/' + j.draftId; }, 800);
      } catch (e) {
        out.textContent = '';
        alert('通信エラー: ' + e.message);
        btns.forEach(function (b) { b.disabled = false; });
      }
    }
    const setAiBtn = document.getElementById('set-ai-btn');
    if (setAiBtn) setAiBtn.addEventListener('click', function () { createSet('ai'); });
    const setCopyBtn = document.getElementById('set-copy-btn');
    if (setCopyBtn) setCopyBtn.addEventListener('click', function () { createSet('copy'); });

    <%# ここから smoke の切り出し範囲 (セット欄の開閉)。EJS の埋め込みを混ぜない
        — 素の JS として vm で動かし、開く・閉じる・ダイアログから開くを実際に押して確かめる %>
    // 「🎁 セットを作る」= 中身の入力欄を開く (2026-09-06)。details の summary では
    // 「作らない」ボタンと大きさが揃わず、押せる場所に見えなかったので開閉ボタンにした。
    // 開き方は 3 経路 (ボタン・閉じる・判断ダイアログ) あるので 1 か所に集める
    function setCreateBoxOpen(box, open, onOpen) {
      if (!box) return;
      box.hidden = !open;
      if (open && typeof onOpen === 'function') onOpen(box);
    }
    function wireSetCreateToggle(doc, onOpen) {
      const box = doc.getElementById('set-create-box');
      const openBtn = doc.getElementById('set-create-open');
      const cancelBtn = doc.getElementById('set-create-cancel');
      if (!box) return null;
      if (openBtn) {
        openBtn.addEventListener('click', function () { setCreateBoxOpen(box, box.hidden, onOpen); });
      }
      if (cancelBtn) cancelBtn.addEventListener('click', function () { setCreateBoxOpen(box, false); });
      return box;
    }
    <%# ここまでがセット欄の開閉の切り出し範囲 %>
    wireSetCreateToggle(document, function (box) {
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // 仮コード → 本コードの差し替え
    const setCodeBtn = document.getElementById('set-code-btn');
    if (setCodeBtn) {
      setCodeBtn.addEventListener('click', async function () {
        const out = document.getElementById('set-code-result');
        const code = document.getElementById('set-code-input').value.trim();
        if (!code) { out.textContent = '商品コードを入れてください'; return; }
        setCodeBtn.disabled = true;
        out.textContent = '差し替え中…';
        async function post(confirmFlag) {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-code', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ne_code: code, confirm: confirmFlag === true }),
          });
          return { status: res.status, json: await res.json() };
        }
        try {
          const r = await post(false);
          if (!r.json.ok) { out.textContent = ''; alert(r.json.error || '差し替えに失敗しました'); setCodeBtn.disabled = false; return; }
          // NE に見つからないコードでも差し替えは通す。ただし出品ゲートは閉じたままなので、
          // その旨をはっきり伝える (黙って通すと「出せるはず」と思われる)
          if (r.json.inNe === false) {
            alert('差し替えました。ただしNE商品マスタにまだ見つかりません。'
              + '\n取り込まれるまで楽天には出品できません (この画面を開いたときに自動で解除されます)。');
          }
          out.textContent = '差し替えました';
          setTimeout(function () { reloadSafely(); }, 800);
        } catch (e) {
          out.textContent = '';
          alert('通信エラー: ' + e.message);
          setCodeBtn.disabled = false;
        }
      });
    }

    // 画像の引き継ぎ計画 (§4.7)。表の行をまとめて置き換える
    const sipSave = document.getElementById('sip-save');
    if (sipSave) {
      sipSave.addEventListener('click', async function () {
        const out = document.getElementById('sip-result');
        const items = [...document.querySelectorAll('#set-image-plan tbody tr')].map(function (tr) {
          return {
            slot: Number(tr.dataset.slot),
            action: tr.querySelector('.sip-action').value,
            instruction: tr.querySelector('.sip-instruction').value.trim(),
          };
        });
        sipSave.disabled = true;
        out.textContent = '保存中…';
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-image-plan', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items }),
          });
          const j = await res.json();
          if (!j.ok) { out.textContent = ''; alert(j.error || '保存できませんでした'); sipSave.disabled = false; return; }
          out.textContent = '保存しました';
          setTimeout(function () { reloadSafely(); }, 600);
        } catch (e) {
          out.textContent = ''; alert('通信エラー: ' + e.message); sipSave.disabled = false;
        }
      });
    }

    // 配送方法: NE の候補を1クリックで入れる (2026-09-05)。押すまでは未選択のまま
    const shipUseNe = document.getElementById('rk-ship-use-ne');
    if (shipUseNe) {
      shipUseNe.addEventListener('click', function () {
        const sel = document.getElementById('rk-shipping-group');
        if (!sel) return;
        sel.value = shipUseNe.dataset.group || '';
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }

    // NE登録の進み (§4.3)。「依頼した」「登録できなかった (理由)」「再要求」
    document.querySelectorAll('.ne-state-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        const state = btn.dataset.state;
        let reason = null;
        if (state === 'needs_action') {
          reason = prompt('登録できなかった理由を入れてください（例: 商品コードが重複していた）');
          if (reason === null) return;
          if (!reason.trim()) { alert('理由を入れてください'); return; }
        }
        btn.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/ne-registration', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ state: state, reason: reason }),
          });
          const j = await res.json();
          if (j.ok) reloadSafely();
          else { alert(j.error || '更新できませんでした'); btn.disabled = false; }
        } catch (e) { alert('通信エラー: ' + e.message); btn.disabled = false; }
      });
    });

    // 親の更新を確認した (§4.5)。覚え直すだけ — セットには自動で反映しない
    const parentAck = document.getElementById('parent-ack-btn');
    if (parentAck) {
      parentAck.addEventListener('click', async function () {
        parentAck.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/parent-snapshot-ack', { method: 'POST' });
          const j = await res.json();
          if (j.ok) reloadSafely();
          else { alert(j.error || '更新できませんでした'); parentAck.disabled = false; }
        } catch (e) { alert('通信エラー: ' + e.message); parentAck.disabled = false; }
      });
    }
  })();
  // ─── 未保存の入力を「読み直し」で失わせない (2026-09-21 中原さん) ───────────────
  // この画面は保存の流儀が 3 つ混ざっている:
  //   ①即保存   … SKU別売価・画像の重要度・自社商品チェック (触った時点で DB へ)
  //   ②自動保存 … 商品情報タブ (入力停止 1 秒 + 離脱時ビーコン)
  //   ③明示保存 … 基本情報 / カテゴリ・属性 / Yahoo!項目 (**ボタンを押すまで DB に行かない**)
  // そこへ読み直し (location.reload) が 30 箇所あり、③の欄に打った値だけが黙って消えていた。
  //   例: 売価を打つ → 「セット商品にする?」を記録 → 読み直しで売価が空に戻る (2026-09-21 中原さん)
  // 🚨 引き金 (読み直す操作) を 1 つずつ塞ぐやり方は必ず数え漏らす。関所は**読み直す側**に
  //    1 本だけ置く: reloadSafely() が未保存を sessionStorage へ退避し、読み直した後に書き戻す。
  // 🚨 退避するだけで**保存はしない**。勝手に保存すると、楽天の全量 upsert が持つ
  //    「画面を開いたときの値」(shipping_method_group_prev / model_conflict_seen) を
  //    人の意図と関係なく進めてしまう。値を戻して見せるところまでが仕事で、押すのは人。
  // 🚨 ここから「未保存ガード」の切り出し範囲 — smoke が **描画ではなくこの素の JS** を
  //    vm で動かして、打った値が読み直しで戻るところまで確かめる。
  //    EJS の埋め込み (<%= %>) をこの範囲に入れない (入れると素の JS として動かせなくなる)
  function initUnsavedGuard(KEY) {
    // 退避する欄 = ③明示保存の**固定**入力欄だけ。①②の欄は消えないので入れない。
    // 🚨 動的に増減する行 (商品属性の表・店舗内カテゴリの並び) はこの版では対象外
    //    (行が増減すると「どの行に戻すか」が決まらない)。SKU表は①即保存なので消えない。
    //   route   … どの保存経路で DB に行くか (その経路が通ったら「保存済み」を進める)
    //   button  … 未保存の印を出すボタン (その欄が見えているタブのもの)
    //   restore … false なら**書き戻さない** (印と離脱の警告だけ)。
    //     🚨 値を戻すだけでは画面のほかの状態と食い違う欄がある (Codex R1):
    //        配送方法 … ヤフー別扱い (yahooOverrideOn) は change でしか動かない
    //        送料込み・納期 … ふだんは固定表示で、解除したときだけ選べる
    //        画像タブの商品情報 … 「自動のまま/手入力」の印 (data-edited) は入力でしか立たない
    //        Yahoo!の配送方法 … 配送方法の連動で書き換わる
    //      戻すと噛み合わないまま保存されるので、戻さずに「未保存です」とだけ知らせる
    //   refresh … 書き戻した後に input を出す欄。**自分の表示だけ**を描き直すものに限る
    //     🚨 ほかの欄を書き換えるハンドラ (ASIN → Amazon URL) を走らせない (Codex R1)。
    //        競合で守ったはずの欄が、別の欄の復元で上書きされてしまう
    const FIELDS = [
      // 「基本情報を保存」(基本情報 API)
      { id: 'f-name', label: '商品名', route: 'basic', button: 'save-basic-btn' },
      { id: 'f-official-url', label: '公式ページURL', route: 'basic', button: 'save-basic-btn' },
      { id: 'f-price', label: '売価', route: 'basic', button: 'save-basic-btn', refresh: true },
      { id: 'y-tax', label: '税率', route: 'basic', button: 'save-basic-btn' },
      { id: 'f-asin', label: 'ASIN', route: 'basic', button: 'save-basic-btn' },
      { id: 'f-amazon-url', label: 'Amazon URL', route: 'basic', button: 'save-basic-btn' },
      { id: 'f-has-variation', label: 'バリエーションあり', route: 'basic', button: 'save-basic-btn' },
      { id: 'f-memo', label: 'メモ', route: 'basic', button: 'save-basic-btn' },
      // 配送・送料・納期は楽天の項目だが基本情報タブにある (「基本情報を保存」が一緒に送る)
      { id: 'rk-shipping-group', label: '配送方法', route: 'rakuten', button: 'save-basic-btn', restore: false },
      { id: 'rk-postage', label: '送料込み', route: 'rakuten', button: 'save-basic-btn', restore: false },
      { id: 'rk-delivery-date', label: '納期', route: 'rakuten', button: 'save-basic-btn', restore: false },
      // 「カテゴリ・属性を保存」/「出品情報を保存」(楽天 API)
      { id: 'rk-genre', label: 'ジャンルID', route: 'rakuten', button: 'rk-save-btn-cat' },
      { id: 'rk-variant-selector', label: 'バリエーションの項目名', route: 'rakuten', button: 'rk-save-btn-cat' },
      { id: 'rk-catalog-exemption', label: 'カタログIDなしの理由', route: 'rakuten', button: 'rk-save-btn-cat' },
      { id: 'rk-article', label: 'メーカー型番', route: 'rakuten', button: 'rk-save-btn-cat' },
      // 🚨 戻さない: 「IDあり/IDなし」のラジオと入力枠の出し分けは DB の値のまま描かれるので、
      //    値だけ戻すと**画面に出ていない JAN が次の保存で送られる** (Codex R2)
      { id: 'f-jan', label: 'JANコード', route: 'jan', button: 'rk-save-btn-cat', restore: false },
      { id: 'rk-whitebg', label: '白抜き背景画像', route: 'rakuten', button: 'rk-save-btn' },
      // 「Yahoo!項目を保存」(Yahoo API)
      { id: 'y-price', label: 'Yahoo!売価', route: 'yahoo', button: 'save-yahoo-btn' },
      { id: 'y-price-sagawa', label: 'Yahoo!売価 (佐川)', route: 'yahoo', button: 'save-yahoo-btn' },
      { id: 'y-delivery', label: '配送方法 (Yahoo!)', route: 'yahoo', button: 'save-yahoo-btn', restore: false },
      { id: 'y-category-id', label: 'Yahoo!カテゴリID', route: 'yahoo', button: 'save-yahoo-btn' },
      { id: 'y-path', label: 'Yahoo!path', route: 'yahoo', button: 'save-yahoo-btn' },
      // 「画像制作情報を保存」(image-production API)
      { id: 'ip-status', label: '画像制作の状態', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-tier', label: '重要度ランク', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-type', label: '制作タイプ', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-aplus', label: 'A+コンテンツ', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-aplus-related', label: 'A+の関連商品', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-camera-url', label: '撮影指示URL', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-refcol', label: '参考コレクション', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-designer', label: 'デザイナー', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-composer', label: 'ページ構成', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-request', label: '制作依頼の文面', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-canva-url', label: 'Canva URL', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-top-compose', label: 'TOP画像の構成', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-top-ref-url', label: 'TOP画像の参考URL', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-material', label: '素材の状態', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-back-info', label: '裏面情報', route: 'image', button: 'save-ip-btn' },
      { id: 'ip-product-info', label: '画像タブの商品情報', route: 'image', button: 'save-ip-btn', restore: false },
    ];
    // これより古い退避は使わない (読み直しが途中で流れて、だいぶ経ってから値が現れるのを防ぐ)
    const MAX_AGE_MS = 30 * 60 * 1000;

    const readValue = (el) => (el.type === 'checkbox' ? (el.checked ? '1' : '0') : String(el.value == null ? '' : el.value));
    function writeValue(el, v) {
      if (el.type === 'checkbox') el.checked = (v === '1');
      else el.value = v;
    }

    const tracked = [];
    for (const f of FIELDS) {
      const el = document.getElementById(f.id);
      if (!el) continue;   // その商品では出ていない欄 (固定表示・SKU表へ寄せた欄) は追わない
      const panel = el.closest('.tab-panel');
      tracked.push({ restore: true, refresh: false, ...f, el, tab: panel ? panel.id : null, saved: readValue(el) });
    }
    const dirty = () => tracked.filter((f) => readValue(f.el) !== f.saved);
    let armed = false;   // reloadSafely が始めた読み直しの最中か (取り消されたら下ろす)
    let armedInflight = {};   // その読み直しで応答を待っていた欄 (id → 送った値)

    // ── 印 (ボタンの横・タブ) ──
    const marks = new Map();
    for (const f of tracked) {
      if (marks.has(f.button)) continue;
      const btn = document.getElementById(f.button);
      if (!btn) continue;
      const span = document.createElement('span');
      span.className = 'unsaved-mark';
      span.textContent = '● 未保存';
      btn.insertAdjacentElement('afterend', span);
      marks.set(f.button, span);
    }
    const tabMarks = new Map();
    document.querySelectorAll('#tabbar .tab-btn').forEach((b) => {
      const span = document.createElement('span');
      span.className = 'tab-unsaved';
      span.textContent = '●';
      span.title = '未保存の入力があります';
      b.appendChild(span);
      tabMarks.set(b.dataset.tab, span);
    });
    function paint() {
      const ds = dirty();
      const buttons = new Set(ds.map((f) => f.button));
      const tabs = new Set(ds.map((f) => f.tab).filter(Boolean));
      for (const [id, span] of marks) span.classList.toggle('on', buttons.has(id));
      for (const [id, span] of tabMarks) span.classList.toggle('on', tabs.has(id));
    }
    // 🚨 読み直しをやめて編集を続けた = さっき退避した分はもう要らない (Codex R3)。
    //    残したままだと「値を元に戻してから自分で再読み込み」した人に、取り消した入力が復活する
    function onTouch() {
      if (armed) { armed = false; mute = false; forget(); }
      paint();
    }
    for (const f of tracked) {
      f.el.addEventListener('input', onTouch);
      f.el.addEventListener('change', onTouch);
    }

    // ── 退避 / 書き戻し ──
    const forget = () => { try { sessionStorage.removeItem(KEY); } catch (_) { /* 使えない環境は諦める */ } };
    /**
     * いまの未保存を退避に書く。
     * @param {Object<string,string>} inflight 応答を待っている欄 (id → 送った値)。
     *   🚨 この欄は**画面の値が基準と同じでも退避する** (Codex R2)。DB が送った値に
     *   変わっているかもしれず、退避しないと黙ってその値に戻ってしまう
     * @returns {boolean} 戻せない欄を残さず書けたか
     */
    /**
     * 「送った値が保存されると DB はこうなるはず」の候補。
     * 🚨 サーバーの正規化 (trim・整数への丸め) を画面で完全には再現できない (Codex R3)。
     *    ここは**当てにいく**だけで、外したときは「戻さずに、打っていた内容を見せる」に倒れる
     *    (黙って上書きする方向には倒さない)
     */
    function sentCandidates(v) {
      const raw = String(v == null ? '' : v);
      const out = [raw];
      const t = raw.trim();
      if (out.indexOf(t) < 0) out.push(t);
      const n = Number(t);
      if (t !== '' && Number.isFinite(n)) {
        const rounded = String(Math.round(n));
        if (out.indexOf(rounded) < 0) out.push(rounded);
      }
      return out;
    }
    function writeStash(inflight) {
      const sending = inflight || {};
      const isSending = (id) => Object.prototype.hasOwnProperty.call(sending, id);
      const all = dirty();
      const blocked = all.filter((f) => !f.restore).length;
      const ds = all.filter((f) => f.restore)
        .concat(tracked.filter((f) => f.restore && isSending(f.id) && all.indexOf(f) < 0));
      // 🚨 戻せない欄 (restore:false) の未保存が残っているときは false。
      //    「退避した」と言い切ると、消える欄があるのに警告まで消してしまう
      if (!ds.length) { forget(); return blocked === 0; }
      // base = 「これなら自分の変更」と言える DB の値の候補。書き戻す前にこれと照合する。
      // 応答待ちの欄は**送った値も候補**に入れる (どちらとも違えば、ほかの人が変えたということ)
      const data = { at: Date.now(), values: {}, base: {} };
      for (const f of ds) {
        data.values[f.id] = readValue(f.el);
        const cands = [f.saved];
        if (isSending(f.id)) cands.push(...sentCandidates(sending[f.id]));
        data.base[f.id] = cands;
      }
      try { sessionStorage.setItem(KEY, JSON.stringify(data)); } catch (_) { return false; }
      return blocked === 0;
    }
    /**
     * 読み直しの前に呼ぶ。ここで一度書くのは、**退避できるかをその場で確かめる**ため
     * (容量不足・戻せない欄が残るなら、離脱の警告を消さずに読み直す)。
     * 🚨 中身は出ていく瞬間 (pagehide) に書き直す (Codex R3)。読み込みの応答が遅れても
     *    退避は消えず、その間に打ち直した分まで残る。時間では「取り消し」と「待ち」を区別できない
     * @returns {boolean} 未保存を失わずに読み直せるか
     */
    function stash(opts) {
      armed = true;
      armedInflight = (opts && opts.inflight) || {};
      return writeStash(armedInflight);
    }
    function restore() {
      let data = null;
      try {
        const raw = sessionStorage.getItem(KEY);
        if (raw) data = JSON.parse(raw);
      } catch (_) { data = null; }
      // 🚨 読んだら必ず消す。戻し損ねた分が残り続けると、あとで開いた人に古い値が突然現れる
      forget();
      if (!data || !data.values) return;
      if (typeof data.at !== 'number' || Date.now() - data.at > MAX_AGE_MS) return;
      // 🚨 先に**全部**の可否を決めてから書く (Codex R1)。書きながら決めると、
      //    片方を戻したときに走るハンドラが、もう片方の判定より先に値を書き換える
      const plan = [], conflicted = [];
      for (const f of tracked) {
        if (!f.restore) continue;
        const v = data.values[f.id];
        if (v === undefined) continue;
        if (v === f.saved) continue;   // 読み直した DB の値と同じ = もう保存されている
        const base = data.base ? data.base[f.id] : undefined;
        // 候補は配列 (元の値と、応答を待っていた欄は送った値)。どれとも違えば、
        // 🚨 退避のあいだに**ほかの人**が変えたということなので戻さない (黙って隠さない)
        const cands = base === undefined ? undefined : (Array.isArray(base) ? base : [base]);
        if (cands !== undefined && cands.indexOf(f.saved) < 0) { conflicted.push({ label: f.label, value: v }); continue; }
        plan.push({ f, v });
      }
      for (const p of plan) writeValue(p.f.el, p.v);
      // 表示の描き直しは、**自分の欄だけ**を直すものに限って後から出す
      for (const p of plan) { if (p.f.refresh) p.f.el.dispatchEvent(new Event('input', { bubbles: true })); }
      if (plan.length || conflicted.length) showBanner(plan.map((p) => p.f), conflicted);
      paint();
    }

    const zone = document.getElementById('unsaved-zone');
    function showBanner(restored, conflicted) {
      if (!zone) return;
      zone.replaceChildren();
      const box = document.createElement('div');
      box.className = 'unsaved-banner';
      const lines = [];
      if (restored.length) lines.push('保存前だった入力を戻しました: ' + restored.map((f) => f.label).join('・'));
      if (conflicted.length) {
        lines.push('⚠️ ほかの人が先に変えていたため戻さなかった項目: '
          + conflicted.map((c) => c.label).join('・'));
      }
      for (const text of lines) {
        const row = document.createElement('div');
        row.textContent = text;
        box.appendChild(row);
      }
      // 🚨 戻さなかった項目は、**打っていた内容を全文**残す (Codex R3)。
      //    退避は 1 回で使い切るので、ここで切り詰めると商品名・メモの続きが二度と拾えない
      for (const c of conflicted) {
        const det = document.createElement('details');
        const sum = document.createElement('summary');
        sum.style.cssText = 'cursor:pointer; font-size:12px; margin-top:4px;';
        sum.textContent = c.label + ' — 打っていた内容を見る (コピーして貼り直せます)';
        const ta = document.createElement('textarea');
        ta.readOnly = true;
        ta.rows = 3;
        ta.style.cssText = 'width:100%; margin-top:4px; font-size:12px;';
        ta.value = String(c.value == null ? '' : c.value);
        det.appendChild(sum);
        det.appendChild(ta);
        box.appendChild(det);
      }
      const note = document.createElement('div');
      note.style.cssText = 'margin-top:4px; font-size:11.5px;';
      note.textContent = 'まだ保存されていません。内容を確かめて、いつもの保存ボタンを押してください。';
      box.appendChild(note);
      if (restored.length) {
        const undo = document.createElement('button');
        undo.type = 'button';
        undo.className = 'btn btn-sm';
        undo.style.marginTop = '6px';
        undo.textContent = '戻さない (読み直した内容のままにする)';
        undo.addEventListener('click', () => {
          for (const f of restored) writeValue(f.el, f.saved);
          for (const f of restored) { if (f.refresh) f.el.dispatchEvent(new Event('input', { bubbles: true })); }
          zone.replaceChildren();
          paint();
        });
        box.appendChild(undo);
      }
      zone.appendChild(box);
    }

    // ── 画面を離れるときの警告 ──
    // 読み直し (reloadSafely) は退避できたときだけ警告を止める。
    // タブを閉じる・別のページへ行く場合は sessionStorage ごと失われるので必ず警告する
    let mute = false;
    // 🚨 退避は「実際に出ていく瞬間の入力」と合わせる (Codex R3)。
    //    reloadSafely が始めた読み直しのときだけ書き直す — ふつうの離脱 (タブを閉じる・
    //    別のページへ行く) では退避しない。警告を見たうえで出ていくのは、捨てる意思だから
    window.addEventListener('pagehide', () => {
      if (!armed) return;
      try { writeStash(armedInflight); } catch (_) { /* 出ていく途中なので、書けなければそのまま */ }
    });
    window.addEventListener('beforeunload', (ev) => {
      if (mute || !dirty().length) return;
      ev.preventDefault();
      ev.returnValue = '';
    });

    const api = {
      stash,
      mute: () => { mute = true; },
      // 🚨 保存を**送る直前**に呼んで、送った値を控える (Codex R1)。応答が返ってから
      //    画面の値を読むと、通信中に打ち直された分まで「保存済み」にしてしまう
      //    ids = 経路に属さないが、その保存でいっしょに送る欄 (Yahoo!保存の税率など)
      saving: (routes, ids) => tracked
        .filter((f) => routes.indexOf(f.route) >= 0 || (ids ? ids.indexOf(f.id) >= 0 : false))
        .map((f) => ({ f, v: readValue(f.el) })),
      // 🚨 保存が通ったら控えた値まで基準を進める。ここを忘れると、次の読み直しで
      //    「自分が保存した値」を他人の変更と誤判定して、打ち直した分を捨てる (Codex R1)
      saved: (snap) => { if (!snap) return; for (const s of snap) s.f.saved = s.v; paint(); },
      // 値が分かっている 1 欄ぶん (JAN のように専用の保存経路を持つ欄)
      savedValue: (id, v) => { for (const f of tracked) { if (f.id === id) f.saved = String(v == null ? '' : v); } paint(); },
      dirtyLabels: () => dirty().map((f) => f.label),
    };
    restore();
    paint();
    return api;
  }
  // ここまでが「未保存ガード」の切り出し範囲
  phKeep = initUnsavedGuard('ph-unsaved:<%= draft.id %>');

  // ─── 基本情報の即保存 (2026-09-21 中原さん「もっと根本解決ないの?」) ──────────────
  // 明示保存の欄は「ボタンを押すまで DB に行かない」ので、読み直しで消える事故が起きていた
  // (#1397 で退避と書き戻しを入れた)。ここでは**未保存でいる時間そのもの**を短くする:
  // 入力を確定した時点 (change) で、その欄だけを送る。サーバーは送られたキーだけ更新し、
  // 送らなかったキーは既存値のまま (部分保存)。
  // 🚨 公式ページURL・Amazon URL は即保存にしない。空にした瞬間に AI 生成のゲートが壊れて
  //    「基本情報入力」工程が自動で差し戻される — URL の打ち替えは「消す → 入れ直す」の
  //    2 手なので、途中の 1 手のたびに差し戻されてしまう。この 2 欄はボタンで保存する
  // 🚨 バリエーションのチェックも即保存にしない (NE が判定できる商品では送らない、という
  //    出し分けがあり、ここだけ別経路で送ると DB に焼いてしまう)
  // ここに無い欄 (配送方法・ジャンル・Yahoo!項目・画像制作情報) は従来どおりボタン保存で、
  // 打ちっぱなしのまま読み直しても #1397 の関所が退避して書き戻す
  // 🚨 ここから「基本情報の即保存」の切り出し範囲 — テストが**描画ではなくこの素の JS** を
  //    vm で動かして、確定した欄が送られること・失敗しても打った値を戻さないことを確かめる。
  //    EJS の埋め込み (<%= %>) をこの範囲に入れない
  function initBasicAutoSave() {
    const FIELDS = [
      { id: 'f-name', key: 'name', label: '商品名', required: true },
      { id: 'f-price', key: 'price', label: '売価' },
      { id: 'f-asin', key: 'asin', label: 'ASIN' },
      { id: 'y-tax', key: 'tax_rate', label: '税率' },
      { id: 'f-memo', key: 'memo', label: 'メモ' },
    ];
    const marks = new Map();
    function markOf(f, el) {
      // 🚨 nextElementSibling を使い回さない (売価の次は利益の枠。別の要素に文字を入れてしまう)
      if (!marks.has(f.id)) {
        const span = document.createElement('span');
        span.className = 'autosave-mark';
        el.insertAdjacentElement('afterend', span);
        marks.set(f.id, span);
      }
      return marks.get(f.id);
    }
    function say(f, el, text, bad) {
      const span = markOf(f, el);
      span.classList.toggle('bad', !!bad);
      span.textContent = text;
    }
    const hhmm = () => new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });

    function save(f, el) {
      // 🚨 送る値は**確定した瞬間**に捕まえる (Codex R1)。列に並んでから el.value を読むと、
      //    待っている間に打ち直された値を送ったり、古い応答で画面を書き戻したりする
      const value = el.value;
      if (f.required && !String(value).trim()) {
        // サーバーは空の商品名を既存値で受け流すので、送ると画面と DB が食い違う
        say(f, el, f.label + 'は空にできません。入れ直してください', true);
        return Promise.resolve();
      }
      // 保存は 1 本の列に並べる (欄ごとの即保存も、ボタンのまとめ保存も同じ列)
      return phEnqueueSave(async () => {
        const body = {};
        body[f.key] = value;
        let json;
        const doneSending = phSending([[f.id, value]]);
        let settled = false;   // 保存できた/できなかったが**はっきりした**か
        try { json = await post(BASE, body); settled = true; } catch (_) { json = null; }
        finally {
          // 🚨 通信エラーは「保存できたか分からない」(Codex R3)。送信の記録を消さない —
          //    消すと、応答待ちに元の値へ戻した人の意思が退避されず、DB の値に黙って戻る
          if (settled) doneSending();
        }
        if (!json || !json.ok) {
          // 🚨 打った値は戻さない (人の入力を消さない)。未保存の印が出たままになるので、
          //    「基本情報を保存」で拾えるし、読み直しても #1397 の関所が書き戻す
          say(f, el, (json && json.error ? json.error : '保存できませんでした')
            + ' — 「基本情報を保存」を押してください', true);
          return;
        }
        // 🚨 基準は**サーバーが返した保存後の値**で進める。売価は整数に丸められ、
        //    文字列は trim されるので、画面の値で進めると「未保存」がいつまでも消えない
        const after = json.saved ? json.saved[f.key] : undefined;
        const s = after === undefined ? value : (after == null ? '' : String(after));
        // 🚨 画面を書き換えるのは**送ったあと編集されていない**ときだけ (Codex R1)。
        //    打ち直した値を古い応答で上書きしない。カーソルがその欄にあるときも触らない
        if (el.value === value && el.value !== s && document.activeElement !== el) el.value = s;
        if (phKeep) phKeep.savedValue(f.id, s);
        if (json.demoted) {
          alert('必須項目が欠けたため、ステータスを「下書き」に戻しました:\n' + json.demoted.join('\n'));
        }
        say(f, el, '✓ ' + hhmm() + ' 保存しました', false);
        updateTabBadges();
      });
    }
    for (const f of FIELDS) {
      const el = document.getElementById(f.id);
      if (!el) continue;
      // この欄は即保存、という印 (画面を見て分かるように / 描画後の確認にも使う)
      el.dataset.autosave = '1';
      // change = 値が変わって確定したとき。変わっていなければ発火しないので、空打ちは送らない
      el.addEventListener('change', () => save(f, el));
    }
  }
  // ここまでが「基本情報の即保存」の切り出し範囲
  initBasicAutoSave();

</script>
