    if (!btn || !box) return;
    // 文面はサーバーから来る値を含むので textContent で入れる (HTML を組み立てない)
    const setMsg = (text, warn) => {
      if (!msg) return;
      msg.textContent = text;
      msg.style.color = warn ? '#b91c1c' : '';
      msg.style.fontWeight = warn ? '700' : '';
    };
    btn.addEventListener('click', async () => {
      if (box.value.trim() && !confirm('裏面情報に文章が入っています。AI が読み取った文章で置き換えますか?\n\n(保存はしません。元に戻すには保存せずに画面を読み直してください)')) return;
      // ⭐押した時点の中身を控える。読み取りを待っている間も欄は打てるので、
      //   戻ってきたときに勝手に上書きしない (Codex PR2 #7)
      const atStart = box.value;
      btn.disabled = true;
      const before = btn.textContent;
      btn.textContent = '読み取っています…';
      setMsg('写真を読み取っています (10〜30秒かかります)', false);
      try {
        const r = await fetch(BASE + '/back-info/transcribe', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
        });
        const j = await r.json().catch(() => ({}));
        if (!j.ok) { setMsg(j.error || '読み取れませんでした', true); return; }
        // 待っている間に打ち足していたら、黙って消さずに聞く
        if (box.value !== atStart
            && !confirm('待っている間に裏面情報が編集されています。AI が読み取った文章で置き換えますか?' + String.fromCharCode(10,10) + '「キャンセル」を選ぶと、いま打った内容がそのまま残ります')) {
          setMsg('読み取った文章は入れませんでした (打った内容を残しました)。もう一度押せば入れ直せます', false);
          return;
        }
        box.value = j.text;
        box.dispatchEvent(new Event('input', { bubbles: true }));
        const warn = j.unreadable > 0
          ? ' 読めなかった箇所が ' + j.unreadable + ' か所あります (' + (j.unreadableMark || '') + ')。実物か写真で確かめてください。'
          : '';
        // 🚨出力の上限で途中で切れたものを、そのまま完成した下書きに見せない
        const cut = j.truncated
          ? ' 🚨文章が途中で切れています。写真を減らすか、切れた先は実物を見て書き足してください。'
          : '';
        // 読み込めなかった / 大きすぎて入らなかった写真を黙って減らさない
        const left = j.skipped
          ? ' 読み取れなかった写真が ' + j.skipped + ' 枚あります。'
          : '';
        setMsg('写真 ' + j.imageCount + '枚から下書きを作りました。まだ保存していません — 中身を確かめて「画像制作情報を保存」を押してください。' + warn + cut + left,
          j.unreadable > 0 || !!j.truncated || !!j.skipped);
      } catch (e) {
        setMsg('通信できませんでした: ' + e.message, true);
      } finally {
        btn.disabled = false;
        btn.textContent = before;
      }
    });
  })();
  // 定型文ボタン (画像工程 v2)。文面はサーバー (lib/prompt-templates.js) が組み立て、画面は表示とコピーだけ
  (function initPromptButtons() {
    const holder = document.getElementById('prompt-templates-json');
    if (!holder) return;
    let tpl = {};
    try { tpl = JSON.parse(holder.textContent) || {}; } catch (e) { return; }
    const modal = document.getElementById('prompt-modal');
    const textEl = document.getElementById('prompt-text');
    const titleEl = document.getElementById('prompt-title');
    const resultEl = document.getElementById('prompt-copy-result');
    const PROMPT_TITLES = {
      initialJudge: '新商品初動判定 (ChatGPT に貼る)',
      productAnalysis: 'LP制作システム (ChatGPT に貼る)',
      simpleLp: '仕入れ商品 簡易LP・サムネイル作成 (ChatGPT に貼る)',
    };
    // 簡易LPの「画像の重要度」(2026-09-17)。重要度は基本情報タブで選ぶと即保存され、画面を読み直さない。
    // そこで開くとき・コピーするときに、【入力】〜「商品情報：」の間の重要度の行を、いま保存されている値
    // (#f-image-priority の data-saved) の 1 行に揃える。本文を手で直していても重要度の行は基本情報の値にする。
    // 保存中・保存できたか分からないときはコピーしない (古い値を ChatGPT に渡さない — Codex 名指し R1)
    const prioritySel = document.getElementById('f-image-priority');
    const lpPriority = tpl.simpleLpPriority || null;
    const PRIORITY_UNSET_HINT = '画像の重要度が未設定です (基本情報タブで選ぶと定型文に入ります)';
    const PRIORITY_SAVING_HINT = '画像の重要度を保存中です。少し待ってから、もう一度コピーを押してください';
    const PRIORITY_UNKNOWN_HINT = '画像の重要度を保存できたか分かりません。画面を読み直してからコピーしてください';
    const PRIORITY_NO_SECTION_HINT = '本文の【入力】か「商品情報：」の見出しを消したり増やしたりしているため、画像の重要度を入れられません。ボタンを押して開き直してください';
    // 戻り値: null = 簡易LPでない・材料が無い (本文はそのまま) / { error } = コピーしない / { saved } = 揃えた (未設定は '')
    function syncPriorityLine() {
      if (modal.dataset.kind !== 'simpleLp' || !lpPriority || !prioritySel) return null;
      if (prioritySel.dataset.saving === '1') return { error: PRIORITY_SAVING_HINT };
      if (prioritySel.dataset.unknown === '1') return { error: PRIORITY_UNKNOWN_HINT };
      const saved = prioritySel.dataset.saved || '';
      const line = lpPriority.prefix + (saved || lpPriority.unset);
      // 見る範囲は【入力】〜「商品情報：」だけ。商品情報や補足の中の同じ文字には当てない (Codex R1)
      const lines = textEl.value.split('\n');
      // 行頭・行末の空白 (全角含む) は見ない: 見出しや重要度の行に空白を足しても同じ行として扱う (Codex 名指し R4)
      const trimmed = lines.map((l) => l.trim());
      // 見出しを消した・増やした (数が定型文と違う) ときは、どこが重要度の行か決められないのでコピーしない (Codex 名指し R2)
      const base = (tpl.simpleLp || '').split('\n').map((l) => l.trim());
      const count = (arr, v) => arr.filter((l) => l === v).length;
      if (count(trimmed, lpPriority.sectionStart) !== count(base, lpPriority.sectionStart)
        || count(trimmed, lpPriority.sectionEnd) !== count(base, lpPriority.sectionEnd)) return { error: PRIORITY_NO_SECTION_HINT };
      const from = trimmed.indexOf(lpPriority.sectionStart);
      const to = from < 0 ? -1 : trimmed.indexOf(lpPriority.sectionEnd, from + 1);
      if (to < 0) return { error: PRIORITY_NO_SECTION_HINT };
      // 最初の重要度の行を保存済みの値にし、手で増やした重要度の行は消す。無ければ「商品情報：」の前に足す。
      // 重要度の行 = 「画像の重要度」で始まる行 (区切りの「：」を「:」や空白に直していても当てる)
      const label = lpPriority.prefix.replace(/[：:]$/, '');
      const isPriorityLine = (l) => l.trim().startsWith(label);
      const region = lines.slice(from + 1, to);
      const at = region.findIndex(isPriorityLine);
      const nextRegion = at < 0
        ? [...region, line, '']
        : region.flatMap((l, i) => (i === at ? [line] : (isPriorityLine(l) ? [] : [l])));
      lines.splice(from + 1, region.length, ...nextRegion);
      const next = lines.join('\n');
      if (next !== textEl.value) textEl.value = next;
      return { saved };
    }
    document.querySelectorAll('.prompt-btn').forEach((b) => {
      b.addEventListener('click', () => {
        const kind = b.dataset.kind;
        titleEl.textContent = PROMPT_TITLES[kind] || '';
        modal.dataset.kind = kind;
        textEl.value = tpl[kind] || '';
        const priority = syncPriorityLine();
        resultEl.textContent = priority?.error || (priority?.saved === '' ? PRIORITY_UNSET_HINT : '');
        modal.hidden = false;
        textEl.focus();
      });
    });
    document.getElementById('prompt-close-btn').addEventListener('click', () => { modal.hidden = true; });
    document.getElementById('prompt-copy-btn').addEventListener('click', async () => {
      // 開いた後に重要度を変えていても、コピーする本文の重要度は保存済みの値にする
      const priority = syncPriorityLine();
      if (priority?.error) { resultEl.textContent = priority.error; return; }
      // 初動判定は LP制作管理シートの URL も人が貼る (定型文には案内文だけが入っている)
      const after = (modal.dataset.kind === 'initialJudge'
        ? 'ChatGPT に貼って、商品画像の添付と LP制作管理シートの URL を入れてください'
        : 'ChatGPT に貼って商品画像を添付してください')
        + (priority?.saved === '' ? '。' + PRIORITY_UNSET_HINT : '');
      // コピーできなければ本文を選択する。iPad では Ctrl+C が使えないので長押しも案内する
      try { await navigator.clipboard.writeText(textEl.value); resultEl.textContent = 'コピーしました。' + after; }
      catch (e) { textEl.select(); resultEl.textContent = 'コピーできませんでした (本文を選択したので、長押しか Ctrl+C でコピーしてください)'; }
    });
  })();
