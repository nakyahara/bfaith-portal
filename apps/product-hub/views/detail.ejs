      <span class="muted" id="pi-result">入力は自動で保存されます (入力が止まって約1秒後)</span>
    </div>
    <div id="pi-warnings" style="margin-top:8px;"></div>
    <div id="pi-preview" style="display:none; margin-top:10px; border:1px solid #e2e8f0; border-radius:8px; padding:10px; background:#fff; overflow:auto; max-height:400px;"></div>
    <textarea id="pi-html-src" style="display:none;"><%= pageInfoHtml %></textarea>
