    }

    function candidateRow(c) {
      const d = c.decision;
      const cur = d ? (d.decision === 'adopt' ? 'adopt:' + d.match_type : d.decision) : 'undecided';
      const sel = el('select', { style: 'min-width:150px;' });
      const opts = [['undecided', '未採用']];
      for (const mt of state.match_types) opts.push(['adopt:' + mt, '採用: ' + L.match_type[mt]]);
      opts.push(['hold', '保留'], ['reject', '却下']);
      for (const [v, t] of opts) sel.appendChild(el('option', { value: v, text: t, selected: v === cur }));
      const kwInput = el('input', { type: 'text', maxlength: '80', style: 'min-width:180px;', value: d && d.decision === 'adopt' ? (d.keyword || c.value) : c.value });
      // 採用したときだけ直せる。押せない欄は薄くして「直せる欄」と見分けがつくように
      const setEditable = (on) => { kwInput.disabled = !on; kwInput.style.opacity = on ? '1' : '.45'; };
      setEditable(!!(d && d.decision === 'adopt'));
      const saving = inflight.has(c.id);
      const note = el('span', { class: 'muted', style: 'font-size:11px;', text: saving ? '保存中…' : (d ? (L.decision[d.decision] + '・' + fmtTime(d.created_at) + (d.actor ? '・' + d.actor : '')) : '') });
      if (saving) { sel.disabled = true; kwInput.disabled = true; }   // GET で描き直されても保存中は触れない
      const send = async () => {
        if (inflight.has(c.id)) return;
        const v = sel.value;
        const body = v.indexOf('adopt:') === 0
          ? { decision: 'adopt', match_type: v.slice(6), keyword: kwInput.value }
          : { decision: v };
        inflight.set(c.id, true);
        sel.disabled = true; kwInput.disabled = true; note.textContent = '保存中…';
        const myReqGen = reqGen;
        let r = null;
        try {
          r = await api('/candidates/' + c.id + '/decisions', body);
        } finally {
          inflight.delete(c.id);
        }
        // 待っている間に依頼が切り替わった (置き換え・取消) → この応答は旧依頼のもの。何も進めない (切替後の GET に任せる)
        if (myReqGen !== reqGen) return;
        // 🚨 ここから先、この行 (sel / kwInput / note) は GET の描き直しで取り外されているかもしれない。
        //    いまの state の候補を id で引き直し、表示している行を id で探して描き直す (R3 #3)
        const cur = state.candidates.find((x) => x.id === c.id);
        if (!r || !r.ok) {
          alert((r && r.error) || '採否を記録できませんでした');
          // サーバーでは保存済みかもしれない → 読み直して確かめる。読み直せなければ、手元の状態で行だけ戻す (操作不能のまま残さない)
          if (!(await refresh()) && cur) rerow(cur);
          return;
        }
        // 待っている間に依頼が置き換わっていたら、この応答は古い依頼のもの → 描き直す
        if (!state.request || r.decision.request_id !== state.request.id || !cur) { await refresh(); return; }
        const dec = { id: r.decision.id, decision: r.decision.decision, keyword: r.decision.keyword, match_type: r.decision.match_type, actor: r.decision.actor, created_at: r.decision.created_at };
        // 同じ候補の遅い応答 (もっと新しい採否が既に載っている) では巻き戻さない
        if (!cur.decision || dec.id > cur.decision.id) cur.decision = dec;
        gen += 1;
        // 採否版 = この依頼の採否の最新 id。固定した本文がこれより古ければ「押し直して」と出す。巻き戻さない (単調増加)
        state.decision_version = Math.max(state.decision_version || 0, r.decision.id);
        state.adopted_count = state.candidates.filter((x) => x.decision && x.decision.decision === 'adopt').length;
        rerow(cur);
        const ex = document.getElementById('adkw-export');
        if (ex) ex.replaceWith(exportSection());
        const cnt = document.getElementById('adkw-count');
        if (cnt) cnt.textContent = '候補 ' + state.candidates.length + ' 語 (採用 ' + state.adopted_count + ')';
        const ab = document.getElementById('adkw-auto-asins');
        if (ab) ab.replaceWith(autoAsinsButton());   // 採用数で押せる / 押せないが変わる
        rerenderAi();
      };
      sel.addEventListener('change', send);
      kwInput.addEventListener('change', () => { if (sel.value.indexOf('adopt:') === 0) send(); });
      const badge = d && d.decision === 'adopt' ? 'badge-approved' : d && d.decision === 'hold' ? 'badge-on_hold' : d && d.decision === 'reject' ? 'badge-excluded' : '';
      return el('tr', { 'data-cid': String(c.id) }, [
        el('td', {}, [el('span', { class: badge ? 'badge ' + badge : '', text: c.value })]),
        el('td', { class: 'muted', 'data-obs': '1', text: obsCellText(c) }),
        el('td', {}, [sel]),
        el('td', {}, [kwInput]),
        el('td', {}, [note]),
      ]);
    }

    // 候補の「出方」欄の文字 = どの種のどの prefix で、いつ観測したか (取り直しても最初の観測の日付は変わらない) / ABA なら順位・位置・シェア・週。
    // AI の提案 (PR3a) = 理由と根拠にした観測語。観測済みの語に AI も提案したときは「🤖 AI も提案」を添える。
    // 採否の保存のたびに rerenderAi() がこの欄の文字だけを書き換える (行ごと描き直すと、別の行の打ちかけの語が消える — Codex #1429 R3)
    function obsCellText(c) {
      const dateOf = (iso) => { const t = iso ? Date.parse(iso) : NaN; return Number.isFinite(t) ? (new Date(t).getMonth() + 1) + '/' + new Date(t).getDate() : '?'; };
      // ABA の観測 = 順位・位置・シェアを原値で (定義は表の頭に。ボリュームや成果に換算しない)
      const pct = (v) => (typeof v === 'number' && isFinite(v)) ? (Math.round(v * 1000) / 10) + '%' : '?';
      const obsText = (o) => o.source === 'aba'
        ? 'ABA 順位 ' + (o.rank != null ? o.rank : '?') + '・位置 ' + (o.click_position != null ? o.click_position : '?') + '・クリック ' + pct(o.click_share) + '・購入 ' + pct(o.conversion_share)
          + (o.seed !== c.seed ? '（' + o.seed + '）' : '') + ' 週 ' + (o.week_text || dateOf(o.week_start))
        : o.source_label + (o.seed !== c.seed ? '（' + o.seed + '）' : '') + ' ' + dateOf(o.fetched_at);
      const p = (state.ai && state.ai.proposals) ? state.ai.proposals[c.id] : null;
      const onlyAi = c.observed.length === 0;
      const aiText = p ? ((onlyAi ? '' : '🤖 AI も提案') + (p.reason ? (onlyAi ? '' : '：') + p.reason : '')
        + (p.basis && p.basis.length ? '（根拠: ' + p.basis.join('・') + '）' : '')
        + '［AI #' + p.job_id + (p.count > 1 ? '・提案 ' + p.count + ' 回' : '')
        // 旧材料 = 商品情報が変わった or 固定した採否版がいまの採否版と違う (画面の state で比べ直す — Codex #1429 R2 #1)
        + ((p.job_stale_product || (p.job_decision_version != null && p.job_decision_version !== state.decision_version)) ? '・旧材料' : '') + '］') : '';
      const obs = c.observed.map(obsText).join(' / ');
      return [obs, aiText].filter(Boolean).join(' / ') || (c.origin === 'ai' ? 'AI 提案 (理由なし)' : '');
    }

    function exportSection() {
      const box = el('div', { id: 'adkw-export', style: 'margin-top:14px; padding:10px 12px; border:1px solid #e2e8f0; border-radius:8px; background:#fff;' });
      box.appendChild(el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center;' }, [
        el('strong', { style: 'font-size:13px;', text: '広告画面に貼る本文 (採用 ' + state.adopted_count + ' 語・商品ターゲット ' + (state.adopted_asin_count || 0) + ' 件)' }),
        el('button', { type: 'button', class: 'btn btn-sm btn-primary', text: '本文を固定する', onclick: () => makeExport(),
          disabled: !state.request || (state.adopted_count === 0 && !(state.adopted_asin_count > 0)) }),
        el('span', { class: 'muted', text: '固定 = このときの採否でコピー本文を作って履歴に残す。採否を変えたらもう一度固定する' }),
      ]));
      const latest = state.exports && state.exports[0];
      if (latest && latest.body) {
        if (latest.decision_version !== state.decision_version) {
          box.appendChild(el('p', { class: 'muted', style: 'color:#b45309; margin:8px 0 0;', text: '⚠ 固定したあとに採否が変わっています。下の本文は古い採否のものです。「本文を固定する」を押し直してください' }));
        }
        box.appendChild(el('p', { class: 'muted', style: 'margin:6px 0 0;', text: '履歴 #' + latest.id + '（' + fmtTime(latest.created_at) + (latest.created_by ? '・' + latest.created_by : '') + '）— マッチタイプごとに分けてあります。Amazon の広告画面の「キーワードを入力」に、同じマッチタイプを選んで貼ってください' }));
        for (const b of latest.body.blocks || []) {
          const ta = el('textarea', { readonly: true, rows: String(Math.min(8, Math.max(2, b.count))), style: 'width:100%; font-family:ui-monospace,Consolas,monospace; font-size:13px;' });
          ta.value = b.text;
          const copiedAt = latest.copied && latest.copied[b.match_type];
          const hint = el('span', { class: 'muted', style: 'font-size:12px;', text: copiedAt ? '✅ コピー済み ' + fmtTime(copiedAt) + '（Amazon 登録済みの印ではありません）' : '' });
          const blockLabel = ((L.copy_block || L.match_type)[b.match_type] || b.match_type);
          const unit = b.match_type === 'product_targets' ? ' 件' : ' 語';
          const btn = el('button', { type: 'button', class: 'btn btn-sm', text: '📋 ' + blockLabel + ' をコピー (' + b.count + unit + ')' });
          btn.addEventListener('click', async () => {
            const ok = await (typeof copyText === 'function' ? copyText(b.text) : Promise.resolve(false));
            if (!ok) { hint.textContent = '⚠️ コピーできません。上の欄を選択して手でコピーしてください'; return; }
            const r = await api('/exports/' + latest.id + '/copied', { match_type: b.match_type });
            if (r.ok) { latest.copied = r.copied; hint.textContent = '✅ コピー済み ' + fmtTime(r.copied[b.match_type]) + '（Amazon 登録済みの印ではありません）'; }
            else hint.textContent = '✅ コピーしました (記録は失敗: ' + (r.error || '') + ')';
          });
          box.appendChild(el('div', { style: 'margin-top:8px;' }, [
            el('div', { style: 'display:flex; gap:8px; align-items:center; margin-bottom:4px;' }, [
              el('strong', { style: 'font-size:13px;', text: blockLabel + '（' + b.count + unit + '）' }), btn, hint,
            ]),
            ta,
          ]));
        }
      }
      return box;
    }

    async function makeExport() {
      if (!state.request) return;
      const myReqGen = reqGen;
      const r = await api('/requests/' + state.request.id + '/exports', {});
      if (myReqGen !== reqGen) return;   // 待つ間に依頼が切り替わった → 旧依頼の応答は捨てる
      if (!r.ok) { alert(r.error || '本文を固定できませんでした'); if (r.network) await refresh(); return; }
      // 待っている間に依頼が置き換わっていたら、この応答は古い依頼のもの
      if (!state.request || r.export.request_id !== state.request.id) { await refresh(); return; }
      state.exports = [r.export].concat((state.exports || []).filter((e) => e.id !== r.export.id));
      gen += 1;
      // 🚨 固定の応答で採否版を巻き戻さない。応答を待つ間に採否が進んでいれば「押し直して」が出たままになる (PR #1408 R1 #3)
      state.decision_version = Math.max(state.decision_version || 0, r.export.decision_version);
      const ex = document.getElementById('adkw-export');
      if (ex) ex.replaceWith(exportSection());
    }
    async function ensureRequest(restart) {
      if (!pendingKey) pendingKey = newKey();
      const r = await api('/requests', { idempotency_key: pendingKey, restart: !!restart });
      // 結果が分からない通信失敗 (サーバーには届いたかもしれない) では同じキーを持ち続ける = 再送で二重に作らない。
      // はっきり断られたとき・できたときはキーを捨てる (R2 #9)
      if (!r.ok) { if (!r.network) pendingKey = null; throw new Error(r.error || '依頼を作れませんでした'); }
      pendingKey = null;
      return r.request_id;
    }
    async function collect(rawSeed, alphabet, ui, retake) {
      if (busy) return;
      const seed = String(rawSeed || '').trim();
      if (!seed) { alert('種になるキーワードを入力してください'); return; }
      busy = true;
      clearTimeout(pollTimer);
      if (ui.collectBtn) ui.collectBtn.disabled = true;
      if (ui.progress) ui.progress.textContent = '「' + seed + '」を miniPC で集めています… (約 10〜20 秒・最長 40 秒)';
      try {
        const rid = state.request ? state.request.id : await ensureRequest(false);
        const myGen = gen, myReqGen = reqGen;
        const r = await api('/requests/' + rid + '/collect', { seed, alphabet: !!alphabet, retake: !!retake });
        if (myReqGen !== reqGen) { busy = false; await refresh(); return; }   // 待つ間に依頼が切り替わった → 収集の応答は捨てて読み直す
        if (!r.ok) { alert(r.error || '集められませんでした'); busy = false; await refresh(); return; }
        gen += 1;
        // 待っている間に採否を変えていたら (世代が進んでいたら)、収集の応答に載った状態は古い → 取り直す
        if (gen - 1 !== myGen || !r.state) { busy = false; await refresh(); }
        else { state = r.state; render(); }
        const p = document.getElementById('adkw-progress');
        if (p) {
          p.textContent = r.collected
            ? (r.reused ? '「' + seed + '」は取得済みです' : '「' + seed + '」: 候補 +' + r.added + ' 語' + (r.merged ? ' (既出 ' + r.merged + ')' : ''))
            : '「' + seed + '」は取れませんでした: ' + (r.error || '') + '（失敗として記録。あとで「もう一度」できます）';
        }
        const inp = document.getElementById('adkw-seed');
        if (inp && r.collected) { inp.value = ''; inp.focus(); }
      } catch (e) {
        alert(e && e.message ? e.message : String(e));
        busy = false;
        await refresh();
      } finally {
        busy = false;
        // 無条件に押せるようにしない: 別の画面が収集中なら押せないまま (5 秒ごとの確認で戻る)
        const b = document.getElementById('adkw-collect');
        if (b) b.disabled = !state.configured || collectingElsewhere();
        schedulePollIfNeeded();
      }
    }
    // 依頼を切り替えたあとの読み直し。1 度で読めなければもう 1 度、それでも駄目なら人に読み直してもらう (古い依頼を出したままにしない)
    async function refreshAfterSwitch() {
      reqGen += 1; gen += 1;
      if (await refresh()) return;
      await new Promise((r) => setTimeout(r, 1000));
      if (await refresh()) return;
      alert('依頼を切り替えましたが、画面を読み直せませんでした。ページを読み直してください');
    }
    async function restart() {
      if (!confirm('新しい依頼にしますか？ いまの候補と採否はこの依頼に残りますが、画面からは消えます (上書きはしません)')) return;
      try { await ensureRequest(true); } catch (e) { alert(e.message || String(e)); return; }
      await refreshAfterSwitch();
    }
    async function cancel() {
      if (!state.request || !confirm('この依頼を取り消しますか？ (収集中の結果は保存されません)')) return;
      const r = await api('/requests/' + state.request.id + '/cancel', {});
      if (!r.ok) alert(r.error || '取り消せませんでした');
      await refreshAfterSwitch();   // 通信断で届いていたかもしれないので、成否に関わらず読み直す
    }
    render();
  })();
  </script>
  <% } %>


  <!-- ジャンル選択モーダル (RMS の「ジャンルID選択」と同じ操作感) -->
  <%# セット展開判断 (2026-09-04 要件定義 §5.4)。⑤は判断を記録してからでないと閉じられない。
      「新規作成」は上部の「セット商品を作る」が入口なので、ここでは選ばせない %>
  <div id="setdec-modal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:1000;">
    <div style="background:#fff; max-width:560px; margin:8vh auto; border-radius:12px; padding:18px 20px; display:flex; flex-direction:column; gap:10px;">
      <div style="display:flex; align-items:center;">
        <h2 style="margin:0; font-size:16px;">セット展開判断</h2>
        <span style="flex:1"></span>
        <button type="button" class="btn btn-sm" id="setdec-close">✕</button>
      </div>
      <p class="muted" style="margin:0; font-size:12px;">
        この商品をセットにするか決めます。<strong>作らない・保留も記録します</strong>
        (後から「まだ検討していない」のか「検討して作らないと決めた」のかが分かるように)。
      </p>
      <label style="display:flex; gap:8px; align-items:flex-start; border:1px solid #e2e8f0; border-radius:6px; padding:8px 10px;">
        <input type="radio" name="setdec" value="none" checked>
        <span><strong>セットは作らない</strong><br><span class="muted" style="font-size:11.5px;">理由を選んでください</span></span>
      </label>
      <div id="setdec-none-box" style="padding-left:26px; display:grid; gap:6px;">
        <select id="setdec-reason" style="width:100%;">
          <% for (const [code, label] of Object.entries(setDecisionReasons)) { %>
            <option value="<%= code %>"><%= label %></option>
          <% } %>
        </select>
        <input type="text" id="setdec-reason-text" maxlength="200" placeholder="「その他」を選んだときは一言" hidden>
      </div>
      <% if (setDrafts.length) { %>
        <label style="display:flex; gap:8px; align-items:flex-start; border:1px solid #e2e8f0; border-radius:6px; padding:8px 10px;">
          <input type="radio" name="setdec" value="existing">
          <span><strong>既存のセットがある</strong><br><span class="muted" style="font-size:11.5px;">二重に作らないよう、そのセットに紐づけます</span></span>
        </label>
        <div id="setdec-existing-box" style="padding-left:26px;" hidden>
          <select id="setdec-linked" style="width:100%;">
            <% for (const sdr of setDrafts) { %>
              <option value="<%= sdr.id %>"><%= sdr.ne_code %> — <%= sdr.name %></option>
            <% } %>
          </select>
        </div>
      <% } %>
      <label style="display:flex; gap:8px; align-items:flex-start; border:1px solid #e2e8f0; border-radius:6px; padding:8px 10px;">
        <input type="radio" name="setdec" value="hold">
        <span><strong>保留</strong><br><span class="muted" style="font-size:11.5px;">この工程は開いたままにして、何日待っているかを数え続けます</span></span>
      </label>
      <div id="setdec-hold-box" style="padding-left:26px;" hidden>
        <input type="text" id="setdec-hold-note" maxlength="200" placeholder="メモ (例: 売れ行きを見てから)" style="width:100%;">
      </div>
      <p class="muted" style="margin:0; font-size:11.5px;">
        セットを新しく作る場合はここでは選びません。
        <button type="button" class="btn btn-sm" id="setdec-goto-create">🎁 セットを作る</button>
        を押すと、上のセット欄の入力に切り替わります (作成すると判断も一緒に記録され、この工程が閉じます)。
      </p>
      <div style="display:flex; gap:8px; align-items:center;">
        <button type="button" class="btn btn-primary btn-sm" id="setdec-apply">この判断で記録</button>
        <button type="button" class="btn btn-sm" id="setdec-cancel">キャンセル</button>
        <span class="muted" id="setdec-result"></span>
      </div>
    </div>
  </div>

  <div id="genre-modal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:1000;">
    <div style="background:#fff; max-width:640px; margin:6vh auto; border-radius:12px; padding:18px 20px; max-height:84vh; display:flex; flex-direction:column;">
      <div style="display:flex; align-items:center;">
        <h2 style="margin:0; font-size:16px;">ジャンルID選択</h2>
        <span style="flex:1"></span>
        <button type="button" class="btn btn-sm" id="genre-modal-close">✕</button>
      </div>
      <div id="genre-tree" style="flex:1; overflow:auto; border:1px solid #e2e8f0; border-radius:8px; margin:12px 0; padding:6px 4px; font-size:13px;">
        <p class="muted" style="margin:8px;">読み込み中…</p>
      </div>
      <div style="background:#f8fafc; border-radius:8px; padding:8px 12px; font-size:12px;">
        選択ジャンルID: <code id="genre-modal-id">—</code><br>
        選択ジャンルパス: <span id="genre-modal-path" class="muted">—</span>
      </div>
      <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:12px;">
        <button type="button" class="btn" id="genre-modal-cancel">キャンセル</button>
        <button type="button" class="btn btn-primary" id="genre-modal-apply">入力画面に反映</button>
      </div>
    </div>
  </div>

  <!-- 履歴 -->
  <div class="card">
    <details>
      <summary style="cursor:pointer; font-size:14px; font-weight:600;">操作履歴 (<%= events.length %>件)</summary>
      <table class="list" style="margin-top:10px;">
        <tbody>
          <% for (const ev of events) { %>
            <tr>
              <td class="muted" style="width:150px"><%= (ev.created_at || '').replace('T', ' ').slice(0, 19) %></td>
              <td style="width:180px"><%= ev.event %></td>
              <td class="muted"><%= ev.detail || '' %></td>
              <td class="muted" style="width:180px"><%= ev.actor || '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </details>
  </div>
</div>

<script>
  const BASE = '/apps/product-hub/api/drafts/<%= draft.id %>';
  const result = document.getElementById('action-result');

  async function post(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json();
  }

  // 読み直しの関所。この画面の読み直しは**すべてここを通す** (ほかの場所で location.reload を直に呼ばない)。
  // 明示保存の欄に打ったまま保存していない値を退避してから読み直し、読み直した後に書き戻す
  // (initUnsavedGuard を参照)。phKeep は var 宣言 — この関数は巻き上がるので、
  // ガードの初期化より前に呼ばれても落ちないようにしている
  var phKeep = null;
  // ─── 保存の順番を 1 本の列にそろえる (2026-09-21) ───────────────────────────
  // 🚨 欄ごとの即保存と、ボタンのまとめ保存が**並行に飛ぶ**と、先に送った古い値が
  //    後から着いて新しい値を上書きする (画面と DB が食い違い、未保存の印も出ない)。
  //    基本情報を触る保存は全部この列に並べる (楽天の全量保存は税率を送らないので対象外)
  // 🚨 ここから「保存の列と読み直し」の切り出し範囲 — テストが**描画ではなくこの素の JS** を
  //    vm で動かして、順番・待ち方を確かめる。EJS の埋め込み (<%= %>) をこの範囲に入れない
  var phSaveTail = Promise.resolve();
  // いま応答を待っている欄と、**その送った値** (id → 送った値)。
  // 🚨 読み直しのときに「DB のいまの値が自分の保存の結果か」を見分けるのに要る (Codex R2)。
  //    送った値を覚えておかないと、他人の変更まで自分のものとして黙って隠してしまう
  var phInflight = new Map();
  /** 送信の開始を記録する。@returns {Function} 終わったときに呼ぶ解除関数 */
  function phSending(entries) {
    for (const [id, v] of entries) phInflight.set(id, v);
    return () => { for (const [id] of entries) phInflight.delete(id); };
  }
  function phEnqueueSave(fn) {
    // 前が失敗しても次は動かす。🚨 つなぐ先も吸収済みにする — reject が残ると
    //    以後の保存が 1 つも動かなくなる (Codex R1)
    const p = phSaveTail.then(fn, fn);
    phSaveTail = p.then(() => {}, () => {});
    return p;
  }

  function reloadSafely() {
    const doReload = () => {
      let kept = false;
      // 🚨 応答を待てなかった欄は「送った値」も添えて退避する (Codex R1/R2)。
      //    DB は送った値に変わっているかもしれない。元の値とも送った値とも違えば、
      //    それは**ほかの人の変更**なので隠さない
      const inflight = {};
      phInflight.forEach((v, id) => { inflight[id] = v; });
      try { kept = phKeep ? phKeep.stash({ inflight }) : true; } catch (_) { kept = false; }
      // 🚨 退避できたときだけ離脱の警告を消す。容量不足やプライベートモードで
      //    退避できないのに黙って読み直すと、未保存が無警告で消える
      if (kept) { try { phKeep.mute(); } catch (_) { /* 印の都合は本筋ではない */ } }
      location.reload();
    };
    // 🚨 保存が飛んでいる最中に読み直すと、保存できたばかりの値を「ほかの人が変えた」と
    //    誤判定して捨ててしまう。**列の最後尾まで**待つ — 待っている間に増えた保存も待つ
    //    (最初の 1 本だけ待つと、後から確定した欄が通信中のまま読み直してしまう)。
    //    固まっても 3 秒で進む (そのときは上の inflight が効く)
    let fired = false;
    const go = () => { if (fired) return; fired = true; doReload(); };
    const deadline = Date.now() + 3000;
    const waitTail = () => {
      const tail = phSaveTail;
      Promise.resolve(tail).then(() => {
        if (fired) return;
        if (tail !== phSaveTail && Date.now() < deadline) { waitTail(); return; }   // 待つ間に増えた
        go();
      }, go);
    };
    waitTail();
    setTimeout(go, 3000);
  }
  // ここまでが「保存の列と読み直し」の切り出し範囲

  function showAndReload(json, okMsg) {
    if (json.ok) {
      if (json.demoted) {
        alert('必須項目が欠けたため、ステータスを「下書き」に戻しました:\n' + json.demoted.join('\n'));
      }
      result.textContent = okMsg;
      setTimeout(() => reloadSafely(), 600);
    } else {
      const detail = json.reasons ? json.reasons.join(' / ') : '';
      alert((json.error || 'エラーが発生しました') + (detail ? '\n' + detail : ''));
    }
  }

  // ─── タブ切り替え (2026-07-29)。location.hash に保持して保存後の reload でも同じタブに戻る ───
  (function initTabs() {
    const btns = Array.from(document.querySelectorAll('#tabbar .tab-btn'));
    function activate(id, remember) {
      btns.forEach((b) => b.classList.toggle('active', b.dataset.tab === id));
      document.querySelectorAll('.tab-panel').forEach((p) => p.classList.toggle('active', p.id === id));
      // location.hash 直代入はパネルへスクロールしてしまうため replaceState を使う
      if (remember) history.replaceState(null, '', '#' + id);
    }
    btns.forEach((b) => b.addEventListener('click', () => activate(b.dataset.tab, true)));
    // 他タブへの案内リンク (例: 基本情報タブの「カタログID はカテゴリ・属性タブの表で入力」)
    document.querySelectorAll('a.jump-tab').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      activate(a.dataset.tab, true);
      window.scrollTo(0, 0);
    }));
    // 初期タブ: ?tab= (工程ボードの画像ビューからのリンク等) > #hash (保存後 reload の復元)。
    // ボードは ?tab=tab-images を付けて飛ばすが、hash しか見ていなかったため基本情報タブが開いていた (2026-08-26)
    const wanted = (new URLSearchParams(location.search).get('tab') || '') || (location.hash || '').slice(1);
    const initial = btns.some((b) => b.dataset.tab === wanted) ? wanted : 'tab-basic';
    activate(initial, false);
    if (initial !== 'tab-basic' && !location.hash) history.replaceState(null, '', '#' + initial);
  })();

  // ─── 必須未入力バッジ。楽天登録・AI生成ゲートで必要な「入力もの」を数える。
  //     サーバーのプリフライト (buildItemPayload 事前検証) の完全ミラーではない —
  //     形式エラー (JAN桁数/文字数超過/税率不正など) はサーバーが最終判定する。
  //     公式ページURLは楽天登録には不要だが「生成待ち」ゲートの必須なので含めている ───
  let mandatoryAttrNames = [];
  try { mandatoryAttrNames = JSON.parse(document.getElementById('rk-mandatory-json').textContent) || []; } catch (e) {}

  function tv(id) {
    const el = document.getElementById(id);
    return el ? String(el.value || '').trim() : '';
  }

  // lib/page-info.js validatePageInfo のミラー。変更時は両方直すこと
  function pageInfoMissing() {
    const t = tv('pi-type') || 'general';
    const miss = [];
    if (t === 'cosmetics' || t === 'health_food') {
      if (!tv('pi-seller')) miss.push('発売元');
      const ot = tv('pi-origin-type');
      if (!ot) miss.push('製造国');
      else if (ot === '海外製') {
        if (t === 'health_food' && !tv('pi-origin-country')) miss.push('原産国名');
        if (!tv('pi-importer')) miss.push('輸入者名');
      }
      if (!tv('pi-category')) miss.push('商品区分');
    }
    if (t === 'health_food') {
      if (!tv('pi-food-name')) miss.push('名称 (食品表示)');
      if (!tv('pi-food-ingredients')) miss.push('原材料名');
      if (!tv('pi-volume')) miss.push('内容量');
      if (!tv('pi-food-expiry')) miss.push('賞味期限');
      if (!tv('pi-food-storage')) miss.push('保存方法');
    }
    return miss;
  }

  function computeMissing() {
    const m = { 'tab-basic': [], 'tab-images': [], 'tab-desc': [], 'tab-info': [], 'tab-category': [] };
    if (!tv('f-name')) m['tab-basic'].push('商品名');
    // AI の参照元は「公式ページURL / 参考URL / Amazon URL のどれか1つ」でよい (サーバーの gateReasons と対応)
    if (!tv('f-official-url') && !tv('f-amazon-url') && Number(document.getElementById('tabbar').dataset.refCount || 0) === 0) {
      m['tab-basic'].push('AIが参照できるURL (公式/参考/Amazon のどれか)');
    }
    const price = Number(tv('f-price'));
    if (!Number.isFinite(price) || price <= 0) m['tab-basic'].push('売価');
    const bar = document.getElementById('tabbar');
    const imgs = Number(bar.dataset.imageCount || 0);
    const transferred = Number(bar.dataset.transferredCount || 0); // drive_file_id 突合済みの件数
    if (imgs === 0) m['tab-images'].push('商品画像 (1枚以上)');
    else if (transferred < imgs) m['tab-images'].push('R-Cabinet未転送 ' + (imgs - transferred) + '枚');
    m['tab-info'].push(...pageInfoMissing());
    if (!tv('rk-genre')) m['tab-category'].push('ジャンルID');
    // カタログIDは JAN からサーバーが自動送信する (入力は基本情報タブ: 単品=JAN欄 / バリエーション=SKU表)。
    // 辞書で必須のジャンルは JAN の無い SKU があると登録が止まるので、基本情報タブの未入力として数える
    // (Codex R1 High-1: 無条件に除外すると「未入力0件」のまま登録が失敗する)
    // 入力はどちらもカテゴリ・属性タブの「カタログID・商品仕様」の表 (2026-09-03)
    const skuJanInputs = Array.from(document.querySelectorAll('.sku-jan-input'));
    const janMissing = skuJanInputs.length > 0
      ? skuJanInputs.filter((i) => !i.value.trim()).length
      : (tv('f-jan') ? 0 : 1);
    if (mandatoryAttrNames.includes('カタログID') && janMissing > 0) {
      m['tab-category'].push(skuJanInputs.length > 0
        ? 'カタログID (JAN) 未入力のSKU ' + janMissing + '件 (このジャンルの必須属性)'
        : 'カタログID (JAN・このジャンルの必須属性)');
    }
    const need = mandatoryAttrNames.filter((n) => n !== 'カタログID');
    if (need.length > 0) {
      const grid = document.getElementById('rk-sku-grid');
      if (grid) {
        // バリエーション: SKU ごとのセルが全部埋まって初めて「入力済み」
        const skuCount = Math.max(0, grid.querySelectorAll('thead th').length - 1);
        for (const n of need) {
          const cells = Array.from(grid.querySelectorAll('.sku-attr-input')).filter((c) => c.dataset.name === n);
          const filled = cells.filter((c) => c.value.trim()).length;
          if (filled < skuCount) m['tab-category'].push('必須属性「' + n + '」(SKU ' + (skuCount - filled) + '件)');
        }
      } else {
        const vals = {};
        document.querySelectorAll('#rk-attrs tbody tr').forEach((tr) => {
          const nameEl = tr.querySelector('.rk-attr-name');
          if (!nameEl) return;   // 固定行 (カタログID・メーカー型番) は属性行ではない
          const n = nameEl.value.trim();
          if (n) vals[n] = tr.querySelector('.rk-attr-value').value.trim();
        });
        for (const n of need) {
          if (vals[n]) continue;
          if (n === modelAttrName && tv('rk-article')) continue; // メーカー型番は固定行の欄
          m['tab-category'].push('必須属性「' + n + '」');
        }
      }
    }
    return m;
  }

  function updateTabBadges() {
    const m = computeMissing();
    document.querySelectorAll('#tabbar .tab-btn').forEach((b) => {
      const list = m[b.dataset.tab] || [];
      const badge = b.querySelector('.tab-badge');
      badge.hidden = list.length === 0;
      badge.textContent = list.length;
      b.title = list.length ? '未入力の必須: ' + list.join(' / ') : '';
    });
  }
  document.addEventListener('input', () => updateTabBadges());
  document.addEventListener('change', () => updateTabBadges());
  document.addEventListener('click', () => setTimeout(updateTabBadges, 60)); // 属性行の追加/削除ボタン対応

  document.querySelectorAll('.status-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/status', { to: btn.dataset.to }), 'ステータスを変更しました');
    });
  });

  // AI の「人の確認待ち」解除 (2026-08-28)。blocked_at を送って、画面が見ていた block と違えば 409
  const genUnblockBtn = document.getElementById('gen-unblock-btn');
  if (genUnblockBtn) {
    genUnblockBtn.addEventListener('click', async () => {
      if (!confirm('AI が止めた理由は直しましたか？\n解除すると次の夜間実行で AI が再挑戦します (直していなければ同じ理由でまた止まります)')) return;
      genUnblockBtn.disabled = true;
      const json = await post(BASE + '/generation-block', { clear: true, blocked_at: genUnblockBtn.dataset.blockedAt });
      showAndReload(json, 'AI の停止を解除しました');
      if (!json.ok) genUnblockBtn.disabled = false;
    });
  }


  // 楽天ページ (既存ページに追加 / 新規ページ / 自動判定): 選択で即保存 (2026-09-25)。
  // 保存中は触らせない (続けて変えると応答の順序で表示と DB が食い違う)。失敗したら保存済みの値に戻す
  const existingPageSel = document.getElementById('f-existing-page');
  if (existingPageSel) {
    existingPageSel.addEventListener('change', async () => {
      const note = document.getElementById('existing-page-note');
      note.textContent = '保存中…';
      existingPageSel.disabled = true;
      let json;
      try {
        json = await post(BASE + '/existing-page', { value: existingPageSel.value });
      } catch (e) {
        json = { ok: false, error: '通信エラーで保存できたか分かりません。画面を読み直して確かめてください' };
      } finally {
        existingPageSel.disabled = false;
      }
      if (!json.ok) {
        existingPageSel.value = existingPageSel.dataset.saved || '';
        note.textContent = '';
        alert(json.error || '保存に失敗しました');
        return;
      }
      existingPageSel.dataset.saved = json.choice || '';
      note.textContent = json.auto
        ? `保存しました (自動判定: ${json.existingPage ? '既存ページに追加' : '新規ページ'})`
        : '保存しました';
    });
  }

  // 画像の重要度: 選択で即保存 (基本情報の保存ボタンとは独立。ボードのセレクトと同じ API)
  const imgPrioritySel = document.getElementById('f-image-priority');
  const ownBrandChk = document.getElementById('f-own-brand');
  if (imgPrioritySel) {
    const IMG_PRIORITIES = <%- JSON.stringify(imagePriorities) %>;
    // 画像制作カードは全商品に出る (2026-09-13〜) ので、重要度・自社商品を変えても読み直さない
    const applyPriorityColors = () => {
      const p = IMG_PRIORITIES.find((x) => x.value === imgPrioritySel.value);
      imgPrioritySel.style.background = p ? p.bg : '';
      imgPrioritySel.style.color = p ? p.fg : '';
      imgPrioritySel.style.fontWeight = p ? '600' : '';
    };
    // 重要度と自社商品チェックはどちらも重要度 (image_priority) を書くので、どちらかの保存中は両方触らせない。
    // 重なると古い応答が後から届き、表示と data-saved (簡易LPの定型文が使う) が DB と食い違う (2026-09-17 Codex R2)
    const setPriorityBusy = (busy) => {
      imgPrioritySel.disabled = busy;
      if (ownBrandChk) ownBrandChk.disabled = busy;
      imgPrioritySel.dataset.saving = busy ? '1' : '';
    };
    imgPrioritySel.addEventListener('change', async () => {
      const note = document.getElementById('image-priority-note');
      note.textContent = '保存中…';
      // 保存中は操作させない (Codex R3 medium): 続けて変えると応答の順序で表示と DB が食い違う
      setPriorityBusy(true);
      let json;
      try {
        json = await post(BASE + '/image-priority', { value: imgPrioritySel.value });
      } catch (e) {
        // 通信エラーは「保存されなかった」とは限らない (サーバーは保存済みで応答だけ届かないことがある)。
        // 表示は戻さず、読み直すまで簡易LPのコピーを止める (古い値を入れない)
        json = { ok: false, unknown: true, error: '通信エラーで重要度を保存できたか分かりません。画面を読み直して確かめてください' };
      } finally {
        setPriorityBusy(false);
      }
      if (!json.ok) {
        note.textContent = '';
        if (json.unknown) {
          imgPrioritySel.dataset.unknown = '1';
        } else {
          // 保存できなかった値を出したままにしない (簡易LPの定型文は保存済みの値を入れるので、表示と食い違う)
          imgPrioritySel.value = imgPrioritySel.dataset.saved || '';
          applyPriorityColors();
        }
        alert(json.error || '保存に失敗しました');
        return;
      }
      imgPrioritySel.dataset.saved = json.image_priority || '';
      imgPrioritySel.dataset.unknown = '';
      note.textContent = '保存しました';
      applyPriorityColors();
      // 自社商品チェックと連動 (サーバーが own_brand も保存済み。表示を合わせる)
      if (ownBrandChk && json.own_brand !== undefined) ownBrandChk.checked = !!json.own_brand;
      setTimeout(() => { note.textContent = ''; }, 2000);
    });
    // 自社商品チェック: 変更で即保存し、重要度「自社商品（重要度：高）」と連動する
    // (サーバー側が正: ON→重要度を自社商品へ / OFF→自社商品の重要度なら未設定へ)。
    // 保存は単一チェーンで直列化し、失敗時は表示が失敗した値のままのときだけ戻す (SKU売価と同じ方針)
    if (ownBrandChk) {
      let obChain = Promise.resolve();
      async function saveOwnBrand(value) {
        // 保存が終わるまで触らせない (Codex R5 medium): 連打すると 2 回目がキューに入り、
        // 1 回目の応答で予約した再読込に巻き込まれて中断される。重要度の選択欄も止める (setPriorityBusy)
        setPriorityBusy(true);
        let json;
        try {
          json = await post(BASE + '/own-brand', { value });
        } catch (e) {
          json = { ok: false, unknown: true, error: '通信エラーで自社商品を保存できたか分かりません。画面を読み直して確かめてください' };
        } finally {
          setPriorityBusy(false);
        }
        if (!json.ok) {
          alert(json.error || '自社商品の保存に失敗しました');
          // 通信エラーは連動した重要度も保存できたか分からない。チェックは戻さず、読み直すまで簡易LPのコピーを止める
          if (json.unknown) imgPrioritySel.dataset.unknown = '1';
          else if (ownBrandChk.checked === value) ownBrandChk.checked = !value;
          return;
        }
        // 保存済みの重要度はサーバーが連動させた値 (簡易LPの定型文が使う)
        if (json.image_priority !== undefined) {
          imgPrioritySel.dataset.saved = json.image_priority || '';
          imgPrioritySel.dataset.unknown = '';
        }
        // 後から操作されていなければ、重要度の表示をサーバー確定値に合わせる
        if (ownBrandChk.checked === value && json.image_priority !== undefined) {
          imgPrioritySel.value = json.image_priority || '';
          applyPriorityColors();
        }
        result.textContent = value ? '自社商品に設定しました (画像の重要度も連動)' : '自社商品を解除しました';
      }
      ownBrandChk.addEventListener('change', () => {
        const value = ownBrandChk.checked;
        obChain = obChain.then(() => saveOwnBrand(value));
      });
    }
  }

  // 🚨 欄ごとの即保存と同じ列に並べる (Codex R1)。並行に飛ばすと、ボタンが送った古い値が
  //    後から着いて、直後に打ち直した値を上書きする (画面と DB が食い違い、印も出ない)
  document.getElementById('save-basic-btn').addEventListener('click', () => phEnqueueSave(async () => {
    // 重要度・自社商品チェックの保存中は何も送らない (2026-09-17 Codex 名指し R4)。保存が終わる前に読み直すと、
    // 変更が消えるか、読み直した画面の重要度が DB より古くなる (簡易LPに古い値が入る)
    if (imgPrioritySel && imgPrioritySel.dataset.saving === '1') {
      alert('画像の重要度を保存中です。保存が終わってから、もう一度「基本情報を保存」を押してください');
      return;
    }
    // 同じ理由で、基本情報の保存 (→ 読み直し) の間は重要度・自社商品チェックを触らせない。読み直すなら戻さない
    const lockPriority = (lock) => {
      if (imgPrioritySel) imgPrioritySel.disabled = lock;
      if (ownBrandChk) ownBrandChk.disabled = lock;
    };
    lockPriority(true);
    let reloading = false;
    // 🚨 応答を待っている間に読み直されても「何をいくらで送ったか」が分かるようにする (Codex R2)。
    //    分からないと、自分の保存を他人の変更と誤判定して打ち直した分を捨てる
    let doneSending = () => {};
    let sendSettled = false;
    try {
      // 配送方法・送料・納期 (楽天出品の項目) を基本情報タブに置いたため、先に出品情報も保存する。
      // /rakuten は全項目 upsert なので、部分送信せず collectRakutenFields の全量を送る
      if (!(await saveRakutenFields())) return;
      const basicSnap = phKeep ? phKeep.saving(['basic']) : null;   // 送る値を控えてから送る (Codex R1)
      doneSending = phSending(basicSnap ? basicSnap.map((s) => [s.f.id, s.v]) : []);
      const json = await post(BASE, {
        name: document.getElementById('f-name').value,
        official_url: document.getElementById('f-official-url').value,
        price: document.getElementById('f-price').value,
        // JAN (単品欄) は直前の saveRakutenFields → saveJanIfChanged で保存済みなので、ここでは送らない
        // (送ると同じ値を二重に保存し、更新ログが 2 回残る — Codex R2 low)。
        // バリエーションは SKU表 → /sku-jans。どちらも未送信 = サーバーは既存値を保持
        asin: document.getElementById('f-asin').value,
        amazon_url: document.getElementById('f-amazon-url').value,
        // own_brand は送らない (未送信 = サーバーは既存値を保持)。自社商品チェックは変更した時点で即保存している。
        // 送ると重要度・自社商品の即保存と前後して、古いチェックの状態で保存済みの重要度を戻してしまう
        // (簡易LPの定型文に DB と違う重要度が入る — 2026-09-17 Codex 名指し R2/R3)
        // NE で判定できる商品はキーごと送らない (DB に焼かせない)
        ...hasVariationPayload(),
        // drive_folder_url は画像タブの取込に一本化 (未送信 = サーバーは既存値を保持)
        tax_rate: document.getElementById('y-tax').value,
        memo: document.getElementById('f-memo').value,
      });
      sendSettled = true;
      if (json.ok && phKeep) phKeep.saved(basicSnap);
      reloading = !!json.ok;
      showAndReload(json, '保存しました');
    } finally {
      // 結果が分からない (通信エラー) ときは記録を残す — 上の即保存と同じ理由
      if (sendSettled) doneSending();
      if (!reloading) lockPriority(false);
    }
  }));

  function hasVariationPayload() {
    const el = document.getElementById('f-has-variation');
    return el ? { has_variation: el.checked } : {};
  }

  // ─── 楽天出品 (P3) ───
  const rkResult = document.getElementById('rk-result');
  const rkResultCat = document.getElementById('rk-result-cat');

  // ─── ジャンルツリー選択モーダル (IchibaGenre/Search。RMS の「ジャンルID選択」相当) ───
  const genreModal = document.getElementById('genre-modal');
  let genreSelected = null; // { id, path, hasChildren }

  function setGenreSelection(id, path, hasChildren) {
    genreSelected = { id, path, hasChildren };
    document.getElementById('genre-modal-id').textContent = id;
    document.getElementById('genre-modal-path').textContent = path;
  }

  async function fetchGenreChildrenApi(genreId) {
    const res = await fetch('/apps/product-hub/api/rakuten/genre-children?genre_id=' + encodeURIComponent(genreId));
    return res.json();
  }

  function makeGenreNode(child, parentPath) {
    const row = document.createElement('div');
    row.style.cssText = 'padding:2px 0;';
    const head = document.createElement('div');
    head.style.cssText = 'display:flex; align-items:center; gap:6px; cursor:pointer; padding:3px 6px; border-radius:6px;';
    const arrow = document.createElement('span');
    arrow.textContent = '>';
    arrow.style.cssText = 'width:14px; color:#94a3b8; transition:transform .15s; display:inline-block;';
    const label = document.createElement('span');
    label.textContent = child.name;
    head.appendChild(arrow); head.appendChild(label);
    const box = document.createElement('div'); // 子の入れ物 (遅延読み込み)
    box.style.cssText = 'margin-left:18px; display:none;';
    row.appendChild(head); row.appendChild(box);
    const myPath = parentPath ? parentPath + ' > ' + child.name : child.name;
    let loaded = false;
    head.addEventListener('click', async () => {
      // 行クリック = 選択 + 展開/折り畳み (RMS モーダルと同じ)
      document.querySelectorAll('#genre-tree .genre-row-active').forEach((el) => {
        el.classList.remove('genre-row-active'); el.style.background = '';
      });
      head.classList.add('genre-row-active');
      head.style.background = '#eff6ff';
      if (!loaded) {
        arrow.textContent = '…';
        try {
          const j = await fetchGenreChildrenApi(child.genreId);
          if (!j.ok) {
            // 取得失敗を「末端」と誤判定しない (429/障害でも反映できてしまう) — 選択も確定しない
            arrow.textContent = '>';
            head.style.background = '';
            head.classList.remove('genre-row-active');
            alert('子ジャンルの取得に失敗しました: ' + (j.error || '') + '\nもう一度クリックして再試行してください');
            return;
          }
          loaded = true;
          const kids = j.children || [];
          if (kids.length === 0) {
            arrow.textContent = '・';
            row.dataset.leaf = '1';
          } else {
            arrow.textContent = '>';
            for (const k of kids) box.appendChild(makeGenreNode(k, myPath));
          }
        } catch (e) {
          arrow.textContent = '>';
          head.style.background = '';
          head.classList.remove('genre-row-active');
          alert('通信エラー: ' + e.message);
          return;
        }
      }
      const isLeaf = row.dataset.leaf === '1';
      if (!isLeaf) {
        const open = box.style.display !== 'none';
        box.style.display = open ? 'none' : 'block';
        arrow.style.transform = open ? '' : 'rotate(90deg)';
      }
      setGenreSelection(child.genreId, myPath, !isLeaf);
    });
    return row;
  }

  async function openGenreModal() {
    genreModal.style.display = 'block';
    setGenreSelection('—', '—', true);
    genreSelected = null;
    const tree = document.getElementById('genre-tree');
    tree.textContent = '読み込み中…';
    try {
      const j = await fetchGenreChildrenApi('0');
      if (!j.ok) { tree.textContent = '❌ ' + (j.error || '取得に失敗しました'); return; }
      tree.replaceChildren();
      for (const c of j.children || []) tree.appendChild(makeGenreNode(c, ''));
    } catch (e) { tree.textContent = '通信エラー: ' + e.message; }
  }

  function closeGenreModal() { genreModal.style.display = 'none'; }
  document.getElementById('rk-genre-tree').addEventListener('click', openGenreModal);
  document.getElementById('genre-modal-close').addEventListener('click', closeGenreModal);
  document.getElementById('genre-modal-cancel').addEventListener('click', closeGenreModal);
  genreModal.addEventListener('click', (ev) => { if (ev.target === genreModal) closeGenreModal(); });

  document.getElementById('genre-modal-apply').addEventListener('click', async () => {
    if (!genreSelected || genreSelected.id === '—') { alert('ジャンルを選択してください'); return; }
    if (genreSelected.hasChildren) {
      alert('末端のジャンル (これ以上開けない階層) を選んでください。\n商品を登録できるのは末端ジャンルだけです。');
      return;
    }
    const btn = document.getElementById('genre-modal-apply');
    btn.disabled = true;
    try {
      if (await applyGenre(genreSelected.id, 'tree')) closeGenreModal();
    } finally { btn.disabled = false; }
  });

  // 他社の商品ページURLからジャンルIDを調べる (2026-09-04 中原さん要望)。
  // 商品検索API では引けない (itemCode は内部IDで URL 末尾とは別物) ので、サーバーが
  // 公開ページの埋め込み JSON から読む。読み取れなければ**黙って諦める**(誤ったIDを入れない)
  (function initGenreFromUrl() {
    const btn = document.getElementById('rk-genre-url-btn');
    const input = document.getElementById('rk-genre-url');
    const out = document.getElementById('rk-genre-url-result');
    if (!btn || !input || !out) return;
    let looking = false;   // Enter 連打で複数走らせない (古い応答が新しい結果を上書きする)
    async function lookup() {
      if (looking) return;
      const url = input.value.trim();
      if (!url) { out.textContent = '商品ページの URL を貼ってください'; return; }
      looking = true;
      btn.disabled = true;
      out.textContent = '調べています…';
      try {
        const json = await post('/apps/product-hub/api/rakuten/genre-from-url', { url });
        if (!json.ok) { out.textContent = '❌ ' + (json.error || '調べられませんでした'); return; }
        // 楽天から来た文字列を innerHTML に混ぜない (DOM で組み立てる)
        out.textContent = '';
        const line = document.createElement('div');
        line.append('✅ ジャンルID ');
        const idEl = document.createElement('b');
        idEl.textContent = json.genreId;
        line.append(idEl, ' — ' + (json.path || '(ジャンル名は取得できませんでした)') + ' ');
        const applyBtn = document.createElement('button');
        applyBtn.type = 'button';
        applyBtn.className = 'btn btn-sm';
        applyBtn.textContent = 'このジャンルにする';
        line.append(applyBtn);
        out.append(line);
        if (!json.usable) {
          const warn = document.createElement('div');
          warn.style.color = '#b45309';
          warn.textContent = '⚠ このジャンルは末端でないか、辞書を取得できませんでした。'
            + 'そのままでは登録に使えない可能性があります (「ツリーから選ぶ」で確認してください)';
          out.append(warn);
        }
        applyBtn.addEventListener('click', async () => {
          applyBtn.disabled = true;
          const okApplied = await applyGenre(json.genreId, 'url');
          if (okApplied) out.textContent = '✅ ジャンルID ' + json.genreId + ' を設定しました';
          else applyBtn.disabled = false;
        });
      } catch (e) {
        out.textContent = '❌ 通信エラーで調べられませんでした';
      } finally { looking = false; btn.disabled = false; }
    }
    btn.addEventListener('click', lookup);
    input.addEventListener('keydown', (ev) => { if (ev.key === 'Enter') { ev.preventDefault(); lookup(); } });
  })();

  // ジャンルを反映する共通処理。順序が重要 (Codex R1 High-2/Medium-3):
  //   ① 先に RMS 属性辞書で検証 (末端でない/存在しないジャンルは 404 → 保存しない)
  //   ② genre だけを保存 (genre_only — 編集途中の他フォーム値を巻き込まない)
  //   ③ 成功してから入力欄と辞書 UI を更新
  let applyingGenre = false;
  let initialSuggestRunning = false;  // 初期化フロー中は個別の再提案を抑止する (下の initSuggestions 参照)
  async function applyGenre(genreId, source) {
    if (applyingGenre) return false;
    applyingGenre = true;
    try {
      const vres = await fetch('/apps/product-hub/api/rakuten/genre-attributes?genre_id=' + encodeURIComponent(genreId));
      const vj = await vres.json();
      if (!vj.ok) {
        const msg = 'ジャンル ' + genreId + ' は登録に使えません: ' + (vj.error || '');
        if (source === 'ai') document.getElementById('rk-genre-suggest').textContent = '❌ ' + msg;
        else alert(msg);
        return false;
      }
      const sres = await post(BASE + '/rakuten', { genre_only: true, genre_id: genreId });
      if (!sres.ok) {
        if (source === 'ai') document.getElementById('rk-genre-suggest').textContent = '❌ 保存に失敗: ' + (sres.error || '');
        else alert(sres.error || 'ジャンルの保存に失敗しました');
        return false;
      }
      document.getElementById('rk-genre').value = genreId;
      document.getElementById('rk-genre-fetch').click(); // 辞書はキャッシュ済みなので即応答
      if (source === 'ai') rkResultCat.textContent = 'AIがジャンルを設定しました (違う場合は「ツリーから選ぶ」で修正)';
      // ジャンルが確定するとフルパスで店舗内カテゴリの採点精度が上がる → AI候補を出し直す
      // (初期化フローでは最後に一度だけ呼ぶので、ここでは呼ばない)
      if (!initialSuggestRunning && typeof suggestShopCats === 'function') suggestShopCats(true);
      return true;
    } finally { applyingGenre = false; }
  }

  // ─── AI がジャンルの初期値を入れる (中原さん 2026-07-28) ───
  // 商品名で楽天市場を検索し、上位ヒット商品のジャンル多数決。人は違うと思ったらツリーで直す
  async function suggestGenre(autoApply) {
    const box = document.getElementById('rk-genre-suggest');
    box.textContent = 'AIがジャンルを探しています… (楽天市場の類似商品から)';
    try {
      const res = await fetch(BASE + '/rakuten/genre-suggest');
      const j = await res.json();
      if (!j.ok) { box.textContent = '提案できませんでした: ' + (j.error || ''); return; }
      const cands = (j.candidates || []).filter((c) => c.path);
      if (cands.length === 0) { box.textContent = '類似商品が見つかりませんでした。「ツリーから選ぶ」で指定してください'; return; }
      // 自動適用は「明確な多数」のときだけ (Codex R1 High-2):
      //   最多候補が 5 件以上 かつ 2位の2倍以上。曖昧なら候補ボタンだけ出して人に選ばせる
      const clearWinner = cands[0].count >= 5 && (cands.length < 2 || cands[0].count >= cands[1].count * 2);
      if (autoApply && clearWinner && !document.getElementById('rk-genre').value.trim()) {
        await applyGenre(cands[0].genreId, 'ai');
      }
      box.replaceChildren();
      const lbl = document.createElement('span');
      lbl.className = 'muted';
      lbl.textContent = 'AI提案: ';
      box.appendChild(lbl);
      cands.forEach((c) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn btn-sm';
        b.style.cssText = 'margin:2px 4px 2px 0; font-size:11px;';
        b.textContent = c.path + ' (' + c.count + '件)';
        b.addEventListener('click', () => applyGenre(c.genreId, 'ai'));
        box.appendChild(b);
      });
    } catch (e) { box.textContent = '通信エラー: ' + e.message; }
  }
  // 初期値の自動入力は、店舗内カテゴリの提案関数を定義したあとで直列に実行する (initSuggestions)

  // ─── 店舗内カテゴリ: RMS「表示先カテゴリ 1〜5」の5枠 + アコーディオンのツリー (2026-08-02) ───
  // 枠の順序 = 保存順 = RMS の枠番。枠1 が item-mappings の mainPluralCategoryId (メインページ)。
  // 外から使う口: getShopCatOrderedIds() = 枠順の id 配列 / setShopCatChecked(id, on) = AI適用・候補ボタン用
  const SHOP_CAT_MAX_SLOTS = 5;
  let getShopCatOrderedIds = () => [];
  let setShopCatChecked = () => false;
  (function buildShopCategoryTree() {
    const dataEl = document.getElementById('rk-cats-data');
    const holder = document.getElementById('rk-cats');
    if (!dataEl || !holder) return;
    let rows = [];
    try { rows = JSON.parse(dataEl.textContent); } catch (e) { rows = []; }
    const byId = new Map(rows.map((r) => [Number(r.id), r]));
    // 枠順の id 配列。初期値 = 保存済みの slot 順
    const order = rows.filter((r) => r.selected)
      .sort((a, b) => (a.slot ?? 99) - (b.slot ?? 99) || Number(a.id) - Number(b.id))
      .map((r) => Number(r.id));
    getShopCatOrderedIds = () => order.slice();

    const slotsEl = document.getElementById('rk-cat-slots');
    function renderSlots() {
      if (!slotsEl) return;
      slotsEl.replaceChildren();
      for (let i = 0; i < SHOP_CAT_MAX_SLOTS; i++) {
        const id = order[i];
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:8px; font-size:13px;';
        const num = document.createElement('span');
        num.textContent = String(i + 1);
        num.style.cssText = 'width:18px; text-align:right; color:#94a3b8; font-size:12px;';
        row.appendChild(num);
        const boxEl = document.createElement('div');
        if (id != null) {
          boxEl.style.cssText = 'flex:1; padding:6px 10px; border:1px solid #cbd5e1; border-radius:6px; background:#fff; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;';
          boxEl.textContent = byId.get(id)?.path || id;
          boxEl.title = (i === 0 ? '枠1 = メインページ設定\n' : '') + (byId.get(id)?.path || '');
          row.appendChild(boxEl);
          if (i === 0 && order.length > 1) {
            const mainTag = document.createElement('span');
            mainTag.textContent = 'メイン';
            mainTag.style.cssText = 'font-size:10px; color:#1d4ed8; background:#dbeafe; border-radius:4px; padding:1px 5px; white-space:nowrap;';
            row.appendChild(mainTag);
          }
          const clear = document.createElement('button');
          clear.type = 'button';
          clear.className = 'btn btn-sm';
          clear.textContent = 'クリア';
          clear.addEventListener('click', () => setShopCatChecked(id, false));
          row.appendChild(clear);
        } else {
          boxEl.style.cssText = 'flex:1; padding:6px 10px; border:1px dashed #e2e8f0; border-radius:6px; color:#cbd5e1;';
          boxEl.textContent = '(未設定)';
          row.appendChild(boxEl);
        }
        slotsEl.appendChild(row);
      }
    }

    // チェック状態と order の唯一の更新経路 (ツリーのチェック・AI適用・候補ボタン・クリアが全部ここを通る)
    setShopCatChecked = (id, on) => {
      id = Number(id);
      const cb = holder.querySelector('.rk-cat-check[value="' + id + '"]');
      const idx = order.indexOf(id);
      if (on) {
        if (idx !== -1) return true; // 既に入っている
        if (order.length >= SHOP_CAT_MAX_SLOTS) {
          alert('店舗内カテゴリは ' + SHOP_CAT_MAX_SLOTS + ' 枠までです (RMSの「表示先カテゴリ」と同じ)。先にどれかをクリアしてください');
          if (cb) cb.checked = false;
          return false;
        }
        order.push(id);
        if (cb) cb.checked = true;
      } else {
        if (idx !== -1) order.splice(idx, 1);
        if (cb) cb.checked = false;
      }
      renderSlots();
      return true;
    };
    // path を ' > ' で割ってツリー構造にする。実在する行 (id あり) だけ checkbox
    const root = { children: new Map(), row: null, name: '' };
    for (const r of rows) {
      const segs = String(r.path).split(' > ');
      let node = root;
      for (const seg of segs) {
        if (!node.children.has(seg)) node.children.set(seg, { children: new Map(), row: null, name: seg });
        node = node.children.get(seg);
      }
      node.row = r;
    }
    function renderNode(node, fullPath) {
      const wrap = document.createElement('div');
      wrap.className = 'rk-cat-node';
      wrap.dataset.path = fullPath.toLowerCase();
      const head = document.createElement('div');
      head.className = 'rk-cat-row';
      head.style.cssText = 'display:flex; align-items:center; gap:4px; padding:2px 0;';
      const hasKids = node.children.size > 0;
      const arrow = document.createElement('span');
      arrow.textContent = hasKids ? '>' : '・';
      arrow.style.cssText = 'width:14px; color:#94a3b8; cursor:' + (hasKids ? 'pointer' : 'default') + '; display:inline-block; transition:transform .15s;';
      head.appendChild(arrow);
      let box = null;
      const toggle = () => {
        if (!box) return;
        const open = box.style.display !== 'none';
        box.style.display = open ? 'none' : 'block';
        arrow.style.transform = open ? '' : 'rotate(90deg)';
      };
      if (node.row) {
        const label = document.createElement('label');
        label.style.cssText = 'font-size:13px; font-weight:400; cursor:pointer; display:inline-flex; align-items:center; gap:4px; margin:0;';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'rk-cat-check';
        cb.value = String(node.row.id);
        cb.checked = !!node.row.selected;
        cb.style.width = 'auto';
        // チェック操作は order 管理を通す (5枠上限・枠表示の更新)
        cb.addEventListener('change', () => setShopCatChecked(node.row.id, cb.checked));
        label.appendChild(cb);
        label.appendChild(document.createTextNode(node.name + (node.row.inactive ? ' (現在の一覧に無いカテゴリ)' : '')));
        head.appendChild(label);
      } else {
        const span = document.createElement('span');
        span.textContent = node.name;
        span.style.cssText = 'font-size:13px; cursor:' + (hasKids ? 'pointer' : 'default') + ';';
        span.addEventListener('click', toggle);
        head.appendChild(span);
      }
      wrap.appendChild(head);
      if (hasKids) {
        box = document.createElement('div');
        box.style.cssText = 'margin-left:16px; display:none;';
        for (const child of node.children.values()) {
          box.appendChild(renderNode(child, fullPath ? fullPath + ' > ' + child.name : child.name));
        }
        wrap.appendChild(box);
        arrow.addEventListener('click', toggle);
      }
      return wrap;
    }
    holder.replaceChildren();
    for (const child of root.children.values()) {
      holder.appendChild(renderNode(child, child.name));
    }
    // 選択済みノードが見えるように、そこまでの枝を開く
    holder.querySelectorAll('.rk-cat-check').forEach((cb) => {
      if (!cb.checked) return;
      let el = cb.closest('.rk-cat-node');
      while (el && el.parentElement && el.parentElement !== holder) {
        const p = el.parentElement;
        if (p.style && p.style.display === 'none') p.style.display = 'block';
        el = p;
      }
    });
    renderSlots();
  })();

  // ─── 店舗内カテゴリ: AI 初期候補 (2026-08-02 中原さん要望「AIが最初に設定して人が修正」) ───
  let shopCatSaveChain = Promise.resolve();
  async function suggestShopCats(autoApply) {
    const box = document.getElementById('rk-cats-suggest');
    if (!box) return; // マスタ未取込
    box.textContent = 'AIが店舗内カテゴリを探しています…';
    const findCb = (id) => document.querySelector('.rk-cat-check[value="' + id + '"]');
    const revealCb = (cb) => { // チェックしたノードまでの枝を開く (選択済み展開と同じ方式)
      let el = cb.closest('.rk-cat-node');
      while (el && el.id !== 'rk-cats') {
        const p = el.parentElement;
        if (p && p.style && p.style.display === 'none') p.style.display = 'block';
        el = p;
      }
    };
    // 保存は直列化する (Codex R1 medium: 候補ボタン連打で古い選択集合が後着し逆転するのを防ぐ)。
    // ids はチェーン実行時点の枠順 (order) から読むので、最後のクリックの状態が最後に届く
    const saveChecked = (source) => {
      shopCatSaveChain = shopCatSaveChain
        .catch(() => {})
        .then(() => post(BASE + '/shop-categories', { ids: getShopCatOrderedIds(), source }));
      return shopCatSaveChain;
    };
    try {
      const res = await fetch(BASE + '/rakuten/shop-category-suggest');
      const j = await res.json();
      if (!j.ok) { box.textContent = ''; return; }
      const cands = j.candidates || [];
      if (cands.length === 0) {
        box.textContent = 'AI候補が見つかりませんでした (ジャンルを設定すると精度が上がります)';
        box.className = 'muted';
        return;
      }
      let autoMsg = '';
      // 自動セットの可否はサーバー判定 (j.autoApply = 未保存 かつ 末端完全一致 かつ 単独1位)。
      // 一度保存されたら (0件保存=人が外した も含む) 二度と自動では入れない
      if (autoApply && j.autoApply && getShopCatOrderedIds().length === 0) {
        const cb = findCb(cands[0].id);
        if (cb && setShopCatChecked(cands[0].id, true)) {
          revealCb(cb);
          const r = await saveChecked('ai');
          // skipped = 送信中に人が保存していた → サーバーが書き込みを拒否したのでチェックも戻す
          if (r.ok && !r.skipped) autoMsg = 'AIが設定: ' + cands[0].path + ' (違うときは外して選び直してください)';
          else setShopCatChecked(cands[0].id, false);
        }
      }
      const render = () => {
        box.replaceChildren();
        const lbl = document.createElement('span');
        lbl.className = 'muted';
        lbl.textContent = (autoMsg ? '✅ ' + autoMsg + ' ／ ' : '') + 'AI候補: ';
        box.appendChild(lbl);
        cands.forEach((c) => {
          const cb = findCb(c.id);
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'btn btn-sm';
          b.style.cssText = 'margin:2px 4px 2px 0; font-size:11px;'
            + (cb && cb.checked ? ' background:#dcfce7; border-color:#86efac;' : '');
          b.textContent = (cb && cb.checked ? '✓ ' : '') + c.path;
          b.addEventListener('click', async () => {
            if (!cb) return;
            const turningOn = !cb.checked;
            if (!setShopCatChecked(c.id, turningOn)) return; // 5枠上限で拒否
            if (turningOn) revealCb(cb);
            const r = await saveChecked('ai_candidate');
            if (!r.ok) { setShopCatChecked(c.id, !turningOn); alert(r.error || '保存に失敗しました'); return; }
            result.textContent = '店舗内カテゴリを保存しました (' + r.count + '件)';
            render();
          });
          box.appendChild(b);
        });
      };
      render();
    } catch (e) { box.textContent = ''; }
  }
  // ─── 初期値の自動入力: ジャンル → 店舗内カテゴリ の順で直列に走らせる (Codex R4 high) ───
  // 並行に走らせると、ローカル計算で速い店舗内カテゴリの提案が先に「商品名だけの候補」で保存され、
  // その保存記録のせいで、後から決まったジャンルを加味した候補が二度と自動適用されなくなる。
  (async function initSuggestions() {
    if (!document.getElementById('rk-genre').value.trim()) {
      initialSuggestRunning = true;
      try { await suggestGenre(true); } catch (e) { /* 提案できなくても後続は動かす */ }
      initialSuggestRunning = false;
    }
    if (document.getElementById('rk-cats-suggest')) suggestShopCats(true);
  })();

  // ─── このジャンルで使える属性の候補ボタン (2026-08-31 中原さん要望) ───
  // 何を入れられるかが分からず、既存の類似商品を開いて確認しながら手打ちしていた。
  // 辞書にある属性をボタンで並べ、押した分だけ行が増える形にする
  // (全部を最初から行にすると、ジャンルによっては入力欄が数十行になって邪魔になる)。
  let attrDict = [];
  let modelAttrName = 'メーカー型番';
  try { attrDict = JSON.parse(document.getElementById('rk-attrdict-json').textContent) || []; } catch (e) {}
  try { modelAttrName = JSON.parse(document.getElementById('rk-model-attr-json').textContent) || modelAttrName; } catch (e) {}

  // バリエーションの SKU 表に行を足す関数 (initSkuGrid が差し替える。単品は null のまま = #rk-attrs の行)
  let addGridRow = null;
  function attrNamesInForm() {
    const names = new Set();
    document.querySelectorAll('#rk-attrs tbody tr .rk-attr-name').forEach((el) => {
      const v = String(el.value || '').trim();
      if (v) names.add(v);
    });
    document.querySelectorAll('#rk-sku-grid tr.sku-grid-attr').forEach((tr) => {
      const v = String(tr.dataset.name || '').trim();
      if (v) names.add(v);
    });
    return names;
  }

  // 今のジャンルの辞書に無い属性を目立たせる (2026-09-04 中原さん要望)。
  // ジャンルを差し替えると、前のジャンルでだけ必要だった属性が行に残る。値は消さない方が
  // 正しい (同じ属性名なら使い回せる) 一方、辞書に無い属性は**出品直前のチェックで
  // IE1002 として弾かれる**ので、差し替えたその場で気づけるようにする。
  // 消す手段は各行の × ボタン (既にある) に任せる
  function markAttrsNotInGenre() {
    const box = document.getElementById('rk-attr-unknown');
    const known = new Set(attrDict.map((a) => a.name));
    const stale = [];
    // 装飾はクラスの付け外しで行う。addAttrRow が必須属性の枠色をインラインで塗っているので、
    // style を直接書き換えると正常な必須属性の表示を消してしまう (Codex R3)
    const paint = (el, name) => {
      const bad = !!name && known.size > 0 && !known.has(name);
      el.classList.toggle('attr-unknown', bad);
      el.title = bad ? 'このジャンルの属性辞書にありません。このままだと出品時に IE1002 で止まります' : '';
      if (bad && !stale.includes(name)) stale.push(name);
    };
    document.querySelectorAll('#rk-attrs tbody tr .rk-attr-name').forEach((el) => {
      paint(el, String(el.value || '').trim());
    });
    document.querySelectorAll('#rk-sku-grid tr.sku-grid-attr').forEach((tr) => {
      const th = tr.querySelector('th');
      if (th) paint(th, String(tr.dataset.name || '').trim());
    });
    if (!box) return;
    box.textContent = '';
    if (attrDict.length === 0 || stale.length === 0) return;
    const msg = document.createElement('div');
    msg.style.cssText = 'font-size:12px; color:#b45309; border:1px solid #fcd34d; background:#fffbeb; border-radius:6px; padding:6px 8px;';
    msg.textContent = '⚠ いまのジャンルに無い属性が ' + stale.length + ' 件あります: ' + stale.join(' / ')
      + '　このままだと出品時に止まります (登録エラー IE1002)。表の × で外してください';
    box.appendChild(msg);
  }

  // ─── 選択式の属性はセレクトで選ばせる (2026-09-20 中原さん) ───
  // 「ジャンル情報を取得」で楽天の選択肢 (options) まで取れた属性だけ。取れていない属性・複数の値を
  // 入れられる属性は今まで通りの入力欄 (+ 注意書き) のまま = 選択肢が欠けたセレクトで正しい値を選べなくしない。
  // いまの値が選択肢に無いときは黙って消さず、その値を選んだ状態で残して選び直しを促す
  const SELECTIVE_NOTE = '⚠️ 選択式 — 楽天が用意した値と同じ表記でないと登録に失敗します (自由入力できません)';
  function selectOptionsOf(meta) {
    if (!meta || meta.inputMethod !== 'SELECTIVE' || !Array.isArray(meta.options) || meta.options.length === 0) return null;
    if (meta.multiValueLimit != null && meta.multiValueLimit > 1) return null;
    return meta.options;
  }
  function selectiveDatalistId(meta) {
    if (!meta || meta.inputMethod !== 'SELECTIVE' || !Array.isArray(meta.options) || meta.options.length === 0) return '';
    const id = 'rk-attr-dl-' + attrDict.indexOf(meta);
    let dl = document.getElementById(id);
    if (!dl) { dl = document.createElement('datalist'); dl.id = id; document.body.appendChild(dl); }
    // 中身で見比べる (名前と件数だけだと、同じ件数の入れ替えを見逃す — Codex R1 medium)
    const sig = JSON.stringify([meta.name, meta.options]);
    if (dl.dataset.sig !== sig) {
      dl.textContent = '';
      dl.dataset.sig = sig;
      for (const o of meta.options) { const op = document.createElement('option'); op.value = o; dl.appendChild(op); }
    }
    return id;
  }
  function syncSelectiveInputs() {
    document.querySelectorAll('#rk-attrs tbody tr').forEach((tr) => {
      const nameEl = tr.querySelector('.rk-attr-name');
      const cur = tr.querySelector('.rk-attr-value');
      if (!nameEl || !cur) return;   // 固定行 (カタログID・メーカー型番)
      const meta = attrDict.find((a) => a.name === nameEl.value.trim()) || null;
      const value = cur.value;
      const options = value.includes('|') ? null : selectOptionsOf(meta);
      let el = cur;
      // 取り直して選択肢が変わったら作り直す (値は残し、選択肢にあるかも見直す — Codex R1 medium)
      const sig = options ? JSON.stringify([meta.name, options]) : '';
      if (options && (cur.tagName !== 'SELECT' || cur.dataset.sig !== sig)) {
        el = document.createElement('select');
        el.className = 'rk-attr-value';
        el.dataset.sig = sig;
        const head = document.createElement('option');
        head.value = ''; head.textContent = '(選んでください)';
        el.appendChild(head);
        if (value.trim() && !options.includes(value.trim())) {
          const keep = document.createElement('option');
          keep.value = value; keep.textContent = '⚠️ ' + value + ' (楽天の選択肢にありません)';
          keep.dataset.unknown = '1';
          el.appendChild(keep);
        }
        for (const o of options) { const op = document.createElement('option'); op.value = o; op.textContent = o; el.appendChild(op); }
        el.value = options.includes(value.trim()) ? value.trim() : value;
        cur.replaceWith(el);
      } else if (!options && cur.tagName === 'SELECT') {
        el = document.createElement('input');
        el.type = 'text'; el.className = 'rk-attr-value'; el.value = value;
        cur.replaceWith(el);
      }
      if (el.tagName === 'INPUT') {
        const dl = selectiveDatalistId(meta);
        if (dl) el.setAttribute('list', dl); else el.removeAttribute('list');
      }
      // 注意書き: セレクトで選べているなら要らない。選択肢に無い値が残っているときは選び直しを促す
      let note = tr.querySelector('.rk-attr-selective');
      const picked = el.tagName === 'SELECT' ? el.selectedOptions[0] : null;
      const text = el.tagName === 'SELECT'
        ? (picked && picked.dataset.unknown ? '⚠️ いまの値は楽天の選択肢にありません。このままだと登録に失敗します — 選び直してください' : '')
        : (meta && meta.inputMethod === 'SELECTIVE' ? SELECTIVE_NOTE : '');
      if (text && !note) {
        note = document.createElement('div');
        note.className = 'muted rk-attr-selective';
        note.style.cssText = 'font-size:11px; color:#b45309;';
        el.parentNode.appendChild(note);
      }
      if (note) { note.textContent = text; note.style.display = text ? '' : 'none'; }
    });
    // バリエーションの SKU 表: セルは即保存・「|」区切りの複数値があるので入力欄のまま、候補だけ出す
    document.querySelectorAll('#rk-sku-grid tr.sku-grid-attr').forEach((tr) => {
      const meta = attrDict.find((a) => a.name === String(tr.dataset.name || '').trim()) || null;
      const dl = selectiveDatalistId(meta);
      tr.querySelectorAll('.sku-attr-input').forEach((c) => { if (dl) c.setAttribute('list', dl); else c.removeAttribute('list'); });
    });
  }

  function renderAttrSuggest() {
    markAttrsNotInGenre();
    syncSelectiveInputs();
    const box = document.getElementById('rk-attr-suggest');
    if (!box) return;
    box.textContent = '';
    if (attrDict.length === 0) return;
    const used = attrNamesInForm();
    // 画面に入口を持たない属性は候補に出さない:
    //   メーカー型番 = 上の「メーカー型番」欄が入口 / カタログID = JAN欄から自動送信
    const rest = attrDict.filter((a) => a.name !== modelAttrName && a.name !== 'カタログID' && !used.has(a.name));
    if (rest.length === 0) return;
    const head = document.createElement('div');
    head.className = 'muted';
    head.style.fontSize = '11px';
    head.style.marginBottom = '4px';
    head.textContent = 'このジャンルで使える属性 (押すと行が増えます) — 残り ' + rest.length + ' 件';
    box.appendChild(head);
    const wrap = document.createElement('div');
    wrap.style.display = 'flex';
    wrap.style.flexWrap = 'wrap';
    wrap.style.gap = '4px';
    // 必須を先に、その中は辞書の並び順のまま (RMS の並びと揃える)
    const sorted = rest.slice().sort((a, b) => (b.mandatory ? 1 : 0) - (a.mandatory ? 1 : 0));
    for (const a of sorted) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn btn-sm';
      b.style.fontSize = '12px';
      b.style.padding = '3px 9px';
      if (a.mandatory) { b.style.borderColor = '#fca5a5'; b.style.color = '#b91c1c'; b.style.fontWeight = '600'; }
      b.textContent = (a.mandatory ? '*' : '') + a.name;
      b.title = [a.mandatory ? '必須' : '任意', a.inputMethod === 'SELECTIVE' ? '選択式' : null,
                 a.unit ? '単位:' + a.unit : null, a.maxLength ? '〜' + a.maxLength + '文字' : null]
                 .filter(Boolean).join(' / ');
      b.addEventListener('click', () => {
        if (addGridRow) {  // バリエーションの SKU 表: 行を足して最初の SKU のセルへ
          const trg = addGridRow(a.name, a);
          renderAttrSuggest();
          const cell = trg.querySelector('.sku-attr-input');
          if (cell) cell.focus();
          updateTabBadges();
          return;
        }
        // 名前も値も空の行が余っていれば、そこを使う (押すたびに空行が増えない)
        const blank = [...document.querySelectorAll('#rk-attrs tbody tr')].find((tr) => {
          const nameEl = tr.querySelector('.rk-attr-name');   // 固定行 (メーカー型番) は対象外
          return nameEl && !nameEl.value.trim() && !tr.querySelector('.rk-attr-value').value.trim();
        });
        if (blank) blank.remove();
        const tr = addAttrRow(a.name, '', a);
        renderAttrSuggest();
        const v = tr.querySelector('.rk-attr-value');
        if (v) v.focus();
        updateTabBadges();
      });
      wrap.appendChild(b);
    }
    box.appendChild(wrap);
  }

  // ─── ジャンル情報を取得 (Genre API) → 必須属性の行を自動生成 ───
  function addAttrRow(name, value, meta) {
    const tr = document.createElement('tr');
    const hint = meta
      ? [meta.mandatory ? '必須' : null, meta.inputMethod === 'SELECTIVE' ? '選択式' : null,
         meta.unit ? '単位:' + meta.unit : null, meta.maxLength ? '〜' + meta.maxLength + '文字' : null]
          .filter(Boolean).join(' / ')
      : '';
    const selective = !!(meta && meta.inputMethod === 'SELECTIVE');
    tr.innerHTML = '<td><input type="text" class="rk-attr-name">'
      + (hint ? '<div class="muted" style="font-size:11px;"></div>' : '') + '</td>'
      + '<td><input type="text" class="rk-attr-value">'
      + (selective ? '<div class="muted rk-attr-selective" style="font-size:11px; color:#b45309;"></div>' : '') + '</td>'
      + '<td><button type="button" class="btn btn-sm rk-attr-del">×</button></td>';
    tr.querySelector('.rk-attr-name').value = name || '';
    tr.querySelector('.rk-attr-value').value = value || '';
    if (hint) tr.querySelector('td div').textContent = hint;
    // 選択式は自由入力できない (2026-09-02 代表カラーの IE0418)。値欄の直下に出す
    if (selective) {
      tr.querySelector('.rk-attr-selective').textContent = SELECTIVE_NOTE;
    }
    if (meta && meta.mandatory) tr.querySelector('.rk-attr-name').style.borderColor = '#fca5a5';
    document.querySelector('#rk-attrs tbody').appendChild(tr);
    return tr;
  }

  // ジャンルIDを書き換えたら旧ジャンルの候補は消す (Codex R1 medium)。
  // 残っていると、新しいジャンルでは使えない属性行を押して追加できてしまう
  {
    const genreInput = document.getElementById('rk-genre');
    if (genreInput) {
      let lastGenre = genreInput.value.trim();
      genreInput.addEventListener('input', () => {
        if (genreInput.value.trim() === lastGenre) return;
        lastGenre = genreInput.value.trim();
        attrDict = [];
        renderAttrSuggest();
      });
    }
  }

  document.getElementById('rk-genre-fetch').addEventListener('click', async () => {
    const genreId = document.getElementById('rk-genre').value.trim();
    const info = document.getElementById('rk-genre-info');
    if (!genreId) { info.textContent = 'ジャンルIDを入力してください'; return; }
    const btn = document.getElementById('rk-genre-fetch');
    btn.disabled = true;
    info.textContent = '取得中…';
    try {
      const res = await fetch('/apps/product-hub/api/rakuten/genre-attributes?genre_id=' + encodeURIComponent(genreId));
      const j = await res.json();
      // 取得中に別のジャンルIDへ書き換えられていたら、この応答は捨てる
      // (古いジャンルの必須行が現在のフォームへ混入するのを防ぐ — Codex R1 Medium-3)
      if (document.getElementById('rk-genre').value.trim() !== genreId) return;
      if (!j.ok) { info.textContent = '❌ ' + (j.error || '取得に失敗しました'); return; }
      const g = j.genre;
      const mandatory = (g.attributes || []).filter((a) => a.mandatory);
      mandatoryAttrNames = mandatory.map((a) => a.name); // バッジの必須属性リストも更新
      info.innerHTML = '';
      const ok = document.createElement('span');
      ok.style.color = '#166534';
      ok.textContent = '✅ ' + (g.genrePath || g.genreName || genreId);
      const mut = document.createElement('span');
      mut.className = 'muted';
      mut.textContent = ' (必須属性 ' + mandatory.length + ' 件)';
      info.appendChild(ok); info.appendChild(mut);

      // 既存行の属性名を集め、無い必須属性だけ行を足す (人の入力は消さない)
      const present = attrNamesInForm();
      document.querySelectorAll('#rk-attrs tbody tr').forEach((tr) => {
        const nameEl = tr.querySelector('.rk-attr-name');
        if (!nameEl) return;   // 固定行 (カタログID・メーカー型番) は消さない
        // 空行 (name も value も空) は整理して詰める
        if (!nameEl.value.trim() && !tr.querySelector('.rk-attr-value').value.trim()) tr.remove();
      });
      // 候補ボタン用の辞書も新しいジャンルのものに差し替える (2026-08-31)
      attrDict = (g.attributes || []).map((a) => ({
        name: a.name, mandatory: !!a.mandatory, inputMethod: a.inputMethod || null,
        unit: a.unit || null, maxLength: a.maxLength || null, multiValueLimit: a.multiValueLimit || null,
        options: Array.isArray(a.options) ? a.options : null,
      }));
      let added = 0;
      for (const a of mandatory) {
        if (present.has(a.name)) continue;
        if (a.name === 'カタログID') continue; // 表の「カタログID」の行 (JAN) から自動送信される
        if (addGridRow) { addGridRow(a.name, a); added += 1; continue; } // バリエーション: メーカー型番も普通の行
        if (a.name === modelAttrName) continue; // 単品: 「メーカー型番」の固定行から自動送信される (2026-08-31)
        addAttrRow(a.name, '', a);
        added += 1;
      }
      renderAttrSuggest();
      if ((g.attributes || []).some((a) => a.name === 'カタログID')) {
        const note = document.createElement('div');
        note.className = 'muted';
        note.style.fontSize = '11px';
        note.textContent = 'ℹ️ このジャンルはカタログIDが属性にあります。表の「カタログID」の行の JAN が SKU ごとに自動で送られます。';
        info.appendChild(note);
      }
      if ((g.attributes || []).some((a) => a.name === modelAttrName) && !addGridRow) {
        const note2 = document.createElement('div');
        note2.className = 'muted';
        note2.style.fontSize = '11px';
        note2.textContent = 'ℹ️ このジャンルは' + modelAttrName + 'が属性にあります。表の「' + modelAttrName + '」の行の値が自動で送られます。';
        info.appendChild(note2);
      }
      if (added > 0) rkResultCat.textContent = '必須属性 ' + added + ' 行を追加しました。値を埋めて保存してください';
      updateTabBadges();
    } catch (e) {
      info.textContent = '通信エラー: ' + e.message;
    } finally { btn.disabled = false; }
  });

  // 入力欄のリンクをその場で開くボタン (2026-08-31 中原さん要望)。
  // 空 / http(s) 以外のときは隠す (javascript: を踏ませない)
  function bindOpenLink(inputId, linkId) {
    const input = document.getElementById(inputId);
    const link = document.getElementById(linkId);
    if (!input || !link) return;
    const sync = () => {
      const v = String(input.value || '').trim();
      let ok = false;
      try {
        const u = new URL(v);
        ok = u.protocol === 'http:' || u.protocol === 'https:';
      } catch (e) { ok = false; }
      link.style.display = ok ? '' : 'none';
      if (ok) link.href = v;
      else link.removeAttribute('href');
    };
    input.addEventListener('input', sync);
    input.addEventListener('change', sync);
    sync();
  }
  // Amazon URL: ASIN の取り違えを目で確かめるため (画像登録を依頼する前に商品ページを見に行く)
  bindOpenLink('f-amazon-url', 'f-amazon-open');

  // カメラマンへの撮影依頼の定型文 (2026-08-31 中原さん)。
  // デザインは社内で進めるようになったので、旧デザイナー向け依頼文は使わない
  (function initRequestTemplate() {
    const btn = document.getElementById('ip-request-template');
    const area = document.getElementById('ip-request');
    if (!btn || !area) return;
    btn.addEventListener('click', () => {
      const folder = String((document.getElementById('import-folder-url') || {}).value || '').trim();
      const camera = String((document.getElementById('ip-camera-url') || {}).value || '').trim();
      const lines = [
        'お世話になっています。',
        '下記商品の商品撮影をお願いします。',
        folder || '(画像フォルダのURLが未入力です)',
        camera || '(カメラ撮影指示URLが未入力です)',
      ];
      const text = lines.join(String.fromCharCode(10));
      // すでに書いてある文を黙って消さない (書き足した内容が失われるため)
      if (area.value.trim() && !confirm('依頼文を定型文で置き換えます。いま書いてある内容は消えます。よろしいですか?')) return;
      area.value = text;
      area.focus();
      const note = document.getElementById('ip-request-template-note');
      if (note) {
        note.textContent = (folder && camera)
          ? '定型文を入れました。「画像制作情報を保存」で保存してください'
          : '定型文を入れました (未入力のURLは括弧書きのままです)';
      }
    });
  })();

  // 画像フォルダのリンク (Amazon URL と同じ共通関数で開く)
  bindOpenLink('import-folder-url', 'import-folder-open');

  document.getElementById('rk-attr-add').addEventListener('click', () => {
    if (addGridRow) {
      // バリエーションの SKU 表: 項目名を聞いて行を足す (辞書に無い名前は登録時に IE1002 で止まる)
      const name = prompt('追加する項目名 (RMS の属性名と同じ表記で)');
      if (name === null) return;
      const n = name.trim();
      if (!n) return;
      if (n === 'カタログID') { alert('カタログID (JAN) は表の「カタログID」の行で入力してください'); return; }
      const meta = attrDict.find((a) => a.name === n) || null;
      const tr = addGridRow(n, meta);
      renderAttrSuggest();
      const cell = tr.querySelector('.sku-attr-input');
      if (cell) cell.focus();
      return;
    }
    const tr = document.createElement('tr');
    tr.innerHTML = '<td><input type="text" class="rk-attr-name"></td>'
      + '<td><input type="text" class="rk-attr-value"></td>'
      + '<td><button type="button" class="btn btn-sm rk-attr-del">×</button></td>';
    document.querySelector('#rk-attrs tbody').appendChild(tr);
  });
  // 手で属性名を打ち替えたときも候補を合わせる (打った属性は候補から消え、消した属性は戻る)
  // (#rk-attrs は単品のときだけある。バリエーションは #rk-sku-grid)
  const rkAttrsTable = document.getElementById('rk-attrs');
  if (rkAttrsTable) {
    rkAttrsTable.addEventListener('input', (ev) => {
      if (ev.target.classList && ev.target.classList.contains('rk-attr-name')) renderAttrSuggest();
    });
    // セレクトで選び直したら「選択肢にありません」の注意書きを外す
    rkAttrsTable.addEventListener('change', (ev) => {
      if (ev.target.tagName === 'SELECT' && ev.target.classList.contains('rk-attr-value')) syncSelectiveInputs();
    });
    rkAttrsTable.addEventListener('click', (ev) => {
      const del = ev.target.closest && ev.target.closest('.rk-attr-del');
      if (del) { del.closest('tr').remove(); renderAttrSuggest(); }
    });
  }

  // メーカー型番の競合 (欄と商品属性に別の値がある) を人が解消したかどうか。
  // ボタンで選んだときだけ true になり、サーバはそのとき旧値を捨てる (黙って捨てない)。
  // 例外: 旧値を欄へ引き上げて表示している状態は、その値が画面に見えているので最初から true
  let modelConflictResolved = <%= modelAutoResolve ? 'true' : 'false' %>;
  // この画面を描いた時点で商品属性側にあった メーカー型番 (楽観ロックの照合用)
  const modelSeenValues = <%- JSON.stringify(legacyModels).replace(/</g, '\\u003c') %>;

  function collectRakutenFields() {
    const attrs = [];
    document.querySelectorAll('#rk-attrs tbody tr').forEach((tr) => {
      const nameEl = tr.querySelector('.rk-attr-name');
      if (!nameEl) return;   // メーカー型番の固定行は article_number として別送 (属性に混ぜない)
      attrs.push({
        name: nameEl.value,
        value: tr.querySelector('.rk-attr-value').value,
      });
    });
    // 単品だけにある欄 (バリエーションは SKU 表で SKU ごとに即保存 → ここからは送らない = サーバーは既存維持)
    const rkArticle = document.getElementById('rk-article');
    const rkExemption = document.getElementById('rk-catalog-exemption');
    return {
      genre_id: document.getElementById('rk-genre').value,
      ...(rkArticle ? { article_number: rkArticle.value } : {}),
      // カタログID (JAN) 本体はここから送らない (saveJanIfChanged が基本情報 API へ送る)。ここは「IDなしの理由」だけ
      ...(rkExemption ? { catalog_id_exemption_reason: rkExemption.value } : {}),
      // バリエーションの項目名 (カラバリのときだけ欄がある。無ければ送らない = 既存維持)
      ...(document.getElementById('rk-variant-selector')
        ? { variant_selector_name: document.getElementById('rk-variant-selector').value }
        : {}),
      ...(document.getElementById('rk-attrs') ? { attributes: attrs } : {}),
      // メーカー型番の競合を人が解消したときだけ true (サーバはこのとき旧値を捨てる)
      resolve_model_conflict: modelConflictResolved,
      // 画面を開いたとき属性側に見えていた型番。サーバはこれと DB が一致するときだけ
      // 捨てることを許す (別タブで変わっていたら 409。見ていない値を消さない)
      model_conflict_seen: modelSeenValues,
      shop_category_ids: getShopCatOrderedIds(),   // 枠順 (配列順=slot。先頭=メインページ)
      shipping_method_group: document.getElementById('rk-shipping-group').value,
      // 画面が持つ「ヤフー別扱い」をそのまま送る (プルダウンからは復元できないため)
      yahoo_shipping_override: yahooOverrideOn ? 1 : 0,
      // 画面を開いたときの選択 (これと違えば「複合選択肢を選び直した」)
      shipping_method_group_prev: shipSelectInitial,
      postage_included: document.getElementById('rk-postage').value,
      normal_delivery_date_id: document.getElementById('rk-delivery-date').value,
      white_bg_url: document.getElementById('rk-whitebg').value,
    };
  }

  // 楽天項目の送信。**保存できた配送方法まで shipSelectInitial を進める** — この画面は保存後に
  // 再読み込みしない経路 (プレビュー・登録へ続く) があり、進めないと 2 回目以降の保存で毎回
  // 「複合選択肢を選び直した」と誤判定して、人が直したヤフーの配送方法を既定値へ戻してしまう
  async function postRakutenFields(extra) {
    const payload = { ...collectRakutenFields(), ...(extra || {}) };
    // 🚨 送る値をここで控える (Codex R1)。afterRakutenSave まで待つと、そこを通らない経路
    //    (プレビュー・登録) で基準が進まず、次の読み直しで打ち直した分を競合として捨てる
    const snap = phKeep ? phKeep.saving(['rakuten']) : null;
    const json = await post(BASE + '/rakuten', payload);
    if (json.ok) {
      shipSelectInitial = payload.shipping_method_group;
      if (phKeep) phKeep.saved(snap);
    }
    return json;
  }

  // 公開 / 非公開の切り替え (アプリから登録した商品のみ)
  // 店舗内カテゴリ (お店の棚) を RMS へ反映。登録時に自動で走るが、失敗時や選び直したときに手動で
  const rkSyncCatBtn = document.getElementById('rk-syncshopcat-btn');
  if (rkSyncCatBtn) {
    rkSyncCatBtn.addEventListener('click', async () => {
      const out = document.getElementById('rk-syncshopcat-result');
      rkSyncCatBtn.disabled = true;
      out.textContent = '反映中…';
      try {
        const json = await post(BASE + '/rakuten/sync-shop-categories', {});
        if (json.ok) {
          out.textContent = '✅ ' + json.count + ' 件を反映しました';
          setTimeout(() => reloadSafely(), 1000);
        } else {
          out.textContent = '';
          alert(json.error || '反映に失敗しました');
        }
      } finally { rkSyncCatBtn.disabled = false; }
    });
  }

  const rkPublishBtn = document.getElementById('rk-publish-btn');
  if (rkPublishBtn) {
    rkPublishBtn.addEventListener('click', async () => {
      if (!confirm('楽天で公開します。売り場に表示されるようになります。\n\nよろしいですか?')) return;
      rkPublishBtn.disabled = true;
      try {
        const json = await post(BASE + '/rakuten/visibility', { hide: false, confirm: true });
        if (json.ok) { rkResult.textContent = '🟢 公開しました'; setTimeout(() => reloadSafely(), 1000); }
        else { alert(json.error || '公開に失敗しました'); }
      } finally { rkPublishBtn.disabled = false; }
    });
  }
  const rkUnpublishBtn = document.getElementById('rk-unpublish-btn');
  if (rkUnpublishBtn) {
    rkUnpublishBtn.addEventListener('click', async () => {
      if (!confirm('楽天の売り場から下げて非公開 (倉庫指定) に戻します。\n\nよろしいですか?')) return;
      rkUnpublishBtn.disabled = true;
      try {
        const json = await post(BASE + '/rakuten/visibility', { hide: true, confirm: true });
        if (json.ok) { rkResult.textContent = '非公開に戻しました'; setTimeout(() => reloadSafely(), 1000); }
        else { alert(json.error || '切り替えに失敗しました'); }
      } finally { rkUnpublishBtn.disabled = false; }
    });
  }

  // 店舗内カテゴリの絞り込み (選択済みは常に表示)
  // ツリー版の絞り込み: パスが一致するノード (とその子孫) を表示し、枝を開く。
  // 選択済み (checked) は常に残す。空にしたら全て畳んだ初期状態に近い表示へ戻す
  const rkCatFilter = document.getElementById('rk-cat-filter');
  if (rkCatFilter) {
    rkCatFilter.addEventListener('input', () => {
      const q = rkCatFilter.value.trim().toLowerCase();
      document.querySelectorAll('#rk-cats .rk-cat-node').forEach((node) => {
        const path = node.dataset.path || '';
        const hasChecked = !!node.querySelector('.rk-cat-check:checked');
        const hit = !q || path.includes(q) || hasChecked;
        // 子孫に一致があれば自分も表示 (枝として必要)
        const descendantHit = q && [...node.querySelectorAll('.rk-cat-node')].some((d) => (d.dataset.path || '').includes(q));
        node.style.display = (hit || descendantHit) ? '' : 'none';
        // 絞り込み中は一致枝を開く
        const box = [...node.children].find((el) => el.tagName === 'DIV' && el !== node.firstElementChild);
        if (box && q && (hit || descendantHit)) box.style.display = 'block';
      });
    });
  }

  // 単品の JAN 欄 (基本情報タブ) は /rakuten では保存されない (入口一本化で catalog_jan を廃止したため)。
  // プレビュー・登録・出品情報の保存はすべて saveRakutenFields を通るので、ここで JAN の変更を先に
  // 基本情報 API へ送る (Codex R1 high: 画面の確認表示は新値なのに payload が旧 jan_code で組まれていた)
  let lastSavedJan = document.getElementById('f-jan') ? document.getElementById('f-jan').value.trim() : null;
  // 保存は 1 本のチェーンで直列化し、保存中に打ち直された分も取り切ってから戻る
  // (Codex R2 high: A を保存している間に B へ変えると、画面は B なのに payload が A で登録される)
  let janSaveChain = Promise.resolve(true);
  // 通信エラーで結果が分からなくなった印 (Codex R5 high: 応答待ち中に元の値へ戻すと lastSavedJan と一致して
  // 保存を省略し、DB だけ新値で登録が進む)。立っている間は現在値が同じでも必ず再送し、成功したときだけ下ろす
  let janSaveUnknown = false;
  function saveJanIfChanged() {
    janSaveChain = janSaveChain.then(async () => {
      const el = document.getElementById('f-jan');
      if (!el) return true; // バリエーションは SKU表 → /sku-jans (flushSkuJanSaves で待つ)
      for (let i = 0; i < 5; i++) {
        const value = el.value.trim();
        if (value === lastSavedJan && !janSaveUnknown) return true;
        let json;
        try {
          json = await post(BASE, { jan_code: value });
        } catch (e) {
          janSaveUnknown = true; // Codex R2 medium / R5 high
          alert('通信エラーでJANコードを保存できませんでした。もう一度お試しください');
          return false;
        }
        if (!json.ok) { alert(json.error || 'JANコードの保存に失敗しました'); return false; }
        janSaveUnknown = false;
        lastSavedJan = value;
        if (phKeep) phKeep.savedValue('f-jan', value);   // 未保存の基準もここまで進める (Codex R1)
      }
      return el.value.trim() === lastSavedJan && !janSaveUnknown;
    });
    return janSaveChain;
  }
  // SKU ごとの即保存ワーカー一覧 (JAN / 商品仕様 / IDなしの理由。createSkuSaver が登録する)。
  // 未保存の変更を確定して全部待ち、1 件でも失敗したら false
  const skuSavers = [];
  let skuSaveGeneration = 0;   // change / 一括操作の開始・終了ごとに +1 (全ワーカーを通した安定確認に使う)
  const skuPendingOps = new Set(); // ワーカー外の保存 (一括入力・行削除) の実行中 Promise (Codex R2 high: flush が待つ)
  let skuOpFailed = false;         // 追跡した保存が拒否/例外で終わった印 (次の flush を 1 回だけ false にする。Codex R3 medium)
  const flushSkuJanSaves = () => flushSkuSavers();
  async function saveRakutenFields() {
    // JAN (単品欄 / SKU表) の保存を先に確定させる。失敗したらプレビュー・登録に進まない (Codex R2 high)
    if (!(await saveJanIfChanged())) return false;
    if (!(await flushSkuJanSaves())) return false;
    const json = await postRakutenFields();
    if (!json.ok) { alert(json.error || '保存に失敗しました'); return false; }
    return true;
  }

  // メーカー型番を属性側から欄へ寄せた保存のあとは、画面が持っている「見た値」が古くなる。
  // そのまま 2 回目を保存すると楽観ロックで 409 になるので読み直す (Codex R7 medium)
  function afterRakutenSave(resultEl) {
    if (modelConflictResolved) {
      resultEl.textContent = '保存しました (メーカー型番を 1 箇所にまとめました)';
      setTimeout(() => reloadSafely(), 700);
      return;
    }
    resultEl.textContent = '保存しました';
  }
  document.getElementById('rk-save-btn').addEventListener('click', async () => {
    if (await saveRakutenFields()) afterRakutenSave(rkResult);
  });
  document.getElementById('rk-save-btn-cat').addEventListener('click', async () => {
    if (await saveRakutenFields()) afterRakutenSave(rkResultCat);
  });
  // メーカー型番の競合解消: 押した値を欄に入れ、解消フラグ付きでそのまま保存する
  document.querySelectorAll('.rk-model-pick').forEach((b) => {
    b.addEventListener('click', async () => {
      const picked = b.dataset.value || '';
      if (!confirm(picked
        ? '「' + picked + '」を残して、ほかのメーカー型番を消します。よろしいですか?'
        : 'メーカー型番を空 (型番なし) にします。よろしいですか?')) return;
      document.querySelectorAll('.rk-model-pick').forEach((x) => { x.disabled = true; });
      document.getElementById('rk-article').value = picked;
      modelConflictResolved = true;
      try {
        if (await saveRakutenFields()) {
          rkResultCat.textContent = 'メーカー型番を 1 つにまとめました';
          setTimeout(() => reloadSafely(), 700);
          return;
        }
      } catch (e) {
        alert('保存できませんでした: ' + e.message);
      }
      // 失敗したらフラグを戻す (次の保存で意図せず旧値を捨てない)
      modelConflictResolved = false;
      document.querySelectorAll('.rk-model-pick').forEach((x) => { x.disabled = false; });
    });
  });

  document.getElementById('rk-images-btn').addEventListener('click', async () => {
    const btn = document.getElementById('rk-images-btn');
    const imgResult = document.getElementById('rk-images-result');
    btn.disabled = true;
    imgResult.textContent = '画像を転送中… (Drive → R-Cabinet)';
    try {
      const json = await post(BASE + '/rakuten/transfer-images');
      if (json.error) { imgResult.textContent = ''; alert(json.error); return; }
      const failed = (json.results || []).filter((r) => r.outcome === 'failed');
      const skuFailed = (json.sku?.results || []).filter((r) => r.outcome === 'failed');
      imgResult.textContent = '転送 ' + (json.uploaded || 0) + ' 件 / 済み '
        + (json.results || []).filter((r) => r.outcome === 'already').length + ' 件 / 失敗 ' + failed.length + ' 件'
        + (json.sku ? ' ｜ SKU画像: 転送 ' + (json.sku.uploaded || 0) + ' / 済み ' + (json.sku.already || 0)
          + (json.sku.failed ? ' / 失敗 ' + json.sku.failed : '') : '');
      if (failed.length > 0 || skuFailed.length > 0) {
        alert('転送に失敗した画像があります:\n'
          + failed.map((f) => '・' + (f.error || '')).join('\n')
          + skuFailed.map((f) => '\n・SKU画像 ' + f.sku + ': ' + (f.error || '')).join('')
          + '\n\nDriveの画像フォルダがサービスアカウントに共有されているか確認してください。');
      } else {
        setTimeout(() => reloadSafely(), 900);
      }
    } finally { btn.disabled = false; }
  });

  document.getElementById('rk-preview-btn').addEventListener('click', async () => {
    if (!(await saveRakutenFields())) return;
    const res = await fetch(BASE + '/rakuten/preview');
    const json = await res.json();
    const pre = document.getElementById('rk-preview');
    pre.style.display = 'block';
    if (!json.ok) {
      pre.textContent = 'まだ送信できません:\n' + (json.reasons || []).map((r) => '・' + r).join('\n');
      return;
    }
    const cats = json.shopCategories || [];
    pre.textContent = '商品管理番号: ' + json.manageNumber
      + (cats.length ? '\n店舗内カテゴリ (登録時にアプリが自動で棚に反映 — この payload とは別API): ' + cats.join(' ／ ') : '')
      + '\n\n' + JSON.stringify(json.payload, null, 2);
  });

  document.getElementById('rk-register-btn').addEventListener('click', async () => {
    if (!(await saveRakutenFields())) return;
    if (!confirm('楽天に「公開」で登録します。\n在庫0のまま売り場に載ります (在庫はNE連携が入れます)。\n\nよろしいですか?')) return;
    const btn = document.getElementById('rk-register-btn');
    btn.disabled = true;
    rkResult.textContent = '楽天に登録中…';
    try {
      const json = await post(BASE + '/rakuten/register', { confirm: true });
      if (json.ok) {
        // 棚 (店舗内カテゴリ) の反映は登録とは別APIなので、失敗を登録成功に紛れさせない
        const cat = json.shopCategories;
        if (cat && cat.ok === false) {
          rkResult.textContent = '✅ 登録しました (店舗内カテゴリの反映は失敗)';
          alert('楽天への登録は成功しましたが、店舗内カテゴリ (棚) の反映に失敗しました:\n\n'
            + (cat.error || '') + '\n\n「棚を反映」ボタンでやり直せます。');
        } else if (cat && cat.ok) {
          rkResult.textContent = '✅ 公開で登録しました (棚 ' + cat.count + ' 件も反映)';
        } else {
          rkResult.textContent = '✅ 公開で登録しました';
        }
        setTimeout(() => reloadSafely(), cat && cat.ok === false ? 300 : 1200);
      } else {
        rkResult.textContent = '';
        const pre = document.getElementById('rk-preview');
        pre.style.display = 'block';
        pre.textContent = '❌ RMSエラー:\n' + (json.error || (json.reasons || []).join('\n'));
      }
    } finally { btn.disabled = false; }
  });

  // SKU をバリエーションから外す / 戻す (委譲。表は再描画されるため)
  document.addEventListener('click', async (ev) => {
    const ex = ev.target.closest && ev.target.closest('.exclude-sku-btn');
    const re = ev.target.closest && ev.target.closest('.restore-sku-btn');
    if (!ex && !re) return;
    const btn = ex || re;
    const code = btn.getAttribute('data-code');
    if (ex && !confirm(code + ' をこのページのバリエーションから外します。\n\n別ページにしたい場合は、後でこのコードで新規登録してください。')) return;
    btn.disabled = true;
    const json = await post(BASE + '/variation/' + (ex ? 'exclude' : 'restore'), { ne_code: code });
    if (json.ok) { reloadSafely(); } else { alert(json.error || '操作に失敗しました'); btn.disabled = false; }
  });

  // 子SKUのドラフトを代表商品コードにまとめる。
  // 画面に出した from/to をサーバーへ送り、実行時の再計算と一致した場合だけ適用させる
  const regroupBtn = document.getElementById('regroup-btn');
  if (regroupBtn) {
    regroupBtn.addEventListener('click', async () => {
      const from = regroupBtn.getAttribute('data-from');
      const to = regroupBtn.getAttribute('data-to');
      if (!confirm('このドラフトの商品コードを「' + from + '」から代表商品コード「' + to + '」に変更します。\n\nよろしいですか?')) return;
      regroupBtn.disabled = true;
      const json = await post(BASE + '/regroup', { expected_from: from, expected_to: to });
