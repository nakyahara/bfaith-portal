  // 定型文ボタン (画像工程 v2)。文面はサーバー (lib/prompt-templates.js) が組み立て、画面は表示とコピーだけ
  (function initPromptButtons() {
    const holder = document.getElementById('prompt-templates-json');
    if (!holder) return;
    let tpl = {};
    try { tpl = JSON.parse(holder.textContent) || {}; } catch (e) { return; }
    const modal = document.getElementById('prompt-modal');
    const textEl = document.getElementById('prompt-text');
    const supWrap = document.getElementById('prompt-supplement-wrap');
    const supEl = document.getElementById('prompt-supplement');
    const titleEl = document.getElementById('prompt-title');
    const resultEl = document.getElementById('prompt-copy-result');
    let base = '';
    function render() {
      textEl.value = base.replace('{{SUPPLEMENT}}', supEl.value || '');
    }
    document.querySelectorAll('.prompt-btn').forEach((b) => {
      b.addEventListener('click', () => {
        const kind = b.dataset.kind;
        base = tpl[kind] || '';
        titleEl.textContent = kind === 'initialJudge' ? '新商品初動判定 Ver1.0 (ChatGPT に貼る)' : 'LP制作システム V2.1 ① 商品分析 (ChatGPT に貼る)';
        supWrap.hidden = kind !== 'productAnalysis';
        resultEl.textContent = '';
        render();
        modal.hidden = false;
        textEl.focus();
      });
    });
    supEl.addEventListener('input', render);
    document.getElementById('prompt-close-btn').addEventListener('click', () => { modal.hidden = true; });
    document.getElementById('prompt-copy-btn').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(textEl.value); resultEl.textContent = 'コピーしました。ChatGPT に貼って商品画像を添付してください'; }
      catch (e) { textEl.select(); resultEl.textContent = 'コピーできませんでした (選択したので Ctrl+C で)'; }
    });
  })();
