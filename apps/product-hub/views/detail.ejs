  // ─── 利益シミュレーション (Notion 数式の移植)。売価入力でライブ更新 ───
  (function initProfitSim() {
    const box = document.getElementById('profit-sim');
    const body = document.getElementById('profit-sim-body');
    if (!box || !body) return; // 原価/送料が無いときは静的メッセージのみ
    const cost = Number(box.dataset.cost);
    const tax = Number(box.dataset.tax);
    const take = Number(box.dataset.take);
    const priceInput = document.getElementById('f-price');
    // 配送費は「選んでいる配送方法」で決まる (2026-09-04)。初期値は NE の送料
    let ship = Number(box.dataset.ship);
    // 利益額・利益率は大きい数字で別枠に出す (2026-09-01)。内訳と未入力メッセージは body 側
    const figs = document.getElementById('profit-sim-figs');
    const amountEl = document.getElementById('profit-sim-amount');
    const marginEl = document.getElementById('profit-sim-margin');
    function render() {
      const price = Number(priceInput.value);
      if (!Number.isFinite(price) || price <= 0) {
        if (figs) figs.hidden = true;
        body.textContent = '売価を入れると利益額・利益率が出ます';
        return;
      }
      const costIncTax = cost * (1 + tax / 100);
      const profit = price * take - costIncTax - ship;
      const margin = (profit / price) * 100;
      const neg = profit < 0;
      if (figs) {
        figs.hidden = false;
        figs.classList.toggle('neg', neg);
        amountEl.textContent = Math.round(profit).toLocaleString() + '円';
        marginEl.textContent = margin.toFixed(1) + '%';
        amountEl.classList.toggle('neg', neg);
        marginEl.classList.toggle('neg', neg);
      }
      body.textContent = '内訳: 手取り' + Math.round(price * take).toLocaleString()
        + ' − 税込原価' + Math.round(costIncTax).toLocaleString()
        + ' − 配送費' + Math.round(ship).toLocaleString();
    }
    priceInput.addEventListener('input', render);

    // ─── 配送方法を差し替えて試算する ───────────────────────────────
    // 楽天の配送方法グループ (8種) と NE の配送方法 (サイズ別) は粒度が違い、
    // 楽天「宅急便50サイズ以下」は NE の 50〜120 サイズ (479〜945円) のどれにもなる。
    // なので選択肢は NE の配送方法にし、楽天のプルダウンを変えたら**候補を上に集める**
    // (絞り込みではなく並べ替え — 対応表は目安で、決めるのは人)
    (function initProfitShipPicker() {
      const sel = document.getElementById('profit-ship-select');
      const note = document.getElementById('profit-ship-note');
      const holder = document.getElementById('profit-ship-data');
      if (!sel || !holder) return;
      let data = { options: [], hints: {} };
      try { data = JSON.parse(holder.textContent) || data; } catch (e) { /* 無ければ選択肢なし */ }
      if (!data.options.length) { sel.closest('div').hidden = true; return; }
      const neCurrent = sel.dataset.current || '';
      const rkShip = document.getElementById('rk-shipping-group');

      function build() {
        const chosen = sel.value || neCurrent;
        // 楽天で選んでいるグループに関係しそうな配送方法を上のグループに集める
        const raw = rkShip ? String(rkShip.value || '') : '';
        const group = raw.replace(/y\d+$/, '');   // 複合選択肢 (1y5 等) は楽天側のグループで見る
        const hints = data.hints[group] || [];
        const match = (o) => hints.some((h) => o.method.includes(h));
        const near = data.options.filter(match);
        const rest = data.options.filter((o) => !match(o));
        sel.replaceChildren();
        const addTo = (parent, list) => {
          for (const o of list) {
            const op = document.createElement('option');
            op.value = o.method;
            op.dataset.cost = o.cost;
            op.textContent = o.method + ' (' + Math.round(o.cost).toLocaleString() + '円'
              + (o.isCurrent ? '・NEの登録値' : '') + ')';
            parent.appendChild(op);
          }
        };
        if (near.length && rest.length) {
          const g1 = document.createElement('optgroup');
          g1.label = '楽天の指定に近いもの';
          addTo(g1, near);
          sel.appendChild(g1);
          const g2 = document.createElement('optgroup');
          g2.label = 'その他';
          addTo(g2, rest);
          sel.appendChild(g2);
        } else {
          addTo(sel, data.options);
        }
        // 選択中の配送方法を保つ。無ければ「NEの登録値」の行 → それも無ければ先頭。
        // ここで実送料の行を外すと、開いただけで利益額が代表送料に変わる (Codex R3 P1)
        const current = data.options.find((o) => o.isCurrent);
        const want = [chosen, neCurrent].find((v) => v && data.options.some((o) => o.method === v));
        sel.value = want || current?.method || data.options[0].method;
        apply();
      }
      function apply() {
        const op = sel.selectedOptions[0];
        if (!op) return;
        ship = Number(op.dataset.cost);
        const isCur = !!data.options.find((o) => o.method === sel.value)?.isCurrent;
        note.textContent = isCur
          ? 'NE に登録されている送料です'
          : 'NE は「' + (neCurrent || '未設定') + '」です — ここでの変更は試算だけで、NE や出品内容は変わりません';
        render();
      }
      sel.addEventListener('change', apply);
      if (rkShip) rkShip.addEventListener('change', build);
      build();
    })();

    render();
  })();

  // ─── SKU別売価 (原価がSKUで異なる場合のみ表に出る)。入力で利益をライブ計算し、確定 (change) で即保存 ───
  (function initSkuPrices() {
    const inputs = document.querySelectorAll('.sku-price-input');
    if (!inputs.length) return;
    const simBox = document.getElementById('profit-sim');
    const tax = Number(simBox?.dataset.tax ?? 10);
    const take = Number(simBox?.dataset.take ?? 0.9);
    inputs.forEach((input) => {
      const cell = document.getElementById('sku-profit-' + input.dataset.key);
      const cost = input.dataset.cost === '' ? null : Number(input.dataset.cost);
      const ship = input.dataset.ship === '' ? null : Number(input.dataset.ship);
      function render() {
        if (!cell) return;
        // 空欄はページ代表の売価 (placeholder) で計算 = 「設定しなければ draft.price」を可視化
        const price = Number(input.value !== '' ? input.value : input.placeholder);
        if (!Number.isFinite(price) || price <= 0 || cost == null || ship == null) {
          cell.textContent = '—';
          cell.title = cost == null ? 'NEに原価がありません' : (ship == null ? 'NEに送料がありません' : '売価を入れると利益が出ます');
          cell.classList.remove('neg');
          cell.classList.add('none');
          return;
        }
        const profit = price * take - cost * (1 + tax / 100) - ship;
        const margin = (profit / price) * 100;
        cell.textContent = Math.round(profit).toLocaleString() + '円 / ' + margin.toFixed(1) + '%';
        cell.title = '手取り' + Math.round(price * take).toLocaleString()
          + ' − 税込原価' + Math.round(cost * (1 + tax / 100)).toLocaleString()
          + ' − 配送費' + Math.round(ship).toLocaleString();
        cell.classList.remove('none');
        cell.classList.toggle('neg', profit < 0);
      }
      let last = input.value;
      // 保存はSKU単位の単一チェーンで直列化する (Codex R1 high: 素早く2回変更したとき
      // 先のPOSTが後から完了すると古い値に巻き戻る)。送信値は change 時点の値を渡す
      let saveChain = Promise.resolve();
      async function save(value) {
        if (value === last) return;
        let json;
        try {
          json = await post(BASE + '/sku-prices', {
            ne_code: input.dataset.code,
            price: value === '' ? null : Number(value),
          });
        } catch (e) {
          // 通信例外も黙殺せずエラー扱いにする (Codex R2)
          json = { ok: false, error: '通信エラーでSKU売価を保存できませんでした' };
        }
        if (!json.ok) {
          alert(json.error || 'SKU売価の保存に失敗しました');
          // 後続の変更値を潰さない: 表示が失敗した値のままのときだけ巻き戻す (Codex R2)
          if (input.value === value) { input.value = last; render(); }
          return;
        }
        last = value;
        result.textContent = 'SKU売価を保存しました (' + input.dataset.code + ')';
      }
      input.addEventListener('input', render);
      input.addEventListener('change', () => {
        const value = input.value;
        saveChain = saveChain.then(() => save(value));
      });
      render();
    });
  })();

  // ─── SKU ごとの即保存ワーカー (2026-09-02〜03)。JAN / 商品仕様 / IDなしの理由 で共通 ───
  // 「保存済みの値 (lastOf = DB の値) と違う入力」を実行時点の現在値で 1 件ずつ送り、全部一致するまで回す。
  // 捕捉値のキューにしない (Codex R3 high: 待機中の変更を待てない・失敗後に古い値を再送できた)。
  // 通信エラーは結果不明 (uncertain) として巻き戻さず、次の change / flush で現在値を冪等に再送する
