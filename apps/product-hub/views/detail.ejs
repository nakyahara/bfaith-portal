  // 確認中 (2026-08-31)。立てる / 理由・補足の更新 / 解除。工程も status も動かさない。
  //
  // 3 つとも同じ形で守る (Codex R1 medium): 押した瞬間に無効化 → **失敗したら必ず戻す** →
  // 応答が読めなくても固まらせない。通信エラーで disabled のまま残ると「押しても何も起きない
  // ボタン」になり、原因が分からないまま放置される。
  // post() 自体を「常に {ok:false} を返す」契約に変えれば画面全部が直るが、他のボタンの
  // 挙動まで変わるので今回は確認中まわりに閉じる (別途まとめて直す)
  async function checkingCall(body, okMsg, buttons) {
    const btns = buttons.filter(Boolean);
    const enable = (on) => btns.forEach((b) => { b.disabled = !on; });
    enable(false);
    try {
      const r = await post(BASE + '/checking', body);
      if (!r || !r.ok) enable(true);
      showAndReload(r || { ok: false, error: '応答を読めませんでした' }, okMsg);
    } catch (e) {
      enable(true);
      alert('操作できませんでした (通信エラー)。もう一度押してください');
    }
  }

  // 理由ボタンのワンタップで立てる (2026-08-31 中原さん要望: 折りたたみでは気づけない)。
  // 押した理由がそのまま入るので、選んでから確定、の 2 手にならない
  {
    const picks = [...document.querySelectorAll('.chk-pick')];
    for (const btn of picks) {
      btn.addEventListener('click', () =>
        checkingCall({ on: true, reason_code: btn.dataset.reason }, '確認中にしました', picks));
    }
  }
  const checkingSetBtn = document.getElementById('checking-set-btn');
  if (checkingSetBtn) {
    checkingSetBtn.addEventListener('click', () => {
      const reasonEl = document.getElementById('checking-reason');
      const noteEl = document.getElementById('checking-note');
      return checkingCall({
        on: true,
        reason_code: reasonEl ? reasonEl.value : '',
        note: noteEl ? noteEl.value : null,
        // 解除ボタンも一緒に止める (Codex R2 medium): 更新中に解除を押せると 2 リクエストが
        // 並走し、到着順によっては「解除したのに確認中へ戻る」。更新と解除は相互排他にする
      }, '確認中の内容を更新しました', [checkingSetBtn, document.getElementById('checking-clear-btn')]);
    });
  }
  const checkingClearBtn = document.getElementById('checking-clear-btn');
  if (checkingClearBtn) {
    checkingClearBtn.addEventListener('click', async () => {
      await checkingCall({ on: false }, '確認中を解除しました', [checkingClearBtn, checkingSetBtn]);
    });
  }

  // 参考URL: 入力したら反映する (2026-08-28 中原さん要望)。
  // change (他の欄へ移った) と Enter の 2 経路が同じ関数を呼ぶ。
  // Enter → blur の順で 2 回走りうるので、送信中フラグで 1 回に閉じる
  (function initRefAdd() {
    const input = document.getElementById('new-ref-url');
    const msg = document.getElementById('add-ref-msg');
    if (!input || !msg) return;
    let busy = false;
    async function addRef() {
      if (busy) return;
      const url = input.value.trim();
      if (!url) return;                       // 空欄で離れただけ = 何もしない
      if (!/^https?:\/\//i.test(url)) {
        // 打ちかけで離れただけの可能性があるので、消さずに理由だけ出す
        msg.style.color = '#dc2626';
        msg.textContent = 'http:// または https:// で始まる URL を入力してください';
        return;
      }
      busy = true;
      msg.style.color = '';
      msg.textContent = '追加しています…';
      try {
        // showAndReload は成功時に読み直す (一覧・タブのバッジ・AI参照元の判定まで揃える)
        showAndReload(await post(BASE + '/refs', { url }), '追加しました');
      } catch (e) {
        msg.style.color = '#dc2626';
        msg.textContent = '通信エラーで追加できませんでした — もう一度お試しください';
      } finally {
        // 例外時に busy を握ったままにしない (以後 Enter もボタンも無反応になる — Codex R1 低)
        busy = false;
      }
    }
    input.addEventListener('change', addRef);
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      if (e.isComposing) return;              // 日本語入力の変換確定 Enter では送らない
      e.preventDefault();                     // フォーム既定の送信を止める
      addRef();
    });
  })();

  // ─── 楽天の説明文3欄プレビュー (2026-08-03。デフォルト表示 = ページを開いたら自動で組み立てる) ───
  (function initDesc3Preview() {
    const btn = document.getElementById('desc3-btn');
    if (!btn) return;
    let latest = null;
    async function loadDesc3() {
      const status = document.getElementById('desc3-status');
      btn.disabled = true;
      status.textContent = '組み立て中…';
      try {
        const res = await fetch(BASE + '/rakuten/desc-preview');
        const j = await res.json();
        if (!j.ok) {
          // 前回の成功結果が画面に残っている場合は「古い」ことを明示する (Codex medium:
          // 素材を直した直後の失敗で、旧内容を最新と誤認してコピーしてしまう)
          status.textContent = '⚠️ 組み立てに失敗しました'
            + (latest ? ' — 下の表示とコピーは前回の結果です' : '') + ': ' + (j.error || '');
          status.style.color = '#dc2626';
          return;
        }
        status.style.color = '';
        latest = j;
        document.getElementById('desc3-result').style.display = '';
        for (const key of ['pc', 'sp', 'sales']) {
          const html = j[key] || '';
          const lenEl = document.getElementById('desc3-len-' + key);
          lenEl.textContent = html.length + '字 / 上限' + j.limit + '字';
          lenEl.style.color = html.length > j.limit ? '#dc2626' : '';
          const box = document.getElementById('desc3-render-' + key);
          if (!html) {
            box.innerHTML = '';
            box.textContent = (key === 'sales' || key === 'sp')
              ? '(まだ空です — 画像タブで「画像をR-Cabinetへ転送」すると画像HTMLが入ります)'
              : '(まだ空です)';
          } else {
            box.innerHTML = html;   // 自前組み立てのHTML (素材はサーバー側でエスケープ済み)
          }
        }
        if (j.imageCount > j.transferredCount) {
          document.getElementById('desc3-render-sales').insertAdjacentHTML('afterbegin',
            '<div style="color:#b45309; font-size:12px;">⚠️ 未転送の画像が ' + (j.imageCount - j.transferredCount)
            + ' 枚あります (転送すると販売説明文に追加されます)</div>');
        }
        status.textContent = '';
      } catch (e) {
        const st = document.getElementById('desc3-status');
        st.textContent = '⚠️ 通信エラー' + (latest ? ' — 下の表示とコピーは前回の結果です' : '') + ': ' + e.message;
        st.style.color = '#dc2626';
      } finally {
        btn.disabled = false;
      }
    }
    btn.addEventListener('click', loadDesc3);
    loadDesc3();   // デフォルト表示 (2026-08-03 中原さん指示)
    document.querySelectorAll('.desc3-copy').forEach((b) => {
      b.addEventListener('click', async () => {
        if (!latest) { alert('まだ組み立てられていません (「再組み立て」を押してください)'); return; }
        await navigator.clipboard.writeText(latest[b.dataset.key] || '');
        result.textContent = 'HTMLをコピーしました';
      });
    });
  })();

  // ─── ASIN ⇔ Amazon URL 連動 (2026-08-01 中原さん指示) ───
  // ・ASIN を入れると URL を https://www.amazon.co.jp/dp/<ASIN> で自動生成
  // ・URL が手入力されている (自動生成形式でない) 間は ASIN 不要 → グレーアウト
  (function initAsinAmazonSync() {
    const asinEl = document.getElementById('f-asin');
    const urlEl = document.getElementById('f-amazon-url');
    const noteEl = document.getElementById('f-asin-note');
    const AUTO_PREFIX = 'https://www.amazon.co.jp/dp/';
    const isAutoUrl = (url, asin) => !!asin && url === AUTO_PREFIX + asin;
    const refresh = () => {
      const url = urlEl.value.trim();
      const manualUrl = url !== '' && !isAutoUrl(url, asinEl.value.trim());
      asinEl.disabled = manualUrl;
      asinEl.style.background = manualUrl ? '#f1f5f9' : '';
      noteEl.hidden = !manualUrl;
    };
    asinEl.addEventListener('input', () => {
      const asin = asinEl.value.trim();
      const url = urlEl.value.trim();
      // ASIN が編集できている = URL は空か自動生成値 → 追従して書き換える
      if (url === '' || isAutoUrl(url, asin) || url.startsWith(AUTO_PREFIX)) {
        urlEl.value = asin ? AUTO_PREFIX + asin : '';
      }
      refresh();
    });
    urlEl.addEventListener('input', refresh);
    refresh();
  })();

  // ─── 送料・納期の固定表示 (外注マニュアル: 全商品送料無料 / 納期ID=4 固定) ───
  (function initFixedShippingDelivery() {
    const postageUnlock = document.getElementById('rk-postage-unlock');
    const postageSel = document.getElementById('rk-postage');
    postageUnlock.addEventListener('click', (e) => {
      e.preventDefault();
      if (!confirm('弊社は全商品「送料無料 (送料込み)」がルールです。\n本当に送料別へ変更できるようにしますか？')) return;
      document.getElementById('rk-postage-fixed').style.display = 'none';
      postageSel.style.display = '';
      postageSel.value = '0';
    });
    postageSel.addEventListener('change', () => {
      if (postageSel.value === '1') {  // 送料込みへ戻したら固定表示に戻す
        document.getElementById('rk-postage-fixed').style.display = '';
        postageSel.style.display = 'none';
      }
    });
    const deliveryUnlock = document.getElementById('rk-delivery-unlock');
    const deliveryInput = document.getElementById('rk-delivery-date');
    deliveryUnlock.addEventListener('click', (e) => {
      e.preventDefault();
      if (!confirm('納期情報は全商品「4: 12時までの注文で当日発送」がルールです。\n本当に別の納期IDへ変更できるようにしますか？')) return;
      document.getElementById('rk-delivery-fixed').style.display = 'none';
      deliveryInput.style.display = '';
      deliveryInput.focus();
    });
    deliveryInput.addEventListener('input', () => {
      if (deliveryInput.value.trim() === '4') {  // 既定値に戻したら固定表示へ
        document.getElementById('rk-delivery-fixed').style.display = '';
        deliveryInput.style.display = 'none';
      }
    });
  })();
  document.querySelectorAll('.del-ref-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/refs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-image-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/images', { url: document.getElementById('new-image-url').value }), '追加しました');
  });
  document.getElementById('import-folder-btn').addEventListener('click', async () => {
    const btn = document.getElementById('import-folder-btn');
    const url = document.getElementById('import-folder-url').value.trim();
    if (!url) return alert('画像フォルダのURLを入力してください');
    const currentCount = <%= images.length %>;
    if (currentCount > 0 && !confirm('現在の商品画像 ' + currentCount + ' 枚をフォルダの内容で置き換えます。よろしいですか？')) return;
    btn.disabled = true; btn.textContent = '取込中…';
    try {
      const json = await post(BASE + '/images/import-folder', { url });
      if (!json.ok) {
        const details = []
          .concat((json.conflicts || []).map((c) => '・' + c.label + ' が複数あります: ' + c.names.join(' / ')))
          .concat((json.skipped || []).map((s) => '・' + s.name + ' — ' + s.reason));
        alert((json.error || 'エラーが発生しました') + (details.length ? '\n\n' + details.join('\n') : ''));
        return;
      }
      let msg = json.slots.length === 0
        ? '白抜き背景をセットしました (商品画像は変更していません)'
        : '画像 ' + json.slots.length + ' 枚をセットしました' + (json.whiteBg ? ' (白抜き背景もセット)' : '');
      if (json.skuImages) {
        msg += ' ｜ SKU画像 ' + json.skuImages.matched + ' 件取込'
          + (json.skuImages.missing.length ? ' (フォルダに無いSKU: ' + json.skuImages.missing.join(', ') + ')' : '');
      }
      if (json.skipped && json.skipped.length) msg += ' / 対象外 ' + json.skipped.length + ' 件';
      const warns = (json.warnings || []).slice();
      if (json.demoted) warns.push('必須項目が欠けたため、ステータスを「下書き」に戻しました: ' + json.demoted.join(' / '));
      if (warns.length) alert(msg + '\n\n⚠ ' + warns.join('\n'));
      result.textContent = msg;
      setTimeout(() => location.reload(), warns.length ? 100 : 600);
    } finally {
      btn.disabled = false; btn.textContent = 'フォルダから自動セット';
    }
  });
  document.querySelectorAll('.del-image-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/images/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-spec-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/specs', {
      spec_key: document.getElementById('new-spec-key').value,
      spec_value: document.getElementById('new-spec-value').value,
    }), '追加しました');
  });
  document.querySelectorAll('.del-spec-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/specs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  // タイトルカードと素材カードの両方に保存ボタンがある (どちらも全 .ai-output を保存)
  document.querySelectorAll('.save-ai-btn').forEach((saveBtn) => {
    saveBtn.addEventListener('click', async () => {
      const areas = document.querySelectorAll('.ai-output');
      for (const ta of areas) {
        const json = await post(BASE + '/ai-outputs', { kind: ta.dataset.kind, content: ta.value });
        if (!json.ok) { alert('保存失敗 (' + ta.dataset.kind + '): ' + (json.error || '')); return; }
      }
      result.textContent = '保存しました';
      setTimeout(() => location.reload(), 600);
    });
  });

  // ─── SKU画像の紐づけ (取り込み・転送は商品画像のボタンに同乗) ───
  (function () {
    const syncBtn = document.getElementById('sku-img-sync-btn');
    if (!syncBtn) return;
    const out = document.getElementById('sku-img-result');
    syncBtn.addEventListener('click', async () => {
      if (!confirm('楽天ページの SKU画像を書き換えます (SKU画像以外は変更されません)。よろしいですか?')) return;
      syncBtn.disabled = true;
      out.textContent = '実行中…';
      try {
        const json = await post(BASE + '/rakuten/sync-sku-images', {});
        if (!json.ok) { out.textContent = ''; alert(json.error || 'エラーが発生しました'); return; }
        out.textContent = '🔗 ' + json.synced.length + ' SKU に紐づけました'
          + (json.unmatched.length ? ' / ページ側に無いSKU: ' + json.unmatched.join(', ') : '');
        setTimeout(() => location.reload(), 1500);
      } catch (e) {
        out.textContent = '通信エラー: ' + e.message;
      } finally { syncBtn.disabled = false; }
    });
  })();

  // 文字数カウンタ (全AI項目)。上限があるもの (楽天タイトル128 / Yahoo!タイトル65 / キャッチコピー30)
  // は「n / 上限文字」+ 超過で赤。上限なしの素材 (特徴・仕様・注意書き) は「n文字」の単純カウント
  document.querySelectorAll('.ai-output').forEach((ta) => {
    const max = ta.dataset.max ? Number(ta.dataset.max) : null;
    const lenEl = document.querySelector('.ai-len[data-for="' + ta.dataset.kind + '"]');
    const update = () => {
      const n = ta.value.length;
      if (lenEl) {
        lenEl.textContent = max ? (n + ' / ' + max + '文字') : (n + '文字');
        lenEl.style.color = max && n > max ? '#dc2626' : '';
        lenEl.style.fontWeight = max && n > max ? '700' : '';
      }
      ta.style.borderColor = max && n > max ? '#dc2626' : '';
    };
    ta.addEventListener('input', update);
    update();
  });

  // 初期表示のバッジ計算 (initPageInfo 内の applyTypeVisibility でも一度呼ばれるが、
  // pi-type が無い画面状態でも必ず一度は計算しておく)
  updateTabBadges();
  // 属性の候補ボタン (2026-08-31)。ジャンル辞書が取得済みなら開いた時点で並ぶ
  renderAttrSuggest();

  // ─── 工程パネル (誰のボールか) ───
  // 変更したその場で保存する。保存ボタン方式だと「状態だけ変えて押し忘れ」が起き、
  // ボードに古い状態が出続けるため。押し間違いは選び直せば戻せる
  (function initWorkflowPanel() {
    const card = document.getElementById('wf-card');
    if (!card) return;
    const out = document.getElementById('wf-result');
    let advanced = false;

    async function save(tr, patch) {
      const step = tr.dataset.step;
      out.textContent = '保存中…';
      try {
        // 画面を開いた時点の updated_at を一緒に送る = 古い画面からの後勝ちをサーバーが弾ける
        const body = Object.assign({ expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }, patch);
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/steps/' + encodeURIComponent(step), {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const j = await res.json();
        if (!j.ok) {
          out.textContent = '';
          alert(j.error || '保存に失敗しました');
          // 409 = 別の人が先に動かした。古い画面のまま操作を続けさせない
          if (res.status === 409) location.reload();
          return false;
        }
        // 連続で操作できるよう、次の楽観ロック用に最新の updated_at を持ち直す
        if (j.version != null) tr.dataset.version = String(j.version);
        out.textContent = '保存しました';
        return j;
      } catch (e) {
        out.textContent = '';
        alert('通信エラー: ' + e.message);
        return false;
      }
    }

    card.querySelectorAll('tr[data-step]').forEach(function (tr) {
      const state = tr.querySelector('.wf-state');
      const assignee = tr.querySelector('.wf-assignee');
      const due = tr.querySelector('.wf-due');
      const note = tr.querySelector('.wf-note');
      if (state) {
        state.addEventListener('change', async function () {
          const r = await save(tr, { state: state.value });
          // 完了で次の工程へボールが移る・工程からステータスが導出し直される (PR4) と
          // 上部の表示が変わるので読み直す。連続で複数工程を片付けたい場合もあるので、
          // 少し待ってから 1 回だけ
          const statusChanged = r && r.draftStatus && r.draftStatus !== '<%= draft.status %>';
          if (r && (state.value === 'done' || statusChanged) && !advanced) {
            advanced = true;
            setTimeout(function () { location.reload(); }, 900);
          }
        });
      }
      if (assignee) {
        assignee.addEventListener('change', function () { save(tr, { assignee_id: assignee.value }); });
      }
      // 未割り当ての工程を自分で引き受ける (admin 以外はこのボタンだけ)
      const claim = tr.querySelector('.wf-claim');
      if (claim) {
        claim.addEventListener('click', async function () {
          claim.disabled = true;
          const ok = await save(tr, { assignee_id: <%= myStaffId == null ? 'null' : myStaffId %> });
          if (ok) location.reload(); else claim.disabled = false;
        });
      }
      if (due) due.addEventListener('change', function () { save(tr, { due_date: due.value }); });
      if (note) note.addEventListener('change', function () { save(tr, { note: note.value }); });
    });

    // 「詳細画像は対象外」トグル (商品単位のフラグ。工程行は書き換えない)
    const exBtn = document.getElementById('wf-detail-excluded');
    if (exBtn) {
      exBtn.addEventListener('click', async function () {
        const next = exBtn.dataset.next === 'true';
        if (next && !confirm('この商品は詳細画像を作らない (TOP画像だけで出品ゲートを開く) 設定にします。よろしいですか?')) return;
        exBtn.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/detail-images-excluded', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ excluded: next }),
          });
          const j = await res.json();
          if (!j.ok) { alert(j.error || '切り替えに失敗しました'); exBtn.disabled = false; return; }
          location.reload();
        } catch (e) { alert('通信エラー: ' + e.message); exBtn.disabled = false; }
      });
    }

    // ─── モール別の展開状況 ───
    const mlOut = document.getElementById('ml-result');
    async function saveMall(tr, patch) {
      const mall = tr.dataset.mall;
      mlOut.textContent = '保存中…';
      try {
        const body = Object.assign(
          { expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }, patch);
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/malls/' + encodeURIComponent(mall), {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const j = await res.json();
        if (!j.ok) {
          mlOut.textContent = '';
          alert(j.error || '保存に失敗しました');
          if (res.status === 409) location.reload();
          return false;
        }
        if (j.version != null) tr.dataset.version = String(j.version);
        mlOut.textContent = '保存しました';
        // 全モールが決着すると工程「出品・展開」が閉じる → 上部の表示が変わるので読み直す
        if (j.listingCompleted) setTimeout(function () { location.reload(); }, 900);
        return true;
      } catch (e) {
        mlOut.textContent = '';
        alert('通信エラー: ' + e.message);
        return false;
      }
    }
    document.querySelectorAll('tr[data-mall]').forEach(function (tr) {
      const st = tr.querySelector('.ml-state');
      const asg = tr.querySelector('.ml-assignee');
      const note = tr.querySelector('.ml-note');
      const claim = tr.querySelector('.ml-claim');
      if (st) st.addEventListener('change', function () { saveMall(tr, { state: st.value }); });
      if (asg) asg.addEventListener('change', function () { saveMall(tr, { assignee_id: asg.value }); });
      if (note) note.addEventListener('change', function () { saveMall(tr, { note: note.value }); });
      if (claim) {
        claim.addEventListener('click', async function () {
          claim.disabled = true;
          const ok = await saveMall(tr, { assignee_id: <%= myStaffId == null ? 'null' : myStaffId %> });
          if (ok) location.reload(); else claim.disabled = false;
        });
      }
    });

    // ─── セット商品 ───
    async function createSet(mode) {
      const out = document.getElementById('set-create-result');
      const qty = Number(document.getElementById('set-qty').value);
      if (!Number.isInteger(qty) || qty < 1) { out.textContent = '個数を入れてください'; return; }
      const label = mode === 'ai' ? 'AIに書き換えてもらう' : 'コピーしてすぐ直す';
      if (!confirm('この商品からセット商品を作ります (' + label + ')。\n商品コードは仮コードになります。\n\nよろしいですか?')) return;
      const btns = [document.getElementById('set-ai-btn'), document.getElementById('set-copy-btn')];
      btns.forEach(function (b) { b.disabled = true; });
      out.textContent = '作成中…';
      try {
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-drafts', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: mode, name: document.getElementById('set-name').value,
            members: [{ ne_code: '<%= draft.ne_code %>', qty: qty }],
            // 親の「セット商品作成検討」を閉じる操作なので、その工程の版数を添える
            parent_step_version: <%= (workflow.main.find((s) => s.step_code === 'set_review') || {}).version %>,
          }),
        });
        const j = await res.json();
        if (!j.ok) { out.textContent = ''; alert(j.error || '作成に失敗しました'); btns.forEach(function (b) { b.disabled = false; }); return; }
        out.textContent = j.neCode + ' を作りました。開きます…';
        setTimeout(function () { location.href = '/apps/product-hub/detail/' + j.draftId; }, 800);
      } catch (e) {
        out.textContent = '';
        alert('通信エラー: ' + e.message);
        btns.forEach(function (b) { b.disabled = false; });
      }
    }
    const setAiBtn = document.getElementById('set-ai-btn');
    if (setAiBtn) setAiBtn.addEventListener('click', function () { createSet('ai'); });
    const setCopyBtn = document.getElementById('set-copy-btn');
    if (setCopyBtn) setCopyBtn.addEventListener('click', function () { createSet('copy'); });

    // 仮コード → 本コードの差し替え
    const setCodeBtn = document.getElementById('set-code-btn');
    if (setCodeBtn) {
      setCodeBtn.addEventListener('click', async function () {
        const out = document.getElementById('set-code-result');
        const code = document.getElementById('set-code-input').value.trim();
        if (!code) { out.textContent = '商品コードを入れてください'; return; }
        setCodeBtn.disabled = true;
        out.textContent = '差し替え中…';
        async function post(confirmFlag) {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-code', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ne_code: code, confirm: confirmFlag === true }),
          });
          return { status: res.status, json: await res.json() };
        }
        try {
          const r = await post(false);
          if (!r.json.ok) { out.textContent = ''; alert(r.json.error || '差し替えに失敗しました'); setCodeBtn.disabled = false; return; }
          // NE に見つからないコードでも差し替えは通す。ただし出品ゲートは閉じたままなので、
          // その旨をはっきり伝える (黙って通すと「出せるはず」と思われる)
          if (r.json.inNe === false) {
            alert('差し替えました。ただしNE商品マスタにまだ見つかりません。'
              + '\n取り込まれるまで楽天には出品できません (この画面を開いたときに自動で解除されます)。');
          }
          out.textContent = '差し替えました';
          setTimeout(function () { location.reload(); }, 800);
        } catch (e) {
          out.textContent = '';
          alert('通信エラー: ' + e.message);
          setCodeBtn.disabled = false;
        }
      });
    }
  })();
</script>
