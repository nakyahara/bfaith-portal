  // ─── Yahoo!売価・配送方法のゲート (2026-08-06 中原さん指示) ───
  // 通常は楽天と同じ配送・売価で出すため入力不可。基本情報の配送方法で
  // 「定形外（ヤフーのみ…）」を選んだときだけ入力可になり、対応する配送方法を初期セットする
  const YAHOO_SHIP_OVERRIDES = <%- JSON.stringify(yahooOverrideGroups) %>;
  // 「ヤフーだけ別配送・別売価で出す」の現在値 (draft_yahoo.shipping_override)。
  // プルダウンの値だけからは復元できない — ヤフーの配送方法を複合の既定値から変えた商品は
  // 複合キーへ逆引きできず「定形外」表示になるため、その状態で楽天項目を保存すると
  // 別扱いが解除されてしまう。**保存時は画面が持つこの値をそのまま送る** (rakutenPayload /
  // yahooPayload の両方。どちらを先に押しても同じ状態が保たれる)
  let yahooOverrideOn = <%= yahoo?.shipping_override ? 'true' : 'false' %>;
  // 画面を開いたときの配送方法の選択。保存時に一緒に送り、サーバは「プルダウンで複合選択肢を
  // 選び直したか」をこれで判定する (1y5 → 1y8 ならヤフーの配送方法も追従させ、選び直して
  // いなければ人が入れた値に触らない)。DB の値からの逆引きでは、ヤフーの配送方法を変えた商品を
  // 「選び直した」と誤判定してしまう
  let shipSelectInitial = '';
  (function () {
    const rkShip = document.getElementById('rk-shipping-group');
    const yPrice = document.getElementById('y-price');
    const yDelivery = document.getElementById('y-delivery');
    const hint = document.getElementById('y-gate-hint');
    if (!rkShip || !yPrice || !yDelivery) return;
    shipSelectInitial = rkShip.value;
    function updateYahooGate(fromChange) {
      const ov = YAHOO_SHIP_OVERRIDES[rkShip.value];
      // プルダウンを操作したときだけ状態が変わる (初期表示は保存値のまま)
      if (fromChange) yahooOverrideOn = !!ov;
      const overrideOn = yahooOverrideOn;
      yPrice.disabled = !overrideOn;
      yDelivery.disabled = !overrideOn;
      if (ov && (fromChange || !yDelivery.value)) yDelivery.value = ov.yahooDelivery;
      if (overrideOn) {
        hint.textContent = 'Yahoo!は「' + (yDelivery.value || (ov ? ov.yahooDelivery : '')) + '」で出す設定です (プルダウンで変更可。保存は「Yahoo!項目を保存」)';
      } else {
        hint.textContent = '楽天と同じ配送・売価で出すため入力不要です (基本情報の配送方法で「定形外（ヤフーのみ…）」を選ぶと入力できます)';
      }
    }
    rkShip.addEventListener('change', () => updateYahooGate(true));
    yDelivery.addEventListener('change', () => updateYahooGate(false));
    updateYahooGate(false);
  })();

  const saveIpBtn = document.getElementById('save-ip-btn');
  if (saveIpBtn) {
    saveIpBtn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/image-production', {
        status: document.getElementById('ip-status').value,
        importance_tier: document.getElementById('ip-tier').value,
        production_type: document.getElementById('ip-type').value,
        aplus_content: document.getElementById('ip-aplus').value,
        aplus_related: document.getElementById('ip-aplus-related').value,
        camera_instruction_url: document.getElementById('ip-camera-url').value,
        shipping_status: document.getElementById('ip-shipping').value,
        reference_collection: document.getElementById('ip-refcol').value,
        designer: document.getElementById('ip-designer').value,
        page_composer: document.getElementById('ip-composer').value,
        request_text: document.getElementById('ip-request').value,
        canva_url: document.getElementById('ip-canva-url').value,
        material_status: document.getElementById('ip-material').value,
        product_info_text: document.getElementById('ip-product-info').value,
      }), '画像制作情報を保存しました');
    });
