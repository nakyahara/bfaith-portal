  // 参考URL: 入力したら反映する (2026-08-28 中原さん要望)。
  // change (他の欄へ移った) と Enter の 2 経路が同じ関数を呼ぶ。
  // Enter → blur の順で 2 回走りうるので、送信中フラグで 1 回に閉じる
  (function initRefAdd() {
    const input = document.getElementById('new-ref-url');
    const msg = document.getElementById('add-ref-msg');
    if (!input || !msg) return;
    let busy = false;
    async function addRef() {
      if (busy) return;
      const url = input.value.trim();
      if (!url) return;                       // 空欄で離れただけ = 何もしない
      if (!/^https?:\/\//i.test(url)) {
        // 打ちかけで離れただけの可能性があるので、消さずに理由だけ出す
        msg.style.color = '#dc2626';
        msg.textContent = 'http:// または https:// で始まる URL を入力してください';
        return;
      }
      busy = true;
      msg.style.color = '';
      msg.textContent = '追加しています…';
      try {
        // showAndReload は成功時に読み直す (一覧・タブのバッジ・AI参照元の判定まで揃える)
        showAndReload(await post(BASE + '/refs', { url }), '追加しました');
      } catch (e) {
        msg.style.color = '#dc2626';
        msg.textContent = '通信エラーで追加できませんでした — もう一度お試しください';
      } finally {
        // 例外時に busy を握ったままにしない (以後 Enter もボタンも無反応になる — Codex R1 低)
        busy = false;
      }
    }
    input.addEventListener('change', addRef);
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      if (e.isComposing) return;              // 日本語入力の変換確定 Enter では送らない
      e.preventDefault();                     // フォーム既定の送信を止める
      addRef();
    });
  })();

  // ─── 楽天の説明文3欄プレビュー (2026-08-03。デフォルト表示 = ページを開いたら自動で組み立てる) ───
  (function initDesc3Preview() {
