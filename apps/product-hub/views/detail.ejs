    // 自動で出した ASIN の出どころ欄: どの語で何位だったか (ABA のクリック上位 3・対象週)
    function autoOriginCell(a) {
      const cell = el('td', { style: 'font-size:12px;' });
      cell.appendChild(el('div', {}, [
        el('span', { class: 'badge badge-ready_for_ai', text: '自動 (ABA)' }),
        el('span', { class: 'muted', text: '　' + a.auto_term_count + ' 語で上位 3' + (a.auto_week_text ? '・対象週 ' + a.auto_week_text : '') + (a.added_at ? '・' + fmtTime(a.added_at) : '') }),
      ]));
      // 部門が複数あるときは部門を、当たった表記が送った語と違うときはその表記を添える (どの数値か分かるように — Codex #1422 R1 任意)
      const multiDept = new Set((a.auto_hits || []).map((h) => h.department)).size > 1;
      const hits = (a.auto_hits || []).map((h) => '「' + h.term + '」'
        + (h.matched_term && h.matched_term !== h.term ? '(ABA では「' + h.matched_term + '」)' : '')
        + (multiDept && h.department ? '[' + h.department + ']' : '')
        + (h.click_position ? h.click_position + '位' : '') + (h.click_share != null ? ' (シェア ' + (Math.round(Number(h.click_share) * 1000) / 10) + '%)' : ''));
      if (hits.length) cell.appendChild(el('div', { class: 'muted', style: 'font-size:11px;', text: hits.join('・') + (a.auto_term_count > hits.length ? ' ほか' : '') }));
