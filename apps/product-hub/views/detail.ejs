      finally { inflight.delete('auto-asins'); }
      // 待つ間に依頼が切り替わった → この応答は旧依頼のもの。読み直せなくてもボタンは戻す (inflight は共有なので、
      // 新しい依頼のボタンも「引いています…」で描かれている — Codex #1422 R1 #1)
      if (myReqGen !== reqGen) { if (!(await refresh())) render(); return; }
      if (!r || !r.ok) {
