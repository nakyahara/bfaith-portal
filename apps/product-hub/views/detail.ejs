      // 内容量・容量 (ml/g) は雑貨でも使う (2026-08-28 中原さん要望。以前は雑貨だと隠していた)
      'pi-f-volume':      { valueId: 'pi-volume',      general: true,  cosmetics: true,  health_food: true,  food: true },
      'pi-f-ingredients': { valueId: 'pi-ingredients', general: true,  cosmetics: true,  health_food: false, food: false },
    };
    // 楽天必須の *必須 マーク (validatePageInfo と対応)
    const REQ_LABELS = {
      cosmetics: ['pi-l-category', 'pi-l-origin', 'pi-l-seller'],
      health_food: ['pi-l-category', 'pi-l-origin', 'pi-l-seller', 'pi-l-volume',
        'pi-l-food-name', 'pi-l-food-ingredients', 'pi-l-food-expiry', 'pi-l-food-storage'],
    };
    const ALL_REQ_LABELS = ['pi-l-category', 'pi-l-origin', 'pi-l-seller', 'pi-l-importer', 'pi-l-volume',
      'pi-l-food-name', 'pi-l-food-ingredients', 'pi-l-food-expiry', 'pi-l-food-storage'];
    // 雑貨は楽天必須の記載がない → 入力ハードルを下げるため「(任意)」を明示 (中原さん指示 2026-08-01)
    const OPT_LABELS_GENERAL = ['pi-l-seller', 'pi-l-size', 'pi-l-ingredients', 'pi-l-usage', 'pi-l-brand', 'pi-l-volume'];

    const applyTypeVisibility = () => {
      const t = typeSel.value || 'general';
      for (const [wrapId, rule] of Object.entries(FIELD_RULES)) {
        const wrap = document.getElementById(wrapId);
        if (!wrap) continue;
        const hasValue = !!String((document.getElementById(rule.valueId) || {}).value || '').trim();
        let show = rule[t];
        if (show === 'overseas') show = originSel.value === '海外製';
        wrap.style.display = (show || hasValue) ? '' : 'none';
      }
      foodBox.style.display = (t === 'food' || t === 'health_food') ? '' : 'none';
      // *必須 マークの付け替え
      const req = new Set(REQ_LABELS[t] || []);
      if ((t === 'cosmetics' || t === 'health_food') && originSel.value === '海外製') req.add('pi-l-importer');
      for (const id of ALL_REQ_LABELS) {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('req', req.has(id));
      }
      // 雑貨のとき (任意) マーク (必須マークとは排他: 雑貨はREQ_LABELS対象外)
      for (const id of OPT_LABELS_GENERAL) {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('opt', t === 'general' && !req.has(id));
      }
      // 商品タイプに整合する商品区分だけ選べるようにする
      const allowed = catByType[t] || null;
      for (const opt of catSel.options) {
        if (!opt.value) continue;
        const ok = !allowed || allowed.includes(opt.value);
        opt.hidden = !ok;
        opt.disabled = !ok;
      }
      if (allowed && catSel.value && !allowed.includes(catSel.value)) catSel.value = '';
      updateTabBadges();
    };
    typeSel.addEventListener('change', applyTypeVisibility);
    originSel.addEventListener('change', applyTypeVisibility);
    applyTypeVisibility();

    const collect = () => ({
      product_type: typeSel.value,
      category_label: document.getElementById('pi-category').value,
      origin_type: document.getElementById('pi-origin-type').value,
      origin_country: document.getElementById('pi-origin-country').value,
      seller_name: document.getElementById('pi-seller').value,
      importer_name: document.getElementById('pi-importer').value,
      brand_name: document.getElementById('pi-brand').value,
      content_volume: document.getElementById('pi-volume').value,
      size_text: document.getElementById('pi-size').value,
      ingredients: document.getElementById('pi-ingredients').value,
      usage_notes: document.getElementById('pi-usage').value,
      food_name: document.getElementById('pi-food-name').value,
      food_ingredients: document.getElementById('pi-food-ingredients').value,
      food_expiry: document.getElementById('pi-food-expiry').value,
      food_storage: document.getElementById('pi-food-storage').value,
    });

    const result = document.getElementById('pi-result');
    const warnBox = document.getElementById('pi-warnings');
    // サーバー (cleanText: trim / 空→null / 上限切り詰め) と同じ正規化で保存済み内容と比較する。
    // 生の入力値で比べると「 x 」vs「x」が永遠に差分扱いになり自動保存が止まらなくなるため
    const PI_LIMITS = {
      category_label: 50, origin_country: 100, seller_name: 200, importer_name: 200,
      brand_name: 200, content_volume: 200, size_text: 300, ingredients: 3000, usage_notes: 2000,
      food_name: 200, food_ingredients: 3000, food_expiry: 200, food_storage: 300,
    };
    function piSnapshot(body) {
      const out = {};
      for (const [k, v] of Object.entries(body)) {
        const s = String(v ?? '').trim();
        out[k] = PI_LIMITS[k] ? s.slice(0, PI_LIMITS[k]) : s;
      }
      return JSON.stringify(out);
    }
    // 掲載HTMLの「商品名」行は**基本情報タブにいま入っている商品名**を使う (2026-08-28 中原さん要望)。
    // 基本情報は明示保存なので、DB の値だけで組むと打ち替えた直後の確認で古い名前が出る。
    // 保存対象ではないので collect() には入れない (入れると名前を打つたび差分扱いになり自動保存が走る)
    const previewProductName = () => (document.getElementById('f-name') || {}).value || '';
    let piSavedSnapshot = piSnapshot(collect());
    let piSaveChain = Promise.resolve(); // 全保存経路を直列化 (並行POSTの後勝ち上書き防止)
    // リビジョン: ページロードごとのトークン + 単調増加 seq。サーバーは同一トークン内で
    // seq が進んでいないリクエストを破棄する (pagehide ビーコンとの到着順逆転対策)
    const piToken = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
    let piSeq = 0;

    async function savePageInfoNow(opts) {
      if (opts.skipIfUnchanged && piSnapshot(collect()) === piSavedSnapshot) return { skipped: true };
      const fields = collect();
      let json;
      try {
        json = await post(BASE + '/page-info', { ...fields, product_name: previewProductName(), save_token: piToken, save_seq: ++piSeq });
      } catch (_) {
        json = { ok: false, error: '通信エラーで保存できませんでした' };
      }
      if (!json.ok) {
        // 自動保存の失敗は alert で作業を止めない (次の入力/手動保存で再試行される)
        if (opts.silent) {
          result.style.color = '#dc2626';
          result.textContent = '自動保存に失敗しました — 「ページ表記を保存」で再試行してください';
          return null;
        }
        alert(json.error || '保存に失敗しました');
        return null;
      }
      piSavedSnapshot = piSnapshot(fields);
      result.style.color = '';
      document.getElementById('pi-html-src').value = json.html || '';
      warnBox.replaceChildren();
      if (json.warnings && json.warnings.length) {
        const div = document.createElement('div');
        div.className = 'banner-warn';
        div.style.margin = '0';
        div.textContent = '⚠️ 楽天必須記載が不足 (登録時に止まります): ' + json.warnings.join(' / ');
        warnBox.appendChild(div);
      }
      return json;
    }
    // 自動保存・手動保存・プレビュー・コピーのどれが同時に走っても POST は1本ずつ
    function savePageInfo(opts = {}) {
      const p = piSaveChain.then(() => savePageInfoNow(opts));
      piSaveChain = p.then(() => {}, () => {});
      return p;
    }

    // ─── 自動保存: 入力停止1秒後 (セレクトは即時)。差分があるときだけ送る ───
    let piTimer = null;
    async function autoSavePageInfo() {
      const j = await savePageInfo({ silent: true, skipIfUnchanged: true });
      if (j && !j.skipped) {
        result.textContent = '自動保存しました'
          + (j.warnings.length ? ' (必須の不足あり)' : '')
          + ' ' + new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
        updateTabBadges();
      }
    }
    function schedulePiAutoSave(delayMs) {
      clearTimeout(piTimer);
      piTimer = setTimeout(autoSavePageInfo, delayMs);
    }
    const piPanel = document.getElementById('tab-info');
    piPanel.addEventListener('input', () => schedulePiAutoSave(1000));
    piPanel.addEventListener('change', () => schedulePiAutoSave(0));
    // タブを閉じる/離れるときに未保存分を送る (応答は見ない best-effort)。
    // POST 進行中でも送ってよい: seq が進んでいるので、到着順がどちらでも
    // サーバー側のリビジョン判定で新しい内容 (ビーコン) が勝つ
    window.addEventListener('pagehide', () => {
      if (!navigator.sendBeacon) return;
      if (piSnapshot(collect()) === piSavedSnapshot) return;
      const body = { ...collect(), save_token: piToken, save_seq: ++piSeq };
      try { navigator.sendBeacon(BASE + '/page-info', new Blob([JSON.stringify(body)], { type: 'application/json' })); } catch (_) { /* best-effort */ }
    });

    document.getElementById('pi-save-btn').addEventListener('click', async () => {
      const j = await savePageInfo();
      if (j) result.textContent = j.warnings.length ? '保存しました (必須の不足あり)' : '保存しました';
    });
    document.getElementById('pi-preview-btn').addEventListener('click', async () => {
      const j = await savePageInfo();
      if (!j) return;
      const pv = document.getElementById('pi-preview');
      pv.style.display = 'block';
      // 自前生成の表HTMLのみ (入力値はサーバー側でエスケープ済み)
      pv.innerHTML = j.html || '<span class="muted">掲載する項目がまだありません</span>';
    });
    document.getElementById('pi-copy-btn').addEventListener('click', async () => {
      const j = await savePageInfo();
      if (!j) return;
      const src = document.getElementById('pi-html-src').value;
      if (!src) { result.textContent = 'コピーする内容がありません'; return; }
      try { await navigator.clipboard.writeText(src); result.textContent = 'HTMLをコピーしました'; }
      catch (e) { result.textContent = 'コピーできませんでした (手動で選択してください)'; }
    });
  })();

  // ─── 利益シミュレーション (Notion 数式の移植)。売価入力でライブ更新 ───
  (function initProfitSim() {
    const box = document.getElementById('profit-sim');
    const body = document.getElementById('profit-sim-body');
    if (!box || !body) return; // 原価/送料が無いときは静的メッセージのみ
    const cost = Number(box.dataset.cost);
    const tax = Number(box.dataset.tax);
    const take = Number(box.dataset.take);
    const priceInput = document.getElementById('f-price');
    // 配送費は「選んでいる配送方法」で決まる (2026-09-04)。初期値は NE の送料
    let ship = Number(box.dataset.ship);
    // 利益額・利益率は大きい数字で別枠に出す (2026-09-01)。内訳と未入力メッセージは body 側
    const figs = document.getElementById('profit-sim-figs');
    const amountEl = document.getElementById('profit-sim-amount');
    const marginEl = document.getElementById('profit-sim-margin');
    function render() {
      const price = Number(priceInput.value);
      if (!Number.isFinite(price) || price <= 0) {
        if (figs) figs.hidden = true;
        body.textContent = '売価を入れると利益額・利益率が出ます';
        return;
      }
      const costIncTax = cost * (1 + tax / 100);
      const profit = price * take - costIncTax - ship;
      const margin = (profit / price) * 100;
      const neg = profit < 0;
      if (figs) {
        figs.hidden = false;
        figs.classList.toggle('neg', neg);
        amountEl.textContent = Math.round(profit).toLocaleString() + '円';
        marginEl.textContent = margin.toFixed(1) + '%';
        amountEl.classList.toggle('neg', neg);
        marginEl.classList.toggle('neg', neg);
      }
      body.textContent = '内訳: 手取り' + Math.round(price * take).toLocaleString()
        + ' − 税込原価' + Math.round(costIncTax).toLocaleString()
        + ' − 配送費' + Math.round(ship).toLocaleString();
    }
    priceInput.addEventListener('input', render);

    // ─── 配送方法を差し替えて試算する ───────────────────────────────
    // 楽天の配送方法グループ (8種) と NE の配送方法 (サイズ別) は粒度が違い、
    // 楽天「宅急便50サイズ以下」は NE の 50〜120 サイズ (479〜945円) のどれにもなる。
    // なので選択肢は NE の配送方法にし、楽天のプルダウンを変えたら**候補を上に集める**
    // (絞り込みではなく並べ替え — 対応表は目安で、決めるのは人)
    (function initProfitShipPicker() {
      const sel = document.getElementById('profit-ship-select');
      const note = document.getElementById('profit-ship-note');
      const holder = document.getElementById('profit-ship-data');
      if (!sel || !holder) return;
      let data = { options: [], hints: {} };
      try { data = JSON.parse(holder.textContent) || data; } catch (e) { /* 無ければ選択肢なし */ }
      if (!data.options.length) { sel.closest('div').hidden = true; return; }
      const neCurrent = sel.dataset.current || '';
      const rkShip = document.getElementById('rk-shipping-group');

      function build() {
        const chosen = sel.value || neCurrent;
        // 楽天で選んでいるグループに関係しそうな配送方法を上のグループに集める
        const raw = rkShip ? String(rkShip.value || '') : '';
        const group = raw.replace(/y\d+$/, '');   // 複合選択肢 (1y5 等) は楽天側のグループで見る
        const hints = data.hints[group] || [];
        const match = (o) => hints.some((h) => o.method.includes(h));
        const near = data.options.filter(match);
        const rest = data.options.filter((o) => !match(o));
        sel.replaceChildren();
        const addTo = (parent, list) => {
          for (const o of list) {
            const op = document.createElement('option');
            op.value = o.method;
            op.dataset.cost = o.cost;
            op.textContent = o.method + ' (' + Math.round(o.cost).toLocaleString() + '円'
              + (o.isCurrent ? '・NEの登録値' : '') + ')';
            parent.appendChild(op);
          }
        };
        if (near.length && rest.length) {
          const g1 = document.createElement('optgroup');
          g1.label = '楽天の指定に近いもの';
          addTo(g1, near);
          sel.appendChild(g1);
          const g2 = document.createElement('optgroup');
          g2.label = 'その他';
          addTo(g2, rest);
          sel.appendChild(g2);
        } else {
          addTo(sel, data.options);
        }
        // 選択中の配送方法を保つ。無ければ「NEの登録値」の行 → それも無ければ先頭。
        // ここで実送料の行を外すと、開いただけで利益額が代表送料に変わる (Codex R3 P1)
        const current = data.options.find((o) => o.isCurrent);
        const want = [chosen, neCurrent].find((v) => v && data.options.some((o) => o.method === v));
        sel.value = want || current?.method || data.options[0].method;
        apply();
      }
      function apply() {
        const op = sel.selectedOptions[0];
        if (!op) return;
        ship = Number(op.dataset.cost);
        const isCur = !!data.options.find((o) => o.method === sel.value)?.isCurrent;
        note.textContent = isCur
          ? 'NE に登録されている送料です'
          : 'NE は「' + (neCurrent || '未設定') + '」です — ここでの変更は試算だけで、NE や出品内容は変わりません';
        render();
      }
      sel.addEventListener('change', apply);
      if (rkShip) rkShip.addEventListener('change', build);
      build();
    })();

    render();
  })();

  // ─── SKU別売価 (原価がSKUで異なる場合のみ表に出る)。入力で利益をライブ計算し、確定 (change) で即保存 ───
  (function initSkuPrices() {
    const inputs = document.querySelectorAll('.sku-price-input');
    if (!inputs.length) return;
    const simBox = document.getElementById('profit-sim');
    const tax = Number(simBox?.dataset.tax ?? 10);
    const take = Number(simBox?.dataset.take ?? 0.9);
    inputs.forEach((input) => {
      const cell = document.getElementById('sku-profit-' + input.dataset.key);
      const cost = input.dataset.cost === '' ? null : Number(input.dataset.cost);
      const ship = input.dataset.ship === '' ? null : Number(input.dataset.ship);
      function render() {
        if (!cell) return;
        // 空欄はページ代表の売価 (placeholder) で計算 = 「設定しなければ draft.price」を可視化
        const price = Number(input.value !== '' ? input.value : input.placeholder);
        if (!Number.isFinite(price) || price <= 0 || cost == null || ship == null) {
          cell.textContent = '—';
          cell.title = cost == null ? 'NEに原価がありません' : (ship == null ? 'NEに送料がありません' : '売価を入れると利益が出ます');
          cell.classList.remove('neg');
          cell.classList.add('none');
          return;
        }
        const profit = price * take - cost * (1 + tax / 100) - ship;
        const margin = (profit / price) * 100;
        cell.textContent = Math.round(profit).toLocaleString() + '円 / ' + margin.toFixed(1) + '%';
        cell.title = '手取り' + Math.round(price * take).toLocaleString()
          + ' − 税込原価' + Math.round(cost * (1 + tax / 100)).toLocaleString()
          + ' − 配送費' + Math.round(ship).toLocaleString();
        cell.classList.remove('none');
        cell.classList.toggle('neg', profit < 0);
      }
      let last = input.value;
      // 保存はSKU単位の単一チェーンで直列化する (Codex R1 high: 素早く2回変更したとき
      // 先のPOSTが後から完了すると古い値に巻き戻る)。送信値は change 時点の値を渡す
      let saveChain = Promise.resolve();
      async function save(value) {
        if (value === last) return;
        let json;
        try {
          json = await post(BASE + '/sku-prices', {
            ne_code: input.dataset.code,
            price: value === '' ? null : Number(value),
          });
        } catch (e) {
          // 通信例外も黙殺せずエラー扱いにする (Codex R2)
          json = { ok: false, error: '通信エラーでSKU売価を保存できませんでした' };
        }
        if (!json.ok) {
          alert(json.error || 'SKU売価の保存に失敗しました');
          // 後続の変更値を潰さない: 表示が失敗した値のままのときだけ巻き戻す (Codex R2)
          if (input.value === value) { input.value = last; render(); }
          return;
        }
        last = value;
        result.textContent = 'SKU売価を保存しました (' + input.dataset.code + ')';
      }
      input.addEventListener('input', render);
      input.addEventListener('change', () => {
        const value = input.value;
        saveChain = saveChain.then(() => save(value));
      });
      render();
    });
  })();

  // ─── SKU ごとの即保存ワーカー (2026-09-02〜03)。JAN / 商品仕様 / IDなしの理由 で共通 ───
  // 「保存済みの値 (lastOf = DB の値) と違う入力」を実行時点の現在値で 1 件ずつ送り、全部一致するまで回す。
  // 捕捉値のキューにしない (Codex R3 high: 待機中の変更を待てない・失敗後に古い値を再送できた)。
  // 通信エラーは結果不明 (uncertain) として巻き戻さず、次の change / flush で現在値を冪等に再送する
  // (Codex R4/R5 high: サーバーがコミット済みでも応答だけ失われることがある)。
  // サーバー拒否 (ok:false) だけ DB の値へ巻き戻す。失敗は drain 実行の結果として flush に伝わる
  function createSkuSaver({ inputs, send, label }) {
    const list = [];
    const lastOf = new Map();
    const uncertain = new Set();
    const result = document.getElementById('rk-result');
    let draining = null;   // 実行中の drain (Promise<boolean> = その実行の開始以降に失敗が無かったか)
    let rerun = false;     // drain 中に change が来た印 (終わる直前の取りこぼし防止)
    function register(input) {
      list.push(input);
      lastOf.set(input, input.value.trim());
      input.addEventListener('change', () => { skuSaveGeneration += 1; drain(); });
    }
    // 戻り値: 'ok' = 保存した / 'rejected' = サーバーが拒否 (DB は旧値のまま) / 'unknown' = DB の値が不明 (drain を止める)
    async function saveOne(input) {
      const value = input.value.trim();
      if (value === lastOf.get(input) && !uncertain.has(input)) return 'ok';
      let json;
      try {
        json = await send(input, value);
      } catch (e) {
        uncertain.add(input);
        alert('通信エラーで' + label + 'を保存できませんでした (' + input.dataset.code + ')。もう一度お試しください');
        return 'unknown';
      }
      if (!json.ok) {
        if (uncertain.has(input)) {
          alert((json.error || label + 'の保存に失敗しました') + ' — 直前の保存結果が不明なため、ページを再読み込みして値を確認してください');
          return 'unknown';
        }
        alert(json.error || label + 'の保存に失敗しました');
        // 後続の変更値を潰さない: 表示が失敗した値のままのときだけ DB の値へ巻き戻す (バッジも追従)
        if (input.value.trim() === value) {
          input.value = lastOf.get(input);
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
        return 'rejected';
      }
      uncertain.delete(input);
      lastOf.set(input, value);
      if (result) result.textContent = label + 'を保存しました (' + input.dataset.code + (value ? ' = ' + value : ' 解除') + ')';
      return 'ok';
    }
    const dirtyInputs = () => list.filter((i) => uncertain.has(i) || i.value.trim() !== lastOf.get(i));
    function drain() {
      if (draining) { rerun = true; return draining; }
      draining = (async () => {
        let ok = true;
        do {
          rerun = false;
          // 拒否は巻き戻すので通常 1〜2 周で収束する。上限は保存が拒否され続けるときの安全弁
          for (let round = 0; round < 10; round++) {
            const dirty = dirtyInputs();
            if (dirty.length === 0) break;
            for (const input of dirty) {
              const r = await saveOne(input);
              if (r === 'unknown') return false; // 結果不明: dirty を残したまま止める (連打再送しない)
              if (r === 'rejected') ok = false;
            }
          }
        } while (rerun);
        return ok;
      })().finally(() => { draining = null; });
      return draining;
    }
    const saver = {
      register,
      isDirty: () => dirtyInputs().length > 0,
      // 一括入力など別経路で保存済みにした値を「DB の値」として覚える
      markSaved(input, value) { uncertain.delete(input); lastOf.set(input, value); },
      // 別経路の保存が結果不明 (通信エラー) になった入力: 次の change / flush で現在値を再送する
      markUncertain(input) { uncertain.add(input); },
      // プレビュー・登録・出品情報保存の前に呼ばれる。(合流した) drain の開始以降に 1 件でも失敗していたら /
      // まだ DB と違う入力が残っていたら false
      async flush() {
        const ok = await drain();
        return ok && dirtyInputs().length === 0;
      },
    };
    (inputs || []).forEach(register);
    skuSavers.push(saver);
    return saver;
  }
  // 全ワーカーを通した安定状態まで待つ (Codex R1 high: Promise.all 一発だと、先に終わったワーカーへ
  // 待機中に入った変更を待たずに登録へ進める)。変更の無い一巡が取れたら true
  // 同時に始まった flush (二重クリック等) は同じ実行を共有し同じ結果を返す (Codex R4 high: skuOpFailed を
  // 片方だけが消費して、もう片方が true で保存へ進んでいた)。終わった後の新しい flush だけが再試行
  let flushInFlight = null;
  function flushSkuSavers() {
    if (flushInFlight) return flushInFlight;
    flushInFlight = flushSkuSaversOnce().finally(() => { flushInFlight = null; });
    return flushInFlight;
  }
  async function flushSkuSaversOnce() {
    for (let i = 0; i < 10; i++) {
      const gen = skuSaveGeneration;
      // ワーカー外の保存 (一括入力・行削除) が走っていれば先に終わるのを待つ
      if (skuPendingOps.size > 0) await Promise.allSettled([...skuPendingOps]);
      // 待った保存が拒否/例外で終わっていたら、この flush は失敗 (1 回限り。次の明示的な flush で再試行できる)
      if (skuOpFailed) { skuOpFailed = false; return false; }
      const ok = (await Promise.all(skuSavers.map((s) => s.flush()))).every(Boolean);
      if (!ok) return false;
      if (gen === skuSaveGeneration && skuPendingOps.size === 0 && skuSavers.every((s) => !s.isDirty())) return true;
    }
    return false;
  }
  // ワーカー外の保存 (一括入力・行削除) を flush の待ち対象にする。開始・終了で世代を進め、
  // 拒否 (ok:false) や例外は skuOpFailed に残す (Codex R3 medium: 完了だけ待つと拒否された一括操作でも成功扱いになる)
  function trackSkuOp(promise) {
    const tracked = promise.then(
      (json) => { if (!json || json.ok === false) skuOpFailed = true; return json; },
      (err) => { skuOpFailed = true; throw err; });
    skuPendingOps.add(tracked);
    skuSaveGeneration += 1;
    tracked.finally(() => { skuPendingOps.delete(tracked); skuSaveGeneration += 1; }).catch(() => {});
    return tracked;
  }

  // ─── SKU別JAN (2026-08-28 中原さん要望)。入力欄を離れたら即保存 ───
  (function initSkuJans() {
    const inputs = [...document.querySelectorAll('.sku-jan-input')];
    if (inputs.length === 0) return;
    createSkuSaver({
      inputs, label: 'JANコード',
      send: (input, value) => post(BASE + '/sku-jans', { ne_code: input.dataset.code, jan_code: value }),
    });
  })();

  // ─── カタログID・商品仕様の SKU 表 (2026-09-03 中原さん: RMS と同じ SKU 列 × 項目行の表) ───
  // セルは入力欄を離れたら即保存。一括入力は 1 リクエストで全 SKU。IDなし = JAN を消して理由を選ぶ
  (function initSkuGrid() {
    const grid = document.getElementById('rk-sku-grid');
    if (!grid) return;
    let members = [];
    try { members = JSON.parse(document.getElementById('rk-sku-members-json').textContent) || []; } catch (e) {}
    const attrSaver = createSkuSaver({
      inputs: [...grid.querySelectorAll('.sku-attr-input')], label: '商品仕様',
      send: (input, value) => post(BASE + '/sku-attributes', { ne_code: input.dataset.code, name: input.dataset.name, value }),
    });
    createSkuSaver({
      inputs: [...grid.querySelectorAll('.sku-exemption-select')], label: 'カタログIDなしの理由',
      send: (input, value) => post(BASE + '/sku-catalog-exemptions', { ne_code: input.dataset.code, reason: value }),
    });
    // ◉IDあり / ○IDなし (SKU ごと)。IDなし にしたら JAN を消して保存 (理由の select が出る)
    grid.addEventListener('change', (ev) => {
      const r = ev.target;
      if (!r.classList || !r.classList.contains('sku-catalog-mode')) return;
      const cell = r.closest('td');
      const withMode = r.value === 'with';
      cell.querySelector('.sku-catalog-with').style.display = withMode ? '' : 'none';
      cell.querySelector('.sku-catalog-without').style.display = withMode ? 'none' : '';
      const jan = cell.querySelector('.sku-jan-input');
      if (!withMode && jan.value.trim()) {
        jan.value = '';
        jan.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (withMode) jan.focus();
    });
    // 行を足す (候補ボタン・「ジャンル情報を取得」・「＋ 項目を追加」から)。値が入るまで DB には無い
    addGridRow = function (name, meta) {
      const existing = grid.querySelector('tr.sku-grid-attr[data-name="' + CSS.escape(name) + '"]');
      if (existing) return existing;
      const tr = document.createElement('tr');
      tr.className = 'sku-grid-attr';
      tr.dataset.name = name;
      const th = document.createElement('th');
      th.className = 'sku-grid-head';
      const title = document.createElement('div');
      title.textContent = name + ' ';
      if (meta && meta.mandatory) {
        const req = document.createElement('span'); req.style.color = '#dc2626'; req.textContent = '*必須'; title.appendChild(req);
      }
      th.appendChild(title);
      const hint = meta
        ? [meta.mandatory ? '必須' : null, meta.inputMethod === 'SELECTIVE' ? '選択式' : null,
           meta.unit ? '単位:' + meta.unit : null, meta.maxLength ? '〜' + meta.maxLength + '文字' : null]
            .filter(Boolean).join(' / ')
        : '';
      if (hint) { const h = document.createElement('div'); h.className = 'muted'; h.style.cssText = 'font-size:11px; font-weight:400;'; h.textContent = hint; th.appendChild(h); }
      if (meta && meta.inputMethod === 'SELECTIVE') {
        const w = document.createElement('div'); w.className = 'muted'; w.style.cssText = 'font-size:11px; font-weight:400; color:#b45309;';
        w.textContent = '⚠️ 楽天が用意した値と同じ表記で'; th.appendChild(w);
      }
      const btns = document.createElement('div');
      btns.style.cssText = 'margin-top:4px; display:flex; gap:6px;';
      btns.innerHTML = '<button type="button" class="btn btn-sm sku-grid-bulk" style="font-size:11px; padding:2px 8px;">一括入力</button>'
        + '<button type="button" class="btn btn-sm sku-grid-del" style="font-size:11px; padding:2px 8px;" title="この行を全SKUから外す">×</button>';
      btns.querySelector('.sku-grid-bulk').dataset.name = name;
      btns.querySelector('.sku-grid-del').dataset.name = name;
      th.appendChild(btns);
      tr.appendChild(th);
      for (const code of members) {
        const td = document.createElement('td');
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'sku-attr-input';
        input.dataset.code = code;
        input.dataset.name = name;
        input.maxLength = 300;
        input.title = '複数の値は | (縦棒) で区切る';
        input.style.cssText = 'font-size:12px; padding:4px 6px;';
        td.appendChild(input);
        tr.appendChild(td);
        attrSaver.register(input);
      }
      grid.querySelector('tbody').appendChild(tr);
      return tr;
    };
    // 一括入力 / 行を外す
    grid.addEventListener('click', async (ev) => {
      const bulk = ev.target.closest && ev.target.closest('.sku-grid-bulk');
      const del = ev.target.closest && ev.target.closest('.sku-grid-del');
      if (!bulk && !del) return;
      const name = (bulk || del).dataset.name;
      const cells = [...grid.querySelectorAll('.sku-attr-input[data-name="' + CSS.escape(name) + '"]')];
      let value;
      if (bulk) {
        const first = cells.find((c) => c.value.trim());
        const v = prompt('「' + name + '」を全SKUに一括入力します', first ? first.value.trim() : '');
        if (v === null) return;
        value = v.trim();
      } else {
        if (!confirm('「' + name + '」の行を全SKUから外しますか？ (値も消えます)')) return;
        value = '';
      }
      let json;
      try {
        // flush (プレビュー・登録・保存) が完了を待てるよう追跡する (Codex R2 high)
        json = await trackSkuOp(post(BASE + '/sku-attributes', { name, value, all: true }));
      } catch (e) {
        // 結果不明: サーバーが適用済みかもしれない。セルを意図した値にして「結果不明」にし、
        // 次の change / flush で SKU ごとに同じ値を再送して収束させる (黙って旧値のままにしない)
        cells.forEach((c) => { c.value = value; attrSaver.markUncertain(c); });
        alert('通信エラーで一括入力の結果が分かりません。保存・登録の前に自動で再送します (画面の値をそのまま使います)');
        updateTabBadges();
        return;
      }
      if (!json.ok) { alert(json.error || '保存に失敗しました'); return; }
      cells.forEach((c) => { c.value = value; attrSaver.markSaved(c, value); });
      if (del) {
        const tr = grid.querySelector('tr.sku-grid-attr[data-name="' + CSS.escape(name) + '"]');
        if (tr) tr.remove();
        renderAttrSuggest();
      } else if (rkResultCat) {
        rkResultCat.textContent = '「' + name + '」を全SKUに入れました (' + (value || '空') + ')';
      }
      updateTabBadges();
    });
  })();

  // 旧データの「カタログID」属性を削除する (バリエーションの SKU 表の警告)。JAN は専用行に入っている前提で人が押す
  (function initLegacyCatalogDrop() {
    const btn = document.getElementById('rk-legacy-catalog-drop');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      if (!confirm('旧データの「カタログID」属性を削除します。各 SKU の JAN は下の表の「カタログID」の行に入っていますか？')) return;
      btn.disabled = true;
      // 入力直後の JAN・商品仕様・理由の保存を待ち切ってから削除 → 再読み込み (Codex R4 high: 通信中の値を失う)
      if (!(await flushSkuSavers())) {
        alert('SKU 表の保存が終わっていない (または失敗した) ため削除しませんでした。表の値を確認してからもう一度押してください');
        btn.disabled = false;
        return;
      }
      let json;
      try {
        json = await postRakutenFields({ drop_legacy_catalog_attr: true });
      } catch (e) {
        json = { ok: false, error: '通信エラーで削除できませんでした。もう一度お試しください' };
      }
      if (!json.ok) { alert(json.error || '削除に失敗しました'); btn.disabled = false; return; }
      location.reload();
    });
  })();

  // 単品のカタログID (表の 1 行目): ◉IDあり=JAN / ○IDなし=理由。IDなし にしたら JAN 欄を空にする
  // (JAN の保存は saveJanIfChanged がプレビュー・登録・保存の前に確定させる)
