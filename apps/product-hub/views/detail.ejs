  // SKU別の選択肢 (2026-09-02 カラバリ出品)。JAN欄と同じ作法: 入力即保存・POSTは1本ずつ
  (function () {
    const inputs = [...document.querySelectorAll('.sku-selector-input')];
    if (inputs.length === 0) return;
    const result = document.getElementById('rk-result');
    let saveChain = Promise.resolve();
    inputs.forEach((input) => {
      let last = input.value.trim();
      async function save(value) {
        if (value === last) return;
        let json;
        try {
          json = await post(BASE + '/sku-selector-values', { ne_code: input.dataset.code, value: value });
        } catch (e) {
