<%- include('_header') %>
<style>
/* いまのジャンルの属性辞書に無い属性 (#1165)。必須属性の薄い赤 (#fca5a5・インライン) とは
   別物なので、インラインスタイルを書き換えずクラスで重ねる */
input.attr-unknown { border-color: #dc2626 !important; background: #fef2f2; }
th.attr-unknown { color: #dc2626; }
  /* 説明文3欄プレビュー: 送信HTMLの画像は width=100% (楽天ページでは正)。
     プレビュー枠で原寸表示すると巨大な帯になって読めないため、表示だけスマホ幅相当に
     縮小して中央寄せする (コピーされるHTMLはそのまま — 2026-08-05 中原さん指摘) */
  .desc3-render img { max-width: 420px !important; height: auto; display: block; margin: 0 auto; }
  /* タブ構成 (2026-07-29 中原さん要望: 項目をタブで整理し、必須未入力をバッジで見せる) */
  .tabbar { position: sticky; top: 0; z-index: 40; background: #f5f6f8; display: flex; gap: 6px;
            flex-wrap: wrap; align-items: center; padding: 10px 0; margin-bottom: 12px;
            border-bottom: 2px solid #e2e8f0; }
  .tab-btn { position: relative; border: 1px solid #cbd5e1; background: #fff; color: #475569;
             border-radius: 999px; padding: 7px 16px; font-size: 13px; cursor: pointer; }
  .tab-btn:hover { background: #f1f5f9; }
  .tab-btn.active { background: #2563eb; border-color: #2563eb; color: #fff; font-weight: 600; }
  .tab-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 18px;
               height: 18px; border-radius: 999px; background: #dc2626; color: #fff; font-size: 11px;
               font-weight: 700; margin-left: 6px; padding: 0 5px; vertical-align: 1px; }
  .tab-btn.active .tab-badge { background: #fff; color: #dc2626; }
  /* カタログID・商品仕様の SKU 表 (2026-09-03): 列 = SKU、行 = 項目。項目列は横スクロールしても固定 */
  .sku-grid th.sku-grid-head { position: sticky; left: 0; z-index: 1; background: #f8fafc; min-width: 190px;
                               text-align: left; font-weight: 600; vertical-align: top; }
  .sku-grid thead th { background: #f1f5f9; vertical-align: top; text-align: left; white-space: nowrap; }
  .sku-grid td { vertical-align: top; min-width: 190px; }
  .sku-grid td input[type="text"], .sku-grid td select { width: 100%; box-sizing: border-box; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  /* 工程パネル (誰のボールか)。.wf-dot は _header.ejs で共通定義 */
  .mini-note { font-size: 11px; color: #94a3b8; }
  /* モール別の展開状況を折りたたみ見出しで一目にする点 */
  .mall-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 3px;
              background: #e2e8f0; vertical-align: middle; }
  .mall-dot.mall-done { background: #16a34a; }
  .mall-dot.mall-doing { background: #f59e0b; }
  .mall-dot.mall-skip { background: #cbd5e1; opacity: .5; }
  #wf-card select, #wf-card input { font-size: 12px; padding: 4px 7px; }
  /* 確認中 (2026-08-31 中原さん: 折りたたみでは気づけない)。商品名のすぐ下に 1 本の帯で置き、
     理由ボタンを 1 タップで押せるようにする。立っているときは青く塗って見落とせなくする */
  .chk-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
             margin-top: 8px; padding: 6px 10px; border-radius: 8px;
             background: #f8fafc; border: 1px solid #e2e8f0; }
  .chk-bar.chk-on { background: #eff6ff; border: 2px solid #3b82f6; }
  .chk-lead { font-size: 13px; font-weight: 700; color: #334155; }
  .chk-bar.chk-on .chk-lead { color: #1e40af; }
  .chk-reason { font-size: 15px; color: #1e3a8a; }
  .chk-days { font-size: 12px; font-weight: 700; color: #fff; background: #3b82f6;
              border-radius: 999px; padding: 2px 10px; }
  .chk-pick { font-size: 13px; padding: 7px 14px; border: 1px solid #93c5fd;
              background: #fff; color: #1e40af; border-radius: 8px; cursor: pointer; }
  .chk-pick:hover { background: #dbeafe; border-color: #3b82f6; }
  .chk-clear { font-size: 13px; padding: 7px 16px; background: #16a34a; color: #fff;
               border: 1px solid #16a34a; border-radius: 8px; cursor: pointer; font-weight: 600; }
  .chk-clear:hover { background: #15803d; }
  .chk-note { width: 240px; font-size: 12px; }
  .chk-select { width: auto; font-size: 12px; }
  /* タブより上 (常時表示) のカードは詰める (2026-08-31 中原さん: 間延びして専有スペースが大きい)。
     ここが縦に伸びるほど、実際に手を動かす基本情報タブが画面の外へ押し出される。
     .card そのものを変えると他アプリの画面まで詰まるので、この画面のヘッダー帯だけに当てる */
  .card.hdr { padding: 9px 14px; margin-bottom: 8px; }
  .card.hdr h2 { font-size: 14px; margin: 0 0 6px; }
  /* 読まなくても操作できる説明は畳む (操作そのものは畳まない — 折りたたむと気づけないため) */
  .hdr-help > summary { cursor: pointer; font-size: 12px; color: #64748b; list-style: none; }
  .hdr-help > summary::-webkit-details-marker { display: none; }
  .hdr-help > summary::before { content: 'ⓘ '; }
  .hdr-help[open] > summary::before { content: '▾ '; }   /* 開閉が見た目で分かるようにする */
  .hdr-help > summary:hover { color: #1d4ed8; text-decoration: underline; }
  .hdr-help p { margin: 6px 0 0; font-size: 12px; color: #64748b; }
  /* 利益額・利益率 (2026-09-01 中原さん要望: 小さくて読み飛ばす)。売価を決めるときに
     一番見る数字なので、原価・内訳の文字とは別格の大きさで出す */
  .profit-figs { display: flex; gap: 20px; align-items: baseline; flex-wrap: wrap;
                 margin-top: 6px; padding: 7px 12px; border: 1px solid #e2e8f0;
                 border-radius: 8px; background: #f8fafc; }
  .profit-figs.neg { background: #fef2f2; border-color: #fca5a5; }   /* 赤字は枠ごと赤 */
  .profit-fig { display: flex; align-items: baseline; gap: 7px; }
  .profit-fig .lbl { font-size: 11px; font-weight: 700; color: #64748b; }
  .profit-fig .val { font-size: 24px; font-weight: 800; color: #0f172a; line-height: 1.15;
                     font-variant-numeric: tabular-nums; }
  .profit-fig .val.neg { color: #dc2626; }
  /* SKU別売価の表の利益セル。色は class で切り替える (inline style を JS で消すと
     ここの指定ごと消えてしまうため) */
  .sku-profit { font-size: 14px; font-weight: 700; color: #0f172a; white-space: nowrap; }
  .sku-profit.neg { color: #dc2626; }
  .sku-profit.none { font-size: 12px; font-weight: 400; color: #94a3b8; }
  /* NE登録の進み (2026-09-04 §5.3)。工程とは別に「どこで止まっているか」を1行で見せる */
  .ne-stepper { display:flex; align-items:center; gap:4px; flex-wrap:wrap; font-size:11px; }
  .ne-step { padding:2px 8px; border-radius:10px; border:1px solid #e2e8f0; background:#f8fafc; color:#64748b; }
  .ne-step.on { background:#fef3c7; color:#92400e; border-color:#fcd34d; font-weight:700; }
  .ne-step.on.ok { background:#dcfce7; color:#166534; border-color:#86efac; }
  .ne-step.on.bad { background:#fee2e2; color:#991b1b; border-color:#fca5a5; }
  .ne-arrow { color:#cbd5e1; }
  /* 未保存の印 (2026-09-21)。明示保存の欄は「ボタンを押すまで DB に行かない」ので、
     どこに未保存が残っているかをボタンとタブの両方で見えるようにする */
  .unsaved-mark { display:none; margin-left:8px; font-size:12px; font-weight:700; color:#b45309; }
  .unsaved-mark.on { display:inline; }
  .tab-unsaved { display:none; margin-left:4px; color:#f59e0b; font-size:11px; }
  .tab-unsaved.on { display:inline; }
  .unsaved-banner { margin-top:10px; padding:8px 12px; border-radius:8px; font-size:12.5px;
                    background:#fffbeb; border:1px solid #fcd34d; color:#92400e; }
  /* 即保存の結果 (2026-09-21)。入力を確定した時点で保存されたことを、その欄のそばで知らせる */
  .autosave-mark { margin-left: 8px; font-size: 11.5px; color: #16a34a; }
  .autosave-mark.bad { color: #dc2626; font-weight: 600; }
</style>
<div class="wrap wide">

  <div style="margin-bottom:8px; display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
    <%# 戻り先は開いた画面に合わせる (2026-08-28 中原さん要望: ボードのカードから開いたら、
        直前に見ていた工程ボード (本流 / 画像・絞り込み) に戻す。一覧から開いたら一覧へ) %>
    <a class="btn" href="<%= backLink.url %>"><%= backLink.label %></a>
    <span class="muted" style="font-size:12px;">
      項目の見方: <span class="ftag ftag-m" style="margin-left:0">手入力</span>=人が入れる /
      <span class="ftag ftag-ai" style="margin-left:0">AI</span>=AIが入れる (直してOK) /
      <span class="ftag ftag-auto" style="margin-left:0">自動</span>=何もしなくてよい
    </span>
  </div>

  <!-- ステータス + Notion -->
  <div class="card hdr">
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <span class="badge badge-<%= draft.status %>" style="font-size:13px"><%= statusLabels[draft.status] || draft.status %></span>
      <strong style="font-size:16px"><%= draft.name %></strong>
      <code class="muted"><%= draft.ne_code %></code>
      <span class="muted" style="font-size:11px;">ステータスは工程から自動で変わります</span>
      <span style="flex:1"></span>
      <% for (const s of nextStatuses) { %>
        <button class="btn btn-sm status-btn" data-to="<%= s %>"><%= s === 'resume' ? '▶ 再開する' : `${statusLabels[s]} にする` %></button>
      <% } %>
    </div>
    <% if (draft.status === 'draft' && gate.length > 0) { %>
      <div class="banner-warn" style="margin:12px 0 0;">
        <div>
          工程「基本情報入力」を完了にする (= AI生成の待ち行列に入れる) には以下が必要です:
          <ul style="margin:6px 0 0 18px; padding:0;">
            <% for (const r of gate) { %><li><%= r %></li><% } %>
          </ul>
        </div>
      </div>
    <% } %>
    <%# AI が「人の確認待ち」にした商品 (2026-08-28 夜間自動化)。解除だけでは生成されない — 人が直してから解除する %>
    <% if (draft.generation_block_code) { %>
      <div class="banner-warn" style="margin:12px 0 0; background:#fee2e2; border-color:#ef4444;">
        <div>
          <strong>⚠ AI が止めています: <%= blockLabels[draft.generation_block_code] || draft.generation_block_code %></strong>
          <div style="margin-top:4px; white-space:pre-wrap;"><%= draft.generation_block_reason %></div>
          <div class="muted" style="font-size:11px; margin-top:6px;">
            <%= draft.generation_blocked_by %> / <%= draft.generation_blocked_at %>
            — 基本情報 (商品名・URL 等) を直してから「解除」すると、次の夜間実行で AI が再挑戦します。直さずに解除すると同じ理由でまた止まります
          </div>
          <button class="btn btn-sm" id="gen-unblock-btn" data-blocked-at="<%= draft.generation_blocked_at %>" style="margin-top:8px;">解除する (AI に再挑戦させる)</button>
        </div>
      </div>
    <% } %>
    <%# 確認中 (2026-08-31 スタッフ要望): パッケージ裏面を見ないと埋まらない・ウェブに情報が無い等、
        「情報待ちで進められない」を表す印。工程 (列) も status も動かさず、ボードのカードに
        ラベルが出て列の先頭に並ぶ。AI の情報入力だけは止まる (確認中に原稿が書かれないように) %>
    <% if (draft.checking_since) { %>
      <% const cr = checkingReasons.find((r) => r.code === draft.checking_reason_code); %>
      <div class="chk-bar chk-on">
        <span class="chk-lead">🔍 確認中</span>
        <strong class="chk-reason"><%= cr ? cr.label : (draft.checking_reason_code || '') %></strong>
        <% if (checkingDays != null) { %><span class="chk-days"><%= checkingDays %>日目</span><% } %>
        <input type="text" id="checking-note" value="<%= draft.checking_note || '' %>"
               maxlength="<%= checkingNoteMax %>" placeholder="補足 (任意・入力したら更新を押す)" class="chk-note">
        <select id="checking-reason" class="chk-select" title="理由を変える">
          <% for (const r of checkingReasons) { %>
            <option value="<%= r.code %>" <%= r.code === draft.checking_reason_code ? 'selected' : '' %>><%= r.label %></option>
          <% } %>
        </select>
        <button class="btn btn-sm" id="checking-set-btn">更新</button>
        <span style="flex:1"></span>
        <button class="btn chk-clear" id="checking-clear-btn">✅ 確認できた</button>
      </div>
      <div class="muted" style="font-size:11px; margin-top:3px;">
        <%= draft.checking_by || '' %> / <%= draft.checking_since %> から — この間 AI の情報入力は動きません
      </div>
    <% } else { %>
      <%# ワンタップで立てられるようにする (2026-08-31 中原さん: 折りたたみは気づけない)。
          理由ごとにボタンを並べ、押した時点で確認中になる。補足は立てたあとで入れられる %>
      <div class="chk-bar" title="押すとボードのカードにラベルが出て、列の先頭に並びます">
        <span class="chk-lead">🔍 確認中にする</span>
        <% for (const r of checkingReasons) { %>
          <button class="btn chk-pick" data-reason="<%= r.code %>" title="<%= r.hint %>"><%= r.short || r.label %></button>
        <% } %>
        <%# 説明を title だけにすると iPad では読めない (Codex R1 medium)。
            省スペースは保ちたいので、同じ帯の末尾に短く常時表示する %>
        <span class="muted" style="font-size:11px;">押すとボードで先頭に出ます</span>
      </div>
    <% } %>
    <% if (draft.source === 'notion_import') { %>
      <div class="banner-warn" style="margin:12px 0 0;">
        📥 <strong>Notionから取り込んだ商品です (検証用)。</strong>
        Notion 側が正のため、ここで編集しても <strong>Notionには書き戻されません</strong>。
        既存カードの運用はNotionで行ってください。
        <% if (draft.source_notion_status) { %>
          <span class="muted">／ 取り込み時のNotion Status: <%= draft.source_notion_status %></span>
        <% } %>
        <button class="btn btn-sm btn-danger" id="delete-draft-btn" style="margin-left:8px">この取り込みを削除</button>
      </div>
    <% } %>
    <%# Notion はもう使わない運用 (2026-08-28 中原さん)。カードの状態も「Notionで開く」リンクも出さない。
        #action-result は画面全体の保存メッセージ置き場なので、この div ごとは消さない %>
    <div style="margin-top:10px; font-size:13px;">
      <span class="muted" id="action-result"></span>
    </div>
    <%# 読み直しで戻した未保存の入力の知らせ (2026-09-21)。中身は JS が作る %>
    <div id="unsaved-zone"></div>
  </div>

  <!-- タブバー。バッジ = 未入力の主要な必須項目数。
       サーバーの登録プリフライトの完全な再現ではない (形式エラー等はサーバーが最終判定) ため、
       0件でも「送信内容を確認」で最終チェックする前提 (Codex R1 Medium-3) -->
  <%
    // 転送済み判定は件数比較ではなく drive_file_id の突合 (Codex R1 Medium-2:
    // 画像を入れ替えると件数が同じでも未転送が発生し、サーバー検証とズレる)
    const transferredImageCount = images.filter(
      (im) => cabinetImages.some((c) => c.drive_file_id === im.drive_file_id)
    ).length;
  %>
  <!-- 楽天出品 (P3) -->
  <div class="card hdr" style="border-color:#fecaca; background:#fffbfa;">
    <h2>🛒 楽天に出品 <span class="muted" style="font-weight:400">(公開で登録 — 在庫0なので売れません。在庫はNE連携)</span></h2>
    <div style="font-size:13px; margin-bottom:6px;">
      🖼 画像転送:
      <% if (images.length === 0) { %>
        <span style="color:#b45309;">画像未登録 (画像タブでフォルダを取り込んでください)</span>
      <% } else if (transferredImageCount >= images.length) { %>
        <span style="color:#166534;">✅ <%= transferredImageCount %>/<%= images.length %> 枚 転送済み</span>
      <% } else { %>
        <span style="color:#b45309;">⚠️ 未転送 <%= images.length - transferredImageCount %> 枚 (<%= transferredImageCount %>/<%= images.length %> 済) — 画像タブの「画像をR-Cabinetへ転送」で送ってください</span>
      <% } %>
    </div>
    <% const selectedShopCats = shopCategories.filter((c) => c.selected)
         .sort((a, b) => (a.slot ?? 99) - (b.slot ?? 99) || a.id - b.id); // 枠順 (枠1=メイン) %>
    <% if (rakuten && rakuten.registered_at && rakuten.published_at) { %>
      <div style="background:#dcfce7; border:1px solid #86efac; border-radius:8px; padding:10px 14px; font-size:13px; margin-bottom:12px;">
        🟢 <strong>楽天で公開中</strong>
        <a href="<%= rakutenItemUrl %>" target="_blank" rel="noopener" style="margin-left:8px; font-weight:600;">🔗 楽天の商品ページを開く ↗</a>
        <% if (rakutenRmsUrl) { %><a href="<%= rakutenRmsUrl %>" target="_blank" rel="noopener" style="margin-left:8px; font-weight:600;" title="RMS の商品編集画面を開きます">🛠 RMSで編集 ↗</a><% } %>
        <span class="muted">(公開: <%= rakuten.published_at.replace('T',' ').slice(0,16) %> — アプリの記録。RMS画面で直接変更した場合はズレます)</span><br>
        問題があれば「非公開に戻す」で売り場から下げられます。
        <div style="margin-top:8px;">
          <button class="btn btn-sm" id="rk-unpublish-btn">非公開に戻す</button>
        </div>
      </div>
    <% } else if (rakuten && rakuten.registered_at) { %>
      <div style="background:#fefce8; border:1px solid #fde047; border-radius:8px; padding:10px 14px; font-size:13px; margin-bottom:12px;">
        ✅ <strong>楽天に非公開 (倉庫指定) で登録済み</strong>
        <span class="muted">(<%= rakuten.registered_at.replace('T',' ').slice(0,16) %>)</span><br>
        公開前チェック:
        <ul style="margin:6px 0 0 18px; padding:0;">
          <li>在庫は <strong>0 で登録</strong>されています (在庫は NE 連携 / 運用側で入れる)</li>
          <% if (selectedShopCats.length > 0) { %>
            <li>
              店舗内カテゴリ: <strong><%= selectedShopCats.map((c) => c.path).join(' ／ ') %></strong>
              <%# 状態は「今の選択が反映済みか」で判定する (反映後に棚を変えたら stale) %>
              <% if (shopCatSyncState === 'synced') { %>
                <span style="color:#166534;">✅ 反映済み (<%= rakuten.shop_categories_synced_at.replace('T',' ').slice(0,16) %>)</span>
              <% } else if (shopCatSyncState === 'stale') { %>
                <span style="color:#b45309;">⚠️ 反映後に棚を変えました (もう一度反映してください)</span>
              <% } else if (shopCatSyncState === 'failed') { %>
                <span style="color:#dc2626;">❌ 反映に失敗</span>
              <% } else { %>
                <span class="muted">⏳ 未反映</span>
              <% } %>
              <button class="btn btn-sm" id="rk-syncshopcat-btn" style="margin-left:6px;">棚を反映</button>
              <span class="muted" id="rk-syncshopcat-result" style="font-size:12px;"></span>
              <% if (rakuten.shop_categories_error && shopCatSyncState !== 'synced') { %>
                <div class="muted" style="font-size:11px; color:#b91c1c; white-space:pre-wrap;"><%= rakuten.shop_categories_error %></div>
              <% } %>
            </li>
          <% } else { %>
            <li class="muted">店舗内カテゴリが未選択です (どの棚にも載りません)</li>
          <% } %>
          <li>「送信内容を確認」でページ内容を最終確認</li>
        </ul>
        <div style="margin-top:8px;">
          <button class="btn btn-primary btn-sm" id="rk-publish-btn">楽天で公開する</button>
          <span class="muted" style="font-size:12px;">アプリから公開に切り替えます (RMS画面を開く必要はありません)</span>
        </div>
      </div>
    <% } %>
    <% if (rakuten && rakuten.last_error) { %>
      <div class="banner-warn" style="margin:0 0 12px; white-space:pre-wrap; font-size:12px;">⚠️ 前回のRMSエラー:
<%= rakuten.last_error %></div>
    <% } %>

    <details class="hdr-help" style="margin:0 0 6px;">
      <summary>送られる値・項目の場所</summary>
      <p>
        税率 (<%= yahoo?.tax_rate || '未設定 = 店舗デフォルト10%' %>) と カタログID (JAN<%= (variation && variation.kind === 'variation' && variation.memberCount > 1) ? ' — SKU表の値をSKUごとに' : ': ' + (draft.jan_code || '未入力') %>) は基本情報タブの値を自動で送ります。
        在庫は常に 0 で登録します。<br>
        配送方法・売価は「基本情報」タブ、ジャンル・店舗内カテゴリ・商品属性は「カテゴリ・属性」タブにあります。
        </p>
    </details>

    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <button class="btn" id="rk-save-btn">出品情報を保存 (全タブ分)</button>
      <button class="btn" id="rk-preview-btn">送信内容を確認</button>
      <button class="btn btn-primary" id="rk-register-btn">公開で登録</button>
      <span class="muted" id="rk-result"></span>
    </div>
    <pre id="rk-preview" style="display:none; margin-top:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px; font-size:11px; max-height:340px; overflow:auto;"></pre>
  </div>

  <!-- ═══ 工程 (いま誰のボールか) ═══ 2026-08-23 -->
  <div class="card hdr" id="wf-card" style="border-color:#bfdbfe; background:#f8fbff;">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span style="font-size:14px; font-weight:700;">🔁 工程</span>
      <% if (workflow.current) { %>
        <span class="badge" style="background:#dbeafe; color:#1d4ed8;"><%= workflow.current.label %></span>
        <span style="font-size:13px; display:inline-flex; align-items:center; gap:5px;">
          <% if (workflow.current.assignee_name) { %>
            <span class="wf-dot" style="background:<%= workflow.current.assignee_color || '#94a3b8' %>"></span>
            <%= workflow.current.assignee_name %>
            <% if (workflow.current.assignee_active !== 1) { %><span class="muted">(無効)</span><% } %>
          <% } else if (workflow.current.role_label) { %>
            <span style="color:#b45309; font-weight:600;"><%= workflow.current.role_label %> — 未割り当て</span>
          <% } else { %>
            <span class="muted">システム (夜間バッチ)</span>
          <% } %>
        </span>
      <% } else { %>
        <span class="badge badge-approved">全工程 完了</span>
      <% } %>
      <span class="muted"><%= workflow.doneCount %>/<%= workflow.totalCount %> 完了</span>
      <% if (workflow.stalledDays) { %>
        <span class="badge" style="background:#fee2e2; color:#b91c1c;">⚠️ <%= workflow.stalledDays %>日 動いていません</span>
      <% } %>
      <span style="flex:1"></span>
      <%# 画像の工程は商品詳細 (LP) の 1 本 (2026-08-31: TOP の 4 工程は廃止し、
          TOP画像そのものは「画像が登録されているか」で見る)。現在地をここに常時出す %>
      <% const kindChip = (label, t) => { %>
        <span style="font-size:12px;">
          🖼 <%= label %>:
          <% if (t.excluded) { %>
            <span class="muted">対象外</span>
          <% } else if (t.done) { %>
            <span style="color:#166534; font-weight:600;">完了</span>
          <% } else if (t.current) { %>
            <%= t.current.label %>
            <% if (t.current.assignee_name) { %>
              <span class="wf-dot" style="background:<%= t.current.assignee_color || '#94a3b8' %>"></span><%= t.current.assignee_name %>
            <% } %>
            <% if (t.stalledDays) { %>
              <span style="color:#b91c1c; font-weight:600;">／ <%= t.stalledDays %>日 滞留</span>
            <% } %>
          <% } else { %>
            <span class="muted">—</span>
          <% } %>
        </span>
      <% }; %>
      <% kindChip('画像', workflow.imageDetail); %>
    </div>

    <details style="margin-top:10px;">
      <summary style="cursor:pointer; font-size:13px; color:#1d4ed8;">工程を進める / 担当者を変える</summary>
      <table class="list" style="margin-top:8px;">
        <thead>
          <tr><th style="width:210px">工程</th><th style="width:110px">状態</th><th style="width:170px">担当者</th>
              <th style="width:140px">期限</th><th style="width:100px">完了日</th><th>メモ</th></tr>
        </thead>
        <tbody>
          <%
            // 動かせるのは admin か担当者本人 (サーバー側 assertStepPermission と同じ条件)。
            // 画像の工程は担当者で縛らず、その工程の役割 (画像登録者・画像作成承認者) を持つ人なら動かせる (2026-09-13)。
            // それ以外の未割り当ての工程は「自分が担当する」で引き受けてから操作する
            const byImageRole = (s) => s.track === 'image' && !!s.role_code && myRoleCodes.includes(s.role_code);
            const canEditStep = (s) => isAdmin || (s.assignee_id != null && s.assignee_id === myStaffId) || byImageRole(s);
            const canClaimStep = (s) => !isAdmin && !!myStaffId && !!s.role_code && s.assignee_id == null && s.track !== 'image';
          %>
          <% for (const s of workflow.main.concat(workflow.imageTop.rows, workflow.imageDetail.rows)) { %>
            <% const isDetailKind = s.track === 'image' && s.image_kind === 'detail'; %>
            <%# 詳細画像が「対象外」の商品では detail 側の工程を触らせない (フラグが正) %>
            <% const editable = canEditStep(s) && !(isDetailKind && workflow.detailExcluded); %>
            <%# data-prev-state = いまの状態。⑤で「完了」を選んだときに選択を戻すために使う (2026-09-04) %>
            <tr data-step="<%= s.step_code %>" data-version="<%= s.version == null ? '' : s.version %>"
                data-prev-state="<%= s.state %>"
                <%= workflow.current && workflow.current.step_code === s.step_code ? 'style="background:#eff6ff"' : (isDetailKind && workflow.detailExcluded ? 'style="opacity:.45"' : '') %>>
              <td>
                <% if (s.track === 'image') { %>
                  <span class="badge" style="font-size:10px; padding:1px 6px; background:<%= isDetailKind ? '#ede9fe' : '#dbeafe' %>; color:<%= isDetailKind ? '#6d28d9' : '#1d4ed8' %>;">🖼 <%= isDetailKind ? '詳細' : 'TOP' %></span>
                <% } %>
                <%= s.label %>
                <% if (s.description) { %><br><span class="mini-note" title="<%= s.description %>"><%= s.description.length > 34 ? s.description.slice(0, 34) + '…' : s.description %></span><% } %>
              </td>
              <td>
                <select class="wf-state" <%= editable ? '' : 'disabled' %>
                        title="<%= editable ? '' : (isDetailKind && workflow.detailExcluded ? '詳細画像は対象外です' : (s.track === 'image' && s.role_code ? '画像の工程は 画像登録者・画像作成承認者 の役割がある人が操作します' : (s.assignee_name ? s.assignee_name + ' さんの担当です' : (s.role_code ? '「自分が担当する」を押すと操作できます' : (s.step_code === 'ai_generate' ? 'AI が進める工程です。AI を待たずに進めるときは工程ボードでカードを動かしてください' : 'システムが進める工程です'))))) %>">
                  <% for (const code of Object.keys(stepStateLabels)) { %>
                    <%# 「対象外」は工程を飛ばすので admin だけ。TOP画像の工程はサムネ必須のため admin でも不可、
                        詳細画像を丸ごと作らない場合は下の「詳細画像は対象外」を使う (商品単位のフラグ) %>
                    <% if (code === 'skip' && s.track === 'image' && s.image_kind !== 'detail' && s.state !== 'skip') continue; %>
                    <% if (code === 'skip' && !isAdmin && s.state !== 'skip') continue; %>
                    <option value="<%= code %>" <%= s.state === code ? 'selected' : '' %>><%= stepStateLabels[code] %></option>
                  <% } %>
                </select>
              </td>
              <td>
                <% if (!s.role_code) { %>
                  <span class="muted" style="font-size:12px;">システム</span>
                <% } else if (s.track === 'image') { %>
                  <%# 画像の工程は担当者を置かない (2026-09-13 スタッフ要望)。役割がある人なら誰でも動かせる %>
                  <span class="muted" style="font-size:12px;">担当なし (役割がある人が操作)</span>
                <% } else if (isAdmin) { %>
                  <select class="wf-assignee">
                    <option value="">未割り当て</option>
                    <% for (const st of workflowStaff) { %>
                      <option value="<%= st.id %>" <%= s.assignee_id === st.id ? 'selected' : '' %>><%= st.name %></option>
                    <% } %>
                    <% if (s.assignee_id && !workflowStaff.some((x) => x.id === s.assignee_id)) { %>
                      <option value="<%= s.assignee_id %>" selected><%= s.assignee_name %> (無効)</option>
                    <% } %>
                  </select>
                <% } else if (s.assignee_id == null) { %>
                  <%# 未割り当ては引き受けだけ許す。引き受けてから状態を動かす %>
                  <% if (canClaimStep(s)) { %>
                    <button type="button" class="btn btn-sm wf-claim">自分が担当する</button>
                  <% } else { %>
                    <span class="muted" style="font-size:12px;">未割り当て</span>
                  <% } %>
                <% } else { %>
                  <span style="font-size:12px; display:inline-flex; align-items:center; gap:4px;">
                    <span class="wf-dot" style="background:<%= s.assignee_color || '#94a3b8' %>"></span><%= s.assignee_name %>
                  </span>
                <% } %>
              </td>
              <td><input type="date" class="wf-due" value="<%= s.due_date || '' %>" <%= editable ? '' : 'disabled' %>></td>
              <td class="muted" style="font-size:12px;"><%= s.done_at ? String(s.done_at).slice(0, 10) : '—' %></td>
              <td><input type="text" class="wf-note" value="<%= s.note || '' %>" placeholder="(任意)" maxlength="300" <%= editable ? '' : 'disabled' %>></td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <%
        // 「詳細画像は対象外」を切り替えられるのは admin か、詳細画像「依頼」工程の担当者本人か役割がある人
        // (サーバー側 setDetailImagesExcluded と同じ条件。2026-09-13 から画像の工程は役割で見る)
        const detailReqRow = workflow.imageDetail.rows.find((r) => r.image_stage === 'request');
        const canToggleDetailExcluded = isAdmin
          || (myStaffId != null && detailReqRow
            && (detailReqRow.assignee_id === myStaffId || (!!detailReqRow.role_code && myRoleCodes.includes(detailReqRow.role_code))));
      %>
      <p style="margin:10px 0 0; font-size:12px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
        <% if (workflow.detailExcluded) { %>
          <span style="color:#6d28d9;">🖼 この商品は<strong>詳細画像を作りません</strong> (TOP画像が登録されていれば出品ゲートが開きます)</span>
          <% if (canToggleDetailExcluded) { %>
            <button type="button" class="btn btn-sm" id="wf-detail-excluded" data-next="false">対象外を解除する</button>
          <% } %>
        <% } else if (canToggleDetailExcluded) { %>
          <button type="button" class="btn btn-sm" id="wf-detail-excluded" data-next="true">🖼 詳細画像は作らない (対象外にする)</button>
          <span class="muted">単純な仕入れ商品など、TOP画像だけで出品する場合</span>
        <% } %>
      </p>
      <p class="muted" style="margin:8px 0 0; font-size:12px;">
        変更するとその場で保存されます。<span id="wf-result"></span>
      </p>
    </details>

    <!-- モール別の展開状況 (工程「出品・展開」の中身) -->
    <details style="margin-top:8px;" id="mall-details">
      <summary style="cursor:pointer; font-size:13px; color:#1d4ed8;">
        モール別の展開状況
        <span class="muted" style="margin-left:6px;">
          <%= mallStatus.doneCount %>/<%= mallStatus.totalCount %> 掲載済<% if (mallStatus.skipCount) { %> ・対象外 <%= mallStatus.skipCount %><% } %>
        </span>
        <span style="margin-left:8px;">
          <% for (const m of mallStatus.list) { %>
            <span class="mall-dot mall-<%= m.state %>" title="<%= m.label %>: <%= stepStateLabels[m.state] %>"></span>
          <% } %>
        </span>
      </summary>
      <table class="list" style="margin-top:8px;">
        <thead>
          <tr><th style="width:150px">モール</th><th style="width:110px">状態</th><th style="width:170px">担当者</th>
              <th style="width:100px">掲載日</th><th>掲載URL / メモ</th></tr>
        </thead>
        <tbody>
          <% for (const m of mallStatus.list) { %>
            <% const mEditable = isAdmin || (m.assignee_id != null && m.assignee_id === myStaffId); %>
            <tr data-mall="<%= m.code %>" data-version="<%= m.version == null ? '' : m.version %>">
              <td>
                <%= m.label %>
                <% if (m.hint) { %><br><span class="mini-note"><%= m.hint %></span><% } %>
              </td>
              <td>
                <select class="ml-state" <%= mEditable ? '' : 'disabled' %>
                        title="<%= mEditable ? '' : (m.assignee_name ? m.assignee_name + ' さんの担当です' : '「自分が担当する」を押すと操作できます') %>">
                  <% for (const code of Object.keys(stepStateLabels)) { %>
                    <% if (code === 'skip' && !isAdmin && m.state !== 'skip') continue; %>
                    <option value="<%= code %>" <%= m.state === code ? 'selected' : '' %>><%= stepStateLabels[code] %></option>
                  <% } %>
                </select>
              </td>
              <td>
                <% if (isAdmin) { %>
                  <select class="ml-assignee">
                    <option value="">未割り当て</option>
                    <% for (const st of workflowStaff) { %>
                      <option value="<%= st.id %>" <%= m.assignee_id === st.id ? 'selected' : '' %>><%= st.name %></option>
                    <% } %>
                  </select>
                <% } else if (m.assignee_id == null) { %>
                  <% if (myStaffId) { %>
                    <button type="button" class="btn btn-sm ml-claim">自分が担当する</button>
                  <% } else { %><span class="muted" style="font-size:12px;">未割り当て</span><% } %>
                <% } else { %>
                  <span style="font-size:12px; display:inline-flex; align-items:center; gap:4px;">
                    <span class="wf-dot" style="background:<%= m.assignee_color || '#94a3b8' %>"></span><%= m.assignee_name %>
                  </span>
                <% } %>
              </td>
              <td class="muted" style="font-size:12px;"><%= m.listed_at ? String(m.listed_at).slice(0, 10) : '—' %></td>
              <td>
                <% if (m.code === 'rakuten' && m.state === 'done') { %>
                  <a href="<%= rakutenItemUrl %>" target="_blank" rel="noopener" style="font-size:12px;">楽天の商品ページ</a>
                  <% if (rakutenRmsUrl) { %> / <a href="<%= rakutenRmsUrl %>" target="_blank" rel="noopener" style="font-size:12px;">RMSで編集</a><% } %><br>
                <% } else if (m.item_url) { %>
                  <a href="<%= m.item_url %>" target="_blank" rel="noopener" style="font-size:12px;">掲載ページ</a><br>
                <% } %>
                <input type="text" class="ml-note" value="<%= m.note || '' %>" placeholder="メモ (任意)" maxlength="300" <%= mEditable ? '' : 'disabled' %>>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <p class="muted" style="margin:8px 0 0; font-size:12px;">
        全モールが「掲載済」か「対象外」になると、工程「出品・展開」が自動で完了になります。
        <span id="ml-result"></span>
      </p>
    </details>

    <!-- セット商品 (工程「セット商品作成検討」の実務) -->
    <% if (setInfo) { %>
      <div style="margin-top:10px; padding:10px 12px; background:#fff7ed; border:1px solid #fed7aa; border-radius:8px;">
        <div style="font-size:13px;">
          🎁 これは
          <% if (setInfo.parent) { %>
            <a href="/apps/product-hub/detail/<%= setInfo.parent.id %>"><%= setInfo.parent.name %></a>
          <% } else { %>元の商品<% } %>
          から作ったセット商品です
          <% if (setInfo.members.length) { %>
            <span class="muted">（構成: <%= setInfo.members.map((m) => `${m.member_ne_code}×${m.qty}`).join(' ＋ ') %>）</span>
          <% } %>
        </div>
        <%# 売価の由来 (§5.3/§4.4)。構成の「単品売価 × 個数」の和を初期値として**実際に入れて**いるので、
            その式を1行で見せる。人が値付けした後は「初期値は〜でした」に言い方を変える %>
        <% if (setInfo.priceOrigin) { %>
          <div class="muted" style="margin-top:6px; font-size:12px;">
            売価の目安（構成の単品売価の合計）は「<%= setInfo.priceOrigin.text %>」です（税込。送料・値引きは含みません）。
            <% if (setInfo.priceOrigin.priceEmpty) { %>
              <strong>売価がまだ入っていません。</strong>
            <% } else { %>
              作成時に入れた初期値は下のイベント欄（<code>price_prefilled</code>）で確認できます。
            <% } %>
          </div>
        <% } %>
        <%# 親が派生後に変わった (§4.5)。自動追随はしない — 見て判断してもらう %>
        <% if (setInfo.parentChanged) { %>
          <div style="margin-top:8px; padding:6px 8px; background:#fff; border:1px solid #fbbf24; border-radius:6px; font-size:12px;">
            🔔 派生したあとに親商品が更新されています。
            <% if (setInfo.parent) { %>
              <a href="/apps/product-hub/detail/<%= setInfo.parent.id %>">親を見る</a>
            <% } %>
            （セットには自動で反映しません）
            <button class="btn btn-sm" id="parent-ack-btn" style="margin-left:6px;">確認した</button>
            <span class="muted" id="parent-ack-result"></span>
          </div>
        <% } %>

        <%# NE登録の進み (§5.3)。工程「NE登録」とは別に、どこで止まっているかを出す。
            「本コード確定」は provisional_code から導出した値 (列には持たない) %>
        <div class="ne-stepper" style="margin-top:10px;">
          <% for (const st of ['not_requested', 'requested', 'processing', 'confirmed']) { %>
            <span class="ne-step <%= setInfo.neState === st ? 'on' : '' %><%= st === 'confirmed' && setInfo.neState === 'confirmed' ? ' ok' : '' %>">
              <%= (NE_STATE_LABELS[st] || st).replace('NE: ', '') %>
            </span>
            <% if (st !== 'confirmed') { %><span class="ne-arrow">→</span><% } %>
          <% } %>
          <% if (setInfo.neState === 'needs_action') { %>
            <span class="ne-step on bad"><%= (NE_STATE_LABELS.needs_action || '').replace('NE: ', '') %></span>
          <% } %>
        </div>
        <% if (setInfo.neState === 'needs_action' && setInfo.neError) { %>
          <div style="margin-top:6px; font-size:12px; color:#991b1b;">⚠ <%= setInfo.neError %></div>
        <% } %>
        <% if (setInfo.neRequestedAt) { %>
          <div class="muted" style="margin-top:4px; font-size:11px;">
            依頼: <%= setInfo.neRequestedAt.slice(0, 16).replace('T', ' ') %>
            <%= setInfo.neRequestedBy ? ` / ${setInfo.neRequestedBy}` : '' %>
          </div>
        <% } %>

        <% if (setInfo.provisional) { %>
          <% const stillTemp = /^SET-/i.test(String(draft.ne_code || '')); %>
          <div style="margin-top:8px; font-size:13px; color:#b45309;">
            <% if (stillTemp) { %>
              ⚠️ 商品コードが仮のままです（<code><%= draft.ne_code %></code>）。<strong>このままでは楽天に出品できません。</strong>
              ネクストエンジンに登録した本コードへ差し替えてください。
            <% } else { %>
              ⚠️ 商品コード「<code><%= draft.ne_code %></code>」がNE商品マスタに見つかりません（登録待ちか取込待ち）。
              <strong>取り込まれるとこの画面を開いたときに自動で解除されます。</strong>それまで楽天には出品できません。
            <% } %>
          </div>
          <div style="display:flex; gap:8px; align-items:center; margin-top:8px; flex-wrap:wrap;">
            <input type="text" id="set-code-input" placeholder="ネクストエンジンの商品コード" style="max-width:280px;" maxlength="100">
            <button class="btn btn-primary btn-sm" id="set-code-btn">本コードに差し替える</button>
            <%# 進みを動かす操作 (§4.3)。押せるのは工程の担当者・セット企画者・管理者 %>
            <% if (setInfo.neState === 'not_requested') { %>
              <button class="btn btn-sm ne-state-btn" data-state="requested">NEに登録を依頼した</button>
            <% } else if (setInfo.neState === 'needs_action') { %>
              <button class="btn btn-sm ne-state-btn" data-state="requested">再要求する</button>
            <% } else { %>
              <button class="btn btn-sm ne-state-btn" data-state="needs_action">登録できなかった</button>
            <% } %>
            <span class="muted" id="set-code-result"></span>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <%# セット展開判断の入口 (§5.4)。以前は「作らない・保留」の入口が工程パネルの状態プルダウン
          の中にしか無く、畳まれた details の二段奥で現場から見つけられなかった
          (2026-09-06 中原さん「作る・作らないのボタンをもっと分かりやすく」)。
          作る／作らない を同じ大きさのボタンで横に並べ、いまの判断を札で常時出す %>
      <%
        // 判断を動かせるのは⑤の担当者本人か admin (サーバー側 assertStepOperable と同じ条件)。
        // 押せないボタンを出すと 403 で弾かれてから理由を知ることになるので、ここで出し分ける。
        // canEditStep は上の工程パネルで定義済み
        const setStep = (workflow.main || []).find((s) => s.step_code === 'set_review') || null;
        const setStepEditable = !!setStep && canEditStep(setStep);
        const setDec = setDecision && setDecision.decision ? setDecision.decision : null;
        // 未判断も色を付ける — 「まだ決めていない」が一目で分かるのがこの札の目的
        const setChip = (setDec === 'create' || setDec === 'existing') ? { bg: '#dcfce7', fg: '#166534' }
          : setDec === 'none' ? { bg: '#e2e8f0', fg: '#475569' }
          : setDec === 'hold' ? { bg: '#fef3c7', fg: '#92400e' }
          : { bg: '#fee2e2', fg: '#b91c1c' };
      %>
      <div style="margin-top:10px; padding:12px 14px; background:#fff; border:2px solid #cbd5e1; border-radius:10px;">
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
          <span style="font-size:14px; font-weight:700;">🎁 セット商品にする？</span>
          <span class="badge" style="background:<%= setChip.bg %>; color:<%= setChip.fg %>;"><%= setDecisionText || 'まだ決めていません' %></span>
          <% if (setDrafts.length) { %><span class="muted"><%= setDrafts.length %> 件作成済み</span><% } %>
        </div>
        <p class="muted" style="margin:6px 0 0; font-size:12px;">
          まとめ買い用のセットを作るか決めます（決めても<strong>単品の出品は止まりません</strong>）。
          <strong>作らない・保留も記録します</strong> — 作る・作らない・既存ありのどれかを決めるまで
          工程「セット商品作成検討」は閉じません（<strong>保留のままでは閉じません</strong>）。
        </p>
        <div style="display:flex; gap:10px; margin-top:10px; flex-wrap:wrap;">
          <%# 決まった後は作成を推さない (色を戻す)。まだ決めていない間と「保留」の間だけ、
              いちばん進めたい操作 = 作成なので青のままにする %>
          <button type="button" class="btn <%= (setDec && setDec !== 'hold') ? '' : 'btn-primary' %>" id="set-create-open"
                  style="font-size:14px; font-weight:700; padding:10px 18px;"
                  <%= setStepEditable ? '' : 'disabled' %>>🎁 <%= setDrafts.length ? 'もう1つセットを作る' : 'セットを作る' %></button>
          <button type="button" class="btn" id="set-decision-open"
                  style="font-size:14px; font-weight:700; padding:10px 18px;"
                  <%# 何かしら判断済みなら「見直す」。create / existing を数え忘れると、
                      札が「既存のセットあり」なのにボタンは「作らない」という食い違いになる (Codex R1) %>
                  <%= setStepEditable ? '' : 'disabled' %>><%= setDec ? '✏️ この判断を見直す' : '🚫 セットは作らない／保留にする' %></button>
          <%# 押し間違いを戻す入口 (2026-09-07 中原さん要望)。ボードのカードにも同じものがある。
              「見直す」= 別の判断で上書き、「取り消す」= 判断そのものを白紙 (ひとつ前) に戻す %>
          <% if (setDec) { %>
            <button type="button" class="btn" id="set-decision-undo"
                    style="font-size:13px; padding:10px 14px; color:#64748b;"
                    <%= setStepEditable ? '' : 'disabled' %>>↩ この判断を取り消す</button>
          <% } %>
        </div>
        <% if (!setStepEditable) { %>
          <p class="muted" style="margin:8px 0 0; font-size:12px;">
            決められるのは<strong>工程「セット商品作成検討」の担当者</strong>か管理者です<% if (setStep && setStep.assignee_name) { %>（いまの担当: <%= setStep.assignee_name %> さん）<% } else { %>（いまは未割り当て。上の「工程を進める / 担当者を変える」で自分が担当にできます）<% } %>。
          </p>
        <% } %>
        <% if (setDrafts.length) { %>
          <table class="list" style="margin-top:10px;">
            <tbody>
              <% for (const s of setDrafts) { %>
                <tr>
                  <td><a href="/apps/product-hub/detail/<%= s.id %>"><%= s.name %></a></td>
                  <td style="width:180px;"><code style="font-size:11px;"><%= s.ne_code %></code>
                    <% if (s.provisional_code === 1) { %><span style="color:#b45309; font-size:11px;">仮</span><% } %></td>
                  <td class="muted" style="width:200px; font-size:11px;"><%= s.members || '' %></td>
                  <td style="width:90px;"><span class="badge badge-<%= s.status %>"><%= statusLabels[s.status] || s.status %></span></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
        <%# 作成フォームは既定で畳んでおく (押してから中身を決める)。details の summary だと
            「作らない」ボタンと大きさが揃わないので、button + hidden の開閉にした %>
        <div id="set-create-box" hidden style="margin-top:12px; padding-top:12px; border-top:1px dashed #cbd5e1;">
          <div style="font-size:13px; font-weight:600; margin-bottom:6px;">セットの中身を決める</div>
          <%# 構成は複数行で指定できる (§5.6)。既定は「この商品 × 2」= いちばん多い形。
              候補はこの商品と、バリエーションがあればその子SKU (混載セットの入口) %>
          <label>構成 <span class="muted">(何を何個入れるか)</span></label>
          <datalist id="set-member-codes">
            <option value="<%= draft.ne_code %>"><%= draft.name %></option>
            <% if (variation.kind === 'variation') { %>
              <% for (const m of variation.members) { %>
                <option value="<%= m.商品コード %>"><%= m.商品名 || '' %></option>
              <% } %>
            <% } %>
          </datalist>
          <div id="set-members" style="display:grid; gap:6px; margin:4px 0 6px;"></div>
          <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
            <button type="button" class="btn btn-sm" id="set-member-add">＋ 行を追加</button>
            <span class="muted" style="font-size:11.5px;">同じ商品の複数個も、別商品を混ぜたセットもここで指定します</span>
          </div>
          <div style="flex:1; min-width:220px;">
            <label>セット商品名 <span class="muted">(空なら自動)</span></label>
            <input type="text" id="set-name" placeholder="<%= draft.name %> 2個セット" maxlength="300">
          </div>
          <p class="muted" style="margin:8px 0; font-size:12px;">
            商品コードは <code>SET-<%= draft.ne_code %>-01</code> のような<strong>仮コード</strong>で作ります。
            ネクストエンジンに登録したら本コードへ差し替えてください（差し替えるまで楽天出品はできません）。
            <br>売価は<strong>構成の「単品売価 × 個数」の合計</strong>を初期値として入れます（そこから値付けしてください）。
            <strong>配送方法は引き継ぎません</strong>（個数で箱もサイズも変わるため。NEに本コードが載ると自動で選ばれます）。
            画像・JANはセット用に作り直しになるので引き継ぎません。
          </p>
          <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <button class="btn btn-primary btn-sm" id="set-ai-btn">AIに書き換えてもらう</button>
            <button class="btn btn-sm" id="set-copy-btn">コピーしてすぐ直す</button>
            <button type="button" class="btn btn-sm" id="set-create-cancel">閉じる</button>
            <span class="muted" id="set-create-result"></span>
          </div>
          <p class="muted" style="margin:6px 0 0; font-size:11px;">
            「AIに書き換えてもらう」＝ AI情報入力待ちから／「コピーしてすぐ直す」＝ 説明文をコピーして商品説明確認から始まります。
          </p>
        </div>
      </div>
    <% } %>
  </div>

  <div class="tabbar" id="tabbar"
       data-image-count="<%= images.length %>" data-transferred-count="<%= transferredImageCount %>"
       data-ref-count="<%= refs.length %>">
    <!-- 並び順 = 入力の流れ (中原さん指定 2026-08-01): 基本情報 → 商品情報 → カテゴリ → 説明 → 画像。出品カードとYahoo!欄はタブ廃止し上部/基本情報へ (2026-08-05) -->
    <button type="button" class="tab-btn" data-tab="tab-basic">✏️ 基本情報<span class="tab-badge" hidden></span></button>
    <button type="button" class="tab-btn" data-tab="tab-info">📄 商品情報<span class="tab-badge" hidden></span></button>
    <button type="button" class="tab-btn" data-tab="tab-category">🗂 カテゴリ・属性<span class="tab-badge" hidden></span></button>
    <button type="button" class="tab-btn" data-tab="tab-desc">📝 商品説明<span class="tab-badge" hidden></span></button>
    <button type="button" class="tab-btn" data-tab="tab-images">🖼 画像<span class="tab-badge" hidden></span></button>
    <% if (draft.own_brand && adKeywords) { %>
      <%# SP広告 検索KW (2026-09-23 PR1)。自社商品だけ。工程には足さない (足すと楽天出品が止まる副作用) %>
      <button type="button" class="tab-btn" data-tab="tab-adkw">📣 SP広告KW<span class="tab-badge" hidden></span></button>
    <% } %>
    <span class="muted" style="margin-left:6px;">赤い数字 = 未入力の主要な必須項目 (内訳はマウスオーバー。最終チェックは「送信内容を確認」で)</span>
  </div>

  <!-- ═══ タブ1: 基本情報 ═══ -->
  <div class="tab-panel" id="tab-basic">
  <%# 🆕 入荷のときに撮ったパッケージ裏面の写真 (2026-09-18 中原さん指示)。
      成分表示・原材料・内容量は実物を見ないと埋まらないので、ここに出して見ながら書けるようにする。
      現物が社内を通るのは入荷のときだけ = 撮り逃すと次の入荷まで取り返せない %>
  <% if (backLabelPhotos && backLabelPhotos.length) { %>
    <div class="card" style="margin-bottom:16px; background:#fff7ed; border-color:#fed7aa;">
      <h2>📷 パッケージ裏面の写真 <span class="muted" style="font-weight:400; font-size:12px;">(入荷のときに撮ったもの・<%= backLabelPhotos.length %>枚)</span></h2>
      <p class="muted" style="margin:0 0 8px; font-size:12px;">
        成分表示・原材料・内容量など<b>実物を見ないと埋まらない項目</b>はここから読み取ってください。
        クリックで拡大します。文字起こしは<a href="#tab-images" class="jump-tab" data-tab="tab-images">画像タブの「裏面情報」</a>へ。
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        <% backLabelPhotos.forEach(function (ph) { %>
          <a href="/apps/product-hub/drafts/<%= draft.id %>/back-label/<%= ph.id %>" target="_blank" rel="noopener"
             title="<%= ph.product_id %> ・ <%= String(ph.created_at || '').slice(0, 16).replace('T', ' ') %>"
             style="display:block; width:132px;">
            <img src="/apps/product-hub/drafts/<%= draft.id %>/back-label/<%= ph.id %>" alt="パッケージ裏面" loading="lazy"
                 style="width:132px; height:132px; object-fit:cover; border-radius:8px; border:1px solid #e2e8f0; background:#fff; display:block;">
            <div class="muted" style="font-size:11px; margin-top:2px;">
              <%= ph.product_id %><% if (ph.status !== 'uploaded') { %> <span title="まだ Drive へ送っていません">⏳</span><% } %>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; align-items:start;">
    <!-- 基本情報 -->
    <div class="card">
      <h2>✏️ 基本情報 <span class="muted" style="font-weight:400">(入力)</span></h2>
      <div class="field">
        <label>商品コード (NE / 楽天管理番号)<span class="ftag ftag-auto">自動</span></label>
        <%# 登録後の変更は影響範囲が広い (NE突合・楽天管理番号のキー) ので表示専用。クリックでコピー %>
        <button type="button" class="copy-code" data-code="<%= draft.ne_code %>"
                title="クリックでコピー"><%= draft.ne_code %><span class="copy-hint">📋 コピー</span></button>
      </div>
      <div class="field">
        <label class="req">商品名<span class="ftag ftag-auto">自動(初期値)</span><span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="f-name" value="<%= draft.name %>">
      </div>
      <div class="field">
        <label>公式ページURL <span class="muted">(AI生成の参照元。無ければ参考URL / Amazon URL でも可)</span><span class="ftag ftag-m">手入力</span></label>
        <input type="url" id="f-official-url" value="<%= draft.official_url || '' %>" placeholder="https://...">
      </div>
      <div class="field">
        <%# TOP画像の重要度 (どれぐらい力を入れて作るかの目安 — 2026-08-24 中原さん)。選ぶと即保存 %>
        <label>画像の重要度 <span class="muted">(TOP画像をどれぐらい力を入れて作るかの目安。選ぶと即保存)</span><span class="ftag ftag-m">手入力</span></label>
        <% const ipr = imagePriorities.find((p) => p.value === draft.image_priority) || null; %>
        <%# data-saved = 保存済みの値。簡易LPの定型文はこの値を入れる (選んでも読み直さないので画面で持つ — 2026-09-17)。
            保存中は data-saving=1、通信エラーで保存できたか分からないときは data-unknown=1 (定型文のコピーを止める) %>
        <select id="f-image-priority" data-saved="<%= draft.image_priority || '' %>"
                style="width:auto; min-width:280px; border-radius:6px; <%= ipr ? `background:${ipr.bg}; color:${ipr.fg}; font-weight:600;` : '' %>">
          <option value="">未設定</option>
          <% for (const p of imagePriorities) { %>
            <option value="<%= p.value %>" <%= draft.image_priority === p.value ? 'selected' : '' %>><%= p.value %></option>
          <% } %>
        </select>
        <span class="muted" id="image-priority-note" style="font-size:11px; margin-left:6px;"></span>
      </div>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label class="req">売価 (税込・円)<span class="ftag ftag-m">手入力</span></label>
          <input type="number" id="f-price" min="0" step="1" value="<%= draft.price != null ? draft.price : '' %>">
          <!-- 利益シミュレーション (Notion 数式の移植 2026-07-28):
               利益額 = 売価×0.9 − 原価×(1+税率/100) − 配送関係費(=NEが配送方法から自動算出した送料) -->
          <div id="profit-sim" style="margin-top:6px; font-size:12px;"
               data-cost="<%= neCost?.costExTax ?? '' %>"
               data-ship="<%= neCost?.shippingCost ?? '' %>"
               data-tax="<%= simTaxPercent %>"
               data-take="<%= profitTakeRate %>">
            <% const knownSkuCosts = (neCost?.skuCosts || []).map((s) => s.costExTax).filter((c) => c != null); %>
            <% if (neCost && neCost.costVaries) { %>
              <span class="ftag ftag-auto" style="margin-left:0">自動</span>
              <span class="muted">原価がSKUごとに異なります<% if (knownSkuCosts.length) { %> (税抜 <%= Math.min(...knownSkuCosts).toLocaleString() %>〜<%= Math.max(...knownSkuCosts).toLocaleString() %>円)<% } %>
                — 売価と利益は右の「NE商品マスタから自動取得」のSKU表でSKUごとに設定・確認してください</span>
            <% } else if (!neCost || neCost.costExTax == null) { %>
              <span class="muted">利益計算: NEに原価が無いため計算できません (NE登録後に自動反映)</span>
            <% } else if (neCost.shippingCost == null) { %>
              <span style="font-size:12px;">原価 <%= neCost.costExTax.toLocaleString() %>円<span class="muted"> (税抜・NE)</span></span>
              <span class="muted"> — 送料 (配送方法からの自動算出値) が無いため利益計算できません</span>
            <% } else { %>
              <span class="ftag ftag-auto" style="margin-left:0">自動</span>
              <span style="font-size:12px;">原価 <%= neCost.costExTax.toLocaleString() %>円<span class="muted"> (税抜・NE<%= neCost.source === 'members' ? '・全SKU共通' : '' %>)</span></span>
              <%# 利益額・利益率は大きく (2026-09-01 中原さん要望)。内訳は下に小さく添える %>
              <div class="profit-figs" id="profit-sim-figs" hidden>
                <div class="profit-fig"><span class="lbl">利益額</span><span class="val" id="profit-sim-amount">—</span></div>
                <div class="profit-fig"><span class="lbl">利益率</span><span class="val" id="profit-sim-margin">—</span></div>
              </div>
              <div id="profit-sim-body" class="muted" style="font-size:11px; margin-top:4px;"></div>
              <%# 配送方法を差し替えて試算する (2026-09-04 中原さん要望: 配送方法を変えても
                  金額が動かなかった)。楽天の配送方法グループは粒度が粗く送料が一意に決まらないので、
                  選択肢は NE の配送方法 (= 送料が決まる方) にする %>
              <div style="margin-top:6px;">
                <label style="font-size:11px; margin-bottom:2px;" class="muted">配送方法で試算</label>
                <select id="profit-ship-select" style="width:100%; font-size:12px;"
                        data-current="<%= neCost?.shippingMethod || '' %>"></select>
                <div id="profit-ship-note" class="muted" style="font-size:11px; margin-top:2px;"></div>
              </div>
              <script type="application/json" id="profit-ship-data"><%- JSON.stringify({ options: neShippingOptions || [], hints: rakutenGroupNeHints || {} }).replace(/</g, '\\u003c') %></script>
            <% } %>
          </div>
        </div>
        <div style="flex:1">
          <%# JAN (楽天のカタログID) の入力はカテゴリ・属性タブの「カタログID・商品仕様」表 (2026-09-03 中原さん:
              RMS と同じ SKU 列 × 項目行の表で、SKU ごとに IDあり/IDなし を選べるように)。
              ここは場所の案内だけ (初めて見た人が探せるように) %>
          <label>JANコード <span class="muted">(楽天の「カタログID」)</span></label>
          <div class="muted" style="font-size:12px; padding:6px 0;">
            <a href="#tab-category" class="jump-tab" data-tab="tab-category">カテゴリ・属性タブの「カタログID・商品仕様」の表</a>で<%= (variation.kind === 'variation' && variation.members.length > 1) ? 'SKUごとに' : '' %>入力します
          </div>
        </div>
        <div style="flex:1">
          <!-- 税率は基本情報 (2026-08-06 中原さん指示: Yahoo!欄から移動)。楽天・Yahoo!両方の登録で使う -->
          <label>税率 <span class="muted">(登録時にNEから初期値)</span><span class="ftag ftag-auto">自動(初期値)</span><span class="ftag ftag-m">手入力</span></label>
          <input type="text" id="y-tax" value="<%= yahoo ? (yahoo.tax_rate || '') : '' %>" placeholder="例: 10%">
        </div>
      </div>
      <!-- 配送・納期。売価とセットで見たい (利益に効く) ため基本情報タブに配置 (2026-07-29 中原さん要望)。
           保存は下の「基本情報を保存」で出品情報 (/rakuten) にも書き込まれる -->
      <div class="field" style="display:flex; gap:12px; flex-wrap:wrap; background:#f8fafc; border-radius:8px; padding:10px 12px;">
        <div style="flex:1; min-width:160px;">
          <label>配送方法 <span class="muted">(楽天の配送方法グループ)</span><span class="ftag ftag-m">手入力</span></label>
          <select id="rk-shipping-group" style="width:100%;">
            <%
              // 🚨 保存されている値だけを選択状態にする (2026-09-05)。
              // 以前は未設定のとき NE の値を**選択済み**にしていたが、そうすると
              // 配送方法に触れずジャンルだけ保存した人が「NE の値を選んだ」ことになってしまう
              // (画面の全項目を collectRakutenFields がまとめて送るため)。
              // 出品ゲートは「人が選んでいないと出品させない」ので、勝手に選ばせない (Codex high)
              const shipDefault = String(shippingSelectValue || '');
            %>
            <option value="" <%= shipDefault ? '' : 'selected' %>>— 選んでください</option>
            <% for (const [gid, gname] of Object.entries(shippingGroups)) { %>
              <option value="<%= gid %>" <%= shipDefault === gid ? 'selected' : '' %>><%= gname %></option>
            <% } %>
            <%# 選択肢から外した配送方法 (「現在使用不可」) が保存されている商品は、その行を足して
                選択状態を保つ。足さないと別の値が選ばれた状態で描かれ、保存し直した拍子に
                配送方法が変わってしまう (2026-09-04 / Codex R3) %>
            <% if (shipDefault && !shippingGroups[shipDefault] && allShippingGroups[shipDefault]) { %>
              <option value="<%= shipDefault %>" selected><%= allShippingGroups[shipDefault] %></option>
            <% } %>
            <%# 複合選択肢: 楽天=定形外のまま Yahoo! だけ別配送 (2026-08-06 中原さん指示) %>
            <% for (const [gid, ov] of Object.entries(yahooOverrideGroups)) { %>
              <option value="<%= gid %>" <%= shipDefault === gid ? 'selected' : '' %>><%= ov.label %></option>
            <% } %>
          </select>
          <%# 未選択のときの案内 (2026-09-05 中原さん判断: 単品は選んでいないと出品させない)。
              🚨 セットは**親からコピーしない代わりに NE の値をそのまま使う** (§4.4 決⑥) ので、
              選ばなくても出品できる。ここで単品と同じ「出品できません」を出すと嘘になる %>
          <% if (!rakuten?.shipping_method_group) { %>
            <% if (setInfo && neShipping.group) { %>
              <div class="muted" style="font-size:11px; margin-top:4px;">
                セットは NE の配送方法「<%= neCost?.shippingMethod %>」をそのまま使います（選ばなくても出品できます）。
                違うものにするならここで選んでください。
              </div>
            <% } else if (setInfo) { %>
              <div style="font-size:11px; margin-top:4px; color:#b45309;">
                配送方法が決まりません（このままでは出品できません）。NE に本コードが載るのを待つか、ここで選んでください。
              </div>
            <% } else if (neShipping.group) { %>
              <div style="font-size:11px; margin-top:4px;">
                <span style="color:#b45309;">未選択です（このままでは出品できません）。</span>
                NE は「<%= neCost?.shippingMethod %>」→
                <button type="button" class="btn btn-sm" id="rk-ship-use-ne"
                        data-group="<%= neShipping.group %>">これにする</button>
              </div>
            <% } else { %>
              <div style="font-size:11px; margin-top:4px; color:#b45309;">
                未選択です（このままでは出品できません）。NE にも配送方法が入っていないので、ここで選んでください。
              </div>
            <% } %>
          <% } %>
          <%# セットは配送方法をコピーしていない (§5.3)。個数で箱もサイズも変わるため。
              NE に本コードが載れば、単品と同じ「NEから自動選択」に乗る %>
          <% if (setInfo && !rakuten?.shipping_method_group && !neShipping.group) { %>
            <div style="font-size:11px; color:#b45309;">
              NE確定待ち — 親の配送方法は<%= setInfo.parent ? `「${setInfo.parent.name}」の` : '' %>ものですが、
              個数で箱もサイズも変わるためコピーしていません。ネクストエンジンに本コードが載ると自動で選ばれます
              （それまでは手で選んでも構いません）。
            </div>
          <% } %>
          <%# 2026-09-04: 利益の配送費を「配送方法で試算」から選べるようにしたので、
              「変えても計算は変わりません」ではなくなった (候補が上に集まる) %>
          <div class="muted" style="font-size:11px;">※ここは楽天へ送る配送方法です。利益計算の配送費は左の「配送方法で試算」で選びます (ここを変えると候補が上に集まります)</div>
        </div>
        <div style="flex:1; min-width:120px;">
          <label>送料<span class="ftag ftag-auto">自動</span></label>
          <!-- 外注マニュアル (楽天登録手順): 「弊社は全て送料無料です」→ 既定=送料込みで固定表示。
               送料別は誤操作防止のためリンク→confirm 経由でのみ選べる (中原さん指示 2026-08-01) -->
          <% const postageIsOther = rakuten?.postage_included === 0; %>
          <div id="rk-postage-fixed" style="<%= postageIsOther ? 'display:none;' : '' %>">
            <div style="padding:7px 10px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; font-size:13px;">送料込み <span class="muted">(全商品共通)</span></div>
            <a href="#" id="rk-postage-unlock" class="muted" style="font-size:11px;">送料別にする (特殊なケースのみ)</a>
          </div>
          <select id="rk-postage" style="width:100%; <%= postageIsOther ? '' : 'display:none;' %>">
            <option value="1" <%= postageIsOther ? '' : 'selected' %>>送料込み</option>
            <option value="0" <%= postageIsOther ? 'selected' : '' %>>送料別</option>
          </select>
        </div>
        <div style="flex:1; min-width:120px;">
          <label>納期情報 <span class="muted">(RMSの納期設定)</span><span class="ftag ftag-auto">自動</span></label>
          <!-- 外注マニュアル: 在庫あり時は「4: 12時までの注文で当日発送」固定 -->
          <%
            const DELIVERY_DEFAULT_ID = '4';
            const deliveryVal = String(rakuten?.normal_delivery_date_id || DELIVERY_DEFAULT_ID);
            const deliveryIsCustom = deliveryVal !== DELIVERY_DEFAULT_ID;
          %>
          <div id="rk-delivery-fixed" style="<%= deliveryIsCustom ? 'display:none;' : '' %>">
            <div style="padding:7px 10px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; font-size:13px;">12時までの注文で当日発送 <span class="muted">(ID: 4)</span></div>
            <a href="#" id="rk-delivery-unlock" class="muted" style="font-size:11px;">別の納期IDにする (特殊なケースのみ)</a>
          </div>
          <input type="text" id="rk-delivery-date" inputmode="numeric" value="<%= deliveryVal %>"
                 style="<%= deliveryIsCustom ? '' : 'display:none;' %>" placeholder="RMSの納期管理番号">
        </div>
      </div>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label>ASIN<span class="ftag ftag-m">手入力</span></label>
          <input type="text" id="f-asin" value="<%= draft.asin || '' %>" placeholder="B0XXXXXXXX">
          <div class="muted" id="f-asin-note" style="font-size:11px;" hidden>Amazon URLが入っているのでASINは不要です</div>
        </div>
        <div style="flex:2">
          <label>Amazon URL <span class="muted">(ASINを入れると自動で作られます)</span><span class="ftag ftag-m">手入力</span></label>
          <%# ASIN の取り違えを目で確かめるため、その場で商品ページを開けるようにする
              (2026-08-31 中原さん: 画像登録を依頼する前に ASIN が合っているか見に行く) %>
          <div style="display:flex; gap:6px;">
            <input type="url" id="f-amazon-url" value="<%= draft.amazon_url || '' %>" placeholder="https://www.amazon.co.jp/dp/..." style="flex:1;">
            <a class="btn" id="f-amazon-open" target="_blank" rel="noopener"
               style="white-space:nowrap; display:none;">🔗 開く</a>
          </div>
        </div>
      </div>
      <div class="field">
        <label><input type="checkbox" id="f-own-brand" style="width:auto" <%= draft.own_brand ? 'checked' : '' %>> 自社商品 (画像制作ワークフローを使う)</label>
      </div>
      <%# 既存の楽天ページへの追加か (2026-09-25 スタッフ要望)。選ぶと即保存。ボードのカードに「📄 既存ページ」の札が出る %>
      <div class="field">
        <label for="f-existing-page">楽天ページ</label>
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
          <%# 色追加のカードは既存ページのまま (サーバーも 400 で断る) %>
          <select id="f-existing-page" style="width:auto" data-saved="<%= existingPage.choice %>" <%= existingPage.addedTo ? 'disabled title="出品済みのページに色を足すカードなので変えられません"' : '' %>>
            <% for (const c of existingPageChoices) { %>
              <option value="<%= c.value %>" <%= existingPage.choice === c.value ? 'selected' : '' %>><%= c.label %></option>
            <% } %>
          </select>
          <span class="muted" id="existing-page-note" style="font-size:12px;"><%= existingPage.auto ? `自動判定: ${existingPage.existingPage ? '既存ページに追加' : '新規ページ'}` : '' %></span>
        </div>
        <% if (existingPage.addedTo) { %>
          <div style="font-size:13px; margin-top:4px;">📄 出品済みのページ
            <a href="/apps/product-hub/detail/<%= existingPage.addedTo.id %>"><%= existingPage.addedTo.ne_code || `#${existingPage.addedTo.id}` %></a>
            に NE で色 (SKU) が足されたので出したカードです。楽天のページは RMS で手で編集してください</div>
        <% } %>
        <div class="muted" style="font-size:12px;">既存ページに追加する商品 (カラバリ追加など) は、楽天のページ編集を目視・手作業で行います (このアプリからは楽天に出品しません)。自動判定 = NE の同じ代表商品コードに前からある商品があるか</div>
      </div>
      <!-- 画像フォルダURL は画像タブ「画像フォルダから自動セット」に一本化 (2026-08-06 中原さん指示: 二重入力欄の解消) -->
      <div class="field">
        <% if (hasVariation.source === 'ne') { %>
          <!-- NE にある商品は NE が正 (中原さん決定 2026-07-25)。手入力させず判定結果を出す -->
          <label>バリエーション<span class="ftag ftag-auto">自動</span></label>
          <div style="font-size:13px;">
            <%= hasVariation.value ? 'あり' : 'なし' %>
            <span class="muted">— NE商品マスタの判定<%= hasVariation.value ? ` (代表 ${variation.groupKey} / ${variation.memberCount} SKU)` : '' %></span>
          </div>
          <!-- NE 判定時は保存リクエストに含めない (サーバー側でも無視される) -->
        <% } else { %>
          <label><input type="checkbox" id="f-has-variation" style="width:auto" <%= draft.has_variation ? 'checked' : '' %>> バリエーションあり (サイズ・色違い)</label>
          <div class="muted">NEに無い商品のため手動指定です。NEに登録されると自動判定に切り替わります。</div>
        <% } %>
      </div>
      <div class="field">
        <label>メモ<span class="ftag ftag-m">手入力</span></label>
        <textarea id="f-memo" rows="3"><%= draft.memo || '' %></textarea>
      </div>
      <button class="btn btn-primary" id="save-basic-btn">基本情報を保存</button>
    </div>

    <div style="display:grid; gap:16px; align-content:start;"><!-- 右カラム: バリエーション+参考URL -->
    <!-- バリエーション (NE の代表商品コードで判定。NE が正・DBには焼かない) -->
    <div class="card" style="border-color:#bae6fd; background:#f8fdff;">
      <h2>🗄️ NE商品マスタから自動取得 <span class="muted" style="font-weight:400">(バリエーション判定)</span></h2>
      <p class="muted" style="margin-top:-6px">
        入力不要です。ネクストエンジンの代表商品コードから自動で判定しています。
        商品名・税率は<strong>登録時の初期値としてだけ</strong>NEから取り込み、以降はこのアプリの値が正です。
      </p>
      <% if (variation.kind === 'variation') { %>
        <div style="font-size:13px; margin-bottom:10px;">
          <strong>バリエーションあり</strong> — 代表商品コード
          <button type="button" class="copy-code" data-code="<%= variation.groupKey %>" title="クリックでコピー"><%= variation.groupKey %><span class="copy-hint">📋 コピー</span></button>
          に <strong><%= variation.memberCount %> SKU</strong> がぶら下がっています
          <span class="muted">(NE判定)</span>
        </div>
        <% if (variation.isChild) { %>
          <div class="banner-warn" style="margin:0 0 10px;">
            <div>
              ⚠️ このドラフトの商品コード <code><%= draft.ne_code %></code> は<strong>子SKU</strong>です。
              楽天は1ページ＝代表コード単位なので、<code><%= variation.groupKey %></code> にまとめることを推奨します。
              <% if (regroup) { %>
                <div class="muted" style="margin-top:4px;">まとめられません: <%= regroup %></div>
              <% } %>
            </div>
            <% if (!regroup) { %>
              <button class="btn btn-sm btn-primary" id="regroup-btn"
                      data-from="<%= draft.ne_code %>" data-to="<%= variation.groupKey %>"
                      style="white-space:nowrap">代表コードにまとめる</button>
            <% } %>
          </div>
        <% } %>
        <details open>
          <summary style="cursor:pointer; font-size:13px; font-weight:600;">このページに載るSKU (<%= variation.members.length %>件)</summary>
          <%
            // NE原価をSKU別に表示 (2026-08-24 中原さん要望)。原価がSKUで異なる場合は売価もSKU別に設定する
            const skuCostBy = {};
            for (const s of (neCost?.skuCosts || [])) skuCostBy[String(s.code).trim().toLowerCase()] = s;
            const showSkuPrices = !!(neCost && neCost.costVaries);
          %>
          <% if (showSkuPrices) { %>
            <p class="muted" style="margin:8px 0 0; font-size:12px;">
              💰 原価がSKUごとに異なります。<strong>売価もSKUごとに設定</strong>してください (空欄 = ページ代表の売価 <%= draft.price != null ? draft.price.toLocaleString() + '円' : '未設定' %> を使う。入力すると即保存)。
            </p>
          <% } %>
          <p class="muted" style="margin:8px 0 0; font-size:12px;">
            🏷 <strong>選択肢はSKUごと</strong>に入力してください (入力すると即保存。空欄にすると解除)。
            カタログID (JAN) と商品仕様は <a href="#tab-category" class="jump-tab" data-tab="tab-category">カテゴリ・属性タブの表</a> で SKU ごとに入力します。
          </p>
          <table class="list" style="margin-top:8px;">
            <thead><tr>
              <th style="width:170px">商品コード</th><th>商品名</th><th style="width:80px">取扱区分</th><th style="width:50px">在庫</th>
              <th style="width:80px">原価<span class="muted" style="font-weight:400">(税抜)</span></th>
              <%# SKU別JAN (2026-08-28 中原さん要望)。バリエーションありのときはページ代表のJAN1つでは足りない %>
              <%# 選択肢 (2026-09-02 カラバリ出品)。楽天は variants[sku].selectorValues が必須で、
                  NE 側に軸の情報が無いのでここで手入力する。列名は RMS の「バリエーション」の用語に合わせる %>
              <th style="width:130px">選択肢<br><span class="muted" style="font-weight:400; font-size:11px;">項目: <%= rakuten?.variant_selector_name || '未設定 (カテゴリ・属性タブ)' %></span></th>
              <% if (showSkuPrices) { %><th style="width:100px">売価<span class="muted" style="font-weight:400">(税込)</span></th><th style="width:110px">利益</th><% } %>
              <th style="width:70px"></th>
            </tr></thead>
            <tbody>
              <% for (const [mi, m] of variation.members.entries()) { %>
                <% const isSelf = String(m.商品コード || '').trim().toLowerCase() === String(draft.ne_code || '').trim().toLowerCase(); %>
                <% const mKey = String(m.商品コード || '').trim().toLowerCase(); %>
                <% const mCost = skuCostBy[mKey] || null; %>
                <tr<%= isSelf ? ' style="background:#eff6ff"' : '' %>>
                  <td><code style="font-size:12px"><%= m.商品コード %></code></td>
                  <td><%= m.商品名 || '' %></td>
                  <td class="muted"><%= m.取扱区分 || '' %></td>
                  <td class="muted"><%= m.在庫数 != null ? m.在庫数 : '' %></td>
                  <td style="text-align:right;<%= mCost?.costExTax == null ? '' : 'font-variant-numeric:tabular-nums;' %>">
                    <% if (mCost?.costExTax != null) { %><%= mCost.costExTax.toLocaleString() %>円<% } else { %><span class="muted" title="NEに原価がありません">—</span><% } %>
                  </td>
                  <td>
                    <input type="text" class="sku-selector-input" maxlength="100"
                           style="width:120px; font-size:12px; padding:4px 6px;"
                           data-code="<%= m.商品コード %>"
                           value="<%= skuSelectorValues[mKey] || '' %>" placeholder="例: ブラウン">
                  </td>
                  <% if (showSkuPrices) { %>
                    <td>
                      <input type="number" class="sku-price-input" min="1" step="1"
                             style="width:90px; font-size:12px; padding:4px 6px;"
                             data-code="<%= m.商品コード %>" data-key="<%= mi %>"
                             data-cost="<%= mCost?.costExTax ?? '' %>"
                             data-ship="<%= (mCost?.shippingCost ?? neCost?.shippingCost) ?? '' %>"
                             value="<%= skuPrices[mKey] != null ? skuPrices[mKey] : '' %>"
                             placeholder="<%= draft.price != null ? draft.price : '' %>">
                    </td>
                    <%# 利益は読み飛ばされないよう表の中でも一段大きく (2026-09-01 中原さん要望) %>
                    <td class="sku-profit" id="sku-profit-<%= mi %>">—</td>
                  <% } %>
                  <td>
                    <% if (!isSelf) { %>
                      <button class="btn btn-sm exclude-sku-btn" data-code="<%= m.商品コード %>">外す</button>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </details>
        <% if (variation.excludedMembers.length > 0) { %>
          <details style="margin-top:10px;">
            <summary style="cursor:pointer; font-size:13px; font-weight:600; color:#b45309;">
              このページから外したSKU (<%= variation.excludedMembers.length %>件)
            </summary>
            <p class="muted" style="margin:8px 0 0;">
              外したSKUは楽天のこのページに載りません。別ページにする場合は、そのコードで新規登録してください
              （まとめ直されずに単独のドラフトになります）。
            </p>
            <table class="list" style="margin-top:8px;">
              <tbody>
                <% for (const m of variation.excludedMembers) { %>
                  <tr>
                    <td style="width:190px"><code style="font-size:12px"><%= m.商品コード %></code></td>
                    <td class="muted"><%= m.商品名 || '' %></td>
                    <td style="width:150px; font-size:12px;">
                      <% if (m.ownDraftId) { %>
                        <a href="/apps/product-hub/detail/<%= m.ownDraftId %>">単独ページ #<%= m.ownDraftId %></a>
                      <% } else { %>
                        <span style="color:#b45309" title="このSKUはどの楽天ページにも載りません">未割当</span>
                      <% } %>
                    </td>
                    <td style="width:70px"><button class="btn btn-sm restore-sku-btn" data-code="<%= m.商品コード %>">戻す</button></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </details>
        <% } %>
      <% } else if (variation.kind === 'detached') { %>
        <p class="muted" style="margin:0;">
          このSKUは他ページのバリエーションから外され、<strong>単独のページ</strong>として扱われています。
        </p>
      <% } else if (variation.kind === 'single') { %>
        <p class="muted" style="margin:0;">単品です（NEに代表商品コードの登録なし）。</p>
      <% } else if (variation.kind === 'conflict') { %>
        <div class="banner-warn" style="margin:0;">
          ⚠️ NE商品マスタに商品コード <code><%= draft.ne_code %></code> が
          <strong><%= variation.memberCount %>件</strong>あります（大文字小文字・空白違いの重複）。
          どちらのグループか判定できないため、NE側の重複を解消してください。
        </div>
      <% } else { %>
        <p class="muted" style="margin:0;">
          商品コード <code><%= draft.ne_code %></code> はNE商品マスタに見つかりませんでした（未登録の新商品など）。
          判定できないため、「バリエーションあり」チェックが手動の値として使われます。
        </p>
      <% } %>
    </div>

    <!-- 参考URL (2026-08-01 中原さん指示: 商品説明タブ→基本情報タブへ移動) -->
    <div class="card">
      <h2>✏️ 参考URL <span class="muted" style="font-weight:400">(公式ページ以外の参照元)</span><span class="ftag ftag-m">手入力</span></h2>
      <% if (refs.length === 0) { %>
        <p class="muted">まだありません。メーカーの商品ページや類似商品ページなど、AI が説明文を書くときに参考にする URL を追加してください。</p>
      <% } %>
      <ul style="list-style:none; margin:0 0 12px; padding:0;">
        <% for (const r of refs) { %>
          <li style="display:flex; gap:8px; align-items:center; padding:4px 0; font-size:13px;">
            <a href="<%= r.url %>" target="_blank" rel="noopener" style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= r.url %></a>
            <button class="btn btn-sm btn-danger del-ref-btn" data-id="<%= r.id %>">削除</button>
          </li>
        <% } %>
      </ul>
      <%# 2026-08-28 中原さん要望: 入力したら反映する (URL を貼って他の欄へ移る / Enter で確定)。
          「追加」ボタンは押す必要が無くなったので置かない %>
      <input type="url" id="new-ref-url" placeholder="https://... (貼って Enter、または他の欄へ移ると追加)">
      <div class="muted" id="add-ref-msg" style="font-size:11px; margin-top:4px;">
        URL を貼って Enter を押すか、他の欄へ移ると自動で追加されます。
      </div>
    </div>
    </div><!-- /右カラム -->
  </div>
  <!-- Yahoo!向け追記項目 -->
  <div class="card">
    <h2>✏️ Yahoo!向け追記項目 <span class="muted" style="font-weight:400">(入力・楽天→Yahoo移行で使用)</span></h2>
    <div class="grid-2">
    <div class="field" style="display:flex; gap:12px;">
      <div style="flex:1">
        <label>Yahoo!売価 (税込・円)<span class="ftag ftag-m">手入力</span></label>
        <input type="number" id="y-price" min="0" step="1" value="<%= yahoo && yahoo.yahoo_price != null ? yahoo.yahoo_price : '' %>">
      </div>
      <div style="flex:1">
        <label>Yahoo!売価 (佐川の場合)<span class="ftag ftag-m">手入力</span></label>
        <input type="number" id="y-price-sagawa" min="0" step="1" value="<%= yahoo && yahoo.yahoo_price_sagawa != null ? yahoo.yahoo_price_sagawa : '' %>">
      </div>
    </div>
    <div class="field" style="display:flex; gap:12px;">
      <div style="flex:1">
        <%# Yahoo!の配送方法はプルダウン (選択肢=楽天の配送方法グループと同じ)。
            Yahoo!売価とともに、基本情報の配送方法で「定形外（ヤフーのみ…）」を選んだときだけ入力可 (2026-08-06 中原さん指示) %>
        <label>配送方法<span class="ftag ftag-m">手入力</span></label>
        <select id="y-delivery" style="width:100%;">
          <option value="">未設定</option>
          <% for (const gname of Object.values(shippingGroups)) { %>
            <option value="<%= gname %>" <%= (yahoo?.delivery_label || '') === gname ? 'selected' : '' %>><%= gname %></option>
          <% } %>
          <% if (yahoo?.delivery_label && !Object.values(shippingGroups).includes(yahoo.delivery_label)) { %>
            <option value="<%= yahoo.delivery_label %>" selected><%= yahoo.delivery_label %> (旧値)</option>
          <% } %>
        </select>
        <div class="muted" id="y-gate-hint" style="font-size:11px;"></div>
      </div>
    </div>
    <div class="field" style="display:flex; gap:12px;">
      <div style="flex:1">
        <label>Yahoo!カテゴリID<span class="ftag ftag-m">手入力</span></label>
        <input type="number" id="y-category-id" value="<%= yahoo && yahoo.yahoo_category_id != null ? yahoo.yahoo_category_id : '' %>">
      </div>
      <div style="flex:2">
        <label>Yahoo!path (店カテゴリ)<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="y-path" value="<%= yahoo ? (yahoo.yahoo_path || '') : '' %>">
      </div>
    </div>
    </div>
    <button class="btn btn-primary" id="save-yahoo-btn">Yahoo!項目を保存</button>
  </div>
  </div><!-- /tab-basic -->


  <!-- ═══ タブ2: 画像 ═══ -->
  <div class="tab-panel" id="tab-images">
  <%# セットの画像は「作る/作らない」ではなく、**親の何枚目をどうするか**を枠ごとに決める
      (2026-09-04 §4.7 中原さん: 「単品の詳細画像で何枚目を修正、みたいな形で指示を送れるように」)。
      全部「そのまま使う」なら制作は要らないので、画像の工程は自動で「対象外」になる %>
  <% if (setInfo && setImagePlans.length) { %>
    <div class="card" style="margin-bottom:16px; background:#faf5ff; border-color:#ddd6fe;">
      <h2>🎁 親の画像をどう使うか<span class="muted" style="font-weight:400; font-size:12px;">（枠ごとに決める）</span></h2>
      <p class="muted" style="margin:0 0 8px; font-size:12px;">
        「そのまま使う」枠は親の画像がここにコピーされています。1つでも「直して使う／作り直す」にすると、
        画像の制作工程が動き出し、依頼にこの指示がそのまま載ります。
      </p>
      <table class="list" id="set-image-plan">
        <thead><tr><th style="width:110px;">枠</th><th style="width:70px;">親の画像</th>
          <th style="width:150px;">どうする</th><th>どう直すか（指示）</th></tr></thead>
        <tbody>
          <% for (const pl of setImagePlans) { %>
            <tr data-slot="<%= pl.slot %>">
              <td><%= pl.label %></td>
              <td>
                <% if (pl.parent_drive_file_id) { %>
                  <a href="<%= fileViewUrl(pl.parent_drive_file_id) %>" target="_blank" rel="noopener">
                    <img src="<%= thumbnailUrl(pl.parent_drive_file_id, 160) %>" alt="<%= pl.label %>"
                         style="width:56px; height:56px; object-fit:contain; background:#fff; border:1px solid #e2e8f0; border-radius:4px;">
                  </a>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td>
                <select class="sip-action" style="width:100%;">
                  <% for (const a of setImageActions) { %>
                    <option value="<%= a %>" <%= pl.action === a ? 'selected' : '' %>><%= setImageActionLabels[a] %></option>
                  <% } %>
                </select>
              </td>
              <td>
                <input type="text" class="sip-instruction" style="width:100%;" maxlength="500"
                       value="<%= pl.instruction || '' %>"
                       placeholder="例: 2個並べた写真に / ×2 の表記を足す">
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <div style="display:flex; gap:8px; align-items:center; margin-top:10px;">
        <button class="btn btn-primary btn-sm" id="sip-save">この計画で保存</button>
        <span class="muted" id="sip-result"></span>
      </div>
    </div>
  <% } %>
  <%# 制作の依頼に載る指示 (§4.7)。依頼を受ける人がここだけ見れば何を作るか分かるようにする %>
  <% if (setInfo && setImageInstructions.length) { %>
    <div class="card" style="margin-bottom:16px; background:#fffbeb; border-color:#fcd34d;">
      <h2>🎨 この画像を作ってください<span class="muted" style="font-weight:400; font-size:12px;">（制作の依頼に載る内容）</span></h2>
      <ul style="margin:0; padding-left:18px; font-size:13px;">
        <% for (const ins of setImageInstructions) { %>
          <li><strong><%= ins.label %></strong>: <%= ins.actionLabel %><%= ins.instruction ? ` — ${ins.instruction}` : '' %></li>
        <% } %>
      </ul>
    </div>
  <% } %>
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; align-items:start;">
  <div class="card">
    <h2>✏️ 商品画像 (Driveリンク)<span class="ftag ftag-m">手入力</span></h2>

    <!-- フォルダ一括取り込み (2026-08-01): 「商品コード_番号」規則でスロットへ自動セット -->
    <div class="field" style="margin-bottom:14px;">
      <label>画像フォルダから自動セット</label>
      <div style="display:flex; gap:8px;">
        <input type="url" id="import-folder-url" style="flex:1;" value="<%= draft.drive_folder_url || '' %>"
               placeholder="https://drive.google.com/drive/folders/... (画像フォルダのリンク)">
        <%# 入っているリンクをそのまま開けるように (2026-08-31 中原さん要望)。
            空のときは押しても行き先が無いのでボタンごと隠す %>
        <a class="btn" id="import-folder-open" target="_blank" rel="noopener"
           style="white-space:nowrap; display:none;">📂 開く</a>
        <button class="btn btn-primary" id="import-folder-btn" style="white-space:nowrap">フォルダから自動セット</button>
      </div>
      <div class="muted" style="font-size:11px;">
        ファイル名「<%= draft.ne_code %><b>_top</b>」= <b>商品画像1 (楽天のTOP画像/サムネイル)</b> /
        「<%= draft.ne_code %>_01」〜「_19」= 商品画像2〜20 (<b>_top が1枠目なので1つずれます</b>) /
        「<%= draft.ne_code %>_00」= 白抜き背景 (仕入先から届いた画像は下の「📥 受信箱から選ぶ」でも登録できます)。欠番は前に詰めて登録されます。
        _top・_01〜 が1枚でも見つかると、現在の商品画像は<b>フォルダの内容で置き換わります</b> (_00 だけの場合は白抜きのみ更新)。
        <b>Driveで画像を差し替えたときも、このボタンを押すとサムネイルが最新になります</b>
      </div>
    </div>

    <%
      const whiteBgTransferred = rakuten?.white_bg_drive_file_id
        && cabinetImages.some((c) => c.drive_file_id === rakuten.white_bg_drive_file_id);
      const transferredIds = new Set(cabinetImages.map((c) => c.drive_file_id));
      // 枠は sort (= 取り込み時のスロット番号-1) で引く。_top が無い商品は枠1が空のまま
      // 表示され、「TOP画像が未設定」がひと目で分かる (2026-08-08 スタッフ指摘)
      const imagesBySlot = new Map(images.map((im) => [Number(im.sort) + 1, im]));
      const slotCount = Math.max(20, ...images.map((im) => Number(im.sort) + 1));
    %>
    <% if (images.length > 0 && !imagesBySlot.has(1)) { %>
      <div class="banner-warn" style="margin:0 0 10px; font-size:12px;">
        ⚠️ <b>TOP画像 (<%= draft.ne_code %>_top) がありません。</b>
        枠1が空のため、楽天へは枠2以降が前に詰めて登録されます (_01 の画像がTOP画像になります)。
        フォルダに <code><%= draft.ne_code %>_top.jpg</code> を置いて「フォルダから自動セット」を押してください
      </div>
    <% } %>
    <!-- スロットグリッド: 白抜き (00) + 楽天の登録口20個 (枠1 = _top) -->
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(104px, 1fr)); gap:10px;">
      <div style="text-align:center;">
        <div style="font-size:11px; color:#64748b; margin-bottom:2px;">00 白抜き</div>
        <% if (rakuten?.white_bg_drive_file_id) { %>
          <a href="<%= fileViewUrl(rakuten.white_bg_drive_file_id) %>" target="_blank" rel="noopener">
            <img src="<%= thumbnailUrl(rakuten.white_bg_drive_file_id, 320, rakuten.white_bg_modified_time) %>" alt="" loading="lazy" referrerpolicy="no-referrer"
                 style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:8px; border:2px solid #c7d2fe; background:#f8fafc;">
          </a>
          <div style="font-size:11px;"><%= whiteBgTransferred ? '✅ 転送済み' : '⏳ 未転送' %></div>
        <% } else { %>
          <div style="width:100%; aspect-ratio:1; border:2px dashed #cbd5e1; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:11px;">未設定</div>
        <% } %>
        <%# 受信箱から選ぶ (2026-09-14 中原さん要望): 仕入先 (0001) からメールで届いた白抜き画像を
            1 枚選んで「商品コード_00」に登録し、商品の画像フォルダへ移動する (受信箱から消える)。
            JS へ渡す値は data 属性 (JS の値の位置に出力タグを置かない) %>
        <button type="button" class="btn btn-sm" id="wb-inbox-btn" style="margin-top:4px; white-space:nowrap;"
                data-code="<%= draft.ne_code %>" data-has-white-bg="<%= rakuten?.white_bg_drive_file_id ? '1' : '' %>"
                title="仕入先から届いた白抜き画像を受信箱から選んで登録します">📥 受信箱から選ぶ</button>
      </div>
      <%# 上限は自動追加バナー込みで判定 (出品時に初めて弾かれないよう、超過をこの場で見せる)。
          白抜きと同じファイルのスロットは payload で除外されるため商品画像として数えない (Codex R2) %>
      <% let productImgCount = 0; %>
      <% for (let i = 0; i < slotCount; i++) { const img = imagesBySlot.get(i + 1);
           const isWhiteBgDup = !!img && !!rakuten?.white_bg_drive_file_id && img.drive_file_id === rakuten.white_bg_drive_file_id;
           if (img && !isWhiteBgDup) productImgCount++;
           const over = !!img && !isWhiteBgDup && productImgCount > 20 - trailingBanners.length; %>
        <div style="text-align:center;">
          <%# ファイル名は取り込み時に記録した source_label があるときだけ出す。
              旧データ (NULL) は枠との対応が新仕様と違うため断定しない (Codex medium) %>
          <div style="font-size:11px; color:<%= over ? '#dc2626' : '#64748b' %>; margin-bottom:2px;"><%= i + 1 %><%= i === 0 ? ' TOP' : '' %>
            <% if (img && img.source_label) { %><span class="muted">(<%= img.source_label %>)</span><% } %><%= over ? ' ⚠上限超え' : '' %></div>
          <% if (img) { %>
            <a href="<%= img.view_url %>" target="_blank" rel="noopener">
              <img src="<%= img.thumb %>" alt="" loading="lazy" referrerpolicy="no-referrer"
                   style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:8px; border:1px solid <%= over ? '#fca5a5' : '#e2e8f0' %>; background:#f8fafc;">
            </a>
            <div style="font-size:11px; display:flex; gap:4px; align-items:center; justify-content:center;">
              <span><%= transferredIds.has(img.drive_file_id) ? '✅' : '⏳' %></span>
              <button class="btn btn-sm btn-danger del-image-btn" data-id="<%= img.id %>">削除</button>
            </div>
          <% } else { %>
            <div style="width:100%; aspect-ratio:1; border:2px dashed #e2e8f0; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#cbd5e1; font-size:16px;">＋</div>
          <% } %>
        </div>
      <% } %>
    </div>
    <p class="muted" style="font-size:11px; margin-top:8px;">※ サムネイルはアプリ経由で表示されます (ブラウザ側の Google ログインは不要)。✅ = R-Cabinet転送済み / ⏳ = 未転送</p>
    <%# 受信箱の選択画面 (2026-09-14)。開閉は class で行う (hidden 属性は inline の display に負けるので使わない) %>
    <style>
      .wb-modal { display:none; position:fixed; inset:0; background:rgba(15,23,42,.55); z-index:1000; align-items:center; justify-content:center; padding:16px; }
      .wb-modal.open { display:flex; }
      .wb-modal-box { background:#fff; border-radius:12px; width:min(960px, 100%); max-height:90vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,.3); }
      .wb-modal-head { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; padding:14px 16px 10px; border-bottom:1px solid #e2e8f0; }
      .wb-modal-body { padding:10px 16px 16px; overflow:auto; }
      .wb-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:10px; margin-top:8px; }
      .wb-item { text-align:left; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:6px; cursor:pointer; font:inherit; color:inherit; }
      .wb-item:hover { border-color:#2563eb; background:#eff6ff; }
      .wb-item:disabled { opacity:.5; cursor:wait; }
      .wb-item img { width:100%; aspect-ratio:1; object-fit:contain; background:#fff; border-radius:6px; display:block; }
      .wb-item .wb-name { font-size:12px; margin-top:4px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .wb-item .wb-reg { font-size:11px; color:#b45309; }
    </style>
    <div class="wb-modal" id="wb-inbox-modal" role="dialog" aria-modal="true" aria-labelledby="wb-inbox-title">
      <div class="wb-modal-box">
        <div class="wb-modal-head">
          <div>
            <div id="wb-inbox-title" style="font-weight:600;">📥 受信箱の白抜き画像</div>
            <div class="muted">仕入先からメールで届いた画像です。1枚選ぶと「<%= draft.ne_code %>_00」として登録し、商品の画像フォルダへ移動します (受信箱からは消えます)</div>
          </div>
          <div style="display:flex; gap:6px; align-items:center; flex-shrink:0;">
            <a class="btn btn-sm" href="<%= locals.whiteBgInboxUrl || '#' %>" target="_blank" rel="noopener">📂 受信箱を開く</a>
            <button type="button" class="btn btn-sm" id="wb-inbox-reload" title="一覧を読み直す">🔄</button>
            <button type="button" class="btn btn-sm" id="wb-inbox-close">✕ 閉じる</button>
          </div>
        </div>
        <div class="wb-modal-body">
          <input type="search" id="wb-inbox-filter" placeholder="ファイル名・メール件名で絞り込み" style="width:100%;">
          <div id="wb-inbox-status" class="muted" style="margin-top:6px;"></div>
          <div id="wb-inbox-grid" class="wb-grid"></div>
        </div>
      </div>
    </div>

    <!-- 1枚ずつの追加 (差し替え・追加用。末尾のスロットに入る) -->
    <div style="display:flex; gap:8px; margin-top:10px;">
      <input type="url" id="new-image-url" placeholder="https://drive.google.com/file/d/... (画像ファイルのリンクを1枚ずつ追加)">
      <button class="btn" id="add-image-btn" style="white-space:nowrap">追加</button>
    </div>

    <!-- 出品時に自動追加される店舗共通バナー (R-Cabinet 既存画像。転送・取込は不要) -->
    <div class="field" style="margin-top:14px;">
      <label>出品時に末尾へ自動追加されるバナー <span class="ftag ftag-auto">自動</span></label>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <% for (const b of trailingBanners) { %>
          <div style="text-align:center; width:110px;">
            <img src="<%= b.url %>" alt="" loading="lazy" referrerpolicy="no-referrer"
                 style="width:100%; aspect-ratio:1; object-fit:contain; border-radius:8px; border:1px solid #e2e8f0; background:#f8fafc;">
            <div class="muted" style="font-size:11px;"><%= b.label %></div>
          </div>
        <% } %>
      </div>
      <div class="muted" style="font-size:11px; margin-top:4px;">
        配送方法 (定形外 / ネコポス / ゆうパケットパフ) に応じたバナー + 共通3枚が楽天登録時に商品画像の後ろへ自動で付きます。
        商品画像は自動追加分と合わせて20枚までです (商品画像は実質<%= 20 - trailingBanners.length %>枚まで)
      </div>
    </div>

    <%# SKU画像 (2026-08-07 中原さん指示): バリエーション商品のみ。フォルダに「SKUコード」名で
        保存された画像を取り込み → R-Cabinet転送 → 楽天ページの variants[sku].images へ PATCH %>
    <% if (variation.kind === 'variation' && variation.members.length > 0) { %>
      <% const skuImgBySku = new Map(skuImages.map((r) => [r.sku_code, r])); %>
      <div class="field" style="margin-top:16px; border-top:1px dashed #e2e8f0; padding-top:12px;">
        <label>SKU画像 <span class="muted">(SKU選択時に切り替わる画像。楽天ページ登録後に紐づけ)</span></label>
        <div class="muted" style="font-size:11px; margin-bottom:6px;">
          画像フォルダに <b>SKUコード名</b> (例: <code><%= String(variation.members[0]?.商品コード || 'sku-code').toLowerCase() %>.jpg</code>) で保存 →
          取り込み・転送は商品画像と一緒に実行 → 最後に「紐づける」。紐づけは楽天ページの SKU画像だけを書き換えます (価格・選択肢など他の項目は触りません)
        </div>
        <table class="list" style="font-size:12px;">
          <thead><tr><th>SKU</th><th>商品名 (NE)</th><th style="width:64px;">画像</th><th>状態</th></tr></thead>
          <tbody>
            <% for (const m of variation.members) { %>
              <% const sku = String(m.商品コード || '').trim().toLowerCase(); const r = skuImgBySku.get(sku); %>
              <tr>
                <td><code><%= sku %></code></td>
                <td class="muted" style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= m.商品名 || '' %></td>
                <td><% if (r) { %><img src="<%= thumbnailUrl(r.drive_file_id, 160, r.drive_modified_time) %>" alt="" loading="lazy"
                       style="width:56px; height:56px; object-fit:contain; border:1px solid #e2e8f0; border-radius:6px; background:#fff;"><% } else { %><span class="muted">—</span><% } %></td>
                <td>
                  <% if (!r) { %><span class="muted">未取込 (フォルダに <%= sku %>.jpg 等を置いて「フォルダから自動セット」)</span>
                  <% } else if (r.synced_at) { %><span style="color:#166534;">🔗 楽天へ反映済み (<%= r.synced_at.replace('T',' ').slice(0,16) %>)</span>
                  <% } else if (r.cabinet_location) { %><span style="color:#166534;">✅ 転送済み</span> <span class="muted">(未紐づけ)</span>
                  <% } else { %><span style="color:#b45309;">⏳ 未転送</span><% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <div style="display:flex; gap:8px; align-items:center; margin-top:8px; flex-wrap:wrap;">
          <button class="btn btn-primary btn-sm" id="sku-img-sync-btn">楽天のSKUに紐づける</button>
          <span class="muted" style="font-size:11px;">取り込み・転送は上の「フォルダから自動セット」「画像をR-Cabinetへ転送」で SKU画像も一緒に処理されます</span>
          <span class="muted" id="sku-img-result" style="font-size:12px;"></span>
        </div>
      </div>
    <% } %>

    <div class="field" style="margin-top:14px;">
      <label>白抜き背景画像 <span class="muted">(検索サムネ用 whiteBgImage。Driveのファイルリンク)</span><span class="ftag ftag-m">手入力</span></label>
      <div style="display:flex; gap:8px; align-items:center;">
        <input type="text" id="rk-whitebg" style="flex:1;" value="<%= rakuten?.white_bg_drive_url || '' %>" placeholder="https://drive.google.com/file/d/...">
        <% if (rakuten?.white_bg_drive_file_id) { %>
          <span class="muted" style="font-size:12px; white-space:nowrap;"><%= whiteBgTransferred ? '✅ 転送済み' : '⏳ 未転送 (「画像を転送」で送る)' %></span>
        <% } %>
      </div>
      <div class="muted" style="font-size:11px;">保存は上部の「出品情報を保存 (全タブ分)」か「基本情報を保存」で行われます</div>
    </div>
    <div style="display:flex; gap:8px; align-items:center; margin-top:10px; flex-wrap:wrap;">
      <!-- 件数は drive_file_id 突合 (Codex R2: 履歴件数だと画像差し替え後や白抜き分でズレる) -->
      <button class="btn" id="rk-images-btn">画像をR-Cabinetへ転送 (<%= transferredImageCount %>/<%= images.length %> 済)</button>
      <span class="muted" id="rk-images-result"></span>
    </div>
  </div>

    <!-- 画像制作 (全商品) -->
    <div class="card">
      <h2>画像制作</h2>
      <%# 対象商品は 自社商品 → 取扱先限定商品 (2026-08-31) → 全商品 (2026-09-13 スタッフ要望: 仕入れ低の商品も
          簡易LPを作る) と広げてきた。サーバ (image-production / image-hold API) も重要度では弾かない %>
        <% const ip = imageProduction || {}; %>
        <%# 画像制作だけの保留 (2026-08-26 中原さん決定)。商品の本流は止めず、画像トラックと楽天出品ゲートだけ閉じる %>
        <div class="field" style="padding:8px 10px; border-radius:8px; background:<%= ip.workflow_state === 'on_hold' ? '#fef3c7' : '#f8fafc' %>; border:1px solid <%= ip.workflow_state === 'on_hold' ? '#f59e0b' : '#e2e8f0' %>;">
          <% if (ip.workflow_state === 'on_hold') { %>
            <strong>⏸ 画像制作は保留中</strong><% if (ip.hold_note) { %> <span class="muted">(<%= ip.hold_note %>)</span><% } %>
            <span class="muted"> — 商品の工程は進みますが、画像トラックと楽天出品は止まります</span>
            <button class="btn" id="image-hold-btn" data-on-hold="0" style="margin-left:8px;">保留を解除</button>
          <% } else { %>
            <span class="muted">画像制作だけを保留にできます (商品の工程は止まりません)</span>
            <input type="text" id="image-hold-note" placeholder="理由 (任意)" style="width:220px; margin-left:8px;">
            <button class="btn" id="image-hold-btn" data-on-hold="1">画像制作を保留</button>
          <% } %>
        </div>
        <%# 画像工程 v2 (2026-08-26): 1.5 商品情報 (手入力) と ChatGPT 用の定型文ボタン %>
        <div class="field" style="padding:8px 10px; border-radius:8px; background:#f0f9ff; border:1px solid #bae6fd;">
          <label>商品情報 <span class="muted" style="font-weight:400">(商品説明タブの説明文から自動で入ります。直して保存するとそちらが優先。下の定型文の材料)</span></label>
          <%# 2026-09-13 スタッフ要望: 説明文とカラバリをコピペしていたので自動で出す (lib/product-info-auto.js)。
              手入力が保存されていればそれ、無ければ自動。data-auto=1 の間は触らずに保存しても手入力として
              残さない (自動のまま = 商品説明タブを直せば追随する) %>
          <% const manualInfo = String(ip.product_info_text || '').trim() !== ''; %>
          <textarea id="ip-product-info" rows="8" data-auto="<%= manualInfo ? '0' : '1' %>" placeholder="商品説明タブの説明文がまだ無いときは、商品の特徴・用途・サイズ・内容量・素材などを書く"><%= manualInfo ? ip.product_info_text : autoProductInfo %></textarea>
          <div class="muted" style="font-size:11px;">
            <% if (manualInfo) { %>
              手入力<% if (ip.product_info_updated_at) { %> (最終更新: <%= String(ip.product_info_updated_at).slice(0, 16).replace('T', ' ') %> <%= ip.product_info_updated_by || '' %>)<% } %>
              <button type="button" class="btn btn-sm" id="ip-info-auto-btn" style="margin-left:6px;">自動に戻す</button>
            <% } else if (autoProductInfo) { %>
              自動 (商品説明タブの説明文)。直して「画像制作情報を保存」すると手入力として残ります
            <% } else { %>
              商品説明タブの説明文がまだありません (工程「基本情報入力」を完了にすると AI が書きます)。手で入れても構いません
            <% } %>
          </div>
          <label style="margin-top:10px;">カラバリ <span class="muted" style="font-weight:400">(基本情報タブの SKU から自動。定型文にも入ります)</span></label>
          <pre id="ip-color-variations" style="margin:0; padding:6px 8px; background:#fff; border:1px solid #e2e8f0; border-radius:6px; font-size:12px; white-space:pre-wrap;"><%= colorVariationsText %></pre>
          <%# 裏面情報 (2026-09-10 スタッフ要望)。パッケージ裏面を撮って AI に文字起こしさせた文章の置き場。
              **任意** (裏面表記が要らない商品もある) なので工程の完了条件には入れない %>
          <label style="margin-top:10px;">裏面情報 <span class="muted" style="font-weight:400">(任意。パッケージ裏面をそのまま貼り付ける。下の定型文の材料)</span></label>
          <%# 🆕 入荷のときに撮った裏面の写真 (2026-09-18)。見ながら書ける + AI に文字起こしさせる %>
          <% if (backLabelPhotos && backLabelPhotos.length) { %>
            <div style="display:flex; gap:8px; align-items:flex-start; flex-wrap:wrap; margin:0 0 6px;">
              <% backLabelPhotos.forEach(function (ph) { %>
                <a href="/apps/product-hub/drafts/<%= draft.id %>/back-label/<%= ph.id %>" target="_blank" rel="noopener" title="クリックで拡大">
                  <img src="/apps/product-hub/drafts/<%= draft.id %>/back-label/<%= ph.id %>" alt="パッケージ裏面" loading="lazy"
                       style="width:72px; height:72px; object-fit:cover; border-radius:6px; border:1px solid #e2e8f0; background:#fff; display:block;">
                </a>
              <% }); %>
              <div style="flex:1; min-width:220px;">
                <button type="button" class="btn" id="back-info-ocr-btn" <%= backLabelOcrEnabled ? '' : 'disabled' %>>🤖 AIで文字起こし</button>
                <div class="muted" id="back-info-ocr-msg" style="font-size:11px; margin-top:4px;">
                  <% if (backLabelOcrEnabled) { %>
                    入荷のときに撮った写真を読み取って<b>下書き</b>を作ります。<b>保存はしません</b> — 中身を確かめてから「画像制作情報を保存」してください
                  <% } else { %>
                    AI文字起こしは未設定です (env <code>OPENAI_API_KEY</code>)。写真を見ながら手で入れてください
                  <% } %>
                </div>
              </div>
            </div>
          <% } else { %>
            <%# 写真が無い商品。どこから来るものかを書いておく (無いのが異常なのか分からないと問い合わせになる) %>
            <div class="muted" style="font-size:11px; margin:0 0 4px;">
              入荷のときに撮った裏面の写真はまだありません。新商品が入荷すると
              <a href="/apps/inbound-check/" target="_blank" rel="noopener">入荷受付チェック</a> で撮られ、ここに出ます
              (この仕組みより前に入荷した商品には付いていません)。
            </div>
          <% } %>
          <textarea id="ip-back-info" rows="5" placeholder="パッケージ裏面を撮影して AI に文字起こしさせた文章をそのまま貼り付ける (原材料・内容量・使用方法・注意書きなど)。裏面表記が不要な商品は空のままで構いません"><%= ip.back_info_text || '' %></textarea>
          <% if (ip.back_info_updated_at) { %>
            <div class="muted" style="font-size:11px;">最終更新: <%= String(ip.back_info_updated_at).slice(0, 16).replace('T', ' ') %> <%= ip.back_info_updated_by || '' %></div>
          <% } %>
          <div style="display:flex; gap:8px; margin-top:6px; flex-wrap:wrap; align-items:center;">
            <button type="button" class="btn prompt-btn" data-kind="initialJudge" <%= promptTemplates.available ? '' : 'disabled' %>>🧪 初動判定を準備</button>
            <button type="button" class="btn prompt-btn" data-kind="productAnalysis" <%= promptTemplates.available ? '' : 'disabled' %>>📝 商品分析を準備</button>
            <button type="button" class="btn prompt-btn" data-kind="simpleLp" <%= promptTemplates.available ? '' : 'disabled' %>>🖼 簡易LPを準備</button>
            <span class="muted" style="font-size:12px;"><%= promptTemplates.available ? 'ChatGPT に貼る定型文を作ります (コピーして商品画像を添付。保存前の編集は反映されません)' : promptTemplates.reason %></span>
          </div>
          <div id="prompt-modal" hidden style="margin-top:8px; background:#fff; border:1px solid #cbd5e1; border-radius:8px; padding:8px;">
            <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
              <strong id="prompt-title"></strong>
              <button type="button" class="btn btn-primary" id="prompt-copy-btn">コピー</button>
              <button type="button" class="btn" id="prompt-close-btn">閉じる</button>
              <span class="muted" id="prompt-copy-result" style="font-size:12px;"></span>
            </div>
            <%# 2026-09-10: 補足情報の欄は廃止 (新しい定型文に補足情報の枠が無い)。
                足したいことがあれば下の本文をそのまま直してからコピーする %>
            <textarea id="prompt-text" rows="16" style="width:100%; font-family:ui-monospace, monospace; font-size:12px;"></textarea>
          </div>
        </div>
        <script type="application/json" id="prompt-templates-json"><%- JSON.stringify(promptTemplates).replace(/</g, '\\u003c') %></script>
        <%# 本番の構成の 済/まだ (2026-09-13 スタッフ要望)。縦列「仮構成」とは別。ボードのカードに「構成：まだ／済」で出る %>
        <div class="field" style="padding:8px 10px; border-radius:8px; background:#f8fafc; border:1px solid #e2e8f0;">
          <label style="display:inline; margin-right:8px;">構成</label>
          <% if (composeState.excluded) { %>
            <span class="muted">対象外 (詳細画像を作らない商品)</span>
          <% } else { %>
            <% if (composeState.done) { %><strong style="color:#15803d;">済</strong><% } else { %><strong>まだ</strong><% } %>
            <span class="muted" style="font-size:12px;">
              <% if (composeState.marked) { %><%= String(ip.compose_updated_at || '').slice(0, 16).replace('T', ' ') %> <%= ip.compose_updated_by || '' %>
              <% } else if (composeState.implied) { %>(③素材待ちが済んでいるので 済 とみなしています)
              <% } else { %>(本番の構成ができたら押す。縦列「仮構成」とは別)<% } %>
            </span>
            <%# 推定の 済 でも「まだに戻す」を出す (人の値が推定より優先 — Codex R1) %>
            <button type="button" class="btn btn-sm" id="compose-btn" data-done="<%= composeState.done ? '0' : '1' %>" style="margin-left:8px;"><%= composeState.done ? 'まだに戻す' : '構成を済にする' %></button>
          <% } %>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>撮影・素材ステータス <span class="muted" style="font-weight:400">(撮影要否を判断して設定 / ③素材待ちは 素材完了 か 撮影不要 で完了)</span></label>
            <select id="ip-material" style="width:100%;">
              <option value="">未設定</option>
              <% for (const m of materialStatuses) { %>
                <option value="<%= m.code %>" <%= ip.material_status === m.code ? 'selected' : '' %>><%= m.label %></option>
              <% } %>
            </select>
          </div>
          <div style="flex:1">
            <label>ステータス <span class="muted" style="font-weight:400">(メモ用。工程は上の工程パネルが正)</span></label>
            <input type="text" id="ip-status" list="dl-ip-status" value="<%= ip.status || '' %>">
            <datalist id="dl-ip-status">
              <option value="参考画像収集"><option value="A+コンテンツ作成"><option value="楽天登録">
              <option value="AUpayマーケットに画像登録"><option value="メルカリshopsに画像登録"><option value="Qoo10登録">
              <option value="完了">
            </datalist>
          </div>
          <div style="flex:1">
            <label>重要商品区分</label>
            <input type="text" id="ip-tier" list="dl-ip-tier" value="<%= ip.importance_tier || '' %>">
            <datalist id="dl-ip-tier">
              <option value="力を入れて画像を作る（9〜12枚）"><option value="そこそこ力を入れる（6〜8枚）">
              <option value="あまり力を入れない（4～５枚）"><option value="過去に作成した画像を参考に作る">
            </datalist>
          </div>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>画像作成指示</label>
            <input type="text" id="ip-type" list="dl-ip-type" value="<%= ip.production_type || '' %>">
            <datalist id="dl-ip-type"><option value="画像を新規で作成"><option value="既存の他容量の画像を差替え"></datalist>
          </div>
          <div style="flex:1">
            <label>A+コンテンツ</label>
            <input type="text" id="ip-aplus" list="dl-ip-aplus" value="<%= ip.aplus_content || '' %>">
            <datalist id="dl-ip-aplus"><option value="新規作成"><option value="既存コンテンツに追加"><option value="作成必要なし"></datalist>
          </div>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>撮影商品発送 <span class="muted" style="font-weight:400">(旧 Notion 項目。上の「撮影・素材ステータス」に置き換え)</span></label>
            <input type="text" id="ip-shipping" value="<%= ip.shipping_status || '' %>" readonly style="background:#f1f5f9;">
          </div>
          <div style="flex:1">
            <label>参考画像・レビュー収集</label>
            <input type="text" id="ip-refcol" list="dl-ip-refcol" value="<%= ip.reference_collection || '' %>">
            <datalist id="dl-ip-refcol"><option value="画像レビュー新規収集"><option value="画像レビュー収集不要"></datalist>
          </div>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>画像作成担当者</label>
            <input type="text" id="ip-designer" list="dl-ip-designer" value="<%= ip.designer || '' %>">
            <datalist id="dl-ip-designer">
              <option value="外注_大川さん"><option value="外注_三木さん"><option value="外注_成田さん"><option value="高島さん"><option value="田中さん">
            </datalist>
          </div>
          <div style="flex:1">
            <label>商品ページ構成担当者</label>
            <input type="text" id="ip-composer" list="dl-ip-composer" value="<%= ip.page_composer || '' %>">
            <datalist id="dl-ip-composer"><option value="田中美祐"><option value="大川さん"><option value="中原大輔"></datalist>
          </div>
        </div>
        <div class="field">
          <label>カメラ撮影指示URL</label>
          <input type="url" id="ip-camera-url" value="<%= ip.camera_instruction_url || '' %>" placeholder="https://docs.google.com/spreadsheets/...">
        </div>
        <div class="field">
          <label>Canva リンク (制作中のデザイン)</label>
          <input type="url" id="ip-canva-url" value="<%= ip.canva_url || '' %>" placeholder="https://canva.link/...">
          <% if (ip.canva_url) { %><a href="<%= ip.canva_url %>" target="_blank" rel="noopener" class="muted" style="font-size:12px;">開く ↗</a><% } %>
        </div>
        <%# TOP画像の構成 (2026-09-13 スタッフ要望)。TOP作成から完了までを円滑にするため、詳細画像 (LP) と同じく
            TOP画像も田中さんが簡単な構成を作る。テキストの構成と参考・ラフの URL を並べて、すり合わせを見える形にし
            大輔さんに制作意図を伝える %>
        <div class="field" style="padding:8px 10px; border-radius:8px; background:#f8fafc; border:1px solid #e2e8f0;">
          <label>TOP画像の構成 <span class="muted" style="font-weight:400">(簡単なもので OK。少量のテキスト)</span></label>
          <textarea id="ip-top-compose" rows="3" placeholder="例: 白背景に商品を大きく配置。左上に「内容量 50g」、下に使用シーンの小写真"><%= ip.top_compose_text || '' %></textarea>
          <label style="margin-top:8px;">参考・ラフの URL <span class="muted" style="font-weight:400">(田中さんのワークスペースか、商品の Drive に保存したもの)</span></label>
          <input type="url" id="ip-top-ref-url" value="<%= ip.top_ref_url || '' %>" placeholder="https://drive.google.com/...">
          <% if (ip.top_ref_url) { %><a href="<%= ip.top_ref_url %>" target="_blank" rel="noopener" class="muted" style="font-size:12px;">開く ↗</a><% } %>
        </div>
        <div class="field">
          <label>A+関連商品 (ASIN等)</label>
          <input type="text" id="ip-aplus-related" value="<%= ip.aplus_related || '' %>">
        </div>
        <div class="field">
          <%# 2026-08-31 中原さん: デザインは社内で進めるようになったので、依頼文はカメラマンへの
              撮影依頼に変わった。URL 2 本 (Drive フォルダ / カメラ撮影指示) を差し込んだ定型文を作る %>
          <label>依頼文 (カメラマンへの撮影依頼)</label>
          <div style="display:flex; gap:6px; align-items:center; margin-bottom:4px; flex-wrap:wrap;">
            <button type="button" class="btn btn-sm" id="ip-request-template">📷 撮影依頼の定型文を作る</button>
            <span class="muted" id="ip-request-template-note" style="font-size:11px;">
              画像フォルダのURL と カメラ撮影指示URL を差し込みます
            </span>
          </div>
          <textarea id="ip-request" rows="6"><%= ip.request_text || '' %></textarea>
        </div>
        <button class="btn btn-primary" id="save-ip-btn">画像制作情報を保存</button>
    </div>
  </div>
  </div><!-- /tab-images -->

  <!-- ═══ タブ3: 商品説明 ═══ -->
  <!-- 2026-08-03 中原さん指示で再構成: 楽天の3欄をデフォルト表示の主役に、
       AI素材 (特徴・仕様・注意書き) は折りたたみの裏方へ。タイトル系に店舗ルールの文字数制限 -->
  <div class="tab-panel" id="tab-desc">
  <%
    const aiMeta = {
      rakuten_title: { label: '楽天タイトル', max: 128 },
      yahoo_title: { label: 'Yahoo!タイトル', max: 65 },
      desc_catch: { label: 'キャッチコピー', max: 30 },
      desc_features: { label: '特徴 (箇条書き)' },
      desc_spec: { label: '仕様 (説明文用)' },
      desc_notes: { label: '注意書き' },
    };
    const aiBadge = (kind) => aiOutputs[kind] && aiOutputs[kind].generated_at && !aiOutputs[kind].edited_by_human;
  %>

  <!-- タイトル・キャッチコピー (店舗ルールの文字数制限つき) -->
  <div class="card" style="border-color:#c7d2fe; background:#fbfbff;">
    <h2>✏️ タイトル・キャッチコピー</h2>
    <p class="muted" style="margin-top:-6px">
      AI が下書きを作り、人が仕上げます。文字数は店舗ルール — 超えると赤くなります。
    </p>
    <% for (const kind of ['rakuten_title', 'yahoo_title', 'desc_catch']) { %>
      <div class="field">
        <label>
          <%= aiMeta[kind].label %> <span class="muted">(<%= aiMeta[kind].max %>文字以内)</span><span class="ftag ftag-ai">AI</span><span class="ftag ftag-m">手入力</span>
          <span class="ai-len muted" data-for="<%= kind %>" style="margin-left:6px; font-size:11px;"></span>
          <% if (aiBadge(kind)) { %><span class="badge badge-ready_for_ai" style="margin-left:6px">AI生成・未レビュー</span><% } %>
        </label>
        <textarea class="ai-output" data-kind="<%= kind %>" data-max="<%= aiMeta[kind].max %>" rows="2"><%= aiOutputs[kind] ? (aiOutputs[kind].content || '') : '' %></textarea>
      </div>
    <% } %>
    <button class="btn btn-primary save-ai-btn">タイトル・説明文を保存</button>
  </div>

  <!-- 楽天の説明文3欄 (最終形。デフォルト表示 — 2026-08-03 中原さん「3欄が主役、素材は裏方」) -->
  <div class="card" style="margin-top:16px;">
    <h2>🛒 楽天の説明文3欄 <span class="muted" style="font-weight:400">(送信される最終形。RMSの入力欄と同じ並び)</span><span class="ftag ftag-auto">自動</span></h2>
    <p class="muted" style="margin-top:-6px;">
      タイトル・下の「説明文の素材」・商品情報タブのページ表記・商品画像から<strong>自動で組み立てて送信</strong>されます。
      直したいときは素材側を直して保存すると、ここも変わります。
    </p>
    <div style="display:flex; gap:8px; align-items:center;">
      <button class="btn btn-sm" id="desc3-btn">再組み立て</button>
      <span class="muted" id="desc3-status" style="font-size:12px;"></span>
    </div>
    <div id="desc3-result" style="display:none; margin-top:12px;">
      <% for (const [key, label, note] of [
        ['pc', 'PC用商品説明文', '表1枚: 説明 (商品名+特徴+仕様) / 注意事項 (注意書き+固定文) / 仕様表 / ページ表記 / 広告文責'],
        ['sp', 'スマートフォン用商品説明文', '販売説明文 (画像) + PC用商品説明文 の連結'],
        ['sales', 'PC用販売説明文', '商品画像を縦に並べた画像HTML (R-Cabinet転送済みの画像のみ)'],
      ]) { %>
        <div style="margin-bottom:14px;">
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <strong style="font-size:13px;"><%= label %></strong>
            <span class="muted" style="font-size:11px;" id="desc3-len-<%= key %>"></span>
            <button class="btn btn-sm desc3-copy" data-key="<%= key %>">HTMLをコピー</button>
          </div>
          <div class="muted" style="font-size:11px;"><%= note %></div>
          <div id="desc3-render-<%= key %>" class="desc3-render"
               style="border:1px solid #e2e8f0; border-radius:8px; padding:10px; margin-top:4px; max-height:<%= key === 'pc' ? 320 : 480 %>px; overflow:auto; background:#fff; font-size:13px;"></div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 説明文の素材 (AIの裏方。折りたたみ) -->
  <details style="margin-top:16px;">
    <summary style="cursor:pointer; font-size:14px; font-weight:600; padding:8px 0;">
      🤖 説明文の素材 (特徴・仕様・注意書き・仕様表) <span class="muted" style="font-weight:400">— 上の3欄の材料。直すと3欄が変わります</span>
    </summary>
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; align-items:start; margin-top:8px;">
    <!-- AI素材 -->
    <div class="card" style="border-color:#c7d2fe; background:#fbfbff;">
      <h2>🤖 AIが書く素材</h2>
      <p class="muted" style="margin-top:-6px">手で埋めなくて構いません。工程「基本情報入力」を完了にすると AI が書きます。直すのは自由です。</p>
      <% for (const kind of ['desc_features', 'desc_spec', 'desc_notes']) { %>
        <div class="field">
          <label>
            <%= aiMeta[kind].label %><span class="ftag ftag-ai">AI</span>
            <span class="ai-len muted" data-for="<%= kind %>" style="margin-left:6px; font-size:11px;"></span>
            <% if (aiBadge(kind)) { %><span class="badge badge-ready_for_ai" style="margin-left:6px">AI生成・未レビュー</span><% } %>
          </label>
          <textarea class="ai-output" data-kind="<%= kind %>" rows="4"><%= aiOutputs[kind] ? (aiOutputs[kind].content || '') : '' %></textarea>
        </div>
      <% } %>
      <button class="btn btn-primary save-ai-btn">タイトル・説明文を保存</button>
    </div>
    <!-- 仕様表 -->
    <div class="card">
      <h2>✏️ 仕様表 <span class="muted" style="font-weight:400">(サイズ・素材・容量など。説明文と各モールのスペック欄に再利用)</span><span class="ftag ftag-m">手入力</span></h2>
      <table class="list" style="margin-bottom:12px;">
        <% if (specs.length > 0) { %>
          <thead><tr><th style="width:200px">項目</th><th>値</th><th style="width:70px"></th></tr></thead>
        <% } %>
        <tbody>
          <% for (const sp of specs) { %>
            <tr>
              <td><%= sp.spec_key %></td>
              <td><%= sp.spec_value || '' %></td>
              <td><button class="btn btn-sm btn-danger del-spec-btn" data-id="<%= sp.id %>">削除</button></td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <div style="display:flex; gap:8px;">
        <input type="text" id="new-spec-key" placeholder="項目 (例: サイズ)" style="width:200px">
        <input type="text" id="new-spec-value" placeholder="値 (例: W10×D10×H15cm)">
        <button class="btn" id="add-spec-btn" style="white-space:nowrap">追加</button>
      </div>
    </div>
  </div>
  </details><!-- /説明文の素材 -->
  </div><!-- /tab-desc -->

