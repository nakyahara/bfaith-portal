<%- include('_header') %>
<div class="wrap">

  <div style="margin-bottom:12px;">
    <a class="btn" href="/apps/product-hub">← 一覧に戻る</a>
  </div>

  <!-- ステータス + Notion -->
  <div class="card">
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <span class="badge badge-<%= draft.status %>" style="font-size:13px"><%= statusLabels[draft.status] || draft.status %></span>
      <strong style="font-size:16px"><%= draft.name %></strong>
      <code class="muted"><%= draft.ne_code %></code>
      <span style="flex:1"></span>
      <% for (const s of nextStatuses) { %>
        <button class="btn btn-sm status-btn" data-to="<%= s %>"><%= statusLabels[s] %> にする</button>
      <% } %>
    </div>
    <% if (draft.status === 'draft' && gate.length > 0) { %>
      <div class="banner-warn" style="margin:12px 0 0;">
        <div>
          「生成待ち」に進むには以下が必要です:
          <ul style="margin:6px 0 0 18px; padding:0;">
            <% for (const r of gate) { %><li><%= r %></li><% } %>
          </ul>
        </div>
      </div>
    <% } %>
    <% if (draft.source === 'notion_import') { %>
      <div class="banner-warn" style="margin:12px 0 0;">
        📥 <strong>Notionから取り込んだ商品です (検証用)。</strong>
        Notion 側が正のため、ここで編集しても <strong>Notionには書き戻されません</strong>。
        既存カードの運用はNotionで行ってください。
        <% if (draft.source_notion_status) { %>
          <span class="muted">／ 取り込み時のNotion Status: <%= draft.source_notion_status %></span>
        <% } %>
        <button class="btn btn-sm btn-danger" id="delete-draft-btn" style="margin-left:8px">この取り込みを削除</button>
      </div>
    <% } %>
    <div style="margin-top:10px; font-size:13px;">
      Notionカード:
      <% if (draft.notion_card_status === 'created' && draft.notion_page_id) { %>
        ✅ 作成済み <a href="https://www.notion.so/<%= draft.notion_page_id.replace(/-/g, '') %>" target="_blank" rel="noopener">Notionで開く ↗</a>
      <% } else { %>
        <% if (draft.notion_card_status === 'failed') { %>
          ❌ 作成失敗 <span class="muted"><%= draft.notion_card_error || '' %></span>
        <% } else { %>
          ⏳ 未作成
        <% } %>
        <button class="btn btn-sm" id="notion-retry-btn">再作成</button>
      <% } %>
      <span class="muted" id="action-result" style="margin-left:8px"></span>
    </div>
  </div>

  <!-- バリエーション (NE の代表商品コードで判定。NE が正・DBには焼かない) -->
  <div class="card" style="border-color:#bae6fd; background:#f8fdff;">
    <h2>🗄️ NE商品マスタから自動取得 <span class="muted" style="font-weight:400">(バリエーション判定)</span></h2>
    <p class="muted" style="margin-top:-6px">
      入力不要です。ネクストエンジンの代表商品コードから自動で判定しています。
      商品名・税率は<strong>登録時の初期値としてだけ</strong>NEから取り込み、以降はこのアプリの値が正です。
    </p>
    <% if (variation.kind === 'variation') { %>
      <div style="font-size:13px; margin-bottom:10px;">
        <strong>バリエーションあり</strong> — 代表商品コード
        <button type="button" class="copy-code" data-code="<%= variation.groupKey %>" title="クリックでコピー"><%= variation.groupKey %><span class="copy-hint">📋 コピー</span></button>
        に <strong><%= variation.memberCount %> SKU</strong> がぶら下がっています
        <span class="muted">(NE判定)</span>
      </div>
      <% if (variation.isChild) { %>
        <div class="banner-warn" style="margin:0 0 10px;">
          <div>
            ⚠️ このドラフトの商品コード <code><%= draft.ne_code %></code> は<strong>子SKU</strong>です。
            楽天は1ページ＝代表コード単位なので、<code><%= variation.groupKey %></code> にまとめることを推奨します。
            <% if (regroup) { %>
              <div class="muted" style="margin-top:4px;">まとめられません: <%= regroup %></div>
            <% } %>
          </div>
          <% if (!regroup) { %>
            <button class="btn btn-sm btn-primary" id="regroup-btn"
                    data-from="<%= draft.ne_code %>" data-to="<%= variation.groupKey %>"
                    style="white-space:nowrap">代表コードにまとめる</button>
          <% } %>
        </div>
      <% } %>
      <details open>
        <summary style="cursor:pointer; font-size:13px; font-weight:600;">このページに載るSKU (<%= variation.members.length %>件)</summary>
        <table class="list" style="margin-top:8px;">
          <thead><tr><th style="width:190px">商品コード</th><th>商品名</th><th style="width:100px">取扱区分</th><th style="width:60px">在庫</th><th style="width:70px"></th></tr></thead>
          <tbody>
            <% for (const m of variation.members) { %>
              <% const isSelf = String(m.商品コード || '').trim().toLowerCase() === String(draft.ne_code || '').trim().toLowerCase(); %>
              <tr<%= isSelf ? ' style="background:#eff6ff"' : '' %>>
                <td><code style="font-size:12px"><%= m.商品コード %></code></td>
                <td><%= m.商品名 || '' %></td>
                <td class="muted"><%= m.取扱区分 || '' %></td>
                <td class="muted"><%= m.在庫数 != null ? m.在庫数 : '' %></td>
                <td>
                  <% if (!isSelf) { %>
                    <button class="btn btn-sm exclude-sku-btn" data-code="<%= m.商品コード %>">外す</button>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </details>
      <% if (variation.excludedMembers.length > 0) { %>
        <details style="margin-top:10px;">
          <summary style="cursor:pointer; font-size:13px; font-weight:600; color:#b45309;">
            このページから外したSKU (<%= variation.excludedMembers.length %>件)
          </summary>
          <p class="muted" style="margin:8px 0 0;">
            外したSKUは楽天のこのページに載りません。別ページにする場合は、そのコードで新規登録してください
            （まとめ直されずに単独のドラフトになります）。
          </p>
          <table class="list" style="margin-top:8px;">
            <tbody>
              <% for (const m of variation.excludedMembers) { %>
                <tr>
                  <td style="width:190px"><code style="font-size:12px"><%= m.商品コード %></code></td>
                  <td class="muted"><%= m.商品名 || '' %></td>
                  <td style="width:150px; font-size:12px;">
                    <% if (m.ownDraftId) { %>
                      <a href="/apps/product-hub/detail/<%= m.ownDraftId %>">単独ページ #<%= m.ownDraftId %></a>
                    <% } else { %>
                      <span style="color:#b45309" title="このSKUはどの楽天ページにも載りません">未割当</span>
                    <% } %>
                  </td>
                  <td style="width:70px"><button class="btn btn-sm restore-sku-btn" data-code="<%= m.商品コード %>">戻す</button></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </details>
      <% } %>
    <% } else if (variation.kind === 'detached') { %>
      <p class="muted" style="margin:0;">
        このSKUは他ページのバリエーションから外され、<strong>単独のページ</strong>として扱われています。
      </p>
    <% } else if (variation.kind === 'single') { %>
      <p class="muted" style="margin:0;">単品です（NEに代表商品コードの登録なし）。</p>
    <% } else if (variation.kind === 'conflict') { %>
      <div class="banner-warn" style="margin:0;">
        ⚠️ NE商品マスタに商品コード <code><%= draft.ne_code %></code> が
        <strong><%= variation.memberCount %>件</strong>あります（大文字小文字・空白違いの重複）。
        どちらのグループか判定できないため、NE側の重複を解消してください。
      </div>
    <% } else { %>
      <p class="muted" style="margin:0;">
        商品コード <code><%= draft.ne_code %></code> はNE商品マスタに見つかりませんでした（未登録の新商品など）。
        判定できないため、下の「バリエーションあり」チェックが手動の値として使われます。
      </p>
    <% } %>
  </div>

  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
    <!-- 基本情報 -->
    <div class="card">
      <h2>✏️ 基本情報 <span class="muted" style="font-weight:400">(入力)</span></h2>
      <div class="field">
        <label>商品コード (NE / 楽天管理番号)</label>
        <!-- 登録後の変更は影響範囲が広い (Notionカード・NE突合のキー) ので表示専用。クリックでコピー -->
        <button type="button" class="copy-code" data-code="<%= draft.ne_code %>"
                title="クリックでコピー"><%= draft.ne_code %><span class="copy-hint">📋 コピー</span></button>
      </div>
      <div class="field">
        <label class="req">商品名</label>
        <input type="text" id="f-name" value="<%= draft.name %>">
      </div>
      <div class="field">
        <label class="req">公式ページURL (AI生成の参照元)</label>
        <input type="url" id="f-official-url" value="<%= draft.official_url || '' %>" placeholder="https://...">
      </div>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label>売価 (税込・円)</label>
          <input type="number" id="f-price" min="0" step="1" value="<%= draft.price != null ? draft.price : '' %>">
        </div>
        <div style="flex:1">
          <label>JANコード</label>
          <input type="text" id="f-jan" inputmode="numeric" value="<%= draft.jan_code || '' %>">
        </div>
      </div>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label>ASIN</label>
          <input type="text" id="f-asin" value="<%= draft.asin || '' %>" placeholder="B0XXXXXXXX">
        </div>
        <div style="flex:2">
          <label>Amazon URL</label>
          <input type="url" id="f-amazon-url" value="<%= draft.amazon_url || '' %>" placeholder="https://www.amazon.co.jp/dp/...">
        </div>
      </div>
      <div class="field">
        <label><input type="checkbox" id="f-own-brand" style="width:auto" <%= draft.own_brand ? 'checked' : '' %>> 自社商品 (画像制作ワークフローを使う)</label>
      </div>
      <div class="field">
        <label>画像フォルダURL (共有ドライブ。「商品コード_商品名」規則を推奨)</label>
        <input type="url" id="f-drive-folder" value="<%= draft.drive_folder_url || '' %>" placeholder="https://drive.google.com/drive/folders/...">
      </div>
      <div class="field">
        <% if (hasVariation.source === 'ne') { %>
          <!-- NE にある商品は NE が正 (中原さん決定 2026-07-25)。手入力させず判定結果を出す -->
          <label>バリエーション</label>
          <div style="font-size:13px;">
            <%= hasVariation.value ? 'あり' : 'なし' %>
            <span class="muted">— NE商品マスタの判定<%= hasVariation.value ? ` (代表 ${variation.groupKey} / ${variation.memberCount} SKU)` : '' %></span>
          </div>
          <!-- NE 判定時は保存リクエストに含めない (サーバー側でも無視される) -->
        <% } else { %>
          <label><input type="checkbox" id="f-has-variation" style="width:auto" <%= draft.has_variation ? 'checked' : '' %>> バリエーションあり (サイズ・色違い)</label>
          <div class="muted">NEに無い商品のため手動指定です。NEに登録されると自動判定に切り替わります。</div>
        <% } %>
      </div>
      <div class="field">
        <label>メモ</label>
        <textarea id="f-memo" rows="3"><%= draft.memo || '' %></textarea>
      </div>
      <button class="btn btn-primary" id="save-basic-btn">基本情報を保存</button>
    </div>

    <!-- 参考URL -->
    <div class="card">
      <h2>✏️ 参考URL <span class="muted" style="font-weight:400">(公式ページ以外の参照元)</span></h2>
      <% if (refs.length === 0) { %>
        <p class="muted">まだありません。メーカーの商品ページや類似商品ページなど、AI が説明文を書くときに参考にする URL を追加してください。</p>
      <% } %>
      <ul style="list-style:none; margin:0 0 12px; padding:0;">
        <% for (const r of refs) { %>
          <li style="display:flex; gap:8px; align-items:center; padding:4px 0; font-size:13px;">
            <a href="<%= r.url %>" target="_blank" rel="noopener" style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= r.url %></a>
            <button class="btn btn-sm btn-danger del-ref-btn" data-id="<%= r.id %>">削除</button>
          </li>
        <% } %>
      </ul>
      <div style="display:flex; gap:8px;">
        <input type="url" id="new-ref-url" placeholder="https://...">
        <button class="btn" id="add-ref-btn" style="white-space:nowrap">追加</button>
      </div>
    </div>
  </div>

  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
    <!-- Yahoo!向け追記項目 -->
    <div class="card">
      <h2>✏️ Yahoo!向け追記項目 <span class="muted" style="font-weight:400">(入力・楽天→Yahoo移行で使用)</span></h2>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label>Yahoo!売価 (税込・円)</label>
          <input type="number" id="y-price" min="0" step="1" value="<%= yahoo && yahoo.yahoo_price != null ? yahoo.yahoo_price : '' %>">
        </div>
        <div style="flex:1">
          <label>Yahoo!売価 (佐川の場合)</label>
          <input type="number" id="y-price-sagawa" min="0" step="1" value="<%= yahoo && yahoo.yahoo_price_sagawa != null ? yahoo.yahoo_price_sagawa : '' %>">
        </div>
      </div>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label>配送方法</label>
          <input type="text" id="y-delivery" value="<%= yahoo ? (yahoo.delivery_label || '') : '' %>" placeholder="例: ネコポス">
        </div>
        <div style="flex:1">
          <label>税率 <span class="muted">(登録時にNEから初期値)</span></label>
          <input type="text" id="y-tax" value="<%= yahoo ? (yahoo.tax_rate || '') : '' %>" placeholder="例: 10%">
        </div>
      </div>
      <div class="field" style="display:flex; gap:12px;">
        <div style="flex:1">
          <label>Yahoo!カテゴリID</label>
          <input type="number" id="y-category-id" value="<%= yahoo && yahoo.yahoo_category_id != null ? yahoo.yahoo_category_id : '' %>">
        </div>
        <div style="flex:2">
          <label>Yahoo!path (店カテゴリ)</label>
          <input type="text" id="y-path" value="<%= yahoo ? (yahoo.yahoo_path || '') : '' %>">
        </div>
      </div>
      <button class="btn btn-primary" id="save-yahoo-btn">Yahoo!項目を保存</button>
    </div>

    <!-- 画像制作 (自社商品のみ) -->
    <div class="card">
      <h2>画像制作 <span class="muted" style="font-weight:400">(自社商品のみ)</span></h2>
      <% if (!draft.own_brand) { %>
        <p class="muted">基本情報で「自社商品」をONにすると、画像制作の管理項目が使えます。</p>
      <% } else { %>
        <% const ip = imageProduction || {}; %>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>ステータス</label>
            <input type="text" id="ip-status" list="dl-ip-status" value="<%= ip.status || '' %>">
            <datalist id="dl-ip-status">
              <option value="参考画像収集"><option value="A+コンテンツ作成"><option value="楽天登録">
              <option value="AUpayマーケットに画像登録"><option value="メルカリshopsに画像登録"><option value="Qoo10登録">
              <option value="完了">
            </datalist>
          </div>
          <div style="flex:1">
            <label>重要商品区分</label>
            <input type="text" id="ip-tier" list="dl-ip-tier" value="<%= ip.importance_tier || '' %>">
            <datalist id="dl-ip-tier">
              <option value="力を入れて画像を作る（9〜12枚）"><option value="そこそこ力を入れる（6〜8枚）">
              <option value="あまり力を入れない（4～５枚）"><option value="過去に作成した画像を参考に作る">
            </datalist>
          </div>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>画像作成指示</label>
            <input type="text" id="ip-type" list="dl-ip-type" value="<%= ip.production_type || '' %>">
            <datalist id="dl-ip-type"><option value="画像を新規で作成"><option value="既存の他容量の画像を差替え"></datalist>
          </div>
          <div style="flex:1">
            <label>A+コンテンツ</label>
            <input type="text" id="ip-aplus" list="dl-ip-aplus" value="<%= ip.aplus_content || '' %>">
            <datalist id="dl-ip-aplus"><option value="新規作成"><option value="既存コンテンツに追加"><option value="作成必要なし"></datalist>
          </div>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>撮影商品発送</label>
            <input type="text" id="ip-shipping" list="dl-ip-shipping" value="<%= ip.shipping_status || '' %>">
            <datalist id="dl-ip-shipping">
              <option value="撮影依頼不要"><option value="撮影商品発送手配済み"><option value="撮影商品未発送"><option value="社内準備">
            </datalist>
          </div>
          <div style="flex:1">
            <label>参考画像・レビュー収集</label>
            <input type="text" id="ip-refcol" list="dl-ip-refcol" value="<%= ip.reference_collection || '' %>">
            <datalist id="dl-ip-refcol"><option value="画像レビュー新規収集"><option value="画像レビュー収集不要"></datalist>
          </div>
        </div>
        <div class="field" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>画像作成担当者</label>
            <input type="text" id="ip-designer" list="dl-ip-designer" value="<%= ip.designer || '' %>">
            <datalist id="dl-ip-designer">
              <option value="外注_大川さん"><option value="外注_三木さん"><option value="外注_成田さん"><option value="高島さん"><option value="田中さん">
            </datalist>
          </div>
          <div style="flex:1">
            <label>商品ページ構成担当者</label>
            <input type="text" id="ip-composer" list="dl-ip-composer" value="<%= ip.page_composer || '' %>">
            <datalist id="dl-ip-composer"><option value="田中美祐"><option value="大川さん"><option value="中原大輔"></datalist>
          </div>
        </div>
        <div class="field">
          <label>カメラ撮影指示URL</label>
          <input type="url" id="ip-camera-url" value="<%= ip.camera_instruction_url || '' %>" placeholder="https://docs.google.com/spreadsheets/...">
        </div>
        <div class="field">
          <label>A+関連商品 (ASIN等)</label>
          <input type="text" id="ip-aplus-related" value="<%= ip.aplus_related || '' %>">
        </div>
        <div class="field">
          <label>依頼文 (外注への画像作成依頼)</label>
          <textarea id="ip-request" rows="4"><%= ip.request_text || '' %></textarea>
        </div>
        <button class="btn btn-primary" id="save-ip-btn">画像制作情報を保存</button>
      <% } %>
    </div>
  </div>

  <!-- 画像 -->
  <div class="card">
    <h2>✏️ 商品画像 (Driveリンク)</h2>
    <div style="display:flex; gap:8px; margin-bottom:12px;">
      <input type="url" id="new-image-url" placeholder="https://drive.google.com/file/d/... (画像ファイルのリンク)">
      <button class="btn" id="add-image-btn" style="white-space:nowrap">追加</button>
    </div>
    <% if (images.length === 0) { %>
      <p class="muted">まだ画像がありません。Drive で画像ファイルを右クリック →「リンクをコピー」で取得した URL を貼ってください。</p>
    <% } else { %>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <% for (const img of images) { %>
          <div style="text-align:center;">
            <a href="<%= img.view_url %>" target="_blank" rel="noopener">
              <img src="<%= img.thumb %>" alt="" loading="lazy" referrerpolicy="no-referrer"
                   style="width:140px; height:140px; object-fit:cover; border-radius:8px; border:1px solid #e2e8f0; background:#f8fafc;">
            </a>
            <div><button class="btn btn-sm btn-danger del-image-btn" data-id="<%= img.id %>">削除</button></div>
          </div>
        <% } %>
      </div>
      <p class="muted" style="margin-bottom:0">※ サムネイルは Drive の閲覧権限があるアカウントでログインしたブラウザでのみ表示されます</p>
    <% } %>
  </div>

  <!-- 仕様表 -->
  <div class="card">
    <h2>✏️ 仕様表 <span class="muted" style="font-weight:400">(サイズ・素材・容量など。説明文と各モールのスペック欄に再利用)</span></h2>
    <table class="list" style="margin-bottom:12px;">
      <% if (specs.length > 0) { %>
        <thead><tr><th style="width:200px">項目</th><th>値</th><th style="width:70px"></th></tr></thead>
      <% } %>
      <tbody>
        <% for (const sp of specs) { %>
          <tr>
            <td><%= sp.spec_key %></td>
            <td><%= sp.spec_value || '' %></td>
            <td><button class="btn btn-sm btn-danger del-spec-btn" data-id="<%= sp.id %>">削除</button></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <div style="display:flex; gap:8px;">
      <input type="text" id="new-spec-key" placeholder="項目 (例: サイズ)" style="width:200px">
      <input type="text" id="new-spec-value" placeholder="値 (例: W10×D10×H15cm)">
      <button class="btn" id="add-spec-btn" style="white-space:nowrap">追加</button>
    </div>
  </div>

  <!-- AI出力 -->
  <div class="card" style="border-color:#c7d2fe; background:#fbfbff;">
    <h2>🤖 AIが書く項目 <span class="muted" style="font-weight:400">(タイトル・説明文)</span></h2>
    <p class="muted" style="margin-top:-6px">
      <strong>ここは手で埋めなくて構いません。</strong>「生成待ち」にすると AI が下書きを作ります (P2 で稼働予定)。
      できあがったものを直すのは自由です。
    </p>
    <%
      const aiLabels = {
        rakuten_title: '楽天タイトル',
        yahoo_title: 'Yahoo!タイトル',
        desc_catch: 'キャッチコピー',
        desc_features: '特徴 (箇条書き)',
        desc_spec: '仕様 (説明文用)',
        desc_notes: '注意書き',
      };
    %>
    <% for (const kind of aiKinds) { %>
      <div class="field">
        <label>
          <%= aiLabels[kind] || kind %>
          <% if (aiOutputs[kind] && aiOutputs[kind].generated_at && !aiOutputs[kind].edited_by_human) { %>
            <span class="badge badge-ready_for_ai" style="margin-left:6px">AI生成・未レビュー</span>
          <% } %>
        </label>
        <textarea class="ai-output" data-kind="<%= kind %>" rows="<%= kind.startsWith('desc_') ? 4 : 2 %>"><%= aiOutputs[kind] ? (aiOutputs[kind].content || '') : '' %></textarea>
      </div>
    <% } %>
    <button class="btn btn-primary" id="save-ai-btn">タイトル・説明文を保存</button>
  </div>

  <!-- 楽天出品 (P3) -->
  <div class="card" style="border-color:#fecaca; background:#fffbfa;">
    <h2>🛒 楽天に出品 <span class="muted" style="font-weight:400">(非公開で登録 → 公開はRMS画面で)</span></h2>
    <% const selectedShopCats = shopCategories.filter((c) => c.selected); %>
    <% if (rakuten && rakuten.registered_at && rakuten.published_at) { %>
      <div style="background:#dcfce7; border:1px solid #86efac; border-radius:8px; padding:10px 14px; font-size:13px; margin-bottom:12px;">
        🟢 <strong>楽天で公開中</strong>
        <span class="muted">(公開: <%= rakuten.published_at.replace('T',' ').slice(0,16) %> — アプリの記録。RMS画面で直接変更した場合はズレます)</span><br>
        問題があれば「非公開に戻す」で売り場から下げられます。
        <div style="margin-top:8px;">
          <button class="btn btn-sm" id="rk-unpublish-btn">非公開に戻す</button>
        </div>
      </div>
    <% } else if (rakuten && rakuten.registered_at) { %>
      <div style="background:#fefce8; border:1px solid #fde047; border-radius:8px; padding:10px 14px; font-size:13px; margin-bottom:12px;">
        ✅ <strong>楽天に非公開 (倉庫指定) で登録済み</strong>
        <span class="muted">(<%= rakuten.registered_at.replace('T',' ').slice(0,16) %>)</span><br>
        公開前チェック:
        <ul style="margin:6px 0 0 18px; padding:0;">
          <li>在庫は <strong>0 で登録</strong>されています (在庫は NE 連携 / 運用側で入れる)</li>
          <% if (selectedShopCats.length > 0) { %>
            <li>店舗内カテゴリを RMS で設定: <strong><%= selectedShopCats.map((c) => c.path).join(' ／ ') %></strong> <span class="muted">(自動反映は未対応)</span></li>
          <% } else { %>
            <li class="muted">店舗内カテゴリが未選択です (どの棚にも載りません)</li>
          <% } %>
          <li>「送信内容を確認」でページ内容を最終確認</li>
        </ul>
        <div style="margin-top:8px;">
          <button class="btn btn-primary btn-sm" id="rk-publish-btn">楽天で公開する</button>
          <span class="muted" style="font-size:12px;">アプリから公開に切り替えます (RMS画面を開く必要はありません)</span>
        </div>
      </div>
    <% } %>
    <% if (rakuten && rakuten.last_error) { %>
      <div class="banner-warn" style="margin:0 0 12px; white-space:pre-wrap; font-size:12px;">⚠️ 前回のRMSエラー:
<%= rakuten.last_error %></div>
    <% } %>

    <div class="field" style="display:flex; gap:12px;">
      <div style="flex:1">
        <label class="req">ジャンルID (楽天)</label>
        <div style="display:flex; gap:6px;">
          <input type="text" id="rk-genre" inputmode="numeric" value="<%= rakuten?.genre_id || '' %>" placeholder="AIが自動で提案します" style="flex:1;">
          <button type="button" class="btn btn-sm" id="rk-genre-tree" style="white-space:nowrap;">🌲 ツリーから選ぶ</button>
          <button type="button" class="btn btn-sm" id="rk-genre-fetch" style="white-space:nowrap;">ジャンル情報を取得</button>
        </div>
        <div id="rk-genre-suggest" style="font-size:12px; margin-top:4px;"></div>
        <div id="rk-genre-info" style="font-size:12px; margin-top:4px;">
          <% if (genreDict) { %>
            <span style="color:#166534;">✅ <%= genreDict.genrePath || genreDict.genreName %></span>
            <span class="muted">(必須属性 <%= genreDict.attributes.filter((a) => a.mandatory).length %> 件 / 辞書取得済み)</span>
          <% } else { %>
            <span class="muted">辞書未取得 — 取得すると必須属性の行が自動で並び、登録前にチェックされます</span>
          <% } %>
        </div>
      </div>
      <div style="flex:1">
        <label>メーカー型番 <span class="muted">(空なら「型番なし」で送信)</span></label>
        <input type="text" id="rk-article" value="<%= rakuten?.article_number || '' %>">
      </div>
    </div>

    <div class="field" style="display:flex; gap:12px; flex-wrap:wrap;">
      <div style="flex:1; min-width:160px;">
        <label>配送方法 <span class="muted">(楽天の配送方法グループ)</span></label>
        <select id="rk-shipping-group" style="width:100%;">
          <option value="">未設定 (店舗デフォルト)</option>
          <% for (const [gid, gname] of Object.entries(shippingGroups)) { %>
            <option value="<%= gid %>" <%= String(rakuten?.shipping_method_group || '') === gid ? 'selected' : '' %>><%= gname %></option>
          <% } %>
        </select>
      </div>
      <div style="flex:1; min-width:120px;">
        <label>送料</label>
        <select id="rk-postage" style="width:100%;">
          <option value="">未設定 (店舗デフォルト)</option>
          <option value="1" <%= rakuten?.postage_included === 1 ? 'selected' : '' %>>送料込み</option>
          <option value="0" <%= rakuten?.postage_included === 0 ? 'selected' : '' %>>送料別</option>
        </select>
      </div>
      <div style="flex:1; min-width:120px;">
        <label>納期情報ID <span class="muted">(RMSの納期設定)</span></label>
        <input type="text" id="rk-delivery-date" inputmode="numeric" value="<%= rakuten?.normal_delivery_date_id || '' %>" placeholder="未設定可">
      </div>
    </div>

    <div class="field">
      <label>白抜き背景画像 <span class="muted">(検索サムネ用 whiteBgImage。Driveのファイルリンク)</span></label>
      <%
        const whiteBgTransferred = rakuten?.white_bg_drive_file_id
          && cabinetImages.some((c) => c.drive_file_id === rakuten.white_bg_drive_file_id);
      %>
      <div style="display:flex; gap:8px; align-items:center;">
        <input type="text" id="rk-whitebg" style="flex:1;" value="<%= rakuten?.white_bg_drive_url || '' %>" placeholder="https://drive.google.com/file/d/...">
        <% if (rakuten?.white_bg_drive_file_id) { %>
          <span class="muted" style="font-size:12px; white-space:nowrap;"><%= whiteBgTransferred ? '✅ 転送済み' : '⏳ 未転送 (「画像を転送」で送る)' %></span>
        <% } %>
      </div>
    </div>

    <p class="muted" style="margin:0 0 10px; font-size:12px;">
      💡 税率 (<%= yahoo?.tax_rate || '未設定 = 店舗デフォルト10%' %>) と JANコード (<%= draft.jan_code || '未入力' %>) は基本情報・Yahoo!欄の値を自動で送ります。
      在庫は常に 0 で登録します。
    </p>

    <div class="field">
      <label>店舗内カテゴリ <span class="muted">(複数選択可。RMSへの自動反映は未対応 — 公開時にRMS画面で設定する欄です)</span></label>
      <% if (shopCategories.length === 0) { %>
        <p class="muted" style="margin:4px 0;">
          カテゴリ一覧が未取り込みです。<a href="/apps/product-hub">一覧画面</a>の「楽天 店舗内カテゴリ一覧」から取り込むと選べるようになります。
        </p>
      <% } else { %>
        <input type="text" id="rk-cat-filter" placeholder="絞り込み (カテゴリ名の一部)" style="margin-bottom:6px;">
        <!-- RMS と同じくツリーで選ぶ (2026-07-28)。checkbox の class/value は保存処理と共通 -->
        <div id="rk-cats" style="max-height:240px; overflow:auto; border:1px solid #e2e8f0; border-radius:8px; padding:6px 10px; background:#fff;"></div>
        <script type="application/json" id="rk-cats-data"><%- JSON.stringify(shopCategories.map((c) => ({ id: c.id, path: c.path, selected: !!c.selected, inactive: !c.is_active }))).replace(/</g, '\\u003c') %></script>
      <% } %>
    </div>

    <label>商品属性 <span class="muted">(「ジャンル情報を取得」で必須属性の行が自動で並びます。<span style="color:#dc2626">*必須</span> / 選択式はRMSの選択肢と同じ表記で)</span></label>
    <table class="list" id="rk-attrs" style="margin-bottom:8px;">
      <thead><tr><th style="width:40%">属性名 (例: ブランド名)</th><th>値</th><th style="width:50px"></th></tr></thead>
      <tbody>
        <%
          let rkAttrs = [];
          try { rkAttrs = JSON.parse(rakuten?.attributes_json || '[]'); } catch (e) { rkAttrs = []; }
          if (rkAttrs.length === 0) rkAttrs = [{ name: '', values: [''] }];
        %>
        <% for (const a of rkAttrs) { %>
          <tr>
            <td><input type="text" class="rk-attr-name" value="<%= a.name || '' %>"></td>
            <td><input type="text" class="rk-attr-value" value="<%= (a.values && a.values[0]) || '' %>"></td>
            <td><button type="button" class="btn btn-sm rk-attr-del">×</button></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <button type="button" class="btn btn-sm" id="rk-attr-add">＋ 属性行を追加</button>

    <div style="display:flex; gap:8px; align-items:center; margin-top:14px; flex-wrap:wrap;">
      <button class="btn" id="rk-save-btn">出品情報を保存</button>
      <button class="btn" id="rk-images-btn">画像をR-Cabinetへ転送 (<%= cabinetImages.length %>/<%= images.length %> 済)</button>
      <button class="btn" id="rk-preview-btn">送信内容を確認</button>
      <button class="btn btn-primary" id="rk-register-btn">非公開で登録</button>
      <span class="muted" id="rk-result"></span>
    </div>
    <pre id="rk-preview" style="display:none; margin-top:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px; font-size:11px; max-height:340px; overflow:auto;"></pre>
  </div>

  <!-- ジャンル選択モーダル (RMS の「ジャンルID選択」と同じ操作感) -->
  <div id="genre-modal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:1000;">
    <div style="background:#fff; max-width:640px; margin:6vh auto; border-radius:12px; padding:18px 20px; max-height:84vh; display:flex; flex-direction:column;">
      <div style="display:flex; align-items:center;">
        <h2 style="margin:0; font-size:16px;">ジャンルID選択</h2>
        <span style="flex:1"></span>
        <button type="button" class="btn btn-sm" id="genre-modal-close">✕</button>
      </div>
      <div id="genre-tree" style="flex:1; overflow:auto; border:1px solid #e2e8f0; border-radius:8px; margin:12px 0; padding:6px 4px; font-size:13px;">
        <p class="muted" style="margin:8px;">読み込み中…</p>
      </div>
      <div style="background:#f8fafc; border-radius:8px; padding:8px 12px; font-size:12px;">
        選択ジャンルID: <code id="genre-modal-id">—</code><br>
        選択ジャンルパス: <span id="genre-modal-path" class="muted">—</span>
      </div>
      <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:12px;">
        <button type="button" class="btn" id="genre-modal-cancel">キャンセル</button>
        <button type="button" class="btn btn-primary" id="genre-modal-apply">入力画面に反映</button>
      </div>
    </div>
  </div>

  <!-- 履歴 -->
  <div class="card">
    <details>
      <summary style="cursor:pointer; font-size:14px; font-weight:600;">操作履歴 (<%= events.length %>件)</summary>
      <table class="list" style="margin-top:10px;">
        <tbody>
          <% for (const ev of events) { %>
            <tr>
              <td class="muted" style="width:150px"><%= (ev.created_at || '').replace('T', ' ').slice(0, 19) %></td>
              <td style="width:180px"><%= ev.event %></td>
              <td class="muted"><%= ev.detail || '' %></td>
              <td class="muted" style="width:180px"><%= ev.actor || '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </details>
  </div>
</div>

<script>
  const BASE = '/apps/product-hub/api/drafts/<%= draft.id %>';
  const result = document.getElementById('action-result');

  async function post(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json();
  }

  function showAndReload(json, okMsg) {
    if (json.ok) {
      if (json.demoted) {
        alert('必須項目が欠けたため、ステータスを「下書き」に戻しました:\n' + json.demoted.join('\n'));
      }
      result.textContent = okMsg;
      setTimeout(() => location.reload(), 600);
    } else {
      const detail = json.reasons ? json.reasons.join(' / ') : '';
      alert((json.error || 'エラーが発生しました') + (detail ? '\n' + detail : ''));
    }
  }

  document.querySelectorAll('.status-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/status', { to: btn.dataset.to }), 'ステータスを変更しました');
    });
  });

  const notionRetryBtn = document.getElementById('notion-retry-btn');
  if (notionRetryBtn) {
    notionRetryBtn.addEventListener('click', async () => {
      notionRetryBtn.disabled = true;
      const json = await post(BASE + '/notion-retry');
      showAndReload(json, 'Notionカードを作成しました');
      if (!json.ok) notionRetryBtn.disabled = false;
    });
  }

  document.getElementById('save-basic-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE, {
      name: document.getElementById('f-name').value,
      official_url: document.getElementById('f-official-url').value,
      price: document.getElementById('f-price').value,
      jan_code: document.getElementById('f-jan').value,
      asin: document.getElementById('f-asin').value,
      amazon_url: document.getElementById('f-amazon-url').value,
      own_brand: document.getElementById('f-own-brand').checked,
      // NE で判定できる商品はキーごと送らない (DB に焼かせない)
      ...hasVariationPayload(),
      drive_folder_url: document.getElementById('f-drive-folder').value,
      memo: document.getElementById('f-memo').value,
    }), '保存しました');
  });

  function hasVariationPayload() {
    const el = document.getElementById('f-has-variation');
    return el ? { has_variation: el.checked } : {};
  }

  // ─── 楽天出品 (P3) ───
  const rkResult = document.getElementById('rk-result');

  // ─── ジャンルツリー選択モーダル (IchibaGenre/Search。RMS の「ジャンルID選択」相当) ───
  const genreModal = document.getElementById('genre-modal');
  let genreSelected = null; // { id, path, hasChildren }

  function setGenreSelection(id, path, hasChildren) {
    genreSelected = { id, path, hasChildren };
    document.getElementById('genre-modal-id').textContent = id;
    document.getElementById('genre-modal-path').textContent = path;
  }

  async function fetchGenreChildrenApi(genreId) {
    const res = await fetch('/apps/product-hub/api/rakuten/genre-children?genre_id=' + encodeURIComponent(genreId));
    return res.json();
  }

  function makeGenreNode(child, parentPath) {
    const row = document.createElement('div');
    row.style.cssText = 'padding:2px 0;';
    const head = document.createElement('div');
    head.style.cssText = 'display:flex; align-items:center; gap:6px; cursor:pointer; padding:3px 6px; border-radius:6px;';
    const arrow = document.createElement('span');
    arrow.textContent = '>';
    arrow.style.cssText = 'width:14px; color:#94a3b8; transition:transform .15s; display:inline-block;';
    const label = document.createElement('span');
    label.textContent = child.name;
    head.appendChild(arrow); head.appendChild(label);
    const box = document.createElement('div'); // 子の入れ物 (遅延読み込み)
    box.style.cssText = 'margin-left:18px; display:none;';
    row.appendChild(head); row.appendChild(box);
    const myPath = parentPath ? parentPath + ' > ' + child.name : child.name;
    let loaded = false;
    head.addEventListener('click', async () => {
      // 行クリック = 選択 + 展開/折り畳み (RMS モーダルと同じ)
      document.querySelectorAll('#genre-tree .genre-row-active').forEach((el) => {
        el.classList.remove('genre-row-active'); el.style.background = '';
      });
      head.classList.add('genre-row-active');
      head.style.background = '#eff6ff';
      if (!loaded) {
        arrow.textContent = '…';
        try {
          const j = await fetchGenreChildrenApi(child.genreId);
          if (!j.ok) {
            // 取得失敗を「末端」と誤判定しない (429/障害でも反映できてしまう) — 選択も確定しない
            arrow.textContent = '>';
            head.style.background = '';
            head.classList.remove('genre-row-active');
            alert('子ジャンルの取得に失敗しました: ' + (j.error || '') + '\nもう一度クリックして再試行してください');
            return;
          }
          loaded = true;
          const kids = j.children || [];
          if (kids.length === 0) {
            arrow.textContent = '・';
            row.dataset.leaf = '1';
          } else {
            arrow.textContent = '>';
            for (const k of kids) box.appendChild(makeGenreNode(k, myPath));
          }
        } catch (e) {
          arrow.textContent = '>';
          head.style.background = '';
          head.classList.remove('genre-row-active');
          alert('通信エラー: ' + e.message);
          return;
        }
      }
      const isLeaf = row.dataset.leaf === '1';
      if (!isLeaf) {
        const open = box.style.display !== 'none';
        box.style.display = open ? 'none' : 'block';
        arrow.style.transform = open ? '' : 'rotate(90deg)';
      }
      setGenreSelection(child.genreId, myPath, !isLeaf);
    });
    return row;
  }

  async function openGenreModal() {
    genreModal.style.display = 'block';
    setGenreSelection('—', '—', true);
    genreSelected = null;
    const tree = document.getElementById('genre-tree');
    tree.textContent = '読み込み中…';
    try {
      const j = await fetchGenreChildrenApi('0');
      if (!j.ok) { tree.textContent = '❌ ' + (j.error || '取得に失敗しました'); return; }
      tree.replaceChildren();
      for (const c of j.children || []) tree.appendChild(makeGenreNode(c, ''));
    } catch (e) { tree.textContent = '通信エラー: ' + e.message; }
  }

  function closeGenreModal() { genreModal.style.display = 'none'; }
  document.getElementById('rk-genre-tree').addEventListener('click', openGenreModal);
  document.getElementById('genre-modal-close').addEventListener('click', closeGenreModal);
  document.getElementById('genre-modal-cancel').addEventListener('click', closeGenreModal);
  genreModal.addEventListener('click', (ev) => { if (ev.target === genreModal) closeGenreModal(); });

  document.getElementById('genre-modal-apply').addEventListener('click', async () => {
    if (!genreSelected || genreSelected.id === '—') { alert('ジャンルを選択してください'); return; }
    if (genreSelected.hasChildren) {
      alert('末端のジャンル (これ以上開けない階層) を選んでください。\n商品を登録できるのは末端ジャンルだけです。');
      return;
    }
    const btn = document.getElementById('genre-modal-apply');
    btn.disabled = true;
    try {
      if (await applyGenre(genreSelected.id, 'tree')) closeGenreModal();
    } finally { btn.disabled = false; }
  });

  // ジャンルを反映する共通処理。順序が重要 (Codex R1 High-2/Medium-3):
  //   ① 先に RMS 属性辞書で検証 (末端でない/存在しないジャンルは 404 → 保存しない)
  //   ② genre だけを保存 (genre_only — 編集途中の他フォーム値を巻き込まない)
  //   ③ 成功してから入力欄と辞書 UI を更新
  let applyingGenre = false;
  async function applyGenre(genreId, source) {
    if (applyingGenre) return false;
    applyingGenre = true;
    try {
      const vres = await fetch('/apps/product-hub/api/rakuten/genre-attributes?genre_id=' + encodeURIComponent(genreId));
      const vj = await vres.json();
      if (!vj.ok) {
        const msg = 'ジャンル ' + genreId + ' は登録に使えません: ' + (vj.error || '');
        if (source === 'ai') document.getElementById('rk-genre-suggest').textContent = '❌ ' + msg;
        else alert(msg);
        return false;
      }
      const sres = await post(BASE + '/rakuten', { genre_only: true, genre_id: genreId });
      if (!sres.ok) {
        if (source === 'ai') document.getElementById('rk-genre-suggest').textContent = '❌ 保存に失敗: ' + (sres.error || '');
        else alert(sres.error || 'ジャンルの保存に失敗しました');
        return false;
      }
      document.getElementById('rk-genre').value = genreId;
      document.getElementById('rk-genre-fetch').click(); // 辞書はキャッシュ済みなので即応答
      if (source === 'ai') rkResult.textContent = 'AIがジャンルを設定しました (違う場合は「ツリーから選ぶ」で修正)';
      return true;
    } finally { applyingGenre = false; }
  }

  // ─── AI がジャンルの初期値を入れる (中原さん 2026-07-28) ───
  // 商品名で楽天市場を検索し、上位ヒット商品のジャンル多数決。人は違うと思ったらツリーで直す
  async function suggestGenre(autoApply) {
    const box = document.getElementById('rk-genre-suggest');
    box.textContent = 'AIがジャンルを探しています… (楽天市場の類似商品から)';
    try {
      const res = await fetch(BASE + '/rakuten/genre-suggest');
      const j = await res.json();
      if (!j.ok) { box.textContent = '提案できませんでした: ' + (j.error || ''); return; }
      const cands = (j.candidates || []).filter((c) => c.path);
      if (cands.length === 0) { box.textContent = '類似商品が見つかりませんでした。「ツリーから選ぶ」で指定してください'; return; }
      // 自動適用は「明確な多数」のときだけ (Codex R1 High-2):
      //   最多候補が 5 件以上 かつ 2位の2倍以上。曖昧なら候補ボタンだけ出して人に選ばせる
      const clearWinner = cands[0].count >= 5 && (cands.length < 2 || cands[0].count >= cands[1].count * 2);
      if (autoApply && clearWinner && !document.getElementById('rk-genre').value.trim()) {
        await applyGenre(cands[0].genreId, 'ai');
      }
      box.replaceChildren();
      const lbl = document.createElement('span');
      lbl.className = 'muted';
      lbl.textContent = 'AI提案: ';
      box.appendChild(lbl);
      cands.forEach((c) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn btn-sm';
        b.style.cssText = 'margin:2px 4px 2px 0; font-size:11px;';
        b.textContent = c.path + ' (' + c.count + '件)';
        b.addEventListener('click', () => applyGenre(c.genreId, 'ai'));
        box.appendChild(b);
      });
    } catch (e) { box.textContent = '通信エラー: ' + e.message; }
  }
  // 初期値: ジャンルが空なら AI が自動で入れる
  if (!document.getElementById('rk-genre').value.trim()) suggestGenre(true);

  // ─── 店舗内カテゴリ: パスからツリーを組んで表示 (RMS のカテゴリ選択相当) ───
  (function buildShopCategoryTree() {
    const dataEl = document.getElementById('rk-cats-data');
    const holder = document.getElementById('rk-cats');
    if (!dataEl || !holder) return;
    let rows = [];
    try { rows = JSON.parse(dataEl.textContent); } catch (e) { rows = []; }
    // path を ' > ' で割ってツリー構造にする。実在する行 (id あり) だけ checkbox
    const root = { children: new Map(), row: null, name: '' };
    for (const r of rows) {
      const segs = String(r.path).split(' > ');
      let node = root;
      for (const seg of segs) {
        if (!node.children.has(seg)) node.children.set(seg, { children: new Map(), row: null, name: seg });
        node = node.children.get(seg);
      }
      node.row = r;
    }
    function renderNode(node, fullPath) {
      const wrap = document.createElement('div');
      wrap.className = 'rk-cat-node';
      wrap.dataset.path = fullPath.toLowerCase();
      const head = document.createElement('div');
      head.className = 'rk-cat-row';
      head.style.cssText = 'display:flex; align-items:center; gap:4px; padding:2px 0;';
      const hasKids = node.children.size > 0;
      const arrow = document.createElement('span');
      arrow.textContent = hasKids ? '>' : '・';
      arrow.style.cssText = 'width:14px; color:#94a3b8; cursor:' + (hasKids ? 'pointer' : 'default') + '; display:inline-block; transition:transform .15s;';
      head.appendChild(arrow);
      let box = null;
      const toggle = () => {
        if (!box) return;
        const open = box.style.display !== 'none';
        box.style.display = open ? 'none' : 'block';
        arrow.style.transform = open ? '' : 'rotate(90deg)';
      };
      if (node.row) {
        const label = document.createElement('label');
        label.style.cssText = 'font-size:13px; font-weight:400; cursor:pointer; display:inline-flex; align-items:center; gap:4px; margin:0;';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'rk-cat-check';
        cb.value = String(node.row.id);
        cb.checked = !!node.row.selected;
        cb.style.width = 'auto';
        label.appendChild(cb);
        label.appendChild(document.createTextNode(node.name + (node.row.inactive ? ' (現在の一覧に無いカテゴリ)' : '')));
        head.appendChild(label);
      } else {
        const span = document.createElement('span');
        span.textContent = node.name;
        span.style.cssText = 'font-size:13px; cursor:' + (hasKids ? 'pointer' : 'default') + ';';
        span.addEventListener('click', toggle);
        head.appendChild(span);
      }
      wrap.appendChild(head);
      if (hasKids) {
        box = document.createElement('div');
        box.style.cssText = 'margin-left:16px; display:none;';
        for (const child of node.children.values()) {
          box.appendChild(renderNode(child, fullPath ? fullPath + ' > ' + child.name : child.name));
        }
        wrap.appendChild(box);
        arrow.addEventListener('click', toggle);
      }
      return wrap;
    }
    holder.replaceChildren();
    for (const child of root.children.values()) {
      holder.appendChild(renderNode(child, child.name));
    }
    // 選択済みノードが見えるように、そこまでの枝を開く
    holder.querySelectorAll('.rk-cat-check').forEach((cb) => {
      if (!cb.checked) return;
      let el = cb.closest('.rk-cat-node');
      while (el && el.parentElement && el.parentElement !== holder) {
        const p = el.parentElement;
        if (p.style && p.style.display === 'none') p.style.display = 'block';
        el = p;
      }
    });
  })();

  // ─── ジャンル情報を取得 (Genre API) → 必須属性の行を自動生成 ───
  function addAttrRow(name, value, meta) {
    const tr = document.createElement('tr');
    const hint = meta
      ? [meta.mandatory ? '必須' : null, meta.inputMethod === 'SELECTIVE' ? '選択式' : null,
         meta.unit ? '単位:' + meta.unit : null, meta.maxLength ? '〜' + meta.maxLength + '文字' : null]
          .filter(Boolean).join(' / ')
      : '';
    tr.innerHTML = '<td><input type="text" class="rk-attr-name">'
      + (hint ? '<div class="muted" style="font-size:11px;"></div>' : '') + '</td>'
      + '<td><input type="text" class="rk-attr-value"></td>'
      + '<td><button type="button" class="btn btn-sm rk-attr-del">×</button></td>';
    tr.querySelector('.rk-attr-name').value = name || '';
    tr.querySelector('.rk-attr-value').value = value || '';
    if (hint) tr.querySelector('td div').textContent = hint;
    if (meta && meta.mandatory) tr.querySelector('.rk-attr-name').style.borderColor = '#fca5a5';
    document.querySelector('#rk-attrs tbody').appendChild(tr);
    return tr;
  }

  document.getElementById('rk-genre-fetch').addEventListener('click', async () => {
    const genreId = document.getElementById('rk-genre').value.trim();
    const info = document.getElementById('rk-genre-info');
    if (!genreId) { info.textContent = 'ジャンルIDを入力してください'; return; }
    const btn = document.getElementById('rk-genre-fetch');
    btn.disabled = true;
    info.textContent = '取得中…';
    try {
      const res = await fetch('/apps/product-hub/api/rakuten/genre-attributes?genre_id=' + encodeURIComponent(genreId));
      const j = await res.json();
      // 取得中に別のジャンルIDへ書き換えられていたら、この応答は捨てる
      // (古いジャンルの必須行が現在のフォームへ混入するのを防ぐ — Codex R1 Medium-3)
      if (document.getElementById('rk-genre').value.trim() !== genreId) return;
      if (!j.ok) { info.textContent = '❌ ' + (j.error || '取得に失敗しました'); return; }
      const g = j.genre;
      const mandatory = (g.attributes || []).filter((a) => a.mandatory);
      info.innerHTML = '';
      const ok = document.createElement('span');
      ok.style.color = '#166534';
      ok.textContent = '✅ ' + (g.genrePath || g.genreName || genreId);
      const mut = document.createElement('span');
      mut.className = 'muted';
      mut.textContent = ' (必須属性 ' + mandatory.length + ' 件)';
      info.appendChild(ok); info.appendChild(mut);

      // 既存行の属性名を集め、無い必須属性だけ行を足す (人の入力は消さない)
      const present = new Set();
      document.querySelectorAll('#rk-attrs tbody tr').forEach((tr) => {
        const n = tr.querySelector('.rk-attr-name').value.trim();
        if (n) present.add(n);
        // 空行 (name も value も空) は整理して詰める
        if (!n && !tr.querySelector('.rk-attr-value').value.trim()) tr.remove();
      });
      let added = 0;
      for (const a of mandatory) {
        if (present.has(a.name)) continue;
        if (a.name === 'カタログID') continue; // JAN欄から自動送信される (footnote 参照)
        addAttrRow(a.name, '', a);
        added += 1;
      }
      if ((g.attributes || []).some((a) => a.name === 'カタログID')) {
        const note = document.createElement('div');
        note.className = 'muted';
        note.style.fontSize = '11px';
        note.textContent = 'ℹ️ このジャンルはカタログIDが属性にあります。JAN欄の値が自動で送られます。';
        info.appendChild(note);
      }
      if (added > 0) rkResult.textContent = '必須属性 ' + added + ' 行を追加しました。値を埋めて「出品情報を保存」してください';
    } catch (e) {
      info.textContent = '通信エラー: ' + e.message;
    } finally { btn.disabled = false; }
  });

  document.getElementById('rk-attr-add').addEventListener('click', () => {
    const tr = document.createElement('tr');
    tr.innerHTML = '<td><input type="text" class="rk-attr-name"></td>'
      + '<td><input type="text" class="rk-attr-value"></td>'
      + '<td><button type="button" class="btn btn-sm rk-attr-del">×</button></td>';
    document.querySelector('#rk-attrs tbody').appendChild(tr);
  });
  document.getElementById('rk-attrs').addEventListener('click', (ev) => {
    const del = ev.target.closest && ev.target.closest('.rk-attr-del');
    if (del) del.closest('tr').remove();
  });

  function collectRakutenFields() {
    const attrs = [];
    document.querySelectorAll('#rk-attrs tbody tr').forEach((tr) => {
      attrs.push({
        name: tr.querySelector('.rk-attr-name').value,
        value: tr.querySelector('.rk-attr-value').value,
      });
    });
    return {
      genre_id: document.getElementById('rk-genre').value,
      article_number: document.getElementById('rk-article').value,
      attributes: attrs,
      shop_category_ids: Array.from(document.querySelectorAll('.rk-cat-check:checked')).map((c) => Number(c.value)),
      shipping_method_group: document.getElementById('rk-shipping-group').value,
      postage_included: document.getElementById('rk-postage').value,
      normal_delivery_date_id: document.getElementById('rk-delivery-date').value,
      white_bg_url: document.getElementById('rk-whitebg').value,
    };
  }

  // 公開 / 非公開の切り替え (アプリから登録した商品のみ)
  const rkPublishBtn = document.getElementById('rk-publish-btn');
  if (rkPublishBtn) {
    rkPublishBtn.addEventListener('click', async () => {
      if (!confirm('楽天で公開します。売り場に表示されるようになります。\n\nよろしいですか?')) return;
      rkPublishBtn.disabled = true;
      try {
        const json = await post(BASE + '/rakuten/visibility', { hide: false, confirm: true });
        if (json.ok) { rkResult.textContent = '🟢 公開しました'; setTimeout(() => location.reload(), 1000); }
        else { alert(json.error || '公開に失敗しました'); }
      } finally { rkPublishBtn.disabled = false; }
    });
  }
  const rkUnpublishBtn = document.getElementById('rk-unpublish-btn');
  if (rkUnpublishBtn) {
    rkUnpublishBtn.addEventListener('click', async () => {
      if (!confirm('楽天の売り場から下げて非公開 (倉庫指定) に戻します。\n\nよろしいですか?')) return;
      rkUnpublishBtn.disabled = true;
      try {
        const json = await post(BASE + '/rakuten/visibility', { hide: true, confirm: true });
        if (json.ok) { rkResult.textContent = '非公開に戻しました'; setTimeout(() => location.reload(), 1000); }
        else { alert(json.error || '切り替えに失敗しました'); }
      } finally { rkUnpublishBtn.disabled = false; }
    });
  }

  // 店舗内カテゴリの絞り込み (選択済みは常に表示)
  // ツリー版の絞り込み: パスが一致するノード (とその子孫) を表示し、枝を開く。
  // 選択済み (checked) は常に残す。空にしたら全て畳んだ初期状態に近い表示へ戻す
  const rkCatFilter = document.getElementById('rk-cat-filter');
  if (rkCatFilter) {
    rkCatFilter.addEventListener('input', () => {
      const q = rkCatFilter.value.trim().toLowerCase();
      document.querySelectorAll('#rk-cats .rk-cat-node').forEach((node) => {
        const path = node.dataset.path || '';
        const hasChecked = !!node.querySelector('.rk-cat-check:checked');
        const hit = !q || path.includes(q) || hasChecked;
        // 子孫に一致があれば自分も表示 (枝として必要)
        const descendantHit = q && [...node.querySelectorAll('.rk-cat-node')].some((d) => (d.dataset.path || '').includes(q));
        node.style.display = (hit || descendantHit) ? '' : 'none';
        // 絞り込み中は一致枝を開く
        const box = [...node.children].find((el) => el.tagName === 'DIV' && el !== node.firstElementChild);
        if (box && q && (hit || descendantHit)) box.style.display = 'block';
      });
    });
  }

  async function saveRakutenFields() {
    const json = await post(BASE + '/rakuten', collectRakutenFields());
    if (!json.ok) { alert(json.error || '保存に失敗しました'); return false; }
    return true;
  }

  document.getElementById('rk-save-btn').addEventListener('click', async () => {
    if (await saveRakutenFields()) { rkResult.textContent = '保存しました'; }
  });

  document.getElementById('rk-images-btn').addEventListener('click', async () => {
    const btn = document.getElementById('rk-images-btn');
    btn.disabled = true;
    rkResult.textContent = '画像を転送中… (Drive → R-Cabinet)';
    try {
      const json = await post(BASE + '/rakuten/transfer-images');
      if (json.error) { rkResult.textContent = ''; alert(json.error); return; }
      const failed = (json.results || []).filter((r) => r.outcome === 'failed');
      rkResult.textContent = '転送 ' + (json.uploaded || 0) + ' 件 / 済み '
        + (json.results || []).filter((r) => r.outcome === 'already').length + ' 件 / 失敗 ' + failed.length + ' 件';
      if (failed.length > 0) {
        alert('転送に失敗した画像があります:\n' + failed.map((f) => '・' + (f.error || '')).join('\n')
          + '\n\nDriveの画像フォルダがサービスアカウントに共有されているか確認してください。');
      } else {
        setTimeout(() => location.reload(), 900);
      }
    } finally { btn.disabled = false; }
  });

  document.getElementById('rk-preview-btn').addEventListener('click', async () => {
    if (!(await saveRakutenFields())) return;
    const res = await fetch(BASE + '/rakuten/preview');
    const json = await res.json();
    const pre = document.getElementById('rk-preview');
    pre.style.display = 'block';
    if (!json.ok) {
      pre.textContent = 'まだ送信できません:\n' + (json.reasons || []).map((r) => '・' + r).join('\n');
      return;
    }
    const cats = json.shopCategories || [];
    pre.textContent = '商品管理番号: ' + json.manageNumber
      + (cats.length ? '\n店舗内カテゴリ (公開時にRMS画面で設定 — payloadには含まれません): ' + cats.join(' ／ ') : '')
      + '\n\n' + JSON.stringify(json.payload, null, 2);
  });

  document.getElementById('rk-register-btn').addEventListener('click', async () => {
    if (!(await saveRakutenFields())) return;
    if (!confirm('楽天に「非公開 (倉庫指定)」で登録します。\n売り場には表示されません。公開はRMS画面で行います。\n\nよろしいですか?')) return;
    const btn = document.getElementById('rk-register-btn');
    btn.disabled = true;
    rkResult.textContent = '楽天に登録中…';
    try {
      const json = await post(BASE + '/rakuten/register', { confirm: true });
      if (json.ok) {
        rkResult.textContent = '✅ 非公開で登録しました';
        setTimeout(() => location.reload(), 1200);
      } else {
        rkResult.textContent = '';
        const pre = document.getElementById('rk-preview');
        pre.style.display = 'block';
        pre.textContent = '❌ RMSエラー:\n' + (json.error || (json.reasons || []).join('\n'));
      }
    } finally { btn.disabled = false; }
  });

  // SKU をバリエーションから外す / 戻す (委譲。表は再描画されるため)
  document.addEventListener('click', async (ev) => {
    const ex = ev.target.closest && ev.target.closest('.exclude-sku-btn');
    const re = ev.target.closest && ev.target.closest('.restore-sku-btn');
    if (!ex && !re) return;
    const btn = ex || re;
    const code = btn.getAttribute('data-code');
    if (ex && !confirm(code + ' をこのページのバリエーションから外します。\n\n別ページにしたい場合は、後でこのコードで新規登録してください。')) return;
    btn.disabled = true;
    const json = await post(BASE + '/variation/' + (ex ? 'exclude' : 'restore'), { ne_code: code });
    if (json.ok) { location.reload(); } else { alert(json.error || '操作に失敗しました'); btn.disabled = false; }
  });

  // 子SKUのドラフトを代表商品コードにまとめる。
  // 画面に出した from/to をサーバーへ送り、実行時の再計算と一致した場合だけ適用させる
  const regroupBtn = document.getElementById('regroup-btn');
  if (regroupBtn) {
    regroupBtn.addEventListener('click', async () => {
      const from = regroupBtn.getAttribute('data-from');
      const to = regroupBtn.getAttribute('data-to');
      if (!confirm('このドラフトの商品コードを「' + from + '」から代表商品コード「' + to + '」に変更します。\n\nよろしいですか?')) return;
      regroupBtn.disabled = true;
      const json = await post(BASE + '/regroup', { expected_from: from, expected_to: to });
      if (json.ok) { location.reload(); } else { alert(json.error || 'まとめられませんでした'); regroupBtn.disabled = false; }
    });
  }

  // 取り込みテストデータの掃除 (取り込み由来のみ。Notion 側のカードには触らない)
  const deleteDraftBtn = document.getElementById('delete-draft-btn');
  if (deleteDraftBtn) {
    deleteDraftBtn.addEventListener('click', async () => {
      if (!confirm('この取り込みドラフトをアプリから削除します。\nNotion側のカードは削除されません。\n\nよろしいですか?')) return;
      const json = await post(BASE + '/delete');
      if (json.ok) {
        location.href = '/apps/product-hub';
      } else {
        alert(json.error || '削除に失敗しました');
      }
    });
  }

  document.getElementById('save-yahoo-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/yahoo', {
      yahoo_price: document.getElementById('y-price').value,
      yahoo_price_sagawa: document.getElementById('y-price-sagawa').value,
      delivery_label: document.getElementById('y-delivery').value,
      tax_rate: document.getElementById('y-tax').value,
      yahoo_category_id: document.getElementById('y-category-id').value,
      yahoo_path: document.getElementById('y-path').value,
    }), 'Yahoo!項目を保存しました');
  });

  const saveIpBtn = document.getElementById('save-ip-btn');
  if (saveIpBtn) {
    saveIpBtn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/image-production', {
        status: document.getElementById('ip-status').value,
        importance_tier: document.getElementById('ip-tier').value,
        production_type: document.getElementById('ip-type').value,
        aplus_content: document.getElementById('ip-aplus').value,
        aplus_related: document.getElementById('ip-aplus-related').value,
        camera_instruction_url: document.getElementById('ip-camera-url').value,
        shipping_status: document.getElementById('ip-shipping').value,
        reference_collection: document.getElementById('ip-refcol').value,
        designer: document.getElementById('ip-designer').value,
        page_composer: document.getElementById('ip-composer').value,
        request_text: document.getElementById('ip-request').value,
      }), '画像制作情報を保存しました');
    });
  }

  document.getElementById('add-ref-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/refs', { url: document.getElementById('new-ref-url').value }), '追加しました');
  });
  document.querySelectorAll('.del-ref-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/refs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-image-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/images', { url: document.getElementById('new-image-url').value }), '追加しました');
  });
  document.querySelectorAll('.del-image-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/images/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('add-spec-btn').addEventListener('click', async () => {
    showAndReload(await post(BASE + '/specs', {
      spec_key: document.getElementById('new-spec-key').value,
      spec_value: document.getElementById('new-spec-value').value,
    }), '追加しました');
  });
  document.querySelectorAll('.del-spec-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      showAndReload(await post(BASE + '/specs/' + btn.dataset.id + '/delete'), '削除しました');
    });
  });

  document.getElementById('save-ai-btn').addEventListener('click', async () => {
    const areas = document.querySelectorAll('.ai-output');
    for (const ta of areas) {
      const json = await post(BASE + '/ai-outputs', { kind: ta.dataset.kind, content: ta.value });
      if (!json.ok) { alert('保存失敗 (' + ta.dataset.kind + '): ' + (json.error || '')); return; }
    }
    result.textContent = '保存しました';
    setTimeout(() => location.reload(), 600);
  });
</script>
