  <!-- ═══ タブ5: カテゴリ・属性 ═══ -->
  <div class="tab-panel" id="tab-category">
  <div class="card">
    <h2>🗂 カテゴリ・属性 <span class="muted" style="font-weight:400">(楽天RMSの商品編集画面と同じ項目名・同じ並びにしています)</span></h2>

    <%# 他社の商品ページから調べる (2026-09-04 中原さん要望)。ジャンルIDの入力より前に置く —
        「似た商品がどのジャンルで出しているか」を見てから決めるのが実際の順番 %>
    <div class="field">
        <label>他社の商品ページからジャンルIDを調べる<span class="ftag ftag-m">手入力</span></label>
        <div style="display:flex; gap:6px;">
          <input type="url" id="rk-genre-url" placeholder="https://item.rakuten.co.jp/店舗コード/商品管理番号/" style="flex:1;">
          <button type="button" class="btn btn-sm" id="rk-genre-url-btn" style="white-space:nowrap;">🔎 調べる</button>
        </div>
        <div class="muted" style="font-size:11px;">楽天で似た商品を探して、その商品ページのURLを貼ってください。その商品が登録しているジャンルIDを読み取ります。</div>
        <div id="rk-genre-url-result" style="font-size:12px; margin-top:4px;"></div>
    </div>

    <div class="field">
        <label class="req">ジャンルID (楽天)<span class="ftag ftag-ai">AI</span><span class="ftag ftag-m">手入力</span></label>
        <div style="display:flex; gap:6px;">
          <input type="text" id="rk-genre" inputmode="numeric" value="<%= rakuten?.genre_id || '' %>" placeholder="AIが自動で提案します" style="flex:1;">
          <button type="button" class="btn btn-sm" id="rk-genre-tree" style="white-space:nowrap;">🌲 ツリーから選ぶ</button>
          <button type="button" class="btn btn-sm" id="rk-genre-fetch" style="white-space:nowrap;">ジャンル情報を取得</button>
        </div>
        <div id="rk-genre-suggest" style="font-size:12px; margin-top:4px;"></div>
        <div id="rk-genre-info" style="font-size:12px; margin-top:4px;">
          <% if (genreDict) { %>
            <span style="color:#166534;">✅ <%= genreDict.genrePath || genreDict.genreName %></span>
            <span class="muted">(必須属性 <%= genreDict.attributes.filter((a) => a.mandatory).length %> 件 / 辞書取得済み)</span>
          <% } else { %>
            <span class="muted">辞書未取得 — 取得すると必須属性の行が自動で並び、登録前にチェックされます</span>
          <% } %>
        </div>
    </div>

    <%# バリエーション — RMS の「バリエーション」(項目と選択肢) に対応 (2026-09-02 カラバリ出品)。
        項目名 = variantSelectors[].displayName。選択肢は SKU ごとに基本情報タブの SKU 表で入力する %>
    <%
      const isVariationPage = variation && variation.kind === 'variation' && variation.memberCount > 1;
      const exReason = rakuten && rakuten.catalog_id_exemption_reason != null
        ? Number(rakuten.catalog_id_exemption_reason) : null;
      // RMS 画面と同じ並び。6 (頒布会商品) は RMS の選択肢に出ないので載せない
      const exOptions = [
        [1, '1: セット商品 (未対応 — 構成品のJAN一覧が要ります)'],
        [2, '2: サービス商品'],
        [3, '3: 店舗オリジナル商品'],
        [4, '4: 項目選択肢在庫商品'],
        [5, '5: 該当製品コードなし'],
      ];
    %>
    <% if (isVariationPage) { %>
      <div class="field">
        <label>バリエーション <span class="muted">(RMSの「バリエーション」。項目名をここに、選択肢は基本情報タブのSKU表で)</span><span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="rk-variant-selector" maxlength="50" style="max-width:280px;"
               value="<%= rakuten?.variant_selector_name || '' %>" placeholder="項目名 (例: カラー・種類)">
        <p class="muted" style="margin:4px 0 0; font-size:11px;">
          このページは <%= variation.memberCount %> SKU のバリエーションページとして登録されます。
        </p>
      </div>
    <% } %>

    <%# ─── カタログID・商品仕様 (2026-09-03 中原さん: RMS の商品編集画面と同じ「SKU 列 × 項目行」の表。
        SKU ごとに IDあり/IDなし を選べ、代表カラーやメーカー型番など SKU で違う値を入れられる。
        単品は列が 1 つ (この商品) で同じ見た目にして、初めて見た人でも迷わないようにする。
        バリエーション: セルは入力欄を離れたら即保存 (/sku-attributes, /sku-jans, /sku-catalog-exemptions)。
        単品: 従来どおり「カテゴリ・属性を保存」で保存 (#rk-attrs / #f-jan / #rk-article の配線は不変)。
        🚨 2026-09-02 まで、カタログID (API の articleNumber) にメーカー型番を送っていて IE0228 で登録が落ちていた ─── %>
    <%
      // メーカー型番 (旧データが属性側に残っている場合の引き上げ・競合表示。単品用)
      let rkAttrsRaw = [];
      try { rkAttrsRaw = JSON.parse(rakuten?.attributes_json || '[]'); } catch (e) { rkAttrsRaw = []; }
      // 旧形式 {name, value} も拾う (Codex R3 high): 取りこぼすとサーバは 400 なのに画面に値が出ない
      const legacyModels = [...new Set(rkAttrsRaw
        .filter((a) => a && a.name === modelAttrName)
        .flatMap((a) => (Array.isArray(a.values) ? a.values : (a.value !== undefined ? [a.value] : [])))
        .map((v) => String(v == null ? '' : v).trim())
        .filter(Boolean))];
      const legacyModel = legacyModels.length === 1 ? legacyModels[0] : '';
      const modelConflict = legacyModels.length > 1
        || (legacyModels.length === 1 && rakuten?.article_number && rakuten.article_number !== legacyModels[0]);
      // 欄が空で属性側に 1 つだけ = 引き上げ表示。人がその値を見ているので解消フラグを立てておく
      // (Codex R4 high: 立てないと、書き換えて保存 → 400 なのに解消ボタンが出ていない、で詰む)
      const modelAutoResolve = !modelConflict && legacyModels.length === 1 && !rakuten?.article_number;
      const modelDict = genreDict ? genreDict.attributes.find((d) => d.name === modelAttrName) : null;
      const dictOf = (name) => (genreDict && name ? genreDict.attributes.find((d) => d.name === name) : null);
      const hintOf = (da) => (da
        ? [da.mandatory ? '必須' : null, da.inputMethod === 'SELECTIVE' ? '選択式' : null,
           da.unit ? '単位:' + da.unit : null, da.maxLength ? '〜' + da.maxLength + '文字' : null]
          .filter(Boolean).join(' / ')
        : '');
      // バリエーションの表: 行 = 辞書の必須属性 (カタログIDは専用行) + 値が入っている項目 (skuAttributeGrid)
      const gridData = locals.skuAttrGrid || { names: [], bySku: {} };
      const gridExemptions = locals.skuExemptions || {};
      const gridNames = [];
      if (genreDict) for (const d of genreDict.attributes) if (d.mandatory && d.name !== 'カタログID' && !gridNames.includes(d.name)) gridNames.push(d.name);
      for (const n of gridData.names) if (!gridNames.includes(n)) gridNames.push(n);
      const skuKeyOf = (m) => String(m.商品コード || '').trim().toLowerCase();
    %>
    <label>カタログID・商品仕様 <span class="muted">(RMSの「製品情報」と同じ表。列 = <%= isVariationPage ? 'SKU' : 'この商品' %>、行 = 項目。「ジャンル情報を取得」で必須の行が自動で並びます。<span style="color:#dc2626">*必須</span> / 選択式は「ジャンル情報を取得」を押すと楽天の選択肢から選べます。選択肢が出ない項目はRMSと同じ表記で)</span><span class="ftag ftag-auto">自動</span><span class="ftag ftag-m">手入力</span></label>
    <% if (isVariationPage) { %>
      <p class="muted" style="margin:0 0 6px; font-size:12px;">
        入力欄を離れると<strong>即保存</strong>。「一括入力」で全SKUに同じ値を入れられます。JANが無いSKUは「IDなし」を選んで理由を選択。
      </p>
      <% if ((gridData.legacyCatalogIds || []).length > 0) { %>
        <%# 旧データ (2026-09-02 までの単品の属性行) の「カタログID」。SKU 表では JAN の専用行が入口なので展開せず、
            人が確認して削除する (Codex R3 high: 展開すると全 SKU で出品が止まり、画面から消せなかった) %>
        <div class="banner-warn" id="rk-legacy-catalog" style="font-size:12px; margin-bottom:6px;">
          ⚠️ 旧データの商品仕様に「カタログID」(<%= gridData.legacyCatalogIds.join(' / ') %>) が残っています。
          JAN は下の表の「カタログID」の行に SKU ごとに入れる方式になりました。各 SKU の JAN を確認してから削除してください (削除するまで出品は止まります)。
          <div style="margin-top:6px;"><button type="button" class="btn btn-sm" id="rk-legacy-catalog-drop">旧データの「カタログID」属性を削除する</button></div>
        </div>
      <% } %>
      <div style="overflow-x:auto; border:1px solid #e2e8f0; border-radius:8px; margin-bottom:8px; background:#fff;">
        <table class="list sku-grid" id="rk-sku-grid" style="margin:0; width:max-content; min-width:100%;">
          <thead><tr>
            <th class="sku-grid-head">項目</th>
            <% for (const m of variation.members) { const k = skuKeyOf(m); %>
              <th><code style="font-size:12px"><%= m.商品コード %></code><br>
                <span class="muted" style="font-weight:400; font-size:11px;"><%= rakuten?.variant_selector_name || '種類' %>: <%= skuSelectorValues[k] || '(未設定 — 基本情報タブのSKU表で)' %></span></th>
            <% } %>
          </tr></thead>
          <tbody>
            <tr class="sku-grid-catalog">
              <th class="sku-grid-head">
                <div>カタログID <span style="color:#dc2626">*必須</span></div>
                <div class="muted" style="font-size:11px; font-weight:400;">JAN (8/12/13桁)。無ければ「IDなし」+ 理由</div>
              </th>
              <% for (const [mi, m] of variation.members.entries()) { const k = skuKeyOf(m); const jan = skuJans[k] || ''; const ex = gridExemptions[k] != null ? Number(gridExemptions[k]) : null; %>
