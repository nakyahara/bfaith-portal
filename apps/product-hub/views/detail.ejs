  // サーバー拒否 (ok:false) だけ DB の値へ巻き戻す。失敗は drain 実行の結果として flush に伝わる
  function createSkuSaver({ inputs, send, label }) {
    const list = [];
    const lastOf = new Map();
    const uncertain = new Set();
    const result = document.getElementById('rk-result');
    let draining = null;   // 実行中の drain (Promise<boolean> = その実行の開始以降に失敗が無かったか)
    let rerun = false;     // drain 中に change が来た印 (終わる直前の取りこぼし防止)
    function register(input) {
      list.push(input);
      lastOf.set(input, input.value.trim());
      input.addEventListener('change', () => { skuSaveGeneration += 1; drain(); });
    }
    // 戻り値: 'ok' = 保存した / 'rejected' = サーバーが拒否 (DB は旧値のまま) / 'unknown' = DB の値が不明 (drain を止める)
    async function saveOne(input) {
      const value = input.value.trim();
      if (value === lastOf.get(input) && !uncertain.has(input)) return 'ok';
      let json;
      try {
        json = await send(input, value);
      } catch (e) {
        uncertain.add(input);
        alert('通信エラーで' + label + 'を保存できませんでした (' + input.dataset.code + ')。もう一度お試しください');
        return 'unknown';
      }
      if (!json.ok) {
        if (uncertain.has(input)) {
          alert((json.error || label + 'の保存に失敗しました') + ' — 直前の保存結果が不明なため、ページを再読み込みして値を確認してください');
          return 'unknown';
        }
        alert(json.error || label + 'の保存に失敗しました');
        // 後続の変更値を潰さない: 表示が失敗した値のままのときだけ DB の値へ巻き戻す (バッジも追従)
        if (input.value.trim() === value) {
          input.value = lastOf.get(input);
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
        return 'rejected';
      }
      uncertain.delete(input);
      lastOf.set(input, value);
      if (result) result.textContent = label + 'を保存しました (' + input.dataset.code + (value ? ' = ' + value : ' 解除') + ')';
      return 'ok';
    }
    const dirtyInputs = () => list.filter((i) => uncertain.has(i) || i.value.trim() !== lastOf.get(i));
    function drain() {
      if (draining) { rerun = true; return draining; }
      draining = (async () => {
        let ok = true;
        do {
          rerun = false;
          // 拒否は巻き戻すので通常 1〜2 周で収束する。上限は保存が拒否され続けるときの安全弁
          for (let round = 0; round < 10; round++) {
            const dirty = dirtyInputs();
            if (dirty.length === 0) break;
            for (const input of dirty) {
              const r = await saveOne(input);
              if (r === 'unknown') return false; // 結果不明: dirty を残したまま止める (連打再送しない)
              if (r === 'rejected') ok = false;
            }
          }
        } while (rerun);
        return ok;
      })().finally(() => { draining = null; });
      return draining;
    }
    const saver = {
      register,
      isDirty: () => dirtyInputs().length > 0,
      // 一括入力など別経路で保存済みにした値を「DB の値」として覚える
      markSaved(input, value) { uncertain.delete(input); lastOf.set(input, value); },
      // 別経路の保存が結果不明 (通信エラー) になった入力: 次の change / flush で現在値を再送する
      markUncertain(input) { uncertain.add(input); },
      // プレビュー・登録・出品情報保存の前に呼ばれる。(合流した) drain の開始以降に 1 件でも失敗していたら /
      // まだ DB と違う入力が残っていたら false
      async flush() {
        const ok = await drain();
        return ok && dirtyInputs().length === 0;
      },
    };
    (inputs || []).forEach(register);
    skuSavers.push(saver);
    return saver;
  }
  // 全ワーカーを通した安定状態まで待つ (Codex R1 high: Promise.all 一発だと、先に終わったワーカーへ
  // 待機中に入った変更を待たずに登録へ進める)。変更の無い一巡が取れたら true
  // 同時に始まった flush (二重クリック等) は同じ実行を共有し同じ結果を返す (Codex R4 high: skuOpFailed を
  // 片方だけが消費して、もう片方が true で保存へ進んでいた)。終わった後の新しい flush だけが再試行
  let flushInFlight = null;
  function flushSkuSavers() {
    if (flushInFlight) return flushInFlight;
    flushInFlight = flushSkuSaversOnce().finally(() => { flushInFlight = null; });
    return flushInFlight;
  }
  async function flushSkuSaversOnce() {
    for (let i = 0; i < 10; i++) {
      const gen = skuSaveGeneration;
      // ワーカー外の保存 (一括入力・行削除) が走っていれば先に終わるのを待つ
      if (skuPendingOps.size > 0) await Promise.allSettled([...skuPendingOps]);
      // 待った保存が拒否/例外で終わっていたら、この flush は失敗 (1 回限り。次の明示的な flush で再試行できる)
      if (skuOpFailed) { skuOpFailed = false; return false; }
      const ok = (await Promise.all(skuSavers.map((s) => s.flush()))).every(Boolean);
      if (!ok) return false;
      if (gen === skuSaveGeneration && skuPendingOps.size === 0 && skuSavers.every((s) => !s.isDirty())) return true;
    }
    return false;
  }
  // ワーカー外の保存 (一括入力・行削除) を flush の待ち対象にする。開始・終了で世代を進め、
  // 拒否 (ok:false) や例外は skuOpFailed に残す (Codex R3 medium: 完了だけ待つと拒否された一括操作でも成功扱いになる)
  function trackSkuOp(promise) {
    const tracked = promise.then(
      (json) => { if (!json || json.ok === false) skuOpFailed = true; return json; },
      (err) => { skuOpFailed = true; throw err; });
    skuPendingOps.add(tracked);
    skuSaveGeneration += 1;
    tracked.finally(() => { skuPendingOps.delete(tracked); skuSaveGeneration += 1; }).catch(() => {});
    return tracked;
  }

  // ─── SKU別JAN (2026-08-28 中原さん要望)。入力欄を離れたら即保存 ───
  (function initSkuJans() {
    const inputs = [...document.querySelectorAll('.sku-jan-input')];
    if (inputs.length === 0) return;
    createSkuSaver({
