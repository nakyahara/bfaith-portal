            <option value="日本製" <%= pageInfo?.origin_type === '日本製' ? 'selected' : '' %>>日本製</option>
            <option value="海外製" <%= pageInfo?.origin_type === '海外製' ? 'selected' : '' %>>海外製</option>
          </select>
          <input type="text" id="pi-origin-country" style="flex:1;" placeholder="海外製のとき原産国名 (健康食品は必須)" value="<%= pageInfo?.origin_country || '' %>">
        </div>
      </div>
      <div class="field" id="pi-f-seller">
        <label id="pi-l-seller">発売元 (メーカー名/販売業者名)<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-seller" value="<%= pageInfo?.seller_name || '' %>" placeholder="例: 株式会社アメージングクラフト">
      </div>
      <div class="field" id="pi-f-importer">
        <label id="pi-l-importer">輸入者名 <span class="muted">(輸入品はメーカー名と両記載が楽天必須)</span><span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-importer" value="<%= pageInfo?.importer_name || '' %>">
      </div>
      <%# ブランド名 (2026-08-28 中原さん要望)。掲載HTMLの表に「ブランド名」行として載る %>
      <div class="field" id="pi-f-brand">
        <label id="pi-l-brand">ブランド名<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-brand" value="<%= pageInfo?.brand_name || '' %>" placeholder="例: B-Faith">
      </div>
      <%# 内容量 = 容量 (ml / g)。2026-08-28 中原さん要望で雑貨でも常時表示にした %>
      <div class="field" id="pi-f-volume">
        <label id="pi-l-volume">内容量・容量 <span class="muted">(ml / g など)</span><span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-volume" value="<%= pageInfo?.content_volume || '' %>" placeholder="例: 50ml / 200g">
      </div>
      <div class="field" id="pi-f-size">
        <label id="pi-l-size">サイズ<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-size" value="<%= pageInfo?.size_text || '' %>" placeholder="例: 縦5cm×横10cm×高さ15cm">
      </div>
      <div class="field" id="pi-f-ingredients">
        <label id="pi-l-ingredients">成分・素材・材質<span class="ftag ftag-m">手入力</span> <span class="muted">(化粧品は全成分。食品は原材料名欄へ)</span></label>
        <textarea id="pi-ingredients" rows="3"><%= pageInfo?.ingredients || '' %></textarea>
      </div>
      <div class="field" id="pi-f-usage">
        <label id="pi-l-usage">使用上の注意<span class="ftag ftag-m">手入力</span></label>
        <textarea id="pi-usage" rows="3"><%= pageInfo?.usage_notes || '' %></textarea>
      </div>
    </div>
    <div id="pi-food-fields" class="grid-2" style="display:none; background:#fef9ec; border-radius:8px; padding:8px 12px; margin-bottom:8px;">
      <div class="field">
        <label id="pi-l-food-name">名称 (食品表示)<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-food-name" value="<%= pageInfo?.food_name || '' %>" placeholder="例: 有機亜麻仁シード">
      </div>
      <div class="field">
        <label id="pi-l-food-ingredients">原材料名 (食品表示)<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-food-ingredients" value="<%= pageInfo?.food_ingredients || '' %>" placeholder="例: 有機アマニ (アルゼンチン産)">
      </div>
      <div class="field">
        <label id="pi-l-food-expiry">賞味期限<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-food-expiry" value="<%= pageInfo?.food_expiry || '' %>" placeholder="例: 商品ラベルに記載">
      </div>
      <div class="field">
        <label id="pi-l-food-storage">保存方法<span class="ftag ftag-m">手入力</span></label>
        <input type="text" id="pi-food-storage" value="<%= pageInfo?.food_storage || '' %>" placeholder="例: 直射日光を避け常温保存">
      </div>
    </div>
    <p class="muted" style="font-size:12px; margin:4px 0 10px;">
      広告文責<span class="ftag ftag-auto">自動</span>: <%- adResponsibilityText %> ／
      発送方法<span class="ftag ftag-auto">自動</span>: <%= neShipping.label ? (neShipping.label + (neShipping.guessed ? ' (NE配送方法から推測)' : ' (マッピング表)')) : '未割当 — 一覧画面の配送方法マッピングで設定' %> ／
      注意事項<span class="ftag ftag-auto">自動</span>: 固定文
    </p>
