  // 文字数カウンタ (全AI項目)。上限があるもの (楽天タイトル128 / Yahoo!タイトル65 / キャッチコピー30)
  // は「n / 上限文字」+ 超過で赤。上限なしの素材 (特徴・仕様・注意書き) は「n文字」の単純カウント
  document.querySelectorAll('.ai-output').forEach((ta) => {
    const max = ta.dataset.max ? Number(ta.dataset.max) : null;
    const lenEl = document.querySelector('.ai-len[data-for="' + ta.dataset.kind + '"]');
    const update = () => {
      const n = ta.value.length;
      if (lenEl) {
        lenEl.textContent = max ? (n + ' / ' + max + '文字') : (n + '文字');
        lenEl.style.color = max && n > max ? '#dc2626' : '';
        lenEl.style.fontWeight = max && n > max ? '700' : '';
      }
      ta.style.borderColor = max && n > max ? '#dc2626' : '';
    };
    ta.addEventListener('input', update);
    update();
  });

  // 初期表示のバッジ計算 (initPageInfo 内の applyTypeVisibility でも一度呼ばれるが、
  // pi-type が無い画面状態でも必ず一度は計算しておく)
  updateTabBadges();
  // 属性の候補ボタン (2026-08-31)。ジャンル辞書が取得済みなら開いた時点で並ぶ
  renderAttrSuggest();

  // ─── 工程パネル (誰のボールか) ───
  // 変更したその場で保存する。保存ボタン方式だと「状態だけ変えて押し忘れ」が起き、
  // ボードに古い状態が出続けるため。押し間違いは選び直せば戻せる
  (function initWorkflowPanel() {
    const card = document.getElementById('wf-card');
    if (!card) return;
    const out = document.getElementById('wf-result');
    let advanced = false;

    async function save(tr, patch) {
      const step = tr.dataset.step;
      out.textContent = '保存中…';
      try {
        // 画面を開いた時点の updated_at を一緒に送る = 古い画面からの後勝ちをサーバーが弾ける
        const body = Object.assign({ expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }, patch);
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/steps/' + encodeURIComponent(step), {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const j = await res.json();
        if (!j.ok) {
          out.textContent = '';
          alert(j.error || '保存に失敗しました');
          // 409 = 別の人が先に動かした。古い画面のまま操作を続けさせない
          if (res.status === 409) location.reload();
          return false;
        }
        // 連続で操作できるよう、次の楽観ロック用に最新の updated_at を持ち直す
        if (j.version != null) tr.dataset.version = String(j.version);
        out.textContent = '保存しました';
        return j;
      } catch (e) {
        out.textContent = '';
        alert('通信エラー: ' + e.message);
        return false;
      }
    }

    // ─── セット展開判断のダイアログ (2026-09-04) ───
    const decModal = document.getElementById('setdec-modal');
    let decRow = null;
    function decChoice() {
      const el = decModal ? decModal.querySelector('input[name="setdec"]:checked') : null;
      return el ? el.value : 'none';
    }
    function decSync() {
      if (!decModal) return;
      const v = decChoice();
      const noneBox = document.getElementById('setdec-none-box');
      const exBox = document.getElementById('setdec-existing-box');
      const holdBox = document.getElementById('setdec-hold-box');
      if (noneBox) noneBox.hidden = v !== 'none';
      if (exBox) exBox.hidden = v !== 'existing';
      if (holdBox) holdBox.hidden = v !== 'hold';
      const rt = document.getElementById('setdec-reason-text');
      const reason = document.getElementById('setdec-reason');
      if (rt && reason) rt.hidden = !(v === 'none' && reason.value === 'other');
    }
    function openSetDecision(tr) {
      if (!decModal) return;
      decRow = tr;
      document.getElementById('setdec-result').textContent = '';
      decSync();
      decModal.style.display = 'block';
    }
    function closeSetDecision() { if (decModal) decModal.style.display = 'none'; }
    if (decModal) {
      decModal.querySelectorAll('input[name="setdec"]').forEach((el) => el.addEventListener('change', decSync));
      const reason = document.getElementById('setdec-reason');
      if (reason) reason.addEventListener('change', decSync);
      document.getElementById('setdec-close').addEventListener('click', closeSetDecision);
      document.getElementById('setdec-cancel').addEventListener('click', closeSetDecision);
      decModal.addEventListener('click', (ev) => { if (ev.target === decModal) closeSetDecision(); });
      document.getElementById('setdec-apply').addEventListener('click', async () => {
        if (!decRow) return;
        const btn = document.getElementById('setdec-apply');
        const res = document.getElementById('setdec-result');
        const v = decChoice();
        const body = {
          decision: v,
          // 工程の版数を一緒に送る = 古い画面からの後勝ちをサーバーが弾く
          expected_version: decRow.dataset.version === '' ? null : Number(decRow.dataset.version),
        };
        if (v === 'none') {
          body.reason_code = document.getElementById('setdec-reason').value;
          body.reason_text = document.getElementById('setdec-reason-text').value.trim();
          if (body.reason_code === 'other' && !body.reason_text) { res.textContent = '「その他」を選んだときは一言書いてください'; return; }
        } else if (v === 'existing') {
          const sel = document.getElementById('setdec-linked');
          if (!sel || !sel.value) { res.textContent = '紐づけるセットを選んでください'; return; }
          body.linked_set_draft_id = Number(sel.value);
        } else if (v === 'hold') {
          body.reason_text = document.getElementById('setdec-hold-note').value.trim();
        }
        btn.disabled = true;
        res.textContent = '記録中…';
        try {
          const r = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-decision', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          });
          const j = await r.json();
          if (!j.ok) {
            res.textContent = '';
            alert(j.error || '記録できませんでした');
            // 409 = 別の人が先に動かした。古い画面のまま操作を続けさせない
            if (r.status === 409) location.reload();
            return;
          }
          location.reload();
        } catch (e) {
          res.textContent = '';
          alert('通信エラー: ' + e.message);
        } finally { btn.disabled = false; }
      });
    }

    card.querySelectorAll('tr[data-step]').forEach(function (tr) {
      const state = tr.querySelector('.wf-state');
      const assignee = tr.querySelector('.wf-assignee');
      const due = tr.querySelector('.wf-due');
      const note = tr.querySelector('.wf-note');
      if (state) {
        state.addEventListener('change', async function () {
          // 「セット展開判断」は判断を記録してからでないと閉じられない (2026-09-04)。
          // ここで捕まえて判断ダイアログを開く (記録できたら工程もサーバー側で閉じる)
          if (tr.dataset.step === 'set_review' && state.value === 'done') {
            state.value = tr.dataset.prevState || 'todo';
            openSetDecision(tr);
            return;
          }
          const r = await save(tr, { state: state.value });
          // 完了で次の工程へボールが移る・工程からステータスが導出し直される (PR4) と
          // 上部の表示が変わるので読み直す。連続で複数工程を片付けたい場合もあるので、
          // 少し待ってから 1 回だけ
          const statusChanged = r && r.draftStatus && r.draftStatus !== '<%= draft.status %>';
          if (r && (state.value === 'done' || statusChanged) && !advanced) {
            advanced = true;
            setTimeout(function () { location.reload(); }, 900);
          }
        });
      }
      if (assignee) {
        assignee.addEventListener('change', function () { save(tr, { assignee_id: assignee.value }); });
      }
      // 未割り当ての工程を自分で引き受ける (admin 以外はこのボタンだけ)
      const claim = tr.querySelector('.wf-claim');
      if (claim) {
        claim.addEventListener('click', async function () {
          claim.disabled = true;
          const ok = await save(tr, { assignee_id: <%= myStaffId == null ? 'null' : myStaffId %> });
          if (ok) location.reload(); else claim.disabled = false;
        });
      }
      if (due) due.addEventListener('change', function () { save(tr, { due_date: due.value }); });
      if (note) note.addEventListener('change', function () { save(tr, { note: note.value }); });
    });

    // 「詳細画像は対象外」トグル (商品単位のフラグ。工程行は書き換えない)
    const exBtn = document.getElementById('wf-detail-excluded');
    if (exBtn) {
      exBtn.addEventListener('click', async function () {
        const next = exBtn.dataset.next === 'true';
        if (next && !confirm('この商品は詳細画像を作らない (TOP画像だけで出品ゲートを開く) 設定にします。よろしいですか?')) return;
        exBtn.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/detail-images-excluded', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ excluded: next }),
          });
          const j = await res.json();
          if (!j.ok) { alert(j.error || '切り替えに失敗しました'); exBtn.disabled = false; return; }
          location.reload();
        } catch (e) { alert('通信エラー: ' + e.message); exBtn.disabled = false; }
      });
    }

    // ─── モール別の展開状況 ───
    const mlOut = document.getElementById('ml-result');
    async function saveMall(tr, patch) {
      const mall = tr.dataset.mall;
      mlOut.textContent = '保存中…';
      try {
        const body = Object.assign(
          { expected_version: tr.dataset.version === '' ? null : Number(tr.dataset.version) }, patch);
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/malls/' + encodeURIComponent(mall), {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const j = await res.json();
        if (!j.ok) {
          mlOut.textContent = '';
          alert(j.error || '保存に失敗しました');
          if (res.status === 409) location.reload();
          return false;
        }
        if (j.version != null) tr.dataset.version = String(j.version);
        mlOut.textContent = '保存しました';
        // 全モールが決着すると工程「出品・展開」が閉じる → 上部の表示が変わるので読み直す
        if (j.listingCompleted) setTimeout(function () { location.reload(); }, 900);
        return true;
      } catch (e) {
        mlOut.textContent = '';
        alert('通信エラー: ' + e.message);
        return false;
      }
    }
    document.querySelectorAll('tr[data-mall]').forEach(function (tr) {
      const st = tr.querySelector('.ml-state');
      const asg = tr.querySelector('.ml-assignee');
      const note = tr.querySelector('.ml-note');
      const claim = tr.querySelector('.ml-claim');
      if (st) st.addEventListener('change', function () { saveMall(tr, { state: st.value }); });
      if (asg) asg.addEventListener('change', function () { saveMall(tr, { assignee_id: asg.value }); });
      if (note) note.addEventListener('change', function () { saveMall(tr, { note: note.value }); });
      if (claim) {
        claim.addEventListener('click', async function () {
          claim.disabled = true;
          const ok = await saveMall(tr, { assignee_id: <%= myStaffId == null ? 'null' : myStaffId %> });
          if (ok) location.reload(); else claim.disabled = false;
        });
      }
    });

    // ─── セット商品 ───
    // 構成は複数行 (§5.6)。行 = 商品コード × 個数。既定は「この商品 × 2」
    const setMembersBox = document.getElementById('set-members');
    function addMemberRow(code, qty) {
      if (!setMembersBox) return;
      const row = document.createElement('div');
      row.className = 'set-member-row';
      row.style.cssText = 'display:flex; gap:6px; align-items:center;';
      const codeInput = document.createElement('input');
      codeInput.type = 'text';
      codeInput.className = 'set-member-code';
      codeInput.setAttribute('list', 'set-member-codes');
      codeInput.placeholder = '商品コード';
      codeInput.maxLength = 100;
      codeInput.value = code || '';
      codeInput.style.cssText = 'flex:1; min-width:160px;';
      const qtyInput = document.createElement('input');
      qtyInput.type = 'number';
      qtyInput.className = 'set-member-qty';
      qtyInput.min = '1';
      qtyInput.max = '999';
      qtyInput.value = String(qty || 1);
      qtyInput.style.cssText = 'flex:0 0 80px;';
      const unit = document.createElement('span');
      unit.className = 'muted';
      unit.style.cssText = 'font-size:12px;';
      unit.textContent = '個';
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn-sm';
      del.textContent = '✕';
      del.title = 'この行を消す';
      // 最後の1行は消せない (構成が空のセットは作れない)。消せるかは押した時点で数える
      del.addEventListener('click', function () {
        if (setMembersBox.querySelectorAll('.set-member-row').length <= 1) return;
        row.remove();
      });
      row.appendChild(codeInput);
      row.appendChild(qtyInput);
      row.appendChild(unit);
      row.appendChild(del);
      setMembersBox.appendChild(row);
    }
    /** 開いた時点の初期状態: 「この商品 × 2」の1行 + 「行を追加」の配線 */
    function initSetMembers(parentCode) {
      if (!setMembersBox) return;
      addMemberRow(parentCode, 2);
      const addBtn = document.getElementById('set-member-add');
      if (addBtn) addBtn.addEventListener('click', function () { addMemberRow('', 1); });
    }
    /** 画面の行 → API に送る構成。空行は落とす (人が行を足して埋めなかった場合) */
    function readSetMembers() {
      if (!setMembersBox) return [];
      const out = [];
      const rows = setMembersBox.querySelectorAll('.set-member-row');
      for (const r of rows) {
        const code = (r.querySelector('.set-member-code').value || '').trim();
        const qty = Number(r.querySelector('.set-member-qty').value);
        if (!code) continue;
        out.push({ ne_code: code, qty: qty });
      }
      return out;
    }
    <%# ここまでが smoke の切り出し範囲 (EJS の埋め込みを混ぜない — 素の JS として動かすため)。
        HTMLエスケープした値を JS 文字列に入れない (Codex low): `'` を含む商品コードが
        `&#39;` という別のコードになって単価が引けなくなる。JSON で埋めて `<` だけ潰す %>
    initSetMembers(<%- JSON.stringify(draft.ne_code || '').replace(/</g, '\\u003c') %>);

    async function createSet(mode) {
      const out = document.getElementById('set-create-result');
      const members = readSetMembers();
      if (members.length === 0) { out.textContent = '構成を1行以上入れてください'; return; }
      // 個数はサーバーでも弾くが、押した瞬間に理由が出るほうが直しやすい
      const badQty = members.find(function (m) { return !Number.isInteger(m.qty) || m.qty < 1 || m.qty > 999; });
      if (badQty) { out.textContent = '「' + badQty.ne_code + '」の個数を 1〜999 で入れてください'; return; }
      const label = mode === 'ai' ? 'AIに書き換えてもらう' : 'コピーしてすぐ直す';
      const compo = members.map(function (m) { return m.ne_code + '×' + m.qty; }).join(' + ');
      if (!confirm('この商品からセット商品を作ります (' + label + ')。\n構成: ' + compo
        + '\n商品コードは仮コードになります。\n\nよろしいですか?')) return;
      const btns = [document.getElementById('set-ai-btn'), document.getElementById('set-copy-btn')];
      btns.forEach(function (b) { b.disabled = true; });
      out.textContent = '作成中…';
      try {
        const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-drafts', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: mode, name: document.getElementById('set-name').value,
            members: members,
            // 親の「セット商品作成検討」を閉じる操作なので、その工程の版数を添える
            parent_step_version: <%= (workflow.main.find((s) => s.step_code === 'set_review') || {}).version %>,
          }),
        });
        const j = await res.json();
        if (!j.ok) { out.textContent = ''; alert(j.error || '作成に失敗しました'); btns.forEach(function (b) { b.disabled = false; }); return; }
        out.textContent = j.neCode + ' を作りました。開きます…';
        setTimeout(function () { location.href = '/apps/product-hub/detail/' + j.draftId; }, 800);
      } catch (e) {
        out.textContent = '';
        alert('通信エラー: ' + e.message);
        btns.forEach(function (b) { b.disabled = false; });
      }
    }
    const setAiBtn = document.getElementById('set-ai-btn');
    if (setAiBtn) setAiBtn.addEventListener('click', function () { createSet('ai'); });
    const setCopyBtn = document.getElementById('set-copy-btn');
    if (setCopyBtn) setCopyBtn.addEventListener('click', function () { createSet('copy'); });

    // 仮コード → 本コードの差し替え
    const setCodeBtn = document.getElementById('set-code-btn');
    if (setCodeBtn) {
      setCodeBtn.addEventListener('click', async function () {
        const out = document.getElementById('set-code-result');
        const code = document.getElementById('set-code-input').value.trim();
        if (!code) { out.textContent = '商品コードを入れてください'; return; }
        setCodeBtn.disabled = true;
        out.textContent = '差し替え中…';
        async function post(confirmFlag) {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-code', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ne_code: code, confirm: confirmFlag === true }),
          });
          return { status: res.status, json: await res.json() };
        }
        try {
          const r = await post(false);
          if (!r.json.ok) { out.textContent = ''; alert(r.json.error || '差し替えに失敗しました'); setCodeBtn.disabled = false; return; }
          // NE に見つからないコードでも差し替えは通す。ただし出品ゲートは閉じたままなので、
          // その旨をはっきり伝える (黙って通すと「出せるはず」と思われる)
          if (r.json.inNe === false) {
            alert('差し替えました。ただしNE商品マスタにまだ見つかりません。'
              + '\n取り込まれるまで楽天には出品できません (この画面を開いたときに自動で解除されます)。');
          }
          out.textContent = '差し替えました';
          setTimeout(function () { location.reload(); }, 800);
        } catch (e) {
          out.textContent = '';
          alert('通信エラー: ' + e.message);
          setCodeBtn.disabled = false;
        }
      });
    }

    // 画像の引き継ぎ計画 (§4.7)。表の行をまとめて置き換える
    const sipSave = document.getElementById('sip-save');
    if (sipSave) {
      sipSave.addEventListener('click', async function () {
        const out = document.getElementById('sip-result');
        const items = [...document.querySelectorAll('#set-image-plan tbody tr')].map(function (tr) {
          return {
            slot: Number(tr.dataset.slot),
            action: tr.querySelector('.sip-action').value,
            instruction: tr.querySelector('.sip-instruction').value.trim(),
          };
        });
        sipSave.disabled = true;
        out.textContent = '保存中…';
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/set-image-plan', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items }),
          });
          const j = await res.json();
          if (!j.ok) { out.textContent = ''; alert(j.error || '保存できませんでした'); sipSave.disabled = false; return; }
          out.textContent = '保存しました';
          setTimeout(function () { location.reload(); }, 600);
        } catch (e) {
          out.textContent = ''; alert('通信エラー: ' + e.message); sipSave.disabled = false;
        }
      });
    }

    // 配送方法: NE の候補を1クリックで入れる (2026-09-05)。押すまでは未選択のまま
    const shipUseNe = document.getElementById('rk-ship-use-ne');
    if (shipUseNe) {
      shipUseNe.addEventListener('click', function () {
        const sel = document.getElementById('rk-shipping-group');
        if (!sel) return;
        sel.value = shipUseNe.dataset.group || '';
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }

    // NE登録の進み (§4.3)。「依頼した」「登録できなかった (理由)」「再要求」
    document.querySelectorAll('.ne-state-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        const state = btn.dataset.state;
        let reason = null;
        if (state === 'needs_action') {
          reason = prompt('登録できなかった理由を入れてください（例: 商品コードが重複していた）');
          if (reason === null) return;
          if (!reason.trim()) { alert('理由を入れてください'); return; }
        }
        btn.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/ne-registration', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ state: state, reason: reason }),
          });
          const j = await res.json();
          if (j.ok) location.reload();
          else { alert(j.error || '更新できませんでした'); btn.disabled = false; }
        } catch (e) { alert('通信エラー: ' + e.message); btn.disabled = false; }
      });
    });

    // 親の更新を確認した (§4.5)。覚え直すだけ — セットには自動で反映しない
    const parentAck = document.getElementById('parent-ack-btn');
    if (parentAck) {
      parentAck.addEventListener('click', async function () {
        parentAck.disabled = true;
        try {
          const res = await fetch('/apps/product-hub/api/drafts/<%= draft.id %>/parent-snapshot-ack', { method: 'POST' });
          const j = await res.json();
          if (j.ok) location.reload();
          else { alert(j.error || '更新できませんでした'); parentAck.disabled = false; }
        } catch (e) { alert('通信エラー: ' + e.message); parentAck.disabled = false; }
      });
    }
  })();
</script>
