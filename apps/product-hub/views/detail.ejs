  <% if (draft.own_brand && adKeywords) { %>
  <!-- ═══ タブ6: SP広告 検索KW (2026-09-23 PR1・『Amazon_SP広告KW自動生成_設計方針_20260922.md』§5) ═══
       サジェスト収集 (miniPC 経由・種 1 つずつ同期) → 観測語の採否 → マッチタイプ別コピー。
       AI 提案・ABA・除外KW・商品ターゲットは後続 PR。Amazon (Ads API) には書き込まない。
       画面は adkw-json の状態から JS が描く (収集のたびに state を受け取って描き直す。ページは読み直さない) -->
  <div class="tab-panel" id="tab-adkw">
    <div class="card" style="border-color:#fde68a; background:#fffdf5;">
      <h2>📣 SP広告 検索キーワード — サジェスト収集・採用支援</h2>
      <p class="muted" style="margin-top:-6px;">
        頭で考えた種キーワードを入れると、Amazon の検索ボックスに出るサジェスト (そのまま + あ〜わ) を会社の回線 (miniPC) から集めます。
        出てきた語を人が採用・保留・却下し、採用した語をマッチタイプ別にコピーして、Amazon の広告画面に<strong>手で</strong>貼ります。<br>
        🚨 ここから Amazon に登録はされません (「コピー済み」は「Amazon 登録済み」ではありません)。
        競合 ASIN は ABA から自動で出す (最初から採用・要らないものを却下) か、人が入れます (商品ターゲットの候補)。その ASIN が<strong>クリック上位 3 商品に入った検索語</strong>を、miniPC に取込済みの週の ABA (Amazon ブランド分析) から引けます (該当なし ≠ 注文なし)。
        「🌙 おまかせ」= 自社商品は、夜に AI が Amazon のタイトルから種キーワードを考え、サジェストと ABA を集め、案まで自動で作ります (1 晩 3 商品・新しい商品から。人は朝に採否を決めてコピーするだけ)。「🤖 AI の案 (夜間)」= 自分で集めた材料をもとに、夜間に AI が検索キーワードの案を出します (未採用で並ぶ・観測は未確認)。除外キーワードはまだありません (次の段階)。自社広告のクリック・注文・ACOS は未取得です。
      </p>
      <script type="application/json" id="adkw-json"><%- JSON.stringify({ draftId: draft.id, state: adKeywords }).replace(/</g, '\\u003c') %></script>
      <div id="adkw-root"><span class="muted">読み込み中…</span></div>
    </div>
  </div>
  <script>
  // SP広告KW タブ。状態 (adkw-json) から DOM を組む。innerHTML に文字列を流さない (候補の語は外部由来)
  (function initAdKeywords() {
    const boot = document.getElementById('adkw-json');
    const root = document.getElementById('adkw-root');
    if (!boot || !root) return;
    let draftId = null, state = null;
    try { const j = JSON.parse(boot.textContent); draftId = j.draftId; state = j.state; } catch (e) { state = null; }
    if (!state) { root.textContent = '状態を読めませんでした。ページを読み直してください'; return; }
    const API = '/apps/product-hub/api/drafts/' + draftId + '/ad-keywords';
    // 依頼の冪等キー = 「新しい依頼を作る」1 回の意図ごとに 1 つ。通信に失敗して再送しても同じ依頼になる。
    // 依頼ができたら捨てる (取消・置き換えのあとに同じキーを送ると、閉じた依頼に当たって詰まる)
    let pendingKey = null;
    const newKey = () => (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.random().toString(36).slice(2));
    let busy = false;
    // 世代 = この画面で状態を変えた回数。遅れて届いた応答 (古い GET・古い収集) で新しい状態を巻き戻さないための番号
    let gen = 0;
    // 依頼の切替世代 = 置き換え・取消・(別画面での切替を GET で知った) の回数。切替前に送った採否・固定・収集の応答は、
    // 届いても捨てる (旧依頼の応答が gen を進めて、切替後の GET を無効にしないため。R4 #2)
    let reqGen = 0;
    // 保存中の候補 (id)。GET で描き直されても「保存中」のまま出し、応答はいま表示している行に反映する (R3 #3)
    const inflight = new Map();
    const rowOf = (cid) => root.querySelector('tr[data-cid="' + cid + '"]');
    const rerow = (cand) => { const row = rowOf(cand.id); if (row) row.replaceWith(candidateRow(cand)); };

    // throw しない (通信断でも {ok:false} を返す。呼び手は finally で欄を戻し、refresh で保存結果を確かめる)
    async function api(path, body) {
      let res;
      try {
        res = await fetch(API + path, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}),
        });
      } catch (e) {
        return { ok: false, network: true, error: '通信できません (' + (e && e.message ? e.message : e) + ')。サーバーには届いているかもしれないので、画面を読み直して確かめてください' };
      }
      let json = null;
      try { json = await res.json(); } catch (e) { json = null; }
      // ヘッダーは来たが本文を読めなかった = サーバーでは処理済みかもしれない「結果不明」(通信断と同じ扱い。R3 #4)
      if (!json) return { ok: false, network: true, error: 'サーバーの応答を読めません (HTTP ' + res.status + ')。届いているかもしれないので、画面を読み直して確かめてください' };
      return json;
    }
    // 状態を取り直す。取りに行っている間にこの画面で状態が変わった (世代が進んだ) / 収集中 なら、古い応答は捨てる
    async function refresh() {
      const myGen = gen;
      try {
        const res = await fetch(API, { headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => null);
        if (!json || !json.ok || !json.state) return false;
        if (gen !== myGen || busy) return false;   // 古い応答 (この画面が先に進んでいる) は適用しない
        // 別の画面で依頼が切り替わっていた → 切替前に送った応答をこれ以降捨てる
        const before = state.request ? state.request.id : null, after = json.state.request ? json.state.request.id : null;
        if (before !== after) reqGen += 1;
        state = json.state;
        gen += 1;   // 状態が変わった = 応答を待っている操作 (ASIN 追加・収集) は古い state を適用しない (Codex #1413 R2)
        render();
        return true;
      } catch (e) { return false; /* 通信断。次の操作か自動再取得でもう一度 */ }
    }
    // 別の画面が収集している間は 5 秒ごとに状態を取り直す (終わった・3 分過ぎた をこの画面でも検知する)。
    // 予約は 1 か所で管理し、GET が失敗しても・この画面の収集が終わっても、必要なら続ける
    let pollTimer = null;
    const collectingElsewhere = () => !!(state.request && state.request.status === 'collecting' && !state.request.collecting_stale);
    function schedulePollIfNeeded() {
      clearTimeout(pollTimer);
      if (!collectingElsewhere() || busy) return;
      pollTimer = setTimeout(async () => { await refresh(); schedulePollIfNeeded(); }, 5000);
    }
    function el(tag, attrs, children) {
      const n = document.createElement(tag);
      if (attrs) for (const k of Object.keys(attrs)) {
        if (k === 'class') n.className = attrs[k];
        else if (k === 'style') n.setAttribute('style', attrs[k]);
        else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), attrs[k]);
        else if (k === 'text') n.textContent = attrs[k];
        else if (attrs[k] === false || attrs[k] == null) { /* 付けない */ }
        else n.setAttribute(k, attrs[k] === true ? '' : attrs[k]);
      }
      for (const c of (children || [])) {
        if (c == null) continue;
        n.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
      }
      return n;
    }
    // DB の時刻は UTC (strftime 'now')。見る人の時計 (日本) に直して 分まで
    const fmtTime = (iso) => {
      const t = iso ? Date.parse(iso) : NaN;
      if (!Number.isFinite(t)) return '';
      const d = new Date(t), p = (n) => String(n).padStart(2, '0');
      return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    };
    const L = state.labels;

    function render() {
      // 入力途中の種は描き直しても消さない (別画面の収集を 5 秒ごとに確かめている間に打っていることがある)
      const prevSeed = document.getElementById('adkw-seed'), prevAlpha = document.getElementById('adkw-alpha');
      const keepSeed = prevSeed ? prevSeed.value : '', keepAlpha = prevAlpha ? prevAlpha.checked : false;
      const prevAsin = document.getElementById('adkw-asin');
      const keepAsin = prevAsin ? prevAsin.value : '';   // 入力途中の競合 ASIN も消さない
      root.textContent = '';
      const req = state.request;
      if (!state.configured) {
        root.appendChild(el('div', { class: 'muted', style: 'padding:8px 10px; border:1px solid #fecaca; background:#fef2f2; border-radius:8px; margin-bottom:10px; color:#991b1b;',
          text: 'miniPC を呼ぶ設定 (WAREHOUSE_SERVICE_TOKEN) がこのサーバーに無いため、サジェストを集められません。既に集めた候補の採否とコピーはできます。' }));
      }
      // ── おまかせ (夜の自動・PR3c)。自社商品は毎晩 AI が種 KW → サジェスト・ABA → 最終案まで作る。人は朝に採否とコピーだけ
      if (state.ai && state.ai.auto) root.appendChild(autoSection());
      // ── 依頼の状態
      const head = el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; margin-bottom:10px; font-size:13px;' });
      if (!req) {
        head.appendChild(el('span', { class: 'muted', text: (state.ai && state.ai.auto && state.ai.auto.waiting)
          ? 'まだ集めていません。夜に AI がおまかせで集めます (自分で集めるなら種キーワードを入れて「サジェストを集める」)'
          : 'まだ集めていません。種キーワードを入れて「サジェストを集める」を押してください' }));
      } else {
        head.appendChild(el('span', { text: '依頼 #' + req.id + '（' + fmtTime(req.created_at) + (req.requested_by ? '・' + req.requested_by : '') + '）' }));
        if (req.status === 'collecting' && !req.collecting_stale) {
          head.appendChild(el('span', { class: 'badge badge-ready_for_ai', text: '「' + (req.collecting_seed || '') + '」を収集中' }));
        }
        if (state.stale) {
          head.appendChild(el('span', { class: 'badge badge-excluded', text: '旧情報に基づく候補 (商品名・コード・ASIN が依頼のあとで変わりました)' }));
        }
        head.appendChild(el('button', { type: 'button', class: 'btn btn-sm', onclick: () => restart(),
          text: '🔄 新しい依頼にする', title: 'いまの候補と採否はこの依頼に残り、画面からは消えます (上書きはしません)' }));
        head.appendChild(el('button', { type: 'button', class: 'btn btn-sm btn-danger', onclick: () => cancel(), text: '取り消す' }));
      }
      root.appendChild(head);

      // ── 種の入力
      const seedInput = el('input', { type: 'text', id: 'adkw-seed', maxlength: String(state.limits.seed_max_len), placeholder: '例: ハッカ油 スプレー', style: 'flex:1; min-width:220px;', value: keepSeed });
      const alphaChk = el('input', { type: 'checkbox', id: 'adkw-alpha', style: 'width:auto;' });
      alphaChk.checked = keepAlpha;
      const collectBtn = el('button', { type: 'button', class: 'btn btn-primary', id: 'adkw-collect', text: 'サジェストを集める (約 10〜20 秒)' });
      const progress = el('span', { class: 'muted', id: 'adkw-progress' });
      const collecting = collectingElsewhere();
      if (!state.configured || collecting) collectBtn.disabled = true;
      if (collecting) progress.textContent = '別の画面で収集中です。終わるまで待ってください (5 秒ごとに確かめます)';
      schedulePollIfNeeded();
      collectBtn.addEventListener('click', () => collect(seedInput.value, alphaChk.checked, { seedInput, collectBtn, progress }));
      seedInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); collectBtn.click(); } });
      root.appendChild(el('div', { class: 'field' }, [
        el('label', { text: '種キーワード (頭で考えた語。1 つずつ・' + state.limits.seed_max_len + ' 文字まで・1 依頼 ' + state.limits.max_seeds + ' 個まで)' }),
        el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px; align-items:center;' }, [
          seedInput,
          el('label', { style: 'display:flex; align-items:center; gap:4px; font-weight:normal; white-space:nowrap;' }, [alphaChk, 'a〜z も付けて集める (+26 回)']),
          collectBtn, progress,
        ]),
      ]));

      // ── 取得範囲 (種ごと)
      if (state.seeds.length) {
        const tb = el('tbody');
        for (const s of state.seeds) {
          const badgeClass = s.status === 'success' ? 'badge-approved' : s.status === 'partial' ? 'badge-ready_for_ai' : s.status === 'failed' ? 'badge-excluded' : 'badge-on_hold';
          // 全部失敗でも取得範囲 (何回失敗・何回未実行) は隠さない。通信そのものが成立しなかったときだけ理由だけになる
          const rangeText = s.status === 'failed' ? [s.error || '取得できませんでした', s.coverage_text].filter(Boolean).join('。') : s.coverage_text;
          const withAlpha = !!(s.options && s.options.alphabet);
          const cells = [
            el('td', {}, [s.seed, withAlpha ? el('span', { class: 'muted', text: ' (a〜z 込み)' }) : null,
              s.fetch_count > 1 ? el('span', { class: 'muted', text: ' (取得 ' + s.fetch_count + ' 回)' }) : null]),
            el('td', {}, [el('span', { class: 'badge ' + badgeClass, text: s.status_ja })]),
            el('td', { class: 'muted', text: rangeText }),
            el('td', { class: 'muted', text: s.fetched_text || '—' }),
            el('td', { style: 'text-align:right;', text: String(s.candidate_count) }),
            el('td', { style: 'text-align:right;', text: String(s.new_count) }),
          ];
          const act = el('td');
          if ((s.status === 'failed' || s.status === 'partial') && state.configured && !collecting) {
            act.appendChild(el('button', { type: 'button', class: 'btn btn-sm', text: s.status === 'failed' ? 'もう一度' : '取り直す',
              title: s.status === 'failed' ? '同じ条件でもう一度集める' : '失敗・未実行が残っている分を含めて同じ条件で取り直す (取れていた語と採否はそのまま)',
              onclick: () => collect(s.seed, withAlpha, { collectBtn, progress }, s.status === 'partial') }));
          }
          cells.push(act);
          tb.appendChild(el('tr', {}, cells));
        }
        root.appendChild(el('details', { open: true, style: 'margin:10px 0;' }, [
          el('summary', { style: 'cursor:pointer; font-weight:600; font-size:13px;', text: '取得範囲 (' + state.seeds.length + ' 種)' }),
          el('div', { style: 'overflow-x:auto;' }, [el('table', { class: 'list', style: 'margin-top:6px;' }, [
            el('thead', {}, [el('tr', {}, ['種', '状態', '取得範囲 (サジェストの口を叩いた回数ごとの結果)', '出典', '観測した語', 'うち初出', ''].map((h) => el('th', { text: h })))]),
            tb,
          ])]),
        ]));
      }

      // ── 夜間 AI に検索 KW の案を頼む (PR3a)。材料 (観測語・採用語・商品情報) は依頼した時点で固定。AI の案は未採用で並ぶ
      if (req && state.ai) root.appendChild(aiSection());

      // ── 候補と採否
      if (state.candidates.length) {
        // 語は「最初に観測した種」の下に並べる (取り直しても動かない)
        const bySeed = new Map();
        for (const c of state.candidates) {
          // いま観測が無い AI の語は「AI 提案」のグループ (PR3a)。あとでサジェスト等に観測されたら、その種のグループへ (origin では決めない — Codex #1429 R1 #1)
          const key = (c.origin === 'ai' && c.observed.length === 0) ? '\u0000ai' : (c.seed || '');
          if (!bySeed.has(key)) bySeed.set(key, []);
          bySeed.get(key).push(c);
        }
        const seedOf = new Map(state.seeds.map((s) => [s.seed, s]));
        const wrap = el('div', { style: 'margin-top:10px;' });
        wrap.appendChild(el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; margin-bottom:6px;' }, [
          el('span', { id: 'adkw-count', style: 'font-weight:600; font-size:13px;', text: '候補 ' + state.candidates.length + ' 語 (採用 ' + state.adopted_count + ')' }),
          el('span', { class: 'muted', text: '並びは 種 → サジェストの出方 (そのまま → あ〜わ → a〜z) → 語。ABA の語は 競合 ASIN → 検索頻度順位。総合点は付けていません' }),
        ]));
        for (const [seedKey, list] of bySeed) {
          const s = seedOf.get(seedKey);
          // 最初の観測が ABA の語 = 「競合 ASIN の検索語」のグループ (§4.8 の文言。サジェストの文言を使い回さない)
          const isAba = !!(list[0] && list[0].first_source === 'aba');
          const abaOf = isAba ? ((state.asins || []).find((x) => x.asin === seedKey) || {}).aba : null;
          const firstObs = isAba ? (list[0].observed.find((o) => o.source === 'aba') || {}) : null;
          const tb = el('tbody');
          for (const c of list) tb.appendChild(candidateRow(c));
          const isAi = seedKey === '\u0000ai';
          wrap.appendChild(el('details', { open: true, style: 'margin:6px 0;' }, [
            el('summary', { style: 'cursor:pointer; font-size:13px;' }, isAi ? [
              el('strong', { text: '🤖 AI 提案 ' + list.length + ' 語' }),
              el('span', { class: 'muted', text: '　AI 提案。サジェスト／ABA での観測は未確認 (出したときの材料には無かった語)。理由は AI の説明で、広告成果は未検証。初期状態は未採用です' }),
            ] : isAba ? [
              el('strong', { text: '競合 ASIN「' + seedKey + '」がクリック上位 3 商品に含まれた検索語 ' + list.length + ' 語' }),
              el('span', { class: 'muted', text: '　対象週 ' + (firstObs.week_text || '不明') + (abaOf && abaOf.week_text && abaOf.week_text !== firstObs.week_text ? '（最新の取得は ' + abaOf.week_text + '）' : '')
                + '。ABA = 検索語ごとのクリック上位 3 商品とシェアであって、競合の全注文語でも広告成果でもない。順位 = 検索頻度順位 (小さいほど多く検索された)・位置 = その語のクリック上位 3 の中の順・シェア = その語のクリック / 購入に占める割合'
                + ((state.asins || []).some((x) => x.asin === seedKey && x.aba_candidate_count > list.length) ? '　(サジェストで先に出た語はその種の側に表示)' : '') }),
            ] : [
              el('strong', { text: '「' + seedKey + '」で初めて出た ' + list.length + ' 語' }),
              el('span', { class: 'muted', text: '　Amazon サジェストで観測。検索回数は不明 (取得日は各行)' + (s && s.candidate_count > list.length ? '　(別の種で先に出た ' + (s.candidate_count - list.length) + ' 語はその種の側に表示)' : '') }),
            ]),
            el('div', { style: 'overflow-x:auto;' }, [el('table', { class: 'list', style: 'margin-top:4px;' }, [
              el('thead', {}, [el('tr', {}, ['語', isAi ? 'AI の理由・根拠にした観測語' : isAba ? 'ABA の順位・位置・シェア (対象週)' : '出方', '採否 (人が決める)', '採用する語 (直せる)', '記録'].map((h) => el('th', { text: h })))]),
              tb,
            ])]),
          ]));
        }
        root.appendChild(wrap);
      } else if (req) {
        root.appendChild(el('p', { class: 'muted', text: 'まだ候補がありません (取得が 0 件だったか、失敗しています)' }));
      }

      // ── 競合 ASIN (商品ターゲット)。ABA から自動で出す (最初から採用・要らないものを人が却下) + 人の入力。PR2-C / 2026-09-23
      if (req) {
        const asins = state.asins || [];
        const asinInput = el('input', { type: 'text', id: 'adkw-asin', placeholder: '例: B0XXXXXXXX, B0YYYYYYYY (Amazon の URL でも可)', style: 'flex:1; min-width:260px;', value: keepAsin });
        const asinBtn = el('button', { type: 'button', class: 'btn', id: 'adkw-asin-add', text: '競合 ASIN を追加' });
        const asinMsg = el('span', { class: 'muted', id: 'adkw-asin-msg' });
        asinBtn.addEventListener('click', () => addAsins(asinInput, asinBtn, asinMsg));
        asinInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); asinBtn.click(); } });
        // ABA から自動で出す (2026-09-23)。採用済みの検索 KW ごとのクリック上位 3。出てきたものは「採用 (自動)」で入る → 要らないものを却下
        const autoBtn = autoAsinsButton();
        const au = state.auto_asins;
        const autoLine = el('div', { class: 'muted', id: 'adkw-auto-summary', style: 'font-size:12px;' });
        if (au) {
          autoLine.textContent = '前回の自動: ' + fmtTime(au.fetched_at || '') + '・'
            + (au.status === 'failed' ? '取れませんでした (' + (au.error || '') + ')'
              : '対象週 ' + (au.week_text || '不明') + (au.week_coverage && au.week_coverage !== 'complete' ? ' (' + (au.week_coverage_ja || au.week_coverage) + ')' : '')
                + '・語 ' + au.terms_sent + (au.terms_truncated ? ' (+' + au.terms_truncated + ' 語は上限で送らず)' : '')
                + ' → 該当あり ' + au.found + ' / 該当なし ' + au.none + (au.not_covered ? ' / 判定できない ' + au.not_covered : '')
                + '・出てきた商品 ' + au.asins_seen + ' → 採用 (自動) ' + au.added + ' 件');
        }
        const box = el('div', { style: 'margin-top:14px; padding:10px 12px; border:1px solid #e2e8f0; border-radius:8px; background:#fff;' }, [
          el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; margin-bottom:6px;' }, [
            el('strong', { style: 'font-size:13px;', text: '商品ターゲット (競合 ASIN) — ' + asins.length + ' / ' + state.limits.max_asins + ' 件' }),
            el('span', { class: 'muted', text: '「ABA から競合を自動で出す」= 採用した検索キーワードごとに、ABA (miniPC に取込済みの週) でクリック上位 3 に入った商品を集め、多く出た順に「採用 (自動)」で入れます。'
              + '要らないものは「却下」にしてください (採用しても Amazon には何も登録されません。下の本文をコピーして人が貼ります)。手で ASIN を足すこともできます。'
              + '採用した ASIN は下の本文に「商品ターゲット」として別に出ます (検索KW とは別キャンペーン)。'
              + '「競合の検索語を引く」= その ASIN がクリック上位 3 商品に入った検索語を ABA から引きます。ABA は検索語ごとのクリック上位 3 商品とシェアであって、競合の全注文語でも広告成果でもありません (該当なし ≠ 注文なし)' }),
          ]),
          el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:6px;' }, [autoBtn, autoLine]),
          el('div', { style: 'display:flex; flex-wrap:wrap; gap:8px; align-items:center;' }, [asinInput, asinBtn, asinMsg]),
        ]);
        if (asins.length) {
          const tb = el('tbody');
          for (const a of asins) tb.appendChild(asinRow(a));
          box.appendChild(el('div', { style: 'overflow-x:auto;' }, [el('table', { class: 'list', style: 'margin-top:8px;' }, [
            el('thead', {}, [el('tr', {}, ['ASIN', '出どころ・日時', 'ABA の検索語 (クリック上位 3 に入った語)', '採否 (人が決める)', '記録'].map((h) => el('th', { text: h })))]),
            tb,
          ])]));
        }
        root.appendChild(box);
      }

      // ── コピー
      root.appendChild(exportSection());
    }

    function asinRow(a) {
      const d = a.decision;
      const cur = d ? d.decision : 'undecided';
      const sel = el('select', { style: 'min-width:170px;' });
      for (const [v, t] of [['undecided', '未採用'], ['adopt', '採用 (商品ターゲットに載せる)'], ['hold', '保留'], ['reject', '却下']]) {
        sel.appendChild(el('option', { value: v, text: t, selected: v === cur }));
      }
      const autoAdopted = d && d.decision === 'adopt' && d.actor === 'auto:aba';
      const note = el('span', { class: 'muted', style: 'font-size:11px;' + (autoAdopted ? ' color:#b45309;' : ''),
        text: inflight.has(a.id) ? '保存中…' : (autoAdopted ? '自動で採用・' + fmtTime(d.created_at) + ' (要らなければ却下)'
          : (d ? (L.decision[d.decision] + '・' + fmtTime(d.created_at) + (d.actor ? '・' + d.actor : '')) : '')) });
      if (inflight.has(a.id)) sel.disabled = true;
      sel.addEventListener('change', async () => {
        if (inflight.has(a.id)) return;
        inflight.set(a.id, true);
        sel.disabled = true; note.textContent = '保存中…';
        const myReqGen = reqGen;
        let r = null;
        try { r = await api('/candidates/' + a.id + '/decisions', { decision: sel.value }); }
        finally { inflight.delete(a.id); }
        if (myReqGen !== reqGen) return;
        const cur2 = (state.asins || []).find((x) => x.id === a.id);
        if (!r || !r.ok) { alert((r && r.error) || '採否を記録できませんでした'); if (!(await refresh()) && cur2) { const row = rowOf(a.id); if (row) row.replaceWith(asinRow(cur2)); } return; }
        if (!state.request || r.decision.request_id !== state.request.id || !cur2) { await refresh(); return; }
        const dec = { id: r.decision.id, decision: r.decision.decision, keyword: r.decision.keyword, match_type: null, actor: r.decision.actor, created_at: r.decision.created_at };
        if (!cur2.decision || dec.id > cur2.decision.id) cur2.decision = dec;
        gen += 1;
        state.decision_version = Math.max(state.decision_version || 0, r.decision.id);
        state.adopted_asin_count = (state.asins || []).filter((x) => x.decision && x.decision.decision === 'adopt').length;
        const row = rowOf(a.id);
        if (row) row.replaceWith(asinRow(cur2));
        const ex = document.getElementById('adkw-export');
        if (ex) ex.replaceWith(exportSection());
        rerenderAi();
      });
      const badge = d && d.decision === 'adopt' ? 'badge-approved' : d && d.decision === 'hold' ? 'badge-on_hold' : d && d.decision === 'reject' ? 'badge-excluded' : '';
      const link = el('a', { href: 'https://www.amazon.co.jp/dp/' + encodeURIComponent(a.asin), target: '_blank', rel: 'noopener', text: '🔗', title: 'Amazon で開く', style: 'margin-left:6px;' });
      return el('tr', { 'data-cid': String(a.id) }, [
        el('td', {}, [el('span', { class: badge ? 'badge ' + badge : '', style: 'font-family:ui-monospace,Consolas,monospace;', text: a.asin }), link]),
        a.auto ? autoOriginCell(a) : el('td', { class: 'muted', text: (a.added_by || '') + (a.added_at ? '・' + fmtTime(a.added_at) : '') }),
        abaCell(a),
        el('td', {}, [sel]),
        el('td', {}, [note]),
      ]);
    }

    // ABA (競合がクリック上位 3 に入った検索語) の欄。miniPC の aba.db に取込済みの週を引くだけ (数秒)。
    // 状態 = 該当あり / 該当なし (証明つき) / 判定できない / レポート無し / 取得失敗 を混ぜない。該当なし ≠ 注文なし
    function abaCell(a) {
      const key = 'aba:' + a.id;
      const cell = el('td');
      if (inflight.has(key)) { cell.appendChild(el('span', { class: 'muted', text: 'miniPC から引いています…' })); return cell; }
      const ab = a.aba;
      const canPull = !!state.configured;
      if (!ab) {
        cell.appendChild(el('button', { type: 'button', class: 'btn btn-sm', text: '競合の検索語を引く', disabled: !canPull,
          title: canPull ? 'この ASIN がクリック上位 3 商品に入った検索語を、miniPC に取込済みの週 (ABA) から引きます (数秒)' : 'miniPC を呼ぶ設定が無いため引けません',
          onclick: () => lookupAba(a, false) }));
        return cell;
      }
      const badgeClass = ab.status === 'found' ? 'badge-approved' : ab.status === 'none' ? 'badge-on_hold' : 'badge-excluded';
      const line = el('div', { style: 'display:flex; flex-wrap:wrap; gap:4px 8px; align-items:center;' });
      line.appendChild(el('span', { class: 'badge ' + badgeClass, text: ab.status_ja }));
      const bits = [];
      if (ab.week_text) bits.push('対象週 ' + ab.week_text);
      if (ab.status === 'found') bits.push(ab.term_count + ' 語' + (ab.coverage && ab.coverage !== 'complete' ? '・' + (ab.coverage_ja || ab.coverage) : ''));
      if (ab.reason_ja && ab.status !== 'found' && ab.status !== 'none') bits.push(ab.reason_ja);
      if (ab.status === 'failed' && ab.error) bits.push(ab.error);
      if (a.aba_fetch_count > 1) bits.push('取得 ' + a.aba_fetch_count + ' 回');
      if (a.aba_previous_ok) bits.push('前の取得回は残っています');
