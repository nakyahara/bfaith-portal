  // SKU別の選択肢 (2026-09-02 カラバリ出品)。JAN欄と同じ作法: 入力即保存・POSTは1本ずつ
  (function () {
    const inputs = [...document.querySelectorAll('.sku-selector-input')];
    if (inputs.length === 0) return;
    const result = document.getElementById('rk-result');
    let saveChain = Promise.resolve();
    inputs.forEach((input) => {
      let last = input.value.trim();
      async function save(value) {
        if (value === last) return;
        let json;
        try {
          json = await post(BASE + '/sku-selector-values', { ne_code: input.dataset.code, value: value });
        } catch (e) {
          json = { ok: false, error: '通信エラーで項目選択肢を保存できませんでした' };
        }
        if (!json.ok) {
          alert(json.error || '項目選択肢の保存に失敗しました');
          // 後続の変更値を潰さない: 表示が失敗した値のままのときだけ巻き戻す
          if (input.value.trim() === value) input.value = last;
          return;
        }
        last = value;
        if (result) result.textContent = '項目選択肢を保存しました (' + input.dataset.code + (value ? ' = ' + value : ' 解除') + ')';
      }
      input.addEventListener('change', () => {
        const value = input.value.trim();
        saveChain = saveChain.then(() => save(value));
      });
    });
  })();

