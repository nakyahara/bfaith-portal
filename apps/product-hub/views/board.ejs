<%- include('_header') %>
<style>
  /* かんばん: 列 = 工程、カード = 商品。列は横スクロール、列の中は縦スクロール */
  .kb { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; align-items: flex-start; }
  .kb-col { flex: 0 0 232px; background: #eef2f7; border-radius: 10px; padding: 8px; }
  .kb-col.system { background: #f1f5f9; border: 1px dashed #cbd5e1; }
  .kb-col-head { display: flex; align-items: baseline; gap: 6px; padding: 2px 4px 8px; }
  .kb-col-title { font-size: 13px; font-weight: 700; }
  .kb-col-count { font-size: 12px; color: #64748b; }
  .kb-col-role { font-size: 11px; color: #94a3b8; padding: 0 4px 6px; }
  .kb-body { max-height: 62vh; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
  .kb-card { display: block; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
             padding: 8px; text-decoration: none; color: #1f2430; }
  .kb-card:hover { border-color: #93c5fd; box-shadow: 0 1px 4px rgba(15,23,42,.08); }
  .kb-card.stalled { border-color: #fca5a5; background: #fff7f7; }
  /* D&D: カード = 掴んで列間を移動できる。リンク部分は中身だけ */
  .kb-card[draggable="true"] { cursor: grab; }
  .kb-card.dragging { opacity: .45; }
  .kb-card-link { display: block; text-decoration: none; color: inherit; }
  .kb-col.drop-ok { outline: 2px dashed #2563eb; outline-offset: -2px; background: #eff6ff; }
  /* TOP画像の重要度 (どれぐらい力を入れて作るか)。Notion のタグ風に色を付ける */
  .kb-priority { width: 100%; margin-top: 6px; font-size: 11px; border-radius: 6px;
                 border: 1px solid #e2e8f0; padding: 3px 4px; background: #f8fafc; color: #475569; }
  .kb-card-top { display: flex; gap: 7px; }
  .kb-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 5px; border: 1px solid #e2e8f0;
              background: #f8fafc; flex: 0 0 auto; }
  .kb-name { font-size: 12px; font-weight: 600; line-height: 1.35; overflow: hidden;
             display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .kb-code { font-family: ui-monospace, Consolas, monospace; font-size: 10px; color: #94a3b8; }
  .kb-meta { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; margin-top: 6px; font-size: 11px; }
  .kb-assignee { display: inline-flex; align-items: center; gap: 4px; color: #475569; }
  .kb-unassigned { color: #b45309; font-weight: 600; }
  .kb-stall { color: #b91c1c; font-weight: 700; }
  .kb-kind { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 4px; }
  .kb-kind.top { background: #dbeafe; color: #1d4ed8; }
  .kb-kind.detail { background: #ede9fe; color: #6d28d9; }
  /* 画像ビュー: TOP画像/商品詳細画像をパッと見で判別 (2026-08-24 中原さん要望)。
     カード上部の帯 + 左ボーダー + 地色で、列を眺めるだけで種別が分かるようにする */
  .kb-card.kind-top { border-left: 4px solid #3b82f6; background: #f8fbff; }
  .kb-card.kind-detail { border-left: 4px solid #8b5cf6; background: #fdfbff; }
  .kb-kindband { display: block; font-size: 11px; font-weight: 700; padding: 2px 8px;
                 border-radius: 4px; margin-bottom: 6px; }
  .kb-kindband.top { background: #dbeafe; color: #1d4ed8; }
  .kb-kindband.detail { background: #ede9fe; color: #6d28d9; }
  .kb-malls { display: flex; align-items: center; gap: 2px; margin-top: 5px; }
  .mall-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #e2e8f0; }
  .mall-dot.mall-done { background: #16a34a; }
  .mall-dot.mall-doing { background: #f59e0b; }
  .mall-dot.mall-skip { background: #cbd5e1; opacity: .5; }
  .mini { font-size: 10px; color: #94a3b8; margin-left: 3px; }
  .kb-progress { height: 3px; background: #e2e8f0; border-radius: 999px; margin-top: 6px; overflow: hidden; }
  .kb-progress > i { display: block; height: 100%; background: #60a5fa; }
  .kb-empty { font-size: 11px; color: #94a3b8; text-align: center; padding: 10px 0; }
  .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
  .chip { display: inline-block; border: 1px solid #cbd5e1; background: #fff; border-radius: 999px;
          padding: 4px 12px; font-size: 12px; text-decoration: none; color: #475569; }
  .chip.on { background: #2563eb; border-color: #2563eb; color: #fff; font-weight: 600; }
  /* ビュー切替タブ: ボードは 1 枚で「見る軸」だけを変える (本流の工程 / 画像の工程) */
  .kb-tabs { display: inline-flex; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; }
  .kb-tab { padding: 5px 14px; font-size: 12px; text-decoration: none; color: #475569; background: #fff; }
  .kb-tab.on { background: #1d4ed8; color: #fff; font-weight: 700; }
  /* 画像トラックのミニステッパー (依頼→制作→登録→承認)。カードに常時出す = 2重管理をなくす */
  .kb-imgtracks { margin-top: 6px; display: flex; flex-direction: column; gap: 2px; font-size: 10px; }
  .kb-krow { display: flex; align-items: center; gap: 4px; color: #64748b; }
  .kb-krow .kb-kname { flex: 0 0 26px; font-weight: 700; }
  .kb-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #e2e8f0; }
  .kb-dot.done { background: #16a34a; }
  .kb-dot.doing { background: #f59e0b; }
  .kb-klabel { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .kb-klabel.done { color: #166534; font-weight: 600; }
  .kb-klabel.excluded { color: #94a3b8; }
  .kb-kstall { color: #b91c1c; font-weight: 700; }
</style>

<%
  // フィルタとタブの URL。切り替えても他の条件 (担当者・未割り当て・ビュー・種別) を失わない
  const boardUrl = (over = {}) => {
    const p = new URLSearchParams();
    const v = over.view !== undefined ? over.view : boardView;
    if (v === 'image') p.set('view', 'image');
    const a = over.assignee !== undefined ? over.assignee : assigneeParam;
    if (a) p.set('assignee', a);
    const f = over.filter !== undefined ? over.filter : (unassignedOnly ? 'unassigned' : '');
    if (f) p.set('filter', f);
    // 種別 (TOP画像/商品詳細画像) は画像ビューだけの条件。本流へ切り替えたら落とす
    const k = over.kind !== undefined ? over.kind : (imageKind || '');
    if (k && v === 'image') p.set('kind', k);
    const s = p.toString();
    return '/apps/product-hub/board' + (s ? '?' + s : '');
  };
%>

<div class="wrap wide">
  <div class="filters">
    <span style="font-size:15px; font-weight:700;">🔁 工程ボード</span>
    <span class="kb-tabs">
      <a class="kb-tab <%= boardView !== 'image' ? 'on' : '' %>" href="<%= boardUrl({ view: 'main' }) %>">本流で並べる</a>
      <a class="kb-tab <%= boardView === 'image' ? 'on' : '' %>" href="<%= boardUrl({ view: 'image' }) %>">🖼 画像で並べる</a>
    </span>
    <a class="chip <%= !assigneeParam && !unassignedOnly ? 'on' : '' %>" href="<%= boardUrl({ assignee: '', filter: '' }) %>">すべて</a>
    <% if (me) { %>
      <a class="chip <%= assigneeParam === 'me' ? 'on' : '' %>" href="<%= boardUrl({ assignee: 'me', filter: '' }) %>">
        自分のボール (<%= me.name %>)
      </a>
    <% } %>
    <a class="chip <%= unassignedOnly ? 'on' : '' %>" href="<%= boardUrl({ assignee: '', filter: 'unassigned' }) %>">未割り当て</a>
    <% if (boardView === 'image') { %>
      <%# 種別の絞り込み (2026-08-24 中原さん要望)。担当者の絞り込みとは独立に効く %>
      <span style="border-left:1px solid #e2e8f0; align-self:stretch;"></span>
      <a class="chip <%= !imageKind ? 'on' : '' %>" href="<%= boardUrl({ kind: '' }) %>">両方</a>
      <a class="chip <%= imageKind === 'top' ? 'on' : '' %>" href="<%= boardUrl({ kind: 'top' }) %>">🖼 TOP画像</a>
      <a class="chip <%= imageKind === 'detail' ? 'on' : '' %>" href="<%= boardUrl({ kind: 'detail' }) %>">📸 商品詳細画像</a>
    <% } %>
    <select id="assignee-select" style="width:auto; font-size:12px;">
      <option value="">担当者で絞る…</option>
      <% for (const s of staff) { %>
        <option value="<%= s.id %>" <%= String(assigneeId) === String(s.id) && assigneeParam !== 'me' ? 'selected' : '' %>><%= s.name %></option>
      <% } %>
    </select>
    <span style="flex:1"></span>
    <span class="muted"><%= board.total %> 件<%= board.truncated ? ' (上限まで表示)' : '' %></span>
    <a class="btn btn-sm" href="/apps/product-hub/list">一覧で見る</a>
  </div>

  <% if (!me && assigneeParam === 'me') { %>
    <div class="banner-warn">
      ログイン中のアカウントに担当者が紐づいていません。
      <a href="/apps/product-hub/staff">担当者・工程</a> で、あなたの担当者にポータルのメールアドレスを設定してください。
    </div>
  <% } %>

  <%
    // 画像トラック (TOP/詳細) のミニステッパー。どちらのビューでも同じものをカードに出す
    const imgTrackRows = (c) => {
      const rows = [];
      for (const kind of ['top', 'detail']) {
        const t = c.image && c.image[kind];
        if (!t) continue;
        rows.push({ kind, t });
      }
      return rows;
    };
  %>

  <div class="kb">
    <% for (const col of board.columns) { %>
      <div class="kb-col <%= col.role_code ? '' : 'system' %>" data-col="<%= col.code || col.key %>">
        <div class="kb-col-head">
          <span class="kb-col-title"><%= col.label %></span>
          <span class="kb-col-count"><%= col.cards.length %></span>
        </div>
        <div class="kb-col-role">
          <%= col.role_code ? '' : '⚙️ 自動' %><%= col.stall_days ? `${col.role_code ? '' : ' / '}${col.stall_days}日で警告` : '' %>
        </div>
        <div class="kb-body">
          <% if (col.cards.length === 0) { %>
            <div class="kb-empty">—</div>
          <% } %>
          <% for (const c of col.cards) { %>
            <% const stalled = boardView === 'image' ? c.kindStalledDays : c.stalledDays; %>
            <% const currentCode = boardView === 'image' ? (c.kindCurrent && c.kindCurrent.step_code) : (c.current && c.current.step_code); %>
            <div class="kb-card <%= stalled ? 'stalled' : '' %><%= boardView === 'image' ? ` kind-${c.kind}` : '' %>" draggable="true"
                 data-draft="<%= c.id %>" data-kind="<%= boardView === 'image' ? c.kind : '' %>"
                 data-current="<%= currentCode || '' %>">
            <a class="kb-card-link" href="/apps/product-hub/detail/<%= c.id %><%= boardView === 'image' ? '?tab=tab-images' : '' %>">
              <% if (boardView === 'image') { %>
                <div class="kb-kindband <%= c.kind %>"><%= c.kind === 'top' ? '🖼 ' : '📸 ' %><%= imageKindLabels[c.kind] %></div>
              <% } %>
              <div class="kb-card-top">
                <% if (c.first_image_id) { %>
                  <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
                <% } else { %>
                  <div class="kb-thumb"></div>
                <% } %>
                <div style="min-width:0;">
                  <div class="kb-name"><%= c.name %></div>
                  <div class="kb-code"><%= c.ne_code %></div>
                </div>
              </div>
              <div class="kb-meta">
                <% if (boardView === 'image') { %>
                  <%# 種別はカード上部の帯 (kb-kindband) で表示済み %>
                  <% if (c.kindCurrent && c.kindCurrent.assignee_name) { %>
                    <span class="kb-assignee">
                      <span class="wf-dot" style="background:<%= c.kindCurrent.assignee_color || '#94a3b8' %>"></span><%= c.kindCurrent.assignee_name %>
                    </span>
                  <% } else if (c.kindCurrent && c.kindCurrent.role_code) { %>
                    <span class="kb-unassigned">未割り当て</span>
                  <% } %>
                  <% if (c.kindStalledDays) { %><span class="kb-stall">⚠️<%= c.kindStalledDays %>日</span><% } %>
                  <span class="mini">本流: <%= c.current ? c.current.label : '完了' %></span>
                <% } else { %>
                  <% if (c.current && c.current.assignee_name) { %>
                    <span class="kb-assignee">
                      <span class="wf-dot" style="background:<%= c.current.assignee_color || '#94a3b8' %>"></span><%= c.current.assignee_name %>
                    </span>
                  <% } else if (c.current && c.current.role_code) { %>
                    <span class="kb-unassigned">未割り当て</span>
                  <% } %>
                  <% if (c.stalledDays) { %><span class="kb-stall">⚠️<%= c.stalledDays %>日</span><% } %>
                <% } %>
              </div>
              <!-- 画像トラック (TOP/詳細) の進み具合。ボードを行き来しなくてもここで読める -->
              <div class="kb-imgtracks">
                <% for (const { kind, t } of imgTrackRows(c)) { %>
                  <div class="kb-krow">
                    <span class="kb-kname"><%= kind === 'top' ? 'TOP' : '詳細' %></span>
                    <% if (t.excluded) { %>
                      <span class="kb-klabel excluded">対象外</span>
                    <% } else { %>
                      <% for (const s of t.steps) { %>
                        <span class="kb-dot <%= s.state === 'done' || s.state === 'skip' ? 'done' : (s.state === 'doing' ? 'doing' : '') %>"></span>
                      <% } %>
                      <% if (t.done) { %>
                        <span class="kb-klabel done">済</span>
                      <% } else if (t.current) { %>
                        <span class="kb-klabel"><%= t.current.label %></span>
                        <% if (t.stalledDays) { %><span class="kb-kstall">⚠<%= t.stalledDays %>日</span><% } %>
                      <% } else { %>
                        <span class="kb-klabel">—</span>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <% if (boardView !== 'image' && c.malls && col.code === 'listing') { %>
                <%# 出品・展開の列だけ、どのモールまで並んだかを出す %>
                <div class="kb-malls">
                  <% for (const m of c.malls) { %>
                    <span class="mall-dot mall-<%= m.state %>" title="<%= m.label %>: <%= stepStateLabels[m.state] %>"></span>
                  <% } %>
                  <span class="mini"><%= c.malls.filter((m) => m.state === 'done').length %>/<%= c.malls.length %></span>
                </div>
              <% } %>
              <% if (boardView !== 'image') { %>
                <div class="kb-progress"><i style="width:<%= c.totalCount ? Math.round(c.doneCount / c.totalCount * 100) : 0 %>%"></i></div>
              <% } %>
            </a>
            <% if (boardView === 'image' && c.kind === 'top') { %>
              <%# TOP画像をどれぐらい力を入れて作るかの目安 (リンクの外 = クリックで詳細に飛ばない) %>
              <% const pr = imagePriorities.find((p) => p.value === c.image_priority) || null; %>
              <select class="kb-priority" data-draft="<%= c.id %>"
                      style="<%= pr ? `background:${pr.bg}; color:${pr.fg}; border-color:${pr.fg}33; font-weight:600;` : '' %>">
                <option value="">重要度: 未設定</option>
                <% for (const p of imagePriorities) { %>
                  <option value="<%= p.value %>" <%= c.image_priority === p.value ? 'selected' : '' %>><%= p.value %></option>
                <% } %>
              </select>
            <% } %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- 終端列: 完了 (画像ビューでは「TOP済み・詳細も済みか対象外」の商品)。
         D&D で落とすと残りの工程をまとめて完了にする (本流は listing のモール決着チェックで止まる) -->
    <div class="kb-col" style="background:#f0fdf4;" data-col="done">
      <div class="kb-col-head">
        <span class="kb-col-title">✅ 完了</span>
        <span class="kb-col-count"><%= board.doneTotal %></span>
      </div>
      <div class="kb-col-role"><%= board.doneTotal > board.doneCards.length ? `直近 ${board.doneCards.length} 件を表示` : '' %></div>
      <div class="kb-body">
        <% if (board.doneCards.length === 0) { %><div class="kb-empty">—</div><% } %>
        <%# 完了カードもドラッグで差し戻せる (data-current 空 = 全工程決着の CAS 値)。
            画像ビューは 商品×種別 なので、どちらを戻すかはカード自体が持っている %>
        <% for (const c of board.doneCards) { %>
          <div class="kb-card<%= boardView === 'image' && c.kind ? ` kind-${c.kind}` : '' %>" draggable="true"
               data-draft="<%= c.id %>" data-kind="<%= boardView === 'image' ? c.kind : '' %>" data-current="">
          <a class="kb-card-link" href="/apps/product-hub/detail/<%= c.id %>">
            <% if (boardView === 'image' && c.kind) { %>
              <div class="kb-kindband <%= c.kind %>"><%= c.kind === 'top' ? '🖼 ' : '📸 ' %><%= imageKindLabels[c.kind] %></div>
            <% } %>
            <div class="kb-card-top">
              <% if (c.first_image_id) { %>
                <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
              <% } else { %><div class="kb-thumb"></div><% } %>
              <div style="min-width:0;">
                <div class="kb-name"><%= c.name %></div>
                <div class="kb-code"><%= c.ne_code %></div>
              </div>
            </div>
          </a>
          <% if (boardView === 'image' && c.kind === 'top') { %>
            <% const prd = imagePriorities.find((p) => p.value === c.image_priority) || null; %>
            <select class="kb-priority" data-draft="<%= c.id %>"
                    style="<%= prd ? `background:${prd.bg}; color:${prd.fg}; border-color:${prd.fg}33; font-weight:600;` : '' %>">
              <option value="">重要度: 未設定</option>
              <% for (const p of imagePriorities) { %>
                <option value="<%= p.value %>" <%= c.image_priority === p.value ? 'selected' : '' %>><%= p.value %></option>
              <% } %>
            </select>
          <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <p class="muted" style="margin-top:14px;">
    カードをクリックすると商品の詳細が開き、そこで工程を進められます。
    <% if (boardView === 'image') { %>
      カードは 商品 × 画像種別 (🖼 TOP画像 / 📸 商品詳細画像) の2枚です。商品詳細画像を作らない商品は「対象外」にするとここに出ません。
    <% } %>
    保留・除外にした商品はこのボードには出ません（<a href="/apps/product-hub/list">一覧</a>で確認できます）。
  </p>
</div>

<script>
  const sel = document.getElementById('assignee-select');
  if (sel) {
    sel.addEventListener('change', function () {
      const p = new URLSearchParams(location.search);
      p.delete('filter');
      if (sel.value) p.set('assignee', sel.value); else p.delete('assignee');
      const s = p.toString();
      location.href = '/apps/product-hub/board' + (s ? '?' + s : '');
    });
  }

  // ─── カードの D&D 移動: 落とした列がその商品の「いまやる工程」になる ───
  const BOARD_VIEW = <%- JSON.stringify(boardView) %>;
  let dragCard = null;
  // ドラッグ直後の click でリンクへ飛ばない (Codex R1 medium: dragend の後に click を
  // 発火するブラウザがある。drop の fetch を中断させないためにも一拍だけ抑止する)
  let suppressClick = false;

  document.querySelectorAll('.kb-card[draggable="true"]').forEach(function (card) {
    card.addEventListener('dragstart', function (e) {
      dragCard = card;
      suppressClick = true;
      card.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      try { e.dataTransfer.setData('text/plain', card.dataset.draft); } catch (_) {}
    });
    card.addEventListener('dragend', function () {
      card.classList.remove('dragging');
      document.querySelectorAll('.kb-col.drop-ok').forEach((c) => c.classList.remove('drop-ok'));
      dragCard = null;
      setTimeout(function () { suppressClick = false; }, 300);
    });
    card.querySelector('.kb-card-link')?.addEventListener('click', function (e) {
      if (suppressClick) e.preventDefault();
    });
  });

  document.querySelectorAll('.kb-col[data-col]').forEach(function (col) {
    col.addEventListener('dragover', function (e) {
      if (!dragCard) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      col.classList.add('drop-ok');
    });
    col.addEventListener('dragleave', function (e) {
      // 子要素間の移動でチラつかないよう、列の外に出たときだけ消す
      if (!col.contains(e.relatedTarget)) col.classList.remove('drop-ok');
    });
    col.addEventListener('drop', async function (e) {
      e.preventDefault();
      col.classList.remove('drop-ok');
      if (!dragCard) return;
      const card = dragCard;
      const to = col.dataset.col;
      // 同じ列へのドロップは何もしない
      if (card.closest('.kb-col') === col) return;
      try {
        const res = await fetch('/apps/product-hub/api/drafts/' + card.dataset.draft + '/board-move', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            view: BOARD_VIEW,
            kind: card.dataset.kind || 'top',
            to: to,
            expected_current: card.dataset.current || null,
          }),
        });
        const j = await res.json();
        if (!j.ok) {
          alert(j.error || '移動できませんでした');
        }
      } catch (err) {
        alert('通信エラー: ' + err.message);
      }
      // 成否どちらでも読み直す (成功 = 列とステータスの再描画 / 失敗 = カードを元の位置へ)
      location.reload();
    });
  });

  // ─── TOP画像の重要度セレクト (その場で保存) ───
  document.querySelectorAll('.kb-priority').forEach(function (s) {
    // select の操作でカードのドラッグが始まらないようにする
    s.addEventListener('mousedown', function () {
      const card = s.closest('.kb-card');
      if (card) card.setAttribute('draggable', 'false');
    });
    ['mouseup', 'mouseleave', 'blur'].forEach(function (ev) {
      s.addEventListener(ev, function () {
        const card = s.closest('.kb-card');
        if (card) card.setAttribute('draggable', 'true');
      });
    });
    s.addEventListener('change', async function () {
      try {
        const res = await fetch('/apps/product-hub/api/drafts/' + s.dataset.draft + '/image-priority', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ value: s.value }),
        });
        const j = await res.json();
        if (!j.ok) { alert(j.error || '保存に失敗しました'); location.reload(); return; }
        // 色を選択肢に追従させる (再読込なしで見た目だけ更新)
        const PR = <%- JSON.stringify(imagePriorities) %>;
        const p = PR.find((x) => x.value === s.value);
        s.style.background = p ? p.bg : '';
        s.style.color = p ? p.fg : '';
        s.style.fontWeight = p ? '600' : '';
      } catch (err) {
        alert('通信エラー: ' + err.message);
        location.reload();
      }
    });
  });
</script>
