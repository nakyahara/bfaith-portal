<%- include('_header') %>
<style>
  /* かんばん: 列 = 工程、カード = 商品。列は横スクロール、列の中は縦スクロール */
  .kb { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; align-items: flex-start; }
  .kb-col { flex: 0 0 232px; background: #eef2f7; border-radius: 10px; padding: 8px; }
  .kb-col.system { background: #f1f5f9; border: 1px dashed #cbd5e1; }
  .kb-col-head { display: flex; align-items: baseline; gap: 6px; padding: 2px 4px 8px; }
  .kb-col-title { font-size: 13px; font-weight: 700; }
  .kb-col-count { font-size: 12px; color: #64748b; }
  .kb-col-role { font-size: 11px; color: #94a3b8; padding: 0 4px 6px; }
  .kb-body { max-height: 62vh; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
  .kb-card { display: block; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
             padding: 8px; text-decoration: none; color: #1f2430; }
  .kb-card:hover { border-color: #93c5fd; box-shadow: 0 1px 4px rgba(15,23,42,.08); }
  .kb-card.stalled { border-color: #fca5a5; background: #fff7f7; }
  /* D&D: カード = 掴んで列間を移動できる。リンク部分は中身だけ */
  .kb-card[draggable="true"] { cursor: grab; }
  .kb-card.dragging { opacity: .45; }
  .kb-card-link { display: block; text-decoration: none; color: inherit; }
  /* セット商品 (2026-09-04)。単品と見分けられるよう左に色の縁を置く (単品の青とは別の色) */
  .kb-card.is-set { border-left: 3px solid #6d28d9; }
  .kb-tag.set { background: #f1ecfd; color: #6d28d9; border-color: #c9b8f5; font-weight: 700; }
  .kb-tag.ne-not_requested { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
  .kb-tag.ne-requested, .kb-tag.ne-processing { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
  .kb-tag.ne-confirmed { background: #dcfce7; color: #166534; border-color: #86efac; }
  .kb-tag.ne-needs_action { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
  .kb-tag.decision { background: #e0e7ff; color: #3730a3; border-color: #a5b4fc; }
  .kb-tag.setstep { background: #faf5ff; color: #7e22ce; border-color: #ddd6fe; }
  .kb-setline { font-size: 10px; color: #64748b; line-height: 1.4; }
  .kb-setline .prov { color: #92400e; font-weight: 600; }
  .kb-parent-changed { font-size: 10px; color: #92400e; background: #fffbeb; border: 1px solid #fcd34d;
    border-radius: 4px; padding: 2px 5px; }
  .kb-tags { display: flex; flex-wrap: wrap; gap: 3px; margin: 2px 0; }
  .kb-tag { font-size: 10px; border-radius: 4px; padding: 1px 5px; background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; }
  .kb-tag.mat-none { color: #94a3b8; }
  .kb-tag.mat-ready, .kb-tag.mat-not_required { background: #dcfce7; color: #166534; border-color: #86efac; }
  .kb-tag.mat-shooting, .kb-tag.mat-shipped { background: #dbeafe; color: #1e40af; border-color: #93c5fd; }
  .kb-tag.mat-not_shipped { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
  .kb-tag.mat-internal_prep { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
  .kb-tag.rev { background: #ede9fe; color: #5b21b6; border-color: #c4b5fd; font-weight: 600; }
  .kb-tag.canva { background: #ecfeff; color: #155e75; border-color: #a5f3fc; }
  .kb-tag.info-missing { background: #fff7ed; color: #9a3412; border-color: #fdba74; }
  .kb-hold { font-size: 11px; font-weight: 600; color: #92400e; background: #fef3c7; border: 1px solid #f59e0b; border-radius: 4px; padding: 1px 6px; margin: 2px 0; display: inline-block; }
  .kb-hold.kb-aiblock { color: #991b1b; background: #fee2e2; border-color: #ef4444; }
  /* 確認中 (2026-08-31): 情報待ちのカード。列の先頭に並ぶ + 左の太いラインで一目で分かるようにする */
  .kb-hold.kb-checking { color: #1e40af; background: #dbeafe; border-color: #3b82f6; }
  .kb-hold.kb-checking.long { color: #9a3412; background: #ffedd5; border-color: #f97316; }
  .kb-card.checking { border-color: #93c5fd; border-left: 4px solid #3b82f6; background: #f8fbff; }
  .kb-col.drop-ok { outline: 2px dashed #2563eb; outline-offset: -2px; background: #eff6ff; }
  /* TOP画像の重要度 (どれぐらい力を入れて作るか)。Notion のタグ風に色を付ける */
  .kb-priority { width: 100%; margin-top: 6px; font-size: 11px; border-radius: 6px;
                 border: 1px solid #e2e8f0; padding: 3px 4px; background: #f8fafc; color: #475569; }
  .kb-card-top { display: flex; gap: 7px; }
  .kb-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 5px; border: 1px solid #e2e8f0;
              background: #f8fafc; flex: 0 0 auto; }
  .kb-name { font-size: 12px; font-weight: 600; line-height: 1.35; overflow: hidden;
             display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .kb-code { font-family: ui-monospace, Consolas, monospace; font-size: 10px; color: #94a3b8; }
  .kb-meta { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; margin-top: 6px; font-size: 11px; }
  .kb-assignee { display: inline-flex; align-items: center; gap: 4px; color: #475569; }
  .kb-unassigned { color: #b45309; font-weight: 600; }
  .kb-stall { color: #b91c1c; font-weight: 700; }
  .kb-kind { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 4px; }
  .kb-kind.top { background: #dbeafe; color: #1d4ed8; }
  .kb-kind.detail { background: #ede9fe; color: #6d28d9; }
  /* 画像ビュー: TOP画像/商品詳細画像をパッと見で判別 (2026-08-24 中原さん要望)。
     カード上部の帯 + 左ボーダー + 地色で、列を眺めるだけで種別が分かるようにする */
  .kb-card.kind-top { border-left: 4px solid #3b82f6; background: #f8fbff; }
  .kb-card.kind-detail { border-left: 4px solid #8b5cf6; background: #fdfbff; }
  .kb-kindband { display: block; font-size: 11px; font-weight: 700; padding: 2px 8px;
                 border-radius: 4px; margin-bottom: 6px; }
  .kb-kindband.top { background: #dbeafe; color: #1d4ed8; }
  .kb-kindband.detail { background: #ede9fe; color: #6d28d9; }
  .kb-malls { display: flex; align-items: center; gap: 2px; margin-top: 5px; }
  /* 楽天への出品 (2026-09-01): 出品・展開の列のカードに 結果 or ボタン。リンクの外に置く */
  .kb-rk { margin-top: 6px; font-size: 11px; border-radius: 6px; padding: 4px 8px; line-height: 1.4; }
  .kb-rk-done { background: #dcfce7; color: #166534; border: 1px solid #86efac; font-weight: 600; }
  .kb-rk-skip { background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; }
  .kb-rk-fail { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5;
                overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
  .kb-rk-link { margin-left: 6px; color: #1d4ed8; font-weight: 600; }
  .kb-rk-busy { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
  .kb-rk-warn { margin-top: 3px; font-weight: 400; color: #92400e; }
  .kb-rk-note { margin-top: 4px; font-size: 10px; color: #64748b; }
  .kb-rk-btn { width: 100%; margin-top: 6px; font-size: 12px; font-weight: 700; border-radius: 6px;
               border: 1px solid #b91c1c; background: #fff; color: #b91c1c; padding: 5px 8px; cursor: pointer; }
  .kb-rk-btn:hover { background: #fef2f2; }
  .kb-rk-btn:disabled { opacity: .5; cursor: default; }
  /* 出品中のオーバーレイ。転送→登録で数十秒かかるので、画面を触らせず進み具合を見せる */
  .kb-busy { position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 1000;
             display: flex; align-items: center; justify-content: center; }
  .kb-busy-box { background: #fff; border-radius: 12px; padding: 20px 28px; min-width: 320px; max-width: 520px;
                 box-shadow: 0 10px 30px rgba(0,0,0,.25); font-size: 14px; }
  .kb-busy-box .ttl { font-weight: 700; font-size: 15px; margin-bottom: 8px; }
  .kb-busy-box .step { color: #475569; }
  .mall-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #e2e8f0; }
  .mall-dot.mall-done { background: #16a34a; }
  .mall-dot.mall-doing { background: #f59e0b; }
  .mall-dot.mall-skip { background: #cbd5e1; opacity: .5; }
  .mini { font-size: 10px; color: #94a3b8; margin-left: 3px; }
  .kb-progress { height: 3px; background: #e2e8f0; border-radius: 999px; margin-top: 6px; overflow: hidden; }
  .kb-progress > i { display: block; height: 100%; background: #60a5fa; }
  .kb-empty { font-size: 11px; color: #94a3b8; text-align: center; padding: 10px 0; }
  .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
  .chip { display: inline-block; border: 1px solid #cbd5e1; background: #fff; border-radius: 999px;
          padding: 4px 12px; font-size: 12px; text-decoration: none; color: #475569; }
  .chip.on { background: #2563eb; border-color: #2563eb; color: #fff; font-weight: 600; }
  /* ビュー切替タブ: ボードは 1 枚で「見る軸」だけを変える (本流の工程 / 画像の工程) */
  .kb-tabs { display: inline-flex; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; }
  .kb-tab { padding: 5px 14px; font-size: 12px; text-decoration: none; color: #475569; background: #fff; }
  .kb-tab.on { background: #1d4ed8; color: #fff; font-weight: 700; }
  /* 画像の作成状況 (2026-09-01 中原さん要望): TOP画像 / 商品詳細画像 が 済 か まだ か。
     カードに常時出す = ボードを見るだけで「画像がまだの商品」が拾える。
     TOP は工程を廃止した (2026-08-31) ので、出品ゲートと同じ「枠1 (_top) が登録されているか」で見る */
  .kb-imgtracks { margin-top: 6px; display: flex; flex-direction: column; gap: 3px; font-size: 11px; }
  .kb-krow { display: flex; align-items: center; gap: 5px; color: #64748b; }
  .kb-krow .kb-kname { flex: 0 0 62px; font-weight: 700; color: #475569; }   /* 「トップ画像」が折り返さない幅 */
  .kb-state { flex: 0 0 auto; font-weight: 700; border-radius: 4px; padding: 1px 7px; border: 1px solid; }
  .kb-state.done { background: #dcfce7; color: #166534; border-color: #86efac; }
  .kb-state.todo { background: #fff7ed; color: #b45309; border-color: #fdba74; }
  .kb-state.off { background: #f1f5f9; color: #94a3b8; border-color: #e2e8f0; }
  .kb-klabel { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .kb-kstall { flex: 0 0 auto; color: #b91c1c; font-weight: 700; }
</style>

<%
  // フィルタとタブの URL。切り替えても他の条件 (担当者・未割り当て・ビュー・種別) を失わない
  const boardUrl = (over = {}) => {
    const p = new URLSearchParams();
    const v = over.view !== undefined ? over.view : boardView;
    if (v && v !== 'main') p.set('view', v);
    const a = over.assignee !== undefined ? over.assignee : assigneeParam;
    if (a) p.set('assignee', a);
    const f = over.filter !== undefined ? over.filter
      : (unassignedOnly ? 'unassigned' : (checkingOnly ? 'checking' : ''));
    if (f) p.set('filter', f);
    // 種別 (TOP画像/商品詳細画像) は画像ビューだけの条件。本流へ切り替えたら落とす
    const k = over.kind !== undefined ? over.kind : (imageKind || '');
    if (k && v === 'image') p.set('kind', k);
    const s = p.toString();
    return '/apps/product-hub/board' + (s ? '?' + s : '');
  };
  // カードから開いた詳細画面の「← 戻る」で、いま見ているボードへ戻すための印
  // (2026-08-28 中原さん要望)。サーバ側 backLinkOf が既知のキーだけ拾って組み直す
  const backParam = (() => {
    const p = new URLSearchParams();
    p.set('v', 'board');
    if (boardView && boardView !== 'main') p.set('view', boardView);
    if (assigneeParam) p.set('assignee', assigneeParam);
    if (unassignedOnly) p.set('filter', 'unassigned');
    if (checkingOnly) p.set('filter', 'checking');
    if (imageKind && boardView === 'image') p.set('kind', imageKind);
    return p.toString();
  })();
  const cardHref = (id, imagesTab) => {
    const p = new URLSearchParams();
    if (imagesTab) p.set('tab', 'tab-images');
    p.set('back', backParam);
    return `/apps/product-hub/detail/${id}?${p.toString()}`;
  };
%>

<div class="wrap wide">
  <div class="filters">
    <span style="font-size:15px; font-weight:700;">🔁 工程ボード</span>
    <span class="kb-tabs">
      <a class="kb-tab <%= boardView === 'main' ? 'on' : '' %>" href="<%= boardUrl({ view: 'main' }) %>">全体</a>
      <a class="kb-tab <%= boardView === 'single' ? 'on' : '' %>" href="<%= boardUrl({ view: 'single' }) %>">単品</a>
      <a class="kb-tab <%= boardView === 'set' ? 'on' : '' %>" href="<%= boardUrl({ view: 'set' }) %>">🧩 セット工程</a>
      <a class="kb-tab <%= boardView === 'image' ? 'on' : '' %>" href="<%= boardUrl({ view: 'image' }) %>">🖼 画像で並べる</a>
    </span>
    <a class="chip <%= !assigneeParam && !unassignedOnly && !checkingOnly ? 'on' : '' %>" href="<%= boardUrl({ assignee: '', filter: '' }) %>">すべて</a>
    <% if (me) { %>
      <a class="chip <%= assigneeParam === 'me' ? 'on' : '' %>" href="<%= boardUrl({ assignee: 'me', filter: '' }) %>">
        自分のボール (<%= me.name %>)
      </a>
    <% } %>
    <a class="chip <%= unassignedOnly ? 'on' : '' %>" href="<%= boardUrl({ assignee: '', filter: 'unassigned' }) %>">未割り当て</a>
    <%# 確認中 (2026-08-31 スタッフ要望)。件数は**絞り込み・ビューと無関係の商品件数**を出す —
        絞り込み中に 0 と出ると確認中が無いように見えて、拾うための入口がそこで消える。
        画像ビューはカード = 商品×種別なので、この件数とカード枚数は一致しない (Codex R1) %>
    <a class="chip <%= checkingOnly ? 'on' : '' %>" href="<%= boardUrl({ assignee: '', filter: 'checking' }) %>"
       title="確認中の商品の件数 (いまの絞り込み・ビューに関わらない全体の数)"
       style="<%= !checkingOnly && board.checkingTotal > 0 ? 'border-color:#3b82f6; color:#1e40af;' : '' %>">
      🔍 確認中<%= board.checkingTotal > 0 ? ` ${board.checkingTotal}` : '' %>
    </a>
    <select id="assignee-select" style="width:auto; font-size:12px;">
      <option value="">担当者で絞る…</option>
      <% for (const s of staff) { %>
        <option value="<%= s.id %>" <%= String(assigneeId) === String(s.id) && assigneeParam !== 'me' ? 'selected' : '' %>><%= s.name %></option>
      <% } %>
    </select>
    <%# 検索 (2026-08-25 中原さん要望): 商品名・商品コードでカードを即時絞り込み (入力のたび・リロード不要) %>
    <input type="search" id="kb-search" placeholder="🔍 商品名・商品コード"
           style="width:190px; font-size:12px; padding:5px 9px; border:1px solid #cbd5e1; border-radius:8px;">
    <span style="flex:1"></span>
    <span class="muted"><%= board.total %> 件<%= board.truncated ? ' (上限まで表示)' : '' %></span>
    <a class="btn btn-sm" href="/apps/product-hub/list">一覧で見る</a>
  </div>

  <% if (!me && assigneeParam === 'me') { %>
    <div class="banner-warn">
      ログイン中のアカウントに担当者が紐づいていません。
      <a href="/apps/product-hub/staff">担当者・工程</a> で、あなたの担当者にポータルのメールアドレスを設定してください。
    </div>
  <% } %>

  <%
    // カードに出す画像の作成状況 (2026-09-01 中原さん要望)。どちらのビューでも同じものを出す。
    // ・トップ画像 = 工程を廃止した (2026-08-31) ので **枠1 (<商品コード>_top) の登録の有無**。
    //   出品ゲート imageTrackBlockReason とわざと同じ判定 — ボードで「済」なのに出品が止まる
    //   (逆も) と、現場はどちらを信じればいいか分からなくなる
    // ・詳細画像 = **制作が終わったか** (⑦Amazon登録依頼まで決着)。こちらは出品ゲートとは基準が違う:
    //   ゲートは ⑥-2 まで (listing_gate=1) で開くので、「まだ (Amazon登録依頼)」でも楽天出品はできる。
    //   カードが見せたいのは「画像を作る仕事が残っているか」なので、わざとゲートより厳しくしている
    const imgStateRows = (c) => {
      const t = (c.image && c.image.detail) || null;
      // 詳細画像は「作り終わったか」で 済/まだ を出す (2026-09-01 中原さん)。
      // ⑧楽天登録・⑨A+登録 は作った画像を載せる後工程なので、そこに来ていれば「済」。
      // 済でも いまの工程名は残す (「済 楽天登録」= 作り終わって登録の番、が 1 行で読める)
      const detail = !t ? { state: 'off', text: '—' }
        : t.excluded ? { state: 'off', text: '対象外' }
          : (t.done || t.made) ? { state: 'done', text: '済', note: t.current ? t.current.label : '' }
            : { state: 'todo', text: 'まだ', note: t.current ? t.current.label : '', stalledDays: t.stalledDays };
      const topDone = !!(c.image && c.image.top && c.image.top.registered);
      return [
        {
          name: 'トップ画像',
          title: topDone ? 'TOP画像 (枠1) が登録されています' : 'TOP画像 (枠1 = 商品コード_top) がまだ登録されていません',
          ...(topDone ? { state: 'done', text: '済' } : { state: 'todo', text: 'まだ' }),
        },
        { name: '詳細画像', title: '商品詳細画像 (LP)。楽天登録・A+登録まで来たら「済」', ...detail },
      ];
    };
  %>

  <div class="kb">
    <% for (const col of board.columns) { %>
      <div class="kb-col <%= col.role_code ? '' : 'system' %>" data-col="<%= col.code || col.key %>">
        <div class="kb-col-head">
          <span class="kb-col-title"><%= col.label %></span>
          <span class="kb-col-count"><%= col.cards.length %></span>
        </div>
        <div class="kb-col-role">
          <%= col.role_code ? '' : '⚙️ 自動' %><%= col.stall_days ? `${col.role_code ? '' : ' / '}${col.stall_days}日で警告` : '' %>
        </div>
        <div class="kb-body">
          <% if (col.cards.length === 0) { %>
            <div class="kb-empty">—</div>
          <% } %>
          <% for (const c of col.cards) { %>
            <% const stalled = boardView === 'image' ? c.kindStalledDays : c.stalledDays; %>
            <% const currentCode = boardView === 'image' ? (c.kindCurrent && c.kindCurrent.step_code) : (c.current && c.current.step_code); %>
            <div class="kb-card <%= stalled ? 'stalled' : '' %><%= c.checking ? ' checking' : '' %><%= c.isSet ? ' is-set' : '' %><%= boardView === 'image' ? ` kind-${c.kind}` : '' %>" draggable="true"
                 data-draft="<%= c.id %>" data-kind="<%= boardView === 'image' ? c.kind : '' %>"
                 data-set="<%= c.isSet ? '1' : '' %>"
                 data-current="<%= currentCode || '' %>"
                 <%# 楽天の状態 (2026-09-01): 「出品・展開」に落としたとき、済み/対象外なら出品の確認を出さない %>
                 data-rk="<%= c.rakutenRegisteredAt ? 'done' : (((c.malls || []).find((m) => m.code === 'rakuten') || {}).state || '') %>"
                 data-name="<%= c.name || '' %>"
                 data-search="<%= `${c.name || ''} ${c.ne_code || ''}`.toLowerCase() %>">
            <a class="kb-card-link" href="<%= cardHref(c.id, boardView === 'image') %>">
              <% if (boardView === 'image') { %>
              <% if (c.imageOnHold) { %><div class="kb-hold" title="<%= c.imageHoldNote || '' %>">⏸ 画像制作 保留中</div><% } %>
              <%# 画像工程 v2 (2026-08-26): 詳細カードに 撮影・素材 / 確認者 (列に工程が複数あるとき) / Canva / 商品情報 %>
              <% if (c.kind === 'detail') { %>
                <div class="kb-tags">
                  <% if (c.materialLabel) { %><span class="kb-tag mat-<%= c.materialStatus %>">📷 <%= c.materialLabel %></span><% } else { %><span class="kb-tag mat-none">📷 撮影・素材 未設定</span><% } %>
                  <% if (col.stepCodes && col.stepCodes.length > 1 && c.kindCurrent) { %><span class="kb-tag rev">👤 <%= c.kindCurrent.label %></span><% } %>
                  <% if (c.canvaUrl) { %><span class="kb-tag canva">🎨 Canva</span><% } %>
                  <% if (!c.hasProductInfo && c.ownBrand) { %><span class="kb-tag info-missing">商品情報 未入力</span><% } %>
                </div>
              <% } %>
              <% } %>
              <%# 確認中 (2026-08-31)。列は動かさず、何を待っているか + 何日待っているかをカードに出す。
                  7日を超えたら色を変える (待ちっぱなしで忘れられたカードを目立たせる) %>
              <% if (c.checking) { %>
                <div class="kb-hold kb-checking <%= (c.checking.days || 0) >= 7 ? 'long' : '' %>" title="<%= c.checking.note || '' %>">
                  🔍 確認中: <%= c.checking.label %><%= c.checking.days ? ` (${c.checking.days}日)` : '' %>
                </div>
              <% } %>
              <%# AI が「人の確認待ち」にした商品 (2026-08-28)。列は動かさず理由をカードに出す %>
              <% if (c.genBlockCode) { %><div class="kb-hold kb-aiblock" title="<%= c.genBlockReason || '' %>">⚠ AIが止めました: <%= c.genBlockLabel %></div><% } %>
              <%# セット商品 (2026-09-04 §5.2)。単品と見分けられるように、種別・親・構成・NEの進みを出す。
                  値はサーバー側で構造化して渡している (ここで文字列から判定しない) %>
              <% if (c.isSet && c.set) { %>
                <div class="kb-tags">
                  <span class="kb-tag set">🎁 セット</span>
                  <span class="kb-tag ne-<%= c.set.neState %>"><%= NE_STATE_LABELS[c.set.neState] || c.set.neState %></span>
                  <%# 全体ビューではセット工程を本流の列に**投影して**置いている (§4.6)。
                      列名とカードの工程が違うので、本当の工程名を必ず出す (投影を隠さない) %>
                  <% if (boardView === 'main' && c.current) { %>
                    <span class="kb-tag setstep">セット工程: <%= c.current.label %></span>
                  <% } %>
                </div>
                <% if (c.set.neState === 'needs_action' && c.set.neError) { %>
                  <div class="kb-hold" title="<%= c.set.neError %>">⚠ <%= c.set.neError %></div>
                <% } %>
                <% if (c.set.parentChanged) { %><div class="kb-parent-changed">親が更新されています</div><% } %>
              <% } %>
              <%# ⑤の判断 (作らない・保留)。何も決めていないカードと区別する %>
              <% if (!c.isSet && c.setDecision && c.setDecision.decision !== 'create') { %>
                <div class="kb-tags"><span class="kb-tag decision">判断: <%= c.setDecision.label %></span></div>
              <% } %>
              <div class="kb-card-top">
                <% if (c.first_image_id) { %>
                  <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
                <% } else { %>
                  <div class="kb-thumb"></div>
                <% } %>
                <div style="min-width:0;">
                  <div class="kb-name"><%= c.name %></div>
                  <div class="kb-code"><%= c.ne_code %><% if (c.isSet && c.set && c.set.provisional) { %> <span class="prov">(仮)</span><% } %></div>
                  <% if (c.isSet && c.set) { %>
                    <div class="kb-setline">
                      親: <%= c.set.parentNeCode || '—' %><% if (c.set.members) { %>　構成: <%= c.set.members %><% } %>
                    </div>
                  <% } %>
                  <% if (!c.isSet && c.setChildrenCount > 0) { %>
                    <div class="kb-setline">🎁 派生セット <%= c.setChildrenCount %>件</div>
                  <% } %>
                </div>
              </div>
              <div class="kb-meta">
                <% if (boardView === 'image') { %>
                  <%# 種別はカード上部の帯 (kb-kindband) で表示済み %>
                  <% if (c.kindCurrent && c.kindCurrent.assignee_name) { %>
                    <span class="kb-assignee">
                      <span class="wf-dot" style="background:<%= c.kindCurrent.assignee_color || '#94a3b8' %>"></span><%= c.kindCurrent.assignee_name %>
                    </span>
                  <% } else if (c.kindCurrent && c.kindCurrent.role_code) { %>
                    <span class="kb-unassigned">未割り当て</span>
                  <% } %>
                  <% if (c.kindStalledDays) { %><span class="kb-stall">⚠️<%= c.kindStalledDays %>日</span><% } %>
                  <span class="mini">本流: <%= c.current ? c.current.label : '完了' %></span>
                <% } else { %>
                  <% if (c.current && c.current.assignee_name) { %>
                    <span class="kb-assignee">
                      <span class="wf-dot" style="background:<%= c.current.assignee_color || '#94a3b8' %>"></span><%= c.current.assignee_name %>
                    </span>
                  <% } else if (c.current && c.current.role_code) { %>
                    <span class="kb-unassigned">未割り当て</span>
                  <% } %>
                  <% if (c.stalledDays) { %><span class="kb-stall">⚠️<%= c.stalledDays %>日</span><% } %>
                <% } %>
              </div>
              <!-- TOP画像 / 商品詳細画像 が 済 か まだ か。ボードを行き来しなくてもここで読める -->
              <div class="kb-imgtracks">
                <% for (const r of imgStateRows(c)) { %>
                  <div class="kb-krow" title="<%= r.title %>">
                    <span class="kb-kname"><%= r.name %></span>
                    <span class="kb-state <%= r.state %>"><%= r.text %></span>
                    <% if (r.note) { %><span class="kb-klabel"><%= r.note %></span><% } %>
                    <% if (r.stalledDays) { %><span class="kb-kstall">⚠<%= r.stalledDays %>日</span><% } %>
                  </div>
                <% } %>
              </div>
              <% if (boardView !== 'image' && c.malls && col.code === 'listing') { %>
                <%# 出品・展開の列だけ、どのモールまで並んだかを出す %>
                <div class="kb-malls">
                  <% for (const m of c.malls) { %>
                    <span class="mall-dot mall-<%= m.state %>" title="<%= m.label %>: <%= stepStateLabels[m.state] %>"></span>
                  <% } %>
                  <span class="mini"><%= c.malls.filter((m) => m.state === 'done').length %>/<%= c.malls.length %></span>
                </div>
              <% } %>
              <% if (boardView !== 'image') { %>
                <div class="kb-progress"><i style="width:<%= c.totalCount ? Math.round(c.doneCount / c.totalCount * 100) : 0 %>%"></i></div>
              <% } %>
            </a>
            <% if (boardView !== 'image' && c.malls && col.code === 'listing') { %>
              <%# 楽天への出品 (2026-09-01 中原さん要望)。リンクの外に置く (押して詳細に飛ばない)。
                  出品済み = 商品ページへのリンク / 失敗 = 理由 + やり直し / 未出品 = 出品ボタン。
                  ボタンからも D&D と同じ確認ダイアログ → 同じ API を通る %>
              <%
                const rkMall = c.malls.find((m) => m.code === 'rakuten') || null;
                // 「出品済み」の主判定は registered_at (RMS に登録が通った記録)。モール状況 (rkMall.state) は
                // 後処理で付くので、後処理だけ失敗した商品を「未出品」に見せない (Codex R1 high)
                const rkRegistered = !!c.rakutenRegisteredAt || (rkMall && rkMall.state === 'done');
                // 掲載URL: 保存されていなければ商品コードから組み立てる (詳細画面を開かずに登録済みになった商品は
                // ensureMallStatus が done で作るので URL を持たない)
                const rkUrl = (rkMall && rkMall.itemUrl) || (typeof rakutenItemPageUrl === 'function' && c.ne_code ? rakutenItemPageUrl(c.ne_code) : null);
                // RMS の商品編集ページ (2026-09-04 中原さん要望: 出品済みの商品をその場で直せるように)
                const rkRmsUrl = (typeof rakutenRmsItemUrl === 'function' && c.ne_code) ? rakutenRmsItemUrl(c.ne_code) : null;
                const rkOutcome = c.rakutenListingOutcome || null;
                // 実行中のまま 15 分以上動いていない = プロセス再起動などで途中で止まった (実行中は通常 1〜2 分)
                const rkAttemptMs = c.rakutenListingAttemptAt ? Date.parse(c.rakutenListingAttemptAt) : NaN;
                const rkStale = rkOutcome === 'running' && (!Number.isFinite(rkAttemptMs) || Date.now() - rkAttemptMs > 15 * 60 * 1000);
              %>
              <% if (rkRegistered) { %>
                <div class="kb-rk kb-rk-done">
                  🛒 楽天: 出品済み
                  <% if (rkUrl) { %><a href="<%= rkUrl %>" target="_blank" rel="noopener" class="kb-rk-link">商品ページ ↗</a><% } %>
                  <% if (rkRmsUrl) { %><a href="<%= rkRmsUrl %>" target="_blank" rel="noopener" class="kb-rk-link" title="RMS の商品編集画面を開きます">RMS ↗</a><% } %>
                  <% if (!(rkMall && rkMall.state === 'done')) { %>
                    <div class="kb-rk-warn">⚠ モール別の状況が未更新です (詳細画面で楽天を「完了」にしてください)</div>
                  <% } %>
                </div>
              <% } else if (rkMall && rkMall.state === 'skip') { %>
                <div class="kb-rk kb-rk-skip">🛒 楽天: 対象外</div>
              <% } else if (rkOutcome === 'running' && !rkStale) { %>
                <div class="kb-rk kb-rk-busy">⏳ 楽天に出品しています… (画像転送 → 登録)</div>
              <% } else if (rkOutcome === 'unknown' || rkStale) { %>
                <%# 🚨 PUT の結果が確認できなかった / 途中で止まった = 実は登録が通っているかもしれない。
                    「やり直す」は出さない。人が RMS で確認したうえで管理者だけが再実行 (Codex R2 critical:
                    途中で止まったものを「15 分経ったからやり直せる」にすると、PUT 成功直後に落ちた商品が二重登録になる) %>
                <div class="kb-rk kb-rk-fail" title="<%= c.rakutenLastError || '' %>">
                  ⚠ <%= rkStale ? `出品処理が途中で止まりました (${(c.rakutenListingAttemptAt || '').replace('T', ' ').slice(0, 16)})` : '楽天への登録結果が確認できませんでした' %>。
                  RMS で商品管理番号「<%= String(c.ne_code || '').toLowerCase() %>」の有無を確認してください。
                  登録されていれば詳細画面の「モール別の展開状況」で楽天を完了に。
                </div>
                <% if (isAdmin) { %>
                  <button type="button" class="kb-rk-btn" data-draft="<%= c.id %>" data-name="<%= c.name %>" data-force="1">
                    🔁 RMS に無いことを確認済み → 再実行 (管理者)
                  </button>
                <% } else { %>
                  <div class="kb-rk-note">RMS に無ければ管理者に再実行を依頼してください</div>
                <% } %>
              <% } else { %>
                <% if (c.rakutenLastError) { %>
                  <div class="kb-rk kb-rk-fail" title="<%= c.rakutenLastError %>">❌ 楽天に出品できませんでした: <%= c.rakutenLastError %></div>
                <% } %>
                <button type="button" class="kb-rk-btn" data-draft="<%= c.id %>" data-name="<%= c.name %>">
                  ⚡ 楽天に出品<%= c.rakutenLastError ? ' (やり直す)' : '' %>
                </button>
              <% } %>
            <% } %>
            <% if (boardView === 'image') { %>
              <%# 画像をどれぐらい力を入れて作るかの目安 (リンクの外 = クリックで詳細に飛ばない)。
                  2026-08-31 中原さん: 商品詳細画像のカードにも出す。設定後にどの重要度にしたかが
                  カード一覧で分からず、いちいち開いて確かめていた。値は**商品単位**なので
                  同じ商品の TOP カードと詳細カードには同じものが出る (片方を変えると両方に効く) %>
              <% const pr = imagePriorities.find((p) => p.value === c.image_priority) || null; %>
              <select class="kb-priority" data-draft="<%= c.id %>"
                      style="<%= pr ? `background:${pr.bg}; color:${pr.fg}; border-color:${pr.fg}33; font-weight:600;` : '' %>">
                <option value="">重要度: 未設定</option>
                <% for (const p of imagePriorities) { %>
                  <option value="<%= p.value %>" <%= c.image_priority === p.value ? 'selected' : '' %>><%= p.value %></option>
                <% } %>
              </select>
            <% } %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- 終端列: 完了 (画像ビューでは「TOP済み・詳細も済みか対象外」の商品)。
         D&D で落とすと残りの工程をまとめて完了にする (本流は listing のモール決着チェックで止まる) -->
    <div class="kb-col" style="background:#f0fdf4;" data-col="done">
      <div class="kb-col-head">
        <span class="kb-col-title">✅ 完了</span>
        <span class="kb-col-count"><%= board.doneTotal %></span>
      </div>
      <div class="kb-col-role"><%= board.doneTotal > board.doneCards.length ? `直近 ${board.doneCards.length} 件を表示` : '' %></div>
      <div class="kb-body">
        <% if (board.doneCards.length === 0) { %><div class="kb-empty">—</div><% } %>
        <%# 完了カードもドラッグで差し戻せる (data-current 空 = 全工程決着の CAS 値)。
            画像ビューは 商品×種別 なので、どちらを戻すかはカード自体が持っている %>
        <% for (const c of board.doneCards) { %>
          <div class="kb-card<%= c.checking ? ' checking' : '' %><%= boardView === 'image' && c.kind ? ` kind-${c.kind}` : '' %>" draggable="true"
               data-draft="<%= c.id %>" data-kind="<%= boardView === 'image' ? c.kind : '' %>" data-current=""
               data-search="<%= `${c.name || ''} ${c.ne_code || ''}`.toLowerCase() %>">
          <a class="kb-card-link" href="<%= cardHref(c.id, false) %>">
            <% if (boardView === 'image' && c.kind) { %>
              <% if (c.imageOnHold) { %><div class="kb-hold" title="<%= c.imageHoldNote || '' %>">⏸ 画像制作 保留中</div><% } %>
            <% } %>
            <% if (c.checking) { %>
              <div class="kb-hold kb-checking <%= (c.checking.days || 0) >= 7 ? 'long' : '' %>" title="<%= c.checking.note || '' %>">
                🔍 確認中: <%= c.checking.label %><%= c.checking.days ? ` (${c.checking.days}日)` : '' %>
              </div>
            <% } %>
            <% if (c.genBlockCode) { %><div class="kb-hold kb-aiblock" title="<%= c.genBlockReason || '' %>">⚠ AIが止めました: <%= c.genBlockLabel %></div><% } %>
            <div class="kb-card-top">
              <% if (c.first_image_id) { %>
                <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
              <% } else { %><div class="kb-thumb"></div><% } %>
              <div style="min-width:0;">
                <div class="kb-name"><%= c.name %></div>
                <div class="kb-code"><%= c.ne_code %></div>
              </div>
            </div>
            <%# 完了列にも画像の状況を出す (2026-09-01): 本流を D&D で完了にすると
                TOP画像が未登録のまま完了列に入りうる。ここで「まだ」が見えれば拾える %>
            <div class="kb-imgtracks">
              <% for (const r of imgStateRows(c)) { %>
                <div class="kb-krow" title="<%= r.title %>">
                  <span class="kb-kname"><%= r.name %></span>
                  <span class="kb-state <%= r.state %>"><%= r.text %></span>
                  <% if (r.note) { %><span class="kb-klabel"><%= r.note %></span><% } %>
                </div>
              <% } %>
            </div>
          </a>
          <% if (boardView === 'image') { %>
            <% const prd = imagePriorities.find((p) => p.value === c.image_priority) || null; %>
            <select class="kb-priority" data-draft="<%= c.id %>"
                    style="<%= prd ? `background:${prd.bg}; color:${prd.fg}; border-color:${prd.fg}33; font-weight:600;` : '' %>">
              <option value="">重要度: 未設定</option>
              <% for (const p of imagePriorities) { %>
                <option value="<%= p.value %>" <%= c.image_priority === p.value ? 'selected' : '' %>><%= p.value %></option>
              <% } %>
            </select>
          <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <p class="muted" style="margin-top:14px;">
    カードをクリックすると商品の詳細が開き、そこで工程を進められます。
    カードは<strong>ドラッグで動かせます</strong> — 別の列に落とすと工程が進み、同じ列の中で上下に動かすと<strong>並び順</strong>が保存されます (次に開いてもその順のまま)。
    並べ替えた列にあとから入ってきたカードは、いちばん下に付きます (上から順にやれば先に来たものから片付く)。
    <% if (boardView === 'image') { %>
カードは 1 商品 1 枚です (2026-08-31: TOP画像の工程は廃止し、LP の工程に一本化)。商品詳細画像を作らない商品は「対象外」にするとここに出ません。
    <% } %>
    保留・除外にした商品はこのボードには出ません（<a href="/apps/product-hub/list">一覧</a>で確認できます）。
  </p>
</div>

<script>
  const sel = document.getElementById('assignee-select');
  if (sel) {
    sel.addEventListener('change', function () {
      const p = new URLSearchParams(location.search);
      p.delete('filter');
      if (sel.value) p.set('assignee', sel.value); else p.delete('assignee');
      const s = p.toString();
      location.href = '/apps/product-hub/board' + (s ? '?' + s : '');
    });
  }

  // ─── 検索 (2026-08-25 中原さん要望): 商品名・商品コードでカードを即時絞り込み ───
  // D&D や重要度変更でページが再読込されるので、検索語は sessionStorage で持ち越す
  (function initBoardSearch() {
    const input = document.getElementById('kb-search');
    if (!input) return;
    const KEY = 'ph-board-search';
    function apply() {
      const q = input.value.trim().toLowerCase();
      try { sessionStorage.setItem(KEY, q); } catch (e) { /* プライベートモード等は保持なしで動く */ }
      document.querySelectorAll('.kb-card[data-search]').forEach(function (c) {
        c.style.display = (!q || (c.dataset.search || '').indexOf(q) !== -1) ? '' : 'none';
      });
      // 列の件数は「表示中/全体」に。解除したら元の数字へ戻す
      document.querySelectorAll('.kb-col').forEach(function (col) {
        const cnt = col.querySelector('.kb-col-count');
        if (!cnt) return;
        if (cnt.dataset.total === undefined) cnt.dataset.total = cnt.textContent;
        let visible = 0;
        col.querySelectorAll('.kb-card[data-search]').forEach(function (c) { if (c.style.display !== 'none') visible++; });
        cnt.textContent = q ? (visible + '/' + cnt.dataset.total) : cnt.dataset.total;
      });
    }
    input.addEventListener('input', apply);
    try {
      const saved = sessionStorage.getItem(KEY);
      if (saved) { input.value = saved; apply(); }
    } catch (e) { /* 保持なしで動く */ }
  })();

  // ─── 楽天に出品 (2026-09-01 中原さん要望) ───
  // 入口は 2 つ (カードを「出品・展開」に落とした直後 / カードの「⚡楽天に出品」ボタン) だが、
  // 確認 → 実行 → 結果表示 は同じ。楽天への公開登録は取り消せないので、必ず確認を挟む。
  // 転送→登録で数十秒かかるので、その間はオーバーレイで画面を塞ぐ (二重クリックと離脱の防止)
  function showBusy(title, step) {
    let el = document.getElementById('kb-busy');
    if (!el) {
      el = document.createElement('div');
      el.id = 'kb-busy';
      el.className = 'kb-busy';
      el.innerHTML = '<div class="kb-busy-box"><div class="ttl"></div><div class="step"></div></div>';
      document.body.appendChild(el);
    }
    el.querySelector('.ttl').textContent = title;
    el.querySelector('.step').textContent = step || '';
    el.style.display = 'flex';
  }
  function hideBusy() {
    const el = document.getElementById('kb-busy');
    if (el) el.style.display = 'none';
  }
  function confirmListing(name) {
    return confirm('「' + name + '」を楽天に出品しますか?\n\n'
      + '・画像を Drive → R-Cabinet へ転送します (転送済みの分は飛ばします)\n'
      + '・公開状態で登録します (在庫0なので売れません。在庫はNE連携が入れます)\n\n'
      + '※ 楽天への登録は取り消せません。\n'
      + '[OK] = 出品する   [キャンセル] = 出品しない');
  }
  // @param {boolean} force 前回「結果不明」の商品を、RMS で未登録を確認したうえで再実行 (管理者のみ)
  // @returns {Promise<boolean>} 実行したか (確認で取りやめたら false)
  async function listToRakuten(draftId, name, force) {
    if (force && !confirm('RMS で商品管理番号を検索して「登録されていない」ことを確認しましたか?\n\n'
      + '登録されているのに再実行すると二重登録になります。\n[OK] = 確認した   [キャンセル] = やめる')) return false;
    if (!confirmListing(name)) return false;
    showBusy('楽天に出品しています…', '① 画像を R-Cabinet へ転送 → ② 公開で登録 (30秒〜1分ほど)');
    let j = null;
    let unreadable = null;   // 応答が読めなかった (切断・プロキシの HTML 等)。結果不明として扱う
    try {
      const res = await fetch('/apps/product-hub/api/drafts/' + draftId + '/rakuten/list-from-board', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirm: true, force_unknown: !!force }),
      });
      const text = await res.text();
      try { j = JSON.parse(text); } catch (_) { unreadable = 'HTTP ' + res.status + ' (JSON でない応答)'; }
    } catch (err) {
      unreadable = err.message;
    }
    hideBusy();
    if (unreadable) {
      // 楽天への登録が通ったかどうかは分からない (サーバー側の処理は続いているかもしれない)。
      // ここで「やり直す」を勧めない — 読み直せばカードに実際の状態 (出品済み / 実行中 / 失敗) が出る
      alert('⚠ 応答が読めませんでした (' + unreadable + ')\n\n'
        + '楽天への登録が通ったかどうかは、ページを読み直してカードの表示で確認してください\n'
        + '(出品済みなら「出品済み」、まだ動いていれば「出品しています…」と出ます)');
      return true;
    }
    if (j.ok) {
      const tr = j.transfer || {};
      const cat = j.register && j.register.shopCategories;
      const post = j.postProcess || {};
      let msg = '✅ 楽天に出品しました\n\n画像: 転送 ' + (tr.uploaded || 0) + ' 枚 / 転送済み ' + (tr.already || 0) + ' 枚';
      if (cat && cat.ok === false) msg += '\n\n⚠️ 店舗内カテゴリ (棚) の反映は失敗しました:\n' + (cat.error || '') + '\n詳細画面の「棚を反映」でやり直せます';
      if (post.mallOk === false) msg += '\n\n⚠️ 登録は通りましたが「モール別の展開状況」を更新できませんでした。詳細画面で楽天を「完了」にしてください';
      if (post.stepOk === false) msg += '\n\n⚠️ 画像工程⑧「楽天登録」を完了にできませんでした。詳細画面の工程パネルで完了にしてください';
      alert(msg);
    } else if (j.outcome === 'unknown') {
      alert('⚠ 楽天への登録結果が確認できませんでした\n\n' + (j.error || '')
        + '\n\n※ 実は登録が通っている可能性があるので、やり直しは止めています。\n'
        + 'RMS で商品管理番号の有無を確認し、登録されていれば詳細画面の「モール別の展開状況」で楽天を完了に、\n'
        + '無ければ管理者がカードの「再実行」で出し直せます');
    } else {
      alert('❌ 楽天に出品できませんでした\n\n' + (j.error || '')
        + (j.stage === 'transfer' ? '\n\n(画像の転送で止まりました)' : '')
        + (j.retryable === false ? '' : '\n\n直してから、カードの「⚡楽天に出品 (やり直す)」で再実行できます'));
    }
    return true;
  }
  document.querySelectorAll('.kb-rk-btn').forEach(function (btn) {
    // ボタン操作でカードのドラッグが始まらないようにする (重要度セレクトと同じ扱い)
    btn.addEventListener('mousedown', function () { btn.closest('.kb-card')?.setAttribute('draggable', 'false'); });
    ['mouseup', 'mouseleave', 'blur'].forEach(function (ev) {
      btn.addEventListener(ev, function () { btn.closest('.kb-card')?.setAttribute('draggable', 'true'); });
    });
    btn.addEventListener('click', async function (e) {
      e.preventDefault();
      btn.disabled = true;
      const ran = await listToRakuten(btn.dataset.draft, btn.dataset.name || '', btn.dataset.force === '1');
      if (ran) location.reload(); else btn.disabled = false;
    });
  });

  // ─── カードの D&D: 列をまたぐと工程が動き、同じ列の中なら並び順が変わる ───
  // (2026-08-28 中原さん要望: 動かしたカードの順番を自由に決めたい。
  //  既定は「停滞が長い順」だが、それだと現場で決めた「今日はこの順」が読み直しで消える)
  const BOARD_VIEW = <%- JSON.stringify(boardView) %>;
  let dragCard = null;
  let dragFromCol = null;   // 掴んだときの列。ドラッグ中に DOM を動かすので closest では判定できない
  let dragHome = null;      // 元の位置 (どこにも落とさず離したときに戻す)
  let dropped = false;
  // ドラッグ直後の click でリンクへ飛ばない (Codex R1 medium: dragend の後に click を
  // 発火するブラウザがある。drop の fetch を中断させないためにも一拍だけ抑止する)
  let suppressClick = false;

  // 空列の「—」の出し入れ。ドラッグでカードが出入りしても見た目が食い違わないようにする
  function refreshEmpty(col) {
    if (!col) return;
    const body = col.querySelector('.kb-body');
    const empty = body?.querySelector('.kb-empty');
    if (!body || !empty) return;
    empty.style.display = body.querySelector('.kb-card') ? 'none' : '';
  }
  function refreshEmptyAll() { document.querySelectorAll('.kb-col[data-col]').forEach(refreshEmpty); }

  // 掴んでいるカードを、どのカードの前に差し込むか (中心より上に来たら、そのカードの前)。
  // 検索で隠しているカードは位置を持たないので飛ばす
  function insertTargetIn(body, y) {
    const els = [...body.querySelectorAll('.kb-card:not(.dragging)')].filter((e) => e.style.display !== 'none');
    for (const el of els) {
      const box = el.getBoundingClientRect();
      if (y < box.top + box.height / 2) return el;
    }
    return null;
  }

  // その列に**いま並んでいるカードの順番をまるごと**送る。
  // 動かした 1 枚だけを送る方式だと、既定順のカードと混ざったときに順番が定まらない。
  // 検索で隠しているカードも DOM 上の位置のまま含める (絞り込み中の並べ替えで他が飛ばない)
  async function saveOrder(col) {
    const items = [...col.querySelectorAll('.kb-card[data-draft]')]
      .map((c) => ({ id: Number(c.dataset.draft), kind: c.dataset.kind || '' }));
    if (items.length === 0) return true;
    try {
      const res = await fetch('/apps/product-hub/api/board/reorder', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ view: BOARD_VIEW, col: col.dataset.col, items }),
      });
      const j = await res.json();
      if (!j.ok) { alert(j.error || '並び順を保存できませんでした'); return false; }
      return true;
    } catch (err) {
      alert('通信エラー: ' + err.message);
      return false;
    }
  }

  document.querySelectorAll('.kb-card[draggable="true"]').forEach(function (card) {
    card.addEventListener('dragstart', function (e) {
      dragCard = card;
      dragFromCol = card.closest('.kb-col');
      dragHome = { parent: card.parentNode, next: card.nextSibling };
      dropped = false;
      suppressClick = true;
      card.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      try { e.dataTransfer.setData('text/plain', card.dataset.draft); } catch (_) {}
    });
    card.addEventListener('dragend', function () {
      card.classList.remove('dragging');
      document.querySelectorAll('.kb-col.drop-ok').forEach((c) => c.classList.remove('drop-ok'));
      // 列の外で離した = 取りやめ。プレビューで動かした DOM を元の位置に戻す
      if (!dropped && dragHome) dragHome.parent.insertBefore(card, dragHome.next);
      refreshEmptyAll();
      dragCard = null; dragFromCol = null; dragHome = null;
      setTimeout(function () { suppressClick = false; }, 300);
    });
    card.querySelector('.kb-card-link')?.addEventListener('click', function (e) {
      if (suppressClick) e.preventDefault();
    });
  });

  document.querySelectorAll('.kb-col[data-col]').forEach(function (col) {
    col.addEventListener('dragover', function (e) {
      if (!dragCard) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      col.classList.add('drop-ok');
      // 落ちる位置をその場で見せる (掴んだカード自体を差し込み位置へ動かす)。
      // 位置が変わらないときは触らない — 毎回 DOM を動かすとドラッグがガタつく
      const body = col.querySelector('.kb-body');
      if (!body) return;
      const target = insertTargetIn(body, e.clientY);
      // すでにその位置にいるなら触らない (nextSibling は EJS の改行がテキストノードで
      // 挟まるので nextElementSibling で見る)
      if (target ? dragCard.nextElementSibling === target : body.lastElementChild === dragCard) return;
      if (target) body.insertBefore(dragCard, target); else body.appendChild(dragCard);
      refreshEmptyAll();
    });
    col.addEventListener('dragleave', function (e) {
      // 子要素間の移動でチラつかないよう、列の外に出たときだけ消す
      if (!col.contains(e.relatedTarget)) col.classList.remove('drop-ok');
    });
    col.addEventListener('drop', async function (e) {
      e.preventDefault();
      col.classList.remove('drop-ok');
      if (!dragCard) return;
      const card = dragCard;
      const from = dragFromCol;
      const to = col.dataset.col;
      dropped = true;
      // 同じ列の中の並べ替え = 工程は動かさない。保存できた画面はもう正しい形なので読み直さない。
      // 失敗したときだけ読み直す (並んだ見た目だけ残ると「保存された」と誤読する — Codex R1 中)
      if (from === col) {
        if (!await saveOrder(col)) location.reload();
        return;
      }
      let moved = false;
      try {
        const res = await fetch('/apps/product-hub/api/drafts/' + card.dataset.draft + '/board-move', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            view: BOARD_VIEW,
            kind: card.dataset.kind || 'top',
            to: to,
            expected_current: card.dataset.current || null,
          }),
        });
        const j = await res.json();
        if (j.ok) moved = true; else alert(j.error || '移動できませんでした');
      } catch (err) {
        alert('通信エラー: ' + err.message);
      }
      // 工程が動いたときだけ、落とした位置を並び順として残す (失敗時に位置だけ残ると
      // 読み直しで元の列に戻ったカードが変な順で並ぶ)
      if (moved) await saveOrder(col);
      // 「出品・展開」に落とした = 楽天に出す番 (2026-09-01 中原さん要望)。工程移動が済んだあとに
      // 確認を出し、OK なら 画像転送 → 公開で登録 まで続ける。取りやめても工程移動は残る。
      // 楽天が済み/対象外の商品 (他モールの展開で戻ってきた等) には聞かない
      if (moved && BOARD_VIEW === 'main' && to === 'listing'
          && card.dataset.rk !== 'done' && card.dataset.rk !== 'skip') {
        await listToRakuten(card.dataset.draft, card.dataset.name || '');
      }
      // 成否どちらでも読み直す (成功 = 列とステータスの再描画 / 失敗 = カードを元の位置へ)
      location.reload();
    });
  });

  // ─── 画像の重要度セレクト (その場で保存)。TOP・商品詳細の両カードに出る ───
  document.querySelectorAll('.kb-priority').forEach(function (s) {
    // select の操作でカードのドラッグが始まらないようにする
    s.addEventListener('mousedown', function () {
      const card = s.closest('.kb-card');
      if (card) card.setAttribute('draggable', 'false');
    });
    ['mouseup', 'mouseleave', 'blur'].forEach(function (ev) {
      s.addEventListener(ev, function () {
        const card = s.closest('.kb-card');
        if (card) card.setAttribute('draggable', 'true');
      });
    });
    s.addEventListener('change', async function () {
      // 同じ商品のセレクトは TOP/詳細 の 2 枚ある。続けて変えると応答の順序で
      // 画面と DB が食い違うので、保存が終わるまで同じ商品のものは全部止める (Codex R2 medium)
      const sameDraft = [...document.querySelectorAll('.kb-priority[data-draft="' + s.dataset.draft + '"]')];
      sameDraft.forEach(function (o) { o.disabled = true; });
      try {
        const res = await fetch('/apps/product-hub/api/drafts/' + s.dataset.draft + '/image-priority', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ value: s.value }),
        });
        const j = await res.json();
        if (!j.ok) { alert(j.error || '保存に失敗しました'); location.reload(); return; }
        // 色を選択肢に追従させる (再読込なしで見た目だけ更新)。
        // 重要度は**商品単位**なので、同じ商品の別カード (TOP ↔ 商品詳細) も一緒に揃える —
        // 揃えないと画面の中で違う重要度が並んで見え、どちらが本当か分からなくなる
        const PR = <%- JSON.stringify(imagePriorities) %>;
        const p = PR.find((x) => x.value === s.value);
        document.querySelectorAll('.kb-priority[data-draft="' + s.dataset.draft + '"]').forEach(function (o) {
          o.value = s.value;
          o.style.background = p ? p.bg : '';
          o.style.color = p ? p.fg : '';
          // 枠線も揃える (初期描画は border-color も重要度色。ここを抜くと枠だけ前の色が残る)
          o.style.borderColor = p ? p.fg + '33' : '';
          o.style.fontWeight = p ? '600' : '';
        });
      } catch (err) {
        alert('通信エラー: ' + err.message);
        location.reload();
      } finally {
        sameDraft.forEach(function (o) { o.disabled = false; });
      }
    });
  });
</script>
