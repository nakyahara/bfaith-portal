<%- include('_header') %>
<style>
  /* かんばん: 列 = 工程、カード = 商品。列は横スクロール、列の中は縦スクロール */
  .kb { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; align-items: flex-start; }
  .kb-col { flex: 0 0 232px; background: #eef2f7; border-radius: 10px; padding: 8px; }
  .kb-col.system { background: #f1f5f9; border: 1px dashed #cbd5e1; }
  .kb-col-head { display: flex; align-items: baseline; gap: 6px; padding: 2px 4px 8px; }
  .kb-col-title { font-size: 13px; font-weight: 700; }
  .kb-col-count { font-size: 12px; color: #64748b; }
  .kb-col-role { font-size: 11px; color: #94a3b8; padding: 0 4px 6px; }
  .kb-body { max-height: 62vh; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
  .kb-card { display: block; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
             padding: 8px; text-decoration: none; color: #1f2430; }
  .kb-card:hover { border-color: #93c5fd; box-shadow: 0 1px 4px rgba(15,23,42,.08); }
  .kb-card.stalled { border-color: #fca5a5; background: #fff7f7; }
  .kb-card-top { display: flex; gap: 7px; }
  .kb-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 5px; border: 1px solid #e2e8f0;
              background: #f8fafc; flex: 0 0 auto; }
  .kb-name { font-size: 12px; font-weight: 600; line-height: 1.35; overflow: hidden;
             display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .kb-code { font-family: ui-monospace, Consolas, monospace; font-size: 10px; color: #94a3b8; }
  .kb-meta { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; margin-top: 6px; font-size: 11px; }
  .kb-assignee { display: inline-flex; align-items: center; gap: 4px; color: #475569; }
  .kb-unassigned { color: #b45309; font-weight: 600; }
  .kb-stall { color: #b91c1c; font-weight: 700; }
  .kb-img { font-size: 10px; padding: 1px 6px; border-radius: 999px; background: #e2e8f0; color: #475569; }
  .kb-img.done { background: #dcfce7; color: #166534; }
  .kb-img.todo { background: #fef3c7; color: #92400e; }
  .kb-progress { height: 3px; background: #e2e8f0; border-radius: 999px; margin-top: 6px; overflow: hidden; }
  .kb-progress > i { display: block; height: 100%; background: #60a5fa; }
  .kb-empty { font-size: 11px; color: #94a3b8; text-align: center; padding: 10px 0; }
  .kb-track-title { font-size: 12px; font-weight: 700; color: #475569; margin: 14px 0 6px; }
  .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
  .chip { display: inline-block; border: 1px solid #cbd5e1; background: #fff; border-radius: 999px;
          padding: 4px 12px; font-size: 12px; text-decoration: none; color: #475569; }
  .chip.on { background: #2563eb; border-color: #2563eb; color: #fff; font-weight: 600; }
</style>

<div class="wrap wide">
  <div class="filters">
    <span style="font-size:15px; font-weight:700;">🔁 工程ボード</span>
    <a class="chip <%= !assigneeParam && !unassignedOnly ? 'on' : '' %>" href="/apps/product-hub/board">すべて</a>
    <% if (me) { %>
      <a class="chip <%= assigneeParam === 'me' ? 'on' : '' %>" href="/apps/product-hub/board?assignee=me">
        自分のボール (<%= me.name %>)
      </a>
    <% } %>
    <a class="chip <%= unassignedOnly ? 'on' : '' %>" href="/apps/product-hub/board?filter=unassigned">未割り当て</a>
    <select id="assignee-select" style="width:auto; font-size:12px;">
      <option value="">担当者で絞る…</option>
      <% for (const s of staff) { %>
        <option value="<%= s.id %>" <%= String(assigneeId) === String(s.id) && assigneeParam !== 'me' ? 'selected' : '' %>><%= s.name %></option>
      <% } %>
    </select>
    <span style="flex:1"></span>
    <span class="muted"><%= board.total %> 件<%= board.truncated ? ' (上限まで表示)' : '' %></span>
    <a class="btn btn-sm" href="/apps/product-hub">一覧で見る</a>
  </div>

  <% if (!me && assigneeParam === 'me') { %>
    <div class="banner-warn">
      ログイン中のアカウントに担当者が紐づいていません。
      <a href="/apps/product-hub/staff">担当者・工程</a> で、あなたの担当者にポータルのメールアドレスを設定してください。
    </div>
  <% } %>

  <!-- 本流 -->
  <div class="kb">
    <% for (const col of board.columns) { %>
      <div class="kb-col <%= col.role_code ? '' : 'system' %>">
        <div class="kb-col-head">
          <span class="kb-col-title"><%= col.label %></span>
          <span class="kb-col-count"><%= col.cards.length %></span>
        </div>
        <div class="kb-col-role">
          <%= col.role_code ? '' : '⚙️ 自動' %><%= col.stall_days ? `${col.role_code ? '' : ' / '}${col.stall_days}日で警告` : '' %>
        </div>
        <div class="kb-body">
          <% if (col.cards.length === 0) { %>
            <div class="kb-empty">—</div>
          <% } %>
          <% for (const c of col.cards) { %>
            <a class="kb-card <%= c.stalledDays ? 'stalled' : '' %>" href="/apps/product-hub/detail/<%= c.id %>">
              <div class="kb-card-top">
                <% if (c.first_image_id) { %>
                  <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
                <% } else { %>
                  <div class="kb-thumb"></div>
                <% } %>
                <div style="min-width:0;">
                  <div class="kb-name"><%= c.name %></div>
                  <div class="kb-code"><%= c.ne_code %></div>
                </div>
              </div>
              <div class="kb-meta">
                <% if (c.current && c.current.assignee_name) { %>
                  <span class="kb-assignee">
                    <span class="wf-dot" style="background:<%= c.current.assignee_color || '#94a3b8' %>"></span><%= c.current.assignee_name %>
                  </span>
                <% } else if (c.current && c.current.role_code) { %>
                  <span class="kb-unassigned">未割り当て</span>
                <% } %>
                <% if (c.stalledDays) { %><span class="kb-stall">⚠️<%= c.stalledDays %>日</span><% } %>
                <span class="kb-img <%= c.imageDone ? 'done' : 'todo' %>">
                  🖼 <%= c.imageDone ? '済' : (c.imageCurrent ? c.imageCurrent.label : '—') %>
                </span>
              </div>
              <div class="kb-progress"><i style="width:<%= c.totalCount ? Math.round(c.doneCount / c.totalCount * 100) : 0 %>%"></i></div>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- 終端列: 完了 -->
    <div class="kb-col" style="background:#f0fdf4;">
      <div class="kb-col-head">
        <span class="kb-col-title">✅ 完了</span>
        <span class="kb-col-count"><%= board.doneTotal %></span>
      </div>
      <div class="kb-col-role"><%= board.doneTotal > board.doneCards.length ? `直近 ${board.doneCards.length} 件を表示` : '' %></div>
      <div class="kb-body">
        <% if (board.doneCards.length === 0) { %><div class="kb-empty">—</div><% } %>
        <% for (const c of board.doneCards) { %>
          <a class="kb-card" href="/apps/product-hub/detail/<%= c.id %>">
            <div class="kb-card-top">
              <% if (c.first_image_id) { %>
                <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
              <% } else { %><div class="kb-thumb"></div><% } %>
              <div style="min-width:0;">
                <div class="kb-name"><%= c.name %></div>
                <div class="kb-code"><%= c.ne_code %></div>
              </div>
            </div>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 画像トラック -->
  <div class="kb-track-title">🖼 画像トラック <span style="font-weight:400; color:#94a3b8;">— 基本情報が入った時点から本流と並行で走ります</span></div>
  <div class="kb">
    <% for (const col of board.imageColumns) { %>
      <div class="kb-col">
        <div class="kb-col-head">
          <span class="kb-col-title"><%= col.label %></span>
          <span class="kb-col-count"><%= col.cards.length %></span>
        </div>
        <div class="kb-col-role"><%= col.stall_days ? `${col.stall_days}日で警告` : '' %></div>
        <div class="kb-body" style="max-height:40vh;">
          <% if (col.cards.length === 0) { %><div class="kb-empty">—</div><% } %>
          <% for (const c of col.cards) { %>
            <a class="kb-card" href="/apps/product-hub/detail/<%= c.id %>?tab=tab-images">
              <div class="kb-card-top">
                <% if (c.first_image_id) { %>
                  <img class="kb-thumb" src="<%= thumbnailUrl(c.first_image_id, 160, c.first_image_mtime) %>" alt="" loading="lazy" referrerpolicy="no-referrer">
                <% } else { %><div class="kb-thumb"></div><% } %>
                <div style="min-width:0;">
                  <div class="kb-name"><%= c.name %></div>
                  <div class="kb-code"><%= c.ne_code %></div>
                </div>
              </div>
              <div class="kb-meta">
                <% if (c.imageCurrent && c.imageCurrent.assignee_name) { %>
                  <span class="kb-assignee">
                    <span class="wf-dot" style="background:<%= c.imageCurrent.assignee_color || '#94a3b8' %>"></span><%= c.imageCurrent.assignee_name %>
                  </span>
                <% } else { %>
                  <span class="kb-unassigned">未割り当て</span>
                <% } %>
                <span class="kb-img">本流: <%= c.current ? c.current.label : '完了' %></span>
              </div>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <p class="muted" style="margin-top:14px;">
    カードをクリックすると商品の詳細が開き、そこで工程を進められます。
    保留・除外にした商品はこのボードには出ません（<a href="/apps/product-hub">一覧</a>で確認できます）。
  </p>
</div>

<script>
  const sel = document.getElementById('assignee-select');
  if (sel) {
    sel.addEventListener('change', function () {
      const v = sel.value;
      location.href = v ? '/apps/product-hub/board?assignee=' + encodeURIComponent(v) : '/apps/product-hub/board';
    });
  }
</script>
