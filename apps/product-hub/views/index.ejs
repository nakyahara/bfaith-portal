<%- include('_header') %>
<div class="wrap">
  <% if (notionPending > 0) { %>
    <div class="banner-warn">
      ⚠️ Notion カード未作成のドラフトが <strong><%= notionPending %> 件</strong> あります
      <button class="btn btn-sm" id="retry-all-btn">まとめて再作成</button>
      <span class="muted" id="retry-all-result"></span>
    </div>
  <% } %>

  <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px; flex-wrap:wrap;">
    <a class="btn <%= !statusFilter ? 'btn-primary' : '' %>" href="/apps/product-hub">
      すべて (<%= Object.values(counts).reduce((a, b) => a + b, 0) %>)
    </a>
    <% for (const s of statuses) { %>
      <a class="btn <%= statusFilter === s ? 'btn-primary' : '' %>" href="/apps/product-hub?status=<%= s %>">
        <%= statusLabels[s] %> (<%= counts[s] %>)
      </a>
    <% } %>
    <span style="flex:1"></span>
    <a class="btn btn-primary" href="/apps/product-hub/new">＋ 新規登録</a>
  </div>

  <!-- NE商品コードからの一括登録 -->
  <div class="card" style="margin-bottom:14px; border-color:#bae6fd;">
    <details>
      <summary style="cursor:pointer; font-size:14px; font-weight:600;">
        商品コードから一括登録
        <% if (intake.pending > 0 && intake.initialized) { %>
          <span class="muted" style="font-weight:400">／ NEに未取込の新商品 <%= intake.pending %> 件</span>
        <% } %>
      </summary>
      <p class="muted" style="margin:10px 0;">
        NE商品マスタにある商品コードを貼り付けると、ドラフトをまとめて作ります。
        <strong>バリエーションは代表商品コード単位で1件にまとまります</strong>（楽天は1ページ＝代表コード単位のため）。
        商品名・税率はNEから初期値が入ります。
        （一度に最大 <%= maxRegisterCodes %> 件。改行またはカンマ区切り）
      </p>
      <textarea id="reg-codes" rows="5" placeholder="sgs-or&#10;sgs-cm&#10;flaxseed" style="width:100%; font-family:monospace; font-size:13px;"></textarea>
      <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
        <button class="btn" id="reg-preview-btn">先に確認する</button>
        <button class="btn btn-primary" id="reg-run-btn">登録する</button>
        <span class="muted" id="reg-result"></span>
      </div>
      <div id="reg-detail" style="margin-top:10px;"></div>
      <% if (isAdmin) { %>
      <div style="margin-top:12px; padding-top:10px; border-top:1px dashed #e2e8f0;">
        <div class="muted" style="font-size:12px; margin-bottom:6px;">
          自動取込 (毎日09:30):
          <% if (intake.initialized) { %>
            初回シード済み (<%= String(intake.seededAt).slice(0, 10) %>)。未取込の新商品 <%= intake.pending %> 件
          <% } else { %>
            <strong style="color:#b45309">初回シード未実施</strong> — 実行するとNEの現在の全商品 (<%= intake.mirrorSingles %>件) を「既存」として記録し、以後の新商品から自動でドラフト化します
          <% } %>
          ／ これまでの自動作成 <%= intake.autoCreated %> 件
        </div>
        <div style="display:flex; align-items:center; gap:10px;">
          <button class="btn btn-sm" id="intake-run-btn">NE取込を今すぐ実行</button>
          <span class="muted" id="intake-run-result" style="font-size:12px;"></span>
        </div>
      </div>
      <% } %>
    </details>
  </div>

  <% if (!notionCardEnabled) { %>
    <p class="muted" style="margin:-6px 0 14px; font-size:12px;">
      ℹ️ Notionカードの自動作成は停止中です（新商品はこのアプリが起点）。
    </p>
  <% } %>

  <!-- 検証用: Notion 既存カードの選択取り込み (読み取り専用) -->
  <div class="card" style="margin-bottom:14px;">
    <details>
      <summary style="cursor:pointer; font-size:14px; font-weight:600;">Notion から取り込み (検証用)</summary>
      <p class="muted" style="margin:10px 0;">
        Notion 商品マスターの既存カードを、商品コード指定でこのアプリに取り込みます。
        <strong>読み取り専用です — 取り込んだ商品からNotionへ書き戻すことはありません。</strong>
        既存カードの運用はこれまで通りNotion側で行ってください。
        （一度に最大 <%= maxImportCodes %> 件。改行またはカンマ区切り）
      </p>
      <textarea id="import-codes" rows="4" placeholder="FBNS-BU-BU&#10;pr_xxxxx" style="width:100%; font-family:monospace; font-size:13px;"></textarea>
      <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
        <button class="btn btn-primary" id="import-btn">取り込む</button>
        <span class="muted" id="import-result"></span>
      </div>
      <div id="import-detail" style="margin-top:10px;"></div>
    </details>
  </div>

  <!-- 楽天 店舗内カテゴリ一覧 (マスタ。全置き換え取り込みなので admin 限定) -->
  <% if (isAdmin) { %>
  <div class="card" style="margin-bottom:14px;">
    <details>
      <summary style="cursor:pointer; font-size:14px; font-weight:600;">
        楽天 店舗内カテゴリ一覧
        <span class="muted" style="font-weight:400">／ 取り込み済み <%= shopCategoryCount %> 件</span>
      </summary>
      <!-- 楽天から直接同期 (2026-08-02、Category API 2.0)。これが通常の運用 -->
      <div style="margin:10px 0; padding:10px 12px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px;">
        <div style="font-size:13px; margin-bottom:8px;">
          <strong>楽天から直接取り込みます</strong> (お店の棚＝店舗内カテゴリ。楽天ジャンルとは別物)。
          カテゴリIDも一緒に取得するので、貼り付けは不要です。
        </div>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
          <button class="btn btn-primary" id="cat-sync-btn">楽天から取り込む</button>
          <label class="muted" style="font-size:12px; display:inline-flex; align-items:center; gap:4px; margin:0;">
            <input type="checkbox" id="cat-sync-refresh" style="width:auto;"> 楽天から取り直す (通常は不要・24時間キャッシュ)
          </label>
          <span class="muted" id="cat-sync-result"></span>
        </div>
      </div>
      <details>
        <summary style="cursor:pointer; font-size:13px; color:#64748b;">貼り付けで取り込む (APIが使えないときのみ)</summary>
        <p class="muted" style="margin:8px 0;">
          RMS の店舗内カテゴリ一覧を貼り付けて取り込みます (<strong>全置き換え</strong>。1行1カテゴリ、最大 <%= maxShopCategoryLines %> 行)。
          階層は「&gt;」区切り (例: <code>犬用品 &gt; おやつ</code>)。カテゴリIDが分かる場合は「ID,カテゴリ名」でも取り込めます。
        </p>
        <textarea id="cat-lines" rows="6" placeholder="犬用品 &gt; おやつ&#10;犬用品 &gt; おやつ &gt; 無添加&#10;123456,猫用品 &gt; ケア用品" style="width:100%; font-family:monospace; font-size:13px;"></textarea>
        <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
          <button class="btn" id="cat-import-btn">貼り付けを取り込む (全置き換え)</button>
          <span class="muted" id="cat-import-result"></span>
        </div>
      </details>
      <p class="muted" style="margin:10px 0 0; font-size:12px;">
        取り込むと各ドラフトの「カテゴリ・属性」タブで選択でき、AIが初期候補を入れます。
        <strong>商品への割り当て自体のRMS反映は未対応</strong>です (公開時にRMS画面で設定)。
      </p>
    </details>
  </div>

  <!-- NE配送方法 → 楽天配送方法グループ (商品ページ表記の「発送方法」とデフォルト選択に使用) -->
  <div class="card" style="margin-bottom:14px;">
    <details id="shipmap-details">
      <summary style="cursor:pointer; font-size:14px; font-weight:600;">
        配送方法マッピング (NE → 楽天)
      </summary>
      <p class="muted" style="margin:10px 0;">
        NE商品マスタの「配送方法」を楽天の配送方法グループに割り当てます。
        商品ページ表記の「発送方法」欄と、楽天出品カードの配送方法の初期値に使われます。
        名前が一致するものは自動で推測されます (<span style="color:#b45309">推測</span> 表示。保存すると確定)。
      </p>
      <div id="shipmap-body" class="muted">読み込み中…</div>
      <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
        <button class="btn btn-primary" id="shipmap-save-btn" style="display:none;">保存</button>
        <span class="muted" id="shipmap-result"></span>
      </div>
    </details>
  </div>
  <% } %>

  <div class="card">
    <% if (drafts.length === 0) { %>
      <p class="muted">ドラフトがありません。「＋ 新規登録」から商品を追加してください。</p>
    <% } else { %>
      <table class="list">
        <thead>
          <tr>
            <th style="width:60px">画像</th>
            <th>商品名</th>
            <th style="width:160px">商品コード</th>
            <th style="width:120px">バリエーション</th>
            <th style="width:110px">ステータス</th>
            <th style="width:170px">工程 / 担当</th>
            <th style="width:90px">出自</th>
            <th style="width:90px">Notion</th>
            <th style="width:150px">更新日時</th>
          </tr>
        </thead>
        <tbody>
          <% for (const d of drafts) { %>
            <tr>
              <td>
                <% if (d.thumb) { %>
                  <img class="thumb" src="<%= d.thumb %>" alt="" loading="lazy" referrerpolicy="no-referrer">
                <% } else { %>
                  <div class="thumb" style="display:flex;align-items:center;justify-content:center;color:#cbd5e1;">—</div>
                <% } %>
              </td>
              <td><a href="/apps/product-hub/detail/<%= d.id %>" style="color:#1d4ed8; text-decoration:none;"><%= d.name %></a></td>
              <td>
                <button type="button" class="copy-code" data-code="<%= d.ne_code %>" title="クリックでコピー"><%= d.ne_code %><span class="copy-hint">📋</span></button>
              </td>
              <td style="font-size:12px;">
                <% if (d.variation.kind === 'variation') { %>
                  あり <span class="muted">(<%= d.variation.memberCount %>SKU)</span>
                  <% if (d.variation.isChild) { %><br><span style="color:#b45309">⚠️ 子SKU</span><% } %>
                <% } else if (d.variation.kind === 'single') { %>
                  <span class="muted">なし</span>
                <% } else if (d.variation.kind === 'conflict') { %>
                  <span style="color:#b45309" title="NE商品マスタに同じ商品コードが重複しています">⚠️ 重複</span>
                <% } else { %>
                  <span class="muted" title="NE商品マスタに見つかりません">—</span>
                <% } %>
              </td>
              <td><span class="badge badge-<%= d.status %>"><%= statusLabels[d.status] || d.status %></span></td>
              <td style="font-size:12px;">
                <% if (d.workflow && d.workflow.current) { %>
                  <%= d.workflow.current.label %>
                  <% if (d.workflow.current.assignee_name) { %>
                    <br><span class="wf-dot" style="background:<%= d.workflow.current.assignee_color || '#94a3b8' %>"></span>
                    <%= d.workflow.current.assignee_name %>
                  <% } else { %>
                    <br><span class="muted">未割り当て</span>
                  <% } %>
                  <% if (d.workflow.stalledDays) { %>
                    <br><span style="color:#b91c1c; font-weight:600;">⚠️ <%= d.workflow.stalledDays %>日 停滞</span>
                  <% } %>
                <% } else if (d.workflow && d.workflow.totalCount > 0) { %>
                  <span style="color:#166534; font-weight:600;">全工程 完了</span>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <td>
                <% if (d.source === 'notion_import') { %>
                  <span class="muted" title="Notionから取り込み (Notion側が正・書き戻さない)">📥 取り込み</span>
                <% } else { %>
                  <span class="muted">アプリ</span>
                <% } %>
              </td>
              <td>
                <% if (d.notion_card_status === 'created') { %>
                  <span title="Notionカード作成済み">✅</span>
                <% } else if (d.notion_card_status === 'failed') { %>
                  <span title="作成失敗: <%= d.notion_card_error || '' %>">❌ 失敗</span>
                <% } else { %>
                  <span class="muted">⏳ 未作成</span>
                <% } %>
              </td>
              <td class="muted"><%= (d.updated_at || '').replace('T', ' ').slice(0, 16) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script>
  const retryAllBtn = document.getElementById('retry-all-btn');
  if (retryAllBtn) {
    retryAllBtn.addEventListener('click', async () => {
      retryAllBtn.disabled = true;
      retryAllBtn.textContent = '作成中…';
      try {
        const res = await fetch('/apps/product-hub/api/notion-retry-all', { method: 'POST' });
        const json = await res.json();
        document.getElementById('retry-all-result').textContent =
          json.ok ? '全件作成できました。再読み込みします…' : (json.tried + '件中 ' + json.failed + '件失敗 (詳細は各ドラフト参照)');
        setTimeout(() => location.reload(), 1200);
      } catch (e) {
        document.getElementById('retry-all-result').textContent = '通信エラー: ' + e.message;
        retryAllBtn.disabled = false;
        retryAllBtn.textContent = 'まとめて再作成';
      }
    });
  }

  // ─── NE取込の手動実行 (admin。cron を待たずシード/取込を回す) ───
  const intakeBtn = document.getElementById('intake-run-btn');
  if (intakeBtn) {
    intakeBtn.addEventListener('click', async () => {
      const out = document.getElementById('intake-run-result');
      if (!confirm('NE新商品の取込を今すぐ実行します。\n初回は「シード」(現在の全商品を既存として記録・ドラフトは作らない) になります。\n\nよろしいですか?')) return;
      intakeBtn.disabled = true;
      out.textContent = '実行中…';
      try {
        const res = await fetch('/apps/product-hub/api/intake/run', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
        });
        const j = await res.json();
        if (!j.ok) { out.textContent = ''; alert(j.error || '実行に失敗しました'); return; }
        out.textContent = j.mode === 'seed'
          ? '✅ 初回シード完了 (' + j.seeded + '件を既存として記録)。明日以降の新商品から自動でドラフト化されます'
          : '✅ 取込完了: 新規ドラフト ' + j.created + ' 件' + (j.merged ? ' / 既存グループへ集約 ' + j.merged + ' 件' : '');
        setTimeout(() => location.reload(), 2500);
      } catch (e) {
        out.textContent = '通信エラー: ' + e.message;
      } finally {
        intakeBtn.disabled = false;
      }
    });
  }

  // ─── 楽天から直接同期 (Category API 2.0。通常はこちら) ───
  const catSyncBtn = document.getElementById('cat-sync-btn');
  if (catSyncBtn) {
    async function postCatSync(force, expectedSnapshot) {
      const res = await fetch('/apps/product-hub/api/shop-categories/sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        // refresh はチェックが入っているときだけ (既定は miniPC の 24h キャッシュを使う)。
        // 承認 (force) では取り直さず、確認した内容の指紋を送って一致したときだけ適用させる
        body: JSON.stringify({
          force: force === true,
          refresh: force !== true && document.getElementById('cat-sync-refresh')?.checked === true,
          expectedSnapshot: expectedSnapshot || undefined,
        }),
      });
      return res.json();
    }
    catSyncBtn.addEventListener('click', async () => {
      const out = document.getElementById('cat-sync-result');
      if (!confirm('楽天から店舗内カテゴリを取り込みます (全置き換え)。\n楽天側に無いカテゴリは選択肢から外れます (選択済みのドラフトには残ります)。\n\nよろしいですか?')) return;
      catSyncBtn.disabled = true;
      out.textContent = '楽天から取得中…';
      try {
        let json = await postCatSync(false, null);
        if (!json.ok && json.error === 'too_few') {
          if (!confirm((json.message || '件数が大きく減ります') + '\n\nそれでも置き換えますか?')) { out.textContent = ''; return; }
          // 確認したのと同じ内容にだけ適用させる (指紋が変わっていればサーバーが 409 で止める)
          json = await postCatSync(true, json.expectedSnapshot);
        }
        if (!json.ok) { out.textContent = ''; alert(json.message || json.error || '取り込みに失敗しました'); return; }
        out.textContent = '取り込み ' + json.imported + ' 件'
          + (json.duplicates ? ' (同名パス ' + json.duplicates + ' 件を除外)' : '')
          + (json.skipped ? ' / 取り込めなかった ' + json.skipped + ' 件' : '')
          + (json.deactivated ? ' / 一覧から外れた ' + json.deactivated + ' 件' : '');
        if (json.skipped) {
          alert('次のカテゴリは取り込めませんでした:\n'
            + (json.skippedDetail || []).map(function (s) { return '・' + s.path + ' — ' + s.reason; }).join('\n'));
        }
        setTimeout(function () { location.reload(); }, 1500);
      } catch (e) {
        out.textContent = '通信エラー: ' + e.message;
      } finally {
        catSyncBtn.disabled = false;
      }
    });
  }

  // ─── 貼り付けでの取り込み (フォールバック) ───
  const catImportBtn = document.getElementById('cat-import-btn');
  if (catImportBtn) {
    async function postCatImport(text, force) {
      const res = await fetch('/apps/product-hub/api/shop-categories/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text, force: force === true }),
      });
      return res.json();
    }
    catImportBtn.addEventListener('click', async () => {
      const text = document.getElementById('cat-lines').value;
      const out = document.getElementById('cat-import-result');
      if (!text.trim()) { out.textContent = 'カテゴリ一覧を貼り付けてください'; return; }
      if (!confirm('店舗内カテゴリ一覧を「全置き換え」で取り込みます。\n貼り付けに無いカテゴリは選択肢から外れます (選択済みのドラフトには残ります)。\n\nよろしいですか?')) return;
      catImportBtn.disabled = true;
      out.textContent = '取り込み中…';
      try {
        let json = await postCatImport(text, false);
        if (!json.ok && json.error === 'too_few') {
          // サーバー側の激減ガード。件数を見せて再確認してから force で再送
          if (!confirm((json.message || '件数が大きく減ります') + '\n\nそれでも置き換えますか?')) { out.textContent = ''; return; }
          json = await postCatImport(text, true);
        }
        if (!json.ok) { out.textContent = ''; alert(json.message || json.error || '取り込みに失敗しました'); return; }
        out.textContent = '取り込み ' + json.imported + ' 件'
          + (json.duplicates ? ' (重複 ' + json.duplicates + ' 行を除外)' : '')
          + (json.deactivated ? ' / 一覧から外れた ' + json.deactivated + ' 件' : '');
        setTimeout(function () { location.reload(); }, 1500);
      } catch (e) {
        out.textContent = '通信エラー: ' + e.message;
      } finally {
        catImportBtn.disabled = false;
      }
    });
  }

  // ─── 配送方法マッピング (NE → 楽天。admin のみパネルが出る) ───
  const shipmapDetails = document.getElementById('shipmap-details');
  if (shipmapDetails) {
    let shipmapLoaded = false;
    shipmapDetails.addEventListener('toggle', async () => {
      if (!shipmapDetails.open || shipmapLoaded) return;
      shipmapLoaded = true;
      const body = document.getElementById('shipmap-body');
      try {
        const res = await fetch('/apps/product-hub/api/shipping-method-map');
        const json = await res.json();
        if (!json.ok) { body.textContent = json.error || '読み込みに失敗しました'; return; }
        if (!json.rows.length) { body.textContent = 'NE商品マスタに配送方法がまだありません'; return; }
        const table = document.createElement('table');
        table.className = 'list';
        table.innerHTML = '<thead><tr><th>NE配送方法</th><th style="width:90px">商品数</th><th style="width:260px">楽天配送方法グループ</th><th style="width:80px">状態</th></tr></thead>';
        const tbody = document.createElement('tbody');
        for (const row of json.rows) {
          const tr = document.createElement('tr');
          const tdLabel = document.createElement('td');
          tdLabel.textContent = row.neLabel;
          const tdCount = document.createElement('td');
          tdCount.textContent = row.count ? row.count + '件' : '—';
          if (!row.count) tdCount.title = 'NE商品マスタに現存しない配送方法 (過去の割当)';
          const tdSel = document.createElement('td');
          const sel = document.createElement('select');
          sel.style.width = '100%';
          sel.dataset.neLabel = row.neLabel;
          const optNone = document.createElement('option');
          optNone.value = '';
          optNone.textContent = '未割当';
          sel.appendChild(optNone);
          for (const gid of Object.keys(json.groups)) {
            const opt = document.createElement('option');
            opt.value = gid;
            opt.textContent = gid + ': ' + json.groups[gid];
            if (row.rakutenGroup === gid) opt.selected = true;
            sel.appendChild(opt);
          }
          tdSel.appendChild(sel);
          const tdState = document.createElement('td');
          tdState.style.fontSize = '12px';
          if (row.saved) { tdState.textContent = '保存済'; tdState.style.color = '#166534'; }
          else if (row.rakutenGroup) { tdState.textContent = '推測'; tdState.style.color = '#b45309'; }
          else { tdState.textContent = '未割当'; tdState.className = 'muted'; }
          tr.append(tdLabel, tdCount, tdSel, tdState);
          tbody.appendChild(tr);
        }
        table.appendChild(tbody);
        body.replaceChildren(table);
        document.getElementById('shipmap-save-btn').style.display = '';
      } catch (e) {
        body.textContent = '通信エラー: ' + e.message;
      }
    });
    const shipmapSaveBtn = document.getElementById('shipmap-save-btn');
    shipmapSaveBtn.addEventListener('click', async () => {
      const out = document.getElementById('shipmap-result');
      const entries = Array.from(document.querySelectorAll('#shipmap-body select')).map((sel) => ({
        ne_label: sel.dataset.neLabel,
        rakuten_group: sel.value,
      }));
      shipmapSaveBtn.disabled = true;
      out.textContent = '保存中…';
      try {
        const res = await fetch('/apps/product-hub/api/shipping-method-map', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entries: entries }),
        });
        const json = await res.json();
        out.textContent = json.ok ? '保存しました (' + json.saved + '件)' : (json.error || '保存に失敗しました');
      } catch (e) {
        out.textContent = '通信エラー: ' + e.message;
      } finally {
        shipmapSaveBtn.disabled = false;
      }
    });
  }

  // ─── Notion 取り込み (検証用) ───
  const OUTCOME_LABELS = {
    imported: '取り込み',
    updated: '再取り込み (更新)',
    not_found: 'Notionに見つかりません',
    conflict_portal: 'アプリ起点の商品のため取り込みません',
    conflict_page_id: '別のNotionカードが紐づいています (要確認)',
    failed: '失敗',
  };
  const importBtn = document.getElementById('import-btn');
  importBtn.addEventListener('click', async () => {
    const codes = document.getElementById('import-codes').value;
    if (!codes.trim()) {
      document.getElementById('import-result').textContent = '商品コードを入力してください';
      return;
    }
    importBtn.disabled = true;
    importBtn.textContent = '取り込み中…';
    document.getElementById('import-detail').innerHTML = '';
    try {
      const res = await fetch('/apps/product-hub/api/notion-import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ codes }),
      });
      const json = await res.json();
      if (!json.results) {
        document.getElementById('import-result').textContent = 'エラー: ' + (json.error || '不明');
        return;
      }
      const s = json.summary;
      document.getElementById('import-result').textContent =
        '新規 ' + s.imported + ' / 更新 ' + s.updated + ' / 未検出 ' + s.not_found
        + ' / 衝突 ' + (s.conflict_portal + s.conflict_page_id) + ' / 失敗 ' + s.failed;

      const rows = json.results.map(function (r) {
        var note = r.error || '';
        if (!note && r.skipped_fields && r.skipped_fields.length) {
          note = '未取込: ' + r.skipped_fields.join(', ');
        }
        // draftId は整数のはず。型が変わっても innerHTML に流し込まない (Codex R1 low-8)
        var link = Number.isSafeInteger(r.draftId)
          ? '<a href="/apps/product-hub/detail/' + r.draftId + '">開く</a>'
          : '';
        return '<tr><td><code>' + escapeHtml(r.ne_code) + '</code></td><td>'
          + escapeHtml(OUTCOME_LABELS[r.outcome] || r.outcome) + '</td><td class="muted">'
          + escapeHtml(note) + '</td><td>' + link + '</td></tr>';
      }).join('');
      document.getElementById('import-detail').innerHTML =
        '<table class="list"><tbody>' + rows + '</tbody></table>';

      if (s.imported + s.updated > 0) setTimeout(function () { location.reload(); }, 2500);
    } catch (e) {
      document.getElementById('import-result').textContent = '通信エラー: ' + e.message;
    } finally {
      importBtn.disabled = false;
      importBtn.textContent = '取り込む';
    }
  });

  // ─── 商品コードから一括登録 ───
  const REG_LABELS = {
    created: '新規ドラフト',
    merged: '既存にまとまる',
    not_in_ne: 'NE商品マスタに無い',
  };
  async function runRegister(dryRun) {
    const codes = document.getElementById('reg-codes').value;
    const out = document.getElementById('reg-result');
    if (!codes.trim()) { out.textContent = '商品コードを入力してください'; return; }
    const btns = [document.getElementById('reg-preview-btn'), document.getElementById('reg-run-btn')];
    btns.forEach(function (b) { b.disabled = true; });
    out.textContent = dryRun ? '確認中…' : '登録中…';
    document.getElementById('reg-detail').innerHTML = '';
    try {
      const res = await fetch('/apps/product-hub/api/register-codes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ codes: codes, dry_run: dryRun }),
      });
      const j = await res.json();
      if (!j.ok) { out.textContent = 'エラー: ' + (j.error || '不明'); return; }
      const s = j.summary;
      out.textContent = (dryRun ? '【確認】' : '') + '新規 ' + s.created + ' / 既存にまとまる ' + s.merged
        + ' / NEに無い ' + s.not_in_ne + '（' + j.results.length + ' コード）';

      const rows = j.results.map(function (r) {
        var note = '';
        if (r.groupKey && r.groupKey !== r.code) note = '→ ' + r.groupKey + ' にまとめ';
        if (r.outcome === 'created' && r.name) note = (note ? note + ' / ' : '') + r.name;
        if (r.outcome === 'created' && dryRun && r.taxPercent == null) {
          note = (note ? note + ' / ' : '') + '⚠️税率はNE未設定のため空欄';
        }
        var link = Number.isSafeInteger(r.draftId)
          ? '<a href="/apps/product-hub/detail/' + r.draftId + '">開く</a>' : '';
        return '<tr><td><code>' + escapeHtml(r.code) + '</code></td><td>'
          + escapeHtml(REG_LABELS[r.outcome] || r.outcome) + '</td><td class="muted">'
          + escapeHtml(note) + '</td><td>' + link + '</td></tr>';
      }).join('');
      document.getElementById('reg-detail').innerHTML =
        '<table class="list"><tbody>' + rows + '</tbody></table>';
      if (!dryRun && s.created > 0) setTimeout(function () { location.reload(); }, 2500);
    } catch (e) {
      out.textContent = '通信エラー: ' + e.message;
    } finally {
      btns.forEach(function (b) { b.disabled = false; });
    }
  }
  document.getElementById('reg-preview-btn').addEventListener('click', function () { runRegister(true); });
  document.getElementById('reg-run-btn').addEventListener('click', function () {
    if (!confirm('入力した商品コードのドラフトを作成します。よろしいですか?')) return;
    runRegister(false);
  });

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
</script>
