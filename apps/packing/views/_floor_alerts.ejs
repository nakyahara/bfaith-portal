<%# 現場間バナー (2026-08-21 / 受領導線の改修 2026-08-23 / 小さく表示 2026-09-13)。12秒ポーリング。
    赤 = 通知 (「確認して閉じる」= 既読のみ・全端末から消える)
    緑 = 再ピック完了で受領待ち (タスク状態から導出。「現物を受け取った」= 業務アクション。
         対象バッチの作業画面なら受領ボタン、それ以外は対象伝票を開くリンク)
    小さく表示: 不足が立て続くとバナーが梱包画面を埋めて操作しづらかった (2026-09-13 現場の声)。
    1件 = 1行に詰め、よそのバッチ宛ての緑 (対象伝票を開く) が 2件以上なら 1行にまとめて「一覧 ▼」で開く。
    赤と、自分のバッチ宛ての緑 (受領ボタン) は行動が要るのでまとめない %>
<style>
  #floorAlerts { position: sticky; top: 0; z-index: 9999; max-height: 40vh; overflow-y: auto; }
  #floorAlerts .fa-row { display: flex; align-items: center; gap: 8px; padding: 5px 10px; color: #fff; font-size: 15px; font-weight: 800; line-height: 1.3; border-bottom: 1px solid #fff; }
  #floorAlerts .fa-msg { flex: 1; min-width: 0; }
  #floorAlerts .fa-one { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #floorAlerts .fa-sub { font-weight: 400; font-size: 13px; margin-left: 6px; }
  #floorAlerts .fa-btn { flex: none; padding: 8px 12px; border: none; border-radius: 8px; background: #fff; font-weight: 800; font-size: 14px; white-space: nowrap; text-decoration: none; cursor: pointer; }
</style>
<div id="floorAlerts"></div>
<script>
(function () {
  var box = document.getElementById('floorAlerts');
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var GREEN = '#2b8a3e';
  var lastReadyKey = null;
  var last = { alerts: [], ready: [] };
  var othersOpen = false;   // まとめた緑を開いているか (12秒ごとの再描画で閉じないよう持っておく)
  function btn(attrs, label, fg) {
    return '<button type="button" class="fa-btn" ' + attrs + ' style="color:' + fg + '">' + label + '</button>';
  }
  function link(href, label, fg) {
    return '<a class="fa-btn" href="' + esc(href) + '" style="color:' + fg + '">' + label + '</a>';
  }
  function isMine(g) {
    return window.__packingBatchId != null && Number(window.__packingBatchId) === Number(g.batch_id);
  }
  function refOf(g) {
    return (g.folder_name || '-') + (g.slip_seq != null ? ' #' + g.slip_seq : '');
  }
  function greenRow(g, child) {
    var seq = Number(g.slip_seq), bid = Number(g.batch_id);
    var action = isMine(g)
      ? btn('data-receive="1" data-seq="' + seq + '" data-batch="' + bid + '"', '📦 現物を受け取った (#' + seq + ' を再開)', GREEN)
      : link('/apps/packing/work/' + bid + '?seq=' + seq, '対象伝票を開く', GREEN);
    var items = (g.tasks || []).map(function (t) { return esc(t.product_name || t.sku) + ' × ' + esc(t.req_qty); }).join(' / ');
    var pickers = (g.tasks || []).map(function (t) { return t.claimed_by; }).filter(function (v, i, a) { return v && a.indexOf(v) === i; }).join(',');
    return '<div class="fa-row" style="background:' + GREEN + (child ? '; padding-left:26px' : '') + '">'
      + '<span class="fa-msg fa-one">✅ ' + esc(refOf(g)) + ' の不足分が届きます'
      + '<small class="fa-sub">' + items
      + '（ピッカー: ' + esc(pickers || '-') + ' / 依頼: ' + esc(g.requested_by || '-') + '）</small></span>'
      + action
      + '</div>';
  }
  function render(alerts, ready) {
    last = { alerts: alerts, ready: ready };
    var html = alerts.map(function (a) {
      // 色 = 次の行動: 赤 = 1階が動く (在庫なし・カート等) / 橙 = 3階が後で持ってくる (🕒 待つだけ)
      var bg = (a.kind === 'picking_shortage' && String(a.message).indexOf('🕒') === 0) ? '#e8590c' : '#e03131';
      // 赤の文面は省略しない (何が起きたかを読ませる) ので折り返しあり
      return '<div class="fa-row" style="background:' + bg + '">'
        + '<span class="fa-msg">' + esc(a.message) + (a.requested_by && a.kind !== 'picking_shortage' && a.kind !== 'stockout' ? '<small class="fa-sub">（依頼: ' + esc(a.requested_by) + '）</small>' : '') + '</span>'
        // 対象伝票へのリンク (在庫なしバナー等)。同一サイトの /apps/ 配下だけ通す
        + (a.link && /^\/apps\/[A-Za-z0-9_\-\/?=&.#]*$/.test(String(a.link)) ? link(a.link, '対象伝票を開く', bg) : '')
        + btn('data-ack="' + a.id + '"', '確認して閉じる', bg)
        + '</div>';
    }).join('');
    // ready は伝票単位 (その伝票の再ピックが全部完了したものだけ = 受領処理の条件と同じ)
    var mine = ready.filter(isMine);
    var others = ready.filter(function (g) { return !isMine(g); });
    html += mine.map(function (g) { return greenRow(g, false); }).join('');
    if (others.length >= 2) {
      html += '<div class="fa-row" style="background:' + GREEN + '">'
        + '<span class="fa-msg fa-one">✅ 不足分が届きます (' + others.length + '件)'
        + '<small class="fa-sub">' + others.map(function (g) { return esc(refOf(g)); }).join(' / ') + '</small></span>'
        + btn('data-toggle-others="1"', othersOpen ? '閉じる ▲' : '一覧 ▼', GREEN)
        + '</div>';
      if (othersOpen) html += others.map(function (g) { return greenRow(g, true); }).join('');
    } else {
      othersOpen = false;   // 1件以下になったら畳んだ状態に戻す (次にまとまったときは閉じて出す)
      html += others.map(function (g) { return greenRow(g, false); }).join('');
    }
    box.innerHTML = html;
    box.querySelectorAll('[data-ack]').forEach(function (b) {
      b.addEventListener('click', function () {
        fetch('/apps/packing/api/floor-alerts/' + b.dataset.ack + '/ack', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
          .then(poll).catch(function () {});
      });
    });
    box.querySelectorAll('[data-receive]').forEach(function (b) {
      b.addEventListener('click', function () {
        // 受領の本体は作業画面側 (作業者・キュー・再描画を持つ)。ここは依頼を投げるだけ
        document.dispatchEvent(new CustomEvent('packing:receive', {
          detail: { slipSeq: Number(b.dataset.seq), batchId: Number(b.dataset.batch) },
        }));
      });
    });
    box.querySelectorAll('[data-toggle-others]').forEach(function (b) {
      b.addEventListener('click', function () {
        othersOpen = !othersOpen;
        render(last.alerts, last.ready);
      });
    });
  }
  function poll() {
    return fetch('/apps/packing/api/floor-alerts')
      .then(function (r) { return r.json(); })
      .then(function (b) {
        var ready = b.repickReady || [];
        render(b.alerts || [], ready);
        // 受領待ちの集合が変わったら作業画面へ知らせる (操作が無くても「⏳待ち」が解けるように)
        var key = ready.map(function (g) { return g.batch_id + ':' + g.slip_seq + ':' + (g.tasks || []).map(function (t) { return t.id + t.status; }).join('+'); }).join(',');
        if (key !== lastReadyKey) {
          lastReadyKey = key;
          document.dispatchEvent(new CustomEvent('packing:repick-ready', { detail: { items: ready } }));
        }
      })
      .catch(function () { /* 次のpollで回復 */ });
  }
  window.__floorAlertsPoll = poll;   // 受領直後などに即時更新したいとき用
  poll();
  setInterval(poll, 12000);
})();
</script>
