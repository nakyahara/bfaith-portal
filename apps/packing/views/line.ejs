<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="manifest" href="/apps/packing/manifest.json">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    body { background: #f4f5f7; }
    .line-wrap { max-width: 640px; margin: 0 auto; padding: 12px; }
    .line-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
    .line-head h1 { font-size: 1.3rem; margin: 8px 0; }
    .line-kind { font-size: .85rem; color: #555; }
    .phase-card { background: #fff; border-radius: 12px; padding: 16px; margin: 12px 0; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .phase-card h2 { font-size: 1.05rem; margin: 0 0 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .phase-card.disabled { opacity: .55; }
    .phase-meta { font-size: .95rem; color: #333; line-height: 1.9; }
    .phase-meta b { font-size: 1.2rem; }
    .big-btn { display: block; width: 100%; padding: 18px; font-size: 1.25rem; font-weight: 700; border: none;
      border-radius: 10px; background: #1a73e8; color: #fff; margin-top: 10px; }
    .big-btn.finish { background: #188038; }
    .big-btn:disabled { background: #aaa; }
    .done-note { background: #e6f4ea; border-radius: 8px; padding: 10px 12px; margin-top: 8px; font-size: .95rem; }
    .handover { background: #fef7e0; border-radius: 8px; padding: 10px 12px; margin: 8px 0; font-size: 1rem; }
    .form-row { margin: 10px 0; }
    .form-row label { display: block; font-size: .9rem; color: #555; margin-bottom: 4px; }
    .form-row input[type=number], .form-row input[type=text], .form-row select { width: 100%; padding: 12px; font-size: 1.2rem;
      border: 1px solid #ccc; border-radius: 8px; box-sizing: border-box; background: #fff; }
    .worker-row { display: flex; gap: 8px; align-items: center; margin: 10px 0; }
    .worker-row select { flex: 1; padding: 10px; font-size: 1.05rem; border-radius: 8px; }
    .timer { font-variant-numeric: tabular-nums; color: #1a73e8; font-weight: 700; }
    /* ← 一覧へ: リンクでは小さくて押しにくい (2026-08-31 現場意見) → ボタン */
    .list-btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 18px; font-size: 1.05rem; font-weight: 700;
      border: 2px solid #1a73e8; border-radius: 10px; background: #fff; color: #1a73e8; text-decoration: none; }
    .list-btn.bottom { display: flex; justify-content: center; width: 100%; box-sizing: border-box; padding: 16px; margin: 16px 0 8px; }
    /* 計測中の表示 (2026-08-31 現場意見: 動いているのか止まっているのか分からない) */
    .live { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-weight: 700;
      font-size: .95rem; background: #e6f4ea; color: #137333; white-space: nowrap; }
    .live::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #1e8e3e; animation: blink 1.2s ease-in-out infinite; }
    .live.stopped { background: #fff3cd; color: #7a5b00; }
    .live.stopped::before { background: #f9ab00; animation: none; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
    @media (prefers-reduced-motion: reduce) { .live::before { animation: none; } }
    .live-bar { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding: 10px 14px; border-radius: 0 0 12px 12px; font-weight: 700; font-size: 1.05rem; }
    .live-bar.running { background: #137333; color: #fff; }
    .live-bar.paused { background: #f9ab00; color: #202124; }
    .live-bar .timer { color: inherit; font-size: 1.15rem; }
    .top-link { font-size: .9rem; }
    .big-btn.pause { background: #f9ab00; color: #202124; }
    .big-btn.resume { background: #1a73e8; padding: 22px; font-size: 1.4rem; }
    .paused-card { background: #fff3cd; border: 2px solid #f9ab00; }
    .reason-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
    .reason-grid button { padding: 16px 8px; font-size: 1.1rem; border: 1px solid #ccc; border-radius: 10px; background: #fff; }
    .reason-grid .cancel { grid-column: 1 / -1; background: none; border: none; color: #868e96; }
    .reason-grid .wide { grid-column: 1 / -1; }
    .stop-hint { font-size: .9rem; color: #555; margin-top: 8px; }
    .split-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    /* 伝票ごとの依頼 (紙で作業する分) */
    .req-grid { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 10px; }
    .req-grid button { padding: 14px 10px; font-size: 1.05rem; font-weight: 700; border: 1px solid #ccc; border-radius: 10px; background: #fff; text-align: left; }
    .req-grid button:disabled { opacity: .5; }
    .slip-info { background: #f1f3f5; border-radius: 8px; padding: 10px 12px; margin-top: 8px; font-size: .95rem; line-height: 1.7; }
    .slip-info .nm { font-weight: 700; }
    .open-req { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px; margin-top: 8px; background: #fff3cd; font-size: .95rem; }
    .open-req.ready { background: #e6f4ea; }
    .open-req.stockout { background: #ffe3e3; border: 2px solid #e03131; }
    .open-req .grow { flex: 1 1 200px; }
    .open-req button { padding: 10px 14px; font-size: 1rem; font-weight: 700; border-radius: 8px; border: 1px solid #ccc; background: #fff; }
    .open-req button.primary { background: #188038; color: #fff; border-color: #188038; }
    .open-req button.danger { background: #e03131; color: #fff; border-color: #e03131; }
    .sub { font-size: .85rem; color: #868e96; font-weight: 400; }
    /* 再ピック依頼の複数選択 (例外処理監査 PR-3): 明細ごとにトグル + 数量ボタン (prompt 廃止) */
    .rp-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; max-height: 48vh; overflow-y: auto; }
    .rp-row { border: 1px solid #ccc; border-radius: 10px; background: #fff; }
    .rp-row.on { border-color: #1a73e8; background: #e8f0fe; }
    .rp-row.locked { background: #f1f3f5; color: #868e96; }
    .rp-toggle { width: 100%; text-align: left; padding: 12px 10px; font-size: 1.05rem; font-weight: 700; border: none; background: none; color: inherit; }
    .rp-qty { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 10px 10px; align-items: center; }
    .rp-qty button { min-width: 48px; padding: 10px 8px; font-size: 1.05rem; border: 1px solid #ccc; border-radius: 8px; background: #fff; }
    .rp-qty button.sel { background: #1a73e8; color: #fff; border-color: #1a73e8; }
    .rp-qty input { width: 110px; padding: 10px; font-size: 1.05rem; border: 1px solid #ccc; border-radius: 8px; }
  </style>
</head>
<body>
  <%- include('_floor_alerts') %>
  <%
    const jst = (t) => t ? new Date(Date.parse(t) + 32400000).toISOString().slice(11, 16) : '—';
    // 所要 = 終了 - 開始 - 一時中断の合計 (工程行 paused_total_sec)
    const durMin = (a, b, pausedSec = 0) => (a && b)
      ? Math.max(0, Math.round((Date.parse(b) - Date.parse(a) - (pausedSec || 0) * 1000) / 6000) / 10) : null;
    const isPaused = batch.status === 'paused';
    // 経過タイマー: 中断中は pause_started_at で止めて見せる。積み上がった中断秒は差し引く
    const timerAttrs = (r) => `data-since="${r.started_at}" data-paused="${r.paused_total_sec || 0}"`
      + (isPaused && batch.pause_started_at ? ` data-frozen="${batch.pause_started_at}"` : '');
    const sort = runs.find((r) => r.phase === 'sort') || null;
    const run = runs.find((r) => r.phase === 'run') || null;
    const runPlanned = run ? run.planned_count : (kind === 'melt' ? (sort?.final_count ?? null) : batch.slip_count);
    // 計測中 = 開始済み・未停止の工程 (仕分け or 流し)。中断中は「計測停止中」
    const liveRun = (sort && !sort.finished_at) ? sort : ((run && !run.finished_at) ? run : null);
    const liveLabel = liveRun ? (liveRun.phase === 'sort' ? '仕分け' : '機械流し') : null;
    const lineName = kind === 'melt' ? 'MELT-LINE' : 'PAS-LINE';
    const transferredIn = dailyTotal.transferredIn || 0;
    // 伝票ごとの依頼: 保留 (再ピック) 中の伝票と、その状態 (候補=未送信 / requested,claimed=依頼中 / fulfilled=受取可)
    const slipList = (typeof slips !== 'undefined' && Array.isArray(slips)) ? slips : [];
    const incList = (typeof incidents !== 'undefined' && Array.isArray(incidents)) ? incidents : [];
    const repickMap = (typeof repickBySlip !== 'undefined' && repickBySlip) ? repickBySlip : {};
    const taskList = (typeof tasks !== 'undefined' && Array.isArray(tasks)) ? tasks : [];
    const heldSlips = slipList.filter((x) => x.status === 'held' && x.holdReason === 'repick');
    // 🚫 3階「在庫なし」の報告 (seq → 商品) と、1階が確認して閉じた伝票 (出荷保留・在庫なし) — 例外処理監査 PR-1
    const stockoutMap = (typeof stockoutBySlip !== 'undefined' && stockoutBySlip) ? stockoutBySlip : {};
    const ackSet = new Set((typeof stockoutAckSeqs !== 'undefined' && stockoutAckSeqs) || []);   // 「在庫なしを確認」できる伝票 (サーバーと同じ条件)
    const stockoutSlips = slipList.filter((x) => x.status === 'cancelled' && x.holdReason === 'stockout');
    const jstHm = (iso) => { const t = Date.parse(iso || ''); return Number.isFinite(t) ? new Date(t + 9 * 3600e3).toISOString().slice(11, 16) : ''; };
    const TASK_LABEL = { requested: '⏳ ピッカー対応待ち', claimed: '🏃 ピッカーが取りに行っています', fulfilled: '✅ 届きました' };
  %>
  <script>
    // ブラウザ側の時刻表示 (伝票情報の 🕒/❌ 行用)。サーバー側 EJS の jstHm とは実行環境が別なので名前を分ける
    function formatJstHm(iso) { const t = Date.parse(iso || ''); return Number.isFinite(t) ? new Date(t + 9 * 3600e3).toISOString().slice(11, 16) : ''; }
  </script>
  <%
  %>
  <% if (liveRun) { %>
    <div class="live-bar <%= isPaused ? 'paused' : 'running' %>">
      <span><%= isPaused ? '⏸ 計測停止中 (一時中断)' : `⏱ 計測中 — ${liveLabel}` %></span>
      <span class="timer" <%- timerAttrs(liveRun) %>></span>
    </div>
  <% } %>
  <div class="line-wrap">
    <div class="line-head">
      <div>
        <h1>🏭 <%= batch.folder_name || batch.tb_key %> — <%= lineName %></h1>
        <div class="line-kind"><%= hikiateClass %></div>
      </div>
      <a class="list-btn" href="/apps/packing/">← 一覧へ戻る</a>
    </div>

    <div class="phase-meta">
      予定 <b><%= batch.slip_count %></b> 件
      <span class="st <%= batch.status %>"><%= statusLabels[batch.status] || batch.status %></span>
      <% if (batch.worker) { %> / 👤 <%= batch.worker %><% } %>
      <% if (liveRun) { %> / <span class="live <%= isPaused ? 'stopped' : '' %>"><%= isPaused ? '計測停止中' : '計測中' %></span><% } %>
    </div>
    <div class="done-note" style="background:#e8f0fe;">
      📟 本日このラインの累計: 出荷 <b><%= dailyTotal.total %></b> 件
      (機械通過 <b><%= dailyTotal.machine %></b> 件<% if (transferredIn > 0) { %>・うち MELT-LINE から移した分 <b><%= transferredIn %></b> 件<% } %>) — 日付が変わるとリセット
    </div>

    <% if (isPaused) { %>
      <div class="phase-card paused-card">
        <h2>⏸ 一時中断中 <span style="color:#868e96; font-size:.9em"><%= batch.pause_reason ? `(${batch.pause_reason})` : '' %></span></h2>
        <div class="phase-meta">経過時間は止まっています。作業を続けるときは再開してください (出荷は終了していません)。</div>
        <button class="big-btn resume" onclick="send('resume')">▶ 再開する</button>
      </div>
    <% } %>

    <div class="worker-row">
      <label for="worker">作業者</label>
      <select id="worker">
        <option value="">選択してください</option>
        <% for (const w of workers) { %><option value="<%= w.name %>"><%= w.name %></option><% } %>
      </select>
    </div>

    <% if (kind === 'melt') { %>
      <div class="phase-card">
        <h2>① 仕分け <% if (sort?.finished_at) { %><span>✅</span><% } else if (sort && !isPaused) { %><span class="live">計測中</span><% } %></h2>
        <% if (!sort) { %>
          <p>機械に流す前の仕分けを開始します (<%= batch.slip_count %>件)。</p>
          <button class="big-btn" onclick="send('line_sort_start')">仕分け開始</button>
        <% } else if (!sort.finished_at) { %>
          <div class="phase-meta">開始 <%= jst(sort.started_at) %> — 経過 <span class="timer" <%- timerAttrs(sort) %>></span>
            <% if (sort.worker) { %> / 👤 仕分け: <%= sort.worker %><% } %></div>
          <% if (!isPaused) { %>
            <button class="big-btn pause" type="button" onclick="openPause()">⏸ 一時中断 (資材交換・休憩など → あとで再開)</button>
          <% } %>
          <div class="split-row">
            <div class="form-row">
              <label>PAS-LINE (3つ折り) へ移す件数</label>
              <input type="number" id="sortToPas" inputmode="numeric" min="0" max="<%= sort.planned_count %>" value="0" oninput="sortCalc()">
            </div>
            <div class="form-row">
              <label>その他の方法で出荷する件数 (配送方法変更など)</label>
              <input type="number" id="sortOther" inputmode="numeric" min="0" max="<%= sort.planned_count %>" value="0" oninput="sortCalc()">
            </div>
          </div>
          <div class="handover">🏭 機械に流す件数: <b id="sortFlowCount"><%= sort.planned_count %></b> 件
            (伝票 <%= sort.planned_count %> − 除外 <span id="sortExShow">0</span>)
            <div class="sub" style="margin-top:4px">PAS-LINE へ移した件数は PAS の「本日の累計」に自動で足されます (機械カウンタと合わせるため)</div></div>
          <div class="form-row">
            <label>備考 (任意)</label>
            <input type="text" id="sortNote" maxlength="200" placeholder="例: 2件をネコポス手動へ変更">
          </div>
          <button class="big-btn finish" onclick="sortDone(<%= sort.planned_count %>)" <%= isPaused ? 'disabled' : '' %>>仕分け完了</button>
        <% } else { %>
          <div class="done-note">
            <%= jst(sort.started_at) %>〜<%= jst(sort.finished_at) %> (所要 <%= durMin(sort.started_at, sort.finished_at, sort.paused_total_sec) %> 分) / 他の方法へ <b><%= sort.excluded_count ?? 0 %></b> 件<% if (sort.to_pas_count) { %> (うち PAS-LINE へ <b><%= sort.to_pas_count %></b> 件)<% } %>
            → 機械に流す件数 <b><%= sort.final_count %></b> 件 (伝票 <%= sort.planned_count %> 件)
            <% if (sort.worker) { %> / 👤 仕分け: <%= sort.worker %><% } %>
            <% if (sort.note) { %> / 備考: <%= sort.note %><% } %>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="phase-card <%= (kind === 'melt' && !sort?.finished_at) ? 'disabled' : '' %>">
      <h2><%= kind === 'melt' ? '② 機械流し' : '機械流し' %> <% if (run?.finished_at) { %><span>✅</span><% } else if (run && !isPaused) { %><span class="live">計測中</span><% } %></h2>
      <% if (kind === 'melt' && sort?.finished_at && !run) { %>
        <div class="handover">📋 申し送り: 仕分け後の機械に流す件数は <b><%= sort.final_count %></b> 件です
          <% if (sort.worker) { %>(仕分け担当: <%= sort.worker %>)<% } %></div>
        <div class="phase-meta" style="color:#c5221f;">
          流す人が仕分けと違う場合は、上の「作業者」を自分の名前に切り替えてから開始してください
        </div>
      <% } %>
      <% if (batch.status === 'done' && run?.finished_at) { %>
        <div class="done-note">
          🏁 完了 — <%= jst(run.started_at) %>〜<%= jst(run.finished_at) %> /
          出荷完了 <b><%= run.final_count %></b> 件 (予定 <%= run.planned_count %> 件・うち手動 <%= run.manual_count || 0 %> 件)
          <% if (run.worker) { %> / 👤 流し: <%= run.worker %><% } %>
          <% if (run.note) { %> / 備考: <%= run.note %><% } %>
          <div style="margin-top:6px"><button type="button" style="border:none; background:none; color:#1a73e8; text-decoration:underline; font-size:.9rem"
            onclick="if (confirm('上の「作業者」で選んだ人を流し担当に修正します。よろしいですか?')) send('takeover')">担当を修正 (作業者欄で選んでから)</button></div>
        </div>
      <% } else if (!run) { %>
        <% if (kind === 'melt' && !sort?.finished_at) { %>
          <p>先に仕分けを完了してください。</p>
        <% } else { %>
          <p>機械流しを開始します (<%= runPlanned %>件)。</p>
          <button class="big-btn" onclick="send('line_start')">流し開始</button>
        <% } %>
      <% } else if (!run.finished_at) { %><!-- 流し作業中: まず時間を止める (件数は次の画面) -->
        <div class="phase-meta">開始 <%= jst(run.started_at) %> — 経過 <span class="timer" <%- timerAttrs(run) %>></span>
          <% if (run.worker) { %> / 👤 流し: <%= run.worker %><% } %>
          <% if (run.paused_total_sec) { %> / 中断 <%= Math.round(run.paused_total_sec / 60) %> 分<% } %></div>
        <% if (!isPaused) { %>
          <button class="big-btn pause" type="button" onclick="openPause()">⏸ 一時中断 (資材交換・休憩など → あとで再開)</button>
          <button class="big-btn finish" onclick="stopRun()">⏹ 流し終了 (このバッチを終わる → 件数入力へ)</button>
          <div class="stop-hint">資材の交換などで少し止めるだけなら「一時中断」。「流し終了」はこのバッチの機械流しを終えるときだけ押してください。</div>
        <% } %>
      <% } else if (run.final_count == null) { %><!-- 停止済み: 件数を入力するまで完了しない -->
        <div class="done-note" style="background:#fef7e0;">
          ⏸ <%= jst(run.started_at) %>〜<%= jst(run.finished_at) %> で停止しました (所要 <%= durMin(run.started_at, run.finished_at, run.paused_total_sec) %> 分<%= run.paused_total_sec ? `・中断 ${Math.round(run.paused_total_sec / 60)} 分を除く` : '' %>)。
          <% if (run.worker) { %>👤 流し: <%= run.worker %> — <% } %><b>件数を入力すると完了になります。</b>
        </div>
        <div class="handover">📟 前回までの累計: 機械通過 <b><%= dailyTotal.machine %></b> 件
          — 梱包機のカウンタ表示から <b><%= dailyTotal.machine %></b> を引いた数が今回の機械通過分です
          <% if (transferredIn > 0) { %>
            <div class="sub" style="margin-top:6px; color:#7a5b00">⚠ うち <b><%= transferredIn %></b> 件は MELT-LINE から移した分 (仕分け完了の時点で足しています)。
              その分をまだ PAS の機械に通していなければ <b><%= dailyTotal.machine - transferredIn %></b> で計算してください</div>
          <% } %></div>
        <div class="form-row">
          <label>出荷完了件数 (手動で流した分も含む)</label>
          <input type="number" id="runFinal" inputmode="numeric" min="0" max="<%= run.planned_count %>" value="<%= run.planned_count %>">
        </div>
        <div class="form-row">
          <label>うち手動で流した件数</label>
          <input type="number" id="runManual" inputmode="numeric" min="0" value="0">
        </div>
        <div class="form-row">
          <label>備考 (任意 — ピッキングミス等)</label>
          <input type="text" id="runNote" maxlength="200">
        </div>
        <button class="big-btn finish" onclick="runDone()">完了を記録</button>
      <% } %>
    </div>

    <% if (slipList.length > 0) { %>
      <div class="phase-card" id="reqCard">
        <h2>📮 伝票ごとの依頼 <span class="sub">再ピック・サイズ変更・再印刷</span></h2>
        <div class="phase-meta" style="font-size:.9rem; color:#555">紙で作業していても、伝票を選べばここから依頼できます (梱包画面と同じ経路で届きます)。</div>
        <%# ❌ ピッキング時の「どこにもない」(PR-2): 3階がもう探した商品。再依頼せず「在庫なしを確認」で出荷保留にする %>
        <% const noneSlips = slipList.filter((x) => x.status === 'pending' && (x.pickingShortages || []).some((p) => p.kind === 'none')); %>
        <% if (noneSlips.length > 0) { %>
          <div style="margin-top:10px; font-weight:700; color:#c92a2a">❌ ピッキング時に「どのロケにもない」 <%= noneSlips.length %> 件 — 3階に無い商品です (再ピック依頼は不要)</div>
          <% for (const ns of noneSlips) { %>
            <div class="open-req stockout" data-seq="<%= ns.seq %>">
              <div class="grow">#<%= ns.seq %> <%= ns.slipNo %> / <%= ns.recipientName || '' %> (NE <%= ns.neSlipNo %>)
                <% for (const p of ns.pickingShortages) { %>
                  <div style="color:<%= p.kind === 'none' ? '#c92a2a' : '#e8590c' %>; font-weight:700"><%= p.kind === 'none' ? '❌' : '🕒' %> <%= p.name || p.sku %> <span class="sub">(<%= p.sku %>)</span> × <%= p.qty %> — <%= p.kind === 'none' ? 'どのロケにもありません' : '後で取りに行きます' %> — 3階 <%= p.picker || '-' %> <%= jstHm(p.at) %></div>
                <% } %>
              </div>
              <% if (ackSet.has(ns.seq)) { %>
                <button type="button" class="danger" onclick="stockoutAck(<%= ns.seq %>)">🚫 在庫なしを確認 → 出荷保留にする (事務へ通知)</button>
              <% } %>
              <%# 退路は商品ごと (同じ伝票に ❌ が2品あるとき、片方だけ見つかった、が言える — Codex R2) %>
              <%# SKU は CSV 由来 = 属性に生で埋めない (data-* + 委譲。onclick に JSON.stringify は ' を守れない — Codex R3) %>
              <% for (const p of ns.pickingShortages.filter((x) => x.kind === 'none')) { %>
                <button type="button" class="found-none" data-seq="<%= ns.seq %>" data-sku="<%= p.sku %>">「<%= p.name || p.sku %>」が手元で見つかった (報告を取り消す)</button>
              <% } %>
            </div>
          <% } %>
        <% } %>
        <% if (heldSlips.length > 0 || incList.length > 0 || stockoutSlips.length > 0) { %>
          <div style="margin-top:10px; font-weight:700">進行中の依頼</div>
          <% for (const hs of heldSlips) {
               // SKU 単位に状態を出す (同一伝票に複数の依頼があり得る — Codex R2)。
               // 受け取れるのは「候補が残っておらず、タスクが全部 届いた (fulfilled)」ときだけ
               const cands = incList.filter((i) => i.slipSeq === hs.seq);
               const tks = taskList.filter((t) => t.slipSeq === hs.seq);
               const ready = cands.length === 0 && tks.length > 0 && tks.every((t) => t.status === 'fulfilled');
               // 3階が「在庫なし」にした商品。他の依頼が残っていなければ「在庫なしを確認」で伝票を閉じられる
               const na = stockoutMap[hs.seq] || [];
               const canAck = na.length > 0 && ackSet.has(hs.seq);
               const nameOf = (sku) => (hs.lines.find((l) => l.sku === sku) || {}).name || sku; %>
            <div class="open-req <%= ready ? 'ready' : (na.length ? 'stockout' : '') %>" data-seq="<%= hs.seq %>">
              <div class="grow">#<%= hs.seq %> <%= hs.slipNo %> / <%= hs.recipientName || '' %> (NE <%= hs.neSlipNo %>)
                <% for (const p of (hs.pickingShortages || [])) { %>
                  <div style="color:<%= p.kind === 'none' ? '#c92a2a' : '#e8590c' %>"><%= p.kind === 'none' ? '❌' : '🕒' %> ピッキング欠品: <%= p.name || p.sku %> × <%= p.qty %> — <%= p.kind === 'none' ? 'どのロケにもありません' : '3階が後で取りに行きます' %> (<%= p.picker || '-' %> <%= jstHm(p.at) %>)</div>
                <% } %>
                <% for (const c of cands) { %>
                  <div>📝 <%= nameOf(c.sku) %> × <%= c.qty %> — <b>未送信</b>
                    <button type="button" class="danger" onclick="resolveInc(<%= c.id %>, 'confirm')">ピッキングへ送信</button>
                    <button type="button" class="found-sku" data-seq="<%= hs.seq %>" data-sku="<%= c.sku %>" data-name="<%= nameOf(c.sku) %>">見つかった</button></div>
                <% } %>
                <% for (const t of tks) { %>
                  <div>🔄 <%= nameOf(t.sku) %> × <%= t.qty %> — <%= TASK_LABEL[t.status] || t.status %>
                    <button type="button" class="found-sku" data-seq="<%= hs.seq %>" data-sku="<%= t.sku %>" data-name="<%= nameOf(t.sku) %>">見つかった</button></div>
                <% } %>
                <% for (const t of na) { %>
                  <div style="color:#c92a2a; font-weight:700">🚫 <%= nameOf(t.sku) %> × <%= t.unavailable_qty ?? t.req_qty %><%= (t.fulfilled_qty || 0) > 0 ? ` (${t.fulfilled_qty}個は他ロケから届きます)` : '' %> — 3階: 在庫なし (<%= t.claimed_by || t.requested_by || '-' %> <%= jstHm(t.updated_at) %>)</div>
                <% } %>
                <% if (na.length > 0 && !canAck) { %>
                  <div class="sub" style="color:#c92a2a">他の商品の再ピック・未送信の候補が片付くと「在庫なしを確認」で出荷保留にできます</div>
                <% } %>
                <% if (cands.length === 0 && tks.length === 0 && na.length === 0) { %><div>⏳ 保留中</div><% } %>
              </div>
              <% if (ready) { %>
                <button type="button" class="primary" onclick="send('receive', { slip_seq: <%= hs.seq %> })">📦 全部受け取った</button>
              <% } %>
              <% if (canAck) { %>
                <button type="button" class="danger" onclick="stockoutAck(<%= hs.seq %>)">🚫 在庫なしを確認 → 出荷保留にする (事務へ通知)</button>
              <% } %>
              <button type="button" onclick="foundSlip(<%= hs.seq %>)">全部見つかった (取下げ)</button>
              <%# ＋ 別の商品も足りない (PR-3・E-2): 依頼していない明細が残っていれば、伝票を選び直さずに追加で送れる %>
              <% const reqSkus = new Set([...cands.map((c) => c.sku), ...tks.map((t) => t.sku), ...na.map((t) => t.sku)].map((v) => String(v || '').trim().toLowerCase()));
                 const hasFree = (hs.lines || []).some((l) => !reqSkus.has(String(l.sku || '').trim().toLowerCase())); %>
              <% if (hasFree) { %><button type="button" onclick="reqRepick(<%= hs.seq %>)">＋ 別の商品も足りない</button><% } %>
            </div>
          <% } %>
          <% for (const ss of stockoutSlips) {
               const notifyState = ((typeof stockoutNotifyBySlip !== 'undefined' && stockoutNotifyBySlip) || {})[ss.seq]; %>
            <div class="open-req" style="background:#f1f3f5; color:#868e96">
              <div class="grow">#<%= ss.seq %> <%= ss.slipNo %> / <%= ss.recipientName || '' %> (NE <%= ss.neSlipNo %>) — 🚫 出荷保留 (在庫なし)・<%= notifyState === 'sent' ? '事務へ通知済み' : '事務への通知待ち (自動で再送中)' %></div>
            </div>
          <% } %>
        <% } %>
        <div class="form-row" style="margin-top:14px">
          <label>伝票を選ぶ (伝票番号・SP番号・お届け先名で絞り込み)</label>
          <input type="text" id="slipFilter" placeholder="例: 1540783 / SP / 山田" oninput="filterSlips()">
          <select id="slipPick" style="margin-top:8px" onchange="showSlip()">
            <option value="">— 伝票を選択 —</option>
          </select>
        </div>
        <div class="slip-info" id="slipInfo" style="display:none"></div>
        <div class="req-grid">
          <button type="button" id="reqRepickBtn" onclick="reqRepick()" disabled>🔄 商品が足りない → 再ピック依頼 (複数の商品を一度に選べます)</button>
          <button type="button" id="reqShipBtn" onclick="reqShip()" disabled>📦 サイズ・配送方法の変更依頼 (事務へ通知)</button>
          <button type="button" id="reqReprintBtn" onclick="reqReprint()" disabled>🖨 伝票の再印刷依頼 (事務へ通知)</button>
        </div>
      </div>
    <% } %>

    <% if (runs.length > 0) { %>
      <div style="text-align:center; margin: 16px 0;">
        <button style="background:none; border:none; color:#c5221f; font-size:.95rem; text-decoration:underline;"
          onclick="lineUndo()">↩ 直前の記録を取り消す</button>
      </div>
    <% } %>

    <a class="list-btn bottom" href="/apps/packing/">← 一覧へ戻る</a>
  </div>

  <div id="pauseBox" class="phase-card" style="display:none; position:fixed; left:12px; right:12px; bottom:12px; max-width:616px; margin:0 auto; box-shadow:0 4px 16px rgba(0,0,0,.25); z-index:50">
    <h2>一時中断の理由</h2>
    <div class="reason-grid">
      <% for (const r of pauseReasons) { %>
        <button type="button" class="pause-reason" data-reason="<%= r %>"><%= r %></button>
      <% } %>
      <button type="button" class="cancel" onclick="document.getElementById('pauseBox').style.display='none'">やめる</button>
    </div>
  </div>

  <div id="reqBox" class="phase-card" style="display:none; position:fixed; left:12px; right:12px; bottom:12px; max-width:616px; margin:0 auto; box-shadow:0 4px 16px rgba(0,0,0,.25); z-index:50; max-height:80vh; overflow:auto">
    <h2 id="reqBoxTitle"></h2>
    <div id="reqBoxBody"></div>
  </div>

  <script>
    const BATCH_ID = <%= batch.id %>;
    const SLIPS = <%- JSON.stringify(slipList).replace(/</g, '\\u003c') %>;
    // 依頼済み判定用 (PR-3): 進行中タスク / 未送信候補 / 3階の在庫なし報告
    const TASKS = <%- JSON.stringify(taskList).replace(/</g, '\\u003c') %>;
    const INCS = <%- JSON.stringify(incList).replace(/</g, '\\u003c') %>;
    const STOCKOUT_MAP = <%- JSON.stringify(stockoutMap).replace(/</g, '\\u003c') %>;
    const METHOD_OPTIONS = <%- JSON.stringify((typeof methodOptions !== 'undefined' && methodOptions) || []).replace(/</g, '\\u003c') %>;
    const TWO_LABELS_OPTION = <%- JSON.stringify((typeof twoLabelsOption !== 'undefined' && twoLabelsOption) || null).replace(/</g, '\\u003c') %>;
    const SHIP_REASONS = <%- JSON.stringify((typeof shipChangeReasons !== 'undefined' && shipChangeReasons) || []).replace(/</g, '\\u003c') %>;
    const workerSel = document.getElementById('worker');
    const savedWorker = localStorage.getItem('packLineWorker');
    if (savedWorker) workerSel.value = savedWorker;
    workerSel.addEventListener('change', () => localStorage.setItem('packLineWorker', workerSel.value));

    // 経過タイマー
    setInterval(() => {
      for (const el of document.querySelectorAll('.timer')) {
        const end = el.dataset.frozen ? Date.parse(el.dataset.frozen) : Date.now();   // 中断中は止めて見せる
        const sec = Math.max(0, Math.floor((end - Date.parse(el.dataset.since)) / 1000) - Number(el.dataset.paused || 0));
        el.textContent = `${Math.floor(sec / 60)}分${String(sec % 60).padStart(2, '0')}秒`;
      }
    }, 1000);

    let sending = false;
    // 1操作 = 1 op_id で最大3回まで同一内容を再送 (通信失敗時)。戻り値 { ok, status, body } / 通信断は null
    async function post(url, payloadObj) {
      const payload = JSON.stringify(payloadObj);
      for (let attempt = 1; ; attempt++) {
        let res;
        try {
          res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload });
        } catch (e) {
          if (attempt >= 3) { alert(`通信エラー: ${e.message}\n電波の良い場所でもう一度お試しください。`); return null; }
          await new Promise((r) => setTimeout(r, 1500));
          continue;   // 同一 op_id で再送 (サーバー側は replay として同じ結果を返す)
        }
        const body = await res.json().catch(() => ({}));
        return { ok: res.ok, status: res.status, body };
      }
    }
    function eventPayload(event, extra = {}) {
      // op_id は1操作につき1回だけ生成し、通信失敗時は同じ内容で再送する
      // (Codex high: タップごとの新op_idだと「保存成功+応答喪失→再タップ」が already_done になる。
      //  特に line_stop はタップ時刻が正なので、同一op_idのreplayで時刻が守られる)
      return {
        op_id: `line-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
        event, worker_name: workerSel.value, client_at: new Date().toISOString(), ...extra,
      };
    }
    async function send(event, extra = {}) {
      if (sending) return;
      const worker = workerSel.value;
      if (!worker) { alert('作業者を選択してください'); return; }
      sending = true;
      try {
        const r = await post(`/apps/packing/api/batches/${BATCH_ID}/events`, eventPayload(event, extra));
        if (!r) return;
        if (!r.ok) {
          alert(r.body.error || `エラー (${r.status})`);
          // 409 = 状態が進んでいる (別端末・応答喪失後の再タップ等) → 画面を実状態に同期
          if (r.status === 409) location.reload();
          return;
        }
        if (r.body && r.body.stockoutNotify && r.body.stockoutNotify !== 'sent') {
          alert('伝票を出荷保留 (在庫なし) にしました。事務への通知はまだ届いていません (自動で再送します)。急ぐなら口頭かチャットで伝えてください');
        }
        reloadKeeping(selectedSlip() ? selectedSlip().seq : 0);
      } finally {
        sending = false;
      }
    }
    function intOf(id, label) {
      const raw = document.getElementById(id).value.trim();
      if (raw === '') { alert(`${label}を入力してください`); return null; }
      const v = Number(raw);
      if (!Number.isInteger(v) || v < 0) { alert(`${label}が不正です`); return null; }
      return v;
    }
    // 仕分けの除外 = PAS-LINE へ移す + その他 (空欄は 0)
    function sortParts() {
      const p = document.getElementById('sortToPas');
      const o = document.getElementById('sortOther');
      const planned = Number(p.max);
      const toPas = p.value.trim() === '' ? 0 : Number(p.value);
      const other = o.value.trim() === '' ? 0 : Number(o.value);
      const valid = Number.isInteger(toPas) && Number.isInteger(other) && toPas >= 0 && other >= 0 && toPas + other <= planned;
      return { planned, toPas, other, ex: toPas + other, valid };
    }
    function sortCalc() {
      const s = sortParts();
      document.getElementById('sortFlowCount').textContent = s.valid ? s.planned - s.ex : '—';
      document.getElementById('sortExShow').textContent = s.valid ? s.ex : '?';
    }
    function sortDone(planned) {
      const s = sortParts();
      if (!s.valid) { alert('他の方法で出荷する件数が不正です (合計は伝票数まで)'); return; }
      const parts = [];
      if (s.toPas > 0) parts.push(`PAS-LINE へ ${s.toPas} 件`);
      if (s.other > 0) parts.push(`その他の方法へ ${s.other} 件`);
      const head = parts.length > 0 ? parts.join('・') + ' → ' : '除外なし → ';
      if (!confirm(`${head}機械に流す ${planned - s.ex} 件で仕分け完了にしますか?`)) return;
      send('line_sort_done', { excluded_count: s.ex, to_pas_count: s.toPas, note: document.getElementById('sortNote').value || null });
    }
    function runDone() {
      const v = intOf('runFinal', '出荷完了件数');
      if (v == null) return;
      const mRaw = document.getElementById('runManual').value.trim();
      const m = mRaw === '' ? 0 : Number(mRaw);
      if (!Number.isInteger(m) || m < 0) { alert('手動で流した件数が不正です'); return; }
      if (!confirm(`出荷完了 ${v} 件 (うち手動 ${m} 件) で終了しますか?`)) return;
      send('line_done', { final_count: v, manual_count: m, note: document.getElementById('runNote').value || null });
    }
    function openPause() { document.getElementById('pauseBox').style.display = 'block'; }
    document.querySelectorAll('.pause-reason').forEach((b) => b.addEventListener('click', () => pauseWith(b.dataset.reason)));
    function pauseWith(reason) {
      document.getElementById('pauseBox').style.display = 'none';
      send('pause', { reason });
    }
    function stopRun() {
      if (!confirm('このバッチの機械流しを終了して件数入力へ進みます。\n(資材交換などで少し止めるだけなら「一時中断」を使ってください)\nよろしいですか?')) return;
      send('line_stop');
    }
    function lineUndo() {
      if (!confirm('直前の記録 (件数→停止→流し開始→仕分け完了→仕分け開始の順) を1段取り消します。よろしいですか?')) return;
      send('undo', { reason: '誤タップ' });
    }

    // ── 伝票ごとの依頼 (紙で作業する MELT/PAS でも再ピック・配送変更・再印刷を出せる — 2026-08-31) ──
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const slipPick = document.getElementById('slipPick');
    const bySeq = new Map(SLIPS.map((x) => [x.seq, x]));
    function slipLabel(x) {
      return `#${x.seq} ${x.slipNo || ''} / ${x.recipientName || ''} (NE ${x.neSlipNo})`;
    }
    function filterSlips() {
      if (!slipPick) return;
      const q = document.getElementById('slipFilter').value.trim().toLowerCase();
      const keep = slipPick.value;
      const opts = ['<option value="">— 伝票を選択 —</option>'];
      for (const x of SLIPS) {
        const hay = `${x.seq} ${x.slipNo || ''} ${x.neSlipNo || ''} ${x.siteOrderNo || ''} ${x.recipientName || ''}`.toLowerCase();
        if (q && !hay.includes(q)) continue;
        opts.push(`<option value="${x.seq}">${esc(slipLabel(x))}</option>`);
      }
      slipPick.innerHTML = opts.join('');
      if (keep && bySeq.has(Number(keep)) && [...slipPick.options].some((o) => o.value === keep)) slipPick.value = keep;
      showSlip();
    }
    function selectedSlip() {
      const v = slipPick ? Number(slipPick.value) : 0;
      return v > 0 ? bySeq.get(v) || null : null;
    }
    function showSlip() {
      const x = selectedSlip();
      const info = document.getElementById('slipInfo');
      for (const id of ['reqRepickBtn', 'reqShipBtn', 'reqReprintBtn']) document.getElementById(id).disabled = !x;
      if (!x) { info.style.display = 'none'; return; }
      const held = x.status === 'held' && x.holdReason === 'repick';
      const stockout = x.status === 'cancelled' && x.holdReason === 'stockout';
      info.innerHTML = `<div class="nm">${esc(slipLabel(x))}</div>`
        + `<div>配送方法: ${esc(x.deliveryMethod || '—')}${x.siteOrderNo ? ` / 受注番号: ${esc(x.siteOrderNo)}` : ''}${held ? ' / <b>⏳ 再ピック保留中</b>' : ''}${stockout ? ' / <b style="color:#c92a2a">🚫 出荷保留 (在庫なし)</b>' : ''}</div>`
        + (x.pickingShortages || []).map((p) => `<div style="color:${p.kind === 'none' ? '#c92a2a' : '#e8590c'}; font-weight:700">${p.kind === 'none' ? '❌' : '🕒'} ピッキング欠品: ${esc(p.name || p.sku)} × ${Number.isFinite(Number(p.qty)) ? Number(p.qty) : 0} — ${p.kind === 'none' ? 'どのロケにもありません (再ピック依頼は不要・「在庫なしを確認」へ)' : '3階が後で取りに行きます'} (${esc(p.picker || '-')} ${formatJstHm(p.at)})</div>`).join('')
        + x.lines.map((l) => `<div>・${esc(l.name)} <span class="sub">(${esc(l.sku)})</span> × <b>${l.qty}</b></div>`).join('');
      info.style.display = 'block';
      // 出荷保留 (在庫なし) で閉じた伝票には再ピック依頼を出さない (事務が NE で扱う)
      document.getElementById('reqRepickBtn').disabled = stockout;
      // 保留中でも別の商品の不足は追加で出せる (同じ伝票で2品目不足 — Codex R1)。同じ商品の二重依頼はサーバーが 409
    }
    if (slipPick) filterSlips();
    // ?seq= があればその伝票を選んだ状態で開く (送信後の再読込・バナー「対象伝票を開く」から) — 選び直しを無くす (E-2)
    {
      const initSeq = Number(new URLSearchParams(location.search).get('seq'));
      if (slipPick && initSeq > 0 && bySeq.has(initSeq)) {
        slipPick.value = String(initSeq);
        showSlip();
        const card = document.getElementById('reqCard');
        if (card) setTimeout(() => card.scrollIntoView({ block: 'start' }), 50);
      }
    }
    function openReqBox(title, html) {
      document.getElementById('reqBoxTitle').textContent = title;
      document.getElementById('reqBoxBody').innerHTML = html;
      document.getElementById('reqBox').style.display = 'block';
    }
    function closeReqBox() { document.getElementById('reqBox').style.display = 'none'; }
    const cancelBtn = '<button type="button" class="cancel" onclick="closeReqBox()">やめる</button>';

    // 🔄 不足 → 再ピック依頼 (例外処理監査 PR-3・E-2/E-3): 1回の操作で複数の商品を選び、数量はボタン (prompt 廃止)。
    //    候補の記録 (shortage) と送信 (confirm) を商品ごとに続けて行い、最後に1回だけ再読込 (同じ伝票を選んだまま)。
    //    ラインは終了画面が無いので、その場で送る (送信に失敗したら候補として残り「進行中の依頼」から送れる)
    const TASK_LABEL_JS = { requested: '依頼中', claimed: 'ピッカーが取りに行っています', fulfilled: '届きました', unavailable: '在庫なし' };
    const normSku = (v) => String(v || '').trim().toLowerCase();
    const rpPick = new Map();   // 選択中: 明細 index → 数量
    let rpSeq = 0;
    // 選べない明細の理由 (依頼済み / 未送信候補 / 3階の在庫なし / ❌ どこにもない)。null なら選べる
    function repickLock(x, l) {
      const k = normSku(l.sku);
      const t = TASKS.find((t) => t.slipSeq === x.seq && normSku(t.sku) === k);
      if (t) return `依頼済み — ${TASK_LABEL_JS[t.status] || t.status}`;
      if (INCS.some((i) => i.slipSeq === x.seq && normSku(i.sku) === k)) return '未送信の候補あり (「進行中の依頼」から送信)';
      if ((STOCKOUT_MAP[x.seq] || []).some((t) => normSku(t.sku) === k)) return '🚫 3階: 在庫なし (「在庫なしを確認」へ)';
      if ((x.pickingShortages || []).some((p) => p.kind === 'none' && normSku(p.sku) === k)) return '❌ 3階に無い商品 (再ピック依頼は不要・「在庫なしを確認」へ)';
      return null;
    }
    function reqRepick(seqArg) {
      const x = seqArg ? bySeq.get(Number(seqArg)) : selectedSlip();
      if (!x) return;
      if (!workerSel.value) { alert('作業者を選択してください'); return; }
      if (seqArg && slipPick && [...slipPick.options].some((o) => o.value === String(x.seq))) { slipPick.value = String(x.seq); showSlip(); }
      rpSeq = x.seq; rpPick.clear();
      // 選べる明細が1つで数量1なら、選ぶ手間を省いて送信ボタンだけにする
      const free = x.lines.map((l, i) => [l, i]).filter(([l]) => !repickLock(x, l));
      if (free.length === 1 && free[0][0].qty === 1) rpPick.set(free[0][1], 1);
      renderRepickBox();
    }
    // 数量: 1〜9 はワンタップ、10以上は数値入力 (work.ejs の qtyButtons と同じ考え方)
    function qtyPadHtml(i, max, cur) {
      const cnt = Math.min(max, 9);
      const btns = Array.from({ length: cnt }, (_, k) => `<button type="button" class="rp-q ${cur === k + 1 ? 'sel' : ''}" data-i="${i}" data-q="${k + 1}">${k + 1}</button>`).join('');
      const more = max > 9 ? `<input type="number" inputmode="numeric" class="rp-qin" data-i="${i}" min="1" max="${max}" placeholder="10〜${max}" value="${cur > 9 ? cur : ''}"><button type="button" class="rp-qok" data-i="${i}">決定</button>` : '';
      return `<div class="rp-qty"><span class="sub">足りない数:</span>${btns}${more}</div>`;
    }
    function renderRepickBox() {
      const x = bySeq.get(rpSeq);
      if (!x) return;
      const rows = x.lines.map((l, i) => {
        const lock = repickLock(x, l);
        const label = `${esc(l.name)} <span class="sub">(${esc(l.sku)})</span> × ${l.qty}`;
        if (lock) return `<div class="rp-row locked"><div style="padding:8px 10px">${label}<div class="sub">${esc(lock)}</div></div></div>`;
        const q = rpPick.get(i);
        const on = q != null;
        return `<div class="rp-row ${on ? 'on' : ''}"><button type="button" class="rp-toggle" data-i="${i}">${on ? '☑' : '☐'} ${label}${on ? ` → <b>${q} 個</b>` : ''}</button>${on && l.qty > 1 ? qtyPadHtml(i, l.qty, q) : ''}</div>`;
      }).join('');
      const cnt = rpPick.size;
      const allLocked = x.lines.length > 0 && x.lines.every((l) => repickLock(x, l));
      const hint = allLocked ? '<div class="sub" style="grid-column:1/-1">この伝票の商品はすべて依頼済み・報告済みです</div>' : '';
      openReqBox(`#${x.seq} 足りない商品を選ぶ (複数可)`,
        `<div class="rp-list">${rows}</div><div class="reason-grid">${hint}<button type="button" class="wide" id="rpSend" style="background:#e03131; color:#fff; border-color:#e03131" ${cnt ? '' : 'disabled'}>🔄 選んだ ${cnt} 品をピッキングへ送信</button>${cancelBtn}</div>`);
    }
    // 選択箱の操作は委譲で受ける (再描画してもリスナーが消えない・SKU を属性に埋めない)
    document.getElementById('reqBoxBody').addEventListener('click', (e) => {
      const x = bySeq.get(rpSeq);
      const tg = e.target.closest('.rp-toggle');
      if (tg && x) { const i = Number(tg.dataset.i); if (rpPick.has(i)) rpPick.delete(i); else rpPick.set(i, x.lines[i].qty); renderRepickBox(); return; }
      const qb = e.target.closest('.rp-q');
      if (qb) { rpPick.set(Number(qb.dataset.i), Number(qb.dataset.q)); renderRepickBox(); return; }
      const ok = e.target.closest('.rp-qok');
      if (ok && x) {
        const i = Number(ok.dataset.i);
        const inp = document.querySelector(`.rp-qin[data-i="${i}"]`);
        const v = Number(inp && inp.value);
        const max = x.lines[i].qty;
        if (!Number.isInteger(v) || v < 1 || v > max) { alert(`数量は 1〜${max} で入力してください`); return; }
        rpPick.set(i, v); renderRepickBox(); return;
      }
      if (e.target.closest('#rpSend') && x) {
        const items = [...rpPick.entries()].map(([i, qty]) => ({ sku: x.lines[i].sku, name: x.lines[i].name, qty }));
        if (!items.length) return;
        const list = items.map((it) => `・${it.name} × ${it.qty}`).join('\n');
        if (!confirm(`#${x.seq} の次の商品が足りないとして、ピッキングへ再ピックを依頼します。\n${list}\nよろしいですか?`)) return;
        closeReqBox();
        sendRepickMany(x.seq, items);
      }
    });
    async function sendRepickMany(seq, items) {
      if (sending) return;
      sending = true;
      const failed = [];
      try {
        for (const it of items) {
          const r = await post(`/apps/packing/api/batches/${BATCH_ID}/events`, eventPayload('shortage', { slip_seq: seq, sku: it.sku, qty: it.qty }));
          if (!r) { failed.push(`${it.name}: 通信エラー`); continue; }
          if (!r.ok) { failed.push(`${it.name}: ${r.body.error || `エラー (${r.status})`}`); continue; }
          // 直前に記録した候補 (この伝票・このSKU) を送信
          const inc = (r.body.incidents || []).filter((i) => i.slip_seq === seq && normSku(i.sku) === normSku(it.sku) && i.status === 'candidate').pop();
          if (!inc) { failed.push(`${it.name}: 候補は記録しましたが送信対象が見つかりません`); continue; }
          const c = await post(`/apps/packing/api/batches/${BATCH_ID}/incidents/${inc.id}/resolve`, { decision: 'confirm', worker_name: workerSel.value });
          // already_resolved かつ confirmed = 先の送信が届いていて応答だけ落ちた (post は同内容を再送する) → 成功扱い (Codex R4/R5)
          const sent = c && (c.ok || (c.body.code === 'already_resolved' && c.body.status === 'confirmed'));
          if (!sent) failed.push(`${it.name}: 送信に失敗${c ? ` (${c.body.error || c.status})` : ''}`);
        }
        if (failed.length) alert(`送れなかった商品があります:\n${failed.join('\n')}\n「進行中の依頼」で状態を確認してください`);
        reloadKeeping(seq);
      } finally { sending = false; }
    }
    // 再読込しても同じ伝票を選んだままにする (?seq=)
    function reloadKeeping(seq) {
      const u = new URL(location.href);
      if (seq) u.searchParams.set('seq', String(seq)); else u.searchParams.delete('seq');
      location.replace(u.toString());
    }
    async function resolveInc(id, decision) {
      if (sending) return;
      if (!workerSel.value) { alert('作業者を選択してください'); return; }
      if (decision === 'confirm' && !confirm('ピッキングへ再ピックを依頼します。よろしいですか?')) return;
      sending = true;
      try {
        const c = await post(`/apps/packing/api/batches/${BATCH_ID}/incidents/${id}/resolve`, { decision, worker_name: workerSel.value });
        const want = decision === 'confirm' ? 'confirmed' : 'withdrawn';
        if (c && !c.ok && !(c.body.code === 'already_resolved' && c.body.status === want)) alert(c.body.error || `エラー (${c.status})`);
        location.reload();
      } finally { sending = false; }
    }
    // ❌ の未処理伝票で「手元で見つかった」: 3階の「どこにもない」報告を取り消す (退路。伝票はそのまま流せる)
    function foundNone(seq, sku) {
      if (!workerSel.value) { alert('作業者を選択してください'); return; }
      if (!confirm(`#${seq} の商品が手元で見つかったため、3階の「どこにもない」の報告を取り消します。よろしいですか?`)) return;
      send('found', { slip_seq: seq, sku });
    }
    // 🚫 在庫なしを確認 (Q1 決定 2026-09-05): 3階が「在庫なし」にした伝票を出荷保留にして閉じ、事務へ通知する
    function stockoutAck(seq) {
      if (!workerSel.value) { alert('作業者を選択してください'); return; }
      if (!confirm(`#${seq} を「出荷保留 (在庫なし)」にして閉じます。事務へ通知し、NE で出荷保留にしてもらいます。\n商品と納品書は出荷保留の棚へ置いてください。よろしいですか?`)) return;
      send('stockout_ack', { slip_seq: seq });
    }
    function foundSlip(seq) {
      if (!confirm(`#${seq} の足りなかった商品が【全部】見つかったため、この伝票の再ピック依頼と不足の候補をすべて取り下げます。\n(1品目だけ見つかったときは、その商品の横の「見つかった」を押してください)\nよろしいですか?`)) return;
      send('found', { slip_seq: seq });
    }
    // SKU 単位の「見つかった」: その商品の依頼/候補だけ取り下げる (他の商品の依頼が残れば保留のまま)。
    // SKU は data-* 属性から加工せずに渡す (onclick へ文字列埋め込みすると記号入り SKU が壊れる — Codex R3)
    function foundSku(seq, sku, name) {
      if (!confirm(`#${seq} の「${name}」が見つかったため、この商品の依頼だけ取り下げます。よろしいですか?`)) return;
      send('found', { slip_seq: seq, sku });
    }
    document.querySelectorAll('.found-sku').forEach((b) => b.addEventListener('click',
      () => foundSku(Number(b.dataset.seq), b.dataset.sku, b.dataset.name)));
    document.querySelectorAll('.found-none').forEach((b) => b.addEventListener('click',
      () => foundNone(Number(b.dataset.seq), b.dataset.sku)));
    // 📦 サイズ・配送方法の変更依頼 (梱包画面④と同じ: 提案する配送方法 → 理由 → 事務へ GChat 通知)
    function reqShip() {
      const x = selectedSlip();
      if (!x) return;
      if (!workerSel.value) { alert('作業者を選択してください'); return; }
      const ms = METHOD_OPTIONS.filter((m) => m !== x.deliveryMethod)
        .map((m) => `<button type="button" onclick="reqShipReason(${x.seq}, this.dataset.m)" data-m="${esc(m)}">${esc(m)}</button>`).join('')
        || '<div style="grid-column:1/-1; color:#868e96">候補がありません</div>';
      // 📦 ネコポス二枚出し (中原さん指示 2026-09-02): 配送方法は変えず送り状を2枚に。理由入力なし
      const two = TWO_LABELS_OPTION
        ? `<button type="button" onclick="reqShipTwoLabels(${x.seq})" style="grid-column:1/-1; background:#fff4e6; border-color:#e8590c">📦📦 ${esc(TWO_LABELS_OPTION)} (送り状2枚)</button>` : '';
      openReqBox(`#${x.seq} どの配送方法にしますか? (現在: ${x.deliveryMethod || '—'})`, `<div class="reason-grid">${ms}${two}${cancelBtn}</div>`);
    }
    function reqShipTwoLabels(seq) {
      closeReqBox();
      if (!confirm(`#${seq} のネコポス二枚出し (送り状2枚・2個口) を事務へ依頼します。商品と納品書は変更待ちの棚へ置いてください。よろしいですか?`)) return;
      send('ship_change', { slip_seq: seq, proposed_method: TWO_LABELS_OPTION });
    }
    function reqShipReason(seq, method) {
      const rs = SHIP_REASONS.map((r) => `<button type="button" onclick="reqShipSend(${seq}, this.dataset.m, this.dataset.r)" data-m="${esc(method)}" data-r="${esc(r)}">${esc(r)}</button>`).join('');
      openReqBox(`#${seq} → ${method}: 理由は?`, `<div class="reason-grid">${rs}${cancelBtn}</div>`);
    }
    function reqShipSend(seq, method, reason) {
      closeReqBox();
      if (!confirm(`#${seq} を「${method}」へ変更するよう事務へ依頼します (理由: ${reason})。商品と納品書は変更待ちの棚へ置いてください。よろしいですか?`)) return;
      send('ship_change', { slip_seq: seq, proposed_method: method, reason });
    }
    // 🖨 再印刷依頼 (押した瞬間に事務へ通知)
    function reqReprint() {
      const x = selectedSlip();
      if (!x) return;
      if (!confirm(`伝票 ${x.neSlipNo} (${x.recipientName || ''}) の再印刷を事務に依頼しますか?`)) return;
      send('reprint', { slip_seq: x.seq });
    }
  </script>
</body>
</html>
