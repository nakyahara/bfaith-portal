<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="manifest" href="/apps/packing/manifest.json">
  <link rel="apple-touch-icon" sizes="180x180" href="/app-icons/packing-180.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <style>
    /* iPad据置・納品書PDF同等の1伝票1画面。明るい紙面+大きな文字 */
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }
    body {
      font-family: "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
      background: #e9ecef; color: #212529;
      position: fixed; inset: 0; overflow: hidden;   /* SafariのURLバー伸縮対策 (picking #783) */
      display: flex; flex-direction: column;
      -webkit-user-select: none; user-select: none;
    }

    /* ── 上部バー ── */
    .topbar {
      flex: 0 0 auto; background: #212529; color: #fff;
      display: flex; align-items: center; gap: 14px; padding: 6px 14px;
      font-size: 15px; flex-wrap: wrap;
    }
    .topbar .prog { font-size: 22px; font-weight: 800; }
    .topbar .slipno { font-size: 26px; font-weight: 800; font-family: ui-monospace, Consolas, monospace; letter-spacing: 1px; }
    .topbar .muted { color: #adb5bd; }
    .topbar .spacer { flex: 1 1 auto; }
    .topbar a { color: #adb5bd; text-decoration: none; }
    .done-tag { background: #2b8a3e; border-radius: 4px; padding: 1px 8px; font-weight: 700; display: none; }

    /* ── 納品書カード ── */
    .sheet-area { flex: 1 1 auto; overflow-y: auto; padding: 10px 12px; }
    .paper {
      background: #fff; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.12);
      max-width: 980px; margin: 0 auto; padding: 14px 18px;
    }
    .ship-row { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; margin-bottom: 8px; font-size: 15px; color: #495057; }
    .ship-row .method { font-size: 19px; font-weight: 700; color: #212529; }
    .ship-row .material { background: #edf2ff; border-radius: 6px; padding: 2px 10px; font-weight: 700; color: #364fc7; }
    .ship-row .boxes { background: #ffe3e3; border-radius: 6px; padding: 2px 10px; font-weight: 800; color: #c92a2a; }
    .warns { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .warn-badge { background: #fff3bf; border: 1px solid #ffd43b; border-radius: 6px; padding: 2px 10px; font-size: 15px; font-weight: 700; }

    /* ── 📦 梱包資材カード (要件『梱包資材表示_要件定義_20260823.md』v1.7 §4.1) ── */
    .mat-card { border: 2px solid #adb5bd; border-radius: 10px; padding: 8px 12px; margin-bottom: 8px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .mat-card.rule { border-color: #2b8a3e; background: #ebfbee; }
    .mat-card.header { border-color: #1971c2; background: #e7f5ff; }
    .mat-card.cand { border-color: #f08c00; background: #fff9db; }
    .mat-card.gray { border-color: #adb5bd; background: #f1f3f5; color: #495057; }
    .mat-img { width: 88px; height: 88px; border-radius: 8px; background: #fff center/contain no-repeat; border: 1px solid #dee2e6; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; font-size: 34px; }
    .mat-name { font-size: 24px; font-weight: 800; }
    .mat-tag { display: inline-block; font-size: 14px; font-weight: 700; padding: 2px 10px; border-radius: 6px; }
    .mat-sub { font-size: 14px; color: #495057; }
    .mat-btn { padding: 12px 16px; font-size: 16px; font-weight: 700; border-radius: 10px; border: 2px solid #ced4da; background: #fff; cursor: pointer; }
    .mat-mini { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-width: 120px; min-height: 110px; padding: 8px 10px; border: 2px solid #ced4da; border-radius: 12px; background: #fff; cursor: pointer; font-size: 15px; font-weight: 700; }
    .mat-mini .mat-img { width: 60px; height: 60px; font-size: 24px; }
    .mat-mini.other { opacity: .55; }
    .mat-mini-row { display: flex; gap: 14px; flex-wrap: wrap; width: 100%; margin-top: 6px; }
    .mat-busy .mat-mini, .mat-busy .mat-btn { pointer-events: none; opacity: .5; }
    .mat-undo-chip { position: fixed; top: 52px; left: 50%; transform: translateX(-50%); z-index: 60; background: #212529; color: #fff; border-radius: 24px; padding: 10px 18px; font-size: 16px; display: none; align-items: center; gap: 12px; box-shadow: 0 4px 14px rgba(0,0,0,.3); }
    .mat-undo-chip button { background: #ffd43b; color: #212529; font-weight: 800; border: none; border-radius: 18px; padding: 8px 18px; font-size: 16px; cursor: pointer; }
    .mat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(136px, 1fr)); gap: 12px; max-height: 56vh; overflow-y: auto; }

    .recipient { border: 2px solid #495057; border-radius: 8px; padding: 8px 14px; margin-bottom: 10px; }
    .recipient .name { font-size: 30px; font-weight: 800; line-height: 1.25; }
    .recipient .addr { font-size: 18px; color: #343a40; margin-top: 2px; }

    .order-row { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 14px; color: #495057; margin-bottom: 10px; }

    /* ── 明細 ──
       アソート (複数明細) でもスクロールなしで全明細が見えるよう、明細数で密度を変える
       (data-density: 1=単品 / 2=2〜3明細 / 3=4明細以上は横2列グリッド) */
    .line {
      display: flex; align-items: center; gap: 14px;
      border-top: 1px solid #dee2e6; padding: 10px 2px;
    }
    .line .img {
      flex: 0 0 auto; width: 128px; height: 128px; border: 1px solid #e9ecef; border-radius: 8px;
      background: #f8f9fa center/contain no-repeat; display: flex; align-items: center; justify-content: center;
      font-size: 30px; color: #ced4da;
    }
    .line .pname { flex: 1 1 auto; min-width: 0; font-size: 22px; font-weight: 700; line-height: 1.35; }
    .line .pmeta { font-size: 14px; color: #868e96; font-weight: 400; margin-top: 4px; }
    .line .qty { flex: 0 0 auto; font-size: 46px; font-weight: 800; white-space: nowrap; }
    .line .qty small { font-size: 20px; font-weight: 700; }
    .line .qty.multi { color: #e8590c; }

    .paper[data-density="2"] .line { padding: 6px 2px; gap: 10px; }
    .paper[data-density="2"] .line .img { width: 96px; height: 96px; }
    .paper[data-density="2"] .line .pname { font-size: 19px; }
    .paper[data-density="2"] .line .qty { font-size: 38px; }
    .paper[data-density="3"] .line { padding: 5px 2px; gap: 8px; }
    .paper[data-density="3"] .line .img { width: 76px; height: 76px; }
    .paper[data-density="3"] .line .pname { font-size: 17px; }
    .paper[data-density="3"] .line .pmeta { font-size: 12px; margin-top: 1px; }
    .paper[data-density="3"] .line .qty { font-size: 30px; }
    .paper[data-density="3"] .line .qty small { font-size: 15px; }
    @media (min-width: 760px) {
      .paper[data-density="3"] .lines-wrap { display: grid; grid-template-columns: 1fr 1fr; column-gap: 22px; }
    }
    /* 複数明細のときは送り先・受注情報も圧縮して明細のスペースを確保 */
    .paper:not([data-density="1"]) .recipient { padding: 5px 12px; margin-bottom: 6px; }
    .paper:not([data-density="1"]) .recipient .name { font-size: 22px; }
    .paper:not([data-density="1"]) .recipient .addr { font-size: 15px; }
    .paper:not([data-density="1"]) .ship-row { margin-bottom: 5px; }
    .paper:not([data-density="1"]) .order-row { margin-bottom: 5px; }

    /* ── 下部操作 ── */
    /* 2段: 上段=通知・記録ボタン (均等幅) / 下段=「次へ」を全幅で一番下 (中原さん指示 2026-08-26) */
    .controls { flex: 0 0 auto; display: flex; flex-direction: column; gap: 8px; padding: 8px 12px calc(10px + env(safe-area-inset-bottom)); }
    .controls-row { display: flex; gap: 8px; }
    .btn-prev {
      flex: 1 1 0; min-width: 0; border: 2px solid #adb5bd; border-radius: 14px; background: #f1f3f5;
      font-size: 17px; font-weight: 700; color: #495057; line-height: 1.25; padding: 10px 4px;
    }
    .btn-prev.notify { border-color: #f08c00; color: #9c5700; background: #fff4e6; }
    .btn-next {
      flex: 1 1 auto; border: none; border-radius: 14px; background: #1971c2; color: #fff;
      font-size: 30px; font-weight: 800; padding: 20px 0; cursor: pointer;
    }
    .btn-next.jump { background: #e8590c; font-size: 22px; }
    .btn-next:disabled { opacity: 0.55; }

    /* ── オーバーレイ (作業者選択・完了) ── */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 40;
      display: none; align-items: center; justify-content: center; }
    .overlay .box { background: #fff; border-radius: 16px; padding: 24px 22px; width: min(560px, 92vw); text-align: center; }
    .overlay h2 { margin: 0 0 14px; font-size: 22px; }
    .worker-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .worker-opt { padding: 20px 8px; font-size: 20px; font-weight: 700; border: 1px solid #ced4da; border-radius: 12px; background: #f8f9fa; cursor: pointer; }
    .done-big { font-size: clamp(30px, 6vw, 54px); font-weight: 800; color: #2b8a3e; }
    .tb-btn { background: none; border: 1px solid #495057; border-radius: 8px; color: #fff; font-size: 18px; padding: 2px 12px; cursor: pointer; }
    .reason-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .reason-opt { padding: 16px 8px; font-size: 18px; font-weight: 700; border: 1px solid #ced4da; border-radius: 12px; background: #f8f9fa; cursor: pointer; }
    .sheet-cancel { margin-top: 14px; width: 100%; padding: 10px; border: none; background: none; color: #868e96; font-size: 16px; cursor: pointer; }
    .jump-banner { display: none; background: #fff3bf; border: 1px solid #ffd43b; border-radius: 8px;
      padding: 6px 12px; margin: 0 auto 8px; max-width: 980px; font-size: 15px; font-weight: 600; }
    /* 閲覧中 (完了済み・保留・作業位置より手前) だけ出す「作業へ戻る」帯。
       下部の大きいボタンに載せない = 納品書を持つ手が触れても作業位置が動かない */
    .back-to-work { display: none; margin: 0 auto 8px; max-width: 980px; }
    .back-to-work button { width: 100%; border: 2px solid #e8590c; background: #fff4e6; color: #d9480f;
      border-radius: 10px; padding: 10px 0; font-size: 17px; font-weight: 800; cursor: pointer; }
    .search-back { display: none; margin: 0 auto 8px; max-width: 980px; }
    .search-back button { background: #edf2ff; border: 1px solid #748ffc; border-radius: 8px;
      color: #364fc7; padding: 8px 16px; font-size: 15px; font-weight: 700; cursor: pointer; }
    .undo-link { display: none; margin: 8px auto 0; max-width: 980px; text-align: right; }
    .undo-link button { background: none; border: 1px solid #adb5bd; border-radius: 8px; color: #868e96; padding: 6px 14px; font-size: 14px; cursor: pointer; }
    .slip-list { max-height: 50vh; overflow-y: auto; text-align: left; margin-top: 10px; }
    .slip-row { display: flex; gap: 12px; padding: 10px 8px; border-top: 1px solid #e9ecef; cursor: pointer; font-size: 17px; align-items: baseline; }
    .slip-row .no { font-family: ui-monospace, Consolas, monospace; font-weight: 700; }
    .slip-row .st-mini { font-size: 13px; border-radius: 4px; padding: 0 8px; background: #e9ecef; }
    .slip-row .st-mini.done { background: #d3f9d8; }
    .search-input { width: 100%; padding: 10px; font-size: 20px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 8px; }
    .toast { position: fixed; left: 50%; bottom: 110px; transform: translateX(-50%);
      background: #212529; color: #fff; border-radius: 10px; padding: 10px 20px; font-size: 16px;
      opacity: 0; transition: opacity .25s; pointer-events: none; z-index: 60; max-width: 90vw; }
    .toast.show { opacity: 0.95; }
    .offline-dot { width: 10px; height: 10px; border-radius: 50%; background: #2b8a3e; }
    .offline-dot.ng { background: #e03131; }
  </style>
</head>
<body>
  <script>window.__packingBatchId = <%= Number(state.batch.id) %>;</script>
  <%- include('_floor_alerts') %>
  <div class="topbar">
    <span class="prog"><span id="progDone">-</span> / <%= state.slips.length %></span>
    <span class="muted"><%= state.batch.folder_name || '' %></span>
    <span class="slipno" id="slipNo">—</span>
    <span id="mall" class="muted"></span>
    <span class="done-tag" id="doneTag">✔ 完了済み</span>
    <span class="spacer"></span>
    <span id="timer" class="muted" style="font-size:14px; font-variant-numeric: tabular-nums;"></span>
    <button id="searchBtn" type="button" class="tb-btn">🔎</button>
    <button id="pauseBtn" type="button" class="tb-btn">⏸</button>
    <button id="ttsBtn" type="button" class="tb-btn">🔊</button>
    <span class="offline-dot" id="netDot" title="通信状態"></span>
    <span id="workerTag" class="muted"></span>
    <a href="/apps/packing/">一覧へ</a>
  </div>

  <div class="mat-undo-chip" id="matUndoChip">
    <span id="matUndoText"></span>
    <button type="button" id="matUndoBtn">取り消す</button>
  </div>

  <div class="sheet-area" id="sheetArea">
    <div class="search-back" id="searchBack"><button type="button" id="searchBackBtn">↩ 検索結果に戻る</button></div>
    <div class="back-to-work" id="backToWork"><button type="button" id="backToWorkBtn">↩ 作業中の伝票へ戻る</button></div>
    <div class="jump-banner" id="jumpBanner">⚠ ズレ回復モード: 順序から外れた伝票を表示中。「次へ」で完了すると、間の伝票は未処理のまま残ります (最後に必ず戻ります)</div>
    <div class="paper" id="paper"></div>
    <div class="undo-link" id="undoLink"><button type="button" id="undoBtn">この伝票の完了を取り消す…</button></div>
    <div class="undo-link" id="repickLink" style="text-align:center">
      <%# 🚫 3階「在庫なし」の報告 (例外処理監査 PR-1・Q1 決定 2026-09-05): 待たせ続けずに赤い箱で知らせ、
          梱包者が「在庫なしを確認」→ 伝票を出荷保留 (在庫なし) にして閉じる。事務へは自動通知 %>
      <div id="stockoutBox" style="display:none; margin:0 auto 10px; max-width:640px; background:#ffe3e3; border:2px solid #e03131; border-radius:12px; padding:12px 16px; text-align:left">
        <div style="font-weight:800; color:#c92a2a; font-size:17px">🚫 3階から「在庫なし」の報告</div>
        <div id="stockoutList" style="margin:6px 0 10px; font-size:15px"></div>
        <button type="button" id="stockoutAckBtn" style="width:100%; padding:12px; background:#e03131; color:#fff; border:none; border-radius:10px; font-weight:800; font-size:16px">在庫なしを確認 → この伝票を出荷保留にする (事務へ通知)</button>
        <div id="stockoutWait" style="display:none; font-size:14px; color:#c92a2a">この伝票には他の商品の再ピック・未送信の候補が残っています。それが片付く (受け取った / 見つかった / 送信) と、ここで出荷保留にできます</div>
        <div style="font-size:12.5px; color:#868e96; margin-top:6px">商品と納品書は出荷保留の棚へ。NE の出荷保留は事務が行います</div>
      </div>
      <button type="button" id="receiveBtn" style="border-color:#2b8a3e; color:#2b8a3e; font-weight:700; padding:10px 18px; font-size:16px">📦 再ピック品を受け取った (再開)</button>
      <button type="button" id="foundBtn" style="margin-left:8px">見つかった (依頼取下げ)</button>
    </div>
  </div>

  <div class="controls">
    <div class="controls-row">
      <button class="btn-prev" id="issueBtn" type="button">不足/余り<br>かも？</button>
      <button class="btn-prev notify" id="shipBtn" type="button">配送方法<br>変更</button>
      <button class="btn-prev notify" id="reprintBtn" type="button">🖨 伝票<br>再印刷</button>
      <button class="btn-prev notify" id="labelMissingBtn" type="button">📭 送り状<br>がない</button>
      <button class="btn-prev" id="prevBtn" type="button">◂ 前へ</button>
    </div>
    <button class="btn-next" id="nextBtn" type="button">次へ ▸</button>
  </div>

  <div class="overlay" id="workerOverlay">
    <div class="box">
      <h2>だれが梱包しますか？</h2>
      <div id="workerHint" style="color:#868e96; font-size:15px; margin-bottom:12px;"></div>
      <div class="worker-grid">
        <% for (const w of workers) { %>
          <button class="worker-opt" data-name="<%= w.name %>"><%= w.name %></button>
        <% } %>
        <% if (workers.length === 0) { %>
          <div style="grid-column: 1 / -1; color:#868e96">作業者が未登録です。<br>ピッキングの端末・作業者管理から追加してください</div>
        <% } %>
      </div>
      <div style="text-align:center">
        <button type="button" id="workerCancel" style="display:none; margin-top:12px; padding:10px 24px; border:none; background:none; color:#868e96; font-size:15px">そのまま (閉じる)</button>
      </div>
    </div>
  </div>

  <div class="overlay" id="pauseOverlay">
    <div class="box">
      <h2>中断の理由</h2>
      <div class="reason-grid">
        <% for (const r of pauseReasons) { %>
          <button class="reason-opt pause-reason" data-reason="<%= r %>"><%= r %></button>
        <% } %>
      </div>
      <button class="sheet-cancel" id="pauseCancel" type="button">やめる</button>
    </div>
  </div>

  <div class="overlay" id="pausedOverlay">
    <div class="box">
      <h2>⏸ 中断中 <span id="pausedReason" style="color:#868e96; font-size:0.8em"></span></h2>
      <button class="reason-opt" id="resumeBtn" type="button" style="width:100%; padding:22px; font-size:22px;">▶ 再開する</button>
    </div>
  </div>

  <div class="overlay" id="undoOverlay">
    <div class="box">
      <h2>完了取消の理由</h2>
      <div class="reason-grid">
        <% for (const r of undoReasons) { %>
          <button class="reason-opt undo-reason" data-reason="<%= r %>"><%= r %></button>
        <% } %>
      </div>
      <button class="sheet-cancel" id="undoCancel" type="button">やめる</button>
    </div>
  </div>

  <div class="overlay" id="shipOverlay">
    <div class="box">
      <h2>配送方法の変更依頼</h2>
      <div id="shipStep1">
        <div style="color:#868e96; font-size:15px; margin-bottom:10px">事務へ変更を依頼します (商品と納品書は変更待ちの棚へ)。どの配送方法にしますか?</div>
        <div class="reason-grid" id="shipMethods"></div>
      </div>
      <div id="shipStep2" style="display:none">
        <div style="color:#868e96; font-size:15px; margin-bottom:10px">理由は?</div>
        <div class="reason-grid">
          <% for (const r of shipChangeReasons) { %>
            <button class="reason-opt ship-reason" data-reason="<%= r %>"><%= r %></button>
          <% } %>
        </div>
      </div>
      <button class="sheet-cancel" id="shipCancel" type="button">やめる</button>
    </div>
  </div>

  <div class="overlay" id="ruleOverlay">
    <div class="box" style="max-width:560px; text-align:left">
      <h2>恒久ルール変更の申請</h2>
      <div style="color:#868e96; font-size:14px; margin-bottom:8px" id="ruleDesc"></div>
      <div id="ruleCurrent"></div>
      <div id="ruleCombos"></div>
      <div id="rulePreview" style="margin-top:10px; font-size:16px; font-weight:700"></div>
      <button class="reason-opt" id="ruleSubmit" type="button" disabled style="width:100%; margin-top:14px; background:#e03131; color:#fff; border:none">この内容で承認依頼を送信</button>
      <button class="sheet-cancel" id="ruleCancel" type="button" style="width:100%">やめる</button>
    </div>
  </div>

  <div class="overlay" id="matOverlay">
    <div class="box" style="max-width:660px">
      <h2>使った資材を選んでください</h2>
      <div style="color:#868e96; font-size:14px; margin-bottom:8px; text-align:left">
        タップした資材がこの商品構成の資材として登録され、次回から自動表示されます。
        <b>資材切れの代替なら何も押さず「やめる」</b>。上段 (濃い色) がこの分類の候補です
      </div>
      <div class="mat-grid" id="matGrid"></div>
      <button class="sheet-cancel" id="matCancel" type="button">やめる</button>
    </div>
  </div>

  <div class="overlay" id="searchOverlay">
    <div class="box">
      <h2>伝票を探す</h2>
      <input class="search-input" id="searchInput" placeholder="伝票番号 or 商品名 or お客様名 (例: 7800 / ひのき / 山田)">
      <div class="slip-list" id="slipList"></div>
      <button class="sheet-cancel" id="searchCancel" type="button">閉じる</button>
    </div>
  </div>

  <div class="overlay" id="issueOverlay">
    <div class="box">
      <h2 id="issueTitle">どうしましたか？</h2>
      <div id="issueStep1" class="reason-grid">
        <button class="reason-opt" data-issue="shortage">📉 不足<br><small>商品が足りない</small></button>
        <button class="reason-opt" data-issue="excess">📈 余り<br><small>商品が余った</small></button>
        <button class="reason-opt" data-issue="wrong_item" style="grid-column:1/-1">🔀 品違い<br><small>違う商品が入っていた</small></button>
      </div>
      <div id="issueStep2" style="display:none">
        <div id="issueSkuGrid" class="reason-grid" style="max-height:40vh; overflow-y:auto"></div>
        <input class="search-input" id="issueSkuInput" placeholder="SKU or 商品名で検索" style="margin-top:10px; display:none" list="batchSkus">
        <datalist id="batchSkus"></datalist>
        <div id="issueSearchRes" style="display:flex; flex-direction:column; gap:6px; margin-top:8px; max-height:36vh; overflow-y:auto"></div>
      </div>
      <div id="issueStep3" style="display:none">
        <div style="color:#868e96; margin-bottom:10px" id="issueQtyLabel">数量は?</div>
        <div id="issueQtyGrid" class="reason-grid"></div>
      </div>
      <button class="sheet-cancel" id="issueCancel" type="button">やめる</button>
    </div>
  </div>

  <div class="overlay" id="doneOverlay">
    <div class="box">
      <div class="done-big" id="doneTitle">✅ <%= state.batch.folder_name || '' %><br><%= state.slips.length %>伝票 完了しました</div>
      <div id="incBox" style="display:none; text-align:left; margin-top:16px; border-top:1px solid #dee2e6; padding-top:12px">
        <div style="font-weight:800; margin-bottom:4px">⚠ 出てこなかった・余った・間違っていた商品</div>
        <div style="color:#868e96; font-size:14px; margin-bottom:8px">「ピッキングへ送信」で再ピック/棚戻しを依頼し、ミスとして記録します。途中で出てきた分は「取下げ」</div>
        <div id="incList"></div>
      </div>
      <div id="endHint" style="display:none; color:#868e96; margin-top:12px; font-size:15px">保留中の伝票は、ピッカーが持ってきたら「📦受け取った」で再開できます</div>
      <div style="margin-top:18px">
        <a href="/apps/packing/" style="font-size:20px">一覧へ戻る</a>
        <button id="endClose" type="button" style="display:none; margin-left:16px; padding:10px 22px; font-size:17px; border:1px solid #ced4da; border-radius:10px; background:#f8f9fa; cursor:pointer">閉じる (梱包画面へ)</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    <%# JSON内の "<" エスケープでscript要素からの脱出を防ぐ (picking と同じ) %>
    const STATE = <%- JSON.stringify({
      batchId: state.batch.id,
      batchStatus: state.batch.status,
      worker: state.batch.worker,
      folderName: state.batch.folder_name || '',
      hikiateClass: typeof hikiateClass === 'undefined' ? null : hikiateClass,
      pauseReason: state.batch.pause_reason || null,
      startedAt: state.batch.started_at,
      pausedTotalSec: state.batch.paused_total_sec || 0,
      blockedTotalSec: state.batch.blocked_total_sec || 0,   // 再ピック待ち (梱包できない時間) の累計 — 除外
      currentSeq: state.currentSeq,
      heldSeqs: state.slips.filter((x) => x.status === 'held').map((x) => x.seq),
      repickSeqs: state.slips.filter((x) => x.status === 'held' && x.hold_reason === 'repick').map((x) => x.seq),
      repickReadySeqs: Object.entries(state.repickBySlip || {}).filter(([, st]) => st === 'fulfilled').map(([q]) => Number(q)),
      stockoutBySlip: state.stockoutBySlip || {},   // 3階「在庫なし」の報告がある保留伝票 (seq → 商品)
      stockoutAckSeqs: state.stockoutAckSeqs || [],  // そのうち「在庫なしを確認」できる伝票 (サーバーと同じ条件)
      stockoutNotifyBySlip: state.stockoutNotifyBySlip || {},   // 閉じた伝票の事務通知の状態 (sent / pending)
      stockoutSeqs: state.slips.filter((x) => x.status === 'cancelled' && x.hold_reason === 'stockout').map((x) => x.seq),
      incidents: (state.incidents || []).map((i) => ({ id: i.id, kind: i.kind, sku: i.sku, actualSku: i.actual_sku, actualName: i.actual_name || null, qty: i.qty, slipSeq: i.slip_seq })),
      methodOptions: typeof methodOptions === 'undefined' ? [] : methodOptions,
      twoLabelsOption: typeof twoLabelsOption === 'undefined' ? null : twoLabelsOption,
      materials: typeof materials === 'undefined' ? null : materials,
      materialOpts: typeof materialOpts === 'undefined' ? null : materialOpts,
      materialUndoSec: typeof materialUndoSec === 'undefined' ? 15 : materialUndoSec,
      shipChangeReasons: typeof shipChangeReasons === 'undefined' ? [] : shipChangeReasons,
      lastDoneSeq: state.slips.filter((x) => x.status === 'done')
        .sort((a, b) => (a.done_at || '').localeCompare(b.done_at || '') || a.seq - b.seq)
        .at(-1)?.seq ?? null,
      slips: state.slips.map((s) => ({
        seq: s.seq, status: s.status, neSlipNo: s.ne_slip_no, mall: s.mall,
        deliveryMethod: s.delivery_method, material: s.material, printHeader1: s.print_header1,
        boxCount: s.box_count, warns: s.warns, pickingShortages: s.pickingShortages || [],
        recipientName: s.recipient_name, recipientZip: s.recipient_zip,
        recipientPref: s.recipient_pref, recipientAddr: s.recipient_addr,
        siteOrderNo: s.site_order_no, orderDate: s.order_date,
        deliveryDate: s.delivery_date, deliveryTime: s.delivery_time,
        lines: s.lines.map((l) => ({
          // 商品名は必ずNE商品マスタの単品名 (🚨セット名は使わない)。セットで展開に失敗したものは
          // CSV名へ戻さず未解決表示。API不達/未登録はCSVの「商品名」列 (=NE単品名) へ。
          // 印字商品名 (モール名・セットSEO長文) は表示に一切使わない
          sku: l.sku, qty: l.qty, imageUrl: l.imageUrl,
          name: l.ne_name || (l.ne_set_unresolved ? '⚠ 商品名未解決 (セット構成を確認)' : (l.product_name || '(商品名なし)')),
          shortName: l.short_name,   // 送り状備考1 = 読み上げ短縮名の第一候補 (要件§5.3)
        })),
      })),
    }).replace(/</g, '\\u003c') %>;
    const WARN_LABELS = <%- JSON.stringify(warnLabels).replace(/</g, '\\u003c') %>;

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    let worker = STATE.worker;          // 作業者名 (start 時に確定)
    let viewSeq = null;                 // 表示中の伝票 seq
    const bySeq = new Map(STATE.slips.map((s) => [s.seq, s]));

    // ── 単品×同一SKU連続アシスト (中原さん指示 2026-08-21) ──
    // 先読みはまとめるが処理はまとめない: 表示と読み上げの補助のみ。完了/次へ/計測は従来どおり。
    // 単品 (明細1行×数量1) が連続する区間の中だけで、同一SKUの連続を数える
    // (複数商品・数量2以上の伝票で区間は必ず切れる — またぎ判定禁止)
    const CONTINUOUS_ITEM_THRESHOLD = 3;   // この件数以上の連続で発動 (設定値)
    const RUNS = new Map();      // seq → { idx: n件目(1始まり), total, first, last }
    const SWITCH_SEQS = new Set();   // 連続の直後にSKUが切り替わる伝票 (誤梱包ポイント)
    (function computeRuns() {
      const slips = STATE.slips;   // seq順 = 納品書の束の順
      const isTanpin = (sl) => sl.lines.length === 1 && sl.lines[0].qty === 1;
      let i = 0;
      while (i < slips.length) {
        if (!isTanpin(slips[i])) { i++; continue; }
        let j = i;
        while (j + 1 < slips.length && isTanpin(slips[j + 1])
          && slips[j + 1].lines[0].sku === slips[i].lines[0].sku) j++;
        const total = j - i + 1;
        if (total >= CONTINUOUS_ITEM_THRESHOLD) {
          for (let k = i; k <= j; k++) {
            RUNS.set(slips[k].seq, { idx: k - i + 1, total, first: k === i, last: k === j });
          }
          // 連続の次の伝票 (別SKU or 複数商品) = 切り替わり注意
          if (j + 1 < slips.length) SWITCH_SEQS.add(slips[j + 1].seq);
        }
        i = j + 1;
      }
    })();
    const doneSet = new Set(STATE.slips.filter((s) => s.status === 'done').map((s) => s.seq));
    const heldSet = new Set(STATE.heldSeqs || []);
    const repickSet = new Set(STATE.repickSeqs || []);
    const repickReadySet = new Set(STATE.repickReadySeqs || []);
    const stockoutSet = new Set(STATE.stockoutSeqs || []);   // 1階が「在庫なしを確認」して閉じた伝票 (出荷保留・在庫なし)
    let stockoutBySlip = STATE.stockoutBySlip || {};         // 3階「在庫なし」の報告 (保留伝票 seq → [{sku, product_name, req_qty, claimed_by, updated_at}])
    const stockoutAckSet = new Set(STATE.stockoutAckSeqs || []);   // 「在庫なしを確認」できる伝票 (他の再ピック・候補が残っていない)
    let stockoutNotifyBySlip = STATE.stockoutNotifyBySlip || {};   // 閉じた伝票の事務通知の状態 (seq → 'sent' | 'pending')
    // 同期判定用: 在庫なし報告の中身 (件数・数量・時刻) まで含めた版 (キーだけだと2件目や数量変更で描き直されない — Codex R1)
    const stockoutVersion = () => Object.entries(stockoutBySlip)
      .flatMap(([seq, rows]) => (rows || []).map((t) => `${seq}:${t.id}:${t.sku}:${t.unavailable_qty ?? t.req_qty}:${t.updated_at}`))
      .sort().join('|') + '#' + [...stockoutAckSet].sort().join(',')
      + '#' + Object.entries(stockoutNotifyBySlip).map(([q, v]) => `${q}=${v}`).sort().join(',');
    const jstHm = (iso) => { const t = Date.parse(iso || ''); return Number.isFinite(t) ? new Date(t + 9 * 3600e3).toISOString().slice(11, 16) : ''; };
    let incidents = STATE.incidents || [];   // 未確定のミス候補 (完了サマリで確定/取下げ)
    let currentSeq = STATE.currentSeq;  // 次に梱包する伝票 = 最小の未処理 (null=全完了)
    let jumpMode = false;               // 検索ジャンプで順序から外れた伝票を表示中
    // 🚨 ズレ回復で完了してよいのは「検索で飛んだその伝票」だけ。
    //    jumpMode だけを見ると、そこから 前へ/次へ で別の未処理伝票へ移っても完了できてしまう
    //    (= 間の伝票を飛ばして順序外完了。Codexレビュー 2026-08-30)
    let jumpTargetSeq = null;
    let paused = STATE.batchStatus === 'paused';
    let lastDoneSeq = STATE.lastDoneSeq ?? null;   // 完了取消の対象 (最後に完了した伝票)

    // 未処理ゼロでも残っている「片付け待ち」= 保留伝票 + 未確定のミス候補 (0ならバッチ完了)
    function unfinishedCount() {
      return heldSet.size + incidents.filter((i) => i.slipSeq == null || !heldSet.has(i.slipSeq)).length;
    }
    /**
     * その伝票を「いま完了できるか」。render のボタン表示と goNext の実処理で**同じ関数**を使う。
     * 別々に書くと片方だけ直して抜ける (実際 jumpMode の扱いがズレていた)。
     */
    function canCompleteSeq(seq) {
      if (seq == null) return false;
      if (doneSet.has(seq) || heldSet.has(seq) || stockoutSet.has(seq)) return false;   // 完了済み・保留・出荷保留は不可
      if (seq === currentSeq) return true;                            // 作業中の伝票
      return jumpMode && seq === jumpTargetSeq;                       // 検索で飛んだその伝票だけ
    }

    // 最小の未処理 seq (クライアント側の楽観計算。ズレ回復で順序外完了があっても正しい)
    function minPending() {
      for (const s of STATE.slips) if (!doneSet.has(s.seq) && !heldSet.has(s.seq) && !stockoutSet.has(s.seq)) return s.seq;
      return null;
    }
    // 指定 seq の次に表示すべき未処理 (無ければ先頭の未処理へ戻る = 飛ばした伝票の回収)
    function nextPendingAfter(seq) {
      for (const s of STATE.slips) if (s.seq > seq && !doneSet.has(s.seq) && !heldSet.has(s.seq) && !stockoutSet.has(s.seq)) return s.seq;
      return minPending();
    }

    function showToast(msg) {
      $('toast').textContent = msg;
      $('toast').classList.add('show');
      clearTimeout(showToast._t);
      showToast._t = setTimeout(() => $('toast').classList.remove('show'), 2500);
    }

    // ── 描画 ──
    function render() {
      const s = bySeq.get(viewSeq);
      if (!s) return;
      $('progDone').textContent = doneSet.size;
      $('slipNo').textContent = s.neSlipNo;
      $('mall').textContent = s.mall || '';
      const stockoutView = stockoutSet.has(s.seq);
      $('doneTag').style.display = (doneSet.has(s.seq) || heldSet.has(s.seq) || stockoutView) ? 'inline-block' : 'none';
      $('doneTag').textContent = stockoutView
        ? (stockoutNotifyBySlip[s.seq] === 'sent' ? '🚫 出荷保留 (在庫なし・事務へ通知済み)' : '🚫 出荷保留 (在庫なし・事務への通知待ち)')
        : heldSet.has(s.seq) ? '⏳ 保留中 (再ピック待ち)' : '✔ 完了済み';

      const warns = (s.warns || []).map((w) => `<span class="warn-badge">${esc(WARN_LABELS[w] || w)}</span>`).join('');
      // ピッキング欠品の配賦バッジ (欠品フローv2 PR2)。この伝票に入るはずの商品が足りない
      // 商品名で読む (SKU コードだけだと梱包者は商品を特定できない — 例外処理監査 U-23)
      const pname = (p) => p.name ? `${esc(p.name)} <small>${esc(p.sku)}</small>` : esc(p.sku);
      const pqty = (p) => (Number.isFinite(Number(p.qty)) ? Number(p.qty) : 0);
      const pshort = (s.pickingShortages || []).map((p) => p.kind === 'none'
        ? `<span class="warn-badge" style="background:#ffe3e3; border-color:#e03131; color:#c92a2a;">❌ ピッキング欠品: どのロケにもありません — ${pname(p)} × ${pqty(p)}</span>`
        : `<span class="warn-badge" style="background:#fff3bf; border-color:#f08c00; color:#e8590c;">🕒 ピッキング欠品: 3階が後で取りに行きます — ${pname(p)} × ${pqty(p)}</span>`).join('');
      // 明細数に応じた表示密度 (スクロールなしで全明細が見えるように)
      $('paper').dataset.density = s.lines.length <= 1 ? '1' : s.lines.length <= 3 ? '2' : '3';
      const lines = s.lines.map((l) => `
        <div class="line">
          <div class="img" data-sku="${esc(l.sku)}" style="${l.imageUrl ? `background-image:url('${esc(l.imageUrl)}')` : ''}">${l.imageUrl ? '' : '📦'}</div>
          <div class="pname">${esc(l.name)}<div class="pmeta">${esc(l.sku)}</div></div>
          <div class="qty ${l.qty >= 2 ? 'multi' : ''}">${l.qty}<small> 個</small></div>
        </div>`).join('');

      const run = RUNS.get(s.seq);
      // 切替警告と連続カウンタは併記する (連続→連続のSKU切替で警告が消えない — Codex指摘)
      const switchHtml = SWITCH_SEQS.has(s.seq)
        ? `<div style="background:#ffe3e3; border:2px solid #e03131; border-radius:10px; padding:8px 12px; margin-bottom:8px; font-size:16px; font-weight:800; color:#c92a2a;">⚠ 商品が切り替わりました — 前と違う商品です</div>`
        : '';
      const runHtml = switchHtml + (run
        ? `<div style="background:${run.last ? '#fff3bf' : '#e7f5ff'}; border:2px solid ${run.last ? '#f08c00' : '#1971c2'}; border-radius:10px; padding:8px 12px; margin-bottom:8px; display:flex; align-items:center; gap:12px;">
            <span style="font-size:26px; font-weight:800; font-variant-numeric:tabular-nums;">${run.idx} / ${run.total}</span>
            <span style="font-size:15px; font-weight:700;">${run.first ? `🔁 同一商品が${run.total}件連続します` : run.last ? '最後の1件です' : '同一商品の連続中'}</span>
          </div>`
        : '');
      $('paper').innerHTML = `
        ${runHtml}
        <div class="ship-row">
          <span class="method">${esc(STATE.hikiateClass || '')}</span>
          ${s.material ? `<span class="material">${esc(s.material)}</span>` : ''}
          ${s.printHeader1 ? `<span class="material">${esc(s.printHeader1)}</span>` : ''}
          ${s.boxCount > 1 ? `<span class="boxes">箱数 ${s.boxCount}</span>` : ''}
          ${s.deliveryDate ? `<span>配達指定 ${esc(s.deliveryDate)} ${esc(s.deliveryTime || '')}</span>` : ''}
        </div>
        ${matCardHtml(s.seq)}
        ${(warns || pshort) ? `<div class="warns">${pshort}${warns}</div>` : ''}
        <div class="recipient">
          <div class="name">${esc(s.recipientName || '(送り先なし)')} 様</div>
          <div class="addr">〒${esc(s.recipientZip || '')} ${esc(s.recipientPref || '')}${esc(s.recipientAddr || '')}</div>
        </div>
        <div class="order-row">
          <span>受注番号: ${esc(s.siteOrderNo || '-')}</span>
          <span>注文日: ${esc(s.orderDate || '-')}</span>
          <span>明細 ${s.lines.length} 件</span>
        </div>
        <div class="lines-wrap">${lines}</div>`;
      $('sheetArea').scrollTop = 0;

      // ボタン状態: 未処理伝票を表示中なら「次へ=完了」(順序どおり or ズレ回復モード)。
      // 完了済みの閲覧中は「現在の伝票へ」+ 完了取消リンク (最後に完了した伝票のみ)
      const viewingHeld = heldSet.has(viewSeq);
      const viewingPending = !doneSet.has(viewSeq) && !viewingHeld && !stockoutSet.has(viewSeq);
      if (currentSeq == null && unfinishedCount() > 0) {
        // 未処理ゼロだが保留/未確定候補が残る = バッチ未完了。終了処理 (候補送信・受領) へ
        // 戻る入口。以前はここが押せない「全伝票 完了」固定で、終了オーバーレイを閉じたり
        // リロードすると候補を送れず・バッチも完了できずに詰んだ (2026-08-26 出荷_06)
        $('nextBtn').textContent = `🏁 終了処理へ (保留 ${unfinishedCount()} 件)`;
        $('nextBtn').classList.add('jump');
        $('nextBtn').disabled = false;
      } else if (currentSeq == null) {
        $('nextBtn').textContent = '全伝票 完了';
        $('nextBtn').disabled = true;
      } else if (canCompleteSeq(viewSeq)) {
        $('nextBtn').textContent = '次へ ▸';
        $('nextBtn').classList.remove('jump');
        $('nextBtn').disabled = false;
      } else {
        // 閲覧中 (完了済み / 保留 / 作業位置より手前)。
        // ⭐ここは「移動」だけ。完了は作業中の伝票を表示しているときにしかできない
        //   (canComplete の条件は変えていない)。
        //   以前は「現在の伝票へ ▸」= 一気に作業位置へ吹き飛ぶ挙動で、1枚ずつ進む手段が
        //   どこにも無かった (三宅さん 2026-08-29)。戻る導線は上部の帯へ移した
        // 🚨 作業中の「次へ ▸」(= 完了) と同じ文字にしない。
        //    1枚ずつ進んで作業位置に着いた瞬間から、同じ場所が「完了」に変わるので、
        //    文字が同じだと勢いでもう1回押して未梱包の伝票を完了させかねない
        $('nextBtn').textContent = '次の伝票を見る ▸';
        $('nextBtn').classList.add('jump');
        $('nextBtn').disabled = viewSeq >= STATE.slips.length;
      }
      // 作業位置から離れているときだけ「作業へ戻る」を出す
      $('backToWork').style.display = (currentSeq != null && viewSeq !== currentSeq) ? 'block' : 'none';
      // ズレ回復の注意書きは「検索で飛んだその伝票を表示中」のときだけ
      $('jumpBanner').style.display =
        (jumpMode && viewSeq === jumpTargetSeq && viewingPending && viewSeq !== currentSeq) ? 'block' : 'none';
      // 完了取消リンク: 最後に完了した伝票を閲覧中のときだけ
      $('undoLink').style.display = (!viewingPending && !viewingHeld && viewSeq === lastDoneSeq) ? 'block' : 'none';
      // 再ピック保留の伝票: 受領/取下げボタン (受領はピッカーが「持って行った」後のみ活性)
      const ready = repickReadySet.has(viewSeq);
      // 🚫 3階「在庫なし」の報告がある伝票 (保留中の再ピックで unavailable / 未処理の伝票に ❌ どこにもない):
      // 「⏳待ち」で待たせ続けず、赤い箱で知らせて「在庫なしを確認」を出す (PR-2 で ❌ の伝票にも)
      const na = stockoutBySlip[viewSeq] || [];
      $('repickLink').style.display = ((viewingHeld && repickSet.has(viewSeq)) || na.length) ? 'block' : 'none';
      $('stockoutBox').style.display = na.length ? 'block' : 'none';
      if (na.length) {
        $('stockoutList').innerHTML = na.map((t) =>
          `🚫 <b>${esc(t.product_name || t.sku)}</b> <small>${esc(t.sku)}</small> × ${t.unavailable_qty ?? t.req_qty}${(t.fulfilled_qty || 0) > 0 ? ` <small>(${t.fulfilled_qty}個は他ロケから届きます)</small>` : ''} — ${t.source === 'picking' ? 'ピッキング時に「どのロケにもない」' : '再ピックで「在庫なし」'}: ${esc(t.claimed_by || t.requested_by || '-')} ${jstHm(t.updated_at)}`).join('<br>');
        // ボタンはサーバーが許可する伝票にだけ (他の商品の再ピック中・未送信候補ありは 409 になる — Codex R1)
        const canAck = stockoutAckSet.has(viewSeq);
        $('stockoutAckBtn').style.display = canAck ? '' : 'none';
        $('stockoutWait').style.display = canAck ? 'none' : '';
      }
      $('receiveBtn').style.display = (!viewingHeld || (na.length && !ready)) ? 'none' : '';
      // 「見つかった」: 保留中は依頼の取下げ / ❌ の未処理伝票は3階の欠品報告の取り消し (手元の山の下から出てきた — 退路)
      $('foundBtn').style.display = (viewingHeld || na.length) ? '' : 'none';
      $('foundBtn').textContent = viewingHeld ? '見つかった (依頼取下げ)' : '手元で見つかった (欠品報告を取り消す)';
      $('receiveBtn').disabled = !ready;
      $('receiveBtn').textContent = ready ? '📦 再ピック品を受け取った (再開)' : '⏳ 再ピック対応待ち…';
      $('prevBtn').disabled = viewSeq <= 1;
      maybeSpeak();
    }

    // ── 音声読み上げ (要件§5.3。picking #790/#809 の読み上げ方針を踏襲) ──
    // 内容 = 警告の先読み + 「短縮名 + 数量」のみ (商品名全文は読まない)。
    // 伝票遷移で前の発声は必ず cancel。🔊トグルは localStorage に保持
    let ttsOn = localStorage.getItem('packing_tts') !== '0';
    let lastSpokenSeq = null;
    const DAKU = { 'カ':'ガ','キ':'ギ','ク':'グ','ケ':'ゲ','コ':'ゴ','サ':'ザ','シ':'ジ','ス':'ズ','セ':'ゼ','ソ':'ゾ','タ':'ダ','チ':'ヂ','ツ':'ヅ','テ':'デ','ト':'ド','ハ':'バ','ヒ':'ビ','フ':'ブ','ヘ':'ベ','ホ':'ボ','ウ':'ヴ' };
    const HANDAKU = { 'ハ':'パ','ヒ':'ピ','フ':'プ','ヘ':'ペ','ホ':'ポ' };

    // 送り状備考1の正規化: 半角カナ・分離濁点 (カ+゛→ガ)・末尾「/数量」の二重読み・区切り記号を吸収。
    // ⚠順序: 全角゛はNFKCで「空白+結合文字」に分解されるため、先にペア結合してからNFKC、
    // NFKC後にも (半角カナ由来の) 結合文字ペアをもう一度結合する
    function normalizeSpeech(s) {
      const pair = (t) => t
        .replace(/([カキクケコサシスセソタチツテトハヒフヘホウ])[゛゙]/g, (m, c) => DAKU[c] || m)
        .replace(/([ハヒフヘホ])[゜゚]/g, (m, c) => HANDAKU[c] || m);
      let t = pair(String(s || ''));
      t = t.normalize('NFKC');
      t = t.replace(/ (?=[゙゚])/g, '');   // NFKCが挿入する空白を除去して結合可能に
      t = pair(t);
      t = t.replace(/[゙゚]/g, '');        // 結合できなかった濁点は捨てる (読み崩れ防止)
      t = t.replace(/\/\d+\s*$/, '');
      t = t.replace(/[_\/]+/g, ' ').replace(/\s+/g, ' ').trim();
      return t;
    }

    function speak(text) {
      if (!ttsOn || !('speechSynthesis' in window)) return;
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'ja-JP';
      u.rate = 1.1;
      speechSynthesis.speak(u);
    }

    // 警告の読み上げ語。multi_qty は明細読み (「複数、N個」)・multi_box は箱数読みで表現、
    // assort は種類数つきで冒頭に読むため個別処理。未知の警告はバッジ表示名 (絵文字を除く) を読む
    const WARN_SPEECH = { gift: 'ギフトあり', noshi: 'のしあり', comment: 'コメント確認', expiry_lot: '期限ロットあり' };
    function speakSlip(s) {
      const parts = [];
      // 単品×同一SKU連続アシスト (処理はまとめない — アナウンスのみ)
      const run = RUNS.get(s.seq);
      // 切替警告は連続開始と併読する (連続→連続の切替で警告が消えない — Codex指摘)
      if (SWITCH_SEQS.has(s.seq)) parts.push('商品が変わります。ご注意ください');
      if (run && run.first) {
        const l0 = s.lines[0];
        const nm0 = normalizeSpeech(l0.shortName) || [...normalizeSpeech(l0.name)].slice(0, 25).join('');
        parts.push(`${nm0}が、このあと${run.total}件続きます`);
      } else if (run && run.last) {
        parts.push('最後の1件です');
      }
      if ((s.warns || []).includes('assort')) parts.push(`アソート、${s.lines.length}種類`);
      for (const w of (s.warns || [])) {
        if (w === 'multi_qty' || w === 'multi_box' || w === 'assort') continue;
        parts.push(WARN_SPEECH[w] || String(WARN_LABELS[w] || w).replace(/^[^ぁ-ヿ一-龯A-Za-z0-9]+/, ''));
      }
      if (s.boxCount > 1) parts.push(`複数箱、${s.boxCount}箱`);
      // ⚠送り状備考1は「伝票単位」の欄 (全明細で同じ値=全商品の連結文字列)。
      // 複数明細の伝票でこれを明細ごとに読むと、全商品リストを明細の数だけ繰り返してしまう
      // (実機フィードバック 2026-08-16)。短縮名を使うのは単一明細の伝票のみ
      const useShort = s.lines.length === 1;
      for (const l of s.lines) {
        const nm = (useShort && normalizeSpeech(l.shortName)) || [...normalizeSpeech(l.name)].slice(0, 25).join('');
        parts.push(l.qty >= 2 ? `${nm}、複数、${l.qty}個` : `${nm}、1個`);
      }
      speak(parts.join('。'));
    }

    // 梱包対象 (未処理・順序どおり or ズレ回復モード) を新しく表示したときだけ読む。
    // 完了済みの閲覧 (前へ) は読まずに止め、対象へ戻ったら読み直す
    function maybeSpeak() {
      if (!('speechSynthesis' in window)) return;
      // ⭐ボタンの出し分けと同じ判定を使う (canCompleteSeq)。別々に書くと、
      //   「ボタンは閲覧なのに読み上げは梱包対象」というズレが起きる (Codex 2026-08-30)
      const isTarget = canCompleteSeq(viewSeq) && !paused;
      if (isTarget && viewSeq !== lastSpokenSeq) {
        lastSpokenSeq = viewSeq;
        speakSlip(bySeq.get(viewSeq));
      } else if (!isTarget) {
        speechSynthesis.cancel();
        lastSpokenSeq = null;
      }
    }

    function updateTtsBtn() {
      $('ttsBtn').textContent = ttsOn ? '🔊' : '🔇';
      $('ttsBtn').style.opacity = ttsOn ? '1' : '0.5';
    }
    $('ttsBtn').addEventListener('click', () => {
      ttsOn = !ttsOn;
      localStorage.setItem('packing_tts', ttsOn ? '1' : '0');
      updateTtsBtn();
      if (!ttsOn) speechSynthesis.cancel();
      else { lastSpokenSeq = null; maybeSpeak(); }   // ONにした瞬間に現在伝票を読む (タップ=有効化操作)
    });
    updateTtsBtn();

    // ── イベント送信 (localStorage キュー直列送信 — picking と同型の簡易版) ──
    const QKEY = `packing_q_${STATE.batchId}`;
    const loadQ = () => { try { return JSON.parse(localStorage.getItem(QKEY) || '[]'); } catch { return []; } };
    const saveQ = (q) => localStorage.setItem(QKEY, JSON.stringify(q));
    let sending = false;

    function enqueue(event, slipSeq, extra = {}) {
      const q = loadQ();
      const opId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
      q.push({
        op_id: opId,
        event, slip_seq: slipSeq, worker_name: worker,
        client_at: new Date().toISOString(),   // pause/resume の中断時間計測に使う (サーバーでクランプ)
        ...extra,
      });
      saveQ(q);
      pump();
      return opId;
    }
    // 同じ直列キューに載せつつ、その操作の確定 (成功/業務エラー) を待てる版 (受領用 — 楽観更新はしない。
    // 直接 fetch だと送信中のキューと順序が逆転し、応答喪失時に同一 op_id で再送もできない — Codex)
    const waiters = new Map();   // op_id → resolve
    function enqueueAndWait(event, slipSeq, extra = {}) {
      return new Promise((resolve) => {
        const opId = enqueue(event, slipSeq, extra);
        waiters.set(opId, resolve);
      });
    }
    function settle(opId, result) {
      const w = waiters.get(opId);
      if (w) { waiters.delete(opId); w(result); }
    }

    async function pump() {
      if (sending) return;
      sending = true;
      let retryLater = false;   // 一時障害で3秒後の再送を予約した (finally の即時再起動を抑止 — Codex)
      try {
        let q = loadQ();
        while (q.length > 0) {
          const item = q[0];
          let res;
          try {
            res = await fetch(`/apps/packing/api/batches/${STATE.batchId}/events`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(item),
            });
          } catch {
            $('netDot').classList.add('ng');
            retryLater = true;
            setTimeout(pump, 3000);   // オフライン: 3秒後に再送
            return;
          }
          $('netDot').classList.remove('ng');
          if (res.status === 401) { location.href = '/login'; return; }
          if (res.status >= 500 || res.status === 429) {
            // 一時的なサーバー障害: キューを保持したまま再試行 (Codex R1 high:
            // 500系でキューを消すとオフライン中の完了操作が全滅する)
            retryLater = true;
            setTimeout(pump, 3000);
            return;
          }
          if (!res.ok) {
            // 業務エラー (taken / out_of_order 等): 問題の先頭項目だけを隔離して続行。
            // 後続の完了操作 (next(2), next(3)…) はまだ有効なことがある
            const body = await res.json().catch(() => ({}));
            if (!waiters.has(item.op_id)) showToast(body.error || `エラー (${res.status})`);
            q.shift(); saveQ(q);
            settle(item.op_id, { ok: false, status: res.status, body });
            continue;
          }
          const body = await res.json();
          q.shift(); saveQ(q);
          applyServerResult(body);
          settle(item.op_id, { ok: true, body });
        }
        // キューが空になった時点でサーバーと画面を最終同期
        await resync();
      } finally {
        sending = false;
        // resync 中に enqueue された操作が滞留しないよう、残っていれば再起動 (Codex R2 medium)。
        // ただし一時障害の再送予約中は即時再起動しない (3秒待ちが効かず連打になる)
        if (!retryLater && loadQ().length > 0) setTimeout(pump, 0);
      }
    }

    function applyServerResult(body) {
      if (body.materials) MATERIALS = body.materials;   // /state 応答のみ同梱 (資材の再照合)
      if (body.shipNotify === 'failed') {
        showToast('🚨 事務へのGChat通知に失敗しました。口頭かチャットで直接伝えてください (自動再送も試みます)');
      }
      if (body.reprintNotify === 'failed') {
        showToast('🚨 再印刷/送り状なしの通知に失敗しました。口頭かチャットで直接伝えてください (自動再送も試みます)');
      }
      if (body.stockoutNotify === 'failed') {
        showToast('🚨 事務への出荷保留 (在庫なし) の通知に失敗しました。口頭かチャットで直接伝えてください');
      }
      const stateKey = () => `${currentSeq}|${doneSet.size}|${worker}|${lastDoneSeq}|${paused}|${stockoutSet.size}|${stockoutVersion()}`;
      const before = stateKey();
      if (Array.isArray(body.stockoutSeqs)) {
        stockoutSet.clear();
        for (const q of body.stockoutSeqs) stockoutSet.add(q);
      }
      if (body.stockoutBySlip && typeof body.stockoutBySlip === 'object') stockoutBySlip = body.stockoutBySlip;
      if (Array.isArray(body.stockoutAckSeqs)) {
        stockoutAckSet.clear();
        for (const q of body.stockoutAckSeqs) stockoutAckSet.add(q);
      }
      if (body.stockoutNotifyBySlip && typeof body.stockoutNotifyBySlip === 'object') stockoutNotifyBySlip = body.stockoutNotifyBySlip;
      currentSeq = body.currentSeq;
      if (Array.isArray(body.doneSeqs)) {
        // ズレ回復 (順序外完了) があるため、doneSet はサーバーの一覧から再構築する
        doneSet.clear();
        for (const q of body.doneSeqs) doneSet.add(q);
      }
      if (Array.isArray(body.heldSeqs)) {
        heldSet.clear();
        for (const q of body.heldSeqs) heldSet.add(q);
      }
      if (Array.isArray(body.repickSeqs)) {
        repickSet.clear();
        for (const q of body.repickSeqs) repickSet.add(q);
      }
      if (Array.isArray(body.repickReadySeqs)) {
        repickReadySet.clear();
        for (const q of body.repickReadySeqs) repickReadySet.add(q);
      }
      if (Array.isArray(body.incidents)) {
        incidents = body.incidents.map((i) => ({ id: i.id, kind: i.kind, sku: i.sku, actualSku: i.actual_sku ?? i.actualSku, actualName: i.actual_name ?? i.actualName ?? null, qty: i.qty, slipSeq: i.slip_seq ?? i.slipSeq }));
        // 終了画面を開いたままなら候補一覧を更新 (tmp-*が実IDに置き換わりボタンが活性化する)
        if (overlayMode && $('doneOverlay').style.display === 'flex') showEndOverlay(overlayMode === 'done');
      }
      if (body.lastDoneSeq !== undefined) lastDoneSeq = body.lastDoneSeq;
      if (body.worker) { worker = body.worker; $('workerTag').textContent = `👤 ${worker}`; }
      if (body.batchStatus) STATE.batchStatus = body.batchStatus;   // 名前開き直しの交代判定に使う (Codex)
      paused = body.batchStatus === 'paused';
      if (autoResuming && !paused) { autoPaused = false; autoResuming = false; }   // 自動中断の解除完了
      updatePausedOverlay(body.pauseReason);
      if (viewSeq == null) viewSeq = currentSeq ?? STATE.slips.length;
      if (body.batchStatus === 'done') showEndOverlay(true);
      // 楽観更新と同じ結果なら再描画しない (タップのたびに紙面が描き直されてチラつかないように)。
      // 3階の「在庫なし」報告 (stockoutBySlip) の変化も描き直す = 保留中の10秒同期で ⏳ が 🚫 に変わる
      if (before !== stateKey()) render();
    }

    async function resync() {
      // 未送信の操作が残っている間は同期しない (Codex R1 medium: 楽観状態を古いサーバー状態で
      // 巻き戻すと、再タップで重複op → out_of_order を誘発する)。pump 完了後に呼ばれる
      if (loadQ().length > 0) return;
      try {
        const res = await fetch(`/apps/packing/api/batches/${STATE.batchId}/state`);
        if (!res.ok) return;
        applyServerResult(await res.json());
      } catch { /* 次の操作時に再試行 */ }
    }

    // ── 📦 梱包資材 (表示 + 現場登録 — 要件『梱包資材表示』§3〜5) ──
    let MATERIALS = STATE.materials;            // seq → 判定 (null = fail-soft)
    const MATOPTS = STATE.materialOpts;         // { materials, candidateCodes }
    let matUndo = null;                         // { eventId, token, expiresAt }
    let matBusy = false;
    let matOverlaySeq = null;

    function matImgHtml(m) {
      if (m && m.imageUrl) return `<div class="mat-img" style="background-image:url('${esc(m.imageUrl)}')"></div>`;
      const color = (m && m.color) || '#ced4da';
      return `<div class="mat-img" style="background:${esc(color)}22; border-color:${esc(color)}">📦</div>`;
    }

    function matCardHtml(seq) {
      if (!MATERIALS) {
        return `<div class="mat-card gray">❓ 資材情報を取得できません — <button type="button" class="mat-btn" data-mat-retry="1">再試行</button> / 責任者に確認</div>`;
      }
      const c = MATERIALS[seq];
      if (!c || c.source === 'hidden') return '';
      if (c.source === 'held') return `<div class="mat-card gray">⏸ 配送方法変更の依頼中 — 資材は変更後に決まります</div>`;
      if (c.source === 'header') {
        return `<div class="mat-card header">${matImgHtml(c.material)}<div>
            <span class="mat-tag" style="background:#1971c2;color:#fff">📌 伝票指定</span>
            <div class="mat-name">${esc(c.material.name)}</div>
            <div class="mat-sub">この資材で梱包してください${c.headerRuleNote ? ` (登録ルールは ${esc(c.headerRuleNote)})` : ''}</div>
          </div></div>`;
      }
      if (c.source === 'rule') {
        return `<div class="mat-card rule ${matBusy ? 'mat-busy' : ''}">${matImgHtml(c.material)}
          <div style="flex:1 1 auto">
            <span class="mat-tag" style="background:#2b8a3e;color:#fff">✓ 登録済み</span>${c.material.inactive ? '<span class="mat-tag" style="background:#e03131;color:#fff">⚠ 廃止資材</span>' : ''}
            <div class="mat-name">${esc(c.material.name)}</div>
            <div class="mat-sub">この資材で梱包してください <span style="color:#868e96">(資材切れの代替は何も押さない)</span></div>
          </div>
          ${c.canRegister ? `<button type="button" class="mat-btn" data-mat-open="1">違う資材 → 変更</button>` : ''}
        </div>`;
      }
      if (c.source === 'candidates') {
        const minis = (c.candidates.length <= 5 && c.canRegister)
          ? `<div class="mat-mini-row">${c.candidates.map((m) => `<button type="button" class="mat-mini" data-mat-register="${esc(m.code)}">${matImgHtml(m)}${esc(m.name)}</button>`).join('')}
              <button type="button" class="mat-mini other" data-mat-open="1">その他の資材…</button></div>`
          : `<div class="mat-mini-row"><button type="button" class="mat-btn" data-mat-open="1">資材を選ぶ</button></div>`;
        return `<div class="mat-card cand ${matBusy ? 'mat-busy' : ''}"><div style="width:100%">
            <span class="mat-tag" style="background:#f08c00;color:#fff">☆ 未登録</span>
            <b>この中のどれかで梱包 → 使った資材をタップで登録</b>
            <span style="color:#868e96; font-size:13px">(資材切れの代替なら押さない)</span></div>
          ${minis}</div>`;
      }
      if (c.reason === 'no_candidates' && c.canRegister) {
        return `<div class="mat-card cand ${matBusy ? 'mat-busy' : ''}"><div style="width:100%">
            <span class="mat-tag" style="background:#f08c00;color:#fff">☆ 未登録</span> 使った資材を登録できます</div>
          <div class="mat-mini-row"><button type="button" class="mat-btn" data-mat-open="1">資材を選ぶ</button></div></div>`;
      }
      if (c.reason === 'line_invalid') return `<div class="mat-card gray">❓ 明細の形式が不正のため資材を登録できません</div>`;
      return `<div class="mat-card gray">❓ 配送方法を判定できません${c.headerRaw ? `: 「${esc(c.headerRaw)}」` : ''} → 責任者に確認してください</div>`;
    }

    /** 同一 op_id での自動再送付き POST (応答喪失はサーバー側 op_id 再現で二重登録にならない)。 */
    async function matFetch(url, payload) {
      for (let i = 0; i < 3; i += 1) {
        try {
          const r = await fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          const body = await r.json().catch(() => ({}));
          return { ok: r.ok, status: r.status, body };
        } catch { await new Promise((rs) => setTimeout(rs, 1500)); }
      }
      return { ok: false, status: 0, body: { error: '通信エラー。もう一度タップしてください' } };
    }

    async function matRegister(seq, code) {
      if (matBusy) return;
      const c = MATERIALS && MATERIALS[seq];
      if (!c) return;
      if (!worker) { showToast('先に作業者を選んでください'); return; }
      matBusy = true;
      $('matGrid').classList.add('mat-busy');
      render();
      try {
        const res = await matFetch(`/apps/packing/api/batches/${STATE.batchId}/material`, {
          op_id: `mat-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`,
          slip_seq: seq,
          material_code: code,
          expected_rule_id: c.ruleId,
          expected_version: c.ruleVersion,
          expected_delivery_code: c.deliveryCode,
          expected_before: c.material ? c.material.code : null,
          worker_name: worker,
        });
        if (!res.ok) {
          showToast((res.body && res.body.error) || `エラー (${res.status})`);
          await resync();   // 409 (他端末の変更/文脈変化) は現在値で描き直す
          return;
        }
        const b = res.body;
        if (b.noop) { showToast('同じ資材が登録済みです'); await resync(); return; }
        MATERIALS[seq] = {
          ...c, source: 'rule', material: b.rule.material,
          ruleId: b.rule.ruleId, ruleVersion: b.rule.ruleVersion, reason: null, canRegister: true,
        };
        matUndo = { eventId: b.eventId, token: b.undoToken, expiresAt: Date.parse(b.undoExpiresAt) };
        $('matUndoText').textContent = `資材を登録しました: ${b.rule.material.name}`;
        $('matUndoChip').style.display = 'flex';
        tickMatUndo();
        resync();   // 同一構成の他伝票にも反映 (非同期)
      } finally {
        matBusy = false;
        $('matGrid').classList.remove('mat-busy');
        closeMatOverlay();
        render();
      }
    }

    function tickMatUndo() {
      if (!matUndo) return;
      const left = Math.floor((matUndo.expiresAt - Date.now()) / 1000);
      if (left <= 0) { matUndo = null; $('matUndoChip').style.display = 'none'; return; }
      $('matUndoBtn').textContent = `取り消す (${left})`;
      setTimeout(tickMatUndo, 500);
    }

    $('matUndoBtn').addEventListener('click', async () => {
      if (!matUndo) return;
      const u = matUndo;
      matUndo = null;
      $('matUndoChip').style.display = 'none';
      const res = await matFetch(`/apps/packing/api/batches/${STATE.batchId}/material/undo`, {
        op_id: `matundo-${u.eventId}-${Math.random().toString(36).slice(2, 8)}`,
        event_id: u.eventId, undo_token: u.token, worker_name: worker || '',
      });
      showToast(res.ok ? '取り消しました' : ((res.body && res.body.error) || '取り消せませんでした'));
      await resync();
      render();
    });

    function openMatOverlay(seq) {
      const c = MATERIALS && MATERIALS[seq];
      if (!c || !MATOPTS) return;
      matOverlaySeq = seq;
      // 候補集合は分類単位 (candidateCodes)。rule 表示の伝票から開いても上段=候補になる
      const candSet = new Set(MATOPTS.candidateCodes || []);
      for (const m of c.candidates || []) candSet.add(m.code);
      const ranked = [...(MATOPTS.materials || [])]
        .sort((a, b) => (candSet.has(b.code) ? 1 : 0) - (candSet.has(a.code) ? 1 : 0));
      $('matGrid').innerHTML = ranked.map((m) => `
        <button type="button" class="mat-mini ${candSet.has(m.code) ? '' : 'other'}" data-mat-register="${esc(m.code)}">
          ${matImgHtml(m)}${esc(m.name)}
        </button>`).join('');
      $('matOverlay').style.display = 'flex';
      autoPauseStart();
    }
    function closeMatOverlay() {
      if ($('matOverlay').style.display !== 'flex') return;
      $('matOverlay').style.display = 'none';
      matOverlaySeq = null;
      autoPauseEnd();
    }
    $('matCancel').addEventListener('click', closeMatOverlay);
    $('matGrid').addEventListener('click', (e) => {
      const b = e.target.closest('[data-mat-register]');
      if (b && matOverlaySeq != null) matRegister(matOverlaySeq, b.dataset.matRegister);
    });
    $('paper').addEventListener('click', (e) => {
      const reg = e.target.closest('[data-mat-register]');
      if (reg) { matRegister(viewSeq, reg.dataset.matRegister); return; }
      const open = e.target.closest('[data-mat-open]');
      if (open) { openMatOverlay(viewSeq); return; }
      if (e.target.closest('[data-mat-retry]')) resync().then(render);
    });

    // ── 操作 ──
    function goNext() {
      if (paused || matBusy) return;
      if (currentSeq == null) {
        // 未処理ゼロ: 保留/候補が残っていれば終了処理へ戻る (閉じた・リロードした後の再入口)
        if (STATE.batchStatus !== 'done' && unfinishedCount() > 0) { jumpMode = false; jumpTargetSeq = null; showEndOverlay(false); }
        return;
      }
      if (!canCompleteSeq(viewSeq)) {
        // 🚨 完了はしない (canComplete が false = 表示中の伝票は完了できない)。
        //    以前はここで viewSeq = currentSeq とし、作業位置へ一気に戻していた。
        //    そのため「1枚ずつ戻れるのに、1枚ずつ進めない」状態だった (三宅さん 2026-08-29)。
        //    移動だけを行う。戻る導線は上部の「↩ 作業中の伝票へ戻る」。
        if (viewSeq < STATE.slips.length) { viewSeq += 1; render(); }
        return;
      }
      // 表示中伝票の完了宣言 + 次伝票へ (楽観的にUI更新・イベントはキュー送信)。
      // ズレ回復モード中は jumped フラグつきで順序外の完了を明示する
      const wasJump = jumpMode && viewSeq === jumpTargetSeq && viewSeq !== currentSeq;
      $('searchBack').style.display = 'none';
      enqueue('next', viewSeq, wasJump ? { jumped: true } : {});
      doneSet.add(viewSeq);
      lastDoneSeq = viewSeq;
      const next = nextPendingAfter(viewSeq);
      currentSeq = minPending();
      if (next != null) {
        if (wasJump && next === minPending() && next < viewSeq) {
          showToast('未処理の伝票が残っています。先頭に戻ります');
          jumpMode = false; jumpTargetSeq = null;
        }
        viewSeq = next;
        render();
      } else if (heldSet.size > 0 || incidents.length > 0) {
        // 一通り終えた (未処理ゼロ) — ここで候補をまとめてピッキングへ送信する (⭐候補方式)
        jumpMode = false; jumpTargetSeq = null;
        render();
        showEndOverlay(false);
      } else {
        jumpMode = false; jumpTargetSeq = null;
        showEndOverlay(true);
        render();
        // render 内の maybeSpeak (閲覧扱いの cancel) より後に完了を読み上げる
        speak(`${STATE.folderName} ${STATE.slips.length}件、完了しました`);
      }
    }

    function goPrev() {
      if (matBusy) return;
      if (viewSeq > 1) { viewSeq -= 1; render(); }
    }

    // 閲覧から作業位置へ一発で戻る (100枚戻ったあとに1枚ずつ進むのは現実的でないため残す)
    $('backToWorkBtn').addEventListener('click', () => {
      if (currentSeq == null) return;
      viewSeq = currentSeq;
      jumpMode = false; jumpTargetSeq = null;
      $('searchBack').style.display = 'none';
      render();
    });

    $('endClose').addEventListener('click', () => { overlayMode = null; $('doneOverlay').style.display = 'none'; });
    $('nextBtn').addEventListener('click', goNext);
    $('prevBtn').addEventListener('click', goPrev);

    // ── 中断 / 再開 ──
    // ④⑥フォームを開いている間の自動中断 (計測から除外)。中断オーバーレイは出さない。
    // autoPaused は resume の**サーバー応答まで**維持する (Codexレビュー: 即時クリアすると
    // 応答までの間に中断オーバーレイがフラッシュ表示され、再オープン時の計測漏れも生む)
    let autoPaused = false;
    let autoResuming = false;
    function autoPauseStart() {
      if (paused || autoPaused || !worker || STATE.batchStatus !== 'packing') return;
      autoPaused = true;
      autoResuming = false;
      enqueue('pause', null, { reason: '配送変更の入力' });
    }
    function autoPauseEnd() {
      if (!autoPaused || autoResuming) return;
      // ④→⑥と連続で開くケースがあるため、両方閉じたときだけ再開する
      if ($('shipOverlay').style.display === 'flex' || $('ruleOverlay').style.display === 'flex'
          || $('matOverlay').style.display === 'flex') return;
      autoResuming = true;
      enqueue('resume', null);
    }
    function updatePausedOverlay(reason) {
      $('pausedOverlay').style.display = (paused && !autoPaused) ? 'flex' : 'none';
      if (paused && !autoPaused) $('pausedReason').textContent = reason ? `(${reason})` : '';
    }
    $('pauseBtn').addEventListener('click', () => {
      if (paused || currentSeq == null || !worker) return;
      $('pauseOverlay').style.display = 'flex';
    });
    $('pauseCancel').addEventListener('click', () => { $('pauseOverlay').style.display = 'none'; });
    document.querySelectorAll('.pause-reason').forEach((btn) => {
      btn.addEventListener('click', () => {
        $('pauseOverlay').style.display = 'none';
        paused = true;
        updatePausedOverlay(btn.dataset.reason);
        speechSynthesis.cancel?.();
        enqueue('pause', null, { reason: btn.dataset.reason });
      });
    });
    $('resumeBtn').addEventListener('click', () => {
      paused = false;
      updatePausedOverlay(null);
      lastSpokenSeq = null;   // 再開時に現在伝票を読み直す
      enqueue('resume', null);
      render();
    });

    // ── 完了取消 (理由必須・監査ログ) ──
    $('undoBtn').addEventListener('click', () => { $('undoOverlay').style.display = 'flex'; });
    $('undoCancel').addEventListener('click', () => { $('undoOverlay').style.display = 'none'; });
    document.querySelectorAll('.undo-reason').forEach((btn) => {
      btn.addEventListener('click', () => {
        $('undoOverlay').style.display = 'none';
        const target = lastDoneSeq;
        if (target == null) return;
        enqueue('undo', target, { reason: btn.dataset.reason });
        doneSet.delete(target);
        lastDoneSeq = null;   // 正確な値はサーバー応答 (lastDoneSeq) で入り直す
        currentSeq = minPending();
        viewSeq = target;
        $('doneOverlay').style.display = 'none';
        render();
      });
    });

    // ── 終了オーバーレイ (⭐候補方式: 一通り終えたらここからまとめてピッキングへ送信 — 要件§5.6) ──
    const INC_LABEL = { shortage: '📉 不足', excess: '📈 余り', wrong_item: '🔀 品違い' };
    let overlayMode = null;   // 'done' | 'end' | null (表示中の同期反映で使う)
    const endActual = {};   // 品違いの実物特定 (incidentId → {sku,name})
    function showEndOverlay(done) {
      overlayMode = done ? 'done' : 'end';
      $('doneOverlay').style.display = 'flex';
      $('doneTitle').innerHTML = done
        ? `✅ ${esc(STATE.folderName)}<br>${STATE.slips.length}伝票 完了しました`
        : `🏁 ひととおり処理しました`;
      $('endClose').style.display = done ? 'none' : 'inline-block';
      // 保留伝票の状態と受領ボタンを終了画面にも置く (受領のために伝票を探し回らない — 2026-08-23)
      const heldList = [...heldSet].sort((a, b) => a - b);
      $('endHint').style.display = (!done && heldList.length > 0) ? 'block' : 'none';
      if (!done && heldList.length > 0) {
        $('endHint').innerHTML = '保留中の伝票: ' + heldList.map((q) => repickReadySet.has(q)
          ? `<button type="button" class="end-receive" data-seq="${q}" style="margin:4px; padding:10px 16px; background:#2b8a3e; color:#fff; border:none; border-radius:10px; font-weight:800; font-size:16px">📦 #${q} 届いた分を受け取る (再開)</button>`
          : (stockoutBySlip[q] || []).length
            ? (stockoutAckSet.has(q)
              ? `<button type="button" class="end-stockout" data-seq="${q}" style="margin:4px; padding:10px 16px; background:#e03131; color:#fff; border:none; border-radius:10px; font-weight:800; font-size:16px">🚫 #${q} 3階: 在庫なし → 確認して出荷保留にする</button>`
              : `<span style="display:inline-block; margin:4px; padding:8px 12px; background:#ffe3e3; color:#c92a2a; border-radius:10px">🚫 #${q} 在庫なし (他の商品の再ピック待ち)</span>`)
            : `<span style="display:inline-block; margin:4px; padding:8px 12px; background:#f1f3f5; border-radius:10px">⏳ #${q} 再ピック対応待ち</span>`).join('')
          + '<div style="font-size:13px; margin-top:4px">ピッカーが持ってきたら「受け取る」で再開します (上の緑バナーからも可)。在庫なしの伝票は「確認」で閉じると事務へ通知されます</div>';
        $('endHint').querySelectorAll('.end-receive').forEach((b) => b.addEventListener('click', () => receiveSlip(Number(b.dataset.seq))));
        $('endHint').querySelectorAll('.end-stockout').forEach((b) => b.addEventListener('click', () => stockoutAck(Number(b.dataset.seq))));
      }
      if (incidents.length === 0) { $('incBox').style.display = 'none'; return; }
      $('incBox').style.display = 'block';
      $('incList').innerHTML = incidents.map((i) => {
        const syncing = String(i.id).startsWith('tmp');   // サーバー同期前はIDが仮 (Codex medium)
        const dis = syncing ? 'disabled style="opacity:.5"' : '';
        // 品違い: 実物 (梱包側にある間違い品) を商品検索で特定してから送信 (2026-08-21)。
        // この特定作業はバッチ完了打刻の後 = 梱包計測には入らない
        // 品違いの実物は記録時に特定済みが基本 (2026-08-23)。ここは確認のみで、必要なら「修正」で検索を開く
        const known = endActual[i.id] || (i.actualSku ? { sku: i.actualSku, name: i.actualName || null } : null);
        const identBlock = i.kind === 'wrong_item' ? `
          <div style="padding:4px 0 8px; border-bottom:1px solid #f1f3f5; font-size:14px">
            間違い品: ${known
              ? `<b style="color:#2b8a3e">${esc(known.sku)}</b> ${esc(known.name || '')} <button type="button" class="inc-edit" data-id="${i.id}" style="margin-left:8px; padding:4px 10px; border:1px solid #ced4da; border-radius:8px; background:#fff">修正</button>`
              : '<b style="color:#c5221f">未特定 — 検索してください</b>'}
            <input type="search" class="inc-search" data-id="${i.id}" placeholder="商品名で検索 (例: ひのき)"
              style="width:100%; margin-top:6px; padding:10px; font-size:15px; border:1px solid #ced4da; border-radius:8px; ${known ? 'display:none' : ''}">
            <div class="inc-search-res" data-id="${i.id}" style="display:flex; flex-direction:column; gap:4px; margin-top:4px"></div>
          </div>` : '';
        return `
        <div style="display:flex; gap:10px; align-items:center; padding:8px 0; border-bottom:1px solid #f1f3f5">
          <span style="flex:1; font-size:15px">${INC_LABEL[i.kind] || i.kind} ${esc(i.sku)}${i.actualSku ? ` (実際: ${esc(i.actualSku)})` : ''} × ${i.qty}${i.slipSeq ? ` / #${i.slipSeq}` : ''}${syncing ? ' <small>同期中…</small>' : ''}</span>
          <button type="button" class="inc-confirm" data-id="${i.id}" ${dis} ${syncing ? '' : 'style="padding:8px 14px; background:#e03131; color:#fff; border:none; border-radius:8px; font-weight:700"'}>ピッキングへ送信</button>
          <button type="button" class="inc-withdraw" data-id="${i.id}" ${dis} ${syncing ? '' : 'style="padding:8px 14px; background:#f1f3f5; border:1px solid #ced4da; border-radius:8px"'}>取下げ</button>
        </div>${identBlock}`;
      }).join('');
      // 品違いの商品検索 (在庫検索と同じデータ源。300msデバウンス)
      document.querySelectorAll('.inc-search').forEach((input) => {
        let timer = null;
        input.addEventListener('input', () => {
          clearTimeout(timer);
          timer = setTimeout(async () => {
            const q = input.value.trim();
            const box = document.querySelector(`.inc-search-res[data-id="${input.dataset.id}"]`);
            if (q.length < 2) { box.innerHTML = ''; return; }
            try {
              const res = await fetch(`/apps/packing/api/stock-search?q=${encodeURIComponent(q)}`);
              const body = await res.json();
              box.innerHTML = (body.items || []).map((it, idx) =>
                `<button type="button" class="inc-pick" data-id="${input.dataset.id}" data-idx="${idx}"
                   style="text-align:left; padding:8px; border:1px solid #ced4da; border-radius:8px; background:#fff">
                   ${esc(it.name || it.sku)}<br><small>${esc(it.sku)}${it.free != null ? ` / フリー${it.free}` : ''}</small></button>`).join('')
                || '<small style="color:#868e96">該当なし</small>';
              box._items = body.items || [];
              box.querySelectorAll('.inc-pick').forEach((btn) => {
                btn.addEventListener('click', () => {
                  const it = box._items[Number(btn.dataset.idx)];
                  endActual[btn.dataset.id] = { sku: it.sku, name: it.name || null };
                  showEndOverlay($('endClose').style.display === 'none');
                });
              });
            } catch { box.innerHTML = '<small style="color:#c5221f">検索エラー</small>'; }
          }, 300);
        });
      });
      document.querySelectorAll('.inc-edit').forEach((btn) => {
        btn.addEventListener('click', () => {
          const input = document.querySelector(`.inc-search[data-id="${btn.dataset.id}"]`);
          if (input) { input.style.display = 'block'; input.focus(); }
        });
      });
      document.querySelectorAll('.inc-confirm, .inc-withdraw').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const decision = btn.classList.contains('inc-confirm') ? 'confirm' : 'withdraw';
          btn.disabled = true;
          try {
            const res = await fetch(`/apps/packing/api/batches/${STATE.batchId}/incidents/${btn.dataset.id}/resolve`, {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ decision, worker_name: worker,
                actual_sku: endActual[btn.dataset.id]?.sku ?? null,
                actual_name: endActual[btn.dataset.id]?.name ?? null }),
            });
            if (!res.ok) { const b = await res.json().catch(() => ({})); showToast(b.error || `エラー (${res.status})`); return; }
            if (decision === 'confirm') showToast('ピッキングへ送信しました');
            incidents = incidents.filter((i) => i.id !== Number(btn.dataset.id));
            await resync();
            showEndOverlay($('endClose').style.display === 'none');
          } finally { btn.disabled = false; }
        });
      });
    }

    // ── ①不足 / ②余り / 品違い (要件§5.4〜5.6) ──
    let issue = null;   // { type, sku, actualSku, maxQty }
    function issueReset() { issue = null; $('issueOverlay').style.display = 'none'; }
    function slipSkuButtons(onPick) {
      const s = bySeq.get(viewSeq);
      $('issueSkuGrid').innerHTML = s.lines.map((l, i) =>
        `<button class="reason-opt issue-sku" data-i="${i}" style="grid-column:1/-1; text-align:left">${esc(l.name)}<br><small>${esc(l.sku)} × ${l.qty}個</small></button>`).join('');
      document.querySelectorAll('.issue-sku').forEach((btn) => {
        btn.addEventListener('click', () => onPick(s.lines[Number(btn.dataset.i)]));
      });
    }
    // 数量: 1〜9 はワンタップ、10以上は数値入力 (上限 = 明細数量 / 余りは999)。
    // 「9個までしか選べない」欠陥の修正 (現場指摘 2026-08-23 — 誤った数量のままタスクとミス記録に流れていた)
    function qtyButtons(max, onPick) {
      const n = Math.min(max, 9);
      const more = max > 9 ? `
        <div style="grid-column:1/-1; display:flex; gap:8px; align-items:center; margin-top:6px">
          <input type="number" inputmode="numeric" id="issueQtyInput" min="1" max="${max}" placeholder="10〜${max} を入力"
            style="flex:1; padding:12px; font-size:20px; border:1px solid #ced4da; border-radius:10px">
          <button type="button" class="reason-opt" id="issueQtyOk" style="min-width:96px">決定</button>
        </div>` : '';
      $('issueQtyGrid').innerHTML = Array.from({ length: n }, (_, i) =>
        `<button class="reason-opt issue-qty" data-q="${i + 1}">${i + 1}個</button>`).join('') + more;
      document.querySelectorAll('.issue-qty').forEach((btn) => {
        btn.addEventListener('click', () => onPick(Number(btn.dataset.q)));
      });
      if (max > 9) {
        const ok = () => {
          const v = Number($('issueQtyInput').value);
          if (!Number.isInteger(v) || v < 1 || v > max) { showToast(`数量は 1〜${max} で入力してください`); return; }
          onPick(v);
        };
        $('issueQtyOk').addEventListener('click', ok);
        $('issueQtyInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); ok(); } });
      }
    }

    // 品違いの「実際に入っていた商品」の特定 (記録時・2026-08-23)。
    // 手に持っている瞬間が一番特定しやすく、終了画面での再入力をなくす (Codex/中原さん)。
    // バッチ内の他商品を候補ボタン + 在庫検索 (サーバーで形式+実在を検証)。自由入力文字列は送らない
    function pickActualItem(expected, onPick) {
      $('issueTitle').textContent = '実際に入っていた商品は？ (候補をタップ or 検索)';
      const cands = allBatchSkus().filter(([sku]) => sku !== expected.sku);
      $('issueSkuGrid').innerHTML = cands.slice(0, 8).map(([sku, name], i) =>
        `<button class="reason-opt issue-cand" data-i="${i}" style="grid-column:1/-1; text-align:left">${esc(name)}<br><small>${esc(sku)}</small></button>`).join('');
      document.querySelectorAll('.issue-cand').forEach((btn) => {
        btn.addEventListener('click', () => { const [sku, name] = cands[Number(btn.dataset.i)]; onPick({ sku, name }); });
      });
      const input = $('issueSkuInput');
      const res = $('issueSearchRes');
      input.style.display = 'block'; input.value = ''; input.removeAttribute('list');
      input.placeholder = '商品名 or SKU で在庫検索 (例: ひのき)';
      input.onchange = null;
      res.innerHTML = '';
      // 検索で出ないとき (未設定・障害・検索漏れ) の逃げ道: SKUをそのまま使う (形式はサーバーでも検証。名前は付けない)
      const directHtml = (q) => `<button type="button" class="reason-opt issue-direct" data-sku="${esc(q)}" style="text-align:left; border-style:dashed">
          検索に出ない → 入力した「${esc(q)}」をSKUとして使う<br><small>バーコード/商品コードを正確に入力した場合のみ</small></button>`;
      const bindDirect = () => res.querySelectorAll('.issue-direct').forEach((b) => b.addEventListener('click', () => {
        const sku = String(b.dataset.sku || '').trim().toLowerCase();
        if (!/^[a-z0-9][a-z0-9_\-.]{0,79}$/.test(sku)) { showToast('SKUの形式が不正です (英数字・-_.)'); return; }
        onPick({ sku, name: null });
      }));
      let timer = null;
      input.oninput = () => {
        clearTimeout(timer);
