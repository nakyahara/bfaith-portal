    function sendIssue({ type, sku, actualSku, actualName, qty }) {
      issueReset();
      $('issueQtyLabel').textContent = '数量は?';
      const seq = viewSeq;
      if (type === 'excess') {
        enqueue('excess', seq, { sku, qty });
