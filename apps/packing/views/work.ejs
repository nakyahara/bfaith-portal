    // ── ⑥ 恒久ルール変更の申請 (現在の登録を表示→実在行を選ぶ→変更後を大ボタンで選択 —
    //     2026-08-21 中原さん指示+Codex UX相談。帯の当てずっぽう入力を構造的に排除) ──
    let ruleSlipSeq = null;
    let ruleCtx = null;   // { kind, cur, options, selRow, choice }
    const MALL_LABEL = { rakuten: '楽天', yahoo: 'Yahoo/その他', amazon: 'Amazon' };
    const bandLabel = (r) => r.qty_max == null ? `${r.qty_min}個以上`
      : (r.qty_min === r.qty_max ? `${r.qty_min}個` : `${r.qty_min}〜${r.qty_max}個`);
    function guessMall(mallName) {
      const m = String(mallName || '');
      if (m.includes('楽天')) return 'rakuten';
      if (m.includes('Amazon') || m.includes('amazon') || m.includes('アマゾン')) return 'amazon';
      return 'yahoo';   // Yahoo/auPay/Qoo10 等は yahoo グループ運用
    }
    async function openRuleOverlay() {
      const sl = bySeq.get(viewSeq);
      ruleSlipSeq = viewSeq;
      ruleCtx = null;
      $('ruleDesc').textContent = '現在の登録を読み込み中…';
      $('ruleCurrent').innerHTML = '';
