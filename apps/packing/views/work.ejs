        showToast(`余り候補に追加: ${sku} × ${qty} (最後にまとめて送信します)`);
        return;
      }
      enqueue(type, seq, type === 'wrong_item' ? { sku, actual_sku: actualSku, actual_name: actualName || null, qty } : { sku, qty });
      incidents.push({ id: `tmp-${Date.now()}`, kind: type, sku, actualSku: actualSku || null, actualName: actualName || null, qty, slipSeq: seq });
      doneSet.delete(seq);
      heldSet.add(seq);
      repickSet.add(seq);
      $('doneOverlay').style.display = 'none';
      showToast(type === 'shortage'
        ? `不足候補に追加: ${sku} × ${qty} — 伝票は保留。途中で出てきたら「見つかった」`
        : '品違い候補に追加しました (最後にまとめて送信します)');
      currentSeq = minPending();
      const next = nextPendingAfter(seq);
      if (next != null) { viewSeq = next; }
