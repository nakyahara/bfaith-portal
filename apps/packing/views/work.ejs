    }
    // 受領 = 状態遷移の要なのでサーバー応答を待ってから画面を進める (楽観更新しない — Codex 2026-08-23)。
    // 入口は3つ: 伝票画面のボタン / ヘッダーの緑バナー / 終了画面の保留一覧。いずれも同じ処理
    let receiving = false;
    async function receiveSlip(seq) {
      if (!worker) { showToast('先に作業者の名前を選んでください'); return; }
      if (paused) { showToast('中断中です。再開してから受け取ってください'); return; }
      if (receiving || !bySeq.has(seq)) return;
      receiving = true;
      showToast('受領を送信中…');
      try {
        // 通常操作と同じキューで直列に送る (先行の操作が届いてから受領が処理される)。
        // 通信断はキューが同一 op_id で再送するので、二重受領や取りこぼしにならない
        const r = await enqueueAndWait('receive', seq, {});
        if (!r.ok) { showToast(r.body?.error || `エラー (${r.status})`); return; }
        if ($('doneOverlay').style.display === 'flex') { $('doneOverlay').style.display = 'none'; overlayMode = null; }
        viewSeq = seq; jumpMode = false; jumpTargetSeq = null;   // 受領した伝票へ自動ジャンプ (探し回らない)
        render();
        showToast(`伝票 #${seq} の保留を解除しました。梱包を続けてください`);
        if (window.__floorAlertsPoll) window.__floorAlertsPoll();
      } finally { receiving = false; }
    }
    $('receiveBtn').addEventListener('click', () => receiveSlip(viewSeq));
    // 🚫 在庫なしを確認 (Q1 決定 2026-09-05 = 案a): 伝票を『出荷保留 (在庫なし)』にして閉じ、事務へ通知する。
    // 受領と同じくサーバー応答を待ってから画面を進める (状態遷移の要なので楽観更新しない)
    async function stockoutAck(seq) {
      if (!worker) { showToast('先に作業者の名前を選んでください'); return; }
      if (paused) { showToast('中断中です。再開してから操作してください'); return; }
      if (receiving || !bySeq.has(seq)) return;
      const items = (stockoutBySlip[seq] || []).map((t) => `${t.product_name || t.sku} × ${t.req_qty}`).join(' / ');
      if (!confirm(`伝票 #${seq} を「出荷保留 (在庫なし)」にして閉じます。事務へ通知し、NE で出荷保留にしてもらいます。\n${items}\n商品と納品書は出荷保留の棚へ置いてください。よろしいですか?`)) return;
      receiving = true;
      showToast('在庫なしの確認を送信中…');
      try {
        const r = await enqueueAndWait('stockout_ack', seq, {});
        if (!r.ok) { showToast(r.body?.error || `エラー (${r.status})`); return; }
        heldSet.delete(seq); repickSet.delete(seq); stockoutSet.add(seq); delete stockoutBySlip[seq]; stockoutAckSet.delete(seq);
        currentSeq = minPending();
        if ($('doneOverlay').style.display === 'flex') { $('doneOverlay').style.display = 'none'; overlayMode = null; }
        if (r.body?.batchStatus === 'done') {
          STATE.batchStatus = 'done';
          render();
          showEndOverlay(true);
        } else if (currentSeq == null && unfinishedCount() > 0) {
          render();
          showEndOverlay(false);
        } else {
          if (currentSeq != null) { viewSeq = currentSeq; jumpMode = false; jumpTargetSeq = null; }
          render();
        }
        showToast(r.body?.stockoutNotify === 'sent'
          ? `伝票 #${seq} を出荷保留 (在庫なし) にしました。事務へ通知済みです`
          : `🚨 伝票 #${seq} を出荷保留にしました。事務への通知はまだ届いていません (自動で再送します)。急ぐなら口頭かチャットで伝えてください`);
        if (window.__floorAlertsPoll) window.__floorAlertsPoll();
      } finally { receiving = false; }
    }
    $('stockoutAckBtn').addEventListener('click', () => stockoutAck(viewSeq));
    document.addEventListener('packing:receive', (e) => {
      if (Number(e.detail.batchId) === STATE.batchId) receiveSlip(Number(e.detail.slipSeq));
    });
    // ピッカーの完了を操作なしでも拾う: バナーの集合が変わったら同期 / 保留中は10秒ごとに同期
    document.addEventListener('packing:repick-ready', (e) => {
      // 受領可の伝票集合 (サーバー) と画面の repickReadySet がどちら向きにでもズレたら同期
      const mine = new Set((e.detail.items || []).filter((t) => Number(t.batch_id) === STATE.batchId).map((t) => Number(t.slip_seq)));
      const same = mine.size === repickReadySet.size && [...mine].every((q) => repickReadySet.has(q));
      if (!same) resync();
    });
    setInterval(() => { if (repickSet.size > 0 && !sending && loadQ().length === 0) resync(); }, 10000);
    $('foundBtn').addEventListener('click', () => {
      const seq = viewSeq;
      if (!heldSet.has(seq)) {
        // ❌ の未処理伝票: 3階の「どこにもない」報告を取り消す (この受注の分だけ)。伝票はそのまま梱包できる
        if (!confirm('この伝票の商品が手元で見つかったため、3階の「どこにもない」の報告を取り消します。よろしいですか?')) return;
        enqueue('found', seq, {});
        const s = bySeq.get(seq);
        if (s) s.pickingShortages = (s.pickingShortages || []).filter((p) => p.kind !== 'none');
        delete stockoutBySlip[seq]; stockoutAckSet.delete(seq);
        showToast('欠品の報告を取り消しました。そのまま梱包して「次へ」を押してください');
        render();
        return;
      }
      if (!confirm('商品が見つかったため、再ピック依頼とミス候補を取り下げます。よろしいですか?')) return;
      enqueue('found', seq, {});
      heldSet.delete(seq); repickSet.delete(seq);
      incidents = incidents.filter((i) => i.slipSeq !== seq || i.kind === 'excess');
      currentSeq = minPending();
      // 見つかった商品は手元にある → その伝票を今すぐ梱包して「完了」できるように、その伝票に留まる
      // (以前は先頭の未処理へ戻していたため、あとで納品書を探して開き直す作業が生じた — 2026-08-31 現場意見)。
      // 作業位置より後ろの伝票なら順序外の完了 (jumped) として送る
      viewSeq = seq;
      if (seq !== currentSeq) { jumpMode = true; jumpTargetSeq = seq; } else { jumpMode = false; jumpTargetSeq = null; }
      showToast('依頼を取り下げました。見つかった商品を梱包して「完了」を押してください');
      render();
    });

    // ── 🖨 伝票再印刷依頼 (2026-08-21): 押した瞬間に事務 (バックオフィス連絡) へ即時通知。
    // 理由入力なし・画面に痕跡も残さない (記録はDB/イベントのみ)。送り状PDFの抜き出しはサーバー側 best-effort
    $('reprintBtn').addEventListener('click', () => {
      if (paused || !worker) return;
