        // 現在ネコポスの伝票が主用途なので deliveryMethod フィルタの外で常に出す
        + (STATE.twoLabelsOption ? `<button class="reason-opt ship-method" data-m="${esc(STATE.twoLabelsOption)}" style="grid-column:1/-1; background:#fff4e6; border-color:#e8590c">📦📦 ${esc(STATE.twoLabelsOption)} (送り状2枚)</button>` : '');
