      $('ruleSubmit').disabled = true;
      $('ruleOverlay').style.display = 'flex';
      autoPauseStart();
      let opt;
      let cur;
      try {
        [opt, cur] = await Promise.all([
          fetch('/apps/packing/api/rule-change/options').then((r) => r.json()),
          fetch(`/apps/packing/api/batches/${STATE.batchId}/rule-current`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slip_seq: viewSeq }),
          }).then((r) => r.json()),
        ]);
        if (opt.error || cur.error) throw new Error(cur.error || opt.error);
      } catch (e) {
        $('ruleDesc').textContent = `現在の登録を取得できませんでした: ${e.message}`;
        return;
      }
      ruleCtx = { kind: cur.kind, cur, options: opt, selRow: null, choice: null };
      const totalQty = sl.lines.reduce((a, l) => a + l.qty, 0);
      if (cur.kind === 'single') {
        $('ruleDesc').textContent = `単品ルール: ${sl.lines[0].name}`;
        if (!cur.registered || cur.ambiguous || !(cur.rows || []).length) {
          $('ruleCurrent').innerHTML = `<div style="color:#c92a2a; font-size:14px">${cur.ambiguous
            ? 'この商品はカラー/サイズ違いのルールが複数あり、ここからは変更できません。'
            : 'この商品の配送ルールは未登録です。'}packing-dispatch画面から操作してください</div>`;
          return;
        }
        const gm = guessMall(sl.mall);
        const inBand = (r) => r.qty_min <= totalQty && (r.qty_max == null || totalQty <= r.qty_max);
        const pick = cur.rows.find((r) => r.mall_group === gm && inBand(r))
          || cur.rows.find((r) => r.mall_group === 'rakuten' && inBand(r))
          || cur.rows[0];
        ruleSelectRow(pick, gm);
      } else {
        $('ruleDesc').textContent = `アソート学習: この${sl.lines.length}種の組み合わせ`;
        const d = cur.decision;
        $('ruleCurrent').innerHTML = `
          <div style="border:2px solid #dee2e6; border-radius:10px; padding:10px 12px">
            <div style="font-size:12px; color:#868e96">現在の学習</div>
            <div style="font-size:17px; font-weight:800">${d ? `${esc(d.method_name)} (${esc(d.machine_name)})` : '未学習 — 今回の申請で新規登録されます'}</div>
            <div style="font-size:13px; color:#868e96; margin-top:4px">${sl.lines.map((l) => `${esc(l.name)} × ${l.qty}`).join(' / ')}</div>
          </div>`;
        renderRuleCombos(d ? { method: d.shipping_method_code, machine: d.packing_machine_code } : null);
      }
    }
    function ruleSelectRow(row, gm) {
      ruleCtx.selRow = row;
      const others = ruleCtx.cur.rows.length - 1;
      const fallbackNote = (gm && gm !== row.mall_group)
        ? `<div style="font-size:13px; color:#c92a2a; margin-top:4px">※ ${esc(MALL_LABEL[gm] || gm)} のモール別登録は無く、楽天の登録が使われています。変更は楽天登録に対して行われます</div>` : '';
      const rakutenNote = row.mall_group === 'rakuten'
        ? '<div style="font-size:12px; color:#868e96; margin-top:4px">楽天の登録は、モール別登録が無いモールにも使われます</div>' : '';
      $('ruleCurrent').innerHTML = `
        <div style="border:2px solid #1971c2; border-radius:10px; padding:10px 12px">
          <div style="font-size:12px; color:#868e96">今回該当する登録</div>
          <div style="font-size:17px; font-weight:800">${esc(MALL_LABEL[row.mall_group] || row.mall_group)} / ${bandLabel(row)} → ${esc(row.method_name)} (${esc(row.machine_name)})</div>
          ${fallbackNote}${rakutenNote}
          ${others > 0 ? `<button type="button" id="ruleMore" style="border:none; background:none; color:#1971c2; text-decoration:underline; font-size:13px; margin-top:6px; padding:0">ほかの帯・モールを見る (${others})</button><div id="ruleRows" style="display:none"></div>` : ''}
        </div>`;
      if (others > 0) {
        $('ruleMore').addEventListener('click', () => {
          const box = $('ruleRows');
          if (!box.innerHTML) {
            box.innerHTML = ruleCtx.cur.rows.map((r, i) => `
              <button type="button" class="rule-row" data-i="${i}" style="display:block; width:100%; text-align:left; padding:12px; margin-top:6px; border:2px solid ${r === ruleCtx.selRow ? '#1971c2' : '#dee2e6'}; border-radius:10px; background:#fff; font-size:14px">
                ${esc(MALL_LABEL[r.mall_group] || r.mall_group)} / ${bandLabel(r)} → ${esc(r.method_name)} (${esc(r.machine_name)})</button>`).join('');
            box.querySelectorAll('.rule-row').forEach((btn) => btn.addEventListener('click',
              () => ruleSelectRow(ruleCtx.cur.rows[Number(btn.dataset.i)], gm)));
          }
          box.style.display = box.style.display === 'none' ? 'block' : 'none';
        });
      }
      renderRuleCombos({ method: row.shipping_method_code, machine: row.packing_machine_code });
    }
    function renderRuleCombos(curCombo) {
      // 有効な組み合わせだけを大ボタンで提示 (梱包機≠手動→ネコポス固定の制約をUIに織り込む)
      const methods = ruleCtx.options.methods || [];
      const machines = ruleCtx.options.machines || [];
      const combos = [
        ...machines.filter((m) => m.code !== 'manual').map((m) => ({ method: 'nekopos', machine: m.code, label: `ネコポス・${m.name}` })),
        ...methods.map((mm) => ({ method: mm.code, machine: 'manual', label: `${mm.name}・手動` })),
      ];
      ruleCtx.choice = null;
      $('rulePreview').textContent = '';
      $('ruleSubmit').disabled = true;
      $('ruleCombos').innerHTML = '<div style="font-size:12px; color:#868e96; margin:10px 0 4px">変更後を選ぶ</div>'
        + combos.map((c, i) => {
          const isCur = curCombo && c.method === curCombo.method && c.machine === curCombo.machine;
          return `<button type="button" class="rule-combo" data-i="${i}" ${isCur ? 'disabled' : ''}
            style="min-height:52px; margin:4px 6px 0 0; padding:10px 14px; border-radius:10px; font-size:15px; border:2px solid ${isCur ? '#adb5bd' : '#1971c2'}; background:${isCur ? '#f1f3f5' : '#fff'}; font-weight:700">${esc(c.label)}${isCur ? ' (現在)' : ''}</button>`;
        }).join('');
      $('ruleCombos').querySelectorAll('.rule-combo:not([disabled])').forEach((btn) => {
        btn.addEventListener('click', () => {
          const c = combos[Number(btn.dataset.i)];
          ruleCtx.choice = c;
          $('ruleCombos').querySelectorAll('.rule-combo').forEach((b) => {
            b.style.background = b === btn ? '#e7f5ff' : (b.disabled ? '#f1f3f5' : '#fff');
          });
          const curTxt = ruleCtx.kind === 'single'
            ? `${ruleCtx.selRow.method_name} (${ruleCtx.selRow.machine_name})`
            : (ruleCtx.cur.decision ? `${ruleCtx.cur.decision.method_name} (${ruleCtx.cur.decision.machine_name})` : '未学習');
          $('rulePreview').innerHTML = `${esc(curTxt)} → <span style="color:#e03131">${esc(c.label)}</span>`;
          $('ruleSubmit').disabled = false;
        });
      });
    }
    $('ruleCancel').addEventListener('click', () => { $('ruleOverlay').style.display = 'none'; autoPauseEnd(); });
    $('ruleSubmit').addEventListener('click', async () => {
      if (!ruleCtx || !ruleCtx.choice) return;
      $('ruleSubmit').disabled = true;
      try {
        const body = {
          slip_seq: ruleSlipSeq,
          worker_name: worker,
          shipping_method_code: ruleCtx.choice.method,
          packing_machine_code: ruleCtx.choice.machine,
        };
        if (ruleCtx.kind === 'single') {
          body.mall_group = ruleCtx.selRow.mall_group;
          body.qty_min = ruleCtx.selRow.qty_min;
          body.qty_max = ruleCtx.selRow.qty_max;
          body.expect_method_code = ruleCtx.selRow.shipping_method_code;
          body.expect_machine_code = ruleCtx.selRow.packing_machine_code;
        } else if (ruleCtx.cur.decision) {
          body.expect_method_code = ruleCtx.cur.decision.shipping_method_code;
          body.expect_machine_code = ruleCtx.cur.decision.packing_machine_code;
        } else {
          body.expect_none = true;   // 「未学習」を見て申請 — 表示後に学習が入っていたら弾く
        }
        const res = await fetch(`/apps/packing/api/batches/${STATE.batchId}/rule-change`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const rb = await res.json().catch(() => ({}));
        if (!res.ok) { showToast(rb.error || `申請に失敗しました (${res.status})`); return; }
        $('ruleOverlay').style.display = 'none';
        autoPauseEnd();
        showToast(rb.cardPosted
          ? `承認依頼 #${rb.id} を送信しました (GChatの承認カードから反映されます)`
          : `承認依頼 #${rb.id} を受け付けました (⚠GChatカードの投稿に失敗 — 管理者に連絡してください)`);
      } finally {
        $('ruleSubmit').disabled = false;
      }
    });

    // ── 伝票検索 (ズレ回復) ──
    let lastSearch = '';       // 直近の検索語 (複数候補を順に見るとき用に保持)
    let lastSearchHits = 0;
    function renderSlipList(filter) {
      const f = String(filter || '').trim();
      lastSearch = f;
      const fl = f.toLowerCase();
      // 伝票番号 (下桁一致含む)・商品名・SKUに加えて、お客様名でも探せる (2026-08-20 中原さん指示:
      // AESはNE伝票番号が載らないケースがあり、商品コードのアルファベット入力は現場で手間)。
      // 名前は姓名間の空白 (全角/半角) のゆれを無視して照合する
      const normName = (t) => String(t || '').toLowerCase().replace(/[\s　]/g, '');
      const fn = normName(f);
      const lineMatch = (s) => s.lines.find((l) =>
        (l.name || '').toLowerCase().includes(fl) || (l.sku || '').toLowerCase().includes(fl));
      const nameMatch = (s) => fn && normName(s.recipientName).includes(fn);
      const filtered = STATE.slips.filter((s) => !f || s.neSlipNo.includes(f) || lineMatch(s) || nameMatch(s));
      lastSearchHits = f ? filtered.length : 0;
      const rows = filtered
        .slice(0, 60)
        .map((s) => {
          const hit = f ? lineMatch(s) : null;
          const shown = hit || s.lines[0] || {};
          return `<div class="slip-row" data-seq="${s.seq}">
            <span class="no">${esc(s.neSlipNo)}</span>
            <span>#${s.seq}</span>
            <span class="st-mini ${doneSet.has(s.seq) ? 'done' : ''}">${doneSet.has(s.seq) ? '完了' : heldSet.has(s.seq) ? '保留' : '未'}</span>
            <span style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#868e96">${s.recipientName ? `<b style="color:#495057">${esc(s.recipientName)}</b>｜` : ''}${esc(shown.name || '')}${hit && s.lines.length > 1 ? ` <b>他${s.lines.length - 1}件</b>` : ''}</span>
          </div>`;
        }).join('');
      $('slipList').innerHTML = rows || '<div style="color:#868e96; padding:20px">該当なし</div>';
      document.querySelectorAll('.slip-row').forEach((el) => {
        el.addEventListener('click', () => {
          const seq = Number(el.dataset.seq);
          $('searchOverlay').style.display = 'none';
          // 複数候補があったときは「検索結果に戻る」チップを出す (検索語は保持)
          if (lastSearchHits > 1) {
            $('searchBackBtn').textContent = `↩ 検索結果に戻る (${lastSearch} · ${lastSearchHits}件)`;
            $('searchBack').style.display = 'block';
          } else {
            $('searchBack').style.display = 'none';
          }
          viewSeq = seq;
          if (!doneSet.has(seq) && seq !== currentSeq) {
            // 順序から外れた未処理伝票へのジャンプ = ズレ回復モード (記録を残し頻度を計測する)
            jumpMode = true; jumpTargetSeq = seq;
            enqueue('jump', seq);
          } else {
            jumpMode = false; jumpTargetSeq = null;
          }
          render();
        });
      });
    }
    $('searchBtn').addEventListener('click', () => {
      if (!worker) return;
      // 直近の検索語を保持したまま開く (複数候補を順に確認する運用のため)
      $('searchInput').value = lastSearch;
      renderSlipList(lastSearch);
      $('searchOverlay').style.display = 'flex';
      $('searchInput').focus();
    });
    $('searchBackBtn').addEventListener('click', () => {
      $('searchInput').value = lastSearch;
      renderSlipList(lastSearch);
      $('searchOverlay').style.display = 'flex';
    });
    $('searchCancel').addEventListener('click', () => { $('searchOverlay').style.display = 'none'; });
    $('searchInput').addEventListener('input', () => renderSlipList($('searchInput').value));

    // スワイプ (左=次へ / 右=前へ)。60px閾値・縦スクロールと干渉しない判定
    let touchX = null, touchY = null;
    // スワイプの除外 (Codex 実装R1 high): ボタン・オーバーレイ・資材カード上で始まった
    // タッチはページ送りにしない (ボタンを少し滑らせて離すと登録+次へが同時に走る事故)。
    // オーバーレイ表示中もページ送り停止
    let touchOnControl = false;
    const anyOverlayOpen = () => [...document.querySelectorAll('.overlay')]
      .some((o) => o.style.display === 'flex');
    document.addEventListener('touchstart', (e) => {
      touchX = e.touches[0].clientX; touchY = e.touches[0].clientY;
      const el = e.target;
      touchOnControl = !!(el && el.closest
        && el.closest('button, input, select, a, .overlay, .mat-card, .mat-undo-chip'));
    }, { passive: true });
    document.addEventListener('touchend', (e) => {
      if (touchX == null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      const dy = e.changedTouches[0].clientY - touchY;
      touchX = null;
      if (touchOnControl || anyOverlayOpen()) return;
      if (Math.abs(dx) < 60 || Math.abs(dy) > Math.abs(dx)) return;
      if (dx < 0) goNext(); else goPrev();
    }, { passive: true });

    // ── 開始 (作業者選択 → start イベント。作業中バッチを別の人が続ける場合は takeover を明示記録) ──
    function begin(name) {
      const prevWorker = worker;
      worker = name;
      $('workerTag').textContent = `👤 ${worker}`;
      $('workerOverlay').style.display = 'none';
      $('workerCancel').style.display = 'none';
      const inProgress = STATE.batchStatus === 'packing' || STATE.batchStatus === 'paused'
        || STATE.batchStatus === 'done';   // 完了後の帰属修正も交代として記録 (2026-08-21)
      if (inProgress && prevWorker && prevWorker !== name) {
        enqueue('takeover', null);   // 交代の記録 (無断で元担当を名乗らない — Codex R1 high)
      }
      if (STATE.batchStatus === 'done') {
        // 完了済み: start は送らない (already_done)。交代の記録だけで完了
        showToast(prevWorker !== name ? `担当者を ${name} に変更しました` : '担当者は変更されていません');
        render();
        return;
      }
      if (STATE.batchStatus === 'paused') {
        // 中断中の再開は resume 経由 (start は ready/packing 用)。再開ボタンを出す
        updatePausedOverlay(STATE.pauseReason);
      } else {
        enqueue('start', null);
        STATE.batchStatus = 'packing';   // 楽観更新 — 直後に名前を開き直しても交代 (takeover) 経路に乗る
      }
      viewSeq = currentSeq ?? 1;
      // 名前タップ=ユーザー操作なので、ここでの発声がブラウザの自動再生制限の有効化を兼ねる (要件§5.3)
      lastSpokenSeq = null;
      render();
      // 一通り終えた後に開き直した場合は終了処理 (候補送信・受領) をそのまま出す
      if (currentSeq == null && STATE.batchStatus !== 'paused' && unfinishedCount() > 0) showEndOverlay(false);
    }

    // 作業中の担当変更 (中原さん指示 2026-08-21: 最初に選び間違えても後で直せるように)。
    // 上部の「👤名前」タップで選択画面を開き直す。別名を選ぶと takeover として記録される
    $('workerTag').style.cursor = 'pointer';
    $('workerTag').style.textDecoration = 'underline';
    $('workerTag').addEventListener('click', () => {
      if (!worker) return;
      $('workerHint').textContent = `現在の担当: ${worker} — 選び間違い・交代のときは正しい名前をタップ (交代として記録されます)`;
      $('workerCancel').style.display = 'inline-block';
      $('workerOverlay').style.display = 'flex';
    });
    $('workerCancel').addEventListener('click', () => {
      $('workerOverlay').style.display = 'none';
      $('workerCancel').style.display = 'none';
    });

    document.querySelectorAll('.worker-opt').forEach((btn) => {
      btn.addEventListener('click', () => begin(btn.dataset.name));
    });

    // ── 画像の後追い反映 (取込直後は解決がバックグラウンド進行中) ──
    let imgPolls = 0;
    async function pollImages() {
      const missing = STATE.slips.some((s) => s.lines.some((l) => !l.imageUrl));
      if (!missing || imgPolls++ > 12) return;
      try {
        const res = await fetch(`/apps/packing/api/batches/${STATE.batchId}/images`);
        if (res.ok) {
          const body = await res.json();
          for (const s of STATE.slips) for (const l of s.lines) {
            if (!l.imageUrl && body.images[l.sku]) l.imageUrl = body.images[l.sku];
          }
          render();
        }
      } catch { /* 次回 */ }
      setTimeout(pollImages, 5000);
    }
    setTimeout(pollImages, 5000);

    // ── 梱包時間タイマー (小表示)。伝票=表示からの経過 / 計=バッチ実働 (中断除く・概算) ──
    let slipSec = 0;
    let batchSec = 0;
    let timerSeq = null;
    if (STATE.batchStatus === 'packing' && STATE.startedAt) {
      batchSec = Math.max(0, Math.round((Date.now() - Date.parse(STATE.startedAt)) / 1000) - STATE.pausedTotalSec - STATE.blockedTotalSec);
    }
    const fmtSec = (t) => `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
    setInterval(() => {
      const working = worker && !paused && currentSeq != null
        && $('doneOverlay').style.display !== 'flex' && $('workerOverlay').style.display !== 'flex';
      if (working) {
        // 表示中の梱包対象が変わったら伝票タイマーをリセット
        // 閲覧中の伝票でタイマーを進めない (作業時間が実態とズレる)。判定はボタンと共通
        const target = canCompleteSeq(viewSeq) ? viewSeq : null;
        if (target !== timerSeq) { timerSeq = target; slipSec = 0; }
        if (target != null) slipSec++;
        batchSec++;
        $('timer').textContent = `⏱ ${fmtSec(slipSec)}・計 ${fmtSec(batchSec)}`;
      }
    }, 1000);

    // ── Wake Lock (梱包台据置で画面を消さない) ──
    async function keepAwake() {
      try { await navigator.wakeLock?.request('screen'); } catch { /* 非対応は無視 */ }
    }
    // 復帰時は先にキューを流す (pump が空になった時点で resync が走る)
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { keepAwake(); pump(); } });
    keepAwake();

    // ── 初期表示 ──
    // 作業中バッチの再開でも必ず名前タップを求める (画面を開いただけの人が
    // 元担当者を名乗って進めてしまわないように — Codex R1 high)
    if (STATE.batchStatus === 'done') {
      viewSeq = STATE.slips.length;
      render();
      $('doneOverlay').style.display = 'flex';
    } else {
      // ?seq=N (ヘッダーの「対象伝票を開く」から) はその伝票を先に表示する
      const qSeq = Number(new URLSearchParams(location.search).get('seq'));
      viewSeq = bySeq.has(qSeq) ? qSeq : (currentSeq ?? 1);
      render();
      if ((STATE.batchStatus === 'packing' || STATE.batchStatus === 'paused') && worker) {
        $('workerHint').textContent = `現在の担当: ${worker}${STATE.batchStatus === 'paused' ? ' (中断中)' : ''} — 別の人が続ける場合は自分の名前をタップ (交代として記録されます)`;
      }
      $('workerOverlay').style.display = 'flex';
    }
    pump();
  </script>
</body>
</html>
