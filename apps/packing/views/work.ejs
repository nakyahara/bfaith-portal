            const r = await fetch(`/apps/packing/api/stock-search?q=${encodeURIComponent(q)}`);
            const body = await r.json();
            const items = body.items || [];
            res.innerHTML = items.map((it, idx) =>
              `<button type="button" class="reason-opt issue-hit" data-idx="${idx}" style="text-align:left">${esc(it.name || it.sku)}<br><small>${esc(it.sku)}${it.free != null ? ` / フリー${it.free}` : ''}</small></button>`).join('')
              + (items.length === 0 ? `<small style="color:#868e96">${body.disabled ? '在庫検索が設定されていません' : body.error ? '在庫検索に接続できません' : '該当なし'}</small>` : '')
              + directHtml(q);
            res.querySelectorAll('.issue-hit').forEach((b) => b.addEventListener('click', () => {
              const it = items[Number(b.dataset.idx)];
              onPick({ sku: it.sku, name: it.name || null });
            }));
            bindDirect();
          } catch {
            res.innerHTML = '<small style="color:#c5221f">検索エラー</small>' + directHtml(q);
            bindDirect();
          }
        }, 300);
      };
      setTimeout(() => input.focus(), 50);
    }
    function allBatchSkus() {
      const seen = new Map();
      for (const sl of STATE.slips) for (const l of sl.lines) if (!seen.has(l.sku)) seen.set(l.sku, l.name);
      return [...seen.entries()];
    }
    function fillSkuDatalist() {
      $('batchSkus').innerHTML = allBatchSkus().map(([sku, name]) => `<option value="${esc(sku)}">${esc(name)}</option>`).join('');
    }
    $('issueBtn').addEventListener('click', () => {
      if (paused || !worker || currentSeq == null && doneSet.size === 0) return;
      issue = null;
      $('issueTitle').textContent = 'どうしましたか？';
      $('issueStep1').style.display = 'grid';
      $('issueStep2').style.display = 'none';
