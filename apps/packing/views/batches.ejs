<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="manifest" href="/apps/packing/manifest.json">
  <link rel="apple-touch-icon" href="/favicon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .pk-wrap { max-width: 760px; margin: 0 auto; padding: 10px 12px 40px; }
    .pk-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
    .pk-bar input[type=date] { padding: 7px; font-size: 16px; }
    .muted { color: #868e96; font-size: 0.85em; }
    .pk-empty { color: #868e96; padding: 40px 0; text-align: center; }
    .card {
      background: #fff; border: 1px solid #dee2e6; border-radius: 12px;
      padding: 12px 14px; margin-bottom: 10px;
      display: flex; gap: 12px; align-items: center;
    }
    .card.done { opacity: 0.55; }
    .card-main { flex: 1 1 auto; min-width: 0; }
    .card-title { font-weight: 700; font-size: 0.98em; line-height: 1.35; margin-bottom: 4px; }
    .card-meta { color: #495057; font-size: 0.85em; display: flex; flex-wrap: wrap; gap: 2px 12px; }
    .card-meta b { font-size: 1.05em; }
    .st { display: inline-block; border-radius: 4px; padding: 1px 8px; background: #e9ecef; font-size: 0.85em; white-space: nowrap; }
    .st.ready { background: #d0ebff; } .st.packing { background: #fff3bf; }
    .st.paused { background: #ffe8cc; } .st.done { background: #d3f9d8; }
    .st.cancelled { background: #f1f3f5; color: #868e96; }
    .match-warn { color: #e8590c; font-weight: 600; }
    .card-actions { flex: 0 0 auto; display: flex; flex-direction: column; gap: 6px; align-items: stretch; }
    .btn-work {
      display: block; padding: 14px 26px; border: none; border-radius: 10px;
      background: #1971c2; color: #fff; font-size: 1.1em; font-weight: 700; text-decoration: none;
      text-align: center; white-space: nowrap;
    }
    .btn-work.resume { background: #e8590c; }
    .btn-detail { text-align: center; font-size: 0.85em; color: #495057; text-decoration: none; padding: 4px; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">📦 梱包支援</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <% if (isAdmin) { %>
        <a href="/apps/packing/admin/import" class="btn-logout">📥 納品書CSV取込</a>
        <a href="/apps/packing/admin/summary" class="btn-logout">📊 サマリ</a>
        <a href="/apps/packing/admin/devices" class="btn-logout">📱 端末</a>
      <% } %>
      <% if (typeof deviceMode === 'undefined' || !deviceMode) { %><a href="/apps/picking/" class="btn-logout">📱 ピッキング</a><% } %>
    </div>
  </header>

  <div class="pk-wrap">
    <div class="pk-bar">
      <form method="get" action="/apps/packing/">
        <input type="date" name="date" value="<%= workDate %>" onchange="this.form.submit()">
      </form>
      <span class="muted"><%= batches.length %> バッチ</span>
    </div>

    <% if (batches.length === 0) { %>
      <div class="pk-empty">
        バッチがありません。<% if (isAdmin) { %><a href="/apps/packing/admin/import">納品書CSV を取り込む</a><% } else { %>取込が済むとここに表示されます。<% } %>
      </div>
    <% } %>

    <% for (const b of batches) { %>
      <div class="card <%= b.status === 'done' ? 'done' : '' %>">
        <div class="card-main">
          <div class="card-title"><%= b.folder_name || b.tb_key %></div>
          <div class="card-meta">
            <span>伝票 <b><%= b.done_slips %></b>/<b><%= b.slip_count %></b></span>
            <span>明細 <b><%= b.line_count %></b></span>
            <span>数量 <b><%= b.total_qty %></b></span>
            <span class="st <%= b.status %>"><%= statusLabels[b.status] || b.status %></span>
            <% if (b.match_status !== 'ok') { %>
              <span class="match-warn">⚠ <%= b.match_status === 'no_picking' ? 'ピッキング未取込' : 'ピッキング不一致' %></span>
            <% } %>
            <% if (b.worker) { %><span>👤 <%= b.worker %></span><% } %>
          </div>
        </div>
        <div class="card-actions">
          <% if (b.status !== 'done' && b.status !== 'cancelled') { %>
            <% if (b.lineKind) { %>
              <a class="btn-work <%= b.status === 'packing' ? 'resume' : '' %>" href="/apps/packing/line/<%= b.id %>">🏭 <%= b.lineKind === 'melt' ? 'MELT' : 'PAS' %>ライン</a>
            <% } else { %>
              <a class="btn-work <%= b.status === 'packing' ? 'resume' : '' %>" href="/apps/packing/work/<%= b.id %>"><%= b.status === 'packing' ? '▶ 続きから' : '▶ 梱包' %></a>
            <% } %>
          <% } %>
          <a class="btn-detail" href="/apps/packing/batches/<%= b.id %>">伝票一覧</a>
        </div>
      </div>
    <% } %>
  </div>
</body>
</html>
