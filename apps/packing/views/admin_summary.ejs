<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | B-Faith Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <style>
    .pk-wrap { max-width: 960px; margin: 0 auto; padding: 12px 16px 40px; }
    .pk-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .tiles { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
    .tile { background: #fff; border: 1px solid #dee2e6; border-radius: 10px; padding: 10px 18px; min-width: 120px; }
    .tile .v { font-size: 1.6em; font-weight: 800; }
    .tile .l { color: #868e96; font-size: 0.82em; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9em; margin-bottom: 20px; }
    th, td { border-bottom: 1px solid #dee2e6; padding: 6px 8px; text-align: left; }
    th { background: #f1f3f5; }
    td.num, th.num { text-align: right; }
    h2 { font-size: 1.05em; margin: 18px 0 8px; }
    .st { display: inline-block; border-radius: 4px; padding: 1px 8px; background: #e9ecef; font-size: 0.85em; }
    .st.done { background: #d3f9d8; } .st.packing { background: #fff3bf; } .st.paused { background: #ffe8cc; }
    .warn { color: #e8590c; font-weight: 600; }
  </style>
</head>
<body>
  <header class="portal-header">
    <div class="header-left">
      <h1>B-Faith Portal</h1>
      <span class="page-title">📊 梱包サマリ</span>
    </div>
    <div class="header-right">
      <span class="user-name"><%= typeof displayName !== 'undefined' && displayName ? displayName : username %></span>
      <a href="/apps/packing/" class="btn-logout">← バッチ一覧</a>
    </div>
  </header>

  <div class="pk-wrap">
    <div class="pk-bar">
      <form method="get" action="/apps/packing/admin/summary">
        <input type="date" name="date" value="<%= summary.workDate %>" onchange="this.form.submit()">
      </form>
    </div>

    <% const fmtMin = (s) => s == null ? '-' : `${Math.floor(s / 60)}分${Math.round(s % 60)}秒`; %>
    <div class="tiles">
      <div class="tile"><div class="v"><%= summary.total.doneCount %>/<%= summary.total.batchCount %></div><div class="l">完了バッチ</div></div>
      <div class="tile"><div class="v"><%= summary.total.slipCount %></div><div class="l">完了伝票</div></div>
      <div class="tile"><div class="v"><%= summary.total.qty %></div><div class="l">数量</div></div>
      <div class="tile"><div class="v"><%= fmtMin(summary.total.activeSec) %></div><div class="l">実働 (中断除く)</div></div>
      <div class="tile"><div class="v"><%= summary.total.secPerSlip == null ? '-' : summary.total.secPerSlip.toFixed(1) %></div><div class="l">秒/伝票 (バッチ実働÷伝票)</div></div>
      <% if (summary.slipStats) { %>
        <div class="tile"><div class="v"><%= summary.slipStats.median %></div><div class="l">秒/伝票 中央値 (表示〜完了実測 n=<%= summary.slipStats.count %>)</div></div>
      <% } %>
    </div>

    <% const oc = summary.opCounts; %>
    <% if (Object.keys(oc).length > 0) { %>
      <div class="tiles">
        <% if (oc.jump) { %><div class="tile"><div class="v warn"><%= oc.jump %></div><div class="l">🔎 ズレ回復ジャンプ</div></div><% } %>
        <% if (oc.undo) { %><div class="tile"><div class="v warn"><%= oc.undo %></div><div class="l">完了取消</div></div><% } %>
        <% if (oc.pause) { %><div class="tile"><div class="v"><%= oc.pause %></div><div class="l">中断</div></div><% } %>
        <% if (oc.takeover) { %><div class="tile"><div class="v"><%= oc.takeover %></div><div class="l">交代</div></div><% } %>
        <% if (oc.cancel) { %><div class="tile"><div class="v"><%= oc.cancel %></div><div class="l">バッチ取消</div></div><% } %>
      </div>
    <% } %>

    <% if (summary.incidents && (summary.incidents.confirmed.length > 0 || summary.incidents.candidateCount > 0)) { %>
      <h2>③ ピッキングミス (確定分・帰責=ピッキング担当)</h2>
      <% if (summary.incidents.candidateCount > 0) { %>
        <div style="color:#e8590c; font-weight:600; margin-bottom:6px">⚠ 未確定の候補が <%= summary.incidents.candidateCount %> 件あります (梱包完了画面で確定/取下げ)</div>
      <% } %>
      <table>
        <thead><tr><th>ピッキング担当</th><th class="num">計</th><th class="num">不足</th><th class="num">余り</th><th class="num">品違い</th></tr></thead>
        <tbody>
          <% for (const w of summary.incidents.byWorker) { %>
            <tr><td><%= w.key %></td><td class="num"><%= w.count %></td><td class="num"><%= w.shortage %></td><td class="num"><%= w.excess %></td><td class="num"><%= w.wrong_item %></td></tr>
          <% } %>
          <% if (summary.incidents.byWorker.length === 0) { %><tr><td colspan="5">確定したミスはありません</td></tr><% } %>
        </tbody>
      </table>
      <% if (summary.incidents.confirmed.length > 0) { %>
        <table>
          <thead><tr><th>種別</th><th>SKU</th><th class="num">数量</th><th>バッチ</th><th>担当</th><th>検知</th></tr></thead>
          <tbody>
            <% for (const i of summary.incidents.confirmed) { %>
              <tr>
                <td><%= { shortage: '📉不足', excess: '📈余り', wrong_item: '🔀品違い' }[i.kind] %></td>
                <td><%= i.sku %><%= i.actual_sku ? ` (実際: ${i.actual_sku})` : '' %></td>
                <td class="num"><%= i.qty %></td>
                <td><%= i.folder_name || '-' %><%= i.slip_seq ? ` #${i.slip_seq}` : '' %></td>
                <td><%= i.attributed_worker || '-' %></td>
                <td><%= i.detected_by %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    <% } %>

    <h2>作業者別 (完了バッチの最終担当者に全量計上)</h2>
    <table>
      <thead><tr><th>作業者</th><th class="num">バッチ</th><th class="num">伝票</th><th class="num">数量</th><th class="num">実働</th><th class="num">秒/伝票</th></tr></thead>
      <tbody>
        <% for (const w of summary.workers) { %>
          <tr>
            <td><%= w.key %></td>
            <td class="num"><%= w.batches %></td>
            <td class="num"><%= w.slips %></td>
            <td class="num"><%= w.qty %></td>
            <td class="num"><%= fmtMin(w.activeSec) %></td>
            <td class="num"><%= w.secPerSlip == null ? '-' : w.secPerSlip.toFixed(1) %></td>
          </tr>
        <% } %>
        <% if (summary.workers.length === 0) { %><tr><td colspan="6">完了バッチがありません</td></tr><% } %>
      </tbody>
    </table>

    <h2>バッチ一覧</h2>
    <table>
      <thead><tr><th>バッチ</th><th>担当</th><th class="num">伝票</th><th class="num">数量</th><th class="num">実働</th><th class="num">秒/伝票</th><th>状態</th></tr></thead>
      <tbody>
        <% for (const b of summary.batches) { %>
          <tr>
            <td><a href="/apps/packing/batches/<%= b.id %>"><%= b.folder_name || b.tb_key %></a></td>
            <td><%= b.worker || '-' %></td>
            <td class="num"><%= b.slip_count %></td>
            <td class="num"><%= b.total_qty %></td>
            <td class="num"><%= fmtMin(b.activeSec) %></td>
            <td class="num"><%= b.activeSec != null && b.slip_count > 0 ? (b.activeSec / b.slip_count).toFixed(1) : '-' %></td>
            <td><span class="st <%= b.status %>"><%= statusLabels[b.status] || b.status %></span></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
