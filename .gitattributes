# .bat は必ず CRLF でチェックアウトする。
# LF のままだと cmd.exe が終了コード 255 で即死し、Stream Deck や
# タスクスケジューラから叩いたときだけ静かに落ちる。
# 各PCの core.autocrlf 設定に依存させないため明示する。
*.bat text eol=crlf
*.cmd text eol=crlf
# bash shim for the nightly runner: CRLF would append \r to the last argument
scripts/ph-nightly/phq text eol=lf
scripts/ph-nightly/phreview text eol=lf
# ロジザードの自動化の正本 (tools/logizard-automation)。各 PC の C:	oolslogizard-automation に写して使う。
# 今の各 PC のファイルは LF = 写した後もバイトが同じになるように LF に固定する (.bat は上の決まりで CRLF のまま)。
tools/logizard-automation/*.js text eol=lf
tools/logizard-automation/*.mjs text eol=lf
tools/logizard-automation/*.json text eol=lf
